{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "okkama-p1-manifest/1",
  "title": "Okkama P1 ownership oracle manifest",
  "type": "object",
  "required": ["schema", "entries"],
  "properties": {
    "schema": {"const": "okkama-p1-manifest/1"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["block", "serial", "type"],
      "properties": {
        "block": {"type": "integer", "minimum": 0},
        "serial": {"type": "integer", "minimum": 1},
        "type": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object",
      "required": ["event", "A", "B"],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "A": {"$ref": "#/$defs/reference"},
        "B": {"$ref": "#/$defs/reference"}
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "source", "checks", "rule", "features", "checkpoints", "failure", "destroy", "baseline", "model_fixture", "cleanup", "expected", "identities"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "rust_test": {"type": "string", "minLength": 1},
        "checks": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "rule": {"type": "string", "minLength": 1},
        "features": {"type": "array", "items": {"type": "string"}},
        "checkpoints": {"type": "array", "items": {"type": "string"}},
        "stdout": {"type": "string"},
        "failure": {
          "type": "object", "required": ["code", "stderr"], "additionalProperties": false,
          "properties": {"code": {"type": "integer", "minimum": 0}, "stderr": {"type": "string"}}
        },
        "destroy": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline": {
          "type": "object", "required": ["revision", "toolchain"],
          "properties": {"revision": {"type": "string", "minLength": 1}, "toolchain": {"type": "string", "minLength": 1}}
        },
        "model_fixture": {"type": ["string", "null"], "minLength": 1},
        "cleanup": {"enum": ["static", "journal", "dynamic"]},
        "expected": {"enum": ["supported", "unsupported"]},
        "reason": {"type": "string", "minLength": 1},
        "identities": {"type": "array", "items": {"$ref": "#/$defs/identity"}}
      },
      "allOf": [
        {"if": {"properties": {"expected": {"const": "unsupported"}}}, "then": {"required": ["reason"]}},
        {"if": {"properties": {"expected": {"const": "supported"}}}, "then": {"required": ["stdout"]}}
      ]
    }
  }
}

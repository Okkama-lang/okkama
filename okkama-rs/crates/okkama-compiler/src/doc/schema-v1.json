{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Okkama documentation model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "signature",
        "target",
        "span",
        "doc",
        "members"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "object",
            "role",
            "enum",
            "error",
            "const",
            "native",
            "native-object",
            "cap"
          ]
        },
        "signature": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "doc": {
          "anyOf": [
            {
              "$ref": "#/$defs/doc"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "signature",
        "target",
        "span",
        "doc"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "constructor",
            "action",
            "signature",
            "cap",
            "case",
            "field"
          ]
        },
        "signature": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "doc": {
          "anyOf": [
            {
              "$ref": "#/$defs/doc"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "file",
        "target",
        "overview",
        "items",
        "notes",
        "link_warnings"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "overview": {
          "anyOf": [
            {
              "$ref": "#/$defs/doc"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "link_warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "doc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "markdown",
        "span",
        "links"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "range",
        "span",
        "target",
        "declarations"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/span"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "span"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span",
        "message"
      ],
      "properties": {
        "span": {
          "$ref": "#/$defs/span"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "span"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    }
  }
}

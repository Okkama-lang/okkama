module app;
object Check {
    Check();
    check() is void { test.is(1, 2); }
}
test "assertions continue" {
    Check().check();
    test.isnt(1, 1);
    test.fail("deliberate failure");
    test.ok(true);
}
test "argument failure" {
    test.is(1 % 0, 0);
}
main() is int { panic "main must not run"; }

module app;
object Box<T> {
    has value is T;
    Box(:value);
    make() is () is () is T {
        () is () is T {
            self.make();
            () is T { value; }
        }
    }
}
main() is int {
    Box(value: 1).make();
    Box(value: "s").make();
    let a = () is int { 2; };
    let b = () is int { 3; };
    0;
}

module app;
object Probe {
    Probe();
    read() is int { 7; }
}
object Owner {
    has probe is Probe;
    Owner(:probe);
    cap View {
        value is int { probe.read(); }
    }
}
main() is int {
    let view = Owner(probe: Probe())::View;
    let first = view::value;
    first + view::value;
}

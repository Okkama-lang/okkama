module app;
role Recorder {
    record(value is int) is ^Recorder;
    calls() is @int;
    fake {
        has calls is @int = [];
        record(value is int) is ^Recorder { ^calls = calls + [value]; }
        calls() is @int { calls; }
    }
}
test "records calls" {
    let recorder is Recorder = Recorder.fake();
    let first = recorder.record(7);
    let recorded = first.record(9);
    test.is(recorded.calls(), [7, 9]);
    test.is(recorder.calls().size(), 0);
}
main() is int { 9; }

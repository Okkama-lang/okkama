module app;
role Counter {
    next() is ^Counter;
    count() is int;
    fake {
        has count is int = 0;
        next() is ^Counter { ^count = count + 1; }
        count() is int { count; }
    }
}
test "first" {
    let counter = Counter.fake();
    counter = counter.next();
    test.is(counter.count(), 1);
}
test "second" {
    let counter = Counter.fake();
    test.is(counter.count(), 0);
}

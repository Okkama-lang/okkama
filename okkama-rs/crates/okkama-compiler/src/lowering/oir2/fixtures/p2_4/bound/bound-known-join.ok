module app;
object Counter {
    has n is int;
    Counter(:n);
    read() is int { n; }
    destroy { }
    bumped() is ^Counter { ^n = n + 1; }
}
main() is int {
    let owner = Counter(n: 7);
    let lambda = () is int { 7; };
    let bound is () is int = owner.read;
    let joined = if owner.read() > 0 { lambda; } else { bound; };
    joined();
}

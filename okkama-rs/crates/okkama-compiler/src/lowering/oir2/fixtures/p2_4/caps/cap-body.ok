module app;
object Owner {
    has items is @int;
    Owner(:items);
    cap View {
        total is int {
            defer items.size();
            let total = items.reduce(0) -> acc, item { acc + item; };
            if total > 0 { return total; }
            0;
        }
        action is () is int {
            let values = items;
            () is int { values.size(); }
        }
    }
}
main() is int {
    let view = Owner(items: [2, 3])::View;
    view::total + view::action();
}

module app;
role Counting {
    read() is int;
    bumped() is ^Counting;
}
object Counter does Counting {
    has n is int;
    Counter(:n);
    read() is int { n; }
    bumped() is ^Counter { ^n = n + 1; }
}
main() is int {
    let item is Counting = Counter(n: 7);
    let bump = item.bumped;
    let later = bump();
    later.read();
}

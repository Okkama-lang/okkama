module app;
import "collections/iteration" take Cursor, Iterating;
import "collections/set" take Set, Intersection;
object Items does Set<int> {
    has values is @int;
    Items(:values);
    cursor() is Cursor<int> {
        let items is Iterating<int> = values;
        items.cursor();
    }
    size() is int { values.size(); }
    membership(value is int) is bool { values.any() -> item { item == value; }; }
    addition(value is int) is Set<int> { Items(values: values + [value]); }
    difference(value is int) is Set<int> { Items(values: values - [value]); }
}
main() is int {
    let left = Items(values: [1, 2]);
    let right = Items(values: [2, 3]);
    Intersection(left: left, right: right).size();
}

module app;
object Res {
    Res();
    destroy { }
}
object Owner {
    has hidden is Res;
    has label is string;
    Owner(:hidden, :label);
    cap View {
        text is string { label; }
    }
}
object Factory {
    Factory();
    view() is Owner::View { Owner(hidden: Res(), label: "O")::View; }
}
main() is int {
    let view = Factory().view();
    view::text;
    0;
}

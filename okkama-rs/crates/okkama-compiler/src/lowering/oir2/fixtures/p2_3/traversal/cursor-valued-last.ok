module app;
import "collections/iteration" take Cursor, Iterating, Batching;
object Step does Cursor<int> {
    has n is int;
    Step(:n);
    available() is bool {
        n > 0;
    }
    item() is int {
        n;
    }
    successor() is Cursor<int> {
        Step(n: n - 1);
    }
    destroy {
        n;
    }
}
object Walk does Iterating<int> {
    has n is int;
    Walk(:n);
    cursor() is Cursor<int> {
        Step(n: n);
    }
}
main() is int {
    for Walk(n: 2) -> x {
        last 9;
    }
}

module app;
object Box<T> {
    has value is T;
    has n is int = 7;
    Box(:value, :n);
    get() is T { value; }
}
object Full<T> {
    has value is T;
    has n is int;
    Full(value is T, n is int = 9) { self.value = value; self.n = n; }
    number() is int { n; }
}
main() is int {
    let a = Box(value: 1);
    let b = Box(value: "s", n: 2);
    let supplied = Box(value: 2, n: 3);
    supplied.get();
    let c is Full<string> = Full("full");
    b.get();
    c.number();
    a.get();
}

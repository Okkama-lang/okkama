module app;
import "collections/iteration" take Cursor, Iterating, Batching;
object Walk does Batching<int> {
    has values is @int;
    Walk(:values);
    batch() is @int {
        values;
    }
}
main() is int {
    for Walk(values: [1, 2]) -> x {
        last if x == 1;
        x;
    }
    0;
}

module app;
object Res {
    has n is int;
    Res(n is int) {
        self.n = n;
    }
    destroy {
        n;
    }
}
object Select {
    Select();
    fresh() is Res {
        let a = Res(1);
        let b = Res(2);
        let xs = ["a": a, "b": a, "c": b];
        {
            xs["a"];
        }
    }
    borrowed(xs is %string:Res, k is string) is Res {
        {
            xs[k];
        }
    }
}
main() is int {
    0;
}

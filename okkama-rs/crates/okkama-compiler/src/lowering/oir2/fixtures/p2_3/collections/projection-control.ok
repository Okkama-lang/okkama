module app;
object Res {
    Res();
    destroy {
    }
}
object Select {
    Select();
    choose(xs is @Res, i is int, again is bool) is Res {
        loop {
            next if again;
            last xs[i];
        }
    }
    empty(xs is @Res) is @Res {
        xs.slice(0, 0);
    }
    singleton_removed(xs is @Res) is @Res {
        xs.removed_at(0);
    }
    empty_values(m is %string:Res) is @Res {
        m.values().slice(0, 0);
    }
    reselect(m is %string:Res, k is string, flag is bool) is Res {
        let result = if flag {
            m[k];
        }
        else {
            m[k] else Res();
        };
        result;
    }
}
main() is int {
    0;
}

module app;
role Package {
    open() is ^Package;
    label() is int;
}
object Box does Package {
    has opened is bool = false;
    Box() {}
    open() is ^Box { ^opened = true; }
    label() is int { 1; }
}
main() is int {
    let package is Package = Box();
    let opened is Package = package.open();
    opened.label();
}

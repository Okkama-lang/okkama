module app;
object Res {
    has n is int;
    Res(n is int) {
        self.n = n;
    }
    destroy {
        n;
    }
}
object Mark {
    Mark();
    key(n is int) is string {
        n.string();
    }
}
main() is int {
    let mark = Mark();
    let a = [Res(1), Res(2)];
    let m = [mark.key(1): Res(3), mark.key(2): Res(4), mark.key(1): Res(5)];
    m.size();
}

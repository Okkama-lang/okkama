module app;
object Box<T> {
    has value is T;
    Box(:value);
    get() is T {
        value;
    }
}
object Index<K,V> {
    has entries is %K:V;
    Index(:entries);
    get(k is K) is V {
        entries[k];
    }
}
main() is int {
    let a = [Box(value: 1)];
    let b = [Box(value: "b")];
    let index = Index(entries: ["a": a]);
    index.get("a")[0].get();
}

module app;
import "compare" take Comparing, Order;
enum Refused is Error = (no);
object Item does Comparing<Item> {
    has number is int;
    Item(:number);
    number() is int { number; }
    order(other is Item) is Order {
        confirm number != 7 && other.number() != 7 else throw Refused.no;
        number.order(other.number());
    }
}
main() is int {
    try {
        [Item(number: 2), Item(number: 7)].ordering().size();
    } catch e is Refused {
        -1;
    }
}

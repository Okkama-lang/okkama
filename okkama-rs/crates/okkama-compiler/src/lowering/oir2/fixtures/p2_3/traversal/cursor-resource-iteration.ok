module app;
import "collections/iteration" take Cursor, Iterating, Batching;
object Res {
    has n is int;
    Res(:n);
    read() is int {
        n;
    }
    destroy {
        n;
    }
}
object Step does Cursor<Res> {
    has n is int;
    Step(:n);
    available() is bool {
        n > 0;
    }
    item() is Res {
        Res(n: n);
    }
    successor() is Cursor<Res> {
        Step(n: n - 1);
    }
    destroy {
        n;
    }
}
object Walk does Iterating<Res> {
    Walk();
    cursor() is Cursor<Res> {
        Step(n: 2);
    }
}
object Run {
    Run();
    run() is int {
        for Walk() -> x {
            x.read();
        }
        0;
    }
}
main() is int {
    0;
}

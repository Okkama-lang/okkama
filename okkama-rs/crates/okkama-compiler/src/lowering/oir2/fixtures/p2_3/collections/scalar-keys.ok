module app;
enum Color = (red, blue);
main() is int {
    let ints = [1: "one", 2: "two"];
    let bools = [false: 1, true: 2];
    let chars = ['b': 2, 'a': 1];
    let strings = ["z": 1, "a": 2];
    let floats = [1.5: 1, 2.5: 2];

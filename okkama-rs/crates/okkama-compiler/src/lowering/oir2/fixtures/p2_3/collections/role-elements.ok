module app;
role Read {
    get() is int;
}
object Res does Read {
    has n is int;
    Res(n is int) {
        self.n = n;
    }
    get() is int {
        n;
    }
    destroy {
        n;
    }
}
main() is int {
    let a is @Read = [Res(1), Res(2)];
    let m is %string:Read = ["a": Res(3)];
    a.removed_at(0)[0].get();
    m["a"].get();
}

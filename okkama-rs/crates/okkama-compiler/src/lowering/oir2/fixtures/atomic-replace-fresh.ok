module app;
import "async/atomic" take Atomic;
import "runtime/utf" take utf8_encode;
import "runtime/stdio" take stdout_write;
main() is int {
    let state = Atomic("old");
    let old = state.value();
    state.replace("new");
    let current = state.value();
    state.close();
    stdout_write(utf8_encode(old));
    stdout_write(utf8_encode(current));
    7;
}

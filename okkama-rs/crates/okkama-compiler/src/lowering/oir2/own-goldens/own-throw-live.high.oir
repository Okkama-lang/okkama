oir 2 high
module app
requires core
entry @main

object app.O {
    field n: int = @app.O.default#0
}

enum app.Stop is Error = (now)
scope S0 action in @app.O.default#0
scope S1 action in @app.O.staged#0
scope S2 try in @app.O.staged#0 parent S1
scope S3 catch in @app.O.staged#0 parent S1
scope S4 action in @main
scope S5 action in @app.O.new#0

func @app.O.default#0() -> int [default app.O.n] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S0:
    raise %1
}

func @app.O.new#0() -> app.O [ctor app.O] {
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %0: int = undef ty int
    [i1] %1: int = call @app.O.default#0()
    stage %1, action S5, field field_ref(declaration=app.O, index=0)
    %2: app.O = obj.new app.O { n: %1 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S5:
    raise %3
}

func @app.O.staged#0(%0: app.O) -> ^app.O [successor app.O] {
    binding b0 "e": app.Stop in S3
    boundary B0 lexical in S1
    boundary B1 lexical in S3
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    br ^b4(%1)
    ^b1(%2: failure) in S1:
    raise %2
    ^b2(%3: int) in S1 unwind ^b1:
    %4: ^app.O = obj.next %0 { n: %3 }
    want %4
    [i3] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #3
    ret %4
    ^b3(%5: int, %6: failure) in S1 unwind ^b1:
    catch %6 is app.Stop, ^b6(%5, %6, $value), ^b7(%5, %6)
    ^b4(%7: int) in S2 unwind ^b3(%7):
    %8: int = const 1
    stage %8, action S1, field field_ref(declaration=app.O, index=0)
    %9: app.Stop = enum.case app.Stop, case 0
    br ^b5(%8)
    ^b5(%10: int) in S2 unwind ^b3(%10):
    throw %9
    ^b6(%11: int, %12: failure, %13: app.Stop) in S3 unwind ^b1:
    bind %13, binding b0
    br ^b9(%11, %12)
    ^b7(%14: int, %15: failure) in S1 unwind ^b1:
    raise %15
    ^b8(%16: int, %17: failure, %18: failure) in S1 unwind ^b1:
    %19: failure = fail.caused %18, %17
    raise %19
    ^b9(%20: int, %21: failure) in S3 unwind ^b8(%20, %21):
    want %20
    [i10] exit.prepare fallthrough %20 at B1
    result.exit edge normal(0), value %20, demand want, prepare #10
    br ^b2(%20)
}

func @main() -> int [entry] {
    binding b0 "o": app.O in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    [i0] %0: app.O = call @app.O.new#0()
    bind %0, binding b0
    [i2] %1: ^app.O = call @app.O.staged#0(%0)
    %2: app.O = succ.take %1, ty app.O
    rebind %2, binding b0, target S4
    %3: int = const 0
    want %3
    [i7] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #7
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b1(%4: failure) in S4:
    raise %4
}

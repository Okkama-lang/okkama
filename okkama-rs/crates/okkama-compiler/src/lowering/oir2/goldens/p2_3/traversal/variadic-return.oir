func @app.Walk.run#0(%0: app.Walk, %1: array<int>) -> int [method app.Walk] {
    binding b0 "xs": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    ^b0 in S0 unwind ^b1:
    bind %1, binding b0
    %2: int = const 0
    %3: int = array.len %1
    %4: range = range.new %2, %3
    br ^b3(%2, %1)
    ^b1(%5: failure) in S0:
    raise %5
    ^b2(%6: array<int>) in S0 unwind ^b1:
    %7: int = const 0
    want %7
    [i6] exit.prepare return %7 at B0
    result.exit edge normal(0), value %7, demand want, prepare #6
    ret %7
    ^b3(%8: int, %9: array<int>) in S0 unwind ^b1:
    %10: bool = int.lt %8, %3
    cond %10, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %11: int = array.get %1, %8
    bind %11, binding b1
    want %11
    [i11] exit.prepare return %11 at B0
    result.exit edge normal(0), value %11, demand want, prepare #11
    ret %11
    ^b5 in S0 unwind ^b1:
    br ^b2(%9)
    ^b6 in S0:
    unreachable
}

func @main() -> int [entry] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    [i0] %0: app.Walk = call @app.Walk.new#0()
    %1: int = const 1
    %2: int = const 2
    %3: array<int> = array.new [%1, %2], ty array<int>
    [i4] %4: int = call @app.Walk.run#0(%0, %3)
    want %4
    [i6] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #6
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    ret %4
    ^b1(%5: failure) in S2:
    raise %5
}

oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}

object app.Walk {
    does "collections/iteration::Batching<object(app::Res)>" {batch = @app.Walk.batch#0}
}

role "collections/iteration::Batching<object(app::Res)>" {
    batch() -> array<app.Res>
}

role Error [builtin] {
    text() -> str
}
scope S0 action in @app.Res.read#0
scope S1 action in @app.Res.destroy
scope S2 action in @app.Walk.batch#0
scope S3 action in @main
scope S4 try in @main parent S3
scope S5 block in @main parent S4
scope S6 iteration in @main parent S5
scope S7 catch in @main parent S3
scope S8 action in @app.Res.new#0
scope S9 action in @app.Walk.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S8
    boundary B0 lexical in S8
    ^b0 in S8 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S8, field field_ref(declaration=app.Res, index=0)
    bind %0, binding b0
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S8:
    raise %3
}

func @app.Res.read#0(%0: app.Res) -> int [method app.Res] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Walk.new#0() -> app.Walk [ctor app.Walk] {
    boundary B0 lexical in S9
    ^b0 in S9 unwind ^b1:
    %0: app.Walk = obj.new app.Walk { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S9:
    raise %1
}

func @app.Walk.batch#0(%0: app.Walk) -> array<app.Res> [method app.Walk] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: int = const 1
    [i1] %2: app.Res = call @app.Res.new#0(%1)
    %3: int = const 2
    [i3] %4: app.Res = call @app.Res.new#0(%3)
    %5: array<app.Res> = array.new [%2, %4], ty array<app.Res>
    want %5
    [i6] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #6
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    ret %5
    ^b1(%6: failure) in S2:
    raise %6
}

func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Batching<object(app::Res)>" in S4
    binding b1 "$batch": array<app.Res> in S5
    binding b2 "x": app.Res in S6
    binding b3 "failure": Error in S7
    boundary B0 lexical in S3
    boundary B1 lexical in S5
    boundary B2 lexical in S5
    boundary B3 loop in S6
    boundary B4 lexical in S4
    boundary B5 lexical in S7
    selection s0: selection = union([])
    selection s1: selection = union([])
    selection s2: selection = union([])
    ^b0 in S3 unwind ^b1:
    br ^b4
    ^b1(%0: failure) in S3:
    raise %0
    ^b2(%1: int) in S3 unwind ^b1:
    want %1
    [i1] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #1
    ret %1
    ^b3(%2: failure) in S3 unwind ^b1:
    catch %2 is Error, ^b14(%2, $value), ^b15(%2)
    ^b4 in S4 unwind ^b3:
    [i2] %3: app.Walk = call @app.Walk.new#0()
    %4: "collections/iteration::Batching<object(app::Res)>" = role.wrap %3, ty "collections/iteration::Batching<object(app::Res)>"
    bind %4, binding b0
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b6
    ^b5 in S4 unwind ^b3:
    %5: int = const 0
    want %5
    [i7] exit.prepare fallthrough %5 at B4
    result.exit edge normal(0), value %5, demand want, prepare #7
    br ^b2(%5)
    ^b6 in S4 unwind ^b3:
    br ^b7
    ^b7 in S5 unwind ^b3:
    [i8] %6: array<app.Res> = call.role %4, "collections/iteration::Batching<object(app::Res)>" slot 0()
    bind %6, binding b1
    %7: int = array.len %6
    %8: int = const 0
    %9: bool = int.lt %8, %7
    high.effects at #8 failures [thrown, program, panic, native, cancelled], suspends true
    cond %9, ^b8, ^b9
    ^b8 in S5 unwind ^b3:
    br ^b10(%8)
    ^b9 in S5 unwind ^b3:
    exit.prepare fallthrough select s0 at B1
    br ^b5
    ^b10(%10: int) in S5 unwind ^b3:
    %11: bool = int.lt %10, %7
    cond %11, ^b11, ^b12
    ^b11 in S6 unwind ^b3:
    %12: app.Res = array.get %6, %10
    bind %12, binding b2
    [i17] %13: int = call @app.Res.read#0(%12)
    %14: int = const 0
    %15: int = int.mod %13, %14
    discard %15
    exit.prepare fallthrough select s2 at B3
    result.exit edge normal(0), value %15, demand discard, prepare none
    high.effects at #17 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b13
    ^b12 in S5 unwind ^b3:
    exit.prepare fallthrough select s1 at B2
    br ^b6
    ^b13 in S5 unwind ^b3:
    %16: int = const 1
    %17: int = int.add %10, %16
    br ^b10(%17)
    ^b14(%18: failure, %19: Error) in S7 unwind ^b1:
    bind %19, binding b3
    br ^b17(%18)
    ^b15(%20: failure) in S3 unwind ^b1:
    raise %20
    ^b16(%21: failure, %22: failure) in S3 unwind ^b1:
    %23: failure = fail.caused %22, %21
    raise %23
    ^b17(%24: failure) in S7 unwind ^b16(%24):
    %25: int = const 9
    want %25
    [i29] exit.prepare fallthrough %25 at B5
    result.exit edge normal(0), value %25, demand want, prepare #29
    br ^b2(%25)
}

oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}

object app.Mark {
}
scope S0 action in @app.Res.destroy
scope S1 action in @app.Mark.key#0
scope S2 action in @main
scope S3 action in @app.Res.new#0
scope S4 action in @app.Mark.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    bind %0, binding b0
    stage %0, action S3, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Mark.new#0() -> app.Mark [ctor app.Mark] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %0: app.Mark = obj.new app.Mark { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S4:
    raise %1
}

func @app.Mark.key#0(%0: app.Mark, %1: int) -> str [method app.Mark] {
    binding b0 "n": int in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    bind %1, binding b0
    %2: str = cvt %1, from int, to str
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    ret %2
    ^b1(%3: failure) in S1:
    raise %3
}

func @main() -> int [entry] {
    binding b0 "mark": app.Mark in S2
    binding b1 "a": array<app.Res> in S2
    binding b2 "m": map<str, app.Res> in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    [i0] %0: app.Mark = call @app.Mark.new#0()
    bind %0, binding b0
    %1: int = const 1
    [i3] %2: app.Res = call @app.Res.new#0(%1)
    %3: int = const 2
    [i5] %4: app.Res = call @app.Res.new#0(%3)
    %5: array<app.Res> = array.new [%2, %4], ty array<app.Res>
    bind %5, binding b1
    %6: int = const 1
    [i9] %7: str = call @app.Mark.key#0(%0, %6)
    %8: int = const 3
    [i11] %9: app.Res = call @app.Res.new#0(%8)
    %10: int = const 2
    [i13] %11: str = call @app.Mark.key#0(%0, %10)
    %12: int = const 4
    [i15] %13: app.Res = call @app.Res.new#0(%12)
    %14: int = const 1
    [i17] %15: str = call @app.Mark.key#0(%0, %14)
    %16: int = const 5
    [i19] %17: app.Res = call @app.Res.new#0(%16)
    %18: map<str, app.Res> = map.new entries [(%7, %9), (%11, %13), (%15, %17)], ty map<str, app.Res>
    bind %18, binding b2
    %19: int = map.len %18
    want %19
    [i24] exit.prepare return %19 at B0
    result.exit edge normal(0), value %19, demand want, prepare #24
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #5 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #9 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #11 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #13 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #15 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #17 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #19 failures [thrown, program, panic, native, cancelled], suspends true
    ret %19
    ^b1(%20: failure) in S2:
    raise %20
}

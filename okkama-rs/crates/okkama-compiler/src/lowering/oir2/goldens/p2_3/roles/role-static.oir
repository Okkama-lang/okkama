oir 2 high
module app
requires core
entry @main

object app.Box {
    does app.Label {label = @app.Box.label#0}
}

role app.Label {
    label() -> int
}
scope S0 action in @app.Box.label#0
scope S1 action in @main
scope S2 action in @app.Box.new#0

func @app.Box.new#0() -> app.Box [ctor app.Box] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: app.Box = obj.new app.Box { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S2:
    raise %1
}

func @app.Box.label#0(%0: app.Box) -> int [method app.Box] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = const 1
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    [i0] %0: app.Box = call @app.Box.new#0()
    [i1] %1: int = call @app.Box.label#0(%0)
    want %1
    [i3] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #3
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

oir 2 high
module app
requires core
entry @main

variant "app::Maybe<int>" = (some: "app::Maybe<int>.some", none: "app::Maybe<int>.none")

object "app::Maybe<int>.some" {
    field value: int
}

object "app::Maybe<int>.none" {
}
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    boundary B3 lexical in S1
    ^b0 in S0 unwind ^b1:
    %0: array<int> = array.new ty array<int>
    bind %0, binding b0
    %1: int = const 0
    %2: int = array.len %0
    %3: range = range.new %1, %2
    %4: "app::Maybe<int>" = variant.new ty "app::Maybe<int>", case 1
    br ^b3(%1, %0, %4)
    ^b1(%5: failure) in S0:
    raise %5
    ^b2(%6: array<int>, %7: "app::Maybe<int>") in S0 unwind ^b1:
    discard %7
    %8: int = const 0
    want %8
    [i9] exit.prepare return %8 at B0
    result.exit edge normal(0), value %7, demand discard, prepare none
    result.exit edge normal(0), value %8, demand want, prepare #9
    ret %8
    ^b3(%9: int, %10: array<int>, %11: "app::Maybe<int>") in S0 unwind ^b1:
    %12: bool = int.lt %9, %2
    cond %12, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %13: int = array.get %0, %9
    bind %13, binding b1
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%10, %11)
    ^b6(%14: array<int>, %15: "app::Maybe<int>") in S0 unwind ^b1:
    %16: int = const 1
    %17: int = int.add %9, %16
    br ^b3(%17, %14, %15)
    ^b7(%18: bool, %19: array<int>, %20: int, %21: "app::Maybe<int>") in S1 unwind ^b1:
    cond %18, ^b9, ^b10
    ^b8 in S2 unwind ^b1:
    %22: int = const 0
    %23: bool = int.gt %13, %22
    want %23
    [i18] exit.prepare fallthrough %23 at B2
    want %10
    [i20] exit.prepare fallthrough %10 at B2
    want %13
    [i22] exit.prepare fallthrough %13 at B2
    want %11
    [i24] exit.prepare fallthrough %11 at B2
    result.exit edge normal(0), value %23, demand want, prepare #18
    result.exit edge normal(0), value %10, demand want, prepare #20
    result.exit edge normal(0), value %13, demand want, prepare #22
    result.exit edge normal(0), value %11, demand want, prepare #24
    br ^b7(%23, %10, %13, %11)
    ^b9 in S1 unwind ^b1:
    %24: "app::Maybe<int>" = variant.new [%20], ty "app::Maybe<int>", case 0
    want %19
    [i27] exit.prepare fallthrough %19 at B3
    want %24
    [i29] exit.prepare fallthrough %24 at B3
    result.exit edge normal(0), value %19, demand want, prepare #27
    result.exit edge normal(0), value %24, demand want, prepare #29
    br ^b2(%19, %24)
    ^b10 in S1 unwind ^b1:
    want %19
    [i31] exit.prepare fallthrough %19 at B1
    want %21
    [i33] exit.prepare fallthrough %21 at B1
    result.exit edge normal(0), value %19, demand want, prepare #31
    result.exit edge normal(0), value %21, demand want, prepare #33
    br ^b6(%19, %21)
}

oir 2 high
module app
requires core
entry @main

object app.Box {
    does app.Label {label = @app.Box.label#0}
}

object app.Other {
    does app.Label {label = @app.Other.label#0}
}

role app.Label {
    label() -> int
}
scope S0 action in @app.Box.label#0
scope S1 action in @app.Other.label#0
scope S2 action in @main
scope S3 action in @app.Box.new#0
scope S4 action in @app.Other.new#0

func @app.Box.new#0() -> app.Box [ctor app.Box] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: app.Box = obj.new app.Box { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S3:
    raise %1
}

func @app.Box.label#0(%0: app.Box) -> int [method app.Box] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = const 1
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Other.new#0() -> app.Other [ctor app.Other] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %0: app.Other = obj.new app.Other { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S4:
    raise %1
}

func @app.Other.label#0(%0: app.Other) -> int [method app.Other] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = const 2
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "a": app.Label in S2
    binding b1 "b": app.Label in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    [i0] %0: app.Box = call @app.Box.new#0()
    %1: app.Label = role.wrap %0, ty app.Label
    bind %1, binding b0
    [i3] %2: app.Other = call @app.Other.new#0()
    %3: app.Label = role.wrap %2, ty app.Label
    bind %3, binding b1
    [i6] %4: int = call.role %1, app.Label slot 0()
    [i7] %5: int = call.role %3, app.Label slot 0()
    %6: int = int.add %4, %5
    want %6
    [i10] exit.prepare return %6 at B0
    result.exit edge normal(0), value %6, demand want, prepare #10
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #7 failures [thrown, program, panic, native, cancelled], suspends true
    ret %6
    ^b1(%7: failure) in S2:
    raise %7
}

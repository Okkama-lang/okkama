oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: range = range.new %0, %1, inclusive true
    %3: builder<int> = builder.new element int
    br ^b3(%0, %3)
    ^b1(%4: failure) in S0:
    raise %4
    ^b2(%5: builder<int>) in S0 unwind ^b14(%5):
    %6: array<int> = builder.finish %5
    discard %6
    %7: int = const 0
    want %7
    [i8] exit.prepare return %7 at B0
    result.exit edge normal(0), value %6, demand discard, prepare none
    result.exit edge normal(0), value %7, demand want, prepare #8
    ret %7
    ^b3(%8: int, %9: builder<int>) in S0 unwind ^b1:
    %10: bool = int.le %8, %1
    cond %10, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %8, binding b0
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%9)
    ^b6(%11: builder<int>) in S0 unwind ^b1:
    %12: int = const 1
    %13: int = int.add %8, %12
    br ^b3(%13, %11)
    ^b7(%14: bool, %15: int, %16: builder<int>) in S1 unwind ^b1:
    cond %14, ^b10, ^b11
    ^b8 in S2 unwind ^b1:
    %17: int = const 0
    %18: bool = int.gt %8, %17
    want %18
    [i16] exit.prepare fallthrough %18 at B2
    want %8
    [i18] exit.prepare fallthrough %8 at B2
    result.exit edge normal(0), value %18, demand want, prepare #16
    result.exit edge normal(0), value %8, demand want, prepare #18
    br ^b7(%18, %8, %9)
    ^b9(%19: int, %20: builder<int>) in S1 unwind ^b1:
    exit.prepare fallthrough select s0 at B1
    br ^b6(%20)
    ^b10 in S1 unwind ^b1:
    br ^b12(%15, %16)
    ^b11 in S1 unwind ^b1:
    br ^b9(%15, %16)
    ^b12(%21: int, %22: builder<int>) in S1 unwind ^b13(%22):
    %23: builder<int> = builder.push %22, %8
    br ^b9(%21, %23)
    ^b13(%24: builder<int>, %25: failure) in S1 unwind ^b1:
    builder.abandon %24
    raise %25
    ^b14(%26: builder<int>, %27: failure) in S0 unwind ^b1:
    builder.abandon %26
    raise %27
}

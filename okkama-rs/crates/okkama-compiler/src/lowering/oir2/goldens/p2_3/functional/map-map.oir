oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": map<int, int> in S0
    binding b1 "key": int in S1
    binding b2 "value": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: int = const 3
    %3: int = const 4
    %4: map<int, int> = map.new entries [(%0, %1), (%2, %3)], ty map<int, int>
    bind %4, binding b0
    %5: int = const 0
    %6: int = map.len %4
    %7: range = range.new %5, %6
    %8: builder<int> = builder.new element int
    br ^b3(%5, %4, %8)
    ^b1(%9: failure) in S0:
    raise %9
    ^b2(%10: map<int, int>, %11: builder<int>) in S0 unwind ^b12(%11):
    %12: array<int> = builder.finish %11
    discard %12
    %13: int = const 0
    want %13
    [i14] exit.prepare return %13 at B0
    result.exit edge normal(0), value %12, demand discard, prepare none
    result.exit edge normal(0), value %13, demand want, prepare #14
    ret %13
    ^b3(%14: int, %15: map<int, int>, %16: builder<int>) in S0 unwind ^b1:
    %17: bool = int.lt %14, %6
    cond %17, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    br ^b7(%15, %16)
    ^b5 in S0 unwind ^b1:
    br ^b2(%15, %16)
    ^b6(%18: map<int, int>, %19: builder<int>) in S0 unwind ^b1:
    %20: int = const 1
    %21: int = int.add %14, %20
    br ^b3(%21, %18, %19)
    ^b7(%22: map<int, int>, %23: builder<int>) in S1 unwind ^b8(%23):
    %24: int = map.key_at %4, %14
    %25: int = map.value_at %4, %14
    bind %24, binding b1
    bind %25, binding b2
    br ^b10
    ^b8(%26: builder<int>, %27: failure) in S1 unwind ^b1:
    builder.abandon %26
    raise %27
    ^b9(%28: int, %29: map<int, int>, %30: int, %31: int, %32: builder<int>) in S1 unwind ^b11(%32):
    %33: builder<int> = builder.push %32, %28
    want %29
    [i25] exit.prepare fallthrough %29 at B1
    result.exit edge normal(0), value %29, demand want, prepare #25
    br ^b6(%29, %33)
    ^b10 in S2 unwind ^b1:
    %34: int = int.add %24, %25
    want %34
    [i28] exit.prepare fallthrough %34 at B2
    want %22
    [i30] exit.prepare fallthrough %22 at B2
    want %24
    [i32] exit.prepare fallthrough %24 at B2
    want %25
    [i34] exit.prepare fallthrough %25 at B2
    result.exit edge normal(0), value %34, demand want, prepare #28
    result.exit edge normal(0), value %22, demand want, prepare #30
    result.exit edge normal(0), value %24, demand want, prepare #32
    result.exit edge normal(0), value %25, demand want, prepare #34
    br ^b9(%34, %22, %24, %25, %23)
    ^b11(%35: builder<int>, %36: failure) in S1 unwind ^b1:
    builder.abandon %35
    raise %36
    ^b12(%37: builder<int>, %38: failure) in S0 unwind ^b1:
    builder.abandon %37
    raise %38
}

oir 2 high
module app
requires core
entry @main

object app.Both {
    does app.Named {name = @app.Both.name#0}
    does app.Labeled {name = @app.Both.name#0, label = @app.Both.label#1}
}

role app.Named {
    name() -> int
}

role app.Labeled {
    name() -> int
    label() -> int
}
scope S0 action in @app.Both.name#0
scope S1 action in @app.Both.label#1
scope S2 action in @main
scope S3 action in @app.Both.new#0

func @app.Both.new#0() -> app.Both [ctor app.Both] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: app.Both = obj.new app.Both { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S3:
    raise %1
}

func @app.Both.name#0(%0: app.Both) -> int [method app.Both] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = const 1
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Both.label#1(%0: app.Both) -> int [method app.Both] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = const 2
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "full": app.Labeled in S2
    binding b1 "view": app.Named in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    [i0] %0: app.Both = call @app.Both.new#0()
    %1: app.Labeled = role.wrap %0, ty app.Labeled
    bind %1, binding b0
    %2: app.Named = role.narrow %1, ty app.Named
    bind %2, binding b1
    [i5] %3: int = call.role %2, app.Named slot 0()
    want %3
    [i7] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #7
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #5 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b1(%4: failure) in S2:
    raise %4
}

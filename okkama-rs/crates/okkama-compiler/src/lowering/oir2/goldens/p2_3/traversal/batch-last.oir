oir 2 high
module app
requires core
entry @main

object app.Walk {
    field values: array<int>
    does "collections/iteration::Batching<int>" {batch = @app.Walk.batch#0}
}

role "collections/iteration::Batching<int>" {
    batch() -> array<int>
}
scope S0 action in @app.Walk.batch#0
scope S1 action in @main
scope S2 block in @main parent S1
scope S3 iteration in @main parent S2
scope S4 branch in @main parent S3
scope S5 branch in @main parent S3
scope S6 action in @app.Walk.new#0

func @app.Walk.new#0(%0: array<int>) -> app.Walk [ctor app.Walk] {
    binding b0 "values": array<int> in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: array<int> = undef ty array<int>
    stage %0, action S6, field field_ref(declaration=app.Walk, index=0)
    bind %0, binding b0
    %2: app.Walk = obj.new app.Walk { values: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Walk.batch#0(%0: app.Walk) -> array<int> [method app.Walk] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: array<int> = obj.get %0, values
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Batching<int>" in S1
    binding b1 "$batch": array<int> in S2
    binding b2 "x": int in S3
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    boundary B2 lexical in S2
    boundary B3 loop in S3
    boundary B4 lexical in S5
    selection s0: selection = union([])
    selection s1: selection = union([])
    selection s2: selection = union([])
    selection s3: selection = union([])
    ^b0 in S1 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    [i3] %3: app.Walk = call @app.Walk.new#0(%2)
    %4: "collections/iteration::Batching<int>" = role.wrap %3, ty "collections/iteration::Batching<int>"
    bind %4, binding b0
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3
    ^b1(%5: failure) in S1:
    raise %5
    ^b2 in S1 unwind ^b1:
    %6: int = const 0
    want %6
    [i8] exit.prepare return %6 at B0
    result.exit edge normal(0), value %6, demand want, prepare #8
    ret %6
    ^b3 in S1 unwind ^b1:
    br ^b4
    ^b4 in S2 unwind ^b1:
    [i9] %7: array<int> = call.role %4, "collections/iteration::Batching<int>" slot 0()
    bind %7, binding b1
    %8: int = array.len %7
    %9: int = const 0
    %10: bool = int.lt %9, %8
    high.effects at #9 failures [thrown, program, panic, native, cancelled], suspends true
    cond %10, ^b5, ^b6
    ^b5 in S2 unwind ^b1:
    br ^b7(%9)
    ^b6 in S2 unwind ^b1:
    exit.prepare fallthrough select s0 at B1
    br ^b2
    ^b7(%11: int) in S2 unwind ^b1:
    %12: bool = int.lt %11, %8
    cond %12, ^b8, ^b9
    ^b8 in S3 unwind ^b1:
    %13: int = array.get %7, %11
    bind %13, binding b2
    %14: int = const 1
    %15: bool = int.eq %13, %14
    cond %15, ^b12(%13), ^b13(%13)
    ^b9 in S2 unwind ^b1:
    exit.prepare fallthrough select s1 at B2
    br ^b3
    ^b10 in S2 unwind ^b1:
    %16: int = const 1
    %17: int = int.add %11, %16
    br ^b7(%17)
    ^b11(%18: int) in S3 unwind ^b1:
    discard %18
    exit.prepare fallthrough select s3 at B3
    result.exit edge normal(0), value %18, demand discard, prepare none
    br ^b10
    ^b12(%19: int) in S4 unwind ^b1:
    exit.prepare last select s2 at B3
    br ^b2
    ^b13(%20: int) in S5 unwind ^b1:
    want %20
    [i27] exit.prepare fallthrough %20 at B4
    result.exit edge normal(0), value %20, demand want, prepare #27
    br ^b11(%20)
}

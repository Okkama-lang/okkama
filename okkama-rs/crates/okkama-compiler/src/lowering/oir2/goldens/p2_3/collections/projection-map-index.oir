oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}

object app.Select {
}
scope S0 action in @app.Res.destroy
scope S1 action in @app.Select.fresh#0
scope S2 block in @app.Select.fresh#0 parent S1
scope S3 action in @app.Select.borrowed#1
scope S4 block in @app.Select.borrowed#1 parent S3
scope S5 action in @main
scope S6 action in @app.Res.new#0
scope S7 action in @app.Select.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: int = undef ty int
    bind %0, binding b0
    stage %0, action S6, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Select.new#0() -> app.Select [ctor app.Select] {
    boundary B0 lexical in S7
    ^b0 in S7 unwind ^b1:
    %0: app.Select = obj.new app.Select { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S7:
    raise %1
}

func @app.Select.fresh#0(%0: app.Select) -> app.Res [method app.Select] {
    binding b0 "a": app.Res in S1
    binding b1 "b": app.Res in S1
    binding b2 "xs": map<str, app.Res> in S1
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    ^b0 in S1 unwind ^b1:
    %1: int = const 1
    [i1] %2: app.Res = call @app.Res.new#0(%1)
    bind %2, binding b0
    %3: int = const 2
    [i4] %4: app.Res = call @app.Res.new#0(%3)
    bind %4, binding b1
    %5: str = const "a"
    %6: str = const "b"
    %7: str = const "c"
    %8: map<str, app.Res> = map.new entries [(%5, %2), (%6, %2), (%7, %4)], ty map<str, app.Res>
    bind %8, binding b2
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3
    ^b1(%9: failure) in S1:
    raise %9
    ^b2(%10: app.Res, %11: app.Res, %12: app.Res, %13: map<str, app.Res>) in S1 unwind ^b1:
    want %10
    [i12] exit.prepare return %10 at B0
    result.exit edge normal(0), value %10, demand want, prepare #12
    ret %10
    ^b3 in S2 unwind ^b1:
    %14: int = const 0
    %15: app.Res = map.value_at %8, %14
    want %15
    [i16] exit.prepare fallthrough %15 at B1
    want %2
    [i18] exit.prepare fallthrough %2 at B1
    want %4
    [i20] exit.prepare fallthrough %4 at B1
    want %8
    [i22] exit.prepare fallthrough %8 at B1
    result.exit edge normal(0), value %15, demand want, prepare #16
    result.exit edge normal(0), value %2, demand want, prepare #18
    result.exit edge normal(0), value %4, demand want, prepare #20
    result.exit edge normal(0), value %8, demand want, prepare #22
    br ^b2(%15, %2, %4, %8)
}

func @app.Select.borrowed#1(%0: app.Select, %1: map<str, app.Res>, %2: int) -> app.Res [method app.Select] {
    binding b0 "xs": map<str, app.Res> in S3
    binding b1 "i": int in S3
    boundary B0 lexical in S3
    boundary B1 lexical in S4
    ^b0 in S3 unwind ^b1:
    bind %1, binding b0
    bind %2, binding b1
    br ^b3
    ^b1(%3: failure) in S3:
    raise %3
    ^b2(%4: app.Res, %5: map<str, app.Res>, %6: int) in S3 unwind ^b1:
    want %4
    [i3] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #3
    ret %4
    ^b3 in S4 unwind ^b1:
    %7: app.Res = map.value_at %1, %2
    want %7
    [i6] exit.prepare fallthrough %7 at B1
    want %1
    [i8] exit.prepare fallthrough %1 at B1
    want %2
    [i10] exit.prepare fallthrough %2 at B1
    result.exit edge normal(0), value %7, demand want, prepare #6
    result.exit edge normal(0), value %1, demand want, prepare #8
    result.exit edge normal(0), value %2, demand want, prepare #10
    br ^b2(%7, %1, %2)
}

func @main() -> int [entry] {
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %0: int = const 0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S5:

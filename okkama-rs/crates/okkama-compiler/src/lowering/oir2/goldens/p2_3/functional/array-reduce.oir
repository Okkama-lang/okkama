oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": array<int> in S0
    binding b1 "acc": int in S1
    binding b2 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    bind %2, binding b0
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: int = const 0
    br ^b3(%3, %2, %6)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: array<int>, %9: int) in S0 unwind ^b1:
    discard %9
    %10: int = const 0
    want %10
    [i11] exit.prepare return %10 at B0
    result.exit edge normal(0), value %9, demand discard, prepare none
    result.exit edge normal(0), value %10, demand want, prepare #11
    ret %10
    ^b3(%11: int, %12: array<int>, %13: int) in S0 unwind ^b1:
    %14: bool = int.lt %11, %4
    cond %14, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %15: int = array.get %2, %11
    bind %13, binding b1
    bind %15, binding b2
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%12, %13)
    ^b6(%16: array<int>, %17: int) in S0 unwind ^b1:
    %18: int = const 1
    %19: int = int.add %11, %18
    br ^b3(%19, %16, %17)
    ^b7(%20: int, %21: array<int>, %22: int, %23: int, %24: int) in S1 unwind ^b1:
    want %21
    [i19] exit.prepare fallthrough %21 at B1
    want %20
    [i21] exit.prepare fallthrough %20 at B1
    result.exit edge normal(0), value %21, demand want, prepare #19
    result.exit edge normal(0), value %20, demand want, prepare #21
    br ^b6(%21, %20)
    ^b8 in S2 unwind ^b1:
    %25: int = int.add %13, %15
    want %25
    [i24] exit.prepare fallthrough %25 at B2
    want %12
    [i26] exit.prepare fallthrough %12 at B2
    want %13
    [i28] exit.prepare fallthrough %13 at B2
    want %15
    [i30] exit.prepare fallthrough %15 at B2
    result.exit edge normal(0), value %25, demand want, prepare #24
    result.exit edge normal(0), value %12, demand want, prepare #26
    result.exit edge normal(0), value %13, demand want, prepare #28
    result.exit edge normal(0), value %15, demand want, prepare #30
    br ^b7(%25, %12, %13, %15, %13)
}

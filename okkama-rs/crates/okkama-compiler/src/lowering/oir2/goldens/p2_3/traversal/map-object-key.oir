oir 2 high
module app
requires core
entry @main

object app.Key {
    field rank: int
    field share: rat
}
scope S0 action in @app.Key.value#0
scope S1 action in @main
scope S2 iteration in @main parent S1
scope S3 action in @app.Key.new#0

func @app.Key.new#0(%0: int, %1: rat) -> app.Key [ctor app.Key] {
    binding b0 "rank": int in S3
    binding b1 "share": rat in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %2: int = undef ty int
    %3: rat = undef ty rat
    stage %0, action S3, field field_ref(declaration=app.Key, index=0)
    stage %1, action S3, field field_ref(declaration=app.Key, index=1)
    bind %0, binding b0
    bind %1, binding b1
    %4: app.Key = obj.new app.Key { rank: %0, share: %1 }
    want %4
    [i8] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #8
    ret %4
    ^b1(%5: failure) in S3:
    raise %5
}

func @app.Key.value#0(%0: app.Key) -> int [method app.Key] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, rank
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "values": map<app.Key, int> in S1
    binding b1 "key": app.Key in S2
    boundary B0 lexical in S1
    boundary B1 loop in S2
    ^b0 in S1 unwind ^b1:
    %0: int = const 2
    %1: int = const 1
    %2: rat = cvt %1, from int, to rat
    [i3] %3: app.Key = call @app.Key.new#0(%0, %2)
    %4: int = const 1
    %5: int = const 1
    %6: int = const 2
    %7: rat = cvt %6, from int, to rat
    [i8] %8: app.Key = call @app.Key.new#0(%5, %7)
    %9: int = const 2
    %10: map<app.Key, int> = map.new entries [(%3, %4), (%8, %9)], ty map<app.Key, int>
    bind %10, binding b0
    %11: array<app.Key> = map.keys %10
    %12: int = const 0
    %13: int = array.len %11
    %14: range = range.new %12, %13
    %15: bool = const false
    %16: int = const 0
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #8 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%12, %15, %16, %10)
    ^b1(%17: failure) in S1:
    raise %17
    ^b2(%18: int, %19: map<app.Key, int>) in S1 unwind ^b1:
    want %18
    [i19] exit.prepare return %18 at B0
    result.exit edge normal(0), value %18, demand want, prepare #19
    ret %18
    ^b3(%20: int, %21: bool, %22: int, %23: map<app.Key, int>) in S1 unwind ^b1:
    %24: bool = int.lt %20, %13
    cond %24, ^b4, ^b5
    ^b4 in S2 unwind ^b1:
    %25: app.Key = array.get %11, %20
    bind %25, binding b1
    [i23] %26: int = call @app.Key.value#0(%25)
    %27: bool = const true
    want %27
    [i26] exit.prepare fallthrough %27 at B1
    want %26
    [i28] exit.prepare fallthrough %26 at B1
    want %23
    [i30] exit.prepare fallthrough %23 at B1
    result.exit edge normal(0), value %27, demand want, prepare #26
    result.exit edge normal(0), value %26, demand want, prepare #28
    result.exit edge normal(0), value %23, demand want, prepare #30
    high.effects at #23 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b8(%27, %26, %23)
    ^b5 in S1 unwind ^b1:
    cond %21, ^b6, ^b7
    ^b6 in S1 unwind ^b1:
    br ^b2(%22, %23)
    ^b7 in S1 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%28: bool, %29: int, %30: map<app.Key, int>) in S1 unwind ^b1:
    %31: int = const 1
    %32: int = int.add %20, %31
    br ^b3(%32, %28, %29, %30)
}

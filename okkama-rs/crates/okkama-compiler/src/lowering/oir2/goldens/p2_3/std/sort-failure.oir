oir 2 high
module app
requires core
entry @main

object app.Item {
    field number: int
    does "compare::Comparing<object(app::Item)>" {order = @app.Item.order#1}
}

role "compare::Comparing<object(app::Item)>" {
    order(app.Item) -> compare.Order
}

enum compare.Order = (less, equal, greater)

enum app.Refused is Error = (no)
scope S0 action in @app.Item.number#0
scope S1 action in @app.Item.order#1
scope S2 branch in @app.Item.order#1 parent S1
scope S3 branch in @app.Item.order#1 parent S1
scope S4 action in @main
scope S5 try in @main parent S4
scope S6 iteration in @main parent S5
scope S7 catch in @main parent S4
scope S8 action in @app.Item.new#0

func @app.Item.new#0(%0: int) -> app.Item [ctor app.Item] {
    binding b0 "number": int in S8
    boundary B0 lexical in S8
    ^b0 in S8 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S8, field field_ref(declaration=app.Item, index=0)
    bind %0, binding b0
    %2: app.Item = obj.new app.Item { number: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S8:
    raise %3
}

func @app.Item.number#0(%0: app.Item) -> int [method app.Item] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, number
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Item.order#1(%0: app.Item, %1: app.Item) -> compare.Order [method app.Item] {
    binding b0 "other": app.Item in S1
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    boundary B2 lexical in S3
    ^b0 in S1 unwind ^b1:
    bind %1, binding b0
    %2: int = obj.get %0, number
    %3: int = const 7
    %4: bool = int.ne %2, %3
    cond %4, ^b3(%1), ^b4(%1)
    ^b1(%5: failure) in S1:
    raise %5
    ^b2(%6: bool, %7: app.Item) in S1 unwind ^b1:
    cond %6, ^b5(%7), ^b6(%7)
    ^b3(%8: app.Item) in S2 unwind ^b1:
    [i4] %9: int = call @app.Item.number#0(%8)
    %10: int = const 7
    %11: bool = int.ne %9, %10
    want %11
    [i8] exit.prepare fallthrough %11 at B1
    want %8
    [i10] exit.prepare fallthrough %8 at B1
    result.exit edge normal(0), value %11, demand want, prepare #8
    result.exit edge normal(0), value %8, demand want, prepare #10
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b2(%11, %8)
    ^b4(%12: app.Item) in S3 unwind ^b1:
    %13: bool = const false
    want %13
    [i13] exit.prepare fallthrough %13 at B2
    want %12
    [i15] exit.prepare fallthrough %12 at B2
    result.exit edge normal(0), value %13, demand want, prepare #13
    result.exit edge normal(0), value %12, demand want, prepare #15
    br ^b2(%13, %12)
    ^b5(%14: app.Item) in S1 unwind ^b1:
    %15: int = obj.get %0, number
    [i17] %16: int = call @app.Item.number#0(%14)
    %17: bool = int.lt %15, %16
    high.effects at #17 failures [thrown, program, panic, native, cancelled], suspends true
    cond %17, ^b8, ^b9
    ^b6(%18: app.Item) in S1 unwind ^b1:
    %19: app.Refused = enum.case app.Refused, case 0
    throw %19
    ^b7(%20: compare.Order, %21: app.Item) in S1 unwind ^b1:
    want %20
    [i21] exit.prepare return %20 at B0
    result.exit edge normal(0), value %20, demand want, prepare #21
    ret %20
    ^b8 in S1 unwind ^b1:
    %22: compare.Order = enum.case compare.Order, case 0
    br ^b7(%22, %14)
    ^b9 in S1 unwind ^b1:
    %23: bool = int.eq %15, %16
    cond %23, ^b10, ^b11
    ^b10 in S1 unwind ^b1:
    %24: compare.Order = enum.case compare.Order, case 1
    br ^b7(%24, %14)
    ^b11 in S1 unwind ^b1:
    %25: compare.Order = enum.case compare.Order, case 2
    br ^b7(%25, %14)
}

func @main() -> int [entry] {
    binding b0 "e": app.Refused in S7
    boundary B0 lexical in S4
    boundary B1 lexical in S6
    boundary B2 lexical in S5
    boundary B3 lexical in S7
    ^b0 in S4 unwind ^b1:
    br ^b4
    ^b1(%0: failure) in S4:
    raise %0
    ^b2(%1: int) in S4 unwind ^b1:
    want %1
    [i1] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #1
    ret %1
    ^b3(%2: failure) in S4 unwind ^b1:
    catch %2 is app.Refused, ^b15(%2, $value), ^b16(%2)
    ^b4 in S5 unwind ^b3:
    %3: int = const 2
    [i3] %4: app.Item = call @app.Item.new#0(%3)
    %5: int = const 7
    [i5] %6: app.Item = call @app.Item.new#0(%5)
    %7: array<app.Item> = array.new [%4, %6], ty array<app.Item>
    %8: int = const 1
    %9: int = const 0
    %10: int = array.len %7
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #5 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b5(%7, %8, %8)
    ^b5(%11: array<app.Item>, %12: int, %13: int) in S5 unwind ^b3:
    %14: bool = int.lt %12, %10
    cond %14, ^b7, ^b8
    ^b6(%15: array<app.Item>, %16: array<app.Item>, %17: int, %18: int) in S5 unwind ^b3:
    %19: int = array.len %15
    want %19
    [i13] exit.prepare fallthrough %19 at B2
    result.exit edge normal(0), value %19, demand want, prepare #13
    br ^b2(%19)
    ^b7 in S6 unwind ^b3:
    br ^b9(%11, %12, %12)
    ^b8 in S5 unwind ^b3:
    br ^b6(%11, %11, %12, %13)
    ^b9(%20: array<app.Item>, %21: int, %22: int) in S6 unwind ^b3:
    %23: bool = int.gt %22, %9
    cond %23, ^b11, ^b12
    ^b10(%24: array<app.Item>, %25: int, %26: int) in S6 unwind ^b3:
    %27: int = int.add %25, %8
    want %24
    [i17] exit.prepare next %24 at B1
    want %27
    [i19] exit.prepare next %27 at B1
    want %26
    [i21] exit.prepare next %26 at B1
    result.exit edge normal(0), value %24, demand want, prepare #17
    result.exit edge normal(0), value %27, demand want, prepare #19
    result.exit edge normal(0), value %26, demand want, prepare #21
    br ^b5(%24, %27, %26)
    ^b11 in S6 unwind ^b3:
    %28: int = int.sub %22, %8
    %29: app.Item = array.get %20, %28
    %30: app.Item = array.get %20, %22
    [i25] %31: compare.Order = call @app.Item.order#1(%29, %30)
    %32: compare.Order = enum.case compare.Order, case 2
    %33: bool = enum.eq %31, %32
    high.effects at #25 failures [thrown, program, panic, native, cancelled], suspends true
    cond %33, ^b13, ^b14
    ^b12 in S6 unwind ^b3:
    br ^b10(%20, %21, %22)
    ^b13 in S6 unwind ^b3:
    %34: array<app.Item> = array.replace %20, %28, %30
    %35: array<app.Item> = array.replace %34, %22, %29
    br ^b9(%35, %21, %28)
    ^b14 in S6 unwind ^b3:
    br ^b10(%20, %21, %22)
    ^b15(%36: failure, %37: app.Refused) in S7 unwind ^b1:
    bind %37, binding b0
    br ^b18(%36)
    ^b16(%38: failure) in S4 unwind ^b1:
    raise %38
    ^b17(%39: failure, %40: failure) in S4 unwind ^b1:
    %41: failure = fail.caused %40, %39
    raise %41
    ^b18(%42: failure) in S7 unwind ^b17(%42):
    %43: int = const -1
    want %43
    [i34] exit.prepare fallthrough %43 at B3
    result.exit edge normal(0), value %43, demand want, prepare #34
    br ^b2(%43)
}

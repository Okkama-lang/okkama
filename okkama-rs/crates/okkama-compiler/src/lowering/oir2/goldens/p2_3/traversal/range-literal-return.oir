oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0

func @main() -> int [entry] {
    binding b0 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: range = range.new %0, %1, inclusive true
    br ^b3(%0)
    ^b1(%3: failure) in S0:
    raise %3
    ^b2 in S0 unwind ^b1:
    %4: int = const 0
    want %4
    [i5] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #5
    ret %4
    ^b3(%5: int) in S0 unwind ^b1:
    %6: bool = int.le %5, %1
    cond %6, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %5, binding b0
    want %5
    [i9] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #9
    ret %5
    ^b5 in S0 unwind ^b1:
    br ^b2
    ^b6 in S0:
    unreachable
}

oir 2 high
module app
requires core
entry @main

object app.Box {
    field opened: bool = @app.Box.default#0
    does app.Package {open = @app.Box.witness.app.Package.slot0, label = @app.Box.label#1}
}

role app.Package {
    open() -> ^app.Package
    label() -> int
}
scope S0 action in @app.Box.witness.app.Package.slot0
scope S1 action in @app.Box.default#0
scope S2 action in @app.Box.open#0
scope S3 action in @app.Box.label#1
scope S4 action in @main
scope S5 action in @app.Box.new#0

func @app.Box.default#0() -> bool [default app.Box.opened] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %0: bool = const false
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S1:
    raise %1
}

func @app.Box.new#0() -> app.Box [ctor app.Box] {
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %0: bool = undef ty bool
    [i1] %1: bool = call @app.Box.default#0()
    stage %1, action S5, field field_ref(declaration=app.Box, index=0)
    %2: app.Box = obj.new app.Box { opened: %1 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S5:
    raise %3
}

func @app.Box.open#0(%0: app.Box) -> ^app.Box [successor app.Box] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: bool = obj.get %0, opened
    %2: bool = const true
    stage %2, action S2, field field_ref(declaration=app.Box, index=0)
    %3: ^app.Box = obj.next %0 { opened: %2 }
    want %3
    [i5] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #5
    ret %3
    ^b1(%4: failure) in S2:
    raise %4
}

func @app.Box.label#1(%0: app.Box) -> int [method app.Box] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = const 1
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S3:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "package": app.Package in S4
    binding b1 "opened": ^app.Package in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    [i0] %0: app.Box = call @app.Box.new#0()
    %1: app.Package = role.wrap %0, ty app.Package
    bind %1, binding b0
    [i3] %2: ^app.Package = call.role %1, app.Package slot 0()
    bind %2, binding b1
    %3: app.Package = succ.take %2, ty app.Package
    [i6] %4: int = call.role %3, app.Package slot 1()
    want %4
    [i8] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #8
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    ret %4
    ^b1(%5: failure) in S4:
    raise %5
}

func @app.Box.witness.app.Package.slot0(%0: app.Box) -> ^app.Package [method app.Box] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    [i0] %1: ^app.Box = call @app.Box.open#0(%0)
    %2: ^app.Package = role.wrap %1, ty ^app.Package
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S0:
    raise %3
}

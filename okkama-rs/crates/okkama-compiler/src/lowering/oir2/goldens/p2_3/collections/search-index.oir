oir 2 high
module app
requires core
entry @main

variant "app::Maybe<int>" = (some: "app::Maybe<int>.some", none: "app::Maybe<int>.none")

object "app::Maybe<int>.some" {
    field value: int
}

object "app::Maybe<int>.none" {
}
scope S0 action in @main

func @main() -> int [entry] {
    binding b0 "a": array<int> in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: int = const 3
    %3: array<int> = array.new [%0, %1, %2], ty array<int>
    bind %3, binding b0
    %4: int = const 4
    %5: int = const -1
    %6: int = const 0
    %7: int = array.len %3
    br ^b2(%6)
    ^b1(%8: failure) in S0:
    raise %8
    ^b2(%9: int) in S0 unwind ^b1:
    %10: bool = int.lt %9, %7
    cond %10, ^b3, ^b5(%5)
    ^b3 in S0 unwind ^b1:
    %11: int = array.get %3, %9
    %12: bool = int.eq %11, %4
    cond %12, ^b5(%9), ^b4
    ^b4 in S0 unwind ^b1:
    %13: int = const 1
    %14: int = int.add %9, %13
    br ^b2(%14)
    ^b5(%15: int) in S0 unwind ^b1:
    %16: int = const 0
    %17: bool = int.ge %15, %16
    cond %17, ^b6, ^b7
    ^b6 in S0 unwind ^b1:
    %18: "app::Maybe<int>" = variant.new [%15], ty "app::Maybe<int>", case 0
    br ^b8(%18, %3)
    ^b7 in S0 unwind ^b1:
    %19: "app::Maybe<int>" = variant.new ty "app::Maybe<int>", case 1
    br ^b8(%19, %3)
    ^b8(%20: "app::Maybe<int>", %21: array<int>) in S0 unwind ^b1:
    discard %20
    %22: int = const 0
    want %22
    [i21] exit.prepare return %22 at B0
    result.exit edge normal(0), value %20, demand discard, prepare none
    result.exit edge normal(0), value %22, demand want, prepare #21
    ret %22
}

oir 2 high
module app
requires core
entry @main
scope S0 action in @main

func @main() -> int [entry] {
    binding b0 "a": array<int> in S0
    binding b1 "b": array<int> in S0
    binding b2 "sum": array<int> in S0
    binding b3 "diff": array<int> in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: int = const 3
    %3: array<int> = array.new [%0, %1, %2], ty array<int>
    bind %3, binding b0
    %4: int = const 3
    %5: int = const 4
    %6: array<int> = array.new [%4, %5], ty array<int>
    bind %6, binding b1
    %7: array<int> = array.concat [%3, %6], ty array<int>
    bind %7, binding b2
    %8: array<int> = array.difference %3, [%6]
    bind %8, binding b3
    %9: int = array.len %3
    discard %9
    %10: int = const 0
    %11: int = array.get %3, %10
    discard %11
    %12: int = const 0
    result.exit edge normal(0), value %9, demand discard, prepare none
    result.exit edge normal(0), value %11, demand discard, prepare none
    br ^b4
    ^b1(%13: failure) in S0:
    raise %13
    ^b2(%14: int) in S0 unwind ^b1:
    discard %14
    %15: int = array.len %3
    %16: int = const 1
    %17: int = int.sub %15, %16
    result.exit edge normal(0), value %14, demand discard, prepare none
    br ^b7
    ^b3 in S0 unwind ^b1:
    trap empty "Cannot read first item of an empty sequence"
    ^b4 in S0 unwind ^b1:
    array.lookup %3, %12, ^b2($value), ^b3
    ^b5(%18: int) in S0 unwind ^b1:
    discard %18
    %19: int = const 0
    %20: int = const 2
    %21: array<int> = array.slice %3, %19, %20
    discard %21
    %22: int = const 1
    %23: int = const 9
    %24: array<int> = array.replace %3, %22, %23
    discard %24
    %25: int = const 0
    %26: array<int> = array.remove %3, %25
    discard %26
    %27: str = const "a"
    %28: str = const "b"
    %29: array<str> = array.new [%27, %28], ty array<str>
    %30: str = const ","
    %31: str = array.join %29, %30
    discard %31
    %32: int = const 0
    want %32
    [i43] exit.prepare return %32 at B0
    result.exit edge normal(0), value %18, demand discard, prepare none
    result.exit edge normal(0), value %21, demand discard, prepare none
    result.exit edge normal(0), value %24, demand discard, prepare none
    result.exit edge normal(0), value %26, demand discard, prepare none
    result.exit edge normal(0), value %31, demand discard, prepare none
    result.exit edge normal(0), value %32, demand want, prepare #43
    ret %32
    ^b6 in S0 unwind ^b1:
    trap empty "Cannot read last item of an empty sequence"
    ^b7 in S0 unwind ^b1:
    array.lookup %3, %17, ^b5($value), ^b6
}

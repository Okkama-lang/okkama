oir 2 high
module app
requires core
entry @main

object app.Walk {
    field values: array<int>
    does "collections/iteration::Batching<int>" {batch = @app.Walk.batch#0}
}

role "collections/iteration::Batching<int>" {
    batch() -> array<int>
}
scope S0 action in @app.Walk.batch#0
scope S1 action in @main
scope S2 block in @main parent S1
scope S3 iteration in @main parent S2
scope S4 block in @main parent S3
scope S5 iteration in @main parent S4
scope S6 action in @app.Walk.new#0

func @app.Walk.new#0(%0: array<int>) -> app.Walk [ctor app.Walk] {
    binding b0 "values": array<int> in S6

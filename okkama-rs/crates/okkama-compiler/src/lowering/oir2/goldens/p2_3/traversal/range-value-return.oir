oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0

func @main() -> int [entry] {
    binding b0 "r": range in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: range = range.new %0, %1, inclusive true
    bind %2, binding b0
    %3: int = range.start %2
    %4: int = range.len %2
    %5: int = int.add %3, %4
    %6: range = range.new %3, %5
    br ^b3(%3, %2)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: range) in S0 unwind ^b1:
    %9: int = const 0
    want %9
    [i10] exit.prepare return %9 at B0
    result.exit edge normal(0), value %9, demand want, prepare #10
    ret %9
    ^b3(%10: int, %11: range) in S0 unwind ^b1:
    %12: bool = int.lt %10, %5
    cond %12, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %10, binding b1
    want %10
    [i14] exit.prepare return %10 at B0
    result.exit edge normal(0), value %10, demand want, prepare #14
    ret %10
    ^b5 in S0 unwind ^b1:
    br ^b2(%11)
    ^b6 in S0:
    unreachable
}

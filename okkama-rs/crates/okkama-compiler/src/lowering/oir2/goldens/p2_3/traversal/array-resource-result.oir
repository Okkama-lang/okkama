oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}

object app.Walk {
}
scope S0 action in @app.Res.destroy
scope S1 action in @app.Walk.result#0
scope S2 iteration in @app.Walk.result#0 parent S1
scope S3 action in @main
scope S4 action in @app.Res.new#0
scope S5 action in @app.Walk.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S4, field field_ref(declaration=app.Res, index=0)
    bind %0, binding b0
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Walk.new#0() -> app.Walk [ctor app.Walk] {
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %0: app.Walk = obj.new app.Walk { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S5:
    raise %1
}

func @app.Walk.result#0(%0: app.Walk, %1: array<int>) -> app.Res [method app.Walk] {
    binding b0 "xs": array<int> in S1
    binding b1 "n": int in S2
    boundary B0 lexical in S1
    boundary B1 loop in S2
    ^b0 in S1 unwind ^b1:
    bind %1, binding b0
    %2: int = const 0
    %3: int = array.len %1
    %4: range = range.new %2, %3
    %5: bool = const false
    %6: array<app.Res> = array.new ty array<app.Res>
    br ^b3(%2, %5, %6, %1)
    ^b1(%7: failure) in S1:
    raise %7
    ^b2(%8: app.Res, %9: array<int>) in S1 unwind ^b1:
    want %8
    [i7] exit.prepare return %8 at B0
    result.exit edge normal(0), value %8, demand want, prepare #7
    ret %8
    ^b3(%10: int, %11: bool, %12: array<app.Res>, %13: array<int>) in S1 unwind ^b1:
    %14: bool = int.lt %10, %3
    cond %14, ^b4, ^b5
    ^b4 in S2 unwind ^b1:
    %15: int = array.get %1, %10
    bind %15, binding b1
    [i11] %16: app.Res = call @app.Res.new#0(%15)
    %17: bool = const true
    %18: array<app.Res> = array.new [%16], ty array<app.Res>
    want %17
    [i15] exit.prepare fallthrough %17 at B1
    want %18
    [i17] exit.prepare fallthrough %18 at B1
    want %13
    [i19] exit.prepare fallthrough %13 at B1
    result.exit edge normal(0), value %17, demand want, prepare #15
    result.exit edge normal(0), value %18, demand want, prepare #17
    result.exit edge normal(0), value %13, demand want, prepare #19
    high.effects at #11 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b8(%17, %18, %13)
    ^b5 in S1 unwind ^b1:
    cond %11, ^b6, ^b7
    ^b6 in S1 unwind ^b1:
    %19: int = const 0
    %20: app.Res = array.get %12, %19
    br ^b2(%20, %13)
    ^b7 in S1 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%21: bool, %22: array<app.Res>, %23: array<int>) in S1 unwind ^b1:
    %24: int = const 1
    %25: int = int.add %10, %24
    br ^b3(%25, %21, %22, %23)
}

func @main() -> int [entry] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: int = const 0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S3:
    raise %1
}

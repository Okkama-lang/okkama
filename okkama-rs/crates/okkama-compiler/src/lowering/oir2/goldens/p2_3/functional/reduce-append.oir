oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "initial": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: array<int> = array.new ty array<int>
    bind %0, binding b0
    %1: int = const 1
    %2: int = const 2
    %3: array<int> = array.new [%1, %2], ty array<int>
    %4: int = const 0
    %5: int = array.len %3
    %6: range = range.new %4, %5
    %7: builder<int> = builder.new element int
    br ^b2(%0, %7)
    ^b1(%8: failure) in S0:
    raise %8
    ^b2(%9: array<int>, %10: builder<int>) in S0 unwind ^b3(%10):
    %11: builder<int> = builder.append %10, %0
    br ^b5(%4, %9, %11)
    ^b3(%12: builder<int>, %13: failure) in S0 unwind ^b1:
    builder.abandon %12
    raise %13
    ^b4(%14: array<int>, %15: builder<int>) in S0 unwind ^b14(%15):
    %16: array<int> = builder.finish %15
    discard %16
    %17: int = const 0
    want %17
    [i15] exit.prepare return %17 at B0
    result.exit edge normal(0), value %16, demand discard, prepare none
    result.exit edge normal(0), value %17, demand want, prepare #15
    ret %17
    ^b5(%18: int, %19: array<int>, %20: builder<int>) in S0 unwind ^b1:
    %21: bool = int.lt %18, %5
    cond %21, ^b6, ^b7
    ^b6 in S1 unwind ^b1:
    br ^b9(%19, %20)
    ^b7 in S0 unwind ^b1:
    br ^b4(%19, %20)
    ^b8(%22: array<int>, %23: builder<int>) in S0 unwind ^b1:
    %24: int = const 1
    %25: int = int.add %18, %24
    br ^b5(%25, %22, %23)
    ^b9(%26: array<int>, %27: builder<int>) in S1 unwind ^b10(%27):
    %28: int = array.get %3, %18
    bind %28, binding b1
    br ^b12
    ^b10(%29: builder<int>, %30: failure) in S1 unwind ^b1:
    builder.abandon %29
    raise %30
    ^b11(%31: array<int>, %32: array<int>, %33: int, %34: builder<int>) in S1 unwind ^b13(%34):
    %35: builder<int> = builder.append %34, %31
    want %32
    [i24] exit.prepare fallthrough %32 at B1
    result.exit edge normal(0), value %32, demand want, prepare #24
    br ^b8(%32, %35)
    ^b12 in S2 unwind ^b1:
    %36: array<int> = array.new [%28], ty array<int>
    want %36
    [i27] exit.prepare fallthrough %36 at B2
    want %26
    [i29] exit.prepare fallthrough %26 at B2
    want %28
    [i31] exit.prepare fallthrough %28 at B2
    result.exit edge normal(0), value %36, demand want, prepare #27
    result.exit edge normal(0), value %26, demand want, prepare #29
    result.exit edge normal(0), value %28, demand want, prepare #31
    br ^b11(%36, %26, %28, %27)
    ^b13(%37: builder<int>, %38: failure) in S1 unwind ^b1:
    builder.abandon %37
    raise %38
    ^b14(%39: builder<int>, %40: failure) in S0 unwind ^b1:
    builder.abandon %39
    raise %40
}

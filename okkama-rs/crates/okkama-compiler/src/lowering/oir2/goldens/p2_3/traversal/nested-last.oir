oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 iteration in @main parent S1
scope S3 branch in @main parent S1
scope S4 branch in @main parent S1

func @main() -> int [entry] {
    binding b0 "outer": int in S1
    binding b1 "inner": int in S2
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 loop in S2
    boundary B3 lexical in S4
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: bool = const false
    %7: int = const 0
    br ^b3(%3, %6, %7)
    ^b1(%8: failure) in S0:
    raise %8
    ^b2(%9: int) in S0 unwind ^b1:
    want %9
    [i9] exit.prepare return %9 at B0
    result.exit edge normal(0), value %9, demand want, prepare #9
    ret %9
    ^b3(%10: int, %11: bool, %12: int) in S0 unwind ^b1:
    %13: bool = int.lt %10, %4
    cond %13, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %14: int = array.get %2, %10
    bind %14, binding b0
    %15: int = const 3
    %16: int = const 4
    %17: array<int> = array.new [%15, %16], ty array<int>
    %18: int = const 0
    %19: int = array.len %17
    %20: range = range.new %18, %19
    br ^b10(%18, %14)
    ^b5 in S0 unwind ^b1:
    cond %11, ^b6, ^b7
    ^b6 in S0 unwind ^b1:
    br ^b2(%12)
    ^b7 in S0 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%21: bool, %22: int) in S0 unwind ^b1:
    %23: int = const 1
    %24: int = int.add %10, %23
    br ^b3(%24, %21, %22)
    ^b9(%25: int) in S1 unwind ^b1:
    %26: int = const 2
    %27: bool = int.eq %25, %26
    cond %27, ^b15(%25), ^b16(%25)
    ^b10(%28: int, %29: int) in S1 unwind ^b1:
    %30: bool = int.lt %28, %19
    cond %30, ^b11, ^b12
    ^b11 in S2 unwind ^b1:
    %31: int = array.get %17, %28
    bind %31, binding b1
    want %29
    [i27] exit.prepare last %29 at B2
    result.exit edge normal(0), value %29, demand want, prepare #27
    br ^b9(%29)
    ^b12 in S1 unwind ^b1:
    br ^b9(%29)
    ^b13 in S1:
    unreachable
    ^b14(%32: int) in S1 unwind ^b1:
    %33: bool = const true
    want %33
    [i30] exit.prepare fallthrough %33 at B1
    want %32
    [i32] exit.prepare fallthrough %32 at B1
    result.exit edge normal(0), value %33, demand want, prepare #30
    result.exit edge normal(0), value %32, demand want, prepare #32
    br ^b8(%33, %32)
    ^b15(%34: int) in S3 unwind ^b1:
    %35: int = const 9
    want %35
    [i35] exit.prepare last %35 at B1
    result.exit edge normal(0), value %35, demand want, prepare #35
    br ^b2(%35)
    ^b16(%36: int) in S4 unwind ^b1:
    want %36
    [i37] exit.prepare fallthrough %36 at B3
    result.exit edge normal(0), value %36, demand want, prepare #37
    br ^b14(%36)
}

oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: array<never> = array.new ty array<never>
    br ^b3(%3, %6)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: array<never>) in S0 unwind ^b1:
    discard %8
    %9: int = const 0
    want %9
    [i10] exit.prepare return %9 at B0
    result.exit edge normal(0), value %8, demand discard, prepare none
    result.exit edge normal(0), value %9, demand want, prepare #10
    ret %9
    ^b3(%10: int, %11: array<never>) in S0 unwind ^b1:
    %12: bool = int.lt %10, %4
    cond %12, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %13: int = array.get %2, %10
    bind %13, binding b0
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%11)
    ^b6 in S0:
    unreachable
    ^b7 in S1:
    unreachable
    ^b8 in S2 unwind ^b1:
    %14: str = const "body"
    panic %14
}

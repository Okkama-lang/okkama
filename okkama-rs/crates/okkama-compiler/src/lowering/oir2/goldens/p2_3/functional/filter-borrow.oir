oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}
scope S0 action in @app.Res.destroy
scope S1 action in @main
scope S2 iteration in @main parent S1
scope S3 block in @main parent S2
scope S4 action in @app.Res.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S4, field field_ref(declaration=app.Res, index=0)
    bind %0, binding b0
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "outer": app.Res in S1
    binding b1 "xs": array<app.Res> in S1
    binding b2 "x": app.Res in S2
    binding b3 "selected": array<app.Res> in S1
    boundary B0 lexical in S1
    boundary B1 loop in S2
    boundary B2 lexical in S3
    ^b0 in S1 unwind ^b1:
    %0: int = const 1
    [i1] %1: app.Res = call @app.Res.new#0(%0)
    bind %1, binding b0
    %2: array<app.Res> = array.new [%1], ty array<app.Res>
    bind %2, binding b1
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: builder<app.Res> = builder.new element app.Res
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%3, %1, %2, %6)
    ^b1(%7: failure) in S1:
    raise %7
    ^b2(%8: app.Res, %9: array<app.Res>, %10: builder<app.Res>) in S1 unwind ^b16(%10):
    %11: array<app.Res> = builder.finish %10
    bind %11, binding b3
    discard %8
    %12: int = array.len %11
    want %12
    [i14] exit.prepare return %12 at B0
    result.exit edge normal(0), value %8, demand discard, prepare none
    result.exit edge normal(0), value %12, demand want, prepare #14
    ret %12
    ^b3(%13: int, %14: app.Res, %15: array<app.Res>, %16: builder<app.Res>) in S1 unwind ^b1:
    %17: bool = int.lt %13, %4
    cond %17, ^b4, ^b5
    ^b4 in S2 unwind ^b1:
    br ^b7(%14, %15, %16)
    ^b5 in S1 unwind ^b1:
    br ^b2(%14, %15, %16)
    ^b6(%18: app.Res, %19: array<app.Res>, %20: builder<app.Res>) in S1 unwind ^b1:
    %21: int = const 1
    %22: int = int.add %13, %21
    br ^b3(%22, %18, %19, %20)
    ^b7(%23: app.Res, %24: array<app.Res>, %25: builder<app.Res>) in S2 unwind ^b8(%25):
    %26: app.Res = array.get %2, %13
    bind %26, binding b2
    br ^b10
    ^b8(%27: builder<app.Res>, %28: failure) in S2 unwind ^b1:
    builder.abandon %27
    raise %28
    ^b9(%29: bool, %30: app.Res, %31: array<app.Res>, %32: app.Res, %33: builder<app.Res>) in S2 unwind ^b1:
    cond %29, ^b12, ^b13
    ^b10 in S3 unwind ^b1:
    %34: bool = const true
    want %34
    [i23] exit.prepare fallthrough %34 at B2
    want %23
    [i25] exit.prepare fallthrough %23 at B2
    want %24
    [i27] exit.prepare fallthrough %24 at B2
    want %26
    [i29] exit.prepare fallthrough %26 at B2
    result.exit edge normal(0), value %34, demand want, prepare #23
    result.exit edge normal(0), value %23, demand want, prepare #25
    result.exit edge normal(0), value %24, demand want, prepare #27
    result.exit edge normal(0), value %26, demand want, prepare #29
    br ^b9(%34, %23, %24, %26, %25)
    ^b11(%35: app.Res, %36: array<app.Res>, %37: app.Res, %38: builder<app.Res>) in S2 unwind ^b1:
    want %35
    [i31] exit.prepare fallthrough %35 at B1
    want %36
    [i33] exit.prepare fallthrough %36 at B1
    result.exit edge normal(0), value %35, demand want, prepare #31
    result.exit edge normal(0), value %36, demand want, prepare #33
    br ^b6(%35, %36, %38)
    ^b12 in S2 unwind ^b1:
    br ^b14(%30, %31, %32, %33)
    ^b13 in S2 unwind ^b1:
    br ^b11(%30, %31, %32, %33)
    ^b14(%39: app.Res, %40: array<app.Res>, %41: app.Res, %42: builder<app.Res>) in S2 unwind ^b15(%42):
    %43: builder<app.Res> = builder.push %42, %26
    br ^b11(%39, %40, %41, %43)
    ^b15(%44: builder<app.Res>, %45: failure) in S2 unwind ^b1:
    builder.abandon %44
    raise %45
    ^b16(%46: builder<app.Res>, %47: failure) in S1 unwind ^b1:
    builder.abandon %46
    raise %47
}

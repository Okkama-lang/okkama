oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": array<int> in S0
    binding b1 "acc": int in S1
    binding b2 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: array<int> = array.new ty array<int>
    bind %0, binding b0
    %1: int = const 0
    %2: int = array.len %0
    %3: range = range.new %1, %2
    %4: int = const 0
    br ^b3(%1, %0, %4)
    ^b1(%5: failure) in S0:
    raise %5
    ^b2(%6: array<int>, %7: int) in S0 unwind ^b1:
    discard %7
    %8: int = const 0
    want %8
    [i9] exit.prepare return %8 at B0
    result.exit edge normal(0), value %7, demand discard, prepare none
    result.exit edge normal(0), value %8, demand want, prepare #9
    ret %8
    ^b3(%9: int, %10: array<int>, %11: int) in S0 unwind ^b1:
    %12: bool = int.lt %9, %2
    cond %12, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %13: int = array.get %0, %9
    bind %11, binding b1
    bind %13, binding b2
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%10, %11)
    ^b6(%14: array<int>, %15: int) in S0 unwind ^b1:
    %16: int = const 1
    %17: int = int.add %9, %16
    br ^b3(%17, %14, %15)
    ^b7(%18: int, %19: array<int>, %20: int, %21: int, %22: int) in S1 unwind ^b1:
    want %19
    [i17] exit.prepare fallthrough %19 at B1
    want %18
    [i19] exit.prepare fallthrough %18 at B1
    result.exit edge normal(0), value %19, demand want, prepare #17
    result.exit edge normal(0), value %18, demand want, prepare #19
    br ^b6(%19, %18)
    ^b8 in S2 unwind ^b1:
    %23: int = int.add %11, %13
    want %23
    [i22] exit.prepare fallthrough %23 at B2
    want %10
    [i24] exit.prepare fallthrough %10 at B2
    want %11
    [i26] exit.prepare fallthrough %11 at B2
    want %13
    [i28] exit.prepare fallthrough %13 at B2
    result.exit edge normal(0), value %23, demand want, prepare #22
    result.exit edge normal(0), value %10, demand want, prepare #24
    result.exit edge normal(0), value %11, demand want, prepare #26
    result.exit edge normal(0), value %13, demand want, prepare #28
    br ^b7(%23, %10, %11, %13, %11)
}

oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1
scope S3 branch in @main parent S2
scope S4 branch in @main parent S2

func @main() -> int [entry] {
    binding b0 "n": int in S1
    binding b1 "evens": array<int> in S0
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S3
    boundary B3 lexical in S4
    boundary B4 lexical in S2
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: int = const 3
    %3: array<int> = array.new [%0, %1, %2], ty array<int>
    %4: int = const 0
    %5: int = array.len %3
    %6: range = range.new %4, %5
    %7: int = const 0
    %8: array<int> = array.new [%7], ty array<int>
    %9: builder<int> = builder.new element int
    br ^b2(%9)
    ^b1(%10: failure) in S0:
    raise %10
    ^b2(%11: builder<int>) in S0 unwind ^b3(%11):
    %12: builder<int> = builder.append %11, %8
    br ^b5(%4, %12)
    ^b3(%13: builder<int>, %14: failure) in S0 unwind ^b1:
    builder.abandon %13
    raise %14
    ^b4(%15: builder<int>) in S0 unwind ^b19(%15):
    %16: array<int> = builder.finish %15
    bind %16, binding b1
    %17: int = array.len %16
    want %17
    [i16] exit.prepare return %17 at B0
    result.exit edge normal(0), value %17, demand want, prepare #16
    ret %17
    ^b5(%18: int, %19: builder<int>) in S0 unwind ^b1:
    %20: bool = int.lt %18, %5
    cond %20, ^b6, ^b7
    ^b6 in S1 unwind ^b1:
    br ^b9(%19)
    ^b7 in S0 unwind ^b1:
    br ^b4(%19)
    ^b8(%21: builder<int>) in S0 unwind ^b1:
    %22: int = const 1
    %23: int = int.add %18, %22
    br ^b5(%23, %21)
    ^b9(%24: builder<int>) in S1 unwind ^b10(%24):
    %25: int = array.get %3, %18
    bind %25, binding b0
    br ^b12
    ^b10(%26: builder<int>, %27: failure) in S1 unwind ^b1:
    builder.abandon %26
    raise %27
    ^b11(%28: array<int>, %29: int, %30: builder<int>) in S1 unwind ^b18(%30):
    %31: builder<int> = builder.append %30, %28
    exit.prepare fallthrough select s0 at B1
    br ^b8(%31)
    ^b12 in S2 unwind ^b1:
    %32: int = const 2
    br ^b13(%25, %24)
    ^b13(%33: int, %34: builder<int>) in S2 unwind ^b14(%34):
    %35: int = int.mod %25, %32
    %36: int = const 0
    %37: bool = int.eq %35, %36
    cond %37, ^b16(%33, %34), ^b17(%33, %34)
    ^b14(%38: builder<int>, %39: failure) in S2 unwind ^b1:
    builder.abandon %38
    raise %39
    ^b15(%40: array<int>, %41: int, %42: builder<int>) in S2 unwind ^b1:
    want %40
    [i31] exit.prepare fallthrough %40 at B4
    want %41
    [i33] exit.prepare fallthrough %41 at B4
    result.exit edge normal(0), value %40, demand want, prepare #31
    result.exit edge normal(0), value %41, demand want, prepare #33
    br ^b11(%40, %41, %42)
    ^b16(%43: int, %44: builder<int>) in S3 unwind ^b1:
    %45: int = const 10
    %46: int = int.mul %43, %45
    %47: array<int> = array.new [%43, %46], ty array<int>
    want %47
    [i38] exit.prepare fallthrough %47 at B2
    want %43
    [i40] exit.prepare fallthrough %43 at B2
    result.exit edge normal(0), value %47, demand want, prepare #38
    result.exit edge normal(0), value %43, demand want, prepare #40
    br ^b15(%47, %43, %44)
    ^b17(%48: int, %49: builder<int>) in S4 unwind ^b1:
    %50: array<int> = array.new ty array<int>
    want %50
    [i43] exit.prepare fallthrough %50 at B3
    want %48
    [i45] exit.prepare fallthrough %48 at B3
    result.exit edge normal(0), value %50, demand want, prepare #43
    result.exit edge normal(0), value %48, demand want, prepare #45
    br ^b15(%50, %48, %49)
    ^b18(%51: builder<int>, %52: failure) in S1 unwind ^b1:
    builder.abandon %51
    raise %52
    ^b19(%53: builder<int>, %54: failure) in S0 unwind ^b1:
    builder.abandon %53
    raise %54
}

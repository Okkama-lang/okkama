oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": range in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    boundary B3 lexical in S1
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: range = range.new %0, %1, inclusive true
    bind %2, binding b0
    %3: int = range.start %2
    %4: int = range.len %2
    %5: int = int.add %3, %4
    %6: range = range.new %3, %5
    %7: bool = const true
    br ^b3(%3, %2, %7)
    ^b1(%8: failure) in S0:
    raise %8
    ^b2(%9: range, %10: bool) in S0 unwind ^b1:
    discard %10
    %11: int = const 0
    want %11
    [i12] exit.prepare return %11 at B0
    result.exit edge normal(0), value %10, demand discard, prepare none
    result.exit edge normal(0), value %11, demand want, prepare #12
    ret %11
    ^b3(%12: int, %13: range, %14: bool) in S0 unwind ^b1:
    %15: bool = int.lt %12, %5
    cond %15, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %12, binding b1
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%13, %14)
    ^b6(%16: range, %17: bool) in S0 unwind ^b1:
    %18: int = const 1
    %19: int = int.add %12, %18
    br ^b3(%19, %16, %17)
    ^b7(%20: bool, %21: range, %22: int, %23: bool) in S1 unwind ^b1:
    cond %20, ^b10, ^b9
    ^b8 in S2 unwind ^b1:
    %24: int = const 0
    %25: bool = int.lt %12, %24
    want %25
    [i20] exit.prepare fallthrough %25 at B2
    want %13
    [i22] exit.prepare fallthrough %13 at B2
    want %12
    [i24] exit.prepare fallthrough %12 at B2
    want %14
    [i26] exit.prepare fallthrough %14 at B2
    result.exit edge normal(0), value %25, demand want, prepare #20
    result.exit edge normal(0), value %13, demand want, prepare #22
    result.exit edge normal(0), value %12, demand want, prepare #24
    result.exit edge normal(0), value %14, demand want, prepare #26
    br ^b7(%25, %13, %12, %14)
    ^b9 in S1 unwind ^b1:
    %26: bool = const false
    want %21
    [i29] exit.prepare fallthrough %21 at B3
    want %26
    [i31] exit.prepare fallthrough %26 at B3
    result.exit edge normal(0), value %21, demand want, prepare #29
    result.exit edge normal(0), value %26, demand want, prepare #31
    br ^b2(%21, %26)
    ^b10 in S1 unwind ^b1:
    want %21
    [i33] exit.prepare fallthrough %21 at B1
    want %23
    [i35] exit.prepare fallthrough %23 at B1
    result.exit edge normal(0), value %21, demand want, prepare #33
    result.exit edge normal(0), value %23, demand want, prepare #35
    br ^b6(%21, %23)
}

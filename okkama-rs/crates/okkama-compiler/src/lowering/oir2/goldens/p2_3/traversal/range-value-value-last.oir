oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 branch in @main parent S1
scope S3 branch in @main parent S1

func @main() -> int [entry] {
    binding b0 "r": range in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S3
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: range = range.new %0, %1, inclusive true
    bind %2, binding b0
    %3: int = range.start %2
    %4: int = range.len %2
    %5: int = int.add %3, %4
    %6: range = range.new %3, %5
    %7: bool = const false
    %8: int = const 0
    br ^b3(%3, %7, %8, %2)
    ^b1(%9: failure) in S0:
    raise %9
    ^b2(%10: int, %11: range) in S0 unwind ^b1:
    want %10
    [i11] exit.prepare return %10 at B0
    result.exit edge normal(0), value %10, demand want, prepare #11
    ret %10
    ^b3(%12: int, %13: bool, %14: int, %15: range) in S0 unwind ^b1:
    %16: bool = int.lt %12, %5
    cond %16, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %12, binding b1
    %17: int = const 2
    %18: bool = int.eq %12, %17
    cond %18, ^b10(%15, %12), ^b11(%15, %12)
    ^b5 in S0 unwind ^b1:
    cond %13, ^b6, ^b7
    ^b6 in S0 unwind ^b1:
    br ^b2(%14, %15)
    ^b7 in S0 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%19: bool, %20: int, %21: range) in S0 unwind ^b1:
    %22: int = const 1
    %23: int = int.add %12, %22
    br ^b3(%23, %19, %20, %21)
    ^b9(%24: range, %25: int) in S1 unwind ^b1:
    %26: bool = const true
    want %26
    [i20] exit.prepare fallthrough %26 at B1
    want %25
    [i22] exit.prepare fallthrough %25 at B1
    want %24
    [i24] exit.prepare fallthrough %24 at B1
    result.exit edge normal(0), value %26, demand want, prepare #20
    result.exit edge normal(0), value %25, demand want, prepare #22
    result.exit edge normal(0), value %24, demand want, prepare #24
    br ^b8(%26, %25, %24)
    ^b10(%27: range, %28: int) in S2 unwind ^b1:
    cond %13, ^b12, ^b13
    ^b11(%29: range, %30: int) in S3 unwind ^b1:
    want %29
    [i26] exit.prepare fallthrough %29 at B2
    want %30
    [i28] exit.prepare fallthrough %30 at B2
    result.exit edge normal(0), value %29, demand want, prepare #26
    result.exit edge normal(0), value %30, demand want, prepare #28
    br ^b9(%29, %30)
    ^b12 in S2 unwind ^b1:
    want %14
    [i30] exit.prepare last %14 at B1
    want %27
    [i32] exit.prepare last %27 at B1
    result.exit edge normal(0), value %14, demand want, prepare #30
    result.exit edge normal(0), value %27, demand want, prepare #32
    br ^b2(%14, %27)
    ^b13 in S2 unwind ^b1:
    trap empty "A void result cannot be used as a value"
}

oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}

object app.Walk {
    does "collections/iteration::Batching<object(app::Res)>" {batch = @app.Walk.batch#0}
}

role "collections/iteration::Batching<object(app::Res)>" {
    batch() -> array<app.Res>
}
scope S0 action in @app.Res.read#0
scope S1 action in @app.Res.destroy
scope S2 action in @app.Walk.batch#0
scope S3 action in @main
scope S4 block in @main parent S3
scope S5 iteration in @main parent S4
scope S6 action in @app.Res.new#0
scope S7 action in @app.Walk.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S6, field field_ref(declaration=app.Res, index=0)
    bind %0, binding b0
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Res.read#0(%0: app.Res) -> int [method app.Res] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Walk.new#0() -> app.Walk [ctor app.Walk] {
    boundary B0 lexical in S7
    ^b0 in S7 unwind ^b1:
    %0: app.Walk = obj.new app.Walk { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S7:
    raise %1
}

func @app.Walk.batch#0(%0: app.Walk) -> array<app.Res> [method app.Walk] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: int = const 1
    [i1] %2: app.Res = call @app.Res.new#0(%1)
    %3: int = const 2
    [i3] %4: app.Res = call @app.Res.new#0(%3)
    %5: array<app.Res> = array.new [%2, %4], ty array<app.Res>
    want %5
    [i6] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #6
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    ret %5
    ^b1(%6: failure) in S2:
    raise %6
}

func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Batching<object(app::Res)>" in S3
    binding b1 "$batch": array<app.Res> in S4
    binding b2 "x": app.Res in S5
    boundary B0 lexical in S3
    boundary B1 lexical in S4
    boundary B2 lexical in S4
    boundary B3 loop in S5
    selection s0: selection = union([])
    selection s1: selection = union([])
    selection s2: selection = union([])
    ^b0 in S3 unwind ^b1:
    [i0] %0: app.Walk = call @app.Walk.new#0()
    %1: "collections/iteration::Batching<object(app::Res)>" = role.wrap %0, ty "collections/iteration::Batching<object(app::Res)>"
    bind %1, binding b0
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3
    ^b1(%2: failure) in S3:
    raise %2
    ^b2 in S3 unwind ^b1:
    %3: int = const 0
    want %3
    [i5] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #5
    ret %3
    ^b3 in S3 unwind ^b1:
    br ^b4
    ^b4 in S4 unwind ^b1:
    [i6] %4: array<app.Res> = call.role %1, "collections/iteration::Batching<object(app::Res)>" slot 0()
    bind %4, binding b1
    %5: int = array.len %4
    %6: int = const 0
    %7: bool = int.lt %6, %5
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    cond %7, ^b5, ^b6
    ^b5 in S4 unwind ^b1:
    br ^b7(%6)
    ^b6 in S4 unwind ^b1:
    exit.prepare fallthrough select s0 at B1
    br ^b2
    ^b7(%8: int) in S4 unwind ^b1:
    %9: bool = int.lt %8, %5
    cond %9, ^b8, ^b9
    ^b8 in S5 unwind ^b1:
    %10: app.Res = array.get %4, %8
    bind %10, binding b2
    [i15] %11: int = call @app.Res.read#0(%10)
    discard %11
    exit.prepare fallthrough select s2 at B3
    result.exit edge normal(0), value %11, demand discard, prepare none
    high.effects at #15 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b10
    ^b9 in S4 unwind ^b1:
    exit.prepare fallthrough select s1 at B2
    br ^b3
    ^b10 in S4 unwind ^b1:
    %12: int = const 1
    %13: int = int.add %8, %12
    br ^b7(%13)
}

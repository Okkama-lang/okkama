oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 branch in @main parent S1
scope S3 branch in @main parent S1

func @main() -> int [entry] {
    binding b0 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S3
    selection s0: selection = union([])
    selection s1: selection = union([])
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: range = range.new %0, %1, inclusive true
    br ^b3(%0)
    ^b1(%3: failure) in S0:
    raise %3
    ^b2 in S0 unwind ^b1:
    %4: int = const 0
    want %4
    [i5] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #5
    ret %4
    ^b3(%5: int) in S0 unwind ^b1:
    %6: bool = int.le %5, %1
    cond %6, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %5, binding b0
    %7: int = const 1
    %8: bool = int.eq %5, %7
    cond %8, ^b8(%5), ^b9(%5)
    ^b5 in S0 unwind ^b1:
    br ^b2
    ^b6 in S0 unwind ^b1:
    %9: int = const 1
    %10: int = int.add %5, %9
    br ^b3(%10)
    ^b7(%11: int) in S1 unwind ^b1:
    discard %11
    exit.prepare fallthrough select s1 at B1
    result.exit edge normal(0), value %11, demand discard, prepare none
    br ^b6
    ^b8(%12: int) in S2 unwind ^b1:
    exit.prepare last select s0 at B1
    br ^b2
    ^b9(%13: int) in S3 unwind ^b1:
    want %13
    [i16] exit.prepare fallthrough %13 at B2
    result.exit edge normal(0), value %13, demand want, prepare #16
    br ^b7(%13)
}

oir 2 high
module app
requires core
entry @main

role Error [builtin] {
    text() -> str
}
scope S0 action in @main
scope S1 try in @main parent S0
scope S2 catch in @main parent S0

func @main() -> int [entry] {
    binding b0 "a": array<int> in S0
    binding b1 "e": Error in S2
    boundary B0 lexical in S0
    boundary B1 lexical in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: array<int> = array.new ty array<int>
    bind %0, binding b0
    br ^b4(%0)
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: array<int>) in S0 unwind ^b1:
    %3: int = const 0
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    ret %3
    ^b3(%4: array<int>, %5: failure) in S0 unwind ^b1:
    catch %5 is Error, ^b9(%4, %5, $value), ^b10(%4, %5)
    ^b4(%6: array<int>) in S1 unwind ^b3(%6):
    %7: int = const 0
    array.lookup %6, %7, ^b5($value), ^b6
    ^b5(%8: int) in S1:
    br ^b8(%6)
    ^b6 in S1:
    br ^b7(%6)
    ^b7(%9: array<int>) in S1 unwind ^b3(%9):
    trap empty "Cannot read first item of an empty sequence"
    ^b8(%10: array<int>) in S1 unwind ^b3(%10):
    discard %8
    want %10
    [i8] exit.prepare fallthrough %10 at B1
    result.exit edge normal(0), value %8, demand discard, prepare none
    result.exit edge normal(0), value %10, demand want, prepare #8
    br ^b2(%10)
    ^b9(%11: array<int>, %12: failure, %13: Error) in S2 unwind ^b1:
    bind %13, binding b1
    br ^b12(%11, %12)
    ^b10(%14: array<int>, %15: failure) in S0 unwind ^b1:
    raise %15
    ^b11(%16: array<int>, %17: failure, %18: failure) in S0 unwind ^b1:
    %19: failure = fail.caused %18, %17
    raise %19
    ^b12(%20: array<int>, %21: failure) in S2 unwind ^b11(%20, %21):
    %22: int = const 0
    discard %22
    want %20
    [i14] exit.prepare fallthrough %20 at B2
    result.exit edge normal(0), value %22, demand discard, prepare none
    result.exit edge normal(0), value %20, demand want, prepare #14
    br ^b2(%20)
}

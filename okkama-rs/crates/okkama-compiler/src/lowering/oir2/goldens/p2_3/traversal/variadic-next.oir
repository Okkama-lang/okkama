    ^b2(%6: array<int>) in S0 unwind ^b1:
    %7: int = const 0
    want %7
    [i6] exit.prepare return %7 at B0
    result.exit edge normal(0), value %7, demand want, prepare #6
    ret %7
    ^b3(%8: int, %9: array<int>) in S0 unwind ^b1:
    %10: bool = int.lt %8, %3
    cond %10, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %11: int = array.get %1, %8
    bind %11, binding b1
    %12: int = const 1
    %13: bool = int.eq %11, %12
    cond %13, ^b8(%9, %11), ^b9(%9, %11)
    ^b5 in S0 unwind ^b1:
    br ^b2(%9)
    ^b6(%14: array<int>) in S0 unwind ^b1:
    %15: int = const 1
    %16: int = int.add %8, %15
    br ^b3(%16, %14)
    ^b7(%17: array<int>, %18: int) in S1 unwind ^b1:
    discard %18
    want %17
    [i16] exit.prepare fallthrough %17 at B1
    result.exit edge normal(0), value %18, demand discard, prepare none
    result.exit edge normal(0), value %17, demand want, prepare #16
    br ^b6(%17)
    ^b8(%19: array<int>, %20: int) in S2 unwind ^b1:
    want %19
    [i18] exit.prepare next %19 at B1
    result.exit edge normal(0), value %19, demand want, prepare #18
    br ^b6(%19)
    ^b9(%21: array<int>, %22: int) in S3 unwind ^b1:
    want %21
    [i20] exit.prepare fallthrough %21 at B2
    want %22
    [i22] exit.prepare fallthrough %22 at B2
    result.exit edge normal(0), value %21, demand want, prepare #20
    result.exit edge normal(0), value %22, demand want, prepare #22

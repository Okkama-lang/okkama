oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 branch in @main parent S1
scope S3 branch in @main parent S1

func @main() -> int [entry] {
    binding b0 "r": range in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S3
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: range = range.new %0, %1, inclusive true
    bind %2, binding b0
    %3: int = range.start %2
    %4: int = range.len %2
    %5: int = int.add %3, %4
    %6: range = range.new %3, %5
    br ^b3(%3, %2)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: range) in S0 unwind ^b1:
    %9: int = const 0
    want %9
    [i10] exit.prepare return %9 at B0
    result.exit edge normal(0), value %9, demand want, prepare #10
    ret %9
    ^b3(%10: int, %11: range) in S0 unwind ^b1:
    %12: bool = int.lt %10, %5
    cond %12, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %10, binding b1
    %13: int = const 1
    %14: bool = int.eq %10, %13
    cond %14, ^b8(%11, %10), ^b9(%11, %10)
    ^b5 in S0 unwind ^b1:
    br ^b2(%11)
    ^b6(%15: range) in S0 unwind ^b1:
    %16: int = const 1
    %17: int = int.add %10, %16
    br ^b3(%17, %15)
    ^b7(%18: range, %19: int) in S1 unwind ^b1:
    discard %19
    want %18
    [i19] exit.prepare fallthrough %18 at B1
    result.exit edge normal(0), value %19, demand discard, prepare none
    result.exit edge normal(0), value %18, demand want, prepare #19
    br ^b6(%18)
    ^b8(%20: range, %21: int) in S2 unwind ^b1:
    want %20
    [i21] exit.prepare last %20 at B1
    result.exit edge normal(0), value %20, demand want, prepare #21
    br ^b2(%20)
    ^b9(%22: range, %23: int) in S3 unwind ^b1:
    want %22
    [i23] exit.prepare fallthrough %22 at B2
    want %23
    [i25] exit.prepare fallthrough %23 at B2
    result.exit edge normal(0), value %22, demand want, prepare #23
    result.exit edge normal(0), value %23, demand want, prepare #25
    br ^b7(%22, %23)
}

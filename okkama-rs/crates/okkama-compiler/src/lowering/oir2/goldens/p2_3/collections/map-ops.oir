oir 2 high
module app
requires core
entry @main
scope S0 action in @main

func @main() -> int [entry] {
    binding b0 "a": map<str, int> in S0
    binding b1 "b": map<str, int> in S0
    binding b2 "sum": map<str, int> in S0
    binding b3 "diff": map<str, int> in S0
    binding b4 "empty": map<str, int> in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: str = const "a"
    %1: int = const 1
    %2: str = const "b"
    %3: int = const 2
    %4: map<str, int> = map.new entries [(%0, %1), (%2, %3)], ty map<str, int>
    bind %4, binding b0
    %5: str = const "b"
    %6: int = const 3
    %7: str = const "c"
    %8: int = const 4
    %9: map<str, int> = map.new entries [(%5, %6), (%7, %8)], ty map<str, int>
    bind %9, binding b1
    %10: map<str, int> = map.merge [%4, %9], ty map<str, int>
    bind %10, binding b2
    %11: map<str, int> = map.difference %4, [%9]
    bind %11, binding b3
    %12: int = map.len %10
    discard %12
    %13: str = const "b"
    %14: bool = map.has %10, %13
    discard %14
    %15: array<str> = map.keys %10
    discard %15
    %16: array<int> = map.values %10
    discard %16
    %17: map<str, int> = map.new ty map<str, int>
    bind %17, binding b4
    %18: map<str, int> = map.difference %17, [%17]
    %19: array<int> = map.values %18
    discard %19
    %20: map<str, int> = map.difference %4, [%4]
    %21: array<str> = map.keys %20
    discard %21
    %22: int = const 0
    want %22
    [i35] exit.prepare return %22 at B0
    result.exit edge normal(0), value %12, demand discard, prepare none
    result.exit edge normal(0), value %14, demand discard, prepare none
    result.exit edge normal(0), value %15, demand discard, prepare none
    result.exit edge normal(0), value %16, demand discard, prepare none
    result.exit edge normal(0), value %19, demand discard, prepare none
    result.exit edge normal(0), value %21, demand discard, prepare none
    result.exit edge normal(0), value %22, demand want, prepare #35
    ret %22
    ^b1(%23: failure) in S0:
    raise %23
}

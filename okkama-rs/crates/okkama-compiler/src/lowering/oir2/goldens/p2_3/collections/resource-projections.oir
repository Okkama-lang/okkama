oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}

object app.Box {
    field item: app.Res
}

object app.Outer {
    field inner: app.Box
}
scope S0 action in @app.Res.destroy
scope S1 action in @app.Box.get#0
scope S2 action in @app.Outer.get#0
scope S3 action in @main
scope S4 action in @app.Res.new#0
scope S5 action in @app.Box.new#0
scope S6 action in @app.Outer.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: int = undef ty int
    bind %0, binding b0
    stage %0, action S4, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Box.new#0(%0: app.Res) -> app.Box [ctor app.Box] {
    binding b0 "item": app.Res in S5
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %1: app.Res = undef ty app.Res
    bind %0, binding b0
    stage %0, action S5, field field_ref(declaration=app.Box, index=0)
    %2: app.Box = obj.new app.Box { item: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S5:
    raise %3
}

func @app.Box.get#0(%0: app.Box) -> app.Res [method app.Box] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: app.Res = obj.get %0, item
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Outer.new#0(%0: app.Box) -> app.Outer [ctor app.Outer] {
    binding b0 "inner": app.Box in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: app.Box = undef ty app.Box
    bind %0, binding b0
    stage %0, action S6, field field_ref(declaration=app.Outer, index=0)
    %2: app.Outer = obj.new app.Outer { inner: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Outer.get#0(%0: app.Outer) -> app.Res [method app.Outer] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: app.Box = obj.get %0, inner
    [i1] %2: app.Res = call @app.Box.get#0(%1)
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S2:
    raise %3
}

func @main() -> int [entry] {
    binding b0 "a": app.Res in S3
    binding b1 "b": app.Res in S3
    binding b2 "xs": array<app.Res> in S3
    binding b3 "one": app.Res in S3
    binding b4 "slice": array<app.Res> in S3
    binding b5 "removed": array<app.Res> in S3
    binding b6 "replaced": array<app.Res> in S3
    binding b7 "m": map<str, app.Res> in S3
    binding b8 "entry": app.Res in S3
    binding b9 "keys": array<str> in S3
    binding b10 "values": array<app.Res> in S3
    binding b11 "nested": array<array<app.Res>> in S3
    binding b12 "path": app.Res in S3
    binding b13 "field": app.Res in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: int = const 1
    [i1] %1: app.Res = call @app.Res.new#0(%0)
    bind %1, binding b0
    %2: int = const 2
    [i4] %3: app.Res = call @app.Res.new#0(%2)
    bind %3, binding b1
    %4: array<app.Res> = array.new [%1, %1, %3], ty array<app.Res>
    bind %4, binding b2
    %5: int = const 0
    %6: app.Res = array.get %4, %5
    bind %6, binding b3
    %7: int = const 0
    %8: int = const 1
    %9: array<app.Res> = array.slice %4, %7, %8
    bind %9, binding b4
    %10: int = const 1
    %11: array<app.Res> = array.remove %4, %10
    bind %11, binding b5
    %12: int = const 1
    %13: int = const 3
    [i20] %14: app.Res = call @app.Res.new#0(%13)
    %15: array<app.Res> = array.replace %4, %12, %14
    bind %15, binding b6
    %16: str = const "a"
    %17: str = const "b"
    %18: str = const "c"
    %19: map<str, app.Res> = map.new entries [(%16, %1), (%17, %1), (%18, %3)], ty map<str, app.Res>
    bind %19, binding b7
    %20: str = const "b"
    %21: app.Res = map.get %19, %20
    bind %21, binding b8
    %22: array<str> = map.keys %19
    bind %22, binding b9
    %23: array<app.Res> = map.values %19
    bind %23, binding b10
    %24: array<app.Res> = array.new [%1], ty array<app.Res>
    %25: array<app.Res> = array.new [%3], ty array<app.Res>
    %26: array<array<app.Res>> = array.new [%24, %25], ty array<array<app.Res>>
    bind %26, binding b11
    %27: int = const 0
    %28: array<app.Res> = array.get %26, %27
    %29: int = const 0
    %30: app.Res = array.get %28, %29
    bind %30, binding b12
    [i44] %31: app.Box = call @app.Box.new#0(%1)
    [i45] %32: app.Outer = call @app.Outer.new#0(%31)
    [i46] %33: app.Res = call @app.Outer.get#0(%32)
    bind %33, binding b13
    %34: int = const 0
    want %34
    [i50] exit.prepare return %34 at B0
    result.exit edge normal(0), value %34, demand want, prepare #50
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #20 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #44 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #45 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #46 failures [thrown, program, panic, native, cancelled], suspends true
    ret %34
    ^b1(%35: failure) in S3:
    raise %35
}

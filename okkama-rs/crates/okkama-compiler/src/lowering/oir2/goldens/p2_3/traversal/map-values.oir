oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0

func @main() -> int [entry] {
    binding b0 "m": map<str, int> in S0
    binding b1 "value": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    ^b0 in S0 unwind ^b1:
    %0: str = const "z"
    %1: int = const 1
    %2: str = const "a"
    %3: int = const 2
    %4: map<str, int> = map.new entries [(%0, %1), (%2, %3)], ty map<str, int>
    bind %4, binding b0
    %5: array<int> = map.values %4
    %6: int = const 0
    %7: int = array.len %5
    %8: range = range.new %6, %7
    %9: bool = const false
    %10: int = const 0
    br ^b3(%6, %9, %10, %4)
    ^b1(%11: failure) in S0:
    raise %11
    ^b2(%12: int, %13: map<str, int>) in S0 unwind ^b1:
    want %12
    [i13] exit.prepare return %12 at B0
    result.exit edge normal(0), value %12, demand want, prepare #13
    ret %12
    ^b3(%14: int, %15: bool, %16: int, %17: map<str, int>) in S0 unwind ^b1:
    %18: bool = int.lt %14, %7
    cond %18, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %19: int = array.get %5, %14
    bind %19, binding b1
    %20: bool = const true
    want %20
    [i19] exit.prepare fallthrough %20 at B1
    want %19
    [i21] exit.prepare fallthrough %19 at B1
    want %17
    [i23] exit.prepare fallthrough %17 at B1
    result.exit edge normal(0), value %20, demand want, prepare #19
    result.exit edge normal(0), value %19, demand want, prepare #21
    result.exit edge normal(0), value %17, demand want, prepare #23
    br ^b8(%20, %19, %17)
    ^b5 in S0 unwind ^b1:
    cond %15, ^b6, ^b7
    ^b6 in S0 unwind ^b1:
    br ^b2(%16, %17)
    ^b7 in S0 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%21: bool, %22: int, %23: map<str, int>) in S0 unwind ^b1:
    %24: int = const 1
    %25: int = int.add %14, %24
    br ^b3(%25, %21, %22, %23)
}

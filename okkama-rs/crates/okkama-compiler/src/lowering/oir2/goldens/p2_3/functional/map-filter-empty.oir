oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": map<int, int> in S0
    binding b1 "key": int in S1
    binding b2 "value": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: map<int, int> = map.new ty map<int, int>
    bind %0, binding b0
    %1: int = const 0
    %2: int = map.len %0
    %3: range = range.new %1, %2
    %4: mbuilder<int, int> = mbuilder.new key int, value int
    br ^b3(%1, %0, %4)
    ^b1(%5: failure) in S0:
    raise %5
    ^b2(%6: map<int, int>, %7: mbuilder<int, int>) in S0 unwind ^b16(%7):
    %8: map<int, int> = mbuilder.finish %7
    discard %8
    %9: int = const 0
    want %9
    [i10] exit.prepare return %9 at B0
    result.exit edge normal(0), value %8, demand discard, prepare none
    result.exit edge normal(0), value %9, demand want, prepare #10
    ret %9
    ^b3(%10: int, %11: map<int, int>, %12: mbuilder<int, int>) in S0 unwind ^b1:
    %13: bool = int.lt %10, %2
    cond %13, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    br ^b7(%11, %12)
    ^b5 in S0 unwind ^b1:
    br ^b2(%11, %12)
    ^b6(%14: map<int, int>, %15: mbuilder<int, int>) in S0 unwind ^b1:
    %16: int = const 1
    %17: int = int.add %10, %16
    br ^b3(%17, %14, %15)
    ^b7(%18: map<int, int>, %19: mbuilder<int, int>) in S1 unwind ^b8(%19):
    %20: int = map.key_at %0, %10
    %21: int = map.value_at %0, %10
    bind %20, binding b1
    bind %21, binding b2
    br ^b10
    ^b8(%22: mbuilder<int, int>, %23: failure) in S1 unwind ^b1:
    mbuilder.abandon %22
    raise %23
    ^b9(%24: bool, %25: map<int, int>, %26: int, %27: int, %28: mbuilder<int, int>) in S1 unwind ^b1:
    cond %24, ^b12, ^b13
    ^b10 in S2 unwind ^b1:
    %29: bool = int.lt %20, %21
    want %29
    [i21] exit.prepare fallthrough %29 at B2
    want %18
    [i23] exit.prepare fallthrough %18 at B2
    want %20
    [i25] exit.prepare fallthrough %20 at B2
    want %21
    [i27] exit.prepare fallthrough %21 at B2
    result.exit edge normal(0), value %29, demand want, prepare #21
    result.exit edge normal(0), value %18, demand want, prepare #23
    result.exit edge normal(0), value %20, demand want, prepare #25
    result.exit edge normal(0), value %21, demand want, prepare #27
    br ^b9(%29, %18, %20, %21, %19)
    ^b11(%30: map<int, int>, %31: int, %32: int, %33: mbuilder<int, int>) in S1 unwind ^b1:
    want %30
    [i29] exit.prepare fallthrough %30 at B1
    result.exit edge normal(0), value %30, demand want, prepare #29
    br ^b6(%30, %33)
    ^b12 in S1 unwind ^b1:
    br ^b14(%25, %26, %27, %28)
    ^b13 in S1 unwind ^b1:
    br ^b11(%25, %26, %27, %28)
    ^b14(%34: map<int, int>, %35: int, %36: int, %37: mbuilder<int, int>) in S1 unwind ^b15(%37):
    %38: mbuilder<int, int> = mbuilder.put %37, %20, %21
    br ^b11(%34, %35, %36, %38)
    ^b15(%39: mbuilder<int, int>, %40: failure) in S1 unwind ^b1:
    mbuilder.abandon %39
    raise %40
    ^b16(%41: mbuilder<int, int>, %42: failure) in S0 unwind ^b1:
    mbuilder.abandon %41
    raise %42
}

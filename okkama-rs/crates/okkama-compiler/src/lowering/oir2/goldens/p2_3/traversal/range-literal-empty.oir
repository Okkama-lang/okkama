oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0

func @main() -> int [entry] {
    binding b0 "end": int in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    ^b0 in S0 unwind ^b1:
    %0: int = const 0
    bind %0, binding b0
    %1: int = const 0
    %2: range = range.new %1, %0
    %3: bool = const false
    %4: int = const 0
    br ^b3(%1, %3, %4, %0)
    ^b1(%5: failure) in S0:
    raise %5
    ^b2(%6: int, %7: int) in S0 unwind ^b1:
    want %6
    [i7] exit.prepare return %6 at B0
    result.exit edge normal(0), value %6, demand want, prepare #7
    ret %6
    ^b3(%8: int, %9: bool, %10: int, %11: int) in S0 unwind ^b1:
    %12: bool = int.lt %8, %0
    cond %12, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %8, binding b1
    %13: bool = const true
    want %13
    [i12] exit.prepare fallthrough %13 at B1
    want %8
    [i14] exit.prepare fallthrough %8 at B1
    want %11
    [i16] exit.prepare fallthrough %11 at B1
    result.exit edge normal(0), value %13, demand want, prepare #12
    result.exit edge normal(0), value %8, demand want, prepare #14
    result.exit edge normal(0), value %11, demand want, prepare #16
    br ^b8(%13, %8, %11)
    ^b5 in S0 unwind ^b1:
    cond %9, ^b6, ^b7
    ^b6 in S0 unwind ^b1:
    br ^b2(%10, %11)
    ^b7 in S0 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%14: bool, %15: int, %16: int) in S0 unwind ^b1:
    %17: int = const 1
    %18: int = int.add %8, %17
    br ^b3(%18, %14, %15, %16)
}

func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Iterating<int>" in S5
    binding b1 "$cursor": "collections/iteration::Cursor<int>" in S6
    binding b2 "x": int in S7
    boundary B0 lexical in S5
    boundary B1 lexical in S6
    boundary B2 loop in S7
    boundary B3 lexical in S6
    ^b0 in S5 unwind ^b1:
    %0: int = const 2
    [i1] %1: app.Walk = call @app.Walk.new#0(%0)
    %2: "collections/iteration::Iterating<int>" = role.wrap %1, ty "collections/iteration::Iterating<int>"
    bind %2, binding b0
    %3: bool = const false
    %4: int = const 0
    [i6] %5: "collections/iteration::Cursor<int>" = call.role %2, "collections/iteration::Iterating<int>" slot 0()
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%5, %3, %4)
    ^b1(%6: failure) in S5:
    raise %6
    ^b2(%7: int) in S5 unwind ^b1:
    want %7
    [i8] exit.prepare return %7 at B0
    result.exit edge normal(0), value %7, demand want, prepare #8
    ret %7
    ^b3(%8: "collections/iteration::Cursor<int>", %9: bool, %10: int) in S5 unwind ^b1:
    br ^b4(%8, %9, %10)
    ^b4(%11: "collections/iteration::Cursor<int>", %12: bool, %13: int) in S6 unwind ^b1:
    bind %11, binding b1
    [i10] %14: bool = call.role %11, "collections/iteration::Cursor<int>" slot 0()
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    cond %14, ^b5, ^b6
    ^b5 in S7 unwind ^b1:
    [i11] %15: int = call.role %11, "collections/iteration::Cursor<int>" slot 1()
    bind %15, binding b2
    %16: bool = const true
    want %16
    [i15] exit.prepare fallthrough %16 at B2
    want %15
    [i17] exit.prepare fallthrough %15 at B2
    result.exit edge normal(0), value %16, demand want, prepare #15
    result.exit edge normal(0), value %15, demand want, prepare #17
    high.effects at #11 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b9(%16, %15)
    ^b6 in S6 unwind ^b1:
    cond %12, ^b7, ^b8
    ^b7 in S6 unwind ^b1:
    want %13
    [i19] exit.prepare fallthrough %13 at B1
    result.exit edge normal(0), value %13, demand want, prepare #19
    br ^b2(%13)
    ^b8 in S6 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b9(%17: bool, %18: int) in S6 unwind ^b1:
    [i20] %19: "collections/iteration::Cursor<int>" = call.role %11, "collections/iteration::Cursor<int>" slot 2()
    want %19
    [i22] exit.prepare next %19 at B3
    want %17
    [i24] exit.prepare next %17 at B3
    want %18
    [i26] exit.prepare next %18 at B3
    result.exit edge normal(0), value %19, demand want, prepare #22
    result.exit edge normal(0), value %17, demand want, prepare #24
    result.exit edge normal(0), value %18, demand want, prepare #26
    high.effects at #20 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%19, %17, %18)
}

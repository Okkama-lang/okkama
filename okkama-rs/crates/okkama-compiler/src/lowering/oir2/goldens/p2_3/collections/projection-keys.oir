oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}

object app.Select {
}
scope S0 action in @app.Res.destroy
scope S1 action in @app.Select.fresh#0
scope S2 block in @app.Select.fresh#0 parent S1
scope S3 action in @app.Select.borrowed#1
scope S4 block in @app.Select.borrowed#1 parent S3
scope S5 action in @main
scope S6 action in @app.Res.new#0
scope S7 action in @app.Select.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: int = undef ty int
    bind %0, binding b0
    stage %0, action S6, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Select.new#0() -> app.Select [ctor app.Select] {
    boundary B0 lexical in S7
    ^b0 in S7 unwind ^b1:
    %0: app.Select = obj.new app.Select { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S7:
    raise %1
}

func @app.Select.fresh#0(%0: app.Select) -> array<str> [method app.Select] {
    binding b0 "a": app.Res in S1
    binding b1 "b": app.Res in S1
    binding b2 "xs": map<str, app.Res> in S1
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    ^b0 in S1 unwind ^b1:
    %1: int = const 1
    [i1] %2: app.Res = call @app.Res.new#0(%1)
    bind %2, binding b0
    %3: int = const 2
    [i4] %4: app.Res = call @app.Res.new#0(%3)
    bind %4, binding b1
    %5: str = const "a"
    %6: str = const "b"
    %7: str = const "c"
    %8: map<str, app.Res> = map.new entries [(%5, %2), (%6, %2), (%7, %4)], ty map<str, app.Res>
    bind %8, binding b2
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3
    ^b1(%9: failure) in S1:
    raise %9
    ^b2(%10: array<str>, %11: app.Res, %12: app.Res, %13: map<str, app.Res>) in S1 unwind ^b1:
    want %10
    [i12] exit.prepare return %10 at B0
    result.exit edge normal(0), value %10, demand want, prepare #12
    ret %10
    ^b3 in S2 unwind ^b1:
    %14: array<str> = map.keys %8
    want %14
    [i15] exit.prepare fallthrough %14 at B1
    want %2
    [i17] exit.prepare fallthrough %2 at B1
    want %4
    [i19] exit.prepare fallthrough %4 at B1
    want %8
    [i21] exit.prepare fallthrough %8 at B1
    result.exit edge normal(0), value %14, demand want, prepare #15
    result.exit edge normal(0), value %2, demand want, prepare #17
    result.exit edge normal(0), value %4, demand want, prepare #19
    result.exit edge normal(0), value %8, demand want, prepare #21
    br ^b2(%14, %2, %4, %8)
}

func @app.Select.borrowed#1(%0: app.Select, %1: map<str, app.Res>) -> array<str> [method app.Select] {
    binding b0 "xs": map<str, app.Res> in S3
    boundary B0 lexical in S3
    boundary B1 lexical in S4
    ^b0 in S3 unwind ^b1:
    bind %1, binding b0
    br ^b3
    ^b1(%2: failure) in S3:
    raise %2
    ^b2(%3: array<str>, %4: map<str, app.Res>) in S3 unwind ^b1:
    want %3
    [i2] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #2
    ret %3
    ^b3 in S4 unwind ^b1:
    %5: array<str> = map.keys %1
    want %5
    [i5] exit.prepare fallthrough %5 at B1
    want %1
    [i7] exit.prepare fallthrough %1 at B1
    result.exit edge normal(0), value %5, demand want, prepare #5
    result.exit edge normal(0), value %1, demand want, prepare #7
    br ^b2(%5, %1)
}

func @main() -> int [entry] {
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %0: int = const 0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S5:
    raise %1
}

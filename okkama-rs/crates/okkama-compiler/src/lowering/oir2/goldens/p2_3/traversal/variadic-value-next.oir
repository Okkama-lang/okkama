oir 2 high
module app
requires core
entry @main

object app.Walk {
}
scope S0 action in @app.Walk.run#0
scope S1 iteration in @app.Walk.run#0 parent S0
scope S2 branch in @app.Walk.run#0 parent S1
scope S3 branch in @app.Walk.run#0 parent S1
scope S4 action in @main
scope S5 action in @app.Walk.new#0

func @app.Walk.new#0() -> app.Walk [ctor app.Walk] {
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %0: app.Walk = obj.new app.Walk { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S5:
    raise %1
}

func @app.Walk.run#0(%0: app.Walk, %1: array<int>) -> int [method app.Walk] {
    binding b0 "xs": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S3
    ^b0 in S0 unwind ^b1:
    bind %1, binding b0
    %2: int = const 0
    %3: int = array.len %1
    %4: range = range.new %2, %3
    %5: bool = const false
    %6: int = const 0
    br ^b3(%2, %5, %6, %1)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: int, %9: array<int>) in S0 unwind ^b1:
    want %8
    [i7] exit.prepare return %8 at B0
    result.exit edge normal(0), value %8, demand want, prepare #7
    ret %8
    ^b3(%10: int, %11: bool, %12: int, %13: array<int>) in S0 unwind ^b1:
    %14: bool = int.lt %10, %3
    cond %14, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %15: int = array.get %1, %10
    bind %15, binding b1
    %16: int = const 1
    %17: bool = int.eq %15, %16
    cond %17, ^b10(%13, %15), ^b11(%13, %15)
    ^b5 in S0 unwind ^b1:
    cond %11, ^b6, ^b7
    ^b6 in S0 unwind ^b1:
    br ^b2(%12, %13)
    ^b7 in S0 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%18: bool, %19: int, %20: array<int>) in S0 unwind ^b1:
    %21: int = const 1
    %22: int = int.add %10, %21
    br ^b3(%22, %18, %19, %20)
    ^b9(%23: array<int>, %24: int) in S1 unwind ^b1:
    %25: bool = const true
    want %25
    [i17] exit.prepare fallthrough %25 at B1
    want %24
    [i19] exit.prepare fallthrough %24 at B1
    want %23
    [i21] exit.prepare fallthrough %23 at B1
    result.exit edge normal(0), value %25, demand want, prepare #17
    result.exit edge normal(0), value %24, demand want, prepare #19
    result.exit edge normal(0), value %23, demand want, prepare #21
    br ^b8(%25, %24, %23)
    ^b10(%26: array<int>, %27: int) in S2 unwind ^b1:
    want %11
    [i23] exit.prepare next %11 at B1
    want %12
    [i25] exit.prepare next %12 at B1
    want %26
    [i27] exit.prepare next %26 at B1
    result.exit edge normal(0), value %11, demand want, prepare #23
    result.exit edge normal(0), value %12, demand want, prepare #25
    result.exit edge normal(0), value %26, demand want, prepare #27
    br ^b8(%11, %12, %26)
    ^b11(%28: array<int>, %29: int) in S3 unwind ^b1:
    want %28
    [i29] exit.prepare fallthrough %28 at B2
    want %29
    [i31] exit.prepare fallthrough %29 at B2
    result.exit edge normal(0), value %28, demand want, prepare #29
    result.exit edge normal(0), value %29, demand want, prepare #31
    br ^b9(%28, %29)
}

func @main() -> int [entry] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    [i0] %0: app.Walk = call @app.Walk.new#0()
    %1: int = const 1
    %2: int = const 2
    %3: array<int> = array.new [%1, %2], ty array<int>
    [i4] %4: int = call @app.Walk.run#0(%0, %3)
    want %4
    [i6] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #6
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    ret %4
    ^b1(%5: failure) in S4:
    raise %5
}

oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1
scope S3 action in @main.defer#0

func @main() -> int [entry] {
    binding b0 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: builder<int> = builder.new element int
    br ^b3(%3, %6)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: builder<int>) in S0 unwind ^b14(%8):
    %9: array<int> = builder.finish %8
    discard %9
    %10: int = const 0
    want %10
    [i11] exit.prepare return %10 at B0
    result.exit edge normal(0), value %9, demand discard, prepare none
    result.exit edge normal(0), value %10, demand want, prepare #11
    ret %10
    ^b3(%11: int, %12: builder<int>) in S0 unwind ^b1:
    %13: bool = int.lt %11, %4
    cond %13, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    br ^b7(%12)
    ^b5 in S0 unwind ^b1:
    br ^b2(%12)
    ^b6(%14: builder<int>) in S0 unwind ^b1:
    %15: int = const 1
    %16: int = int.add %11, %15
    br ^b3(%16, %14)
    ^b7(%17: builder<int>) in S1 unwind ^b8(%17):
    %18: int = array.get %2, %11
    bind %18, binding b0
    br ^b10
    ^b8(%19: builder<int>, %20: failure) in S1 unwind ^b1:
    builder.abandon %19
    raise %20
    ^b9(%21: int, %22: int, %23: builder<int>) in S1 unwind ^b13(%23):
    %24: builder<int> = builder.push %23, %21
    exit.prepare fallthrough select s0 at B1
    br ^b6(%24)
    ^b10 in S2 unwind ^b1:
    defer.register S2, action defer_action(function=@main.defer#0, bindings=[b0])
    br ^b11(%18, %17)
    ^b11(%25: int, %26: builder<int>) in S2 unwind ^b12:
    %27: int = const 1
    %28: int = int.add %25, %27
    want %28
    [i24] exit.prepare fallthrough %28 at B2
    want %25
    [i26] exit.prepare fallthrough %25 at B2
    result.exit edge normal(0), value %28, demand want, prepare #24
    result.exit edge normal(0), value %25, demand want, prepare #26
    br ^b9(%28, %25, %26)
    ^b12(%29: failure) in S0:
    raise %29
    ^b13(%30: builder<int>, %31: failure) in S1 unwind ^b1:
    builder.abandon %30
    raise %31
    ^b14(%32: builder<int>, %33: failure) in S0 unwind ^b1:
    builder.abandon %32
    raise %33
}

func @main.defer#0(%0: int) -> void {
    binding b0 "x": int in S3
    boundary B0 lexical in S3
    selection s0: selection = union([])
    ^b0 in S3 unwind ^b1:
    bind %0, binding b0
    %1: int = const 1
    %2: int = int.mod %0, %1
    discard %2
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %2, demand discard, prepare none
    ret
    ^b1(%3: failure) in S3:
    raise %3
}

oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}

object app.Walk {
    does "collections/iteration::Batching<object(app::Res)>" {batch = @app.Walk.batch#0}
}

object app.Run {
}

role "collections/iteration::Batching<object(app::Res)>" {
    batch() -> array<app.Res>
}
scope S0 action in @app.Res.read#0
scope S1 action in @app.Res.destroy
scope S2 action in @app.Walk.batch#0
scope S3 action in @app.Run.run#0
scope S4 block in @app.Run.run#0 parent S3
scope S5 iteration in @app.Run.run#0 parent S4
scope S6 action in @main
scope S7 action in @app.Res.new#0
scope S8 action in @app.Walk.new#0
scope S9 action in @app.Run.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S7
    boundary B0 lexical in S7
    ^b0 in S7 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S7, field field_ref(declaration=app.Res, index=0)
    bind %0, binding b0
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S7:
    raise %3
}

func @app.Res.read#0(%0: app.Res) -> int [method app.Res] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Walk.new#0() -> app.Walk [ctor app.Walk] {
    boundary B0 lexical in S8
    ^b0 in S8 unwind ^b1:
    %0: app.Walk = obj.new app.Walk { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S8:
    raise %1
}

func @app.Walk.batch#0(%0: app.Walk) -> array<app.Res> [method app.Walk] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: int = const 1
    [i1] %2: app.Res = call @app.Res.new#0(%1)
    %3: int = const 2
    [i3] %4: app.Res = call @app.Res.new#0(%3)
    %5: array<app.Res> = array.new [%2, %4], ty array<app.Res>
    want %5
    [i6] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #6
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    ret %5
    ^b1(%6: failure) in S2:
    raise %6
}

func @app.Run.new#0() -> app.Run [ctor app.Run] {
    boundary B0 lexical in S9
    ^b0 in S9 unwind ^b1:
    %0: app.Run = obj.new app.Run { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S9:
    raise %1
}

func @app.Run.run#0(%0: app.Run) -> app.Res [method app.Run] {
    binding b0 "$source": "collections/iteration::Batching<object(app::Res)>" in S3
    binding b1 "$batch": array<app.Res> in S4
    binding b2 "x": app.Res in S5
    boundary B0 lexical in S3
    boundary B1 lexical in S4
    boundary B2 lexical in S4
    boundary B3 loop in S5
    ^b0 in S3 unwind ^b1:
    [i0] %1: app.Walk = call @app.Walk.new#0()
    %2: "collections/iteration::Batching<object(app::Res)>" = role.wrap %1, ty "collections/iteration::Batching<object(app::Res)>"
    bind %2, binding b0
    %3: bool = const false
    %4: array<app.Res> = array.new ty array<app.Res>
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%3, %4)
    ^b1(%5: failure) in S3:
    raise %5
    ^b2(%6: app.Res) in S3 unwind ^b1:
    want %6
    [i6] exit.prepare return %6 at B0
    result.exit edge normal(0), value %6, demand want, prepare #6
    ret %6
    ^b3(%7: bool, %8: array<app.Res>) in S3 unwind ^b1:
    br ^b4(%7, %8)
    ^b4(%9: bool, %10: array<app.Res>) in S4 unwind ^b1:
    [i7] %11: array<app.Res> = call.role %2, "collections/iteration::Batching<object(app::Res)>" slot 0()
    bind %11, binding b1
    %12: int = array.len %11
    %13: int = const 0
    %14: bool = int.lt %13, %12
    high.effects at #7 failures [thrown, program, panic, native, cancelled], suspends true
    cond %14, ^b5, ^b6
    ^b5 in S4 unwind ^b1:
    br ^b9(%13, %9, %10)
    ^b6 in S4 unwind ^b1:
    cond %9, ^b7, ^b8
    ^b7 in S4 unwind ^b1:
    %15: int = const 0
    %16: app.Res = array.get %10, %15
    want %16
    [i15] exit.prepare fallthrough %16 at B1
    result.exit edge normal(0), value %16, demand want, prepare #15
    br ^b2(%16)
    ^b8 in S4 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b9(%17: int, %18: bool, %19: array<app.Res>) in S4 unwind ^b1:
    %20: bool = int.lt %17, %12
    cond %20, ^b10, ^b11
    ^b10 in S5 unwind ^b1:
    %21: app.Res = array.get %11, %17
    bind %21, binding b2
    want %21
    [i20] exit.prepare last %21 at B3
    result.exit edge normal(0), value %21, demand want, prepare #20
    br ^b2(%21)
    ^b11 in S4 unwind ^b1:
    want %18
    [i22] exit.prepare fallthrough %18 at B2
    want %19
    [i24] exit.prepare fallthrough %19 at B2
    result.exit edge normal(0), value %18, demand want, prepare #22
    result.exit edge normal(0), value %19, demand want, prepare #24
    br ^b3(%18, %19)
    ^b12 in S4:
    unreachable
}

func @main() -> int [entry] {
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %0: int = const 0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S6:
    raise %1
}

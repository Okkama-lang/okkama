func "@app::Box<int>.new#ctor(value:int)"(%0: int) -> "app::Box<int>" [ctor "app::Box<int>"] {
    binding b0 "value": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S3, field field_ref(declaration="app::Box<int>", index=0)
    bind %0, binding b0
    %2: "app::Box<int>" = obj.new "app::Box<int>" { value: %0 }
    want %2

oir 2 high
module app
requires core
entry @main

object "app::Box<int>" {
    field value: int
}

object "app::Box<string>" {
    field value: str
}
scope S0 action in @main
scope S1 action in "@app::Box<string>.get#overload()"
scope S2 action in "@app::Box<int>.get#overload()"
scope S3 action in "@app::Box<int>.new#ctor(value:int)"
scope S4 action in "@app::Box<string>.new#ctor(value:string)"

func @main() -> int [entry] {
    binding b0 "a": "app::Box<int>" in S0
    binding b1 "b": "app::Box<string>" in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    [i1] %1: "app::Box<int>" = call "@app::Box<int>.new#ctor(value:int)"(%0)
    bind %1, binding b0
    %2: str = const "s"
    [i4] %3: "app::Box<string>" = call "@app::Box<string>.new#ctor(value:string)"(%2)
    bind %3, binding b1
    [i6] %4: str = call "@app::Box<string>.get#overload()"(%3)
    discard %4
    [i8] %5: int = call "@app::Box<int>.get#overload()"(%1)
    want %5
    [i10] exit.prepare return %5 at B0
    result.exit edge normal(0), value %4, demand discard, prepare none
    result.exit edge normal(0), value %5, demand want, prepare #10
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #8 failures [thrown, program, panic, native, cancelled], suspends true
    ret %5
    ^b1(%6: failure) in S0:
    raise %6
}

func "@app::Box<int>.new#ctor(value:int)"(%0: int) -> "app::Box<int>" [ctor "app::Box<int>"] {
    binding b0 "value": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S3, field field_ref(declaration="app::Box<int>", index=0)
    bind %0, binding b0
    %2: "app::Box<int>" = obj.new "app::Box<int>" { value: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func "@app::Box<string>.new#ctor(value:string)"(%0: str) -> "app::Box<string>" [ctor "app::Box<string>"] {
    binding b0 "value": str in S4

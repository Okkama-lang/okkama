oir 2 high
module app
requires core
entry @main

variant "app::Maybe<int>" = (some: "app::Maybe<int>.some", none: "app::Maybe<int>.none")

object "app::Maybe<int>.some" {
    field value: int
}

object "app::Maybe<int>.none" {
}
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": map<int, int> in S0
    binding b1 "key": int in S1
    binding b2 "value": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    boundary B3 lexical in S1
    ^b0 in S0 unwind ^b1:
    %0: map<int, int> = map.new ty map<int, int>
    bind %0, binding b0
    %1: int = const 0
    %2: int = map.len %0
    %3: range = range.new %1, %2
    %4: "app::Maybe<int>" = variant.new ty "app::Maybe<int>", case 1
    br ^b3(%1, %0, %4)
    ^b1(%5: failure) in S0:
    raise %5
    ^b2(%6: map<int, int>, %7: "app::Maybe<int>") in S0 unwind ^b1:
    discard %7
    %8: int = const 0
    want %8
    [i9] exit.prepare return %8 at B0
    result.exit edge normal(0), value %7, demand discard, prepare none
    result.exit edge normal(0), value %8, demand want, prepare #9
    ret %8
    ^b3(%9: int, %10: map<int, int>, %11: "app::Maybe<int>") in S0 unwind ^b1:
    %12: bool = int.lt %9, %2
    cond %12, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %13: int = map.key_at %0, %9
    %14: int = map.value_at %0, %9
    bind %13, binding b1
    bind %14, binding b2
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%10, %11)
    ^b6(%15: map<int, int>, %16: "app::Maybe<int>") in S0 unwind ^b1:
    %17: int = const 1
    %18: int = int.add %9, %17
    br ^b3(%18, %15, %16)
    ^b7(%19: bool, %20: map<int, int>, %21: int, %22: int, %23: "app::Maybe<int>") in S1 unwind ^b1:
    cond %19, ^b9, ^b10
    ^b8 in S2 unwind ^b1:
    %24: int = const 0
    %25: bool = int.gt %14, %24
    want %25
    [i20] exit.prepare fallthrough %25 at B2
    want %10
    [i22] exit.prepare fallthrough %10 at B2
    want %14
    [i24] exit.prepare fallthrough %14 at B2
    want %13
    [i26] exit.prepare fallthrough %13 at B2
    want %11
    [i28] exit.prepare fallthrough %11 at B2
    result.exit edge normal(0), value %25, demand want, prepare #20
    result.exit edge normal(0), value %10, demand want, prepare #22
    result.exit edge normal(0), value %14, demand want, prepare #24
    result.exit edge normal(0), value %13, demand want, prepare #26
    result.exit edge normal(0), value %11, demand want, prepare #28
    br ^b7(%25, %10, %14, %13, %11)
    ^b9 in S1 unwind ^b1:
    %26: "app::Maybe<int>" = variant.new [%21], ty "app::Maybe<int>", case 0
    want %20
    [i31] exit.prepare fallthrough %20 at B3
    want %26
    [i33] exit.prepare fallthrough %26 at B3
    result.exit edge normal(0), value %20, demand want, prepare #31
    result.exit edge normal(0), value %26, demand want, prepare #33
    br ^b2(%20, %26)
    ^b10 in S1 unwind ^b1:
    want %20
    [i35] exit.prepare fallthrough %20 at B1
    want %23
    [i37] exit.prepare fallthrough %23 at B1
    result.exit edge normal(0), value %20, demand want, prepare #35
    result.exit edge normal(0), value %23, demand want, prepare #37
    br ^b6(%20, %23)
}

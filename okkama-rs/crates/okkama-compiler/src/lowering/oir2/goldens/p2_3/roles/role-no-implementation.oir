oir 2 high
module app
requires core
entry @main

object app.Reader {
}

role app.Empty {
    read() -> int
}
scope S0 action in @app.Reader.read#0
scope S1 action in @main
scope S2 action in @app.Reader.new#0

func @app.Reader.new#0() -> app.Reader [ctor app.Reader] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: app.Reader = obj.new app.Reader { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S2:
    raise %1
}

func @app.Reader.read#0(%0: app.Reader, %1: app.Empty) -> int [method app.Reader] {
    binding b0 "value": app.Empty in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    bind %1, binding b0
    unreachable
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %0: int = const 0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S1:
    raise %1
}

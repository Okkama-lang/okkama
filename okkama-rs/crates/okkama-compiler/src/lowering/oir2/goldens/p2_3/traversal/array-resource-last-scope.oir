oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}
scope S0 action in @app.Res.read#0
scope S1 action in @app.Res.destroy
scope S2 action in @main
scope S3 iteration in @main parent S2
scope S4 branch in @main parent S3
scope S5 branch in @main parent S3
scope S6 action in @app.Res.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S6, field field_ref(declaration=app.Res, index=0)
    bind %0, binding b0
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Res.read#0(%0: app.Res) -> int [method app.Res] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S1:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "n": int in S3
    binding b1 "resource": app.Res in S3
    boundary B0 lexical in S2
    boundary B1 loop in S3
    boundary B2 lexical in S5
    selection s0: selection = union([])
    selection s1: selection = union([])
    ^b0 in S2 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    br ^b3(%3)
    ^b1(%6: failure) in S2:
    raise %6
    ^b2 in S2 unwind ^b1:
    %7: int = const 0
    want %7
    [i8] exit.prepare return %7 at B0
    result.exit edge normal(0), value %7, demand want, prepare #8
    ret %7
    ^b3(%8: int) in S2 unwind ^b1:
    %9: bool = int.lt %8, %4
    cond %9, ^b4, ^b5
    ^b4 in S3 unwind ^b1:
    %10: int = array.get %2, %8
    bind %10, binding b0
    [i12] %11: app.Res = call @app.Res.new#0(%10)
    bind %11, binding b1
    %12: int = const 1
    %13: bool = int.eq %10, %12
    high.effects at #12 failures [thrown, program, panic, native, cancelled], suspends true
    cond %13, ^b8(%10, %11), ^b9(%10, %11)
    ^b5 in S2 unwind ^b1:
    br ^b2
    ^b6 in S2 unwind ^b1:
    %14: int = const 1
    %15: int = int.add %8, %14
    br ^b3(%15)
    ^b7(%16: int, %17: app.Res) in S3 unwind ^b1:
    [i18] %18: int = call @app.Res.read#0(%17)
    discard %18
    exit.prepare fallthrough select s1 at B1
    result.exit edge normal(0), value %18, demand discard, prepare none
    high.effects at #18 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b6
    ^b8(%19: int, %20: app.Res) in S4 unwind ^b1:
    exit.prepare last select s0 at B1
    br ^b2
    ^b9(%21: int, %22: app.Res) in S5 unwind ^b1:
    want %21
    [i23] exit.prepare fallthrough %21 at B2
    want %22
    [i25] exit.prepare fallthrough %22 at B2
    result.exit edge normal(0), value %21, demand want, prepare #23
    result.exit edge normal(0), value %22, demand want, prepare #25
    br ^b7(%21, %22)
}

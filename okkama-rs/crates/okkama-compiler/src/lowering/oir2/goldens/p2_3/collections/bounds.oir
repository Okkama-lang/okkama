oir 2 high
module app
requires core
entry @main

role Error [builtin] {
    text() -> str
}
scope S0 action in @main
scope S1 try in @main parent S0
scope S2 catch in @main parent S0

func @main() -> int [entry] {
    binding b0 "a": array<int> in S0
    binding b1 "e": Error in S2
    boundary B0 lexical in S0
    boundary B1 lexical in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: array<int> = array.new ty array<int>
    bind %0, binding b0
    br ^b4(%0)
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: array<int>) in S0 unwind ^b1:
    %3: int = const 0
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    ret %3
    ^b3(%4: array<int>, %5: failure) in S0 unwind ^b1:
    catch %5 is Error, ^b5(%4, %5, $value), ^b6(%4, %5)
    ^b4(%6: array<int>) in S1 unwind ^b3(%6):
    %7: int = const 1
    %8: int = array.get %6, %7
    discard %8
    want %6
    [i9] exit.prepare fallthrough %6 at B1
    result.exit edge normal(0), value %8, demand discard, prepare none
    result.exit edge normal(0), value %6, demand want, prepare #9
    br ^b2(%6)
    ^b5(%9: array<int>, %10: failure, %11: Error) in S2 unwind ^b1:
    bind %11, binding b1
    br ^b8(%9, %10)
    ^b6(%12: array<int>, %13: failure) in S0 unwind ^b1:
    raise %13
    ^b7(%14: array<int>, %15: failure, %16: failure) in S0 unwind ^b1:
    %17: failure = fail.caused %16, %15
    raise %17
    ^b8(%18: array<int>, %19: failure) in S2 unwind ^b7(%18, %19):
    %20: int = const 0
    discard %20
    want %18
    [i15] exit.prepare fallthrough %18 at B2
    result.exit edge normal(0), value %20, demand discard, prepare none
    result.exit edge normal(0), value %18, demand want, prepare #15
    br ^b2(%18)
}

    ^b1(%6: failure) in S2:
    raise %6
    ^b2(%7: str, %8: int, %9: str, %10: int) in S2 unwind ^b1:
    stage %7, action S2, field field_ref(declaration="collections/frequencies::Frequency<string>", index=0)
    stage %8, action S2, field field_ref(declaration="collections/frequencies::Frequency<string>", index=1)
    %11: "collections/frequencies::Frequency<string>" = obj.new "collections/frequencies::Frequency<string>" { origin: %7, quantity: %8 }
    want %11
    [i10] exit.prepare return %11 at B0
    result.exit edge normal(0), value %11, demand want, prepare #10
    ret %11
    ^b3(%12: str, %13: int, %14: str, %15: int) in S2 unwind ^b1:
    %16: str = const "frequency amount must be positive"
    %17: error.InvalidArgument = variant.new [%16], ty error.InvalidArgument, case 0
    throw %17
}

func "@collections/frequencies::Frequency<string>.amount#overload()"(%0: "collections/frequencies::Frequency<string>") -> int [method "collections/frequencies::Frequency<string>"] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, quantity
    want %1
    [i2] exit.prepare return %1 at B0

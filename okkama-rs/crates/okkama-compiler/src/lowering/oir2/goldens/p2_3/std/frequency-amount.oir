variant error.InvalidArgument is Error = (because: error.InvalidArgument.because)
scope S0 action in @main
scope S1 action in "@collections/frequencies::Frequency<string>.amount#overload()"
scope S2 action in "@collections/frequencies::Frequency<string>.new#ctor(item:string,amount:int)"

func @main() -> int [entry] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: str = const "blue"
    %1: int = const 2
    [i2] %2: "collections/frequencies::Frequency<string>" = call "@collections/frequencies::Frequency<string>.new#ctor(item:string,amount:int)"(%0, %1)
    [i3] %3: int = call "@collections/frequencies::Frequency<string>.amount#overload()"(%2)
    want %3
    [i5] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #5
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b1(%4: failure) in S0:
    raise %4
}


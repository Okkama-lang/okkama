oir 2 high
module app
requires core
entry @main

object app.Walk {
    field values: array<int>
    does "collections/iteration::Batching<int>" {batch = @app.Walk.batch#0}
}

role "collections/iteration::Batching<int>" {
    batch() -> array<int>
}
scope S0 action in @app.Walk.batch#0
scope S1 action in @main
scope S2 block in @main parent S1
scope S3 iteration in @main parent S2
scope S4 action in @app.Walk.new#0

func @app.Walk.new#0(%0: array<int>) -> app.Walk [ctor app.Walk] {
    binding b0 "values": array<int> in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: array<int> = undef ty array<int>
    stage %0, action S4, field field_ref(declaration=app.Walk, index=0)
    bind %0, binding b0
    %2: app.Walk = obj.new app.Walk { values: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.Walk.batch#0(%0: app.Walk) -> array<int> [method app.Walk] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: array<int> = obj.get %0, values
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Batching<int>" in S1
    binding b1 "$batch": array<int> in S2
    binding b2 "x": int in S3
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    boundary B2 lexical in S2
    boundary B3 loop in S3
    ^b0 in S1 unwind ^b1:
    %0: array<int> = array.new ty array<int>
    [i1] %1: app.Walk = call @app.Walk.new#0(%0)
    %2: "collections/iteration::Batching<int>" = role.wrap %1, ty "collections/iteration::Batching<int>"
    bind %2, binding b0
    %3: bool = const false
    %4: int = const 0
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%3, %4)
    ^b1(%5: failure) in S1:
    raise %5
    ^b2(%6: int) in S1 unwind ^b1:
    want %6
    [i7] exit.prepare return %6 at B0
    result.exit edge normal(0), value %6, demand want, prepare #7
    ret %6
    ^b3(%7: bool, %8: int) in S1 unwind ^b1:
    br ^b4(%7, %8)
    ^b4(%9: bool, %10: int) in S2 unwind ^b1:
    [i8] %11: array<int> = call.role %2, "collections/iteration::Batching<int>" slot 0()
    bind %11, binding b1
    %12: int = array.len %11
    %13: int = const 0
    %14: bool = int.lt %13, %12
    high.effects at #8 failures [thrown, program, panic, native, cancelled], suspends true
    cond %14, ^b5, ^b6
    ^b5 in S2 unwind ^b1:
    br ^b9(%13, %9, %10)
    ^b6 in S2 unwind ^b1:
    cond %9, ^b7, ^b8
    ^b7 in S2 unwind ^b1:
    want %10
    [i14] exit.prepare fallthrough %10 at B1
    result.exit edge normal(0), value %10, demand want, prepare #14
    br ^b2(%10)
    ^b8 in S2 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b9(%15: int, %16: bool, %17: int) in S2 unwind ^b1:
    %18: bool = int.lt %15, %12
    cond %18, ^b10, ^b11
    ^b10 in S3 unwind ^b1:
    %19: int = array.get %11, %15
    bind %19, binding b2
    %20: bool = const true
    want %20
    [i20] exit.prepare fallthrough %20 at B3
    want %19
    [i22] exit.prepare fallthrough %19 at B3
    result.exit edge normal(0), value %20, demand want, prepare #20
    result.exit edge normal(0), value %19, demand want, prepare #22
    br ^b12(%20, %19)
    ^b11 in S2 unwind ^b1:
    want %16
    [i24] exit.prepare fallthrough %16 at B2
    want %17
    [i26] exit.prepare fallthrough %17 at B2
    result.exit edge normal(0), value %16, demand want, prepare #24
    result.exit edge normal(0), value %17, demand want, prepare #26
    br ^b3(%16, %17)
    ^b12(%21: bool, %22: int) in S2 unwind ^b1:
    %23: int = const 1
    %24: int = int.add %15, %23
    br ^b9(%24, %21, %22)
}

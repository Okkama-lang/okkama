oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: array<int> = array.new ty array<int>
    bind %0, binding b0
    %1: int = const 0
    %2: int = array.len %0
    %3: range = range.new %1, %2
    %4: builder<int> = builder.new element int
    br ^b3(%1, %0, %4)
    ^b1(%5: failure) in S0:
    raise %5
    ^b2(%6: array<int>, %7: builder<int>) in S0 unwind ^b16(%7):
    %8: array<int> = builder.finish %7
    discard %8
    %9: int = const 0
    want %9
    [i10] exit.prepare return %9 at B0
    result.exit edge normal(0), value %8, demand discard, prepare none
    result.exit edge normal(0), value %9, demand want, prepare #10
    ret %9
    ^b3(%10: int, %11: array<int>, %12: builder<int>) in S0 unwind ^b1:
    %13: bool = int.lt %10, %2
    cond %13, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    br ^b7(%11, %12)
    ^b5 in S0 unwind ^b1:
    br ^b2(%11, %12)
    ^b6(%14: array<int>, %15: builder<int>) in S0 unwind ^b1:
    %16: int = const 1
    %17: int = int.add %10, %16
    br ^b3(%17, %14, %15)
    ^b7(%18: array<int>, %19: builder<int>) in S1 unwind ^b8(%19):
    %20: int = array.get %0, %10
    bind %20, binding b1
    br ^b10
    ^b8(%21: builder<int>, %22: failure) in S1 unwind ^b1:
    builder.abandon %21
    raise %22
    ^b9(%23: bool, %24: array<int>, %25: int, %26: builder<int>) in S1 unwind ^b1:
    cond %23, ^b12, ^b13
    ^b10 in S2 unwind ^b1:
    %27: int = const 0
    %28: bool = int.gt %20, %27
    want %28
    [i20] exit.prepare fallthrough %28 at B2
    want %18
    [i22] exit.prepare fallthrough %18 at B2
    want %20
    [i24] exit.prepare fallthrough %20 at B2
    result.exit edge normal(0), value %28, demand want, prepare #20
    result.exit edge normal(0), value %18, demand want, prepare #22
    result.exit edge normal(0), value %20, demand want, prepare #24
    br ^b9(%28, %18, %20, %19)
    ^b11(%29: array<int>, %30: int, %31: builder<int>) in S1 unwind ^b1:
    want %29
    [i26] exit.prepare fallthrough %29 at B1
    result.exit edge normal(0), value %29, demand want, prepare #26
    br ^b6(%29, %31)
    ^b12 in S1 unwind ^b1:
    br ^b14(%24, %25, %26)
    ^b13 in S1 unwind ^b1:
    br ^b11(%24, %25, %26)
    ^b14(%32: array<int>, %33: int, %34: builder<int>) in S1 unwind ^b15(%34):
    %35: builder<int> = builder.push %34, %20
    br ^b11(%32, %33, %35)
    ^b15(%36: builder<int>, %37: failure) in S1 unwind ^b1:
    builder.abandon %36
    raise %37
    ^b16(%38: builder<int>, %39: failure) in S0 unwind ^b1:
    builder.abandon %38
    raise %39
}

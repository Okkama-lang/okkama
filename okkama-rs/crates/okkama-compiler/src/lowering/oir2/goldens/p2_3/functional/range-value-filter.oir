oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": range in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: range = range.new %0, %1, inclusive true
    bind %2, binding b0
    %3: int = range.start %2
    %4: int = range.len %2
    %5: int = int.add %3, %4
    %6: range = range.new %3, %5
    %7: builder<int> = builder.new element int
    br ^b3(%3, %2, %7)
    ^b1(%8: failure) in S0:
    raise %8
    ^b2(%9: range, %10: builder<int>) in S0 unwind ^b14(%10):
    %11: array<int> = builder.finish %10
    discard %11
    %12: int = const 0
    want %12
    [i13] exit.prepare return %12 at B0
    result.exit edge normal(0), value %11, demand discard, prepare none
    result.exit edge normal(0), value %12, demand want, prepare #13
    ret %12
    ^b3(%13: int, %14: range, %15: builder<int>) in S0 unwind ^b1:
    %16: bool = int.lt %13, %5
    cond %16, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %13, binding b1
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%14, %15)
    ^b6(%17: range, %18: builder<int>) in S0 unwind ^b1:
    %19: int = const 1
    %20: int = int.add %13, %19
    br ^b3(%20, %17, %18)
    ^b7(%21: bool, %22: range, %23: int, %24: builder<int>) in S1 unwind ^b1:
    cond %21, ^b10, ^b11
    ^b8 in S2 unwind ^b1:
    %25: int = const 0
    %26: bool = int.gt %13, %25
    want %26
    [i21] exit.prepare fallthrough %26 at B2
    want %14
    [i23] exit.prepare fallthrough %14 at B2
    want %13
    [i25] exit.prepare fallthrough %13 at B2
    result.exit edge normal(0), value %26, demand want, prepare #21
    result.exit edge normal(0), value %14, demand want, prepare #23
    result.exit edge normal(0), value %13, demand want, prepare #25
    br ^b7(%26, %14, %13, %15)
    ^b9(%27: range, %28: int, %29: builder<int>) in S1 unwind ^b1:
    want %27
    [i27] exit.prepare fallthrough %27 at B1
    result.exit edge normal(0), value %27, demand want, prepare #27
    br ^b6(%27, %29)
    ^b10 in S1 unwind ^b1:
    br ^b12(%22, %23, %24)
    ^b11 in S1 unwind ^b1:
    br ^b9(%22, %23, %24)
    ^b12(%30: range, %31: int, %32: builder<int>) in S1 unwind ^b13(%32):
    %33: builder<int> = builder.push %32, %13
    br ^b9(%30, %31, %33)
    ^b13(%34: builder<int>, %35: failure) in S1 unwind ^b1:
    builder.abandon %34
    raise %35
    ^b14(%36: builder<int>, %37: failure) in S0 unwind ^b1:
    builder.abandon %36
    raise %37
}

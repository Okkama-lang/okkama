oir 2 high
module app
requires core
entry @main

object app.Walk {
    field values: array<int>
    does "collections/iteration::Batching<int>" {batch = @app.Walk.batch#0}
}

role "collections/iteration::Batching<int>" {
    batch() -> array<int>
}
scope S0 action in @app.Walk.batch#0
scope S1 action in @main
scope S2 block in @main parent S1
scope S3 iteration in @main parent S2
scope S4 branch in @main parent S3
scope S5 branch in @main parent S3
scope S6 action in @app.Walk.new#0

func @app.Walk.new#0(%0: array<int>) -> app.Walk [ctor app.Walk] {
    binding b0 "values": array<int> in S6
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %1: array<int> = undef ty array<int>
    stage %0, action S6, field field_ref(declaration=app.Walk, index=0)
    bind %0, binding b0
    %2: app.Walk = obj.new app.Walk { values: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S6:
    raise %3
}

func @app.Walk.batch#0(%0: app.Walk) -> array<int> [method app.Walk] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: array<int> = obj.get %0, values
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Batching<int>" in S1
    binding b1 "$batch": array<int> in S2
    binding b2 "x": int in S3
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    boundary B2 lexical in S2
    boundary B3 loop in S3
    boundary B4 lexical in S5
    ^b0 in S1 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    [i3] %3: app.Walk = call @app.Walk.new#0(%2)
    %4: "collections/iteration::Batching<int>" = role.wrap %3, ty "collections/iteration::Batching<int>"
    bind %4, binding b0
    %5: bool = const false
    %6: int = const 0
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%5, %6)
    ^b1(%7: failure) in S1:
    raise %7
    ^b2(%8: int) in S1 unwind ^b1:
    want %8
    [i9] exit.prepare return %8 at B0
    result.exit edge normal(0), value %8, demand want, prepare #9
    ret %8
    ^b3(%9: bool, %10: int) in S1 unwind ^b1:
    br ^b4(%9, %10)
    ^b4(%11: bool, %12: int) in S2 unwind ^b1:
    [i10] %13: array<int> = call.role %4, "collections/iteration::Batching<int>" slot 0()
    bind %13, binding b1
    %14: int = array.len %13
    %15: int = const 0
    %16: bool = int.lt %15, %14
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    cond %16, ^b5, ^b6
    ^b5 in S2 unwind ^b1:
    br ^b9(%15, %11, %12)
    ^b6 in S2 unwind ^b1:
    cond %11, ^b7, ^b8
    ^b7 in S2 unwind ^b1:
    want %12
    [i16] exit.prepare fallthrough %12 at B1
    result.exit edge normal(0), value %12, demand want, prepare #16
    br ^b2(%12)
    ^b8 in S2 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b9(%17: int, %18: bool, %19: int) in S2 unwind ^b1:
    %20: bool = int.lt %17, %14
    cond %20, ^b10, ^b11
    ^b10 in S3 unwind ^b1:
    %21: int = array.get %13, %17
    bind %21, binding b2
    %22: int = const 2
    %23: bool = int.eq %21, %22
    cond %23, ^b14(%21), ^b15(%21)
    ^b11 in S2 unwind ^b1:
    want %18
    [i23] exit.prepare fallthrough %18 at B2
    want %19
    [i25] exit.prepare fallthrough %19 at B2
    result.exit edge normal(0), value %18, demand want, prepare #23
    result.exit edge normal(0), value %19, demand want, prepare #25
    br ^b3(%18, %19)
    ^b12(%24: bool, %25: int) in S2 unwind ^b1:
    %26: int = const 1
    %27: int = int.add %17, %26
    br ^b9(%27, %24, %25)
    ^b13(%28: int) in S3 unwind ^b1:
    %29: bool = const true
    want %29
    [i30] exit.prepare fallthrough %29 at B3
    want %28
    [i32] exit.prepare fallthrough %28 at B3
    result.exit edge normal(0), value %29, demand want, prepare #30
    result.exit edge normal(0), value %28, demand want, prepare #32
    br ^b12(%29, %28)
    ^b14(%30: int) in S4 unwind ^b1:
    cond %18, ^b16, ^b17
    ^b15(%31: int) in S5 unwind ^b1:
    want %31
    [i34] exit.prepare fallthrough %31 at B4
    result.exit edge normal(0), value %31, demand want, prepare #34
    br ^b13(%31)
    ^b16 in S4 unwind ^b1:
    want %19
    [i36] exit.prepare last %19 at B3
    result.exit edge normal(0), value %19, demand want, prepare #36
    br ^b2(%19)
    ^b17 in S4 unwind ^b1:
    trap empty "A void result cannot be used as a value"
}

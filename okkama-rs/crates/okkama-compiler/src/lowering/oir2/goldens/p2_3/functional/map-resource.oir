oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    destroy @app.Res.destroy
}
scope S0 action in @app.Res.destroy
scope S1 action in @main
scope S2 iteration in @main parent S1
scope S3 block in @main parent S2
scope S4 action in @app.Res.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S4, field field_ref(declaration=app.Res, index=0)
    bind %0, binding b0
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "x": int in S2
    binding b1 "retired": app.Res in S3
    boundary B0 lexical in S1
    boundary B1 loop in S2
    boundary B2 lexical in S3
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: builder<app.Res> = builder.new element app.Res
    br ^b3(%3, %6)
    ^b1(%7: failure) in S1:
    raise %7
    ^b2(%8: builder<app.Res>) in S1 unwind ^b14(%8):
    %9: array<app.Res> = builder.finish %8
    discard %9
    %10: int = const 0
    want %10
    [i11] exit.prepare return %10 at B0
    result.exit edge normal(0), value %9, demand discard, prepare none
    result.exit edge normal(0), value %10, demand want, prepare #11
    ret %10
    ^b3(%11: int, %12: builder<app.Res>) in S1 unwind ^b1:
    %13: bool = int.lt %11, %4
    cond %13, ^b4, ^b5
    ^b4 in S2 unwind ^b1:
    br ^b7(%12)
    ^b5 in S1 unwind ^b1:
    br ^b2(%12)
    ^b6(%14: builder<app.Res>) in S1 unwind ^b1:
    %15: int = const 1
    %16: int = int.add %11, %15
    br ^b3(%16, %14)
    ^b7(%17: builder<app.Res>) in S2 unwind ^b8(%17):
    %18: int = array.get %2, %11
    bind %18, binding b0
    br ^b10
    ^b8(%19: builder<app.Res>, %20: failure) in S2 unwind ^b1:
    builder.abandon %19
    raise %20
    ^b9(%21: app.Res, %22: int, %23: builder<app.Res>) in S2 unwind ^b13(%23):
    %24: builder<app.Res> = builder.push %23, %21
    exit.prepare fallthrough select s0 at B1
    br ^b6(%24)
    ^b10 in S3 unwind ^b1:
    %25: int = const 10
    %26: int = int.add %18, %25
    br ^b11(%18, %17)
    ^b11(%27: int, %28: builder<app.Res>) in S3 unwind ^b12(%28):
    [i22] %29: app.Res = call @app.Res.new#0(%26)
    bind %29, binding b1
    [i24] %30: app.Res = call @app.Res.new#0(%27)
    want %30
    [i26] exit.prepare fallthrough %30 at B2
    want %27
    [i28] exit.prepare fallthrough %27 at B2
    result.exit edge normal(0), value %30, demand want, prepare #26
    result.exit edge normal(0), value %27, demand want, prepare #28
    high.effects at #22 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #24 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b9(%30, %27, %28)
    ^b12(%31: builder<app.Res>, %32: failure) in S3 unwind ^b1:
    builder.abandon %31
    raise %32
    ^b13(%33: builder<app.Res>, %34: failure) in S2 unwind ^b1:
    builder.abandon %33
    raise %34
    ^b14(%35: builder<app.Res>, %36: failure) in S1 unwind ^b1:
    builder.abandon %35
    raise %36
}

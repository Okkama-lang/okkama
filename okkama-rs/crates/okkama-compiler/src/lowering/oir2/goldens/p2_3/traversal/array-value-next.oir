oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 branch in @main parent S1
scope S3 branch in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S3
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    bind %2, binding b0
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: bool = const false
    %7: int = const 0
    br ^b3(%3, %6, %7, %2)
    ^b1(%8: failure) in S0:
    raise %8
    ^b2(%9: int, %10: array<int>) in S0 unwind ^b1:
    want %9
    [i10] exit.prepare return %9 at B0
    result.exit edge normal(0), value %9, demand want, prepare #10
    ret %9
    ^b3(%11: int, %12: bool, %13: int, %14: array<int>) in S0 unwind ^b1:
    %15: bool = int.lt %11, %4
    cond %15, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %16: int = array.get %2, %11
    bind %16, binding b1
    %17: int = const 1
    %18: bool = int.eq %16, %17
    cond %18, ^b10(%14, %16), ^b11(%14, %16)
    ^b5 in S0 unwind ^b1:
    cond %12, ^b6, ^b7
    ^b6 in S0 unwind ^b1:
    br ^b2(%13, %14)
    ^b7 in S0 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%19: bool, %20: int, %21: array<int>) in S0 unwind ^b1:
    %22: int = const 1
    %23: int = int.add %11, %22
    br ^b3(%23, %19, %20, %21)
    ^b9(%24: array<int>, %25: int) in S1 unwind ^b1:
    %26: bool = const true
    want %26
    [i20] exit.prepare fallthrough %26 at B1
    want %25
    [i22] exit.prepare fallthrough %25 at B1
    want %24
    [i24] exit.prepare fallthrough %24 at B1
    result.exit edge normal(0), value %26, demand want, prepare #20
    result.exit edge normal(0), value %25, demand want, prepare #22
    result.exit edge normal(0), value %24, demand want, prepare #24
    br ^b8(%26, %25, %24)
    ^b10(%27: array<int>, %28: int) in S2 unwind ^b1:
    want %12
    [i26] exit.prepare next %12 at B1
    want %13
    [i28] exit.prepare next %13 at B1
    want %27
    [i30] exit.prepare next %27 at B1
    result.exit edge normal(0), value %12, demand want, prepare #26
    result.exit edge normal(0), value %13, demand want, prepare #28
    result.exit edge normal(0), value %27, demand want, prepare #30
    br ^b8(%12, %13, %27)
    ^b11(%29: array<int>, %30: int) in S3 unwind ^b1:
    want %29
    [i32] exit.prepare fallthrough %29 at B2
    want %30
    [i34] exit.prepare fallthrough %30 at B2
    result.exit edge normal(0), value %29, demand want, prepare #32
    result.exit edge normal(0), value %30, demand want, prepare #34
    br ^b9(%29, %30)
}

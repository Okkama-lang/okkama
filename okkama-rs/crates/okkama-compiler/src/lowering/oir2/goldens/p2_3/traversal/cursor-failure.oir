func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Iterating<int>" in S5
    binding b1 "$cursor": "collections/iteration::Cursor<int>" in S6
    binding b2 "x": int in S7
    boundary B0 lexical in S5
    boundary B1 lexical in S6
    boundary B2 loop in S7
    selection s0: selection = union([])
    ^b0 in S5 unwind ^b1:
    %0: int = const 2
    [i1] %1: app.Walk = call @app.Walk.new#0(%0)
    %2: "collections/iteration::Iterating<int>" = role.wrap %1, ty "collections/iteration::Iterating<int>"
    bind %2, binding b0
    [i4] %3: "collections/iteration::Cursor<int>" = call.role %2, "collections/iteration::Iterating<int>" slot 0()
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%3)
    ^b1(%4: failure) in S5:
    raise %4
    ^b2 in S5 unwind ^b1:
    %5: int = const 0
    want %5
    [i7] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #7
    ret %5
    ^b3(%6: "collections/iteration::Cursor<int>") in S5 unwind ^b1:
    br ^b4(%6)
    ^b4(%7: "collections/iteration::Cursor<int>") in S6 unwind ^b1:
    bind %7, binding b1
    [i9] %8: bool = call.role %7, "collections/iteration::Cursor<int>" slot 0()
    high.effects at #9 failures [thrown, program, panic, native, cancelled], suspends true
    cond %8, ^b5, ^b6
    ^b5 in S7 unwind ^b1:
    [i10] %9: int = call.role %7, "collections/iteration::Cursor<int>" slot 1()
    bind %9, binding b2
    %10: str = const "body"
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    panic %10
    ^b6 in S6 unwind ^b1:
    exit.prepare fallthrough select s0 at B1
    br ^b2
    ^b7 in S6:
    unreachable
}

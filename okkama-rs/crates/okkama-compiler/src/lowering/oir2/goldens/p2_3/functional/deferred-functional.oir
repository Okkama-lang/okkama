oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 action in @main.defer#0
scope S2 iteration in @main.defer#0 parent S1
scope S3 block in @main.defer#0 parent S2

func @main() -> int [entry] {
    binding b0 "offset": int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    bind %0, binding b0
    defer.register S0, action defer_action(function=@main.defer#0, bindings=[b0])
    br ^b2(%0)
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: int) in S0 unwind ^b3:
    %3: int = const 0
    want %3
    [i5] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #5
    ret %3
    ^b3(%4: failure) in S0:
    raise %4
}

func @main.defer#0(%0: int) -> void {
    binding b0 "offset": int in S1
    binding b1 "x": int in S2
    boundary B0 lexical in S1
    boundary B1 loop in S2
    boundary B2 lexical in S3
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    bind %0, binding b0
    %1: int = const 1
    %2: int = const 2
    %3: array<int> = array.new [%1, %2], ty array<int>
    %4: int = const 0
    %5: int = array.len %3
    %6: range = range.new %4, %5
    %7: builder<int> = builder.new element int
    br ^b3(%4, %0, %7)
    ^b1(%8: failure) in S1:
    raise %8
    ^b2(%9: int, %10: builder<int>) in S1 unwind ^b12(%10):
    %11: array<int> = builder.finish %10
    discard %11
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %11, demand discard, prepare none
    ret
    ^b3(%12: int, %13: int, %14: builder<int>) in S1 unwind ^b1:
    %15: bool = int.lt %12, %5
    cond %15, ^b4, ^b5
    ^b4 in S2 unwind ^b1:
    br ^b7(%13, %14)
    ^b5 in S1 unwind ^b1:
    br ^b2(%13, %14)
    ^b6(%16: int, %17: builder<int>) in S1 unwind ^b1:
    %18: int = const 1
    %19: int = int.add %12, %18
    br ^b3(%19, %16, %17)
    ^b7(%20: int, %21: builder<int>) in S2 unwind ^b8(%21):
    %22: int = array.get %3, %12
    bind %22, binding b1
    br ^b10
    ^b8(%23: builder<int>, %24: failure) in S2 unwind ^b1:
    builder.abandon %23
    raise %24
    ^b9(%25: int, %26: int, %27: int, %28: builder<int>) in S2 unwind ^b11(%28):
    %29: builder<int> = builder.push %28, %25
    want %26
    [i19] exit.prepare fallthrough %26 at B1
    result.exit edge normal(0), value %26, demand want, prepare #19
    br ^b6(%26, %29)
    ^b10 in S3 unwind ^b1:
    %30: int = int.add %22, %20
    want %30
    [i22] exit.prepare fallthrough %30 at B2
    want %20
    [i24] exit.prepare fallthrough %20 at B2
    want %22
    [i26] exit.prepare fallthrough %22 at B2
    result.exit edge normal(0), value %30, demand want, prepare #22
    result.exit edge normal(0), value %20, demand want, prepare #24
    result.exit edge normal(0), value %22, demand want, prepare #26
    br ^b9(%30, %20, %22, %21)
    ^b11(%31: builder<int>, %32: failure) in S2 unwind ^b1:
    builder.abandon %31
    raise %32
    ^b12(%33: builder<int>, %34: failure) in S1 unwind ^b1:
    builder.abandon %33
    raise %34
}

oir 2 high
module app
requires core
entry @main

object app.Step {
    does "collections/iteration::Cursor<int>" {available = @app.Step.available#0, item = @app.Step.item#1, successor = @app.Step.successor#2}
}

object app.Both {
    does "collections/iteration::Batching<int>" {batch = @app.Both.batch#0}
    does "collections/iteration::Iterating<int>" {cursor = @app.Both.cursor#1}
}

role "collections/iteration::Cursor<int>" {
    available() -> bool
    item() -> int
    successor() -> "collections/iteration::Cursor<int>"
}

role "collections/iteration::Batching<int>" {
    batch() -> array<int>
}

role "collections/iteration::Iterating<int>" {
    cursor() -> "collections/iteration::Cursor<int>"
}
scope S0 action in @app.Step.available#0
scope S1 action in @app.Step.item#1
scope S2 action in @app.Step.successor#2
scope S3 action in @app.Both.batch#0
scope S4 action in @app.Both.cursor#1
scope S5 action in @main
scope S6 block in @main parent S5
scope S7 iteration in @main parent S6
scope S8 action in @app.Step.new#0
scope S9 action in @app.Both.new#0

func @app.Step.new#0() -> app.Step [ctor app.Step] {
    boundary B0 lexical in S8
    ^b0 in S8 unwind ^b1:
    %0: app.Step = obj.new app.Step { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S8:
    raise %1
}


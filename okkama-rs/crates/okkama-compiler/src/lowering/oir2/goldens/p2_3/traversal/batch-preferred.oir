func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Batching<int>" in S5
    binding b1 "$batch": array<int> in S6
    binding b2 "x": int in S7
    boundary B0 lexical in S5
    boundary B1 lexical in S6
    boundary B2 lexical in S6
    boundary B3 loop in S7
    ^b0 in S5 unwind ^b1:
    [i0] %0: app.Both = call @app.Both.new#0()
    %1: "collections/iteration::Batching<int>" = role.wrap %0, ty "collections/iteration::Batching<int>"
    bind %1, binding b0
    %2: bool = const false
    %3: int = const 0
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%2, %3)
    ^b1(%4: failure) in S5:
    raise %4
    ^b2(%5: int) in S5 unwind ^b1:
    want %5
    [i6] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #6
    ret %5
    ^b3(%6: bool, %7: int) in S5 unwind ^b1:
    br ^b4(%6, %7)
    ^b4(%8: bool, %9: int) in S6 unwind ^b1:
    [i7] %10: array<int> = call.role %1, "collections/iteration::Batching<int>" slot 0()
    bind %10, binding b1
    %11: int = array.len %10
    %12: int = const 0
    %13: bool = int.lt %12, %11
    high.effects at #7 failures [thrown, program, panic, native, cancelled], suspends true
    cond %13, ^b5, ^b6
    ^b5 in S6 unwind ^b1:
    br ^b9(%12, %8, %9)
    ^b6 in S6 unwind ^b1:
    cond %8, ^b7, ^b8
    ^b7 in S6 unwind ^b1:
    want %9
    [i13] exit.prepare fallthrough %9 at B1
    result.exit edge normal(0), value %9, demand want, prepare #13
    br ^b2(%9)
    ^b8 in S6 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b9(%14: int, %15: bool, %16: int) in S6 unwind ^b1:
    %17: bool = int.lt %14, %11
    cond %17, ^b10, ^b11
    ^b10 in S7 unwind ^b1:
    %18: int = array.get %10, %14
    bind %18, binding b2
    want %18
    [i18] exit.prepare last %18 at B3
    result.exit edge normal(0), value %18, demand want, prepare #18
    br ^b2(%18)
    ^b11 in S6 unwind ^b1:
    want %15
    [i20] exit.prepare fallthrough %15 at B2
    want %16
    [i22] exit.prepare fallthrough %16 at B2
    result.exit edge normal(0), value %15, demand want, prepare #20
    result.exit edge normal(0), value %16, demand want, prepare #22
    br ^b3(%15, %16)
    ^b12 in S6:
    unreachable
}

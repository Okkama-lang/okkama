func @app.Both.cursor#1(%0: app.Both) -> "collections/iteration::Cursor<int>" [method app.Both] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    [i0] %1: app.Step = call @app.Step.new#0()
    %2: "collections/iteration::Cursor<int>" = role.wrap %1, ty "collections/iteration::Cursor<int>"
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S4:

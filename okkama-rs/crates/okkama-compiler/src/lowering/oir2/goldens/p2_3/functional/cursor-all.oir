    ^b3(%8: "collections/iteration::Cursor<int>", %9: bool) in S4 unwind ^b1:
    br ^b4(%8, %9)
    ^b4(%10: "collections/iteration::Cursor<int>", %11: bool) in S5 unwind ^b1:
    bind %10, binding b1
    [i11] %12: bool = call.role %10, "collections/iteration::Cursor<int>" slot 0()
    high.effects at #11 failures [thrown, program, panic, native, cancelled], suspends true
    cond %12, ^b5, ^b6
    ^b5 in S6 unwind ^b1:
    [i12] %13: int = call.role %10, "collections/iteration::Cursor<int>" slot 1()
    bind %13, binding b2
    high.effects at #12 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b9
    ^b6 in S5 unwind ^b1:
    want %11
    [i15] exit.prepare fallthrough %11 at B1
    result.exit edge normal(0), value %11, demand want, prepare #15
    br ^b2(%11)
    ^b7(%14: bool) in S5 unwind ^b1:
    [i16] %15: "collections/iteration::Cursor<int>" = call.role %10, "collections/iteration::Cursor<int>" slot 2()
    want %15
    [i18] exit.prepare next %15 at B5
    want %14
    [i20] exit.prepare next %14 at B5
    result.exit edge normal(0), value %15, demand want, prepare #18
    result.exit edge normal(0), value %14, demand want, prepare #20
    high.effects at #16 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b3(%15, %14)
    ^b8(%16: bool, %17: int, %18: bool) in S6 unwind ^b1:
    cond %16, ^b11, ^b10
    ^b9 in S7 unwind ^b1:
    %19: int = const 0
    %20: bool = int.lt %13, %19
    want %20
    [i24] exit.prepare fallthrough %20 at B3
    want %13
    [i26] exit.prepare fallthrough %13 at B3
    want %11
    [i28] exit.prepare fallthrough %11 at B3
    result.exit edge normal(0), value %20, demand want, prepare #24
    result.exit edge normal(0), value %13, demand want, prepare #26
    result.exit edge normal(0), value %11, demand want, prepare #28
    br ^b8(%20, %13, %11)
    ^b10 in S6 unwind ^b1:
    %21: bool = const false
    want %21
    [i31] exit.prepare fallthrough %21 at B4
    result.exit edge normal(0), value %21, demand want, prepare #31
    br ^b2(%21)
    ^b11 in S6 unwind ^b1:
    want %18
    [i33] exit.prepare fallthrough %18 at B2
    result.exit edge normal(0), value %18, demand want, prepare #33
    br ^b7(%18)
}

oir 2 high
module app
requires core
entry @main

object app.Step {
    field n: int
    does "collections/iteration::Cursor<int>" {available = @app.Step.available#0, item = @app.Step.item#1, successor = @app.Step.successor#2}
}

object app.Walk {
    field n: int
    does "collections/iteration::Iterating<int>" {cursor = @app.Walk.cursor#0}
}

role "collections/iteration::Cursor<int>" {
    available() -> bool
    item() -> int
    successor() -> "collections/iteration::Cursor<int>"
}

role "collections/iteration::Iterating<int>" {
    cursor() -> "collections/iteration::Cursor<int>"
}
scope S0 action in @app.Step.available#0
scope S1 action in @app.Step.item#1
scope S2 action in @app.Step.successor#2
scope S3 action in @app.Walk.cursor#0
scope S4 action in @main
scope S5 iteration in @main parent S4
scope S6 iteration in @main parent S5
scope S7 block in @main parent S6
scope S8 action in @app.Step.new#0
scope S9 action in @app.Walk.new#0

func @app.Step.new#0(%0: int) -> app.Step [ctor app.Step] {
    binding b0 "n": int in S8
    boundary B0 lexical in S8
    ^b0 in S8 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S8, field field_ref(declaration=app.Step, index=0)
    bind %0, binding b0
    %2: app.Step = obj.new app.Step { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S8:
    raise %3
}

func @app.Step.available#0(%0: app.Step) -> bool [method app.Step] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    %2: int = const 0
    %3: bool = int.gt %1, %2
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    ret %3
    ^b1(%4: failure) in S0:
    raise %4
}

func @app.Step.item#1(%0: app.Step) -> int [method app.Step] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2

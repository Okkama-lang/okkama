func @main() -> int [entry] {
    binding b0 "$source": "collections/iteration::Iterating<int>" in S4
    binding b1 "$cursor": "collections/iteration::Cursor<int>" in S5
    binding b2 "x": int in S6
    boundary B0 lexical in S4
    boundary B1 lexical in S5
    boundary B2 loop in S6
    boundary B3 lexical in S7
    boundary B4 lexical in S6
    boundary B5 lexical in S5
    ^b0 in S4 unwind ^b1:
    %0: int = const 2
    [i1] %1: app.Walk = call @app.Walk.new#0(%0)
    %2: "collections/iteration::Iterating<int>" = role.wrap %1, ty "collections/iteration::Iterating<int>"
    bind %2, binding b0
    [i4] %3: "collections/iteration::Cursor<int>" = call.role %2, "collections/iteration::Iterating<int>" slot 0()
    %4: bool = const true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true

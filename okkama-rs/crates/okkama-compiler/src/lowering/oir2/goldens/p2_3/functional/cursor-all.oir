func @app.Step.successor#2(%0: app.Step) -> "collections/iteration::Cursor<int>" [method app.Step] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: int = obj.get %0, n
    %2: int = const 1
    %3: int = int.sub %1, %2
    [i3] %4: app.Step = call @app.Step.new#0(%3)
    %5: "collections/iteration::Cursor<int>" = role.wrap %4, ty "collections/iteration::Cursor<int>"
    want %5
    [i6] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #6
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    ret %5
    ^b1(%6: failure) in S2:
    raise %6
}

func @app.Walk.new#0(%0: int) -> app.Walk [ctor app.Walk] {
    binding b0 "n": int in S9
    boundary B0 lexical in S9
    ^b0 in S9 unwind ^b1:
    %1: int = undef ty int

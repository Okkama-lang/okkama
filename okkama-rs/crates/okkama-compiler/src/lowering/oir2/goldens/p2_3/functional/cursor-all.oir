func @app.Walk.cursor#0(%0: app.Walk) -> "collections/iteration::Cursor<int>" [method app.Walk] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = obj.get %0, n
    [i1] %2: app.Step = call @app.Step.new#0(%1)
    %3: "collections/iteration::Cursor<int>" = role.wrap %2, ty "collections/iteration::Cursor<int>"
    want %3
    [i4] exit.prepare return %3 at B0

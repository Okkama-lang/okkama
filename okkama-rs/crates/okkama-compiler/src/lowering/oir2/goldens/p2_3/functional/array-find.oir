oir 2 high
module app
requires core
entry @main

variant "app::Maybe<int>" = (some: "app::Maybe<int>.some", none: "app::Maybe<int>.none")

object "app::Maybe<int>.some" {
    field value: int
}

object "app::Maybe<int>.none" {
}
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    boundary B3 lexical in S1
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    bind %2, binding b0
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: "app::Maybe<int>" = variant.new ty "app::Maybe<int>", case 1
    br ^b3(%3, %2, %6)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: array<int>, %9: "app::Maybe<int>") in S0 unwind ^b1:
    discard %9
    %10: int = const 0
    want %10
    [i11] exit.prepare return %10 at B0
    result.exit edge normal(0), value %9, demand discard, prepare none
    result.exit edge normal(0), value %10, demand want, prepare #11
    ret %10
    ^b3(%11: int, %12: array<int>, %13: "app::Maybe<int>") in S0 unwind ^b1:
    %14: bool = int.lt %11, %4
    cond %14, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %15: int = array.get %2, %11
    bind %15, binding b1
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%12, %13)
    ^b6(%16: array<int>, %17: "app::Maybe<int>") in S0 unwind ^b1:
    %18: int = const 1
    %19: int = int.add %11, %18
    br ^b3(%19, %16, %17)
    ^b7(%20: bool, %21: array<int>, %22: int, %23: "app::Maybe<int>") in S1 unwind ^b1:
    cond %20, ^b9, ^b10
    ^b8 in S2 unwind ^b1:
    %24: int = const 0
    %25: bool = int.gt %15, %24
    want %25
    [i20] exit.prepare fallthrough %25 at B2
    want %12
    [i22] exit.prepare fallthrough %12 at B2
    want %15
    [i24] exit.prepare fallthrough %15 at B2
    want %13
    [i26] exit.prepare fallthrough %13 at B2
    result.exit edge normal(0), value %25, demand want, prepare #20
    result.exit edge normal(0), value %12, demand want, prepare #22
    result.exit edge normal(0), value %15, demand want, prepare #24
    result.exit edge normal(0), value %13, demand want, prepare #26
    br ^b7(%25, %12, %15, %13)
    ^b9 in S1 unwind ^b1:
    %26: "app::Maybe<int>" = variant.new [%22], ty "app::Maybe<int>", case 0
    want %21
    [i29] exit.prepare fallthrough %21 at B3
    want %26
    [i31] exit.prepare fallthrough %26 at B3
    result.exit edge normal(0), value %21, demand want, prepare #29
    result.exit edge normal(0), value %26, demand want, prepare #31
    br ^b2(%21, %26)
    ^b10 in S1 unwind ^b1:
    want %21
    [i33] exit.prepare fallthrough %21 at B1
    want %23
    [i35] exit.prepare fallthrough %23 at B1
    result.exit edge normal(0), value %21, demand want, prepare #33
    result.exit edge normal(0), value %23, demand want, prepare #35
    br ^b6(%21, %23)
}

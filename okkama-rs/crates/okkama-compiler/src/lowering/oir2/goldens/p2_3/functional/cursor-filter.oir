    want %20
    [i26] exit.prepare fallthrough %20 at B3
    result.exit edge normal(0), value %27, demand want, prepare #24
    result.exit edge normal(0), value %20, demand want, prepare #26
    br ^b12(%27, %20, %19)
    ^b14(%28: int, %29: builder<int>) in S6 unwind ^b1:
    exit.prepare fallthrough select s1 at B2
    br ^b9(%29)
    ^b15 in S6 unwind ^b1:
    br ^b17(%24, %25)
    ^b16 in S6 unwind ^b1:
    br ^b14(%24, %25)
    ^b17(%30: int, %31: builder<int>) in S6 unwind ^b18(%31):

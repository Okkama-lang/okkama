    br ^b3(%18, %17)
    ^b10(%19: builder<int>) in S6 unwind ^b11(%19):
    [i18] %20: int = call.role %11, "collections/iteration::Cursor<int>" slot 1()
    bind %20, binding b2
    high.effects at #18 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b13
    ^b11(%21: builder<int>, %22: failure) in S6 unwind ^b1:
    builder.abandon %21

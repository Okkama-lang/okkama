oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": range in S0
    binding b1 "acc": int in S1
    binding b2 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: int = const 0
    %1: int = const 0
    %2: range = range.new %0, %1
    bind %2, binding b0
    %3: int = range.start %2
    %4: int = range.len %2
    %5: int = int.add %3, %4
    %6: range = range.new %3, %5
    %7: int = const 0
    br ^b3(%3, %2, %7)
    ^b1(%8: failure) in S0:
    raise %8
    ^b2(%9: range, %10: int) in S0 unwind ^b1:
    discard %10
    %11: int = const 0
    want %11
    [i12] exit.prepare return %11 at B0
    result.exit edge normal(0), value %10, demand discard, prepare none
    result.exit edge normal(0), value %11, demand want, prepare #12
    ret %11
    ^b3(%12: int, %13: range, %14: int) in S0 unwind ^b1:
    %15: bool = int.lt %12, %5
    cond %15, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %14, binding b1
    bind %12, binding b2
    br ^b8
    ^b5 in S0 unwind ^b1:
    br ^b2(%13, %14)
    ^b6(%16: range, %17: int) in S0 unwind ^b1:
    %18: int = const 1
    %19: int = int.add %12, %18
    br ^b3(%19, %16, %17)
    ^b7(%20: int, %21: range, %22: int, %23: int, %24: int) in S1 unwind ^b1:
    want %21
    [i19] exit.prepare fallthrough %21 at B1
    want %20
    [i21] exit.prepare fallthrough %20 at B1
    result.exit edge normal(0), value %21, demand want, prepare #19
    result.exit edge normal(0), value %20, demand want, prepare #21
    br ^b6(%21, %20)
    ^b8 in S2 unwind ^b1:
    %25: int = int.add %14, %12
    want %25
    [i24] exit.prepare fallthrough %25 at B2
    want %13
    [i26] exit.prepare fallthrough %13 at B2
    want %14
    [i28] exit.prepare fallthrough %14 at B2
    want %12
    [i30] exit.prepare fallthrough %12 at B2
    result.exit edge normal(0), value %25, demand want, prepare #24
    result.exit edge normal(0), value %13, demand want, prepare #26
    result.exit edge normal(0), value %14, demand want, prepare #28
    result.exit edge normal(0), value %12, demand want, prepare #30
    br ^b7(%25, %13, %14, %12, %14)
}

oir 2 high
module app
requires core
entry @main

object app.Box {
    does app.Label {label = @app.Box.label#0}
}

object app.Source {
    does app.Factory {make = @app.Source.witness.app.Factory.slot0}
}

role app.Label {
    label() -> int
}

role app.Factory {
    make() -> app.Label
}
scope S0 action in @app.Source.witness.app.Factory.slot0
scope S1 action in @app.Box.label#0
scope S2 action in @app.Source.make#0
scope S3 action in @main
scope S4 action in @app.Box.new#0
scope S5 action in @app.Source.new#0

func @app.Box.new#0() -> app.Box [ctor app.Box] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %0: app.Box = obj.new app.Box { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S4:
    raise %1
}

func @app.Box.label#0(%0: app.Box) -> int [method app.Box] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = const 1
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Source.new#0() -> app.Source [ctor app.Source] {
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %0: app.Source = obj.new app.Source { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S5:
    raise %1
}

func @app.Source.make#0(%0: app.Source) -> app.Box [method app.Source] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    [i0] %1: app.Box = call @app.Box.new#0()
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    ret %1
    ^b1(%2: failure) in S2:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "factory": app.Factory in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    [i0] %0: app.Source = call @app.Source.new#0()
    %1: app.Factory = role.wrap %0, ty app.Factory
    bind %1, binding b0
    [i3] %2: app.Label = call.role %1, app.Factory slot 0()
    [i4] %3: int = call.role %2, app.Label slot 0()
    want %3
    [i6] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #6
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b1(%4: failure) in S3:
    raise %4
}

func @app.Source.witness.app.Factory.slot0(%0: app.Source) -> app.Label [method app.Source, adapter @app.Source.make#0] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    [i0] %1: app.Box = call @app.Source.make#0(%0)
    %2: app.Label = role.wrap %1, ty app.Label
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S0:
    raise %3
}

oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 block in @main parent S1

func @main() -> int [entry] {
    binding b0 "xs": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: array<int> = array.new [%0, %1], ty array<int>
    bind %2, binding b0
    %3: int = const 0
    %4: int = array.len %2
    %5: range = range.new %3, %4
    %6: builder<int> = builder.new element int
    br ^b3(%3, %2, %6)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: array<int>, %9: builder<int>) in S0 unwind ^b16(%9):
    %10: array<int> = builder.finish %9
    discard %10
    %11: int = const 0
    want %11
    [i12] exit.prepare return %11 at B0
    result.exit edge normal(0), value %10, demand discard, prepare none
    result.exit edge normal(0), value %11, demand want, prepare #12
    ret %11
    ^b3(%12: int, %13: array<int>, %14: builder<int>) in S0 unwind ^b1:
    %15: bool = int.lt %12, %4
    cond %15, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    br ^b7(%13, %14)
    ^b5 in S0 unwind ^b1:
    br ^b2(%13, %14)
    ^b6(%16: array<int>, %17: builder<int>) in S0 unwind ^b1:
    %18: int = const 1
    %19: int = int.add %12, %18
    br ^b3(%19, %16, %17)
    ^b7(%20: array<int>, %21: builder<int>) in S1 unwind ^b8(%21):
    %22: int = array.get %2, %12
    bind %22, binding b1
    br ^b10
    ^b8(%23: builder<int>, %24: failure) in S1 unwind ^b1:
    builder.abandon %23
    raise %24
    ^b9(%25: bool, %26: array<int>, %27: int, %28: builder<int>) in S1 unwind ^b1:
    cond %25, ^b12, ^b13
    ^b10 in S2 unwind ^b1:
    %29: int = const 0
    %30: bool = int.gt %22, %29
    want %30
    [i22] exit.prepare fallthrough %30 at B2
    want %20
    [i24] exit.prepare fallthrough %20 at B2
    want %22
    [i26] exit.prepare fallthrough %22 at B2
    result.exit edge normal(0), value %30, demand want, prepare #22
    result.exit edge normal(0), value %20, demand want, prepare #24
    result.exit edge normal(0), value %22, demand want, prepare #26
    br ^b9(%30, %20, %22, %21)
    ^b11(%31: array<int>, %32: int, %33: builder<int>) in S1 unwind ^b1:
    want %31
    [i28] exit.prepare fallthrough %31 at B1
    result.exit edge normal(0), value %31, demand want, prepare #28
    br ^b6(%31, %33)
    ^b12 in S1 unwind ^b1:
    br ^b14(%26, %27, %28)
    ^b13 in S1 unwind ^b1:
    br ^b11(%26, %27, %28)
    ^b14(%34: array<int>, %35: int, %36: builder<int>) in S1 unwind ^b15(%36):
    %37: builder<int> = builder.push %36, %22
    br ^b11(%34, %35, %37)
    ^b15(%38: builder<int>, %39: failure) in S1 unwind ^b1:
    builder.abandon %38
    raise %39
    ^b16(%40: builder<int>, %41: failure) in S0 unwind ^b1:
    builder.abandon %40
    raise %41
}

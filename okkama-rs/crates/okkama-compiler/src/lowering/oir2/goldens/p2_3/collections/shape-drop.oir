oir 2 high
module app
requires core
entry @main
scope S0 action in @main

func @main() -> int [entry] {
    binding b0 "a": array<int> in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 1
    %1: int = const 2
    %2: int = const 3
    %3: array<int> = array.new [%0, %1, %2], ty array<int>
    bind %3, binding b0
    %4: int = const 99
    %5: int = const 0
    %6: bool = int.lt %4, %5
    cond %6, ^b2, ^b3
    ^b1(%7: failure) in S0:
    raise %7
    ^b2 in S0 unwind ^b1:
    trap range "drop needs a non-negative count"
    ^b3 in S0 unwind ^b1:
    %8: int = array.len %3
    %9: bool = int.lt %4, %8
    cond %9, ^b4(%4), ^b4(%8)
    ^b4(%10: int) in S0 unwind ^b1:
    %11: array<int> = array.slice %3, %10, %8
    %12: int = array.len %11
    want %12
    [i13] exit.prepare return %12 at B0
    result.exit edge normal(0), value %12, demand want, prepare #13
    ret %12
}

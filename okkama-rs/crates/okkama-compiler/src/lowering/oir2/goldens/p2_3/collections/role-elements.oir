oir 2 high
module app
requires core
entry @main

object app.Res {
    field n: int
    does app.Read {get = @app.Res.get#0}
    destroy @app.Res.destroy
}

role app.Read {
    get() -> int
}
scope S0 action in @app.Res.get#0
scope S1 action in @app.Res.destroy
scope S2 action in @main
scope S3 action in @app.Res.new#0

func @app.Res.new#0(%0: int) -> app.Res [ctor app.Res] {
    binding b0 "n": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    bind %0, binding b0
    stage %0, action S3, field field_ref(declaration=app.Res, index=0)
    %2: app.Res = obj.new app.Res { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func @app.Res.get#0(%0: app.Res) -> int [method app.Res] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    discard %1
    exit.prepare return select s0 at B0
    result.exit edge normal(0), value %1, demand discard, prepare none
    ret
    ^b1(%2: failure) in S1:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "a": array<app.Read> in S2
    binding b1 "m": map<str, app.Read> in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: int = const 1
    [i1] %1: app.Res = call @app.Res.new#0(%0)
    %2: app.Read = role.wrap %1, ty app.Read
    %3: int = const 2
    [i4] %4: app.Res = call @app.Res.new#0(%3)
    %5: app.Read = role.wrap %4, ty app.Read
    %6: array<app.Read> = array.new [%2, %5], ty array<app.Read>
    bind %6, binding b0
    %7: str = const "a"
    %8: int = const 3
    [i10] %9: app.Res = call @app.Res.new#0(%8)
    %10: app.Read = role.wrap %9, ty app.Read
    %11: map<str, app.Read> = map.new entries [(%7, %10)], ty map<str, app.Read>
    bind %11, binding b1
    %12: int = const 0
    %13: array<app.Read> = array.remove %6, %12
    %14: int = const 0
    %15: app.Read = array.get %13, %14
    [i18] %16: int = call.role %15, app.Read slot 0()
    discard %16
    %17: str = const "a"
    %18: app.Read = map.get %11, %17
    [i22] %19: int = call.role %18, app.Read slot 0()
    want %19
    [i24] exit.prepare return %19 at B0
    result.exit edge normal(0), value %16, demand discard, prepare none
    result.exit edge normal(0), value %19, demand want, prepare #24
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #18 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #22 failures [thrown, program, panic, native, cancelled], suspends true
    ret %19
    ^b1(%20: failure) in S2:
    raise %20
}

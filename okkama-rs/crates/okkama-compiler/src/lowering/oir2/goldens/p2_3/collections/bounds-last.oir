oir 2 high
module app
requires core
entry @main

role Error [builtin] {
    text() -> str
}
scope S0 action in @main
scope S1 try in @main parent S0
scope S2 catch in @main parent S0

func @main() -> int [entry] {
    binding b0 "a": array<int> in S0
    binding b1 "e": Error in S2
    boundary B0 lexical in S0
    boundary B1 lexical in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: array<int> = array.new ty array<int>
    bind %0, binding b0
    br ^b4(%0)
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: array<int>) in S0 unwind ^b1:
    %3: int = const 0
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    ret %3
    ^b3(%4: array<int>, %5: failure) in S0 unwind ^b1:
    catch %5 is Error, ^b9(%4, %5, $value), ^b10(%4, %5)
    ^b4(%6: array<int>) in S1 unwind ^b3(%6):
    %7: int = array.len %6
    %8: int = const 1
    %9: int = int.sub %7, %8
    array.lookup %6, %9, ^b5($value), ^b6
    ^b5(%10: int) in S1:
    br ^b8(%6)
    ^b6 in S1:
    br ^b7(%6)
    ^b7(%11: array<int>) in S1 unwind ^b3(%11):
    trap empty "Cannot read last item of an empty sequence"
    ^b8(%12: array<int>) in S1 unwind ^b3(%12):
    discard %10
    want %12
    [i10] exit.prepare fallthrough %12 at B1
    result.exit edge normal(0), value %10, demand discard, prepare none
    result.exit edge normal(0), value %12, demand want, prepare #10
    br ^b2(%12)
    ^b9(%13: array<int>, %14: failure, %15: Error) in S2 unwind ^b1:
    bind %15, binding b1
    br ^b12(%13, %14)
    ^b10(%16: array<int>, %17: failure) in S0 unwind ^b1:
    raise %17
    ^b11(%18: array<int>, %19: failure, %20: failure) in S0 unwind ^b1:
    %21: failure = fail.caused %20, %19
    raise %21
    ^b12(%22: array<int>, %23: failure) in S2 unwind ^b11(%22, %23):
    %24: int = const 0
    discard %24
    want %22
    [i16] exit.prepare fallthrough %22 at B2
    result.exit edge normal(0), value %24, demand discard, prepare none
    result.exit edge normal(0), value %22, demand want, prepare #16
    br ^b2(%22)
}

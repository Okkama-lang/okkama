oir 2 high
module app
requires core
entry @main

object app.Walk {
}
scope S0 action in @app.Walk.run#0
scope S1 iteration in @app.Walk.run#0 parent S0
scope S2 action in @main
scope S3 action in @app.Walk.new#0

func @app.Walk.new#0() -> app.Walk [ctor app.Walk] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: app.Walk = obj.new app.Walk { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S3:
    raise %1
}

func @app.Walk.run#0(%0: app.Walk, %1: array<int>) -> int [method app.Walk] {
    binding b0 "xs": array<int> in S0
    binding b1 "x": int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    ^b0 in S0 unwind ^b1:
    bind %1, binding b0
    %2: int = const 0
    %3: int = array.len %1
    %4: range = range.new %2, %3
    %5: bool = const false
    %6: int = const 0
    br ^b3(%2, %5, %6, %1)
    ^b1(%7: failure) in S0:
    raise %7
    ^b2(%8: int, %9: array<int>) in S0 unwind ^b1:
    want %8
    [i7] exit.prepare return %8 at B0
    result.exit edge normal(0), value %8, demand want, prepare #7
    ret %8
    ^b3(%10: int, %11: bool, %12: int, %13: array<int>) in S0 unwind ^b1:
    %14: bool = int.lt %10, %3
    cond %14, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    %15: int = array.get %1, %10
    bind %15, binding b1
    %16: bool = const true
    want %16
    [i13] exit.prepare fallthrough %16 at B1
    want %15
    [i15] exit.prepare fallthrough %15 at B1
    want %13
    [i17] exit.prepare fallthrough %13 at B1
    result.exit edge normal(0), value %16, demand want, prepare #13
    result.exit edge normal(0), value %15, demand want, prepare #15
    result.exit edge normal(0), value %13, demand want, prepare #17
    br ^b8(%16, %15, %13)
    ^b5 in S0 unwind ^b1:
    cond %11, ^b6, ^b7
    ^b6 in S0 unwind ^b1:
    br ^b2(%12, %13)
    ^b7 in S0 unwind ^b1:
    trap empty "A void result cannot be used as a value"
    ^b8(%17: bool, %18: int, %19: array<int>) in S0 unwind ^b1:
    %20: int = const 1
    %21: int = int.add %10, %20
    br ^b3(%21, %17, %18, %19)
}

func @main() -> int [entry] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    [i0] %0: app.Walk = call @app.Walk.new#0()
    %1: array<int> = array.new ty array<int>
    [i2] %2: int = call @app.Walk.run#0(%0, %1)
    want %2
    [i4] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #4
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S2:
    raise %3
}

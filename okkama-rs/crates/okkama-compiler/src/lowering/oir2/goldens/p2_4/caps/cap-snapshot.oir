oir 2 high
module app
requires core
entry @main

object app.Owner {
    field n: int
}

cap app.Owner :: app.Owner.View {
    field value = @app.Owner.cap.View.value#0
}
scope S0 action in @app.Owner.changed#0
scope S1 action in @app.Owner.cap.View.value#0
scope S2 action in @main
scope S3 action in @app.Owner.new#0

func @app.Owner.new#0(%0: int) -> app.Owner [ctor app.Owner] {
    binding b0 "n": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S3, field field_ref(declaration=app.Owner, index=0)
    bind %0, binding b0
    %2: app.Owner = obj.new app.Owner { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func @app.Owner.changed#0(%0: app.Owner) -> ^app.Owner [successor app.Owner] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    %2: int = obj.get %0, n
    %3: int = const 1
    %4: int = int.add %2, %3
    stage %4, action S0, field field_ref(declaration=app.Owner, index=0)
    %5: ^app.Owner = obj.next %0 { n: %4 }
    want %5
    [i7] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #7
    ret %5
    ^b1(%6: failure) in S0:
    raise %6
}

func @app.Owner.cap.View.value#0(%0: app.Owner) -> int {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "owner": app.Owner in S2
    binding b1 "before": app.Owner.View in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: int = const 4
    [i1] %1: app.Owner = call @app.Owner.new#0(%0)
    bind %1, binding b0
    %2: app.Owner.View = cap.make %1, ty app.Owner.View
    bind %2, binding b1
    [i5] %3: ^app.Owner = call @app.Owner.changed#0(%1)
    %4: app.Owner = succ.take %3, ty app.Owner
    rebind %4, binding b0, target S2
    [i8] %5: int = call.cap %2, field_ref(declaration=app.Owner.View, index=0)()
    %6: app.Owner.View = cap.make %4, ty app.Owner.View
    [i10] %7: int = call.cap %6, field_ref(declaration=app.Owner.View, index=0)()
    %8: int = int.add %5, %7
    want %8
    [i13] exit.prepare return %8 at B0
    result.exit edge normal(0), value %8, demand want, prepare #13
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #5 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #8 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    ret %8
    ^b1(%9: failure) in S2:
    raise %9
}

oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 action in @main.lambda#0
scope S2 action in @main.lambda#0.0
summary M0 call-boundary parameters [parameter_effect(convention=take, destination=none)] contract
        call_contract(publication=atomic)
protocol P0 kind closure holders [scope, packet] rules [protocol_rule(transition=publish, from=packet, to=scope,
        checks=[owner, live_dependencies, snapshot, transferable], normal=protocol_poststate(holder=scope, state=open),
        unwind=some(protocol_poststate(holder=scope, state=settled))), protocol_rule(transition=dynamic, from=packet,
        to=scope, checks=[owner, live_dependencies, snapshot, transferable], normal=protocol_poststate(holder=scope,
        state=open), unwind=some(protocol_poststate(holder=packet, state=unaccepted)))] roots [operands]

func @main() -> int [entry] {
    binding b0 "x": int in S0
    binding b1 "make": fn() -> fn() -> int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: type = type.of ty fn() -> int, descriptor descriptor_contract(managed=runtime, retention=owner_graph(0),
        cleanup=@oir.sync_closure.cleanup, summary=M0)
    %1: int = const 7
    bind %1, binding b0
    %2: fn() -> fn() -> int = fn.closure @main.lambda#0, [%1], ty fn() -> fn() -> int
    bind %2, binding b1
    [i5] %3: fn() -> int = fn.call %2()
    [i6] %4: int = fn.call %3()
    want %4
    [i8] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #8
    high.effects at #5 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    ret %4
    ^b1(%5: failure) in S0:
    raise %5
}

func @main.lambda#0(%0: int) -> fn() -> int [lambda captures 1] {
    binding b0 "x": int in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    bind %0, binding b0
    %1: fn() -> int = fn.closure @main.lambda#0.0, [%0], ty fn() -> int
    want %1
    [i3] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #3
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @main.lambda#0.0(%0: int) -> int [lambda captures 1] {
    binding b0 "x": int in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    bind %0, binding b0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2

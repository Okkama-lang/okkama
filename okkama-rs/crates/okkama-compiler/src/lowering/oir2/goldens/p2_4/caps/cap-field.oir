oir 2 high
module app
requires core
entry @main

object app.Owner {
    field n: int
}

object app.Holder {
    field view: app.Owner.View
}

cap app.Owner :: app.Owner.View {
    field value = @app.Owner.cap.View.value#0
}
scope S0 action in @app.Owner.cap.View.value#0
scope S1 action in @app.Holder.read#0
scope S2 action in @main
scope S3 action in @app.Owner.new#0
scope S4 action in @app.Holder.new#0

func @app.Owner.new#0(%0: int) -> app.Owner [ctor app.Owner] {
    binding b0 "n": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S3, field field_ref(declaration=app.Owner, index=0)
    bind %0, binding b0
    %2: app.Owner = obj.new app.Owner { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func @app.Owner.cap.View.value#0(%0: app.Owner) -> int {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Holder.new#0(%0: app.Owner.View) -> app.Holder [ctor app.Holder] {
    binding b0 "view": app.Owner.View in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: app.Owner.View = undef ty app.Owner.View
    stage %0, action S4, field field_ref(declaration=app.Holder, index=0)
    bind %0, binding b0
    %2: app.Holder = obj.new app.Holder { view: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.Holder.read#0(%0: app.Holder) -> int [method app.Holder] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: app.Owner.View = obj.get %0, view
    [i1] %2: int = call.cap %1, field_ref(declaration=app.Owner.View, index=0)()
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S1:
    raise %3
}

func @main() -> int [entry] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: int = const 4
    [i1] %1: app.Owner = call @app.Owner.new#0(%0)
    %2: app.Owner.View = cap.make %1, ty app.Owner.View
    [i3] %3: app.Holder = call @app.Holder.new#0(%2)
    [i4] %4: int = call @app.Holder.read#0(%3)
    want %4
    [i6] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #6
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    ret %4
    ^b1(%5: failure) in S2:
    raise %5
}

oir 2 high
module app
requires core
entry @main

object app.Owner {
    field n: int
}

cap app.Owner :: app.Owner.Internal {
    field value = @app.Owner.cap.Internal.value#0
}

cap app.Owner :: app.Owner.External {
    field value = @app.Owner.cap.External.value#0
}
scope S0 action in @app.Owner.cap.Internal.value#0
scope S1 action in @app.Owner.cap.External.value#0
scope S2 action in @main
scope S3 action in @app.Owner.new#0

func @app.Owner.new#0(%0: int) -> app.Owner [ctor app.Owner] {
    binding b0 "n": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S3, field field_ref(declaration=app.Owner, index=0)
    bind %0, binding b0
    %2: app.Owner = obj.new app.Owner { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func @app.Owner.cap.Internal.value#0(%0: app.Owner) -> int {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Owner.cap.External.value#0(%0: app.Owner) -> int {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    %2: int = const 1
    %3: int = int.add %1, %2
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    ret %3
    ^b1(%4: failure) in S1:
    raise %4
}

func @main() -> int [entry] {
    binding b0 "owner": app.Owner in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: int = const 4
    [i1] %1: app.Owner = call @app.Owner.new#0(%0)
    bind %1, binding b0
    %2: app.Owner.Internal = cap.make %1, ty app.Owner.Internal
    [i4] %3: int = call.cap %2, field_ref(declaration=app.Owner.Internal, index=0)()
    %4: app.Owner.External = cap.make %1, ty app.Owner.External
    [i6] %5: int = call.cap %4, field_ref(declaration=app.Owner.External, index=0)()
    %6: int = int.add %3, %5
    want %6
    [i9] exit.prepare return %6 at B0
    result.exit edge normal(0), value %6, demand want, prepare #9
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    ret %6
    ^b1(%7: failure) in S2:
    raise %7
}

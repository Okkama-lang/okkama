oir 2 high
module app
requires core
entry @main

object app.Owner {
    field n: int
}

cap app.Owner :: app.Owner.View {
    field value = @app.Owner.cap.View.value#0
}
scope S0 action in @app.Owner.cap.View.value#0
scope S1 action in @main
scope S2 action in @app.Owner.new#0

func @app.Owner.new#0(%0: int) -> app.Owner [ctor app.Owner] {
    binding b0 "n": int in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S2, field field_ref(declaration=app.Owner, index=0)
    bind %0, binding b0
    %2: app.Owner = obj.new app.Owner { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S2:
    raise %3
}

func @app.Owner.cap.View.value#0(%0: app.Owner) -> int {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    %2: int = const 1
    %3: int = int.add %1, %2
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    ret %3
    ^b1(%4: failure) in S0:
    raise %4
}

func @main() -> int [entry] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %0: int = const 4
    [i1] %1: app.Owner = call @app.Owner.new#0(%0)
    %2: app.Owner.View = cap.make %1, ty app.Owner.View
    [i3] %3: int = call.cap %2, field_ref(declaration=app.Owner.View, index=0)()
    want %3
    [i5] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #5
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b1(%4: failure) in S1:
    raise %4
}

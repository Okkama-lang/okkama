oir 2 high
module app
requires core
entry @main

enum app.Stop is Error = (now)
scope S0 action in @main
scope S1 try in @main parent S0
scope S2 catch in @main parent S0
scope S3 action in @main.lambda#0

func @main() -> int [entry] {
    binding b0 "fail": fn() -> int in S0
    binding b1 "e": app.Stop in S2
    boundary B0 lexical in S0
    boundary B1 lexical in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: fn() -> int = fn.closure @main.lambda#0, ty fn() -> int
    bind %0, binding b0
    br ^b4(%0)
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: int, %3: fn() -> int) in S0 unwind ^b1:
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    ret %2
    ^b3(%4: fn() -> int, %5: failure) in S0 unwind ^b1:
    catch %5 is app.Stop, ^b5(%4, %5, $value), ^b6(%4, %5)
    ^b4(%6: fn() -> int) in S1 unwind ^b3(%6):
    [i4] %7: int = fn.call %6()
    want %7
    [i6] exit.prepare fallthrough %7 at B1
    want %6
    [i8] exit.prepare fallthrough %6 at B1
    result.exit edge normal(0), value %7, demand want, prepare #6
    result.exit edge normal(0), value %6, demand want, prepare #8
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b2(%7, %6)
    ^b5(%8: fn() -> int, %9: failure, %10: app.Stop) in S2 unwind ^b1:
    bind %10, binding b1
    br ^b8(%8, %9)
    ^b6(%11: fn() -> int, %12: failure) in S0 unwind ^b1:
    raise %12
    ^b7(%13: fn() -> int, %14: failure, %15: failure) in S0 unwind ^b1:
    %16: failure = fail.caused %15, %14
    raise %16
    ^b8(%17: fn() -> int, %18: failure) in S2 unwind ^b7(%17, %18):
    %19: int = const 7
    want %19
    [i13] exit.prepare fallthrough %19 at B2
    want %17
    [i15] exit.prepare fallthrough %17 at B2
    result.exit edge normal(0), value %19, demand want, prepare #13
    result.exit edge normal(0), value %17, demand want, prepare #15
    br ^b2(%19, %17)
}

func @main.lambda#0() -> int [lambda] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: app.Stop = enum.case app.Stop, case 0
    throw %0
    ^b1(%1: failure) in S3:
    raise %1
}

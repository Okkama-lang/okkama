oir 2 high
module app
requires core
entry @main

object "app::Box<string>" {
    field value: str
    does "app::Readable<string>" {read = "@app::Box<string>.read#overload()"}
}

object "app::Box<int>" {
    field value: int
    does "app::Readable<int>" {read = "@app::Box<int>.read#overload()"}
}

role "app::Readable<string>" {
    read() -> str
}

role "app::Readable<int>" {
    read() -> int
}
scope S0 action in @main
scope S1 action in "@app::Box<string>.read#overload()"
scope S2 action in "@app::Box<int>.read#overload()"
scope S3 action in "@app::Box<string>.new#ctor(value:string)"
scope S4 action in "@app::Box<int>.new#ctor(value:int)"

func @main() -> int [entry] {
    binding b0 "text": "app::Readable<string>" in S0
    binding b1 "readText": fn() -> str in S0
    binding b2 "number": "app::Readable<int>" in S0
    binding b3 "readNumber": fn() -> int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: str = const "a"
    [i1] %1: "app::Box<string>" = call "@app::Box<string>.new#ctor(value:string)"(%0)
    %2: "app::Readable<string>" = role.wrap %1, ty "app::Readable<string>"
    bind %2, binding b0
    %3: fn() -> str = fn.bind.role %2, role "app::Readable<string>", slot 0, ty fn() -> str
    bind %3, binding b1
    [i6] %4: str = fn.call %3()
    discard %4
    %5: int = const 7
    [i9] %6: "app::Box<int>" = call "@app::Box<int>.new#ctor(value:int)"(%5)
    %7: "app::Readable<int>" = role.wrap %6, ty "app::Readable<int>"
    bind %7, binding b2
    %8: fn() -> int = fn.bind.role %7, role "app::Readable<int>", slot 0, ty fn() -> int
    bind %8, binding b3
    [i14] %9: int = fn.call %8()
    want %9
    [i16] exit.prepare return %9 at B0
    result.exit edge normal(0), value %4, demand discard, prepare none
    result.exit edge normal(0), value %9, demand want, prepare #16
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #9 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #14 failures [thrown, program, panic, native, cancelled], suspends true
    ret %9
    ^b1(%10: failure) in S0:
    raise %10
}

func "@app::Box<string>.read#overload()"(%0: "app::Box<string>") -> str [method "app::Box<string>"] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: str = obj.get %0, value
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}


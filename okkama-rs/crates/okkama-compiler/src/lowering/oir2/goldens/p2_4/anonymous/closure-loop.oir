oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 iteration in @main parent S0
scope S2 action in @main.lambda#0

func @main() -> int [entry] {
    binding b0 "i": int in S1
    binding b1 "f": fn() -> int in S1
    boundary B0 lexical in S0
    boundary B1 loop in S1
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    %0: int = const 0
    %1: int = const 2
    %2: range = range.new %0, %1
    br ^b3(%0)
    ^b1(%3: failure) in S0:
    raise %3
    ^b2 in S0 unwind ^b1:
    %4: int = const 0
    want %4
    [i5] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #5
    ret %4
    ^b3(%5: int) in S0 unwind ^b1:
    %6: bool = int.lt %5, %1
    cond %6, ^b4, ^b5
    ^b4 in S1 unwind ^b1:
    bind %5, binding b0
    %7: fn() -> int = fn.closure @main.lambda#0, [%5], ty fn() -> int
    bind %7, binding b1
    [i10] %8: int = fn.call %7()
    discard %8
    exit.prepare fallthrough select s0 at B1
    result.exit edge normal(0), value %8, demand discard, prepare none
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b6
    ^b5 in S0 unwind ^b1:
    br ^b2
    ^b6 in S0 unwind ^b1:
    %9: int = const 1
    %10: int = int.add %5, %9
    br ^b3(%10)
}

func @main.lambda#0(%0: int) -> int [lambda captures 1] {
    binding b0 "i": int in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    bind %0, binding b0
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S2:
    raise %1
}

oir 2 high
module app
requires core
entry @main

object app.Counter {
    field n: int
    does app.Counting {read = @app.Counter.read#0, bumped = @app.Counter.witness.app.Counting.slot1}
}

role app.Counting {
    read() -> int
    bumped() -> ^app.Counting
}
scope S0 action in @app.Counter.witness.app.Counting.slot1
scope S1 action in @app.Counter.read#0
scope S2 action in @app.Counter.bumped#1
scope S3 action in @main
scope S4 action in @app.Counter.new#0

func @app.Counter.new#0(%0: int) -> app.Counter [ctor app.Counter] {
    binding b0 "n": int in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S4, field field_ref(declaration=app.Counter, index=0)
    bind %0, binding b0
    %2: app.Counter = obj.new app.Counter { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S4:
    raise %3
}

func @app.Counter.read#0(%0: app.Counter) -> int [method app.Counter] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Counter.bumped#1(%0: app.Counter) -> ^app.Counter [successor app.Counter] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: int = obj.get %0, n
    %2: int = obj.get %0, n
    %3: int = const 1
    %4: int = int.add %2, %3
    stage %4, action S2, field field_ref(declaration=app.Counter, index=0)
    %5: ^app.Counter = obj.next %0 { n: %4 }
    want %5
    [i7] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #7
    ret %5
    ^b1(%6: failure) in S2:
    raise %6
}

func @main() -> int [entry] {
    binding b0 "item": app.Counting in S3
    binding b1 "bump": fn() -> ^app.Counting in S3
    binding b2 "later": ^app.Counting in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: int = const 7
    [i1] %1: app.Counter = call @app.Counter.new#0(%0)
    %2: app.Counting = role.wrap %1, ty app.Counting
    bind %2, binding b0
    %3: fn() -> ^app.Counting = fn.bind.role %2, role app.Counting, slot 1, ty fn() -> ^app.Counting
    bind %3, binding b1
    [i6] %4: ^app.Counting = fn.call %3()
    bind %4, binding b2
    %5: app.Counting = succ.take %4, ty app.Counting
    [i9] %6: int = call.role %5, app.Counting slot 0()
    want %6
    [i11] exit.prepare return %6 at B0
    result.exit edge normal(0), value %6, demand want, prepare #11
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #6 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #9 failures [thrown, program, panic, native, cancelled], suspends true
    ret %6
    ^b1(%7: failure) in S3:
    raise %7
}

func @app.Counter.witness.app.Counting.slot1(%0: app.Counter) -> ^app.Counting [method app.Counter] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    [i0] %1: ^app.Counter = call @app.Counter.bumped#1(%0)
    %2: ^app.Counting = role.wrap %1, ty ^app.Counting
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S0:
    raise %3
}

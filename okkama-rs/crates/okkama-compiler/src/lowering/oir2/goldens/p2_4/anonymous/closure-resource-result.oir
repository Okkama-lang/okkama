oir 2 high
module app
requires core
entry @main

object app.R {
    destroy @app.R.destroy
}
scope S0 action in @app.R.destroy
scope S1 action in @main
scope S2 action in @app.R.new#0
scope S3 action in @main.lambda#0

func @app.R.new#0() -> app.R [ctor app.R] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: app.R = obj.new app.R { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S2:
    raise %1
}

func @app.R.destroy(%0: app.R) -> void [destroy app.R] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    exit.prepare return select s0 at B0
    ret
    ^b1(%1: failure) in S0:
    raise %1
}

func @main() -> int [entry] {
    binding b0 "make": fn() -> app.R in S1
    binding b1 "r": app.R in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %0: fn() -> app.R = fn.closure @main.lambda#0, ty fn() -> app.R
    bind %0, binding b0
    [i2] %1: app.R = fn.call %0()
    bind %1, binding b1
    %2: int = const 0
    want %2
    [i6] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #6
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S1:
    raise %3
}

func @main.lambda#0() -> app.R [lambda] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    [i0] %0: app.R = call @app.R.new#0()
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    ret %0
    ^b1(%1: failure) in S3:
    raise %1
}

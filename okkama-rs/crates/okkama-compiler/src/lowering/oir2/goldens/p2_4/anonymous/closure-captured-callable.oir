oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 action in @main.lambda#0
scope S2 action in @main.lambda#1
summary M0 call-boundary parameters [parameter_effect(convention=take, destination=none)] contract
        call_contract(publication=atomic)
protocol P0 kind closure holders [scope, packet] rules [protocol_rule(transition=publish, from=packet, to=scope,
        checks=[owner, live_dependencies, snapshot, transferable], normal=protocol_poststate(holder=scope, state=open),
        unwind=some(protocol_poststate(holder=scope, state=settled))), protocol_rule(transition=dynamic, from=packet,
        to=scope, checks=[owner, live_dependencies, snapshot, transferable], normal=protocol_poststate(holder=scope,
        state=open), unwind=some(protocol_poststate(holder=packet, state=unaccepted)))] roots [operands]

func @main() -> int [entry] {
    binding b0 "f": fn() -> int in S0
    binding b1 "g": fn() -> int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: fn() -> int = fn.closure @main.lambda#0, ty fn() -> int
    bind %0, binding b0
    %1: fn() -> int = fn.closure @main.lambda#1, [%0], ty fn() -> int
    bind %1, binding b1
    [i4] %2: int = fn.call %1()
    want %2
    [i6] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #6
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S0:
    raise %3
}

func @main.lambda#0() -> int [lambda] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %0: int = const 7
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S1:
    raise %1
}

func @main.lambda#1(%0: fn() -> int) -> int [lambda captures 1] {
    binding b0 "f": fn() -> int in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: type = type.of ty fn() -> int, descriptor descriptor_contract(managed=runtime, retention=owner_graph(0),
        cleanup=@oir.sync_closure.cleanup, summary=M0)
    bind %0, binding b0
    [i2] %2: int = fn.call %0()
    want %2
    [i4] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #4
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S2:
    raise %3
}

func @oir.sync_closure.cleanup(%arg0: fn() -> int) -> void [intrinsic "oir.sync_closure.cleanup"] summary(M0);

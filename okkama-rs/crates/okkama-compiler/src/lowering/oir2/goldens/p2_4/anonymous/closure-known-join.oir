oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 branch in @main parent S0
scope S2 branch in @main parent S0
scope S3 action in @main.lambda#0
scope S4 action in @main.lambda#1

func @main() -> int [entry] {
    binding b0 "f": fn() -> int in S0
    boundary B0 lexical in S0
    boundary B1 lexical in S1
    boundary B2 lexical in S2
    ^b0 in S0 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: fn() -> int) in S0 unwind ^b1:
    bind %2, binding b0
    [i2] %3: int = fn.call %2()
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b3 in S1 unwind ^b1:
    %4: fn() -> int = fn.closure @main.lambda#0, ty fn() -> int
    want %4
    [i7] exit.prepare fallthrough %4 at B1
    result.exit edge normal(0), value %4, demand want, prepare #7
    br ^b2(%4)
    ^b4 in S2 unwind ^b1:
    %5: fn() -> int = fn.closure @main.lambda#1, ty fn() -> int
    want %5
    [i10] exit.prepare fallthrough %5 at B2
    result.exit edge normal(0), value %5, demand want, prepare #10
    br ^b2(%5)
}

func @main.lambda#0() -> int [lambda] {
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %0: int = const 7
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S3:
    raise %1
}

func @main.lambda#1() -> int [lambda] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %0: int = const 8
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S4:
    raise %1
}

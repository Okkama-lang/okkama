oir 2 high
module app
requires core
entry @main

object app.Counter {
    field n: int
    does app.Readable {read = @app.Counter.read#0}
    destroy @app.Counter.destroy
}

role app.Readable {
    read() -> int
}
scope S0 action in @app.Counter.read#0
scope S1 action in @app.Counter.destroy
scope S2 action in @main
scope S3 action in @app.Counter.new#0

func @app.Counter.new#0(%0: int) -> app.Counter [ctor app.Counter] {
    binding b0 "n": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S3, field field_ref(declaration=app.Counter, index=0)
    bind %0, binding b0
    %2: app.Counter = obj.new app.Counter { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func @app.Counter.read#0(%0: app.Counter) -> int [method app.Counter] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @app.Counter.destroy(%0: app.Counter) -> void [destroy app.Counter] {
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    exit.prepare return select s0 at B0
    ret
    ^b1(%1: failure) in S1:
    raise %1
}

func @main() -> int [entry] {
    binding b0 "owner": app.Counter in S2
    binding b1 "item": app.Readable in S2
    binding b2 "read": fn() -> int in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: int = const 7
    [i1] %1: app.Counter = call @app.Counter.new#0(%0)
    bind %1, binding b0
    %2: app.Readable = role.wrap %1, ty app.Readable
    bind %2, binding b1
    %3: fn() -> int = fn.bind.role %2, role app.Readable, slot 0, ty fn() -> int
    bind %3, binding b2
    [i7] %4: int = fn.call %3()
    want %4
    [i9] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #9
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #7 failures [thrown, program, panic, native, cancelled], suspends true
    ret %4
    ^b1(%5: failure) in S2:
    raise %5
}

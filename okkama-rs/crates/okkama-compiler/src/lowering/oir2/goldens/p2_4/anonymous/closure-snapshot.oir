oir 2 high
module app
requires core
entry @main

object app.Counter {
    field n: int
}
scope S0 action in @app.Counter.bumped#0
scope S1 action in @app.Counter.read#1
scope S2 action in @main
scope S3 action in @app.Counter.new#0
scope S4 action in @main.lambda#0

func @app.Counter.new#0(%0: int) -> app.Counter [ctor app.Counter] {
    binding b0 "n": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S3, field field_ref(declaration=app.Counter, index=0)
    bind %0, binding b0
    %2: app.Counter = obj.new app.Counter { n: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func @app.Counter.bumped#0(%0: app.Counter) -> ^app.Counter [successor app.Counter] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = obj.get %0, n
    %2: int = obj.get %0, n
    %3: int = const 1
    %4: int = int.add %2, %3
    stage %4, action S0, field field_ref(declaration=app.Counter, index=0)
    %5: ^app.Counter = obj.next %0 { n: %4 }
    want %5
    [i7] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #7
    ret %5
    ^b1(%6: failure) in S0:
    raise %6
}

func @app.Counter.read#1(%0: app.Counter) -> int [method app.Counter] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: int = obj.get %0, n
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @main() -> int [entry] {
    binding b0 "c": app.Counter in S2
    binding b1 "f": fn() -> int in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: int = const 1
    [i1] %1: app.Counter = call @app.Counter.new#0(%0)
    bind %1, binding b0
    %2: fn() -> int = fn.closure @main.lambda#0, [%1], ty fn() -> int
    bind %2, binding b1
    [i5] %3: ^app.Counter = call @app.Counter.bumped#0(%1)
    %4: app.Counter = succ.take %3, ty app.Counter
    rebind %4, binding b0, target S2
    [i8] %5: int = fn.call %2()
    want %5
    [i10] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #10
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #5 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #8 failures [thrown, program, panic, native, cancelled], suspends true
    ret %5
    ^b1(%6: failure) in S2:
    raise %6
}

func @main.lambda#0(%0: app.Counter) -> int [lambda captures 1] {
    binding b0 "c": app.Counter in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    bind %0, binding b0
    [i1] %1: int = call @app.Counter.read#1(%0)
    want %1
    [i3] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #3
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %1
    ^b1(%2: failure) in S4:
    raise %2
}

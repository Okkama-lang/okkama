oir 2 high
module app
requires core
entry @main

object app.Res {
    destroy @app.Res.destroy
}

object app.Owner {
    field hidden: app.Res
    field label: str
}

object app.Factory {
}

cap app.Owner :: app.Owner.View {
    field text = @app.Owner.cap.View.text#0
}
scope S0 action in @app.Res.destroy
scope S1 action in @app.Owner.cap.View.text#0
scope S2 action in @app.Factory.view#0
scope S3 action in @main
scope S4 action in @app.Res.new#0
scope S5 action in @app.Owner.new#0
scope S6 action in @app.Factory.new#0

func @app.Res.new#0() -> app.Res [ctor app.Res] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %0: app.Res = obj.new app.Res { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S4:
    raise %1
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    exit.prepare return select s0 at B0
    ret
    ^b1(%1: failure) in S0:
    raise %1
}

func @app.Owner.new#0(%0: app.Res, %1: str) -> app.Owner [ctor app.Owner] {
    binding b0 "hidden": app.Res in S5
    binding b1 "label": str in S5
    boundary B0 lexical in S5
    ^b0 in S5 unwind ^b1:
    %2: app.Res = undef ty app.Res
    %3: str = undef ty str
    stage %0, action S5, field field_ref(declaration=app.Owner, index=0)
    stage %1, action S5, field field_ref(declaration=app.Owner, index=1)
    bind %0, binding b0
    bind %1, binding b1
    %4: app.Owner = obj.new app.Owner { hidden: %0, label: %1 }
    want %4
    [i8] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #8
    ret %4
    ^b1(%5: failure) in S5:
    raise %5
}

func @app.Owner.cap.View.text#0(%0: app.Owner) -> str {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: str = obj.get %0, label
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Factory.new#0() -> app.Factory [ctor app.Factory] {
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %0: app.Factory = obj.new app.Factory { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S6:
    raise %1
}

func @app.Factory.view#0(%0: app.Factory) -> app.Owner.View [method app.Factory] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    [i0] %1: app.Res = call @app.Res.new#0()
    %2: str = const "O"
    [i2] %3: app.Owner = call @app.Owner.new#0(%1, %2)
    %4: app.Owner.View = cap.make %3, ty app.Owner.View
    want %4
    [i5] exit.prepare return %4 at B0
    result.exit edge normal(0), value %4, demand want, prepare #5
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %4
    ^b1(%5: failure) in S2:
    raise %5
}

func @main() -> int [entry] {
    binding b0 "view": app.Owner.View in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    [i0] %0: app.Factory = call @app.Factory.new#0()
    [i1] %1: app.Owner.View = call @app.Factory.view#0(%0)
    bind %1, binding b0
    [i3] %2: str = call.cap %1, field_ref(declaration=app.Owner.View, index=0)()
    discard %2
    %3: int = const 0
    want %3
    [i7] exit.prepare return %3 at B0
    result.exit edge normal(0), value %2, demand discard, prepare none
    result.exit edge normal(0), value %3, demand want, prepare #7
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #3 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b1(%4: failure) in S3:
    raise %4
}

oir 2 high
module app
requires core
entry @main

object "app::Box<string>" {
    field value: str
}

object "app::Box<int>" {
    field value: int
}
scope S0 action in @main
scope S1 action in "@app::Box<string>.read#overload()"
scope S2 action in "@app::Box<int>.read#overload()"
scope S3 action in "@app::Box<string>.new#ctor(value:string)"
scope S4 action in "@app::Box<int>.new#ctor(value:int)"

func @main() -> int [entry] {
    binding b0 "text": fn() -> str in S0
    binding b1 "number": fn() -> int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: str = const "a"
    [i1] %1: "app::Box<string>" = call "@app::Box<string>.new#ctor(value:string)"(%0)
    %2: fn() -> str = fn.bind %1, "@app::Box<string>.read#overload()", ty fn() -> str
    bind %2, binding b0
    [i4] %3: str = fn.call %2()
    discard %3
    %4: int = const 7
    [i7] %5: "app::Box<int>" = call "@app::Box<int>.new#ctor(value:int)"(%4)
    %6: fn() -> int = fn.bind %5, "@app::Box<int>.read#overload()", ty fn() -> int
    bind %6, binding b1
    [i10] %7: int = fn.call %6()
    want %7
    [i12] exit.prepare return %7 at B0
    result.exit edge normal(0), value %3, demand discard, prepare none
    result.exit edge normal(0), value %7, demand want, prepare #12
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #7 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    ret %7
    ^b1(%8: failure) in S0:
    raise %8
}

func "@app::Box<string>.new#ctor(value:string)"(%0: str) -> "app::Box<string>" [ctor "app::Box<string>"] {
    binding b0 "value": str in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: str = undef ty str
    stage %0, action S3, field field_ref(declaration="app::Box<string>", index=0)
    bind %0, binding b0
    %2: "app::Box<string>" = obj.new "app::Box<string>" { value: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func "@app::Box<string>.read#overload()"(%0: "app::Box<string>") -> str [method "app::Box<string>"] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    %1: str = obj.get %0, value
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func "@app::Box<int>.new#ctor(value:int)"(%0: int) -> "app::Box<int>" [ctor "app::Box<int>"] {
    binding b0 "value": int in S4
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S4, field field_ref(declaration="app::Box<int>", index=0)
    bind %0, binding b0
    %2: "app::Box<int>" = obj.new "app::Box<int>" { value: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S4:

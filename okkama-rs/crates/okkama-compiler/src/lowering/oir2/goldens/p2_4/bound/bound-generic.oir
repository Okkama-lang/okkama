func "@app::Box<int>.read#overload()"(%0: "app::Box<int>") -> int [method "app::Box<int>"] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %1: int = obj.get %0, value
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2

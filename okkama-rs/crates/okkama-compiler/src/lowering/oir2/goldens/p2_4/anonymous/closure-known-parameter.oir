oir 2 high
module app
requires core
entry @main

object app.Apply {
}
scope S0 action in @app.Apply.call#0
scope S1 action in @main
scope S2 action in @app.Apply.new#0
scope S3 action in @main.lambda#0

func @app.Apply.new#0() -> app.Apply [ctor app.Apply] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: app.Apply = obj.new app.Apply { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S2:
    raise %1
}

func @app.Apply.call#0(%0: app.Apply, %1: fn(int) -> int) -> int [method app.Apply] {
    binding b0 "f": fn(int) -> int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    bind %1, binding b0
    %2: int = const 3
    [i2] %3: int = fn.call %1(%2)
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b1(%4: failure) in S0:
    raise %4
}

func @main() -> int [entry] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    [i0] %0: app.Apply = call @app.Apply.new#0()
    %1: fn(int) -> int = fn.closure @main.lambda#0, ty fn(int) -> int
    [i2] %2: int = call @app.Apply.call#0(%0, %1)
    want %2
    [i4] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #4
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S1:
    raise %3
}

func @main.lambda#0(%0: int) -> int [lambda] {
    binding b0 "x": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    bind %0, binding b0
    %1: int = const 4
    %2: int = int.add %0, %1
    want %2
    [i4] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #4
    ret %2
    ^b1(%3: failure) in S3:

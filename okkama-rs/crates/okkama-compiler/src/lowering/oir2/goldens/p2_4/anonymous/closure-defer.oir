oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 action in @main.lambda#0
scope S2 action in @main.lambda#0.defer#0
scope S3 branch in @main.lambda#0.defer#0 parent S2
scope S4 branch in @main.lambda#0.defer#0 parent S2

func @main() -> int [entry] {
    binding b0 "f": fn() -> int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: fn() -> int = fn.closure @main.lambda#0, ty fn() -> int
    bind %0, binding b0
    [i2] %1: int = fn.call %0()
    want %1
    [i4] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #4
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main.lambda#0() -> int [lambda] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    defer.register S1, action defer_action(function=@main.lambda#0.defer#0,
        replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^b2
    ^b1(%0: failure) in S1:
    raise %0
    ^b2 in S1 unwind ^b3:
    %1: int = const 1
    want %1
    [i3] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #3
    ret %1
    ^b3(%2: failure) in S1:
    raise %2
}

func @main.lambda#0.defer#0() -> void [defer(replacements=[defer_label(label="return", result=some(int))])] {
    boundary B0 lexical in S2
    boundary B1 lexical in S4
    selection s0: selection = union([])
    ^b0 in S2 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S2:
    raise %1
    ^b2 in S2 unwind ^b1:
    ret defer continue
    ^b3 in S3 unwind ^b1:
    %2: int = const 7
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    ret defer replace return, %2
    ^b4 in S4 unwind ^b1:
    exit.prepare fallthrough select s0 at B1
    br ^b2
}

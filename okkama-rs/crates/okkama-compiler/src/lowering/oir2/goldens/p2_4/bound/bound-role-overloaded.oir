oir 2 high
module app
requires core
entry @main

object "app::Box<int>" {
    field value: int
    does "app::Readable<int>" {read#slot0 = "@app::Box<int>.read#overload(value:int)",
        read#slot1 = "@app::Box<int>.read#overload(value:string)"}
}

role "app::Readable<int>" {
    read#slot0(int) -> int
    read#slot1(str) -> int
}
scope S0 action in @main
scope S1 action in "@app::Box<int>.read#overload(value:int)"
scope S2 action in "@app::Box<int>.read#overload(value:string)"
scope S3 action in "@app::Box<int>.new#ctor(value:int)"

func @main() -> int [entry] {
    binding b0 "item": "app::Readable<int>" in S0
    binding b1 "number": fn(int) -> int in S0
    binding b2 "text": fn(str) -> int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 7
    [i1] %1: "app::Box<int>" = call "@app::Box<int>.new#ctor(value:int)"(%0)
    %2: "app::Readable<int>" = role.wrap %1, ty "app::Readable<int>"
    bind %2, binding b0
    %3: fn(int) -> int = fn.bind.role %2, role "app::Readable<int>", slot 0, ty fn(int) -> int
    bind %3, binding b1
    %4: fn(str) -> int = fn.bind.role %2, role "app::Readable<int>", slot 1, ty fn(str) -> int
    bind %4, binding b2
    %5: int = const 1
    [i9] %6: int = fn.call %3(%5)
    %7: str = const "a"
    [i11] %8: int = fn.call %4(%7)
    %9: int = int.add %6, %8
    want %9
    [i14] exit.prepare return %9 at B0
    result.exit edge normal(0), value %9, demand want, prepare #14
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #9 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #11 failures [thrown, program, panic, native, cancelled], suspends true
    ret %9
    ^b1(%10: failure) in S0:
    raise %10
}

func "@app::Box<int>.read#overload(value:int)"(%0: "app::Box<int>", %1: int) -> int [method "app::Box<int>"] {
    binding b0 "value": int in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    bind %1, binding b0
    %2: int = obj.get %0, value
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    ret %2
    ^b1(%3: failure) in S1:
    raise %3
}

func "@app::Box<int>.read#overload(value:string)"(%0: "app::Box<int>", %1: str) -> int [method "app::Box<int>"] {
    binding b0 "value": str in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    bind %1, binding b0
    %2: int = obj.get %0, value
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    ret %2
    ^b1(%3: failure) in S2:
    raise %3
}

func "@app::Box<int>.new#ctor(value:int)"(%0: int) -> "app::Box<int>" [ctor "app::Box<int>"] {
    binding b0 "value": int in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: int = undef ty int
    stage %0, action S3, field field_ref(declaration="app::Box<int>", index=0)
    bind %0, binding b0
    %2: "app::Box<int>" = obj.new "app::Box<int>" { value: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

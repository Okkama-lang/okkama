oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 action in @main.defer#0
scope S2 branch in @main.defer#0 parent S1
scope S3 branch in @main.defer#0 parent S1

func @main() -> int [entry] {
    binding b0 "replacement": int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: int = const 7
    bind %0, binding b0
    defer.register S0, action defer_action(function=@main.defer#0, bindings=[b0], replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^b2(%0)
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: int) in S0 unwind ^b3:
    %3: int = const 1
    want %3
    [i5] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #5
    ret %3
    ^b3(%4: failure) in S0:
    raise %4
}

func @main.defer#0(%0: int) -> void [defer(replacements=[defer_label(label="return", result=some(int))])] {
    binding b0 "replacement": int in S1
    boundary B0 lexical in S1
    boundary B1 lexical in S3
    ^b0 in S1 unwind ^b1:
    bind %0, binding b0
    %1: int = const 0
    %2: bool = int.gt %0, %1
    cond %2, ^b3(%0), ^b4(%0)
    ^b1(%3: failure) in S1:
    raise %3
    ^b2(%4: int) in S1 unwind ^b1:
    ret defer continue
    ^b3(%5: int) in S2 unwind ^b1:
    want %5
    [i4] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #4
    ret defer replace return, %5
    ^b4(%6: int) in S3 unwind ^b1:
    %7: int = const 2
    discard %7
    want %6
    [i8] exit.prepare fallthrough %6 at B1
    result.exit edge normal(0), value %7, demand discard, prepare none
    result.exit edge normal(0), value %6, demand want, prepare #8
    br ^b2(%6)
}

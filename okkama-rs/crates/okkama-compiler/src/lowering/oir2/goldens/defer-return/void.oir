oir 2 high
module app
requires core
entry @main

object app.Work {
}
scope S0 action in @app.Work.run#0
scope S1 action in @main
scope S2 action in @app.Work.new#0
scope S3 action in @app.Work.run#0.defer#0
scope S4 branch in @app.Work.run#0.defer#0 parent S3
scope S5 branch in @app.Work.run#0.defer#0 parent S3

func @app.Work.new#0() -> app.Work [ctor app.Work] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: app.Work = obj.new app.Work { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S2:
    raise %1
}

func @app.Work.run#0(%0: app.Work) -> void [method app.Work] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    defer.register S0, action defer_action(function=@app.Work.run#0.defer#0, replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^b2
    ^b1(%1: failure) in S0:
    raise %1
    ^b2 in S0 unwind ^b3:
    exit.prepare return select s0 at B0
    ret
    ^b3(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    [i0] %0: app.Work = call @app.Work.new#0()
    [i1] call @app.Work.run#0(%0)
    %1: int = const 0
    want %1
    [i4] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #4
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %1
    ^b1(%2: failure) in S1:
    raise %2
}

func @app.Work.run#0.defer#0() -> void [defer(replacements=[defer_label(label="return")])] {
    boundary B0 lexical in S3
    boundary B1 lexical in S5
    selection s0: selection = union([])
    selection s1: selection = union([])
    ^b0 in S3 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S3:
    raise %1
    ^b2 in S3 unwind ^b1:
    ret defer continue
    ^b3 in S4 unwind ^b1:
    exit.prepare return select s0 at B0
    ret defer replace return
    ^b4 in S5 unwind ^b1:
    exit.prepare fallthrough select s1 at B1
    br ^b2
}

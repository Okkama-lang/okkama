oir 2 high
module app
requires core
entry @main

object app.Res {
    field name: str
    destroy @app.Res.destroy
}

object app.Work {
}
scope S0 action in @app.Res.destroy
scope S1 action in @app.Work.run#0
scope S2 action in @main
scope S3 action in @app.Res.new#0
scope S4 action in @app.Work.new#0
scope S5 action in @app.Work.run#0.defer#0
scope S6 branch in @app.Work.run#0.defer#0 parent S5
scope S7 branch in @app.Work.run#0.defer#0 parent S5
scope S8 action in @app.Work.run#0.defer#1

func @app.Res.new#0(%0: str) -> app.Res [ctor app.Res] {
    binding b0 "name": str in S3
    boundary B0 lexical in S3
    ^b0 in S3 unwind ^b1:
    %1: str = undef ty str
    stage %0, action S3, field field_ref(declaration=app.Res, index=0)
    bind %0, binding b0
    %2: app.Res = obj.new app.Res { name: %0 }
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    ret %2
    ^b1(%3: failure) in S3:
    raise %3
}

func @app.Res.destroy(%0: app.Res) -> void [destroy app.Res] {
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0 unwind ^b1:
    exit.prepare return select s0 at B0
    ret
    ^b1(%1: failure) in S0:
    raise %1
}

func @app.Work.new#0() -> app.Work [ctor app.Work] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %0: app.Work = obj.new app.Work { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S4:
    raise %1
}

func @app.Work.run#0(%0: app.Work) -> app.Res [method app.Work] {
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    defer.register S1, action defer_action(function=@app.Work.run#0.defer#0, replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^b2
    ^b1(%1: failure) in S1:
    raise %1
    ^b2 in S1 unwind ^b3:
    %2: str = const "original"
    [i2] %3: app.Res = call @app.Res.new#0(%2)
    want %3
    [i4] exit.prepare return %3 at B0
    result.exit edge normal(0), value %3, demand want, prepare #4
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    ret %3
    ^b3(%4: failure) in S1:
    raise %4
}

func @main() -> int [entry] {
    binding b0 "result": app.Res in S2
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    [i0] %0: app.Work = call @app.Work.new#0()
    [i1] %1: app.Res = call @app.Work.run#0(%0)
    bind %1, binding b0
    %2: int = const 0
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S2:
    raise %3
}

func @app.Work.run#0.defer#0() -> void [defer(replacements=[defer_label(label="return", result=some(app.Res))])] {
    binding b0 "local": app.Res in S6
    boundary B0 lexical in S5
    boundary B1 lexical in S7
    selection s0: selection = union([])
    ^b0 in S5 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S5:
    raise %1
    ^b2 in S5 unwind ^b1:
    ret defer continue
    ^b3 in S6 unwind ^b1:
    %2: str = const "local"
    [i2] %3: app.Res = call @app.Res.new#0(%2)
    bind %3, binding b0
    defer.register S6, action defer_action(function=@app.Work.run#0.defer#1, bindings=[b0])
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b5(%3)
    ^b4 in S7 unwind ^b1:
    exit.prepare fallthrough select s0 at B1
    br ^b2
    ^b5(%4: app.Res) in S6 unwind ^b6:
    %5: str = const "replacement"
    [i7] %6: app.Res = call @app.Res.new#0(%5)
    want %6
    [i9] exit.prepare return %6 at B0
    result.exit edge normal(0), value %6, demand want, prepare #9
    high.effects at #7 failures [thrown, program, panic, native, cancelled], suspends true

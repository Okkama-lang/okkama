func @app.Work.run#0.defer#1(%0: app.Res) -> void [defer()] {
    binding b0 "local": app.Res in S8
    boundary B0 lexical in S8
    ^b0 in S8 unwind ^b1:
    bind %0, binding b0
    discard %0
    result.exit edge normal(0), value %0, demand discard, prepare none
    br ^b2
    ^b1(%1: failure) in S8:

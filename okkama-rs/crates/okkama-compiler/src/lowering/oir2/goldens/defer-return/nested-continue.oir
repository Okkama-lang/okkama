oir 2 high
module app
requires core
entry @main
scope S0 action in @main
scope S1 action in @main.defer#0
scope S2 branch in @main.defer#0 parent S1
scope S3 branch in @main.defer#0 parent S1
scope S4 action in @main.defer#1
scope S5 branch in @main.defer#1 parent S4
scope S6 branch in @main.defer#1 parent S4

func @main() -> int [entry] {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    defer.register S0, action defer_action(function=@main.defer#0, replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^b2
    ^b1(%0: failure) in S0:
    raise %0
    ^b2 in S0 unwind ^b3:
    %1: int = const 1
    want %1
    [i3] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #3
    ret %1
    ^b3(%2: failure) in S0:
    raise %2
}

func @main.defer#0() -> void [defer(replacements=[defer_label(label="return", result=some(int))])] {
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    boundary B2 lexical in S3
    selection s0: selection = union([])
    selection s1: selection = union([])
    ^b0 in S1 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S1:
    raise %1
    ^b2 in S1 unwind ^b1:
    ret defer continue
    ^b3 in S2 unwind ^b1:
    defer.register S2, action defer_action(function=@main.defer#1, replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^b5
    ^b4 in S3 unwind ^b1:
    exit.prepare fallthrough select s1 at B2
    br ^b2
    ^b5 in S2 unwind ^b6:
    %2: int = const 2
    discard %2
    exit.prepare fallthrough select s0 at B1
    result.exit edge normal(0), value %2, demand discard, prepare none
    br ^b2
    ^b6(%3: failure) in S1:
    raise %3
}

func @main.defer#1() -> void [defer(replacements=[defer_label(label="return", result=some(int))])] {
    boundary B0 lexical in S4
    boundary B1 lexical in S6
    selection s0: selection = union([])
    ^b0 in S4 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S4:
    raise %1
    ^b2 in S4 unwind ^b1:
    ret defer continue
    ^b3 in S5 unwind ^b1:
    %2: int = const 7
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    ret defer replace return, %2
    ^b4 in S6 unwind ^b1:
    exit.prepare fallthrough select s0 at B1
    br ^b2
}

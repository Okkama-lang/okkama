    ^b5(%6: bool) in S5 unwind ^b6:
    cond %6, ^b8(%6), ^b9(%6)
    ^b6(%7: failure) in S4:
    raise %7
    ^b7(%8: bool) in S5 unwind ^b6:
    %9: int = const 7
    want %9
    [i7] exit.prepare return %9 at B0
    result.exit edge normal(0), value %9, demand want, prepare #7
    ret defer replace return, %9
    ^b8(%10: bool) in S7 unwind ^b6:
    %11: app.Stop = enum.case app.Stop, case 0

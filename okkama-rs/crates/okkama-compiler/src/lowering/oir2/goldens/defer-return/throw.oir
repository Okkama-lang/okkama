func @main() -> int [entry] {
    binding b0 "fails": bool in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %0: bool = const true
    bind %0, binding b0
    defer.register S0, action defer_action(function=@main.defer#0, replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^b2(%0)
    ^b1(%1: failure) in S0:
    raise %1
    ^b2(%2: bool) in S0 unwind ^b3:
    defer.register S0, action defer_action(function=@main.defer#1, bindings=[b0], replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^b4(%2)
    ^b3(%3: failure) in S0:
    raise %3
    ^b4(%4: bool) in S0 unwind ^b5:
    %5: int = const 1
    want %5
    [i6] exit.prepare return %5 at B0
    result.exit edge normal(0), value %5, demand want, prepare #6
    ret %5
    ^b5(%6: failure) in S0:
    raise %6
}

func @main.defer#0() -> void [defer(replacements=[defer_label(label="return", result=some(int))])] {
    boundary B0 lexical in S1
    boundary B1 lexical in S3
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S1:
    raise %1
    ^b2 in S1 unwind ^b1:
    ret defer continue
    ^b3 in S2 unwind ^b1:
    %2: int = const 9
    want %2
    [i3] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #3
    ret defer replace return, %2
    ^b4 in S3 unwind ^b1:
    exit.prepare fallthrough select s0 at B1
    br ^b2
}

func @main.defer#1(%0: bool) -> void [defer(replacements=[defer_label(label="return", result=some(int))])] {
    binding b0 "fails": bool in S4
    boundary B0 lexical in S4
    boundary B1 lexical in S8
    boundary B2 lexical in S6
    ^b0 in S4 unwind ^b1:
    bind %0, binding b0

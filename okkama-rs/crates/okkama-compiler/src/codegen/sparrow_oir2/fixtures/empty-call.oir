oir 2 low
module empty_call
scope S action in @caller
scope SC action in @callee
summary Mc call-boundary contract call_contract(failures=[program], publication=atomic)
func @caller(%original: own, %full: deps) -> (own, deps) abi explicit(input_packet=0, output_packet=0) {
^entry in S:
    %empty: own = own.empty
    invoke.own call @callee(; %empty) deps [%full] summary(Mc)
        normal ^ok($packet, $deps)
        unwind ^bad($failure)
^ok(%packet: own, %deps: deps) in S:
    %joined: own = own.join [%original, %packet]
    ret %joined, %deps
^bad(%failure: failure) in S:
    ret %original, %full
}
func @callee(%input: own, %full: deps) -> (own, deps) abi explicit(input_packet=0, output_packet=0) summary(Mc) {
^entry in SC:
    ret %input, %full
}

// #601 R4: okkama-oir's Low golden r2-take-proof-recheck, edited by hand. On the successful return the second
// Future's cache duty is rehomed (C-4, token form) into the return's reserve instead of being settled, with the
// only target OIR names today, a scope (`target S1`). verify_low refuses the token form until #601 R1 models it
// (AsyncUnmodeledOp), and the return commits to the caller, so the SPB 17 load gate refuses the target
// (SPB_REHOME). The fixture checks the translation only.
module unique_cache
scope S0 action in @task
scope S1 action in @f
summary M0 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary M1 call-boundary contract call_contract(failures=[cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary M3 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)

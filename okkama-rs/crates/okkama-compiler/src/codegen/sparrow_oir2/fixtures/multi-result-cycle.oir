oir 2 low
module outcome_cycle
scope S action in @caller
scope SC action in @callee
summary Mc call-boundary parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)]
    contract call_contract(results=[int], failures=[thrown], publication=atomic)
func @caller(%a: int, %b: int, %offered: own, %full: deps, %unwind_only: str) -> (int, own, deps)
    abi explicit(input_packet=2, output_packet=1) {
^entry in S:
    br ^loop(%a, %b, %offered, %full, %a)
^loop(%left: int, %right: int, %packet: own, %deps: deps, %previous: int) in S:
    invoke.own call @callee(%left, %right; %packet) deps [%deps] summary(Mc)
        normal ^loop(%right, %left, $packet, $deps, $value)
        unwind ^bad($failure, %unwind_only, %full)
^bad(%failure: failure, %text: str, %old_deps: deps) in S:
    %length: int = str.len %text
    %empty: own = own.empty
    ret %length, %empty, %old_deps
}
func @callee(%a: int, %b: int, %input: own, %full: deps) -> (int, own, deps)
    abi explicit(input_packet=2, output_packet=1) summary(Mc) {
^entry in SC:
    ret %a, %input, %full
}

oir 2 low
module shielded_call
scope S action in @caller
scope SC action in @callee
summary Mc call-boundary contract call_contract(failures=[thrown, cancelled], publication=atomic)
func @caller(%offered: own, %full: deps) -> (own, deps) [cleanup] abi explicit(input_packet=0, output_packet=0) {
^entry in S:
    invoke.own call @callee(; %offered) deps [%full] summary(Mc), cleanup shielded
        normal ^ok($packet, $deps)
        unwind ^failed($failure)
^ok(%packet: own, %deps: deps) in S:
    ret %packet, %deps
^failed(%failure: failure) in S:
    %empty: own = own.empty
    ret %empty, %full
}
func @callee(%input: own, %full: deps) -> (own, deps) abi explicit(input_packet=0, output_packet=0) summary(Mc) {
^entry in SC:
    ret %input, %full
}

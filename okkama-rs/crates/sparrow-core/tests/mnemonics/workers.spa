; Process workers in a synchronous body on both engines (#1121): an action bound to its fields and its spawn,
; which fails without a worker command; a panic at the end.
sparrow 18
module "mnemonics-workers" "1.0.0"
type t0 int
type t1 str
type t2 byte
type t3 array t2
type t4 bool
type t5 fn [t0] -> t0
type t6 future t0
type t7 failure
function f0 "write" native "runtime/stdio@1::stdout_write/1" {
    registers [t3]
    params [r0]
    result t0
}
function f1 "print" {
    registers [t0, t1, t1, t1, t3]
    params [r0]
    result void
    0: cvt r1, r0
    1: const r2, str "\n"
    2: str.concat r3, r1, r2
    3: str.utf8 r4, r3
    4: call _, f0, [r4]
    5: ret _
}
function f2 "say" {
    registers [t1, t1, t1, t3]
    params [r0]
    result void
    0: const r1, str "\n"
    1: str.concat r2, r0, r1
    2: str.utf8 r3, r2
    3: call _, f0, [r3]
    4: ret _
}
function f3 "flag" {
    registers [t4, t0]
    params [r0]
    result void
    0: br r0, @1, @3
    1: const r1, int 1
    2: jmp @4
    3: const r1, int 0
    4: call _, f1, [r1]
    5: ret _
}

function f4 "main" {
    registers [t0, t5, t5, t6, t7, t1]
    params []
    result t0
    handler 3 4 @5 r4
    0: const r0, int 20
    1: fn.closure r1, f5, []
    2: worker.bind r2, r1, r1, [r0]
    3: worker.spawn r3, r2, [r0], false
    4: jmp @7
    5: const r5, str "spawn failed"
    6: call _, f2, [r5]
    7: const r5, str "the end"
    8: panic r5
}
function f5 "twice" {
    registers [t0, t0]
    params [r0]
    result t0
    0: int.add r1, r0, r0
    1: ret r1
}
entry f4

; Workers on both engines, emulated in the same instance (#1121, #1127, #1144): an action bound to a field and its
; spawn, a direct spawn, a worker that fails (its failure caught at the await), and a panic at the end. Its test
; (interp_tests.rs) runs it with emulated workers, so every spawn here succeeds and needs no host.
sparrow 18
module "mnemonics-workers" "1.0.0"
type t0 int
type t1 str
type t2 byte
type t3 array t2
type t4 bool
type t5 fn [t0] -> t0
type t6 future t0
type t7 failure
type t8 fn [t0, t0] -> t0
function f0 "write" native "runtime/stdio@1::stdout_write/1" {
    registers [t3]
    params [r0]
    result t0
}
function f1 "print" {
    registers [t0, t1, t1, t1, t3]
    params [r0]
    result void
    0: cvt r1, r0
    1: const r2, str "\n"
    2: str.concat r3, r1, r2
    3: str.utf8 r4, r3
    4: call _, f0, [r4]
    5: ret _
}
function f2 "say" {
    registers [t1, t1, t1, t3]
    params [r0]
    result void
    0: const r1, str "\n"
    1: str.concat r2, r0, r1
    2: str.utf8 r3, r2
    3: call _, f0, [r3]
    4: ret _
}
function f3 "flag" {
    registers [t4, t0]
    params [r0]
    result void
    0: br r0, @1, @3
    1: const r1, int 1
    2: jmp @4
    3: const r1, int 0
    4: call _, f1, [r1]
    5: ret _
}

function f4 "main" async {
    registers [t0, t5, t5, t6, t7, t1, t0, t8, t0]
    params []
    result t0
    handler 13 14 @16 r4
    0: const r0, int 20
    1: fn.closure r1, f5, []
    2: fn.closure r7, f6, []
    3: worker.bind r2, r1, r7, [r0]
    4: const r6, int 22
    5: worker.spawn r3, r2, [r6], false
    6: await r8, r3
    7: call _, f1, [r8]
    8: worker.spawn r3, r1, [r0], true
    9: await r8, r3
    10: call _, f1, [r8]
    11: fn.closure r1, f7, []
    12: worker.spawn r3, r1, [r0], true
    13: await r8, r3
    14: call _, f1, [r8]
    15: jmp @18
    16: const r5, str "worker failed"
    17: call _, f2, [r5]
    18: const r5, str "the end"
    19: panic r5
}
function f5 "twice" {
    registers [t0, t0]
    params [r0]
    result t0
    0: int.add r1, r0, r0
    1: ret r1
}
function f6 "add" {
    registers [t0, t0, t0]
    params [r0, r1]
    result t0
    0: int.add r2, r0, r1
    1: ret r2
}
function f7 "fails" {
    registers [t0, t1]
    params [r0]

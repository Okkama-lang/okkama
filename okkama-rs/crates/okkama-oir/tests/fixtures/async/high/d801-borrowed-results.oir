// #801: results of synchronous calls that are borrowed aliases of a Future (a getter of a Future field, a relay
// of one) next to a fresh one (a Future created and returned). The producer's High for:
//     module app v1.0.0;
//     object Child { has n is int; Child(:n); async run() is int { n; } }
//     object Box { has f is Future<int>; Box(:f); first() is Future<int> { f; } }
//     object Relay { Relay(); relay(b is Box) is Future<int> { b.first(); } }
//     object Maker { Maker(); make(n is int) is Future<int> { Child(n: n).run(); } }
//     async main() is int {
//         let b = Box(f: Child(n: 5).run());
//         let g = Relay().relay(b);
//         let m = Maker().make(3);
//         (await g) + (await m) - 8;
//     }

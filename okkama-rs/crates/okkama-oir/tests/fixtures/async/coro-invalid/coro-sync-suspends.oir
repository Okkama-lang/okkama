oir 2 coro
// expect coro-sync-suspends instruction:0:1
// D20: a sync function never suspends, so its close declares no suspension.
module coro_sync_suspends
scope S action in @f
summary Mf internal contract call_contract(publication=atomic)
func @f() -> void summary(Mf) {
^entry in S:
    %q: scope<S> = scope.begin S
    %closed: closed = scope.end %q, effects scope_effects(failures=[], suspends=true, cancel=false)
    ret
}

oir 2 coro
// C-2: continuation 0 restores receiver, arguments, descriptor parameters and the input packet; every exit
// publishes through the frame and returns.
module c2_body_entry_exit
object Receiver {
    field name: str
}
object Res {
    field label: str
}
scope S action in @read
summary Mbody internal contract call_contract(results=[Res], failures=[thrown, program, panic, native, cancelled],
    suspends=true, publication=atomic)
func @read(%frame: frame<@read>) -> void [async] summary(Mbody) {
    frame.layout {
        slot 0: Receiver
        slot 1: Res
        slot 2: type
        slot 3: own linear
    }
    continuation 0 start saves [0, 1, 2, 3]
    boundary B0 call in S
^entry in S:
    (%fr1: frame<@read>, %recv: Receiver, %arg: Res, %dict: type, %inputs: own) = frame.resume %frame, continuation 0, slots [
        saved_slot(slot=0, ty=Receiver, linear=false), saved_slot(slot=1, ty=Res, linear=false),
        saved_slot(slot=2, ty=type, linear=false), saved_slot(slot=3, ty=own, linear=true)]
    %q0: scope<S> = scope.begin S
    %q1: scope<S> = own.accept %q0, %inputs
    %empty: own = own.empty
    %d0: deps = deps.of %arg
    %pending: pending = exit.prepare return %arg, %empty, deps(%d0) at B0
    invoke.own scope.end %q1, reserve %pending, effects scope_effects(failures=[thrown, program, panic, native],
        suspends=false, cancel=true)
        normal ^ok($closed, $pending)
        unwind ^cancelled($closed, $failure)
^ok(%closed: closed, %reserved: pending) in S:
    (%v: Res, %p: own, %d: deps) = exit.commit %reserved, destination caller, result Res
    fut.publish %fr1, success(value=%v, packet=%p, deps=%d)
    ret
^cancelled(%closed2: closed, %failure: failure) in S:
    fut.publish %fr1, failure(%failure)
    ret
}

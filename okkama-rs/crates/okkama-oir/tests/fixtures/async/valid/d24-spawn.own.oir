oir 2 own
// D24.1 in own: spawn adds ServiceOf{f, Frame} to the scope state and forwards it.
module d24_spawn_own
object Worker {
    field id: int
}
scope SR action in @Worker.run
scope S action in @main
summary Mrun internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @Worker.run(%w: Worker) -> void [async] summary(Mrun) {
^entry in SR:
    ret
}
func @main(%in: own, %deps: deps, %w: Worker) -> void {
^entry in S:
    %q0: scope<S> = scope.begin S
    (%t: future<void>, %q1: scope<S>) = fut.new %in, %deps, %q0, environment deferred(function=@Worker.run,
        arguments=[%w], descriptors=[]), owner S
    %q2: scope<S> = fut.spawn %t, %q1
    %closed: closed = scope.end %q2, effects scope_effects(failures=[], suspends=false, cancel=false)
    ret
}

oir 2 low
// D25.3: the static settle steps of scheduled tokens, then one dynamic step for runtime-admitted entries.
module d25_settle_dynamic
protocol Services kind services holders [scope, cache, frame, root] rules [protocol_rule(transition=settle,
    from=frame, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running)),
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled))]
scope S action in @f
summary Mf internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @f(%frame: frame<@f>) -> void [async] summary(Mf) {
    frame.layout {
        slot 0: task-state linear
        slot 1: cache-state linear
        slot 2: deps
    }
    continuation 0 start saves [0, 1, 2]
    low.metadata cleanup_metadata(closes=[cleanup_close(source=scope(S), after_defers=^entry, reserve=false,
        active_failure=false, effects=scope_effects(failures=[thrown, program, panic, native], suspends=false,
        cancel=false))], schedules=[cleanup_schedule(close=0, holders=[%task, %c], protocol=some(Services))],
        plans=[cleanup_plan(close=0, sources=[scope_inventory])], roots=[], proofs=[])
^entry in S:
    (%fr0: frame<@f>, %task: task-state, %c: cache-state, %deps: deps) = frame.resume %frame, continuation 0, slots [
        saved_slot(slot=0, ty=task-state, linear=true), saved_slot(slot=1, ty=cache-state, linear=true),
        saved_slot(slot=2, ty=deps, linear=false)]
    %q: scope<S> = scope.begin S
    %cl0: cleanup-state = cleanup.begin %q, close 0, effects scope_effects(failures=[thrown, program, panic, native],
        suspends=false, cancel=false)
    %cl2: cleanup-state = cleanup.settle %cl0, %task, protocol Services
    %cl3: cleanup-state = cleanup.settle %cl2, %c, protocol Services
    %cl4: cleanup-state = cleanup.settle.dynamic %cl3, protocol Services
    %cl5: cleanup-state = cleanup.plan %cl4, plan 0
    (%closed: closed, %fs: failure-state, %xs: exit-state) = cleanup.finish %cl5
    exit.dispatch 0 %closed %fs %xs success ^done(%fr0, $closed) failure ^failed(%fr0, $closed, $failure)
^done(%fr1: frame<@f>, %closed1: closed) in S:
    %p: own = own.empty
    fut.publish %fr1, success(packet=%p, deps=%deps)
    ret
^failed(%fr2: frame<@f>, %closed2: closed, %failure: failure) in S:
    fut.publish %fr2, failure(%failure)
    ret
}

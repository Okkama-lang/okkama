oir 2 own
// D22 in own: an external environment is treated as deferred; own returns no cache-state.
module d22_external_new_own
object Event {
    field id: int
}
scope S action in @create
summary MwaitC internal contract call_contract(results=[Event], publication=atomic)
summary MwaitB internal contract call_contract(results=[Event], failures=[thrown, program, panic, native, cancelled],
    suspends=true, publication=atomic)
func @Event.wait(%self: Event) -> Event [async, intrinsic "fixture.ordinary"] async-creation(MwaitC)
    async-body(MwaitB);
func @create(%inputs: own, %external: deps, %q: scope<S>, %ev: Event) -> (future<Event>, scope<S>) {
^entry in S:
    (%future: future<Event>, %next: scope<S>) = fut.new %inputs, %external, %q, environment external(function=@Event.wait,
        arguments=[%ev], descriptors=[]), result Event, owner S
    ret %future, %next
}

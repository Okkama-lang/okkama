oir 2 coro
// D22: a Future run by a runtime driver; coro adds the owner's cache-state for every environment.
module d22_external_new
object Event {
    field id: int
}
scope S action in @main
summary MwaitC internal contract call_contract(results=[Event], publication=atomic)
summary MwaitB internal contract call_contract(results=[Event], failures=[thrown, program, panic, native, cancelled],
    suspends=true, publication=atomic)
summary Mmain internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @Event.wait(%self: Event) -> Event [async, intrinsic "fixture.ordinary"] async-creation(MwaitC)
    async-body(MwaitB);
func @main(%frame: frame<@main>) -> void [async] summary(Mmain) {
    frame.layout {
        slot 0: Event
        slot 1: own linear
        slot 2: deps
    }
    continuation 0 start saves [0, 1, 2]
^entry in S:
    (%fr0: frame<@main>, %ev: Event, %inputs: own, %deps: deps) = frame.resume %frame, continuation 0, slots [
        saved_slot(slot=0, ty=Event, linear=false), saved_slot(slot=1, ty=own, linear=true), saved_slot(slot=2,
        ty=deps, linear=false)]
    %q0: scope<S> = scope.begin S
    (%f: future<Event>, %c: cache-state, %q1: scope<S>) = fut.new %inputs, %deps, %q0, environment external(function=@Event.wait,
        arguments=[%ev], descriptors=[]), result Event, owner S
    %closed: closed = scope.end %q1, effects scope_effects(failures=[], suspends=false, cancel=false)
    %empty: own = own.empty
    %p: own = service.absorb %empty, %c
    fut.publish %fr0, success(value=%f, packet=%p, deps=%deps)
    ret
}

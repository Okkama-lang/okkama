oir 2 coro
// D25.2: a known entry leaves a packet as its duty token, and a token goes back into a packet.
module d25_materialize_absorb
scope S action in @main
summary Mmain internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @main(%frame: frame<@main>) -> void [async] summary(Mmain) {
    frame.layout {
        slot 0: future<int>
        slot 1: own linear
        slot 2: deps
    }
    continuation 0 start saves [0, 1, 2]
^entry in S:
    (%fr0: frame<@main>, %f: future<int>, %p0: own, %deps: deps) = frame.resume %frame, continuation 0, slots [
        saved_slot(slot=0, ty=future<int>, linear=false), saved_slot(slot=1, ty=own, linear=true), saved_slot(slot=2,
        ty=deps, linear=false)]
    (%p1: own, %c: cache-state) = service.materialize %p0, holder %f, kind cache
    %p2: own = service.absorb %p1, %c
    fut.publish %fr0, success(value=%f, packet=%p2, deps=%deps)
    ret
}

// C-6: an async defer entry is an async body; its success maps to Continue and it declares no replacement.
module c6_async_defer
object Conn {
    field id: int
}
scope SD action in @d
summary Md internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @d(%frame: frame<@d>) -> void [async, defer()] summary(Md) {
    frame.layout {
        slot 0: Conn
        slot 1: own linear
        slot 2: deps
    }
    continuation 0 start saves [0, 1, 2]
^entry in SD:
    (%fr0: frame<@d>, %conn: Conn, %input: own, %deps: deps) = frame.resume %frame, continuation 0, slots [
        saved_slot(slot=0, ty=Conn, linear=false), saved_slot(slot=1, ty=own, linear=true), saved_slot(slot=2,
        ty=deps, linear=false)]
    %q0: scope<SD> = scope.begin SD
    %q1: scope<SD> = own.accept %q0, %input
    %closed: closed = scope.end %q1, effects scope_effects(failures=[], suspends=false, cancel=false)
    %p: own = own.empty
    fut.publish %fr0, success(packet=%p, deps=%deps)
    ret
}

oir 2 low
// D20 form (b) around a cleanup step that may suspend (async ABI §2.4, second example).
module d20_instruction_triple
scope S action in @job
summary Mjob internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @job(%frame: frame<@job>) -> void [async] summary(Mjob) {
    frame.layout {
        slot 0: str
        slot 1: cleanup-state linear
        slot 2: stable-key
    }
    continuation 0 start saves [0]
    continuation 1 at #7 saves [0] operands [1, 2]
    low.metadata cleanup_metadata(closes=[cleanup_close(source=scope(S), after_defers=^entry, reserve=false,
        active_failure=false, effects=scope_effects(failures=[thrown, program, panic, native], suspends=true,
        cancel=false))], schedules=[cleanup_schedule(close=0)], plans=[cleanup_plan(close=0,
        sources=[scope_inventory])], roots=[], proofs=[])
^entry in S:
    (%fr0: frame<@job>, %x: str) = frame.resume %frame, continuation 0, slots [saved_slot(slot=0, ty=str,
        linear=false)]
    %q: scope<S> = scope.begin S
    %c: cleanup-state = cleanup.begin %q, close 0, effects scope_effects(failures=[thrown, program, panic, native],
        suspends=true, cancel=false)
    %settled: cleanup-state = cleanup.settle.empty %c, schedule 0
    %planned: cleanup-state = cleanup.plan %settled, plan 0
    br ^next(%planned, %fr0)
^next(%c0: cleanup-state, %fr6: frame<@job>) in S:
    cleanup.next %c0 selected ^destroy(%fr6, $state, $selected) done ^finish(%fr6, $state)
^destroy(%fr7: frame<@job>, %c1: cleanup-state, %key: stable-key) in S:
    %fr8: frame<@job> = frame.save %fr7, slots [frame_slot(slot=0, value=%x, mode=borrow)], continuation 1
    [i7] (%c2: cleanup-state, %fs: failure-state) = cleanup.destroy %c1, %key
    (%fr9: frame<@job>, %x1: str) = frame.resume %fr8, continuation 1, slots [saved_slot(slot=0, ty=str,
        linear=false)]
    failure.dispatch %fs none ^next(%c2, %fr9) some ^failed(%fr9, %c2, $failure)
^failed(%fr10: frame<@job>, %c3: cleanup-state, %failure: failure) in S:
    %c4: cleanup-state = cleanup.failure %c3, %failure
    br ^next(%c4, %fr10)
^finish(%fr11: frame<@job>, %c5: cleanup-state) in S:
    (%closed: closed, %fs2: failure-state, %xs: exit-state) = cleanup.finish %c5
    exit.dispatch 0 %closed %fs2 %xs success ^done(%fr11, $closed) failure ^bad(%fr11, $closed, $failure)
^done(%fr12: frame<@job>, %closed1: closed) in S:
    %p: own = own.empty
    %d: deps = deps.of %x
    fut.publish %fr12, success(packet=%p, deps=%d)
    ret
^bad(%fr13: frame<@job>, %closed2: closed, %final: failure) in S:
    fut.publish %fr13, failure(%final)
    ret
}

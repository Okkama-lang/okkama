func @work(%0: frame<@work>) -> void [async] summary(M4) async-creation(M6) async-body(M4) {
    frame.layout {
        slot 0: int
        slot 1: own linear
    }
    continuation 0 start saves [0, 1]
    boundary B0 lexical in S0
    boundary B1 lexical in S0
    ^b0 in S0:
    (%1: frame<@work>, %2: int, %3: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=int), saved_slot(slot=1, ty=own, linear=true)]
    %4: scope<S0> = scope.begin S0
    %5: scope<S0> = own.accept %4, %3
    br ^b1(%2, %5)
    ^b1(%6: int, %7: scope<S0>) in S0:
    %8: own = own.empty
    %9: deps = deps.of %6
    %10: pending = exit.prepare return %6, %8, deps(%9) at B1
    invoke.own scope.end %7, reserve %10, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b2($closed, $pending, %6)
        unwind ^b3($closed, $failure)
    ^b2(%11: closed, %12: pending, %13: int) in S0:
    (%14: int, %15: own, %16: deps) = exit.commit %12, destination caller, result int
    fut.publish %1, success(value=%14, packet=%15, deps=%16)
    ret
    ^b3(%17: closed, %18: failure) in S0:
    fut.publish %1, failure(%18)
    ret
}


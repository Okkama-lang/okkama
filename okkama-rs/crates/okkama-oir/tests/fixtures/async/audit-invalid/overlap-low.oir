    ^b25(%144: failure) in S1:
    [i52] fut.publish %60, failure(%144)
    ret
    ^b26(%145: cleanup-state) in S1:
    cleanup.next %145 selected ^b27($state, $selected) done ^b29($state)
    ^b27(%146: cleanup-state, %147: stable-key) in S1:
    [i53] (%148: cleanup-state, %149: failure-state) = cleanup.destroy %146, %147
    failure.dispatch %149 none ^b26(%148) some ^b28(%148, $failure)
    ^b28(%150: cleanup-state, %151: failure) in S1:
    [i54] %152: cleanup-state = cleanup.failure %150, %151
    br ^b26(%152)
    ^b29(%153: cleanup-state) in S1:
    [i55] (%154: closed, %155: failure-state, %156: exit-state) = cleanup.finish %153
    exit.dispatch 2 %154 %155 %156 failure ^b25($failure)
}

// expect coro-layout-misplaced function:0
// Only an async body of coro/low declares a frame layout (D21): an ordinary function cannot.
module coro_layout_misplaced
scope S action in @f
summary Mf internal contract call_contract(publication=atomic)
func @f() -> void summary(Mf) {
    frame.layout {
        slot 0: int
    }
    continuation 0 start saves [0]
^entry in S:
    ret
}

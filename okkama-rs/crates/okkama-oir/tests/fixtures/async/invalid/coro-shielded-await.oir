oir 2 coro
// expect coro-shielded-await terminator:0:0
// await.shielded is not produced in coro/low.
module coro_shielded_await
scope S action in @f
summary Mf internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @f(%fut: future<int>) -> void [async, cleanup] summary(Mf) {
^entry in S:
    invoke.own await.shielded %fut, result int
        normal ^ok($value, $deps)
        unwind ^bad($failure, $task, $receipt)
^ok(%v: int, %d: deps) in S:
    ret
^bad(%f: failure, %t: task-state, %r: receipt) in S:
    ret
}

oir 2 coro
// expect coro-body-raises terminator:0:2
// An async body raises its failure instead of publishing it.
module d20_await_triple
protocol Services kind services holders [scope, cache, frame, receipt] rules [protocol_rule(transition=settle,
    from=cache, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled))]
scope S action in @main
summary Mmain internal contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @main(%frame: frame<@main>) -> void [async] summary(Mmain) {
    frame.layout {
        slot 0: scope<S> linear
        slot 1: str
        slot 2: future<int>
        slot 3: failure
        slot 4: task-state linear
        slot 5: receipt linear
    }
    continuation 0 start saves [1, 2]
    continuation 1 at ^entry saves [0, 1] operands [2]
    continuation 2 at #9 saves [1] operands [0, 3, 4, 5]
^entry in S:
    (%fr0: frame<@main>, %name: str, %fut: future<int>) = frame.resume %frame, continuation 0, slots [
        saved_slot(slot=1, ty=str, linear=false), saved_slot(slot=2, ty=future<int>, linear=false)]
    %q: scope<S> = scope.begin S
    %fr1: frame<@main> = frame.save %fr0, slots [frame_slot(slot=0, value=%q, mode=consume),
        frame_slot(slot=1, value=%name, mode=borrow)], continuation 1
    invoke.own await %fut, result int
        normal ^ok($value, $deps)
        unwind ^bad($failure, $task, $receipt)
^ok(%v: int, %d: deps) in S:
    (%fr2: frame<@main>, %q1: scope<S>, %name1: str) = frame.resume %fr1, continuation 1, slots [
        saved_slot(slot=0, ty=scope<S>, linear=true), saved_slot(slot=1, ty=str, linear=false)]
    %closed: closed = scope.end %q1, effects scope_effects(failures=[], suspends=false, cancel=false)
    %p: own = own.empty
    fut.publish %fr2, success(packet=%p, deps=%d)
    ret
^bad(%f: failure, %t: task-state, %r: receipt) in S:
    (%fr3: frame<@main>, %q2: scope<S>, %name2: str) = frame.resume %fr1, continuation 1, slots [
        saved_slot(slot=0, ty=scope<S>, linear=true), saved_slot(slot=1, ty=str, linear=false)]
    %fr4: frame<@main> = frame.save %fr3, slots [frame_slot(slot=1, value=%name2, mode=borrow)], continuation 2
    [i9] (%q3: scope<S>, %f1: failure) = await.unwind %q2, %f, %t, %r, protocol Services
    (%fr5: frame<@main>, %name3: str) = frame.resume %fr4, continuation 2, slots [
        saved_slot(slot=1, ty=str, linear=false)]
    %combined: failure = scope.unwind %q3, %f1, effects scope_effects(failures=[thrown, program, panic, native],
        suspends=false, cancel=false)
    raise %combined
}

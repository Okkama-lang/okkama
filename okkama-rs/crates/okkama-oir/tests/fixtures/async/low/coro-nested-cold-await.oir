oir 2 low
// async action inner(n: int) is int { return n; }
// async action outer(n: int) is int { return await inner(n); }
// async main() { await outer(7); }
// A cold Future awaited inside the body of another cold Future: each body brackets its own await.
// Low golden of coro/coro-nested-cold-await.oir (V4): outer and main each settle the duty of the Future
// they created; each keeps the continuations of its own await and await.unwind.
module coro_nested_cold_await
scope S0 action in @inner
scope S1 action in @outer
scope S2 action in @main
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic,
    native, cancelled], suspends=true, publication=atomic)
summary M2 internal parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M3 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic,
    native, cancelled], suspends=true, publication=atomic)
summary M4 internal results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>],
    publication=atomic)
summary M5 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
protocol P0 kind services holders [scope, cache, receipt] rules [protocol_rule(transition=settle, from=cache, to=scope,
    checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled))]

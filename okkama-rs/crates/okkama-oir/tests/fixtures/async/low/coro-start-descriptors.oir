        root_requirement(boundary=terminator(^b3), bindings=[root_binding(value=%4, trace=failure_graph)]),
        root_requirement(boundary=entry(^b3), bindings=[root_binding(value=%4, trace=failure_graph),
        root_binding(value=%5, trace=value(int))]), ], proofs=[])
    boundary B0 lexical in S0
    ^b0 in S0:
    br ^b1(%0)
    ^b1(%1: int) in S0:
    invoke.own obj.new Box { n: %1 }
        normal ^b2($value, %1)
        unwind ^b3($failure, %1)
    ^b2(%2: Box facts(plain(certificate=closed_graph(ty=Box))), %3: int) in S0:
    ret %2
    ^b3(%4: failure, %5: int) in S0:
    raise %4
}

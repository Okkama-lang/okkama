oir 2 low
// Low golden of coro/coro-start-descriptors.oir (V4).
// C-2: continuation 0 restores the receiver, the language arguments, the descriptor and the input
// packet, in order.
// Continuation 0 is unchanged; the closes of run and main settle their duties and deliver (D18).
module coro_start_continuation
entry @main
object Box {
    field n: int
}
scope S0 action in @Box.new
scope S1 action in @Box.get
scope S2 action in @run
scope S3 action in @main
scope S4 action in @noop
summary M0 internal contract call_contract(publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)

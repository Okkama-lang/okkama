oir 2 low
// Low golden of coro/async-caught-throw.oir (V4).
// The body throws; its block unwind catches the throw inside the body, so only the failure after the
// lexical unwind is published (C-2).
// The throw caught inside the body stays; main settles its cache duty at each close and delivers the
// cancellation at its final successful close (D18).
module async_caught_throw
entry @main
enum Stop is Error = (now)
scope S0 action in @work
scope S1 action in @main
summary M0 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary M1 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, cancelled], suspends=true, publication=atomic)

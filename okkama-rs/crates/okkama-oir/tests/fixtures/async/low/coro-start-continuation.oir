oir 2 low
// object Box { n: int }
// async action Box.get(k: int) is int { return n + k; }    (with a dictionary parameter)
// async action run(box: Box, k: int) is int { return await box.get(k); }
// Low golden of coro/coro-start-continuation.oir (V4): continuation 0 is unchanged; the closes of run
// settle the duty of box.get(k).
module coro_start_continuation
object Box {
    field n: int
}
scope S0 action in @noop
scope S1 action in @Box.get
scope S2 action in @run
summary M0 internal contract call_contract(publication=atomic)
summary M1 internal parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary M2 call-boundary parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
summary M3 internal parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary M4 call-boundary parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
protocol P0 kind services holders [scope, cache, receipt] rules [protocol_rule(transition=settle, from=cache, to=scope,
    checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled))]
func @noop() -> void summary(M0) {
    low.metadata cleanup_metadata(closes=[], schedules=[], plans=[], roots=[root_requirement(boundary=terminator(^b0)),
        root_requirement(boundary=entry(^b0)), ], proofs=[])
    ^b0 in S0:
    ret
}

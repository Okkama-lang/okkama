func @Box.new(%0: int) -> Box [ctor Box] abi observation summary(M14) {
    low.metadata cleanup_metadata(closes=[], schedules=[], plans=[], roots=[root_requirement(boundary=terminator(^b0),
        bindings=[root_binding(value=%0, trace=value(int))]), root_requirement(boundary=entry(^b0),
        bindings=[root_binding(value=%0, trace=value(int))]), root_requirement(boundary=terminator(^b1),

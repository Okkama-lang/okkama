oir 2 low
// enum Stop is Error = (now)
// action boom() is int { throw Stop.now; }
// async action work() is int { return boom(); }
// async main() { let x = await work(); }
// The body fails in a call: it publishes the failure, and the await rethrows it into main.
// Low golden of coro/async-await-failure.oir (V4): the sync close of boom keeps its synchronous cleanup;
// main settles its cache duty at both closes.
module async_await_failure
enum Stop is Error = (now)
scope S0 action in @boom
scope S1 action in @work
scope S2 action in @main
summary M0 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown], publication=atomic)
summary M1 internal results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>],
    publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M3 internal results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>],
    publication=atomic)
summary M4 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
protocol P0 kind services holders [scope, cache, receipt] rules [protocol_rule(transition=settle, from=cache, to=scope,
    checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled))]

    [i29] (%68: cleanup-state, %69: failure-state) = cleanup.destroy %66, %67
    failure.dispatch %69 none ^b12(%68) some ^b14(%68, $failure)
    ^b14(%70: cleanup-state, %71: failure) in S2:
    [i30] %72: cleanup-state = cleanup.failure %70, %71
    br ^b12(%72)
    ^b15(%73: cleanup-state) in S2:
    [i31] (%74: closed, %75: failure-state, %76: exit-state) = cleanup.finish %73
    exit.dispatch 1 %74 %75 %76 failure ^b11($failure)
}

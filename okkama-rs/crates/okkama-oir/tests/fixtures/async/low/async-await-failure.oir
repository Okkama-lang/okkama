oir 2 low
// Low golden of coro/async-await-failure.oir (V4).
// failure.rethrown-at-every-await: the body raises its failure and publishes it; both awaits rethrow
// it, the first inside a try whose catch arm resumes main.
// Each close of main settles the cache duty that reaches it; the catch-miss close fails, and only the final
// successful close delivers the cancellation (D18).
module async_await_failure
entry @main
enum Broken is Error = (broken)
scope S0 action in @fail
scope S1 action in @main
scope S2 try in @main parent S1
scope S3 catch in @main parent S1
summary M0 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary M1 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary M3 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M4 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, cancelled], suspends=true, publication=atomic)
summary M5 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M6 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary M7 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary M8 internal contract call_contract(publication=atomic)
summary M9 observation results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)

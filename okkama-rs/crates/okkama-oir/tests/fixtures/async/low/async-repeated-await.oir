oir 2 low
// async action work(n: int) is int { return n; }
// async main() is int { let f = work(7); let a = await f; let b = await f; return a + b; }
// The Future is the operand of both awaits; the first result is saved across the second await.
// Low golden of coro/async-repeated-await.oir (V4): the three closes settle the duty version that reaches
// them; the close continuations go and the two await.unwind continuations become 3 and 4.
module async_repeated_await
scope S0 action in @work
scope S1 action in @main
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic,
    native, cancelled], suspends=true, publication=atomic)
summary M2 internal results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>],
    publication=atomic)
summary M3 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
protocol P0 kind services holders [scope, cache, receipt] rules [protocol_rule(transition=settle, from=cache, to=scope,
    checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled))]

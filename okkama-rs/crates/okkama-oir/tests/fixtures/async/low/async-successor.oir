    binding b0 "updated": ^app.Counter in S2
    binding b1 "other": app.Counter in S2
    boundary B0 lexical in S2
    key k0: key = service_of(value=%9, kind=cache)
    dependency d0: dependency = key(k0)
    dependency d1: dependency = from_ssa(%8)
    dependency d2: dependency = union([d0, d1])
    dependency d3: dependency = from_ssa(%23)
    ^b0 in S2:
    [i0] %1: frame<@main> = frame.resume %0, continuation 0
    [i1] %2: scope<S2> = scope.begin S2
    br ^b1(%2)
    ^b1(%3: scope<S2>) in S2:
    [i2] %4: int = const 1
    invoke.own call @app.Counter.new#0(%4)
        normal ^b2($value, %3)
        unwind ^b3($failure, %3)
    ^b2(%5: app.Counter facts(plain(certificate=closed_graph(ty=app.Counter))), %6: scope<S2>) in S2:

summary M0 call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(failures=[cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary M3 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
summary M4 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(failures=[cancelled], suspends=true, publication=atomic)
summary M5 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
summary M6 call-boundary parameters [parameter_effect(convention=borrow,

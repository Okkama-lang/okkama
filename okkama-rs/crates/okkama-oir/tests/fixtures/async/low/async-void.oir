oir 2 low
// async action log() { }
// async main() { await log(); }
// A void body publishes only its packet and deps; the await of a void Future has no value.
// Low golden of coro/async-void.oir (V4): main settles the duty of the void Future at both closes.
module async_void
scope S0 action in @log
scope S1 action in @main
summary M0 internal results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>],
    publication=atomic)
summary M1 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
summary M2 internal results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>],
    publication=atomic)
summary M3 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
protocol P0 kind services holders [scope, cache, receipt] rules [protocol_rule(transition=settle, from=cache, to=scope,
    checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled))]

oir 2 own
// #759: a Future created and bound in a `for` body: `for 1..=3 -> i { let f = Job(n: i).run(); }`. The body
// scope S2 owns the duty and settles it at each iteration's close; the back edge carries no token, so the unwind
// close of a failed `Job(n: i)` in a later iteration settles nothing. Own's output of the program (OIR-2 pipeline).
module app v1.0.0
requires core, async
entry @main

object app.Job {
    field n: int
}
scope S0 action in @app.Job.run#0
scope S1 action in @main

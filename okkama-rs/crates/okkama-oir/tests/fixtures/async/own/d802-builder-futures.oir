oir 2 own
// #802: own's output for a literal of eight fresh Futures, built through a builder:
//   async main() is int { let fs = [Child(n: 1).run(), …, Child(n: 8).run()]; (await fs[0]) + (await fs[7]); }
// Each push stores its Future: a scope.split before it names the Future, and the journal carries its entry. The
// schedule of S1 ends with `dynamic`: a failed store split leaves the entry to the owner's dynamic step.
module app v1.0.0
requires core, async
entry @main

object app.Child {
    field n: int
}
scope S0 action in @app.Child.run#0
scope S1 action in @main
scope S2 action in @app.Child.new#0

oir 2 own
// #851: a Future whose outcome has a destroy, created and awaited in a `for` body: `for ["a", "b"] -> name {
// let size = (await Now().res(name)).label().length(); }`, `Res` with a destroy that may panic. The body scope
// settles the duty and its closes declare the destroy's failures; main's scope settles nothing, so its close
// releases no outcome. Own's output of the program (OIR-2 pipeline).
module app v1.0.0
requires core, async
entry @main

object app.Res {
    field name: str
    destroy @app.Res.destroy
}

object app.Now {
}

    [i59] fut.publish %82, failure(%159)
    ret
    ^b38(%160: cleanup-state) in S4:
    cleanup.next %160 selected ^b39($state, $selected) done ^b41($state)
    ^b39(%161: cleanup-state, %162: stable-key) in S4:
    [i60] (%163: cleanup-state, %164: failure-state) = cleanup.destroy %161, %162
    failure.dispatch %164 none ^b38(%163) some ^b40(%163, $failure)
    ^b40(%165: cleanup-state, %166: failure) in S4:
    [i61] %167: cleanup-state = cleanup.failure %165, %166
    br ^b38(%167)
    ^b41(%168: cleanup-state) in S4:
    [i62] (%169: closed, %170: failure-state, %171: exit-state) = cleanup.finish %168
    exit.dispatch 4 %169 %170 %171 failure ^b37($failure)
}

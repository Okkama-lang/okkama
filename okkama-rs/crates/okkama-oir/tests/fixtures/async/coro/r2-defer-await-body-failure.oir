func @risky() -> void abi observation summary(M15) {
    ^b0 in S5:
    br ^b1
    ^b1 in S5:
    %0: Stop facts(plain(certificate=scalar)) = enum.case Stop, case 0
    br ^b2(%0)
    ^b2(%1: Stop facts(plain(certificate=scalar))) in S5 unwind ^b3:
    throw %1
    ^b3(%2: failure) in S5:
    raise %2
}


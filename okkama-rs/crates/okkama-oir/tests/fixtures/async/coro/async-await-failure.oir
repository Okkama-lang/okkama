oir 2 coro
// enum Stop is Error = (now)
// action boom() is int { throw Stop.now; }
// async action work() is int { return boom(); }
// async main() { let x = await work(); }
// The body fails in a call: it publishes the failure, and the await rethrows it into main.
// Coro golden of own/async-await-failure.oir (V3): the body publishes the failure of its call.
module async_await_failure
enum Stop is Error = (now)
protocol Services kind services holders [scope, cache, receipt] rules [protocol_rule(transition=settle, from=cache,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled))]
scope SB action in @boom
scope SW action in @work
scope SM action in @main
summary Mboom call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown], publication=atomic)
summary Mwc internal results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary Mwb call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary Mmc internal results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary Mmb call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @boom(%inputs: own) -> (int, own) abi explicit(input_packet=0, output_packet=1) summary(Mboom) {
^entry in SB:
    %q0: scope<SB> = scope.begin SB
    %q1: scope<SB> = own.accept %q0, %inputs
    %stop: Stop facts(plain(certificate=scalar)) = enum.case Stop, case 0
    br ^throw(%stop, %q1)
^throw(%e: Stop facts(plain(certificate=scalar)), %q2: scope<SB>) in SB unwind ^thrown(%q2):
    throw %e
^thrown(%q3: scope<SB>, %f: failure) in SB:
    %combined: failure = scope.unwind %q3, %f, effects scope_effects(failures=[thrown], suspends=false,
        cancel=false)
    raise %combined
}
func @work(%frame: frame<@work>) -> void [async] summary(Mwb) async-creation(Mwc) async-body(Mwb) {
    frame.layout {
        slot 0: own linear
    }
    continuation 0 start saves [0]
    boundary B0 call in SW
^entry in SW:
    (%fr0: frame<@work>, %inputs: own) = frame.resume %frame, continuation 0, slots [saved_slot(slot=0, ty=own,
        linear=true)]
    %q0: scope<SW> = scope.begin SW
    %q1: scope<SW> = own.accept %q0, %inputs
    %e: own = own.empty
    invoke.own call @boom(; %e)
        normal ^ok($value, $packet, $deps, %q1)
        unwind ^failed($failure, %q1)
^ok(%v: int, %vp: own, %vd: deps, %q2: scope<SW>) in SW:
    %q3: scope<SW> = own.admit %q2, %vp
    %empty: own = own.empty
    %d: deps = deps.of %v
    %pending: pending = exit.prepare return %v, %empty, deps(%d) at B0
    (%closed: closed, %reserved: pending) = scope.end %q3, reserve %pending, effects scope_effects(failures=[],
        suspends=false, cancel=false)
    (%r: int, %p: own, %rd: deps) = exit.commit %reserved, destination caller, result int
    fut.publish %fr0, success(value=%r, packet=%p, deps=%rd)
    ret
^failed(%failure: failure, %q4: scope<SW>) in SW:
    %combined: failure = scope.unwind %q4, %failure, effects scope_effects(failures=[thrown], suspends=false,
        cancel=false)
    fut.publish %fr0, failure(%combined)
    ret
}
func @main(%frame: frame<@main>) -> void [async] summary(Mmb) async-creation(Mmc) async-body(Mmb) {
    frame.layout {
        slot 0: own linear
        slot 1: scope<SM> linear
        slot 2: cache-state linear
        slot 3: future<int>
        slot 4: pending linear
        slot 5: failure
        slot 6: task-state linear
        slot 7: receipt linear
    }
    continuation 0 start saves [0]
    continuation 1 at ^entry saves [1, 2] operands [3]
    continuation 2 at ^ok saves [] operands [1, 4, 2]
    continuation 3 at #90 saves [2] operands [1, 5, 6, 7]
    continuation 4 at #91 saves [] operands [1, 5, 2]
    service.schedule Sched0 owner SM, protocol Services, duties [%c3]
    service.schedule Sched1 owner SM, protocol Services, duties [%c1]
    boundary B0 call in SM
    key k0: key = service_of(value=%f, kind=cache)
    dependency d0: dependency = key(k0)
    selection s0: selection = union([])
^entry in SM:
    (%fr0: frame<@main>, %inputs: own) = frame.resume %frame, continuation 0, slots [saved_slot(slot=0, ty=own,
        linear=true)]
    %q0: scope<SM> = scope.begin SM
    %q1: scope<SM> = own.accept %q0, %inputs
    %e0: own = own.empty
    (%l: own, %r: own, %external: deps) = own.split %e0, selection(0)
    %offered: own = own.join [%l, %r]
    (%f: future<int> facts(managed(deps=d0)), %c: cache-state,
        %q2: scope<SM>) = fut.new %offered, %external, %q1, environment deferred(
        function=@work, arguments=[], descriptors=[]), result int, owner SM
    %fr1: frame<@main> = frame.save %fr0, slots [frame_slot(slot=1, value=%q2, mode=consume), frame_slot(slot=2,
        value=%c, mode=consume)], continuation 1
    invoke.own await %f, result int
        normal ^ok_resume($value, $deps)
        unwind ^bad_resume($failure, $task, $receipt)
^ok(%x: int, %xd: deps, %q3: scope<SM>) in SM:
    %e: own = own.empty
    %pending: pending = exit.prepare return packet %e select s0 at B0
    %fr3: frame<@main> = frame.save %fr2, continuation 2
    invoke.own scope.end %q3, reserve %pending, effects scope_effects(failures=[thrown, program, panic, native],
        suspends=true, cancel=false)
        normal ^done($closed, $pending)
        unwind ^close_failed($closed, $failure)
^done(%closed: closed, %reserved: pending) in SM:
    %fr4: frame<@main> = frame.resume %fr3, continuation 2
    (%p: own, %pd: deps) = exit.commit %reserved, destination caller
    fut.publish %fr4, success(packet=%p, deps=%pd)
    ret
^close_failed(%closed2: closed, %close_failure: failure) in SM:
    %fr5: frame<@main> = frame.resume %fr3, continuation 2
    fut.publish %fr5, failure(%close_failure)
    ret
^bad(%failure: failure, %task: task-state, %receipt: receipt, %q4: scope<SM>) in SM:
    %fr7: frame<@main> = frame.save %fr6, slots [frame_slot(slot=2, value=%c2, mode=consume)], continuation 3
    [i90] (%q5: scope<SM>, %f1: failure) = await.unwind %q4, %failure, %task, %receipt, protocol Services
    (%fr8: frame<@main>, %c3: cache-state) = frame.resume %fr7, continuation 3, slots [saved_slot(slot=2,
        ty=cache-state, linear=true)]
    %fr9: frame<@main> = frame.save %fr8, continuation 4
    [i91] %combined: failure = scope.unwind %q5, %f1, effects scope_effects(failures=[thrown, program, panic, native],
        suspends=true, cancel=false)
    %fr10: frame<@main> = frame.resume %fr9, continuation 4
    fut.publish %fr10, failure(%combined)
    ret
^ok_resume(%x0: int, %xd0: deps) in SM:
    (%fr2: frame<@main>, %q2r: scope<SM>, %c1: cache-state) = frame.resume %fr1, continuation 1, slots [
        saved_slot(slot=1, ty=scope<SM>, linear=true), saved_slot(slot=2, ty=cache-state, linear=true)]
    br ^ok(%x0, %xd0, %q2r)
^bad_resume(%failure0: failure, %task0: task-state, %receipt0: receipt) in SM:
    (%fr6: frame<@main>, %q2b: scope<SM>, %c2: cache-state) = frame.resume %fr1, continuation 1, slots [
        saved_slot(slot=1, ty=scope<SM>, linear=true), saved_slot(slot=2, ty=cache-state, linear=true)]
    br ^bad(%failure0, %task0, %receipt0, %q2b)
}

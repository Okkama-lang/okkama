func @fail(%0: frame<@fail>) -> void [async] summary(M4) async-creation(M6) async-body(M4) {
    frame.layout {
        slot 0: own linear
    }
    continuation 0 start saves [0]
    ^b0 in S0:
    (%1: frame<@fail>, %2: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=own, linear=true)]
    %3: scope<S0> = scope.begin S0
    %4: scope<S0> = own.accept %3, %2
    br ^b1(%4)
    ^b1(%5: scope<S0>) in S0:
    %6: Broken facts(plain(certificate=scalar)) = enum.case Broken, case 0
    br ^b2(%5, %6)
    ^b2(%7: scope<S0>, %8: Broken facts(plain(certificate=scalar))) in S0 unwind ^b3(%7):
    throw %8
    ^b3(%9: scope<S0>, %10: failure) in S0:
    %11: failure = scope.unwind %9, %10, effects scope_effects(failures=[], suspends=false, cancel=false)
    fut.publish %1, failure(%11)
    ret
}


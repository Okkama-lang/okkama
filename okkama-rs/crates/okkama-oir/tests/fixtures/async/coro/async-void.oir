func @note(%0: frame<@note>) -> void [async] summary(M4) async-creation(M6) async-body(M4) {
    frame.layout {
        slot 0: str
        slot 1: own linear
    }
    continuation 0 start saves [0, 1]
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0:
    (%1: frame<@note>, %2: str, %3: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=str), saved_slot(slot=1, ty=own, linear=true)]
    %4: scope<S0> = scope.begin S0
    %5: scope<S0> = own.accept %4, %3
    br ^b1(%2, %5)
    ^b1(%6: str, %7: scope<S0>) in S0:
    %8: int = str.len %6
    %9: own = own.empty
    %10: pending = exit.prepare return packet %9 select s0 at B0
    invoke.own scope.end %7, reserve %10, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b2($closed, $pending)
        unwind ^b3($closed, $failure)
    ^b2(%11: closed, %12: pending) in S0:
    (%13: own, %14: deps) = exit.commit %12, destination caller
    fut.publish %1, success(packet=%13, deps=%14)
    ret
    ^b3(%15: closed, %16: failure) in S0:
    fut.publish %1, failure(%16)
    ret
}


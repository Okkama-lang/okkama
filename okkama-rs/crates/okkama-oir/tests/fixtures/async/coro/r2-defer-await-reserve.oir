    %13: frame<@closer> = frame.save %1, slots [frame_slot(slot=1, value=%12, mode=consume), frame_slot(slot=2, value=%11, mode=consume), frame_slot(slot=3, value=%6, mode=borrow)], continuation 1
    invoke.own await %10

    ^b1(%14: deps, %15: scope<S3>) in S3:
    %16: closed = scope.end %15, effects scope_effects(failures=[], suspends=false, cancel=false)
    %17: own = own.empty
    fut.publish %29, success(packet=%17, deps=%32)
    ret
    ^b2(%18: failure, %19: task-state, %20: receipt, %21: scope<S3>) in S3:
    %22: frame<@closer> = frame.save %36, slots [frame_slot(slot=2, value=%38, mode=consume)], continuation 2
    [i14] (%23: scope<S3>, %24: failure) = await.unwind %21, %18, %19, %20, protocol P0
    (%25: frame<@closer>, %26: cache-state) = frame.resume %22, continuation 2, slots [saved_slot(slot=2, ty=cache-state, linear=true)]
    %27: failure = scope.unwind %23, %24, effects scope_effects(failures=[], suspends=false, cancel=false)
    fut.publish %25, failure(%27)

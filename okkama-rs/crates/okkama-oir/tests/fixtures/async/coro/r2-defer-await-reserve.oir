func @task(%0: frame<@task>) -> void [async] summary(M7) async-creation(M11) async-body(M7) {
    frame.layout {
        slot 0: own linear
    }
    continuation 0 start saves [0]
    boundary B0 lexical in S2
    boundary B1 lexical in S2
    selection s0: selection = union([])
    ^b0 in S2:
    (%1: frame<@task>, %2: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=own, linear=true)]
    %3: scope<S2> = scope.begin S2
    %4: scope<S2> = own.accept %3, %2
    br ^b1(%4)
    ^b1(%5: scope<S2>) in S2:
    %6: own = own.empty
    %7: pending = exit.prepare return packet %6 select s0 at B1
    invoke.own scope.end %5, reserve %7, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b2($closed, $pending)
        unwind ^b3($closed, $failure)
    ^b2(%8: closed, %9: pending) in S2:
    (%10: own, %11: deps) = exit.commit %9, destination caller
    fut.publish %1, success(packet=%10, deps=%11)
    ret
    ^b3(%12: closed, %13: failure) in S2:
    fut.publish %1, failure(%13)
    ret
}


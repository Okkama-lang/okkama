    (%36: frame<@closer>, %37: scope<S3>, %38: cache-state, %39: deps) = frame.resume %13, continuation 1, slots [saved_slot(slot=1, ty=scope<S3>, linear=true), saved_slot(slot=2, ty=cache-state, linear=true), saved_slot(slot=3, ty=deps)]
    br ^b2(%33, %34, %35, %37)
}

func @risky() -> void abi observation summary(M5) {
    ^b0 in S5:
    %0: Stop facts(plain(certificate=scalar)) = enum.case Stop, case 0
    br ^b1(%0)
    ^b1(%1: Stop facts(plain(certificate=scalar))) in S5 unwind ^b2:
    throw %1
    ^b2(%2: failure) in S5:
    raise %2
}


    ^b3(%25: failure, %26: task-state, %27: receipt, %28: scope<S2>) in S2:
    %29: frame<@run> = frame.save %52, slots [frame_slot(slot=6, value=%56, mode=consume)], continuation 2
    [i12] (%30: scope<S2>, %31: failure) = await.unwind %28, %25, %26, %27, protocol P0
    (%32: frame<@run>, %33: cache-state) = frame.resume %29, continuation 2, slots [saved_slot(slot=6, ty=cache-state, linear=true)]
    %34: failure = scope.unwind %30, %31, effects scope_effects(failures=[], suspends=false, cancel=false)

func @Box.new(%0: int) -> Box [ctor Box] abi observation summary(M14) {
    boundary B0 lexical in S0
    ^b0 in S0:
    br ^b1(%0)
    ^b1(%1: int) in S0:
    invoke.own obj.new Box { n: %1 }
        normal ^b2($value, %1)
        unwind ^b3($failure, %1)
    ^b2(%2: Box facts(plain(certificate=closed_graph(ty=Box))), %3: int) in S0:
    ret %2
    ^b3(%4: failure, %5: int) in S0:
    raise %4
}

func @Box.get(%0: frame<@Box.get>) -> void [method Box, async] summary(M7) async-creation(M10) async-body(M7) {
    frame.layout {
        slot 0: Box
        slot 1: int
        slot 2: own linear

    [i13] (%29: scope<S3>, %30: failure) = await.unwind %27, %24, %25, %26, protocol P0
    (%31: frame<@main>, %32: cache-state) = frame.resume %28, continuation 2, slots [saved_slot(slot=3, ty=cache-state, linear=true)]
    %33: failure = scope.unwind %29, %30, effects scope_effects(failures=[], suspends=false, cancel=false)

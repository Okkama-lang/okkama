    %15: deps = deps.of %12
    %16: frame<@run> = frame.save %1, slots [frame_slot(slot=3, value=%11, mode=borrow), frame_slot(slot=4, value=%14, mode=consume), frame_slot(slot=5, value=%15, mode=borrow), frame_slot(slot=6, value=%13, mode=consume)], continuation 1
    invoke.own await %12, result int
        normal ^b6($value, $deps)
        unwind ^b7($failure, $task, $receipt)
    ^b2(%17: int, %18: deps, %19: future<int> facts(managed(deps=d3)), %20: scope<S2>, %21: deps) in S2:
    %22: own = own.empty

    %5: scope<S1> = scope.begin S1
    %6: scope<S1> = own.accept %5, %4
    br ^b1(%2, %3, %6)
    ^b1(%7: Box facts(plain(certificate=closed_graph(ty=Box))), %8: int, %9: scope<S1>) in S1:
    %10: int = obj.get %7, n
    %11: int = int.add %10, %8
    %12: own = own.empty
    %13: deps = deps.of %11
    %14: pending = exit.prepare return %11, %12, deps(%13) at B1
    invoke.own scope.end %9, reserve %14, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b2($closed, $pending, %11)
        unwind ^b3($closed, $failure)
    ^b2(%15: closed, %16: pending, %17: int) in S1:
    (%18: int, %19: own, %20: deps) = exit.commit %16, destination caller, result int
    fut.publish %1, success(value=%18, packet=%19, deps=%20)
    ret
    ^b3(%21: closed, %22: failure) in S1:
    fut.publish %1, failure(%22)

func @Box.new(%0: int) -> Box [ctor Box] abi observation summary(M14) {
    boundary B0 lexical in S0
    ^b0 in S0:
    br ^b1(%0)
    ^b1(%1: int) in S0:
    invoke.own obj.new Box { n: %1 }
        normal ^b2($value, %1)
        unwind ^b3($failure, %1)
    ^b2(%2: Box facts(plain(certificate=closed_graph(ty=Box))), %3: int) in S0:
    ret %2
    ^b3(%4: failure, %5: int) in S0:
    raise %4
}

func @Box.get(%0: frame<@Box.get>) -> void [method Box, async] summary(M7) async-creation(M10) async-body(M7) {
    frame.layout {
        slot 0: Box
        slot 1: int
        slot 2: own linear
    }
    continuation 0 start saves [0, 1, 2]
    boundary B0 lexical in S1
    boundary B1 lexical in S1
    ^b0 in S1:
    (%1: frame<@Box.get>, %2: Box facts(plain(certificate=closed_graph(ty=Box))), %3: int, %4: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=Box), saved_slot(slot=1, ty=int), saved_slot(slot=2, ty=own, linear=true)]
    %5: scope<S1> = scope.begin S1
    %6: scope<S1> = own.accept %5, %4
    br ^b1(%2, %3, %6)
    ^b1(%7: Box facts(plain(certificate=closed_graph(ty=Box))), %8: int, %9: scope<S1>) in S1:
    %10: int = obj.get %7, n
    %11: int = int.add %10, %8
    %12: own = own.empty
    %13: deps = deps.of %11
    %14: pending = exit.prepare return %11, %12, deps(%13) at B1
    invoke.own scope.end %9, reserve %14, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b2($closed, $pending)
        unwind ^b3($closed, $failure)
    ^b2(%15: closed, %16: pending) in S1:
    (%17: int, %18: own, %19: deps) = exit.commit %16, destination caller, result int
    fut.publish %1, success(value=%17, packet=%18, deps=%19)
    ret
    ^b3(%20: closed, %21: failure) in S1:
    fut.publish %1, failure(%21)
    ret
}

func @run(%0: frame<@run>) -> void [async] summary(M8) async-creation(M11) async-body(M8) {
    frame.layout {

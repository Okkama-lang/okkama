    %13: deps = deps.of %10
    %14: frame<@main> = frame.save %1, slots [frame_slot(slot=0, value=%9, mode=borrow), frame_slot(slot=1, value=%12, mode=consume), frame_slot(slot=2, value=%13, mode=borrow), frame_slot(slot=3, value=%11, mode=consume)], continuation 1
    invoke.own await %10, result int

// Coro golden of src/own/tests/async-goldens/async-caught-throw.oir.
// The body throws; its block unwind catches the throw inside the body, so only the failure after the
// lexical unwind is published (C-2).
module async_caught_throw
entry @main

enum Stop is Error = (now)
scope S0 action in @work
scope S1 action in @main
summary M0 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M1 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M3 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M4 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, cancelled], suspends=true, publication=atomic)
summary M5 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M6 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M7 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M8 internal contract call_contract(publication=atomic)
summary M9 observation results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root] rules [protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running))]

func @work(%0: frame<@work>) -> void [async] summary(M4) async-creation(M6) async-body(M4) {
    frame.layout {
        slot 0: own linear
    }
    continuation 0 start saves [0]
    ^b0 in S0:
    (%1: frame<@work>, %2: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=own, linear=true)]
    %3: scope<S0> = scope.begin S0
    %4: scope<S0> = own.accept %3, %2
    br ^b1(%4)
    ^b1(%5: scope<S0>) in S0:
    %6: Stop facts(plain(certificate=scalar)) = enum.case Stop, case 0
    br ^b2(%5, %6)
    ^b2(%7: scope<S0>, %8: Stop facts(plain(certificate=scalar))) in S0 unwind ^b3(%7):
    throw %8
    ^b3(%9: scope<S0>, %10: failure) in S0:
    %11: failure = scope.unwind %9, %10, effects scope_effects(failures=[], suspends=false, cancel=false)
    fut.publish %1, failure(%11)
    ret
}

func @main(%0: frame<@main>) -> void [entry, async] abi observation summary(M9) async-creation(M7) async-body(M9) {
    frame.layout {
        slot 0: scope<S1> linear
        slot 1: deps
        slot 2: cache-state linear
        slot 3: future<int>
        slot 4: failure
        slot 5: task-state linear
        slot 6: receipt linear
    }
    continuation 0 start saves []
    continuation 1 at ^b1 saves [0, 1, 2] operands [3]
    continuation 2 at #10 saves [2] operands [0, 4, 5, 6]
    service.schedule Schedule0 owner S1, protocol P0, duties [%28]
    service.schedule Schedule0#1 owner S1, protocol P0, duties [%40]
    binding b0 "x": int in S1
    boundary B0 lexical in S1
    key k0: key = service_of(value=%9, kind=cache)
    dependency d0: dependency = key(k0)
    dependency d1: dependency = from_ssa(%18)
    selection s0: selection = union([])
    ^b0 in S1:
    %1: frame<@main> = frame.resume %0, continuation 0
    %2: scope<S1> = scope.begin S1
    br ^b1(%2)
    ^b1(%3: scope<S1>) in S1:
    %4: own = own.empty
    (%5: own, %6: own, %7: deps) = own.split %4, s0
    %8: own = own.join [%5, %6]
    (%9: future<int> facts(managed(deps=d0)), %10: cache-state, %11: scope<S1>) = fut.new %8, %7, %3, environment deferred(function=@work), result int, owner S1
    %12: deps = deps.of %9
    %13: frame<@main> = frame.save %1, slots [frame_slot(slot=0, value=%11, mode=consume), frame_slot(slot=1, value=%12, mode=borrow), frame_slot(slot=2, value=%10, mode=consume)], continuation 1
    invoke.own await %9, result int
        normal ^b6($value, $deps)
        unwind ^b7($failure, $task, $receipt)
    ^b2(%14: int, %15: deps, %16: future<int> facts(managed(deps=d1)), %17: scope<S1>, %18: deps) in S1:
    %19: deps = deps.of %14
    invoke.own scope.end %17, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b4($closed, %14)
        unwind ^b5($closed, $failure)
    ^b3(%20: failure, %21: task-state, %22: receipt, %23: scope<S1>) in S1:
    %24: frame<@main> = frame.save %44, slots [frame_slot(slot=2, value=%47, mode=consume)], continuation 2
    [i10] (%25: scope<S1>, %26: failure) = await.unwind %23, %20, %21, %22, protocol P0
    (%27: frame<@main>, %28: cache-state) = frame.resume %24, continuation 2, slots [saved_slot(slot=2, ty=cache-state, linear=true)]
    %29: failure = scope.unwind %25, %26, effects scope_effects(failures=[], suspends=false, cancel=false)
    fut.publish %27, failure(%29)
    ret
    ^b4(%30: closed, %31: int) in S1:
    %32: own = own.empty
    fut.publish %37, success(value=%31, packet=%32, deps=%19)
    ret
    ^b5(%33: closed, %34: failure) in S1:
    fut.publish %37, failure(%34)
    ret
    ^b6(%35: int, %36: deps) in S1:
    (%37: frame<@main>, %38: scope<S1>, %39: deps, %40: cache-state) = frame.resume %13, continuation 1, slots [saved_slot(slot=0, ty=scope<S1>, linear=true), saved_slot(slot=1, ty=deps), saved_slot(slot=2, ty=cache-state, linear=true)]
    br ^b2(%35, %36, %9, %38, %39)
    ^b7(%41: failure, %42: task-state, %43: receipt) in S1:
    (%44: frame<@main>, %45: scope<S1>, %46: deps, %47: cache-state) = frame.resume %13, continuation 1, slots [saved_slot(slot=0, ty=scope<S1>, linear=true), saved_slot(slot=1, ty=deps), saved_slot(slot=2, ty=cache-state, linear=true)]
    br ^b3(%41, %42, %43, %45)
}

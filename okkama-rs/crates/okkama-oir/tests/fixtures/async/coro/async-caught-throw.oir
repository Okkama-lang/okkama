oir 2 coro
module async_caught_throw
entry @main

enum Stop is Error = (now)
scope S0 action in @work
scope S1 action in @main
summary M0 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M1 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M3 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M4 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, cancelled], suspends=true, publication=atomic)
summary M5 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M6 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M7 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary M8 internal contract call_contract(publication=atomic)
summary M9 observation results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=settle, from=frame, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope, to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary], normal=protocol_poststate(holder=pending_exit, state=open))]

func @work(%0: frame<@work>) -> void [async] summary(M4) async-creation(M6) async-body(M4) {
    frame.layout {
        slot 0: own linear
    }
    continuation 0 start saves [0]
    ^b0 in S0:
    (%1: frame<@work>, %2: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=own, linear=true)]
    %3: scope<S0> = scope.begin S0
    %4: scope<S0> = own.accept %3, %2
    br ^b1(%4)
    ^b1(%5: scope<S0>) in S0:
    %6: Stop facts(plain(certificate=scalar)) = enum.case Stop, case 0
    br ^b2(%5, %6)
    ^b2(%7: scope<S0>, %8: Stop facts(plain(certificate=scalar))) in S0 unwind ^b3(%7):
    throw %8
    ^b3(%9: scope<S0>, %10: failure) in S0:
    %11: failure = scope.unwind %9, %10, effects scope_effects(failures=[], suspends=false, cancel=false)
    fut.publish %1, failure(%11)
    ret
}

func @main(%0: frame<@main>) -> void [entry, async] abi observation summary(M9) async-creation(M7) async-body(M9) {
    frame.layout {
        slot 0: deps
        slot 1: scope<S1> linear
        slot 2: deps
        slot 3: cache-state linear
        slot 4: future<int>
        slot 5: failure
        slot 6: task-state linear
        slot 7: receipt linear
    }
    continuation 0 start saves []
    continuation 1 at ^b1 saves [0, 1, 2, 3] operands [4]
    continuation 2 at #9 saves [3] operands [1, 5, 6, 7]
    service.schedule Schedule0 owner S1, protocol P0, duties [%25]
    service.schedule Schedule0#1 owner S1, protocol P0, duties [%38]
    binding b0 "x": int in S1
    boundary B0 lexical in S1
    key k0: key = service_of(value=%6, kind=cache)
    dependency d0: dependency = key(k0)
    dependency d1: dependency = from_ssa(%5)
    dependency d2: dependency = union([d0, d1])
    dependency d3: dependency = from_ssa(%15)
    ^b0 in S1:
    %1: frame<@main> = frame.resume %0, continuation 0
    %2: scope<S1> = scope.begin S1
    br ^b1(%2)
    ^b1(%3: scope<S1>) in S1:
    %4: own = own.empty
    %5: deps = deps.join
    (%6: future<int> facts(managed(deps=d2)), %7: cache-state, %8: scope<S1>) = fut.new %4, %5, %3, environment deferred(function=@work), result int, owner S1
    %9: deps = deps.of %6
    %10: frame<@main> = frame.save %1, slots [frame_slot(slot=0, value=%5, mode=borrow), frame_slot(slot=1, value=%8, mode=consume), frame_slot(slot=2, value=%9, mode=borrow), frame_slot(slot=3, value=%7, mode=consume)], continuation 1
    invoke.own await %6, result int
        normal ^b6($value, $deps)
        unwind ^b7($failure, $task, $receipt)
    ^b2(%11: int, %12: deps, %13: future<int> facts(managed(deps=d3)), %14: scope<S1>, %15: deps) in S1:
    %16: deps = deps.of %11
    invoke.own scope.end %14, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b4($closed, %11)
        unwind ^b5($closed, $failure)
    ^b3(%17: failure, %18: task-state, %19: receipt, %20: scope<S1>) in S1:
    %21: frame<@main> = frame.save %42, slots [frame_slot(slot=3, value=%46, mode=consume)], continuation 2
    [i9] (%22: scope<S1>, %23: failure) = await.unwind %20, %17, %18, %19, protocol P0
    (%24: frame<@main>, %25: cache-state) = frame.resume %21, continuation 2, slots [saved_slot(slot=3, ty=cache-state, linear=true)]
    %26: failure = scope.unwind %22, %23, effects scope_effects(failures=[], suspends=false, cancel=false)
    fut.publish %24, failure(%26)
    ret
    ^b4(%27: closed, %28: int) in S1:
    %29: own = own.empty
    fut.publish %34, success(value=%28, packet=%29, deps=%16)
    ret
    ^b5(%30: closed, %31: failure) in S1:
    fut.publish %34, failure(%31)
    ret
    ^b6(%32: int, %33: deps) in S1:
    (%34: frame<@main>, %35: deps, %36: scope<S1>, %37: deps, %38: cache-state) = frame.resume %10, continuation 1, slots [saved_slot(slot=0, ty=deps), saved_slot(slot=1, ty=scope<S1>, linear=true), saved_slot(slot=2, ty=deps), saved_slot(slot=3, ty=cache-state, linear=true)]
    br ^b2(%32, %33, %6, %36, %37)
    ^b7(%39: failure, %40: task-state, %41: receipt) in S1:
    (%42: frame<@main>, %43: deps, %44: scope<S1>, %45: deps, %46: cache-state) = frame.resume %10, continuation 1, slots [saved_slot(slot=0, ty=deps), saved_slot(slot=1, ty=scope<S1>, linear=true), saved_slot(slot=2, ty=deps), saved_slot(slot=3, ty=cache-state, linear=true)]
    br ^b3(%39, %40, %41, %44)
}

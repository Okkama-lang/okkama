oir 2 coro
module void_fixed_root
requires core, test, async
test "effect" = @check
scope S0 action in @note
scope S1 action in @check
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>], publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(failures=[cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>], publication=atomic)
summary M3 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M4 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(failures=[cancelled], suspends=true, publication=atomic)
summary M5 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M6 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>], publication=atomic)
summary M7 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>], publication=atomic)
summary M8 internal contract call_contract(publication=atomic)
summary M9 observation contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope, to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary], normal=protocol_poststate(holder=pending_exit, state=open))]

func @note(%0: frame<@note>) -> void [async] summary(M4) async-creation(M6) async-body(M4) {
    frame.layout {
        slot 0: str
        slot 1: own linear
    }
    continuation 0 start saves [0, 1]
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0:
    (%1: frame<@note>, %2: str, %3: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=str), saved_slot(slot=1, ty=own, linear=true)]
    %4: scope<S0> = scope.begin S0
    %5: scope<S0> = own.accept %4, %3
    br ^b1(%2, %5)
    ^b1(%6: str, %7: scope<S0>) in S0:
    %8: int = str.len %6
    %9: own = own.empty
    %10: pending = exit.prepare return packet %9 select s0 at B0
    invoke.own scope.end %7, reserve %10, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b2($closed, $pending)
        unwind ^b3($closed, $failure)
    ^b2(%11: closed, %12: pending) in S0:
    (%13: own, %14: deps) = exit.commit %12, destination caller
    fut.publish %1, success(packet=%13, deps=%14)
    ret
    ^b3(%15: closed, %16: failure) in S0:
    fut.publish %1, failure(%16)
    ret
}

func @check(%0: frame<@check>) -> void [async] abi observation summary(M9) async-creation(M7) async-body(M9) {
    frame.layout {
        slot 0: scope<S1> linear
        slot 1: deps
        slot 2: cache-state linear
        slot 3: deps
        slot 4: future<void>
        slot 5: failure
        slot 6: task-state linear
        slot 7: receipt linear
    }
    continuation 0 start saves []
    continuation 1 at ^b1 saves [0, 1, 2, 3] operands [4]
    continuation 2 at #11 saves [2] operands [0, 5, 6, 7]
    service.schedule Schedule0 owner S1, protocol P0, duties [%26]
    service.schedule Schedule0#1 owner S1, protocol P0, duties [%36]
    binding b0 "pending": future<void> in S1
    boundary B0 lexical in S1
    key k0: key = service_of(value=%9, kind=cache)
    dependency d0: dependency = key(k0)
    dependency d1: dependency = from_ssa(%17)
    ^b0 in S1:
    %1: frame<@check> = frame.resume %0, continuation 0
    %2: int = const 0
    %3: deps = deps.of %2
    %4: scope<S1> = scope.begin S1
    br ^b1(%4)
    ^b1(%5: scope<S1>) in S1:
    %6: str = const "effect"
    %7: own = own.empty
    %8: deps = deps.of %6
    (%9: future<void> facts(managed(deps=d0)), %10: cache-state, %11: scope<S1>) = fut.new %7, %8, %5, environment deferred(function=@note, arguments=[%6]), owner S1
    %12: deps = deps.of %9
    %13: frame<@check> = frame.save %1, slots [frame_slot(slot=0, value=%11, mode=consume), frame_slot(slot=1, value=%12, mode=borrow), frame_slot(slot=2, value=%10, mode=consume), frame_slot(slot=3, value=%3, mode=borrow)], continuation 1
    invoke.own await %9
        normal ^b6($deps)
        unwind ^b7($failure, $task, $receipt)
    ^b2(%14: deps, %15: future<void> facts(managed(deps=d1)), %16: scope<S1>, %17: deps) in S1:
    invoke.own scope.end %16, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b4($closed)
        unwind ^b5($closed, $failure)
    ^b3(%18: failure, %19: task-state, %20: receipt, %21: scope<S1>) in S1:
    %22: frame<@check> = frame.save %41, slots [frame_slot(slot=2, value=%44, mode=consume)], continuation 2
    [i11] (%23: scope<S1>, %24: failure) = await.unwind %21, %18, %19, %20, protocol P0
    (%25: frame<@check>, %26: cache-state) = frame.resume %22, continuation 2, slots [saved_slot(slot=2, ty=cache-state, linear=true)]
    %27: failure = scope.unwind %23, %24, effects scope_effects(failures=[], suspends=false, cancel=false)
    fut.publish %25, failure(%27)
    ret
    ^b4(%28: closed) in S1:
    %29: own = own.empty
    fut.publish %33, success(packet=%29, deps=%37)
    ret
    ^b5(%30: closed, %31: failure) in S1:
    fut.publish %33, failure(%31)
    ret
    ^b6(%32: deps) in S1:
    (%33: frame<@check>, %34: scope<S1>, %35: deps, %36: cache-state, %37: deps) = frame.resume %13, continuation 1, slots [saved_slot(slot=0, ty=scope<S1>, linear=true), saved_slot(slot=1, ty=deps), saved_slot(slot=2, ty=cache-state, linear=true), saved_slot(slot=3, ty=deps)]
    br ^b2(%32, %9, %34, %35)
    ^b7(%38: failure, %39: task-state, %40: receipt) in S1:
    (%41: frame<@check>, %42: scope<S1>, %43: deps, %44: cache-state, %45: deps) = frame.resume %13, continuation 1, slots [saved_slot(slot=0, ty=scope<S1>, linear=true), saved_slot(slot=1, ty=deps), saved_slot(slot=2, ty=cache-state, linear=true), saved_slot(slot=3, ty=deps)]
    br ^b3(%38, %39, %40, %42)
}

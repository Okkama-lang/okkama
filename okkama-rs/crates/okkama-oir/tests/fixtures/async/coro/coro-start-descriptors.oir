    %11: int = obj.get %8, n
    %12: int = int.add %11, %9
    %13: own = own.empty
    %14: deps = deps.of %12
    %15: pending = exit.prepare return %12, %13, deps(%14) at B1
    invoke.own scope.end %10, reserve %15, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b2($closed, $pending, %12)
        unwind ^b3($closed, $failure)
    ^b2(%16: closed, %17: pending, %18: int) in S1:
    (%19: int, %20: own, %21: deps) = exit.commit %17, destination caller, result int
    fut.publish %1, success(value=%19, packet=%20, deps=%21)
    ret
    ^b3(%22: closed, %23: failure) in S1:
    fut.publish %1, failure(%23)

oir 2 coro
// Coro golden of tests/fixtures/async/own/r2-take-proof-recheck.oir (R2): the proof names the resumed version
// of the Future, and coro's recheck lists the frame slot that held it across the await in the evidence (B9.2).
module unique_cache
scope S0 action in @task
scope S1 action in @f
summary M0 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>], publication=atomic)
summary M1 call-boundary contract call_contract(failures=[cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<void>], publication=atomic)
summary M3 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=settle, from=frame, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope, to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary], normal=protocol_poststate(holder=pending_exit, state=open))]

func @task(%0: frame<@task>) -> void [async] summary(M1) async-creation(M0) async-body(M1) {
    frame.layout {
        slot 0: own linear
    }
    continuation 0 start saves [0]
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0:
    (%1: frame<@task>, %2: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=own, linear=true)]
    %3: scope<S0> = scope.begin S0
    %4: scope<S0> = own.accept %3, %2
    %5: own = own.empty
    %6: pending = exit.prepare return packet %5 select s0 at B0
    invoke.own scope.end %4, reserve %6, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b1($closed, $pending)
        unwind ^b2($closed, $failure)
    ^b1(%7: closed, %8: pending) in S0:
    (%9: own, %10: deps) = exit.commit %8, destination caller
    fut.publish %1, success(packet=%9, deps=%10)
    ret
    ^b2(%11: closed, %12: failure) in S0:
    fut.publish %1, failure(%12)
    ret
}

func @f(%0: frame<@f>) -> void [async] summary(M3) async-creation(M2) async-body(M3) {
    frame.layout {
        slot 0: own linear
        slot 1: future<void>
        slot 2: scope<S1> linear
        slot 3: cache-state linear
        slot 4: cache-state linear
        slot 5: future<void>
        slot 6: unique-cache linear
        slot 7: failure
        slot 8: task-state linear
        slot 9: receipt linear
    }
    continuation 0 start saves [0]
    continuation 1 at ^b0 saves [1, 2, 3, 4] operands [5]
    continuation 2 at ^b1 saves [2, 3, 4] operands [1, 6]
    continuation 3 at #16 saves [3, 4] operands [2, 7, 8, 9]
    service.schedule Schedule0 owner S1, protocol P0, duties [%37, %38]
    service.schedule Schedule0#1 owner S1, protocol P0, duties [%64, %65]
    boundary B0 lexical in S1
    key k0: key = service_of(value=%8, kind=cache)
    key k1: key = service_of(value=%12, kind=cache)
    dependency d0: dependency = key(k0)
    dependency d1: dependency = key(k1)
    selection s0: selection = union([])
    ^b0 in S1:
    (%1: frame<@f>, %2: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=own, linear=true)]
    %3: scope<S1> = scope.begin S1
    %4: scope<S1> = own.accept %3, %2
    %5: own = own.empty
    %6: int = const 0
    %7: deps = deps.of %6
    [i6] (%8: future<void> facts(managed(deps=d0)), %9: cache-state, %10: scope<S1>) = fut.new %5, %7, %4, environment deferred(function=@task), owner S1
    %11: own = own.empty
    (%12: future<void> facts(managed(deps=d1)), %13: cache-state, %14: scope<S1>) = fut.new %11, %7, %10, environment deferred(function=@task), owner S1
    %15: frame<@f> = frame.save %1, slots [frame_slot(slot=1, value=%8, mode=borrow), frame_slot(slot=2, value=%14, mode=consume), frame_slot(slot=3, value=%9, mode=consume), frame_slot(slot=4, value=%13, mode=consume)], continuation 1
    invoke.own await %12
        normal ^b6($deps)
        unwind ^b7($failure, $task, $receipt)
    ^b1(%16: deps, %17: scope<S1>) in S1:
    %18: unique-cache = unique_cache.proof proof unique_cache_proof(future=%48, scope=S1, region=[^b1], evidence=unique_cache_evidence(creation=instruction(i6), frame_slots=[1], no_external_storage=true, no_other_waiters=true, no_live_views=true, no_collector_retention=true, scheduler_cannot_publish=true))
    %19: frame<@f> = frame.save %47, slots [frame_slot(slot=2, value=%17, mode=consume), frame_slot(slot=3, value=%50, mode=consume), frame_slot(slot=4, value=%51, mode=consume)], continuation 2
    invoke.own await.take %48, %18, boundary temporary(awaiting=S1)
        normal ^b8($packet, $deps)
        unwind ^b9($failure, $task, $receipt)
    ^b2(%20: own, %21: deps, %22: scope<S1>) in S1:
    %23: scope<S1> = own.accept %22, %20
    %24: own = own.empty
    %25: pending = exit.prepare return packet %24 select s0 at B0
    invoke.own scope.end %23, reserve %25, effects scope_effects(failures=[thrown, program, panic, native], suspends=false, cancel=true)
        normal ^b4($closed, $pending)
        unwind ^b5($closed, $failure)
    ^b3(%26: failure, %27: task-state, %28: receipt, %29: scope<S1>, %30: frame<@f>, %31: cache-state, %32: cache-state) in S1:
    %33: frame<@f> = frame.save %30, slots [frame_slot(slot=3, value=%31, mode=consume), frame_slot(slot=4, value=%32, mode=consume)], continuation 3
    [i16] (%34: scope<S1>, %35: failure) = await.unwind %29, %26, %27, %28, protocol P0
    (%36: frame<@f>, %37: cache-state, %38: cache-state) = frame.resume %33, continuation 3, slots [saved_slot(slot=3, ty=cache-state, linear=true), saved_slot(slot=4, ty=cache-state, linear=true)]
    %39: failure = scope.unwind %34, %35, effects scope_effects(failures=[thrown, program, panic, native], suspends=false, cancel=false)
    fut.publish %36, failure(%39)
    ret
    ^b4(%40: closed, %41: pending) in S1:
    (%42: own, %43: deps) = exit.commit %41, destination caller
    fut.publish %62, success(packet=%42, deps=%43)
    ret
    ^b5(%44: closed, %45: failure) in S1:
    fut.publish %62, failure(%45)
    ret
    ^b6(%46: deps) in S1:
    (%47: frame<@f>, %48: future<void> facts(managed(deps=d0)), %49: scope<S1>, %50: cache-state, %51: cache-state) = frame.resume %15, continuation 1, slots [saved_slot(slot=1, ty=future<void>), saved_slot(slot=2, ty=scope<S1>, linear=true), saved_slot(slot=3, ty=cache-state, linear=true), saved_slot(slot=4, ty=cache-state, linear=true)]
    br ^b1(%46, %49)
    ^b7(%52: failure, %53: task-state, %54: receipt) in S1:
    (%55: frame<@f>, %56: future<void> facts(managed(deps=d0)), %57: scope<S1>, %58: cache-state, %59: cache-state) = frame.resume %15, continuation 1, slots [saved_slot(slot=1, ty=future<void>), saved_slot(slot=2, ty=scope<S1>, linear=true), saved_slot(slot=3, ty=cache-state, linear=true), saved_slot(slot=4, ty=cache-state, linear=true)]
    br ^b3(%52, %53, %54, %57, %55, %58, %59)
    ^b8(%60: own, %61: deps) in S1:
    (%62: frame<@f>, %63: scope<S1>, %64: cache-state, %65: cache-state) = frame.resume %19, continuation 2, slots [saved_slot(slot=2, ty=scope<S1>, linear=true), saved_slot(slot=3, ty=cache-state, linear=true), saved_slot(slot=4, ty=cache-state, linear=true)]
    br ^b2(%60, %61, %63)
    ^b9(%66: failure, %67: task-state, %68: receipt) in S1:
    (%69: frame<@f>, %70: scope<S1>, %71: cache-state, %72: cache-state) = frame.resume %19, continuation 2, slots [saved_slot(slot=2, ty=scope<S1>, linear=true), saved_slot(slot=3, ty=cache-state, linear=true), saved_slot(slot=4, ty=cache-state, linear=true)]
    br ^b3(%66, %67, %68, %70, %69, %71, %72)
}

// A path steps from a variant into the payload field of one of its cases (a once Maybe slot, #717).
module variant_paths
object Some {
    field value: int
}
variant Maybe = (some: Some)
object Outer {
    field slot: Maybe
}
scope S action in @f
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)]
    results [result_relation(aliases=[path(parameter=0, fields=[field_ref(declaration=Outer, index=0),
    field_ref(declaration=Some, index=0)])], provenance=bound)] contract call_contract(results=[int],
    publication=atomic)
func @f(%outer: Outer facts(plain(certificate=closed_graph(ty=Outer)))) -> int summary(M0) {
^entry in S:
    ret 0
}

oir 2 own
module local_selection
requires core
object R {
    field child: R
    field $pending: bool
    destroy @destroy
}
scope SD action in @destroy
scope S action in @f
summary MD observation parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(
        publication=atomic)
summary MF call-boundary parameters [parameter_effect(convention=take, retention=some(parameter(0)), deps=[0],
        destination=result)] results [result_relation(fresh=[0], aliases=[parameter(0)], external_deps=[0],
        provenance=unbound_result)] contract call_contract(results=[R], failures=[program], publication=atomic)
func @destroy(%self: R facts(managed(deps=dd))) -> void [destroy R] abi observation summary(MD) {
    dependency dd: dependency = retention(value=%self, selection=selection(%self))
    ^entry in SD:
    ret
}
summary MV observation parameters [parameter_effect(convention=borrow, destination=none),
        parameter_effect(convention=borrow, destination=none)] results [result_relation(
        aliases=[parameter(0), parameter(1)], external_deps=[0, 1], provenance=bound)] contract call_contract(
        results=[R], publication=atomic)
// Expose the completed self together with its initialized child retention.
func @graph(%self: R, %child: R) -> R [extern "fixture.completed.graph"] abi observation summary(MV);
func @f(%arg: R facts(managed(deps=da)); %ad: deps, %input: own) -> (R, own) [ctor R]
        abi explicit(input_packet=2, output_packet=1) summary(MF) {
    boundary B0 lexical in S
    key kl: key = created(site=0, instance=%local)
    dependency da: dependency = from_ssa(%ad)
    dependency du: dependency = empty
    dependency dk: dependency = key(kl)
    dependency dl: dependency = union([dk, da])
    dependency dg: dependency = retention(value=%graph, selection=selection(%graph))
    dependency dout: dependency = from_ssa(%gd)
    ^entry in S:
    %q: scope<S> = scope.begin S
    %accepted: scope<S> = own.accept %q, %input
    %uninit: R facts(managed(deps=du)) = undef ty R
    %unknown: bool = undef ty bool
    invoke.own obj.new R { child: %uninit, $pending: %unknown } construction incomplete
        normal ^created($value, %accepted)
        unwind ^failed($failure, %accepted)
    ^created(%local: R facts(managed(deps=dl)), %open: scope<S>) in S unwind ^implicit_failed(%open):
    // The incomplete self's reference names only its local identity.
    // Initialization adds the accepted child; full deps conservatively keep it throughout.
    obj.init %local, %arg, field field_ref(declaration=R, index=0)
    %no: bool = const false
    %complete: scope<S> = obj.init %local, %no, field field_ref(declaration=R,
        index=1), completion construction_completion(state=%open)
    %graph: R facts(managed(deps=dg)) = call @graph(%local, %arg) summary(MV)
    %full: deps = deps.of %graph
    %p: pending = exit.prepare return %graph, own.empty, deps(%full) at B0
    invoke.own scope.split %complete, selection(%graph)
        normal ^selected($state, $selected, $external_deps, %full, %p)
        unwind ^split_failed($state, $failure, %p)
    ^selected(%rest: scope<S>, %part: own, %ext: deps, %gd: deps, %pending: pending) in S:
    %extended: pending = exit.extend %pending, %part
    (%closed: closed, %reserved: pending) = scope.end %rest, reserve %extended, effects scope_effects(
        failures=[], suspends=false, cancel=false)
    (%out: R facts(managed(deps=dout)), %packet: own,
        %deps: deps) = exit.commit %reserved, destination caller, result R
    ret %out, %packet
    ^implicit_failed(%is: scope<S>, %ie: failure) in S:
    %if: failure = scope.unwind %is, %ie, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %if
    ^failed(%error: failure, %fs: scope<S>) in S:
    %failure: failure = scope.unwind %fs, %error, effects scope_effects(
        failures=[], suspends=false, cancel=false)
    raise %failure
    ^split_failed(%ss: scope<S>, %se: failure, %sp: pending) in S:
    %sf: failure = scope.unwind %ss, %se, reserve %sp, effects scope_effects(
        failures=[], suspends=false, cancel=false)
    raise %sf
}

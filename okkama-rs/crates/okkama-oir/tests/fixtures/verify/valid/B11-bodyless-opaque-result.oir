oir 2 own
module opaque_cleanup
summary Mc call-boundary parameters [parameter_effect(convention=take,
    destination=none)] contract call_contract(publication=atomic)
func @drop(%value: fn(int) -> int; %deps: deps, %packet: own) -> own
    [intrinsic "fixture.cleanup.fn"] abi explicit(input_packet=2, output_packet=0) summary(Mc);
summary Ms call-boundary results [result_relation(provenance=bound)] contract call_contract(results=[array<fn(int)
    -> int>], publication=atomic)
func @source() -> array<fn(int) -> int> [intrinsic "fixture.source"] summary(Ms);
scope S action in @f
summary Mf call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] contract call_contract(failures=[thrown, program, panic, native], suspends=true,
    publication=atomic)
func @f(%value: fn(int) -> int facts(managed(deps=dv)); %input: own) -> void [async] summary(Mf) {
    dependency dv: dependency = retention(value=%value, selection=selection(%value))
^entry in S:
    %state: scope<S> = scope.begin S
    %accepted: scope<S> = own.accept %state, %input
    %dictionary: type = type.of ty fn(int) -> int, descriptor descriptor_contract(managed=runtime,
        retention=owner_graph(0), cleanup=@drop, async_destroy=true, summary=Mc)
    %closed: closed = scope.end %accepted, effects scope_effects(
        failures=[thrown, program, panic, native], suspends=true, cancel=false)
    ret
}

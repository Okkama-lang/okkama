        root_requirement(boundary=entry(^b7), bindings=[root_binding(value=%5, trace=failure_graph)]), ], proofs=[])
    boundary B0 call in S1
    key k0: key = created(site=0, instance=%2)
    dependency d0: dependency = key(k0)
    ^b0 in S1:
    [i0] %1: int = const 1
    invoke.own obj.new R { x: %1; %0 }
        normal ^b1($value, $packet)
        unwind ^b2($packet, $failure)
    ^b1(%2: R facts(managed(deps=d0)), %3: own) in S1:
    ret %2, %3
    ^b2(%4: own, %5: failure) in S1:
    [i1] %6: cleanup-state = cleanup.begin %4, failure %5, close 0, effects scope_effects(failures=[thrown, program,
        panic, native], suspends=false, cancel=false)
    [i2] %7: cleanup-state = cleanup.settle.empty %6, schedule 0
    [i3] %8: cleanup-state = cleanup.plan %7, plan 0
    br ^b3(%8)
    ^b3(%9: cleanup-state) in S1:
    cleanup.next %9 selected ^b4($state, $selected) done ^b6($state)
    ^b4(%10: cleanup-state, %11: stable-key) in S1:
    [i4] (%12: cleanup-state, %13: failure-state) = cleanup.destroy %10, %11
    failure.dispatch %13 none ^b3(%12) some ^b5(%12, $failure)

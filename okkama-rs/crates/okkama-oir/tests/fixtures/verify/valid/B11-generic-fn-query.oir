oir 2 own
module opaque_cleanup
summary Mc call-boundary parameters [parameter_effect(convention=take,
    destination=none)] contract call_contract(publication=atomic)
func @drop(%value: fn(array<param<function(@f), 0>>) -> int; %deps: deps, %packet: own) -> own
    [intrinsic "fixture.cleanup.fn"] abi explicit(input_packet=2, output_packet=0) summary(Mc);
scope S action in @f
summary Mf call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @f<T>(%value: fn(array<T>) -> int facts(managed(deps=dv)); %input: own) -> void [async] summary(Mf) {
    dependency dv: dependency = retention(value=%value, selection=selection(%value))
^entry in S:
    %state: scope<S> = scope.begin S
    %accepted: scope<S> = own.accept %state, %input
    %dictionary: type = type.of ty fn(array<T>) -> int, descriptor descriptor_contract(managed=runtime,
        retention=owner_graph(0), cleanup=@drop, async_destroy=true, summary=Mc)
    invoke.own scope.end %accepted, effects scope_effects(failures=[thrown, program, panic, native], suspends=true,
        cancel=true)
        normal ^d18_closed($closed)
        unwind ^d18_cancelled($closed, $failure)
^d18_closed(%closed: closed) in S:
    ret
^d18_cancelled(%d18_closed2: closed, %d18_cancel: failure) in S:
    raise %d18_cancel
}

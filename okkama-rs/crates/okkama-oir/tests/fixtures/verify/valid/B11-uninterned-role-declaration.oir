oir 2 own
module opaque_cleanup
role Marker {
}
object Hidden {
    field resource: R
    does Marker { }
}
object R {
    destroy @destroy
}
scope SD action in @destroy
summary Md call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] contract call_contract(failures=[thrown], suspends=true, publication=atomic)
func @destroy(%self: R facts(managed(deps=dd))) -> void [destroy R, async] summary(Md) {
    dependency dd: dependency = retention(value=%self, selection=selection(%self))
^entry in SD:
    ret
}
object Visible {
    does Marker { }
}
scope SV action in @visible
summary Mv call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] contract call_contract(publication=atomic)
func @visible(%value: Visible facts(plain(certificate=closed_graph(ty=Visible)))) -> void summary(Mv) {
^entry in SV:
    ret
}
scope S action in @f
summary Mf call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] contract call_contract(failures=[thrown, program, panic, native], suspends=true,
    publication=atomic)
func @f(%value: Marker facts(managed(deps=dv)); %input: own) -> void [async] summary(Mf) {
    dependency dv: dependency = retention(value=%value, selection=selection(%value))
^entry in S:
    %state: scope<S> = scope.begin S
    %accepted: scope<S> = own.accept %state, %input
    %closed: closed = scope.end %accepted, effects scope_effects(
        failures=[thrown, program, panic, native], suspends=true, cancel=false)
    ret
}

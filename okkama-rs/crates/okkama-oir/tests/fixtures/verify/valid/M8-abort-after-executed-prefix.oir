oir 2 low
// M8 (OIR-2 §9.1, §9.3 step 6): f owns A and returns R through the reserve of its final close (cancel=true).
// #696, the D21 form: the first plan drains and destroys A; cleanup.deliver_cancel runs after it, and the second
// plan closes R only if the cancellation was delivered. A requested cancellation therefore keeps the trace A R:
// the executed prefix stays executed and R is aborted after it (spec/09-abort-after-prefix.json).
module resources
object R {
    field x: int
    destroy @destroy
}
scope S0 action in @destroy
scope S1 action in @create
scope S2 action in @f
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(publication=atomic)
summary M1 internal results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[R],
    failures=[thrown, program, panic, native, cancelled], publication=atomic)
summary M2 internal results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[R],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
protocol P0 kind services
func @destroy(%0: R facts(managed(deps=d0))) -> void [destroy R] summary(M0) {
    low.metadata cleanup_metadata(closes=[], schedules=[], plans=[], roots=[root_requirement(boundary=terminator(^b0)),
        root_requirement(boundary=entry(^b0), bindings=[root_binding(value=%0, trace=value(R))]), ], proofs=[])
    dependency d0: dependency = retention(value=%0, selection=selection(%0))
    ^b0 in S0:
    ret
}

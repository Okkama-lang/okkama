oir 2 own
// Spec §9.2; verifier plan §4.8: Trap follows block unwind before function exit.
module trap_unwind
scope S action in @f
summary M0 internal contract call_contract(failures=[program], publication=atomic)
func @f() -> void summary(M0) {
    ^entry in S:
    %q: scope<S> = scope.begin S
    br ^body(%q)
    ^body(%open: scope<S>) in S unwind ^cleanup(%open):
    trap confirm "program failure"
    ^cleanup(%state: scope<S>, %failure: failure) in S:
    %final: failure = scope.unwind %state, %failure, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %final
}

oir 2 high
// Design §§10.4/10.7 (D8/D11), H2/H4: High tagged return carries only its language value.
module high_defer_result
scope S action in @d
func @d() -> void [defer(replacements=[defer_label(label="return", result=some(int))])] {
    boundary B0 lexical in S
    ^entry in S:
    %value: int = const 7
    want %value
    [iprepared] exit.prepare return %value at B0
    result.exit edge normal(0), value %value, demand want, prepare iprepared
    ret defer replace return, %value
}

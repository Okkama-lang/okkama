    %11: unique-cache = unique_cache.proof proof unique_cache_proof(future=%8, scope=S1, region=[^b0],
        evidence=unique_cache_evidence(creation=instruction(i6), no_external_storage=true, no_other_waiters=false,
        no_live_views=true, no_collector_retention=true, scheduler_cannot_publish=true))
    %12: frame<@f> = frame.save %1, slots [frame_slot(slot=1, value=%10, mode=consume), frame_slot(slot=2, value=%9,

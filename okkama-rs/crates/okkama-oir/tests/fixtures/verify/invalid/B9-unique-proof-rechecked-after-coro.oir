oir 2 coro
// expect OIR2-B9.2 instruction:1:7
// B9.2: the unique-cache evidence does not exclude other waiters, and coro rechecks it.
// #696: the D21 form; its valid pair is valid/B9-unique-proof-rechecked-after-coro.oir.
module unique_cache
scope S0 action in @task
scope S1 action in @f
summary M0 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary M1 call-boundary contract call_contract(failures=[cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary M3 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root] rules [protocol_rule(transition=settle,
    from=cache, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=cache, to=root,
    checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=settle, from=frame, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running))]
func @task(%0: frame<@task>) -> void [async] summary(M1) async-creation(M0) async-body(M1) {
    frame.layout {
        slot 0: own linear
    }
    continuation 0 start saves [0]
    boundary B0 lexical in S0
    selection s0: selection = union([])
    ^b0 in S0:
    (%1: frame<@task>, %2: own) = frame.resume %0, continuation 0, slots [saved_slot(slot=0, ty=own, linear=true)]
    %3: scope<S0> = scope.begin S0
    %4: scope<S0> = own.accept %3, %2
    %5: own = own.empty
    %6: pending = exit.prepare return packet %5 select s0 at B0
    invoke.own scope.end %4, reserve %6, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b1($closed, $pending)
        unwind ^b2($closed, $failure)
    ^b1(%7: closed, %8: pending) in S0:
    (%9: own, %10: deps) = exit.commit %8, destination caller
    fut.publish %1, success(packet=%9, deps=%10)
    ret
    ^b2(%11: closed, %12: failure) in S0:
    fut.publish %1, failure(%12)
    ret
}
func @f(%0: frame<@f>) -> void [async] summary(M3) async-creation(M2) async-body(M3) {

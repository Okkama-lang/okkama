oir 2 own
// expect OIR2-B9.1 value:0:0
// Elaboration D12: own holds the cache duty in its owner state; a cache-state token is a second holder,
// even when a service schedule settles it.
module own_loose_cache_state
protocol Services kind services
scope S action in @f
summary M0 internal contract call_contract(failures=[thrown, program, panic, native], suspends=true,
    publication=atomic)
func @f(%cache: cache-state) -> void [async] summary(M0) {
    service.schedule Schedule0 owner S, protocol Services, duties [%cache]
^entry in S:
    %q: scope<S> = scope.begin S
    %closed: closed = scope.end %q, effects scope_effects(failures=[thrown, program, panic, native], suspends=true,
        cancel=false)
    ret
}

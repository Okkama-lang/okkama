oir 2 own
// expect OIR2-B10.6 value:1:6
// D16: a schedule covers each duty exactly once.
module own_cache_schedule
protocol Services kind services
scope ST action in @task
scope S action in @f
scope SI block in @f parent S
summary Mt internal contract call_contract(publication=atomic)
summary Mf internal contract call_contract(publication=atomic)
func @task() -> void summary(Mt) {
^entry in ST:
    ret
}
func @f() -> void summary(Mf) {
    service.schedule Outer owner S, protocol Services, duties [%a, %a]
    service.schedule Inner owner SI, protocol Services, duties [%b]
    key ka: key = service_of(value=%a, kind=cache)
    key kb: key = service_of(value=%b, kind=cache)
    dependency dak864: dependency = key(ka)
    dependency daf864: dependency = from_ssa(%x0)
    dependency da: dependency = union([dak864, daf864])
    dependency dbk864: dependency = key(kb)
    dependency dbf864: dependency = from_ssa(%x1)
    dependency db: dependency = union([dbk864, dbf864])
    selection s0: selection = union([])
^entry in S:
    %q: scope<S> = scope.begin S
    %e0: own = own.empty
    (%l0: own, %r0: own, %x0: deps) = own.split %e0, s0
    %in0: own = own.join [%l0, %r0]
    (%a: future<void> facts(managed(deps=da)), %q1: scope<S>) = fut.new %in0, %x0, %q, environment deferred(
        function=@task), owner S
    br ^inner(%q1)
^inner(%q2: scope<S>) in SI:
    %qi: scope<SI> = scope.begin SI
    %e1: own = own.empty
    (%l1: own, %r1: own, %x1: deps) = own.split %e1, s0
    %in1: own = own.join [%l1, %r1]
    (%b: future<void> facts(managed(deps=db)), %qi1: scope<SI>) = fut.new %in1, %x1, %qi, environment deferred(
        function=@task), owner SI
    %ci: closed = scope.end %qi1, effects scope_effects(failures=[], suspends=false, cancel=false)
    br ^after(%q2)
^after(%q3: scope<S>) in S:
    %c: closed = scope.end %q3, effects scope_effects(failures=[], suspends=false, cancel=false)
    ret
}

module resources
object R {
    field x: int
    destroy @destroy
}
scope S0 action in @destroy
scope S1 action in @create
scope S2 action in @deferred
scope S3 action in @f
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(publication=atomic)
summary M1 internal results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[R],
    failures=[thrown, program, panic, native, cancelled], publication=atomic)
summary M2 internal contract call_contract(failures=[thrown], publication=atomic)
summary M3 internal results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[R],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)

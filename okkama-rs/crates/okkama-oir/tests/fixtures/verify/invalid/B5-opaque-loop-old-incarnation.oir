oir 2 own
// expect OIR2-B5.1 instruction:3:5
// #569 O1 audit: an opaque call in a loop. The packet of the previous result %x is
// offered with %y, the result of an older iteration of the same call site. Once the
// call retires both keys, only the result's labels tell the incarnations apart:
// the fresh piece of %x is not inside %y's graph.
module opaque_loop
object R {
    destroy @destroy
}
scope S action in @main
summary Md call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary Mop call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(fresh=[0], aliases=[owner_graph(0)], external_deps=[0], opaque=true, provenance=unbound_result)] contract call_contract(results=[R], publication=atomic)
summary Msink call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @destroy(%self: R) -> void [extern "fixture.destroy", destroy R] summary(Md);
func @op(%env: R; %input: own) -> (R, own, deps) [extern "fixture.op"] summary(Mop);
func @sink(%r: R; %input: own) -> (own, deps) [extern "fixture.sink"] summary(Msink);
func @main(%c: R facts(managed(deps=dc)), %go: bool; %cd: deps) -> void summary(M0) {
    boundary B0 lexical in S
    dependency dc: dependency = from_ssa(%cd)
    dependency dr0: dependency = retention(value=%r0, selection=selection(%r0))
    dependency dx: dependency = retention(value=%x, selection=selection(%x))
    dependency dy: dependency = retention(value=%y, selection=selection(%y))
    dependency dz: dependency = retention(value=%z, selection=selection(%z))
    dependency du: dependency = retention(value=%u, selection=selection(%u))
^entry in S:
    (%r0: R facts(managed(deps=dr0)), %p0: own, %d0: deps) = call @op(%c; own.empty) deps [%cd]
    %a0: own = own.empty
    br ^loop(%r0, %p0, %r0, %a0)
^loop(%x: R facts(managed(deps=dx)), %px: own, %y: R facts(managed(deps=dy)), %acc: own) in S:
    (%z: R facts(managed(deps=dz)), %pz: own, %dz0: deps) = call @op(%c; own.empty) deps [%cd]
    (%e: own, %de: deps) = call @sink(%y; %px)
    %acc2: own = own.join [%acc, %e]
    cond %go, ^loop(%z, %pz, %x, %acc2), ^exit(%z, %pz, %acc2)
^exit(%u: R facts(managed(deps=du)), %pu: own, %fin: own) in S:
    (%e1: own, %de1: deps) = call @sink(%u; %pu)
    %all: own = own.join [%fin, %e1]
    %closed: closed = end %all, boundary B0
    ret
}

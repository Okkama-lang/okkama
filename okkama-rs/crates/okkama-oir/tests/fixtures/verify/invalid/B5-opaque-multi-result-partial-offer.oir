oir 2 own
// expect OIR2-B5.1 instruction:3:2
// #569 O1 audit: one fresh site in two opaque result relations. The fresh graph
// may escape through either result, so a callee that receives only %b and the
// whole packet could destroy the part of it that %a still retains.
module multi_opaque
object R {
    destroy @destroy
}
scope S action in @main
summary Md call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary Mtwo call-boundary results [result_relation(fresh=[0], opaque=true, provenance=unbound_result), result_relation(fresh=[0], opaque=true, provenance=unbound_result)] contract call_contract(results=[R, R], publication=atomic)
summary Msink call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary M0 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], publication=atomic)
func @destroy(%self: R) -> void [extern "fixture.destroy", destroy R] summary(Md);
func @two(%input: own) -> (R, R, own, deps) [extern "fixture.two"] summary(Mtwo);
func @sink(%b: R; %input: own) -> (own, deps) [extern "fixture.sink"] summary(Msink);
func @main() -> void summary(M0) {
    boundary B0 lexical in S
    dependency da: dependency = retention(value=%a, selection=selection(%a))
    dependency db: dependency = retention(value=%b, selection=selection(%b))
^entry in S:
    (%a: R facts(managed(deps=da)), %b: R facts(managed(deps=db)), %packet: own, %full: deps) = call @two(; own.empty)
    (%empty: own, %deps: deps) = call @sink(%b; %packet)
    %closed: closed = end %empty, boundary B0
    ret
}

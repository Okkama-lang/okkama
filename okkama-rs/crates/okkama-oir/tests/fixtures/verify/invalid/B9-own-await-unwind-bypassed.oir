oir 2 own
// expect OIR2-B9.1 terminator:0:0
// Elaboration §13.3: a generic failure block settles the waiter's task and receipt through the
// close's service schedule instead of await.unwind.
module own_await_unwind_bypassed
protocol Services kind services
scope S action in @f
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
func @f(%future: future<int> facts(managed(deps=d0))) -> void [async] summary(M0) {
    service.schedule Schedule0 owner S, protocol Services, duties [%t, %r]
    key k0: key = service_of(value=%future, kind=cache)
    dependency d0: dependency = key(k0)
^entry in S:
    %q: scope<S> = scope.begin S
    invoke.own await %future, result int
        normal ^ok($value, $deps, %q)
        unwind ^failed($failure, $task, $receipt, %q)
^ok(%v: int, %d: deps, %q1: scope<S>) in S:
    %closed: closed = scope.end %q1, effects scope_effects(failures=[], suspends=false, cancel=false)
    ret
^failed(%e: failure, %t: task-state, %r: receipt, %q2: scope<S>) in S:
    %combined: failure = scope.unwind %q2, %e, effects scope_effects(failures=[thrown, program, panic, native],
        suspends=true, cancel=false)
    raise %combined
}

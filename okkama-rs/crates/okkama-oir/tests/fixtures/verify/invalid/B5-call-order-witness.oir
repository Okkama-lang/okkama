oir 2 high
// expect OIR2-B5.1 instruction:1:0
module call_order
object Card {
    field rank: int
    does Comparing {order = @order}
}
role Comparing {
    order(Card) -> Order
}
enum Order = (less, equal, greater)
scope So action in @order
scope S action in @f
summary Mw call-boundary parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Order], failures=[thrown], publication=atomic)
summary Mo call-boundary parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Order], publication=atomic)
func @order(%self: Card, %other: Card) -> Order [method Card] summary(Mw) {
    boundary Bo lexical in So
^entry in So:
    %greater: Order = enum.case Order, case 2
    want %greater
    [i1] exit.prepare return %greater at Bo
    result.exit edge normal(0), value %greater, demand want, prepare #1
    ret %greater
}
func @f(%cards: array<Card>) -> void {
^entry in S:
    %sorted: array<Card> = call.order %cards, Comparing slot 0(%cards) summary(Mo)
    ret
}

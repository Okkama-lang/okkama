oir 2 high
// expect OIR2-T1 operand:1:0:[1]
module call_order
object Plain {
    field rank: int
}
object Card {
    field rank: int
    does Comparing {order = @order}
}
role Comparing {
    order(Card) -> Order
}
enum Order = (less, equal, greater)
scope So action in @order
scope S action in @f
summary Mo call-boundary parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[Order], publication=atomic)
func @order(%self: Card, %other: Card) -> Order [method Card] summary(Mo) {
    boundary Bo lexical in So
^entry in So:
    %greater: Order = enum.case Order, case 2
    want %greater
    [i1] exit.prepare return %greater at Bo
    result.exit edge normal(0), value %greater, demand want, prepare #1
    ret %greater
}
func @f(%cards: array<Plain>) -> void {
^entry in S:
    %sorted: array<Plain> = call.order %cards, Comparing slot 0(%cards) summary(Mo)
    ret
}

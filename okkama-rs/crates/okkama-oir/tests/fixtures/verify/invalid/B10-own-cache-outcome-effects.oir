oir 2 own
// expect OIR2-B10.4 instruction:2:5
// Async ABI D24.2: settling a done Future releases its outcome packet into the owner's serial plan, so the
// close needs the outcome's destroy effects. The envelope omits the thrown failure of R's destroy.
module own_cache_outcome_effects
protocol Services kind services
object R {
    field x: int
    destroy @destroy
}
scope SD action in @destroy
scope S action in @f
summary Md internal parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(failures=[thrown], publication=atomic)
summary Mt observation results [result_relation(provenance=unbound_result)] contract call_contract(results=[R],
    publication=atomic)
summary Mf internal contract call_contract(publication=atomic)
func @destroy(%self: R facts(managed(deps=dd))) -> void [destroy R] summary(Md) {
    dependency dd: dependency = retention(value=%self, selection=selection(%self))
^entry in SD:
    ret
}
func @task() -> R [extern "fixture.task"] abi observation summary(Mt);
func @f() -> void summary(Mf) {
    service.schedule Schedule0 owner S, protocol Services, duties [%a]
    key ka: key = service_of(value=%a, kind=cache)
    dependency dak864: dependency = key(ka)
    dependency daf864: dependency = from_ssa(%x0)
    dependency da: dependency = union([dak864, daf864])
    selection s0: selection = union([])
^entry in S:
    %q: scope<S> = scope.begin S
    %e0: own = own.empty
    (%l0: own, %r0: own, %x0: deps) = own.split %e0, s0
    %in0: own = own.join [%l0, %r0]
    (%a: future<R> facts(managed(deps=da)), %q1: scope<S>) = fut.new %in0, %x0, %q, environment deferred(
        function=@task), result R, owner S
    %c: closed = scope.end %q1, effects scope_effects(failures=[], suspends=false, cancel=false)
    ret
}

oir 2 own
// expect OIR2-B5.5 terminator:4:4
// #569 O1: a fresh result treated as an alias of the argument. The call narrows
// the registered open contract to the identity relation of the hand-written Mopen.
module sync

object R {
    destroy @destroy
}
scope S0 action in @destroy
scope S1 action in @make
scope S2 action in @f
scope S3 action in @read
summary M0 call-boundary parameters [parameter_effect(convention=take, destination=none)] contract

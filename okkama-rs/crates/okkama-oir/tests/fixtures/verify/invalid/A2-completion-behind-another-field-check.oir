oir 2 high
// expect OIR2-A2 instruction:0:9
module constructor
object C {
    field x: int
    field y: int
    field $pending: bool
}
scope S action in @f
func @f(%choose: bool) -> C [ctor C] {
    boundary B0 lexical in S
^entry in S unwind ^failed:
    %u: int = undef ty int
    %v: int = undef ty int
    %p: bool = undef ty bool
    %o: C = obj.new C { x: %u, y: %v, $pending: %p } construction incomplete
    obj.init %o, 2, field field_ref(declaration=C, index=1)
    %ybound: bool = const true
    cond %choose, ^left(%o), ^right(%o)
^left(%a: C) in S:
    obj.init %a, 1, field field_ref(declaration=C, index=0)
    br ^merge(%a, %ybound)
^right(%b: C) in S:
    br ^merge(%b, %ybound)
^merge(%joined: C, %bound: bool) in S:
    cond %bound, ^complete(%joined), ^unbound
^complete(%self: C) in S:
    obj.init %self, false, field field_ref(declaration=C, index=2)
    [iprep0] exit.prepare return %self at B0
    result.exit edge normal(0), value %self, demand want, prepare iprep0
    ret %self
^unbound in S:
    trap unbound "Object \"C\" field \"x\" was not initialized"
^failed(%e: failure) in S:
    raise %e
}

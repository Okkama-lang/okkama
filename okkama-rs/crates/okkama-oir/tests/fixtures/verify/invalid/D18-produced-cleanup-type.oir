oir 2 own
// expect OIR2-B10.4 instruction:3:3
// D18 / design §10.11: forwarded borrows do not become newly created cleanup obligations.
module created_effects
object R {
    destroy @destroy_r
}
object X {
    destroy @destroy_x
}
enum Stop is Error = (stop)
scope SDR action in @destroy_r
scope SDX action in @destroy_x
scope S action in @f
summary MR observation parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(
        failures=[thrown], publication=atomic)
summary MX observation parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(
        failures=[thrown], publication=atomic)
summary MF observation parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(
        failures=[program], publication=atomic)
func @destroy_r(%self: R facts(managed(deps=dr))) -> void [destroy R] abi observation summary(MR) {
    dependency dr: dependency = retention(value=%self, selection=selection(%self))
    ^entry in SDR:
    ret
}
func @destroy_x(%self: X facts(managed(deps=dx))) -> void [destroy X] abi observation summary(MX) {
    dependency dx: dependency = retention(value=%self, selection=selection(%self))
    ^entry in SDX:
    %stop: Stop facts(plain(certificate=scalar)) = enum.case Stop, case 0
    throw %stop
}
scope SM action in @make
summary MM call-boundary results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(
        results=[R], failures=[program], publication=atomic)
func @make(%input: own) -> (R, own) [ctor R] abi explicit(input_packet=0, output_packet=1) summary(MM) {
    key km: key = created(site=0, instance=%made)
    dependency dm: dependency = key(km)
    boundary BM call in SM
    ^entry in SM:
    invoke.own obj.new R {; %input }
        normal ^made($value, $packet)
        unwind ^bad($packet, $failure)
    ^made(%made: R facts(managed(deps=dm)), %packet: own) in SM:
    ret %made, %packet
    ^bad(%rest: own, %failure: failure) in SM:
    %closed: closed = end %rest, boundary BM
    raise %failure
}
func @f(%outside: X facts(managed(deps=dx))) -> void abi observation summary(MF) {
    dependency dx: dependency = retention(value=%outside, selection=selection(%outside))
    dependency db: dependency = retention(value=%borrow, selection=selection(%borrow))
    dependency dr: dependency = retention(value=%r, selection=selection(%r))
    ^entry in S:
    %q: scope<S> = scope.begin S
    invoke.own call @make(; own.empty) summary(MM)
        normal ^ok($value, $packet, %q, %outside)
        unwind ^bad($failure, %q)
    ^ok(%r: R facts(managed(deps=dr)), %packet: own, %open: scope<S>, %borrow: X facts(managed(deps=db))) in S:
    %admitted: scope<S> = own.admit %open, %packet
    %closed: closed = scope.end %admitted, effects scope_effects(failures=[], suspends=false, cancel=false)
    ret
    ^bad(%failure: failure, %open_bad: scope<S>) in S:
    %final: failure = scope.unwind %open_bad, %failure, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %final
}

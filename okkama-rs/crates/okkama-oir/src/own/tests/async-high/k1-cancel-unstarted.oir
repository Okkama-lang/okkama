oir 2 high
// K1 (#601), a reduced L08.future.cancel-unstarted: async main cancels a cold Future twice before it starts,
// awaits it inside a try whose catch arm (Error) yields -1, then reads done and cancelled. The producer's form,
// which passes the Future through the blocks, closes S2 with S1's duty live (#684); here S1's value is used.
// Cancelling never moves the Future's inputs: its cache duty stays in the owner S1 and settles at S1's close
// (elaboration §13.1, Champ draft 3 §5).
module k1_cancel_unstarted
requires core, async
entry @main

object app.Job {
}

role Error [builtin] {
    text() -> str
}
scope S0 action in @app.Job.run#0
scope S1 action in @main
scope S2 try in @main parent S1
scope S3 catch in @main parent S1
scope S4 branch in @main parent S1
scope S5 branch in @main parent S1
scope S6 action in @app.Job.new#0
summary M0 call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], failures=[program, panic, native], publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M3 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], failures=[program, panic, native], publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root] rules [protocol_rule(transition=settle,
    from=cache, to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=receipt, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=cache, to=root,
    checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running))]

func @app.Job.new#0() -> app.Job [ctor app.Job] {
    boundary B0 lexical in S6
    ^b0 in S6 unwind ^b1:
    %0: app.Job = obj.new app.Job { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S6:
    raise %1
}

func @app.Job.run#0(%0: app.Job) -> int [method app.Job, async] async-creation(M1) async-body(M0) {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: int = const 1
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry, async] async-creation(M3) async-body(M2) {
    binding b0 "pending": future<int> in S1
    binding b1 "e": Error in S3
    binding b2 "r": int in S1
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    boundary B2 lexical in S3
    boundary B3 lexical in S4
    boundary B4 lexical in S5
    ^b0 in S1 unwind ^b1:
    [i0] %0: app.Job = call @app.Job.new#0()
    [i1] %1: future<int> = call @app.Job.run#0(%0)
    bind %1, binding b0
    fut.cancel %1
    fut.cancel %1
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b4
    ^b1(%2: failure) in S1:
    raise %2
    ^b2(%3: int) in S1 unwind ^b1:
    bind %3, binding b2
    %4: bool = fut.done %1
    cond %4, ^b10, ^b11
    ^b3(%5: failure) in S1 unwind ^b1:
    catch %5 is Error, ^b5(%5, $value), ^b6(%5)
    ^b4 in S2 unwind ^b3:
    %6: int = await %1, result int
    want %6
    [i9] exit.prepare fallthrough %6 at B1
    result.exit edge normal(0), value %6, demand want, prepare #9
    br ^b2(%6)
    ^b5(%7: failure, %8: Error) in S3 unwind ^b1:
    bind %8, binding b1
    br ^b8(%7)
    ^b6(%9: failure) in S1 unwind ^b1:
    raise %9
    ^b7(%10: failure, %11: failure) in S1 unwind ^b1:
    %12: failure = fail.caused %11, %10
    raise %12
    ^b8(%13: failure) in S3 unwind ^b7(%13):
    %14: int = const -1
    want %14
    [i14] exit.prepare fallthrough %14 at B2
    result.exit edge normal(0), value %14, demand want, prepare #14
    br ^b2(%14)
    ^b9(%15: bool) in S1 unwind ^b1:
    cond %15, ^b12(%3), ^b13
    ^b10 in S4 unwind ^b1:
    %16: bool = fut.cancelled %1
    want %16
    [i17] exit.prepare fallthrough %16 at B3
    result.exit edge normal(0), value %16, demand want, prepare #17
    br ^b9(%16)
    ^b11 in S5 unwind ^b1:
    %17: bool = const false
    want %17
    [i20] exit.prepare fallthrough %17 at B4
    result.exit edge normal(0), value %17, demand want, prepare #20
    br ^b9(%17)
    ^b12(%18: int) in S1 unwind ^b1:
    want %18
    [i22] exit.prepare return %18 at B0
    result.exit edge normal(0), value %18, demand want, prepare #22
    ret %18
    ^b13 in S1 unwind ^b1:
    %19: int = const 0
    want %19
    [i25] exit.prepare return %19 at B0
    result.exit edge normal(0), value %19, demand want, prepare #25
    ret %19
}

// OIR-2 §10.2: a temporary Future of a plain outcome is awaited shared. Nothing is fresh in its outcome, so the
// awaiting scope takes nothing: no unique-cache proof and no await.take, unlike r1-temporary-take.
module r1_plain_temporary
entry @main
protocol Services kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope,
    to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary],
    normal=protocol_poststate(holder=pending_exit, state=open))]
scope SW action in @work
scope S action in @main
summary MworkC call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary MworkB call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[cancelled],
    suspends=true, publication=atomic)
summary MmainC call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary MmainB call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @work(%x: int) -> int [async] async-creation(MworkC) async-body(MworkB) {
    boundary Bauto lexical in SW
    ^entry in SW:
    %n: int = int.add %x, %x
    want %n
    [iprep0] exit.prepare return %n at Bauto
    result.exit edge normal(0), value %n, demand want, prepare iprep0
    ret %n
}
func @main() -> int [entry, async] async-creation(MmainC) async-body(MmainB) {
    boundary Bauto lexical in S
    ^entry in S unwind ^failed:
    %seven: int = const 7
    %f: future<int> = call @work(%seven)
    temp %f, S
    %v: int = await %f, result int
    want %v
    [iprep1] exit.prepare return %v at Bauto
    result.exit edge normal(0), value %v, demand want, prepare iprep1
    ret %v
    ^failed(%failure: failure) in S:
    raise %failure
}

oir 2 high
// OIR-2 §10.1 make(): a sync action creates a cold Future of a fresh receiver R and a fresh argument A and returns
// it. The Future's cache duty and its input packet leave make's scope through the exit (C-4: cache.rehome into the
// pending reserve, target caller). main admits the returned packet into the inner block SI (D25.1, its schedule
// gains the dynamic step), the Future leaves SI as the block's value (cache.rehome, target S), and S awaits it.
// The borrowed log keeps its owner: it is an external dep of the Future, never part of its packet.
module r1_make_escape
entry @main
protocol Services kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope,
    to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary],
    normal=protocol_poststate(holder=pending_exit, state=open))]
object Res {
    destroy @destroy
}
scope SD action in @destroy
scope SR action in @res
scope SE action in @read
scope SM action in @make
scope S action in @main
scope SI block in @main parent S
summary MreadC call-boundary parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)]
    results [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>],
    publication=atomic)
summary MreadB call-boundary parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)]
    results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[cancelled], suspends=true, publication=atomic)
summary MmainC call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary MmainB call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @destroy(%self: Res) -> void [destroy Res] {
    ^entry in SD:
    ret
}
func @res() -> Res [ctor Res] {
    boundary BR lexical in SR
    ^entry in SR unwind ^failed:
    %r: Res = obj.new Res { }
    want %r
    [iprep0] exit.prepare return %r at BR
    result.exit edge normal(0), value %r, demand want, prepare iprep0
    ret %r
    ^failed(%failure: failure) in SR:
    raise %failure
}
func @read(%self: Res, %arg: Res, %log: Res) -> int [method Res, async] async-creation(MreadC) async-body(MreadB) {
    boundary BE lexical in SE
    ^entry in SE:
    %n: int = const 1
    want %n
    [iprep1] exit.prepare return %n at BE
    result.exit edge normal(0), value %n, demand want, prepare iprep1
    ret %n
}
func @make(%log: Res) -> future<int> {
    boundary BM lexical in SM
    ^entry in SM unwind ^failed:
    %r: Res = call @res()
    %a: Res = call @res()
    %f: future<int> = call @read(%r, %a, %log)
    want %f
    [iprep2] exit.prepare return %f at BM
    result.exit edge normal(0), value %f, demand want, prepare iprep2
    ret %f
    ^failed(%failure: failure) in SM:
    raise %failure
}
func @main() -> int [entry, async] async-creation(MmainC) async-body(MmainB) {
    binding b0 "log": Res in S
    binding b1 "f": future<int> in S
    boundary BI lexical in SI
    boundary Bauto lexical in S
    ^entry in S unwind ^failed:
    %log: Res = call @res()
    bind %log, binding b0
    br ^inner
    ^inner in SI unwind ^failed:
    %f: future<int> = call @make(%log)
    want %f
    [iprep3] exit.prepare fallthrough %f at BI
    result.exit edge normal(0), value %f, demand want, prepare iprep3
    br ^after(%f)
    ^after(%g: future<int>) in S unwind ^failed:
    bind %g, binding b1
    %n: int = await %g, result int
    want %n
    [iprep4] exit.prepare return %n at Bauto
    result.exit edge normal(0), value %n, demand want, prepare iprep4
    ret %n
    ^failed(%failure: failure) in S:
    raise %failure
}

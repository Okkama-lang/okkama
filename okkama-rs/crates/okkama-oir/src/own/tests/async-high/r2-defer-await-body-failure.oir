oir 2 high
// R2 (P2.5 plan, async ABI C-6): async action f() { let r = R(); defer await closer(); risky(); }
// risky() throws; the defer runs the async defer entry closer, which awaits a task, on both exits of f. The
// defer entry creates no Future: it has a body summary only (#730).
module defer_await_body_failure
protocol Services kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope,
    to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary],
    normal=protocol_poststate(holder=pending_exit, state=open))]
object R {
    destroy @destroy
}
enum Stop is Error = (now)
scope S0 action in @destroy
scope S1 action in @make
scope S2 action in @task
scope S3 action in @closer
scope S4 action in @f
scope S5 action in @risky
summary MtC call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary MtB call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
summary Mcl call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
summary MfC call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary MfB call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @destroy(%self: R) -> void [destroy R] {
    ^entry in S0:
    ret
}
func @make() -> R [ctor R] {
    boundary B0 lexical in S1
    ^entry in S1 unwind ^failed:
    %r: R = obj.new R { }
    want %r
    [iprep0] exit.prepare return %r at B0
    result.exit edge normal(0), value %r, demand want, prepare iprep0
    ret %r
    ^failed(%failure: failure) in S1:
    raise %failure
}
func @task() -> void [async] async-creation(MtC) async-body(MtB) {
    boundary B0 lexical in S2
    selection s0: selection = union([])
    ^entry in S2 unwind ^failed:
    exit.prepare return select s0 at B0
    ret
    ^failed(%failure: failure) in S2:
    raise %failure
}
func @closer() -> void [defer(), async] async-body(Mcl) {
    ^entry in S3 unwind ^failed:
    %t: future<void> = call @task()
    temp %t, S3
    await %t
    ret defer continue
    ^failed(%failure: failure) in S3:
    raise %failure
}
func @risky() -> void {
    ^entry in S5 unwind ^failed:
    %error: Stop = enum.case Stop, case 0
    throw %error
    ^failed(%failure: failure) in S5:
    raise %failure
}
func @f() -> void [async] async-creation(MfC) async-body(MfB) {
    binding b0 "r": R in S4
    boundary B0 lexical in S4
    selection s0: selection = union([])
    ^entry in S4 unwind ^failed:
    %r: R = call @make()
    bind %r, binding b0
    br ^next
    ^next in S4 unwind ^failed2:
    defer.register S4, action defer_action(function=@closer)
    br ^body
    ^body in S4 unwind ^failed3:
    call @risky()
    exit.prepare return select s0 at B0
    ret
    ^failed(%failure: failure) in S4:
    raise %failure
    ^failed2(%failure2: failure) in S4:
    raise %failure2
    ^failed3(%failure3: failure) in S4:
    raise %failure3
}

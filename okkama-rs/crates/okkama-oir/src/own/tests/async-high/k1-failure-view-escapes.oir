oir 2 high
// K1 (#601), the elaboration §13.4 fixture, producer output: `let f = work(); await f;` where the body of
// Work.run throws, so the failure escapes the Future-owning action main. The failure view has no ownership
// deps: closing the local cache duty does not invalidate it, and main raises it after the close.
module k1_failure_view_escapes
requires core, async
entry @main

object app.Work {
}

enum app.Broken is Error = (broken)
scope S0 action in @app.Work.run#0
scope S1 action in @main
scope S2 action in @app.Work.new#0
summary M0 call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], failures=[program, panic, native], publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M3 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], failures=[program, panic, native], publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope,
    to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary],
    normal=protocol_poststate(holder=pending_exit, state=open))]

func @app.Work.new#0() -> app.Work [ctor app.Work] {
    boundary B0 lexical in S2
    ^b0 in S2 unwind ^b1:
    %0: app.Work = obj.new app.Work { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S2:
    raise %1
}

func @app.Work.run#0(%0: app.Work) -> int [method app.Work, async] async-creation(M1) async-body(M0) {
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    %1: app.Broken = enum.case app.Broken, case 0
    throw %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry, async] async-creation(M3) async-body(M2) {
    binding b0 "f": future<int> in S1
    boundary B0 lexical in S1
    ^b0 in S1 unwind ^b1:
    [i0] %0: app.Work = call @app.Work.new#0()
    [i1] %1: future<int> = call @app.Work.run#0(%0)
    bind %1, binding b0
    %2: int = await %1, result int
    want %2
    [i5] exit.prepare return %2 at B0
    result.exit edge normal(0), value %2, demand want, prepare #5
    high.effects at #0 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #1 failures [thrown, program, panic, native, cancelled], suspends true
    ret %2
    ^b1(%3: failure) in S1:
    raise %3
}

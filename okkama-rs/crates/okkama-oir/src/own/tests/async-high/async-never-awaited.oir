oir 2 high
// future.never-awaited: a synchronous main creates a Future and never awaits it. The body never starts;
// the cache duty settles at the close of main's scope without waiting (async ABI D24.2).
module async_never_awaited
entry @main
protocol Services kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=settle, from=frame, to=root, checks=[owner, live_dependencies], normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope,
    to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary],
    normal=protocol_poststate(holder=pending_exit, state=open))]
scope SE action in @explode
scope S action in @main
summary MexplodeC call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary MexplodeB call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[int], failures=[panic, cancelled], suspends=true, publication=atomic)
func @explode() -> int [async] async-creation(MexplodeC) async-body(MexplodeB) {
    ^entry in SE unwind ^failed:
    %message: str = const "this body must not start"
    panic %message
    ^failed(%failure: failure) in SE:
    raise %failure
}
func @main() -> int [entry] {
    binding b0 "pending": future<int> in S
    boundary Bauto lexical in S
    ^entry in S unwind ^failed:
    %f: future<int> = call @explode()
    bind %f, binding b0
    %zero: int = const 0
    want %zero
    [iprep0] exit.prepare return %zero at Bauto
    result.exit edge normal(0), value %zero, demand want, prepare iprep0
    ret %zero
    ^failed(%failure: failure) in S:
    raise %failure
}

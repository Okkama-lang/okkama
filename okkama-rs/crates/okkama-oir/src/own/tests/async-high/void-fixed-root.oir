oir 2 high
// #691 (1): a void fixed root. An async test returns no value and awaits a void Future for its effect. Its success
// publishes an empty packet with empty deps, which coro takes from a scalar constant at the entry, as an async
// defer entry does for its Continue (async ABI C-2 ruling of #691, C-6).
module void_fixed_root
requires core, test, async
test "effect" = @check
scope S0 action in @note
scope S1 action in @check
summary M0 call-boundary parameters [parameter_effect(convention=borrow,
    destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(failures=[cancelled], suspends=true, publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<void>], publication=atomic)
summary M3 call-boundary contract call_contract(failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope,
    to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary],
    normal=protocol_poststate(holder=pending_exit, state=open))]

func @note(%0: str) -> void [async] async-creation(M0) async-body(M1) {
    ^b0 in S0:
    %1: int = str.len %0
    ret
}

func @check() -> void [async] async-creation(M2) async-body(M3) {
    binding b0 "pending": future<void> in S1
    boundary B0 lexical in S1
    selection s0: selection = union([])
    ^b0 in S1 unwind ^b1:
    %0: str = const "effect"
    %1: future<void> = call @note(%0)
    bind %1, binding b0
    await %1
    exit.prepare return select s0 at B0
    ret
    ^b1(%2: failure) in S1:
    raise %2
}

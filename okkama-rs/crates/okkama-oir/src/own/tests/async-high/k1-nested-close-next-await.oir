oir 2 high
// K1 (#601), producer output: a branch block owns the cache duty of g and closes after awaiting it; its close
// is nested, so it never delivers a deferred cancellation (D18, cancel=false). The await of f after the block
// is the next await, where a pending cancellation is delivered. (The final close keeps the D18 form until #727;
// per the K2 ruling it delivers nothing at run time.)
module k1_nested_close_next_await
requires core, async
entry @main

object app.Inner {
}
scope S0 action in @app.Inner.run#0
scope S1 action in @main
scope S2 branch in @main parent S1
scope S3 branch in @main parent S1
scope S4 action in @app.Inner.new#0
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none),
    parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], failures=[program, panic, native], publication=atomic)
summary M2 call-boundary results [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary M3 call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], failures=[program, panic, native], publication=atomic)
protocol P0 kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope,
    to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary],
    normal=protocol_poststate(holder=pending_exit, state=open))]

func @app.Inner.new#0() -> app.Inner [ctor app.Inner] {
    boundary B0 lexical in S4
    ^b0 in S4 unwind ^b1:
    %0: app.Inner = obj.new app.Inner { }
    want %0
    [i2] exit.prepare return %0 at B0
    result.exit edge normal(0), value %0, demand want, prepare #2
    ret %0
    ^b1(%1: failure) in S4:
    raise %1
}

func @app.Inner.run#0(%0: app.Inner, %1: int) -> int [method app.Inner, async] async-creation(M1) async-body(M0) {
    binding b0 "n": int in S0
    boundary B0 lexical in S0
    ^b0 in S0 unwind ^b1:
    bind %1, binding b0
    want %1
    [i2] exit.prepare return %1 at B0
    result.exit edge normal(0), value %1, demand want, prepare #2
    ret %1
    ^b1(%2: failure) in S0:
    raise %2
}

func @main() -> int [entry, async] async-creation(M3) async-body(M2) {
    binding b0 "g": future<int> in S2
    binding b1 "a": int in S1
    binding b2 "f": future<int> in S1
    boundary B0 lexical in S1
    boundary B1 lexical in S2
    boundary B2 lexical in S3
    ^b0 in S1 unwind ^b1:
    %0: bool = const true
    cond %0, ^b3, ^b4
    ^b1(%1: failure) in S1:
    raise %1
    ^b2(%2: int) in S1 unwind ^b1:
    bind %2, binding b1
    [i2] %3: app.Inner = call @app.Inner.new#0()
    %4: int = const 2
    [i4] %5: future<int> = call @app.Inner.run#0(%3, %4)
    bind %5, binding b2
    %6: int = await %5, result int
    %7: int = int.add %2, %6
    want %7
    [i9] exit.prepare return %7 at B0
    result.exit edge normal(0), value %7, demand want, prepare #9
    high.effects at #2 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #4 failures [thrown, program, panic, native, cancelled], suspends true
    ret %7
    ^b3 in S2 unwind ^b1:
    [i10] %8: app.Inner = call @app.Inner.new#0()
    %9: int = const 1
    [i12] %10: future<int> = call @app.Inner.run#0(%8, %9)
    bind %10, binding b0
    %11: int = await %10, result int
    want %11
    [i16] exit.prepare fallthrough %11 at B1
    result.exit edge normal(0), value %11, demand want, prepare #16
    high.effects at #10 failures [thrown, program, panic, native, cancelled], suspends true
    high.effects at #12 failures [thrown, program, panic, native, cancelled], suspends true
    br ^b2(%11)
    ^b4 in S3 unwind ^b1:
    %12: int = const 0
    want %12
    [i19] exit.prepare fallthrough %12 at B2
    result.exit edge normal(0), value %12, demand want, prepare #19
    br ^b2(%12)
}

oir 2 high
// A cold Future awaited inside the body of another cold Future: async main awaits outer(7), whose body awaits
// inner(n). Each body brackets its own await (async ABI D20) and owns the cache duty of the Future it creates.
module coro_nested_cold_await
entry @main
protocol Services kind services holders [scope, cache, frame, receipt, root, pending_exit] rules [
    protocol_rule(transition=settle, from=cache, to=scope, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=scope, state=settled)), protocol_rule(transition=settle, from=receipt,
    to=scope, checks=[owner, live_dependencies], normal=protocol_poststate(holder=scope, state=settled)),
    protocol_rule(transition=settle, from=cache, to=root, checks=[owner, live_dependencies],
    normal=protocol_poststate(holder=root, state=running)), protocol_rule(transition=rehome, from=scope,
    to=pending_exit, checks=[owner, live_dependencies, sufficient_boundary],
    normal=protocol_poststate(holder=pending_exit, state=open))]
scope SI action in @inner
scope SO action in @outer
scope S action in @main
summary MinnerC call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary MinnerB call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[int], failures=[cancelled],
    suspends=true, publication=atomic)
summary MouterC call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[future<int>], publication=atomic)
summary MouterB call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results
    [result_relation(provenance=unbound_result)] contract call_contract(results=[int],
    failures=[thrown, program, panic, native, cancelled], suspends=true, publication=atomic)
summary MmainC call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[future<int>], publication=atomic)
summary MmainB call-boundary results [result_relation(provenance=unbound_result)] contract
    call_contract(results=[int], failures=[thrown, program, panic, native, cancelled], suspends=true,
    publication=atomic)
func @inner(%n: int) -> int [async] async-creation(MinnerC) async-body(MinnerB) {
    boundary Bauto lexical in SI
    ^entry in SI:
    want %n
    [iprep0] exit.prepare return %n at Bauto
    result.exit edge normal(0), value %n, demand want, prepare iprep0
    ret %n
}
func @outer(%n: int) -> int [async] async-creation(MouterC) async-body(MouterB) {
    boundary Bauto lexical in SO
    ^entry in SO unwind ^failed:
    %f: future<int> = call @inner(%n)
    %x: int = await %f, result int
    want %x
    [iprep1] exit.prepare return %x at Bauto
    result.exit edge normal(0), value %x, demand want, prepare iprep1
    ret %x
    ^failed(%failure: failure) in SO:
    raise %failure
}
func @main() -> int [entry, async] async-creation(MmainC) async-body(MmainB) {
    boundary Bauto lexical in S
    ^entry in S unwind ^failed:
    %seven: int = const 7
    %f: future<int> = call @outer(%seven)
    %x: int = await %f, result int
    want %x
    [iprep2] exit.prepare return %x at Bauto
    result.exit edge normal(0), value %x, demand want, prepare iprep2
    ret %x
    ^failed(%failure: failure) in S:
    raise %failure
}

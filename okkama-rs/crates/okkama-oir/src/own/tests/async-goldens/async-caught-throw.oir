func @work(%0: own) -> (int, own) [async] abi explicit(input_packet=0, output_packet=1) summary(M4) async-creation(M6) async-body(M4) {
    ^b0 in S0:
    %1: scope<S0> = scope.begin S0
    %2: scope<S0> = own.accept %1, %0
    br ^b1(%2)
    ^b1(%3: scope<S0>) in S0:
    %4: Stop facts(plain(certificate=scalar)) = enum.case Stop, case 0
    br ^b2(%3, %4)
    ^b2(%5: scope<S0>, %6: Stop facts(plain(certificate=scalar))) in S0 unwind ^b3(%5):
    throw %6
    ^b3(%7: scope<S0>, %8: failure) in S0:
    %9: failure = scope.unwind %7, %8, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %9
}

func @main() -> int [entry, async] abi observation summary(M9) async-creation(M7) async-body(M9) {
    service.schedule Schedule0 owner S1, protocol P0, duties [%4]
    binding b0 "x": int in S1

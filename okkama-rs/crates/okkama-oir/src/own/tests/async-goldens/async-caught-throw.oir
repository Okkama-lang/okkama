    %6: deps = deps.of %4
    invoke.own await %4, result int
        normal ^b2($value, $deps, %4, %5, %6)
        unwind ^b3($failure, $task, $receipt, %5)
    ^b2(%7: int, %8: deps, %9: future<int> facts(managed(deps=d3)), %10: scope<S1>, %11: deps) in S1:
    invoke.own scope.end %10, effects scope_effects(failures=[], suspends=false, cancel=true)
        normal ^b4($closed, %7)
        unwind ^b5($closed, $failure)
    ^b3(%12: failure, %13: task-state, %14: receipt, %15: scope<S1>) in S1:
    (%16: scope<S1>, %17: failure) = await.unwind %15, %12, %13, %14, protocol P0
    %18: failure = scope.unwind %16, %17, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %18
    ^b4(%19: closed, %20: int) in S1:

oir 2 high
// PR-P (#749): the High stage of a program whose results keep a carrier-free field (a role over a plain object):
//   object Source { has res is Res; has tag is Named;
//       first(late is bool) is Step { if late { Step(tag, res); } else { Step(tag, res); } } }
//   object Holder { has tag is Named; has wide is bool;
//       mark() is Mark { if wide { Mark(tag, 2); } else { Mark(tag, 1); } } }
module app v1.0.0
requires core
entry @main

object app.Tag {
    field n: int

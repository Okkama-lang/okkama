oir 2 own
module bound_dictionary
scope S0 action in @cleanup
scope S1 action in @f
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary M2 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], publication=atomic)
summary M3 observation parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary M4 observation parameters [parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], publication=atomic)

func @cleanup(%0: int) -> void abi observation summary(M3) {
    ^b0 in S0:
    br ^b1(%0)
    ^b1(%1: int) in S0:
    ret
}

func @f(%0: int, %1: type facts(service)) -> int abi observation summary(M4) {
    descriptor.binding %1 contract descriptor_contract(managed=plain, retention=owner_graph(0), cleanup=@cleanup, summary=M3)
    boundary B0 lexical in S1
    ^b0 in S1:
    br ^b1(%0, %1)
    ^b1(%2: int, %3: type facts(service)) in S1:
    ret %2
}

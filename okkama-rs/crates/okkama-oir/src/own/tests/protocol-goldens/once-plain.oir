module once_plain

object O {
    field slot: int once
}
scope S0 action in @f
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], publication=atomic)
summary M1 observation parameters [parameter_effect(convention=borrow, destination=none), parameter_effect(convention=borrow, destination=none)] results [result_relation(provenance=unbound_result)] contract call_contract(results=[int], publication=atomic)

func @f(%0: O facts(plain(certificate=closed_graph(ty=O))), %1: int) -> int [method O] abi observation summary(M1) {
    boundary B0 lexical in S0
    ^b0 in S0:
    br ^b1(%0, %1)
    ^b1(%2: O facts(plain(certificate=closed_graph(ty=O))), %3: int facts(plain(certificate=closed_graph(ty=int)))) in S0:

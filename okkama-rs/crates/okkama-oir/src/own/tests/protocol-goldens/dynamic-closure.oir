func @destroy(%0: R facts(managed(deps=d1))) -> void [destroy R] abi observation summary(M5) {
    dependency d0: dependency = from_ssa(%3)
    dependency d1: dependency = retention(value=%0, selection=selection(%0))
    ^b0 in S0:
    %1: deps = deps.of %0
    br ^b1(%0, %1)
    ^b1(%2: R facts(managed(deps=d0)), %3: deps) in S0:
    ret
}

func @make(%0: own) -> (R, own) [ctor R] abi explicit(input_packet=0, output_packet=1) summary(M2) {
    boundary B0 lexical in S1

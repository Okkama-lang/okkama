summary M5 call-boundary results [result_relation(fresh=[0], provenance=unbound_result, several=true)] contract call_contract(results=[View], failures=[program], publication=atomic)
summary M6 observation parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)

func @destroy(%0: R facts(managed(deps=d1))) -> void [destroy R] abi observation summary(M6) {
    dependency d0: dependency = from_ssa(%3)
    dependency d1: dependency = retention(value=%0, selection=selection(%0))
    ^b0 in S0:
    %1: deps = deps.of %0
    br ^b1(%0, %1)
    ^b1(%2: R facts(managed(deps=d0)), %3: deps) in S0:
    ret
}


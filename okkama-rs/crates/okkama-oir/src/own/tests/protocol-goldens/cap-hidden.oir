    %15: scope<S1> = own.admit %14, %12
    %16: failure = scope.unwind %15, %13, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %16
    ^b4(%17: scope<S1>, %18: own, %19: deps, %20: R facts(managed(deps=d2)), %21: deps, %22: pending) in S1:
    %23: pending = exit.extend %22, %18

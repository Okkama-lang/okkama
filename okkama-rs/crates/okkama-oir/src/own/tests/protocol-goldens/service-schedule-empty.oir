oir 2 own
module empty_service_inventory
scope S0 action in @f
summary M0 call-boundary contract call_contract(publication=atomic)
summary M1 internal contract call_contract(publication=atomic)
protocol P0 kind services holders [scope] roots [operands]

func @f(%0: own) -> own abi explicit(input_packet=0, output_packet=0) summary(M0) {
    service.schedule Schedule0 owner S0, protocol P0
    ^b0 in S0:
    %1: scope<S0> = scope.begin S0
    %2: scope<S0> = own.accept %1, %0
    br ^b1(%2)
    ^b1(%3: scope<S0>) in S0:
    %4: closed = scope.end %3, effects scope_effects(failures=[], suspends=false, cancel=false)
    %5: own = own.empty
    ret %5
}

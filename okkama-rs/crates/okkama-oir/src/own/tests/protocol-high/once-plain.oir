oir 2 high
module once_plain
object O {
    field slot: int once
}
scope S action in @f
func @f(%self: O, %value: int) -> int [method O] {
    boundary B0 lexical in S
    ^entry in S:
    once.store %self, slot, %value
    %result: int = once.load %self, slot
    [ip] exit.prepare return %result at B0
    result.exit edge normal(0), value %result, demand want, prepare ip
    ret %result
}

oir 2 high
module sync
object R {
    destroy @destroy
}
scope SD action in @destroy
scope SC action in @make
scope S action in @f
func @destroy(%self: R) -> void [destroy R] {
    ^entry in SD:
    ret
}
func @make() -> R [ctor R] {
    boundary BC lexical in SC
    ^entry in SC unwind ^failed:
    %r: R = obj.new R { }
    want %r
    [iprep0] exit.prepare return %r at BC
    result.exit edge normal(0), value %r, demand want, prepare iprep0
    ret %r
    ^failed(%failure: failure) in SC:
    raise %failure
}
scope SR action in @read
func @read(%self: R) -> int [method R] {
    boundary Bauto lexical in SR
    ^entry in SR:
    %n: int = const 7
    want %n
    [iprep1] exit.prepare return %n at Bauto
    result.exit edge normal(0), value %n, demand want, prepare iprep1
    ret %n
}
scope SL action in @lambda
func @lambda(%captured: R) -> int [lambda captures 1] {
    boundary BL lexical in SL
    ^entry in SL unwind ^failed:
    %n: int = call @read(%captured)
    [ip] exit.prepare return %n at BL
    result.exit edge normal(0), value %n, demand want, prepare ip
    ret %n
    ^failed(%failure: failure) in SL:
    raise %failure
}
scope SI block in @f parent S
func @f() -> int {
    boundary BF lexical in S
    boundary BI lexical in SI
    binding b0 "r": R in S
    ^entry in S unwind ^failed:
    %r: R = call @make()
    bind %r, binding b0
    br ^inner(%r)
    ^inner(%external: R) in SI unwind ^failed:
    %closure: fn() -> int = fn.closure @lambda, [%external], ty fn() -> int
    [ipass] exit.prepare fallthrough %closure at BI
    result.exit edge normal(0), value %closure, demand want, prepare ipass
    br ^after(%closure)
    ^after(%snapshot: fn() -> int) in S unwind ^failed:
    %called: int = fn.call %snapshot()
    %result: int = call @read(%r)
    [ireturn] exit.prepare return %result at BF
    result.exit edge normal(0), value %result, demand want, prepare ireturn
    ret %result
    ^failed(%failure: failure) in S:
    raise %failure
}

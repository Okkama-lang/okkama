oir 2 high
module opaque_plain
scope S action in @f
func @f() -> any {
    boundary B0 lexical in S
    ^entry in S:
    %value: int = const 7
    %result: any = any.box %value, ty any
    [ip] exit.prepare return %result at B0
    result.exit edge normal(0), value %result, demand want, prepare ip
    ret %result
}

oir 2 high
module checked_group
object R {
    destroy @destroy
}
scope SD action in @destroy
scope SC action in @make
scope S action in @f
func @destroy(%self: R) -> void [destroy R] {
    ^entry in SD:
    ret
}
func @make() -> R [ctor R] {
    boundary BC lexical in SC
    ^entry in SC unwind ^failed:
    %r: R = obj.new R { }
    want %r
    [iprep0] exit.prepare return %r at BC
    result.exit edge normal(0), value %r, demand want, prepare iprep0
    ret %r
    ^failed(%failure: failure) in SC:
    raise %failure
}
scope SR action in @read
func @read(%self: R) -> int [method R] {
    boundary Bauto lexical in SR
    ^entry in SR:
    %n: int = const 7
    want %n
    [iprep1] exit.prepare return %n at Bauto
    result.exit edge normal(0), value %n, demand want, prepare iprep1
    ret %n
}
protocol P kind group holders [scope, packet, group, frame, cache, pin] rules [protocol_rule(transition=publish,
        from=group, to=scope,
        checks=[owner, live_dependencies],
        normal=protocol_poststate(holder=scope, state=open),
        unwind=some(protocol_poststate(holder=scope, state=settled)),
        cancel=some(protocol_poststate(holder=scope, state=settled))),
    protocol_rule(transition=settle, from=group, to=scope,
        checks=[owner, live_dependencies],
        normal=protocol_poststate(holder=scope, state=open),
        unwind=some(protocol_poststate(holder=scope, state=settled)),
        cancel=some(protocol_poststate(holder=scope, state=settled))),
    protocol_rule(transition=cancel, from=group, to=scope,
        checks=[owner, live_dependencies],
        normal=protocol_poststate(holder=scope, state=open),
        unwind=some(protocol_poststate(holder=scope, state=settled)),
        cancel=some(protocol_poststate(holder=scope, state=settled))),
    protocol_rule(transition=save, from=group, to=scope,
        checks=[owner, live_dependencies],
        normal=protocol_poststate(holder=scope, state=open),
        unwind=some(protocol_poststate(holder=scope, state=settled)),
        cancel=some(protocol_poststate(holder=scope, state=settled))),
    protocol_rule(transition=resume, from=group, to=scope,
        checks=[owner, live_dependencies],
        normal=protocol_poststate(holder=scope, state=open),
        unwind=some(protocol_poststate(holder=scope, state=settled)),
        cancel=some(protocol_poststate(holder=scope, state=settled))),
    protocol_rule(transition=dynamic, from=packet, to=scope,
        checks=[owner, live_dependencies, snapshot, transferable],
        normal=protocol_poststate(holder=scope, state=open),
        unwind=some(protocol_poststate(holder=packet, state=unaccepted)))] roots [operands, cache, pins, frame_slots]
summary Mf call-boundary parameters [parameter_effect(convention=borrow, destination=none)]
    results [result_relation(provenance=unbound_result)]
    contract call_contract(results=[int], publication=atomic, protocol=some(P))
func @f(%value: R) -> int summary(Mf) {
    boundary B0 lexical in S
    ^entry in S unwind ^failed:
    %result: int = const 7
    [ip] exit.prepare return %result at B0
    result.exit edge normal(0), value %result, demand want, prepare ip
    ret %result
    ^failed(%failure: failure) in S:
    raise %failure
}

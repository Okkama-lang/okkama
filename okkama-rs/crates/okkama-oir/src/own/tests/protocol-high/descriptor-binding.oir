oir 2 high
module bound_dictionary
scope SC action in @cleanup
scope S action in @f
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)]
    contract call_contract(publication=atomic)
func @cleanup(%value: int) -> void summary(M0) {
    ^entry in SC:
    ret
}
func @f(%value: int, %dictionary: type) -> int {
    descriptor.binding %dictionary contract descriptor_contract(managed=plain, retention=owner_graph(0),
        cleanup=@cleanup, async_destroy=false, summary=M0)
    boundary B0 lexical in S
    ^entry in S:
    [ip] exit.prepare return %value at B0
    result.exit edge normal(0), value %value, demand want, prepare ip
    ret %value
}

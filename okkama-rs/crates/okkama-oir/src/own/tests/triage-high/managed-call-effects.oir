oir 2 high
module managed_call_effects
object R {
    destroy @destroy
}
scope SD action in @destroy
scope SR action in @read
scope S action in @main
func @destroy(%self: R) -> void [destroy R] {
^entry in SD:
    ret
}
func @read(%r: R) -> int {
    boundary B0 lexical in SR
^entry in SR:
    %n: int = const 0
    want %n
    [iprep0] exit.prepare return %n at B0
    result.exit edge normal(0), value %n, demand want, prepare iprep0
    ret %n
}
func @main(%r: R) -> int {
    boundary B0 lexical in S
^entry in S unwind ^failed:
    %n: int = call @read(%r)
    want %n
    [iprep1] exit.prepare return %n at B0
    result.exit edge normal(0), value %n, demand want, prepare iprep1
    ret %n
^failed(%failure: failure) in S:
    raise %failure
}

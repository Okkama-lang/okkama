oir 2 high
module successor_retention
object Child {
    destroy @destroy_child
}
object Res {
    field child: Child
    destroy @destroy_res
}
scope SC action in @destroy_child
scope SR action in @destroy_res
scope S action in @next
func @destroy_child(%self: Child) -> void [destroy Child] {
^entry in SC:
    ret
}
func @destroy_res(%self: Res) -> void [destroy Res] {
^entry in SR:
    ret
}
func @next(%self: Res) -> ^Res [successor Res] {
    boundary B0 lexical in S
^entry in S unwind ^failed:
    %child: Child = obj.get %self, child
    %next: ^Res = obj.next %self { child: %child }
    want %next
    [iprep0] exit.prepare return %next at B0
    result.exit edge normal(0), value %next, demand want, prepare iprep0
    ret %next
^failed(%failure: failure) in S:
    raise %failure
}

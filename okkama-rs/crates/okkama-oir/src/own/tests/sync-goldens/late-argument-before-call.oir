    ^b7(%21: scope<S2>, %22: own, %23: deps, %24: int, %25: R facts(managed(deps=d2)), %26: deps) in S2:
    %27: own = own.join [%22]
    (%28: own, %29: deps) = call @take(%25, %24; %27) deps [%26]
    %30: scope<S2> = own.admit %21, %28
    %31: own = own.empty

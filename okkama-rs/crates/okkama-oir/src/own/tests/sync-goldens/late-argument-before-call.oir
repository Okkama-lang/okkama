oir 2 own
module sync

object R {
    destroy @destroy
}

enum Stop is Error = (now)
scope S0 action in @destroy
scope S1 action in @make
scope S2 action in @f
scope S3 action in @risky
scope S4 action in @take
scope S5 action in @deferred
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract call_contract(publication=atomic)
summary M1 call-boundary results [result_relation(fresh=[0], provenance=unbound_result)] contract call_contract(results=[R], failures=[program], publication=atomic)

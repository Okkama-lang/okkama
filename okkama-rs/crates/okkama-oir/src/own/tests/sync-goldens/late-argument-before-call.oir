func @f(%0: own) -> own abi explicit(input_packet=0, output_packet=0) summary(M5) {
    dependency d0: dependency = from_ssa(%8)
    dependency d1: dependency = from_ssa(%16)
    dependency d2: dependency = from_ssa(%26)
    selection s0: selection = union([selection(%15)])
    selection s1: selection = admissible(s0)
    ^b0 in S2:
    %1: scope<S2> = scope.begin S2
    %2: scope<S2> = own.accept %1, %0
    br ^b1(%2)
    ^b1(%3: scope<S2>) in S2:

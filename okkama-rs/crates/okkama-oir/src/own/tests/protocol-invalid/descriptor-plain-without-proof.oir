oir 2 own
// expect OIR2-B11.1 Value { function: FuncId(1), value: ValueId(0) }
module plain_parameter_dictionary
scope S0 action in @noop
scope S1 action in @f
summary M0 call-boundary contract call_contract(publication=atomic)
summary M1 call-boundary contract call_contract(publication=atomic)
summary M2 call-boundary parameters [parameter_effect(convention=borrow,
        destination=none)] results [result_relation(provenance=unbound_result)] contract
        call_contract(results=[param<function(@f), 0>], publication=atomic)
summary M3 observation contract call_contract(publication=atomic)
summary M4 observation parameters [parameter_effect(convention=borrow,
        destination=none)] results [result_relation(provenance=unbound_result)] contract
        call_contract(results=[param<function(@f), 0>], publication=atomic)

func @noop() -> void abi observation summary(M3) {
    ^b0 in S0:
    br ^b1
    ^b1 in S0:
    ret
}

func @f<T>(%0: T facts(plain(certificate=descriptor(%1))), %1: type facts(service)) -> T abi observation summary(M4) {
    descriptor.binding %1 contract descriptor_contract(managed=runtime, retention=descriptor(0), cleanup=@noop,
        summary=M3)
    boundary B0 lexical in S1
    ^b0 in S1:
    br ^b1(%0, %1)
    ^b1(%2: T facts(plain(certificate=descriptor(%1))), %3: type facts(service)) in S1:
    ret %2
}

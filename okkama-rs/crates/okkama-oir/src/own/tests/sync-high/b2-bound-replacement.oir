oir 2 high
module sync
object R {
    destroy @destroy
}
scope SD action in @destroy
scope SC action in @make
scope S action in @f
func @destroy(%self: R) -> void [destroy R] {
    ^entry in SD:
    ret
}
func @make() -> R [ctor R] {
    boundary BC lexical in SC
    ^entry in SC unwind ^failed:
    %r: R = obj.new R { }
    want %r
    [iprep0] exit.prepare return %r at BC
    result.exit edge normal(0), value %r, demand want, prepare iprep0
    ret %r
    ^failed(%failure: failure) in SC:
    raise %failure
}
scope SP action in @replace
func @replace(%value: R) -> void [defer(replacements=[defer_label(label="return", result=some(R))])] {
    boundary BP lexical in SP
    ^entry in SP unwind ^failed:
    want %value
    [iprep1] exit.prepare return %value at BP
    result.exit edge normal(0), value %value, demand want, prepare iprep1
    ret defer replace return, %value
    ^failed(%failure: failure) in SP:
    raise %failure
}
scope SI block in @f parent S
func @f() -> R {
    binding bb "b0": R in S
    boundary B0 lexical in S
    ^entry in S unwind ^failed:
    %b0: R = call @make()
    bind %b0, binding bb
    defer.register S, action defer_action(function=@replace, bindings=[bb], replacements=[defer_registration(label="return", kind=return, boundary=B0)])
    br ^inner
    ^inner in SI unwind ^failed_after:
    %r: R = call @make()
    want %r
    [iprep2] exit.prepare return %r at B0
    result.exit edge normal(0), value %r, demand want, prepare iprep2
    ret %r
    ^failed(%failure: failure) in S:
    raise %failure
    ^failed_after(%after_registration: failure) in S:
    raise %after_registration
}

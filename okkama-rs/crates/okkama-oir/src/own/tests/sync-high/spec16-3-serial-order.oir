oir 2 high
module sync
object R {
    destroy @destroy
}
scope SD action in @destroy
scope SC action in @make
scope S action in @f
func @destroy(%self: R) -> void [destroy R] {
    ^entry in SD:
    ret
}
func @make() -> R [ctor R] {
    boundary BC lexical in SC
    ^entry in SC unwind ^failed:
    %r: R = obj.new R { }
    want %r
    [iprep0] exit.prepare return %r at BC
    result.exit edge normal(0), value %r, demand want, prepare iprep0
    ret %r
    ^failed(%failure: failure) in SC:
    raise %failure
}
object Holder {
    field child: R
}
scope SH action in @hold
func @hold(%child: R) -> Holder [ctor Holder] {
    boundary BH lexical in SH
    ^entry in SH unwind ^failed:
    stage %child, action SH, field field_ref(declaration=Holder, index=0)
    %h: Holder = obj.new Holder { child: %child }
    want %h
    [iprep1] exit.prepare return %h at BH
    result.exit edge normal(0), value %h, demand want, prepare iprep1
    ret %h
    ^failed(%failure: failure) in SH:
    raise %failure
}
func @f() -> void {
    binding ba "a": R in S
    binding bb "b0": R in S
    binding bh "h": Holder in S
    ^entry in S unwind ^failed:
    %a: R = call @make()
    bind %a, binding ba
    %b0: R = call @make()
    bind %b0, binding bb
    %h: Holder = call @hold(%a)
    bind %h, binding bh
    ret
    ^failed(%failure: failure) in S:
    raise %failure
}

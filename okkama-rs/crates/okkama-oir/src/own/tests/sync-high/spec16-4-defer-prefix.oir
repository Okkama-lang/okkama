oir 2 high
module sync
object R {
    destroy @destroy
}
scope SD action in @destroy
scope SC action in @make
scope S action in @f
func @destroy(%self: R) -> void [destroy R] {
    ^entry in SD:
    ret
}
func @make() -> R [ctor R] {
    boundary BC lexical in SC
    ^entry in SC unwind ^failed:
    %r: R = obj.new R { }
    want %r
    [iprep0] exit.prepare return %r at BC
    result.exit edge normal(0), value %r, demand want, prepare iprep0
    ret %r
    ^failed(%failure: failure) in SC:
    raise %failure
}
enum Stop is Error = (now)
scope SL action in @label
scope ST action in @temporary
scope SE action in @risky
func @label(%r: R) -> void {
    ^entry in SL:
    ret
}
func @temporary() -> void {
    ^entry in ST unwind ^failed:
    %r: R = call @make()
    temp %r, ST
    discard %r
    result.exit edge normal(0), value %r, demand discard, prepare none
    ret
    ^failed(%failure: failure) in ST:
    raise %failure
}
func @risky() -> void {
    ^entry in SE unwind ^failed:
    %error: Stop = enum.case Stop, case 0
    throw %error
    ^failed(%failure: failure) in SE:
    raise %failure
}
func @f() -> void {
    binding b0 "r": R in S
    ^entry in S unwind ^failed:
    %r: R = call @make()
    bind %r, binding b0
    defer.register S, action defer_action(function=@label, bindings=[b0])
    br ^next
    ^next in S unwind ^failed2:
    defer.register S, action defer_action(function=@temporary)
    br ^body
    ^body in S unwind ^failed3:
    call @risky()
    ret
    ^failed(%failure: failure) in S:
    raise %failure
    ^failed2(%failure2: failure) in S:
    raise %failure2
    ^failed3(%failure3: failure) in S:
    raise %failure3
}

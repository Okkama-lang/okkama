oir 2 high
module sync
object R {
    destroy @destroy
}
enum Stop is Error = (now)
scope SD action in @destroy
scope SC action in @make
scope S action in @f
func @destroy(%self: R) -> void [destroy R] {
    ^entry in SD unwind ^failed:
    %error: Stop = enum.case Stop, case 0
    throw %error
    ^failed(%failure: failure) in SD:
    raise %failure
}
func @make() -> R [ctor R] {
    boundary BC lexical in SC
    ^entry in SC unwind ^failed:
    %r: R = obj.new R { }
    want %r
    [iprep0] exit.prepare return %r at BC
    result.exit edge normal(0), value %r, demand want, prepare iprep0
    ret %r
    ^failed(%failure: failure) in SC:
    raise %failure
}
scope SF action in @defer_fail
func @defer_fail() -> void {
    ^entry in SF unwind ^failed:
    %error: Stop = enum.case Stop, case 0
    throw %error
    ^failed(%failure: failure) in SF:
    raise %failure
}
scope SI block in @f parent S
func @f() -> R {
    binding ba "a": R in S
    boundary B0 lexical in S
    ^entry in S unwind ^failed:
    %a: R = call @make()
    bind %a, binding ba
    defer.register S, action defer_action(function=@defer_fail)
    br ^inner
    ^inner in SI unwind ^failed_after:
    %r: R = call @make()
    want %r
    [iprep1] exit.prepare return %r at B0
    result.exit edge normal(0), value %r, demand want, prepare iprep1
    ret %r
    ^failed(%failure: failure) in S:
    raise %failure
    ^failed_after(%after_registration: failure) in S:
    raise %after_registration
}

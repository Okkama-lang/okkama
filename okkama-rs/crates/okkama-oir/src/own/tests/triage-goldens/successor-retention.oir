oir 2 own
module successor_retention

object Child {
    destroy @destroy_child
}

object Res {
    field child: Child
    destroy @destroy_res
}
scope S0 action in @destroy_child
scope S1 action in @destroy_res
scope S2 action in @next
summary M0 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(publication=atomic)
summary M1 call-boundary parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(publication=atomic)
summary M2 call-boundary parameters [parameter_effect(convention=take, retention=some(field(parameter=0,
    field=field_ref(declaration=Res, index=0))), destination=result)] results [result_relation(fresh=[21],
    aliases=[field(parameter=0, field=field_ref(declaration=Res, index=0))], provenance=unbound_result)] contract
    call_contract(results=[^Res], failures=[program], publication=atomic)
summary M3 observation parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(publication=atomic)
summary M4 observation parameters [parameter_effect(convention=borrow, destination=none)] contract
    call_contract(publication=atomic)

func @destroy_child(%0: Child facts(managed(deps=d1))) -> void [destroy Child] abi observation summary(M3) {
    dependency d0: dependency = from_ssa(%3)
    dependency d1: dependency = retention(value=%0, selection=selection(%0))
    ^b0 in S0:
    %1: deps = deps.of %0
    br ^b1(%0, %1)
    ^b1(%2: Child facts(managed(deps=d0)), %3: deps) in S0:
    ret
}

func @destroy_res(%0: Res facts(managed(deps=d1))) -> void [destroy Res] abi observation summary(M4) {
    dependency d0: dependency = from_ssa(%3)
    dependency d1: dependency = retention(value=%0, selection=selection(%0))
    ^b0 in S1:
    %1: deps = deps.of %0
    br ^b1(%0, %1)
    ^b1(%2: Res facts(managed(deps=d0)), %3: deps) in S1:
    ret
}

func @next(%0: Res facts(managed(deps=d1)); %1: deps, %2: own) -> (^Res, own) [successor Res] abi
    explicit(input_packet=2, output_packet=1) summary(M2) {
    boundary B0 lexical in S2
    boundary B1 lexical in S2
    dependency d0: dependency = from_ssa(%6)
    dependency d1: dependency = from_ssa(%1)
    dependency d2: dependency = retention(value=%8, selection=selection(%8))
    dependency d3: dependency = from_ssa(%14)
    dependency d4: dependency = from_ssa(%16)
    dependency d5: dependency = from_ssa(%25)
    dependency d6: dependency = from_ssa(%27)
    dependency d7: dependency = retention(value=%21, selection=selection(%21))
    dependency d8: dependency = from_ssa(%41)
    dependency d9: dependency = from_ssa(%41)
    selection s0: selection = union([selection(%8)])
    selection s1: selection = admissible(s0)
    ^b0 in S2:
    %3: scope<S2> = scope.begin S2
    %4: scope<S2> = own.accept %3, %2
    br ^b1(%0, %1, %4)
    ^b1(%5: Res facts(managed(deps=d0)), %6: deps, %7: scope<S2>) in S2:
    %8: Child facts(managed(deps=d2)) = obj.get %5, child
    %9: deps = deps.of %8
    invoke.own scope.split %7, s1
        normal ^b2($state, $selected, $external_deps, %5, %6, %8, %9)
        unwind ^b3($state, $failure)
    ^b2(%10: scope<S2>, %11: own, %12: deps, %13: Res facts(managed(deps=d3)), %14: deps, %15: Child
        facts(managed(deps=d4)), %16: deps) in S2:
    %17: own = own.join [%11]
    invoke.own obj.next %13 { child: %15; %17 }
        normal ^b4($value, $packet, %10, %13, %14, %15, %16)
        unwind ^b5($packet, $failure, %10)
    ^b3(%18: scope<S2>, %19: failure) in S2:
    %20: failure = scope.unwind %18, %19, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %20
    ^b4(%21: ^Res facts(managed(deps=d7)), %22: own, %23: scope<S2>, %24: Res facts(managed(deps=d5)), %25: deps,
        %26: Child facts(managed(deps=d6)), %27: deps) in S2:
    %28: deps = deps.of %21
    %29: scope<S2> = own.admit %23, %22
    %30: own = own.empty
    %31: pending = exit.prepare return %21, %30, deps(%28) at B1
    invoke.own scope.split %29, selection(%21)
        normal ^b6($state, $selected, $external_deps, %21, %28, %31)
        unwind ^b7($state, $failure, %31)
    ^b5(%32: own, %33: failure, %34: scope<S2>) in S2:
    %35: scope<S2> = own.admit %34, %32
    %36: failure = scope.unwind %35, %33, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %36
    ^b6(%37: scope<S2>, %38: own, %39: deps, %40: ^Res facts(managed(deps=d8)), %41: deps, %42: pending) in S2:
    %43: pending = exit.extend %42, %38
    (%44: closed, %45: pending) = scope.end %37, reserve %43, effects scope_effects(failures=[], suspends=false,
        cancel=false)
    (%46: ^Res facts(managed(deps=d9)), %47: own, %48: deps) = exit.commit %45, destination caller, result ^Res
    ret %46, %47
    ^b7(%49: scope<S2>, %50: failure, %51: pending) in S2:
    %52: failure = scope.unwind %49, %50, reserve %51, effects scope_effects(failures=[], suspends=false, cancel=false)
    raise %52
}

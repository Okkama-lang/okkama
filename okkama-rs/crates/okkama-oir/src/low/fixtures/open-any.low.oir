    ^b19(%66: cleanup-state, %67: failure) in S2:
    [i22] %68: cleanup-state = cleanup.failure %66, %67
    br ^b17(%68)
    ^b20(%69: cleanup-state) in S2:
    [i23] (%70: closed, %71: failure-state, %72: exit-state) = cleanup.finish %69
    exit.dispatch 2 %70 %71 %72 failure ^b16($failure)
}

oir 2 own
module unwind_local_parameter
scope S action in @main
summary M0 internal parameters [parameter_effect(convention=borrow, destination=none)]
    contract call_contract(failures=[program], publication=atomic)
func @main(%seed: int) -> void summary(M0) {
^entry in S:
    %q: scope<S> = scope.begin S
    %closed: closed = scope.end %q, effects scope_effects()
    br ^trap(%seed)
^trap(%local: int) in S unwind ^failed(%local):
    trap confirm "failed"
^failed(%carried: int, %failure: failure) in S:
    raise %failure
}

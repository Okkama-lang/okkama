module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "xml/parse" take ParsedXml;

// An RSS feed of 20 items with a namespace, entities, CDATA and comments (~5 KB).
object Bench {
    has text is string;
    Bench() {
        let items is @string = (0..20).map() -> i {
            let s = i.string();
            "  <item>\n    <title>Item " + s + " &amp; more</title>\n    <link>https://example.org/" + s +
                "</link>\n    <dc:creator>Ann &lt;ann@example.org&gt;</dc:creator>\n" +
                "    <description><![CDATA[<p>Body of item " + s + "</p>]]></description>\n" +
                "    <category domain=\"tags\">news</category><!-- note " + s + " -->\n  </item>\n";
        };
        text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\">\n<channel>\n" +
            "  <title>Feed</title>\n" + items.join("") + "</channel>\n</rss>\n";
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let channel = ParsedXml(text).document().root().children("channel")[0];
        self.run(i + 1, n, acc + (channel.children("item").size() + channel.text("title").length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

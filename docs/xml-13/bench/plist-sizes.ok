module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "plist/parse" take ParsedPlist;
import "encoding/utf" take Utf8Encoded;
import "cli/arguments" take ProcessArguments;
import "os/environment" take Environment;

// SIZE=small: 5 keys; medium: 40 entries (~200 nodes); large: 600 entries (~3600 nodes, ~150 KB).
object Bench {
    has bytes is @byte;
    Bench(size is string) {
        let count = if size == "small" { 1; } else if size == "medium" { 40; } else { 600; };
        let entries is @string = (0..count).map() -> i {
            let s = i.string();
            "  <key>entry" + s + "</key>\n  <dict>\n    <key>name</key><string>Entry " + s + " &amp; co</string>\n" +
                "    <key>count</key><integer>" + s + "</integer>\n    <key>ratio</key><real>0.5</real>\n" +
                "    <key>on</key><true/>\n    <key>list</key><array><string>a</string><integer>1</integer></array>\n  </dict>\n";
        };
        let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
            "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n" +
            "<plist version=\"1.0\">\n<dict>\n" + entries.join("") + "</dict>\n</plist>\n";
        bytes = Utf8Encoded(text).bytes();
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let root = ParsedPlist(bytes, 4194304, 10000, 64).dictionary();
        self.run(i + 1, n, acc + root.get("entry0").int("count") + 1);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench(Environment().text("SIZE"));
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

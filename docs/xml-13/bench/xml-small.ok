module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "xml/parse" take ParsedXml;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let text = "<item id=\"" + i.string() + "\"><title>Tea &amp; cake</title></item>";
        let root = ParsedXml(text).document().root();
        self.run(i + 1, n, acc + (root.attribute("id").length() + root.text("title").length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

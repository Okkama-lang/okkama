module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "xml/parse" take ParsedXml;

// 2000 records with attributes, nested elements and entities (~500 KB).
object Bench {
    has text is string;
    Bench() {
        let records is @string = (0..2000).map() -> i {
            let s = i.string();
            "<record id=\"" + s + "\" kind=\"entry\" lang='en'>\n  <name>Record " + s + "</name>\n" +
                "  <value unit=\"kg\">" + s + ".25</value>\n  <note>Fish &amp; chips &lt;" + s + "&gt;</note>\n" +
                "  <tags><tag>a</tag><tag>b</tag><tag>c</tag></tags>\n  <empty/>\n" +
                "  <text>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.</text>\n</record>\n";
        };
        text = "<?xml version=\"1.0\"?>\n<records>\n" + records.join("") + "</records>\n";
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let records = ParsedXml(text).document().root().children("record");
        self.run(i + 1, n, acc + (records.size() + records[1999].attribute("id").length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

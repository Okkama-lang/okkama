module app v1.0.0;

import "io/stdout" take Stdout;
import "async/event" take Event;

object Conn {
    has closing is Event;
    has gate is Event;
    Conn(:closing, :gate);
    async destroy {
        closing.set();
        await gate.wait();
        Stdout().writeln("conn closed");
    }
}

object Opener {
    has closing is Event;
    has gate is Event;
    Opener(:closing, :gate);
    async run() is int {
        let c = Conn(closing: closing, gate: gate);
        Stdout().writeln("body done");
        7;
    }
}

async main() is int {
    let closing = Event();
    let gate = Event();
    let task = spawn Opener(closing: closing, gate: gate).run();
    await closing.wait();
    task.cancel();
    Stdout().writeln("cancel requested");
    gate.set();
    let r = try { await task; } catch e is Cancelled { -1; };
    Stdout().writeln("result " + r.string() + " cancelled " + task.cancelled().string());
    0;
}

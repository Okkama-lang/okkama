module app v1.0.0;

import "io/stdout" take Stdout;
import "async/event" take Event;

object Child {
    has go is Event;
    Child(:go);
    async run() is int {
        await go.wait();
        42;
    }
}

object Worker {
    has ready is Event;
    has go is Event;
    has child is Future<int>;
    Worker(:ready, :go, :child);
    // The cancellation arrives after the last await has settled: the result stands.
    async run() is int {
        defer Stdout().writeln("worker cleanup");
        await ready.wait();
        go.set();
        let v = await child;
        Stdout().writeln("worker observed " + v.string());
        v;
    }
}

async main() is int {
    let ready = Event();
    let go = Event();
    let child = spawn Child(go: go).run();
    let worker = spawn Worker(ready: ready, go: go, child: child).run();
    ready.set();
    Stdout().writeln("main observed " + (await child).string());
    worker.cancel();
    Stdout().writeln("cancel requested");
    let r = try { await worker; } catch e is Cancelled { -1; };
    Stdout().writeln("worker returned " + r.string() + ", cancelled " + worker.cancelled().string());
    0;
}

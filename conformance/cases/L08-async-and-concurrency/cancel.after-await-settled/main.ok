module app v1.0.0;

import "io/stdout" take Stdout;
import "async/event" take Event;

object Child {
    has go is Event;
    Child(:go);
    async run() is int {
        await go.wait();
        42;
    }
}

object Worker {
    has ready is Event;
    has go is Event;
    has never is Event;
    has child is Future<int>;
    Worker(:ready, :go, :never, :child);
    async run() is int {
        defer Stdout().writeln("worker cleanup");
        await ready.wait();
        go.set();
        let v = await child;
        Stdout().writeln("worker observed " + v.string());
        await never.wait();
        Stdout().writeln("worker not cancelled");
        v;
    }
}

async main() is int {
    let ready = Event();
    let go = Event();
    let never = Event();
    let child = spawn Child(go: go).run();
    let worker = spawn Worker(ready: ready, go: go, never: never, child: child).run();
    ready.set();
    let v = await child;
    Stdout().writeln("main observed " + v.string());
    worker.cancel();
    Stdout().writeln("cancel requested");
    let r = try { await worker; } catch e is Cancelled { -1; };
    Stdout().writeln(r.string());
    0;
}

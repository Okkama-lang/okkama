module app v1.0.0;

import "conformance/check" take Checks;
import "numbers/bigrational" take BigRational, ZeroBigRationalDenominator;

main() is int {
    let c = Checks();
    c = c.same_text(
        "sum",
        (BigRational(numerator: 1, denominator: 3).plus(BigRational(numerator: 1, denominator: 6))).string(),
        "1/2"
    );
    c = c.same_text(
        "negative denominator normalised",
        BigRational(numerator: 2, denominator: -4).denominator().string(),
        "2"
    );
    c.done();
}

module app v1.0.0;

import "conformance/check" take Checks;
import "json" take Json, ParsedJson, JsonError;

main() is int {
    let c = Checks();
    let doc = ParsedJson("{\"nil\":null,\"empty\":\"\",\"zero\":0,\"flag\":false,\"decimal\":1.25,\"big\":9223372036854775808,\"items\":[],\"object\":{}}").root();
    c = c.same_bool("node preserves missing", match doc.presence("absent").node() { case Presence.missing: true; case _: false; }, true);
    c = c.same_bool("node folds missing", match doc.maybe("absent").node() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("node preserves none", match doc.presence("nil").node() { case Presence.none: true; case _: false; }, true);
    c = c.same_bool("node folds none", match doc.maybe("nil").node() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("object preserves missing", match doc.presence("absent").object() { case Presence.missing: true; case _: false; }, true);
    c = c.same_bool("object folds missing", match doc.maybe("absent").object() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("object preserves none", match doc.presence("nil").object() { case Presence.none: true; case _: false; }, true);
    c = c.same_bool("object folds none", match doc.maybe("nil").object() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("text preserves missing", match doc.presence("absent").text() { case Presence.missing: true; case _: false; }, true);
    c = c.same_bool("text folds missing", match doc.maybe("absent").text() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("text preserves none", match doc.presence("nil").text() { case Presence.none: true; case _: false; }, true);
    c = c.same_bool("text folds none", match doc.maybe("nil").text() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("int preserves missing", match doc.presence("absent").int() { case Presence.missing: true; case _: false; }, true);
    c = c.same_bool("int folds missing", match doc.maybe("absent").int() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("int preserves none", match doc.presence("nil").int() { case Presence.none: true; case _: false; }, true);
    c = c.same_bool("int folds none", match doc.maybe("nil").int() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("boolean preserves missing", match doc.presence("absent").boolean() { case Presence.missing: true; case _: false; }, true);
    c = c.same_bool("boolean folds missing", match doc.maybe("absent").boolean() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("boolean preserves none", match doc.presence("nil").boolean() { case Presence.none: true; case _: false; }, true);
    c = c.same_bool("boolean folds none", match doc.maybe("nil").boolean() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("number preserves missing", match doc.presence("absent").number() { case Presence.missing: true; case _: false; }, true);
    c = c.same_bool("number folds missing", match doc.maybe("absent").number() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("number preserves none", match doc.presence("nil").number() { case Presence.none: true; case _: false; }, true);
    c = c.same_bool("number folds none", match doc.maybe("nil").number() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("integer preserves missing", match doc.presence("absent").integer() { case Presence.missing: true; case _: false; }, true);
    c = c.same_bool("integer folds missing", match doc.maybe("absent").integer() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("integer preserves none", match doc.presence("nil").integer() { case Presence.none: true; case _: false; }, true);
    c = c.same_bool("integer folds none", match doc.maybe("nil").integer() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("list preserves missing", match doc.presence("absent").list() { case Presence.missing: true; case _: false; }, true);
    c = c.same_bool("list folds missing", match doc.maybe("absent").list() { case Maybe.none: true; case _: false; }, true);
    c = c.same_bool("list preserves none", match doc.presence("nil").list() { case Presence.none: true; case _: false; }, true);
    c = c.same_bool("list folds none", match doc.maybe("nil").list() { case Maybe.none: true; case _: false; }, true);
    c = c.same_text("maybe reads empty", (doc.maybe("empty").text() else panic "unexpected absence"), "");
    c = c.same_text("presence reads empty", (doc.presence("empty").text().fold() else panic "unexpected absence"), "");
    c = c.same_int("maybe reads zero", (doc.maybe("zero").int() else panic "unexpected absence"), 0);
    c = c.same_int("presence reads zero", (doc.presence("zero").int().fold() else panic "unexpected absence"), 0);
    c = c.same_bool("maybe reads flag", (doc.maybe("flag").boolean() else panic "unexpected absence"), false);
    c = c.same_bool("presence reads flag", (doc.presence("flag").boolean().fold() else panic "unexpected absence"), false);
    c = c.same_text("maybe reads decimal", (doc.maybe("decimal").number() else panic "unexpected absence").string(), "1.25");
    c = c.same_text("presence reads decimal", (doc.presence("decimal").number().fold() else panic "unexpected absence").string(), "1.25");
    c = c.same_text("maybe reads big", (doc.maybe("big").integer() else panic "unexpected absence").string(), "9223372036854775808");
    c = c.same_text("presence reads big", (doc.presence("big").integer().fold() else panic "unexpected absence").string(), "9223372036854775808");
    c = c.same_int("maybe reads items", (doc.maybe("items").list() else panic "unexpected absence").size(), 0);
    c = c.same_int("presence reads items", (doc.presence("items").list().fold() else panic "unexpected absence").size(), 0);
    c = c.same_int("maybe reads object", (doc.maybe("object").object() else panic "unexpected absence").names().size(), 0);
    c = c.same_int("presence reads object", (doc.presence("object").object().fold() else panic "unexpected absence").names().size(), 0);
    c = c.same_text("lazy fallback", doc.maybe("empty").text() else panic "eager fallback", "");
    c = c.same_text("missing fallback", doc.maybe("absent").text() else "guest", "guest");
    c = c.same_text("null fallback", doc.presence("nil").text().fold() else "guest", "guest");
    c = c.same_text("maybe rejects zero as text", try { doc.maybe("zero").text(); "no error"; } catch JsonError.wrong_kind(pointer, _, _) { pointer; }, "/zero");
    c = c.same_text("maybe rejects decimal as int", try { doc.maybe("decimal").int(); "no error"; } catch JsonError.invalid_number(location, _, _) { location; }, "/decimal");
    c = c.same_text("maybe rejects big as int", try { doc.maybe("big").int(); "no error"; } catch JsonError.invalid_number(location, _, _) { location; }, "/big");
    c = c.same_text("maybe rejects flag as list", try { doc.maybe("flag").list(); "no error"; } catch JsonError.wrong_kind(pointer, _, _) { pointer; }, "/flag");
    c = c.same_text("maybe rejects items as object", try { doc.maybe("items").object(); "no error"; } catch JsonError.wrong_kind(pointer, _, _) { pointer; }, "/items");
    c = c.same_text("maybe rejects object as list", try { doc.maybe("object").list(); "no error"; } catch JsonError.wrong_kind(pointer, _, _) { pointer; }, "/object");
    c = c.same_bool("maybe rejects scalar parent", try { Json(0).maybe("name"); false; } catch JsonError.wrong_kind(_, _, _) { true; }, true);
    c = c.same_text("presence rejects zero as text", try { doc.presence("zero").text(); "no error"; } catch JsonError.wrong_kind(pointer, _, _) { pointer; }, "/zero");
    c = c.same_text("presence rejects decimal as int", try { doc.presence("decimal").int(); "no error"; } catch JsonError.invalid_number(location, _, _) { location; }, "/decimal");
    c = c.same_text("presence rejects big as int", try { doc.presence("big").int(); "no error"; } catch JsonError.invalid_number(location, _, _) { location; }, "/big");
    c = c.same_text("presence rejects flag as list", try { doc.presence("flag").list(); "no error"; } catch JsonError.wrong_kind(pointer, _, _) { pointer; }, "/flag");
    c = c.same_text("presence rejects items as object", try { doc.presence("items").object(); "no error"; } catch JsonError.wrong_kind(pointer, _, _) { pointer; }, "/items");
    c = c.same_text("presence rejects object as list", try { doc.presence("object").list(); "no error"; } catch JsonError.wrong_kind(pointer, _, _) { pointer; }, "/object");
    c = c.same_bool("presence rejects scalar parent", try { Json(0).presence("name"); false; } catch JsonError.wrong_kind(_, _, _) { true; }, true);
    c.done();
}

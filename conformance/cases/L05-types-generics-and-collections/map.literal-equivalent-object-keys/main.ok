module app v1.0.0;

import "io/stdout" take Stdout;

object Key {
    has id is int;
    Key(:id);
}

main() is int {
    let out = Stdout();
    let first = Key(id: 1);
    let second = Key(id: 1);
    out.writeln("before");
    let m = [first: "first", second: "second"];
    out.writeln("unreachable " + m.size().string());
    0;
}

module app v1.0.0;

import "io/stdout" take Stdout;

object Probe {
    Probe();

    // Never evaluated: a literal condition runs only the selected branch.
    unused() is @int { panic "the other branch ran"; }

    pick(c is bool) is @int { if c { [1]; } else { []; }; }
}

main() is int {
    let out = Stdout();
    let p = Probe();
    let c = false;
    // A literal condition, an empty collection on the selected side.
    out.writeln(((if false { [1]; } else { []; }) == []).string() + " " + ((if true { []; } else { [1]; }) == []).string()
        + " " + ((if false { ["k": 1]; } else { [:]; }) == [:]).string() + " " + ((if false { [[1]]; } else { []; }) == []).string());
    // The same with a variable condition.
    out.writeln(((if c { [1]; } else { []; }) == []).string() + " " + ((if !c { []; } else { [1]; }) == []).string());
    // Typed bindings, action results, method calls and a later concatenation.
    let typed is @int = if false { [1]; } else { []; };
    out.writeln(typed.size().string() + " " + p.pick(false).size().string() + " " + ((if true { []; } else { [1]; }) + [5]).size().string());
    // Only the selected branch runs.
    out.writeln(((if true { []; } else { p.unused(); }) == []).string() + " " + (if false { p.unused(); } else { [7]; })[0].string());
    // An ordinary if keeps working.
    out.writeln(((if false { [1]; } else { []; }) == []).string());
    0;
}

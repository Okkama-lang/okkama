module runtime/uuid v1.0.0;

// The native layer under uuid/generation: the calls that module makes into the
// host runtime. Programs use that module instead; these declarations may
// change with the runtime.

// A name-based UUID (version 3 or 5) of name in namespace.
native uuid_named(
    namespace is @byte,
    name is @byte,
    version is int,
) is @byte;

module html/entities v1.0.0;

// HTML escaping and unescaping of text.
//
//     EscapedHtml("<Ada & Bob>").string();                   // "&lt;Ada &amp; Bob&gt;"
//     EscapedHtml(origin: title, quotes: true).string();     // for attribute values
//     UnescapedHtml("caf&eacute; &lt;3").string();           // "café <3"
//
// Escaping is not sanitizing: it makes text safe as text or as a quoted
// attribute value, nothing more. Unescaping knows all 2231 named references of
// the HTML standard.

import "html/events" take HtmlEvents, HandlingHtmlEvent, StartingHtmlTag, EndingHtmlTag,
    ContainingHtmlText, ContainingHtmlComment, DeclaringHtml, ProcessingHtmlInstruction;
import "async/atomic" take Atomic;

// Text with `&`, `<` and `>` escaped, and quotes too when asked.
object EscapedHtml {
    has origin is string;
    has quotes is bool;

    // Escapes origin for text.
    EscapedHtml(origin is string) {
        self.origin = origin;
        self.quotes = false;
    }

    // Escapes origin; quotes also escapes `"` and `'` for attribute values.
    EscapedHtml(origin is string, quotes is bool) {
        self.origin = origin;
        self.quotes = quotes;
    }

    // The escaped text; existing references are escaped again.
    string() is string {
        // Ampersands first: later replacements introduce entity ampersands.
        let escaped = origin.replace("&", "&amp;")
            .replace("<", "&lt;").replace(">", "&gt;");
        if quotes {
            escaped.replace("\"", "&quot;").replace("'", "&#39;");
        }
        else {
            escaped;
        }
    }
}

// Character-reference-decoded text, using HTML text-context recovery rules.
// Construction retains source only. string() decodes once, preserving literal
// markup and all non-reference scalars (including NUL and CRLF). Unknown names
// and digitless numeric references stay literal; invalid numeric scalars become
// U+FFFD and HTML C1 replacements apply. This is not attribute-context decoding,
// document parsing, sanitization or recursive decoding of the resulting text.
// The hidden tokenizer uses the pinned 2231-spelling table in Okkama.
// Example: UnescapedHtml("<b>&amp;lt;</b>").string() == "<b>&lt;</b>".
// Each observation uses O(n) temporary memory; no native registry handle,
// external resources or I/O. Repeated observations agree.
object UnescapedHtml {
    has origin is string;

    // The text.
    UnescapedHtml(origin is string) {
        self.origin = origin;
    }

    // The decoded text; unknown names stay as written.
    string() is string {
        if origin == "" {
            "";
        }
        else {
            // Prevent markup recognition without escaping original references.
            // No literal '<' remains: exactly one text event, decoded once.
            let text = HtmlDecodedText();
            for HtmlEvents(origin.replace("<", "&lt;")) -> event {
                event.dispatch(text);
            }
            text.string();
        }
    }
}

test "HTML reference decoding preserves markup and is not recursive" {
    test.is(UnescapedHtml("").string(), "");
    test.is(UnescapedHtml("<b>&amp;lt;</b>").string(), "<b>&lt;</b>");
    test.is(UnescapedHtml("<!--&copy;-->").string(), "<!--©-->");
}

test "HTML named and numeric recovery" {
    test.is(UnescapedHtml("&notin; &notit; &unknown;").string(), "∉ ¬it; &unknown;");
    test.is(UnescapedHtml("&#65 &#x41; &#X1F600;").string(), "A A 😀");
    test.is(UnescapedHtml("&#0; &#xD800; &#128;").string(), "� � €");
}

test "HTML decoding repeats and composes with escaping" {
    let source = "<&amp;\"'é>";
    let value = UnescapedHtml(EscapedHtml(origin: source, quotes: true).string());
    test.is(value.string(), source);
    test.is(value.string(), source);
}

test "HTML text and quotation policies" {
    test.is(EscapedHtml("&<>\"'").string(), "&amp;&lt;&gt;\"'");
    test.is(EscapedHtml(origin: "&<>\"'", quotes: false).string(), "&amp;&lt;&gt;\"'");
    test.is(EscapedHtml(origin: "&<>\"'", quotes: true).string(), "&amp;&lt;&gt;&quot;&#39;");
}

test "HTML escaping preserves empty text Unicode and whitespace" {
    test.is(EscapedHtml("").string(), "");
    test.is(EscapedHtml(origin: "", quotes: true).string(), "");
    test.is(EscapedHtml("é é 😀\t\r\n").string(), "é é 😀\t\r\n");
}

test "HTML references are ordinary source and queries repeat" {
    let source = "&amp; <";
    let escaped = EscapedHtml(source);
    test.is(escaped.string(), "&amp;amp; &lt;");
    test.is(escaped.string(), "&amp;amp; &lt;");
    test.is(source, "&amp; <");
}

hidden object HtmlDecodedText does HandlingHtmlEvent {
    has text is Atomic<string>;

    HtmlDecodedText() {
        text = Atomic("");
    }

    handle(event is ContainingHtmlText) is void {
        text.replace(event.text());
    }

    handle(event is StartingHtmlTag) is void {}

    handle(event is EndingHtmlTag) is void {}

    handle(event is ContainingHtmlComment) is void {}

    handle(event is DeclaringHtml) is void {}

    handle(event is ProcessingHtmlInstruction) is void {}

    string() is string {
        text.value();
    }
}

test "HTML numeric references recover scalar limits overflow and leading zeros" {
    test.is(
        UnescapedHtml("&#0;|&#xD7FF;|&#xD800;|&#xDFFF;|&#xE000;|&#x10FFFF;|&#x110000;").string(),
        "�|\u{d7ff}|�|�|\u{e000}|\u{10ffff}|�"
    );
    test.is(
        UnescapedHtml(
            "&#999999999999999999999; &#xFFFFFFFFFFFFFFFF; &#000000000000000000065; &#x0000000000041;"
        ).string(),
        "� � A A"
    );
    test.is(
        UnescapedHtml("&#; &#x; &#Xz; &#-1; &#65z &#X41z").string(),
        "&#; &#x; &#Xz; &#-1; Az Az"
    );
    test.is(
        UnescapedHtml("&#128; &#129; &#130; &#159; &#160; &#13;").string(),
        "€ \u{81} ‚ Ÿ \u{a0} \r"
    );
}

test "HTML named references use longest case sensitive spellings and multiple scalars" {
    test.is(
        UnescapedHtml("&NotEqualTilde; &fjlig; &notin; &notit; &AMP; &Amp; &acE;").string(),
        "≂̸ fj ∉ ¬it; & &Amp; ∾̳"
    );
    test.is(UnescapedHtml("é\u{0}\r\n &amp;lt; <&copy;>").string(), "é\u{0}\r\n &lt; <©>");
}

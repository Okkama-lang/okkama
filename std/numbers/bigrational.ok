module numbers/bigrational v1.0.0;

// Canonical exact ratio: positive denominator, gcd=1, unique zero 0/1.
//
//     let third = BigRational(numerator: 1, denominator: 3);
//     third.plus(third).string();    // "2/3"
//     third.divided(third).string(); // "1/1"

import "compare" take Comparing, Order;

// An exact fraction of two ints, always reduced: 2/4 is 1/2.
object BigRational does Comparing<BigRational> {
    has upper, lower is int;

    // The ratio is reduced here, so equal ratios have equal fields and compare
    // equal.
    BigRational(numerator is int, denominator is int) {
        confirm denominator.sign() != 0 else throw ZeroBigRationalDenominator.zero;
        let canonical = rat(numerator, denominator);
        upper = canonical.numerator();
        lower = canonical.denominator();
    }

    // The numerator, with the sign.
    numerator() is int {
        upper;
    }

    // The denominator, always positive.
    denominator() is int {
        lower;
    }

    // Compares the values.
    order(other is BigRational) is Order {
        let left = (upper * other.denominator());
        let right = (other.numerator() * lower);
        left.order(right);
    }

    // `numerator/denominator`: "2/3".
    string() is string {
        upper.string() + "/" + lower.string();
    }

    // The exact sum.
    plus(other is BigRational) is BigRational {
        BigRational(
            numerator: (upper * other.denominator() + other.numerator() * lower),
            denominator: (lower * other.denominator())
        );
    }

    // The exact difference.
    minus(other is BigRational) is BigRational {
        BigRational(
            numerator: (upper * other.denominator() - other.numerator() * lower),
            denominator: (lower * other.denominator())
        );
    }

    // The exact product.
    times(other is BigRational) is BigRational {
        BigRational(
            numerator: (upper * other.numerator()),
            denominator: (lower * other.denominator())
        );
    }

    // The exact quotient; BigRationalDivisionByZero for zero.
    divided(other is BigRational) is BigRational {
        confirm other.numerator().sign() != 0 else throw BigRationalDivisionByZero.by_zero;
        BigRational(
            numerator: (upper * other.denominator()),
            denominator: (lower * other.numerator())
        );
    }
}

// A denominator of zero.
enum ZeroBigRationalDenominator is Error = (zero);

// Division by zero.
enum BigRationalDivisionByZero is Error = (by_zero);

test "511 rational int components normalize every sign without narrowing" {
    for [7, -7, 123456789012345678901234567890, -123456789012345678901234567890] -> a {
        for [2, -2] -> b {
            let value = BigRational(numerator: a, denominator: b);
            test.is(rat(value.numerator(), value.denominator()), rat(a, b));
            test.ok(value.denominator() > 0);
        }
    }
    test.is(BigRational(numerator: 12, denominator: -18).string(), "-2/3");
    test.is(BigRational(numerator: 0, denominator: -18).string(), "0/1");
    test.ok(try {
        BigRational(numerator: 1, denominator: 0);
        false;
    }
    catch error is ZeroBigRationalDenominator {
        true;
    });
}

test "rationals add, subtract, multiply and divide exactly" {
    let half = BigRational(numerator: 1, denominator: 2);
    let third = BigRational(numerator: 1, denominator: 3);
    test.is(half.plus(third).string(), "5/6");
    test.is(half.minus(third).string(), "1/6");
    test.is(third.minus(half).string(), "-1/6");
    test.is(half.times(third).string(), "1/6");
    test.is(half.divided(third).string(), "3/2");
    let zero = BigRational(numerator: 0, denominator: 5);
    test.ok(try {
        half.divided(zero);
        false;
    }
    catch e is BigRationalDivisionByZero {
        true;
    });
}

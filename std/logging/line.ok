module logging/line v1.0.0;

// Log records as lines: text for people, JSON for machines.
//
//     TextLogLine(origin: record, zone: utc).string();
//     JsonLogLine(record).string();          // {"time": …, "level": …, "logger": …, "message": …}

import "logging/record" take LogRecord, LogContext, InvalidLogProcess;
import "logging/level" take LogLevelName, LogLevel;
import "json" take Json, JsonField, ParsedJson;
import "time/zone" take TimeZone, FixedZone;
import "time/duration" take Duration;
import "time/rfc3339" take Rfc3339;
import "encoding/utf" take Utf8Encoded;
import "runtime/unicode_character";
import "logging/field" take LogFields;
import "logging/name" take LogName;
import "time/clock" take Instant;
import "math/decimal" take Decimal;

// A record as a text line.
object TextLogLine {
    has origin is LogRecord;
    has zone is TimeZone;

    // origin, its time in zone.
    TextLogLine(origin is LogRecord, zone is TimeZone) {
        self.origin = origin;
        self.zone = zone;
    }

    // `time level=INFO name="shop" process=8 message="…" fields={…}`.
    string() is string {
        let time = origin.time();
        let context = origin.context();
        let name = BoundedLogJson(Json(context.name().string())).string();
        let message = BoundedLogJson(Json(origin::Entry::message)).string();
        let fields = BoundedLogJson(context.fields().values()).string();
        let cause = if origin.has_cause() {
            " cause=" + BoundedLogJson(Json(origin.cause().text())).string();
        }
        else {
            "";
        };
        PhysicalLogLine(
            Rfc3339(origin: time, offset: zone.offset(time)).string() + " level=" + LogLevelName(
                origin::Entry::level
            ).string() + " name=" + name + " process=" + context.process()
                .string() + " message=" + message + " fields=" + fields + cause
        ).string();
    }
}

// A record as a JSON line.
object JsonLogLine {
    has origin is LogRecord;

    // origin.
    JsonLogLine(origin is LogRecord) {
        self.origin = origin;
    }

    // The JSON object, with the cause's text when there is one.
    string() is string {
        let context = origin.context();
        let members is @JsonField = [
            JsonField(
                "time",
                Rfc3339(origin: origin.time(), offset: Duration(seconds: 0.rat())).string()
            ),
            JsonField("level", LogLevelName(origin::Entry::level).string()),
            JsonField("name", context.name().string()),
            JsonField("process", context.process()),
            JsonField("message", origin::Entry::message),
            JsonField("fields", context.fields().values())
        ];
        let complete is @JsonField = if origin.has_cause() {
            members + [JsonField("cause", origin.cause().text())];
        }
        else {
            members;
        };
        PhysicalLogLine(BoundedLogJson(Json(complete)).string()).string();
    }
}

hidden object BoundedLogJson {
    has origin is Json;

    BoundedLogJson(origin is Json) {
        self.origin = origin;
    }

    // Compact text of at most 34 levels and 1 MiB.
    string() is string {
        let text = origin.string();
        confirm Utf8Encoded(text).bytes().size() <= 1048576 else throw LogLineLimit.exceeded;
        ParsedJson(text, 34).root();
        text;
    }
}

// JSON already escapes C0. Escape remaining terminal controls and Unicode line
// separators without altering quoting, so text and JSON remain one line.
hidden object PhysicalLogLine {
    has origin is string;

    PhysicalLogLine(origin is string) {
        self.origin = origin;
    }

    string() is string {
        confirm origin.length() <= 1048576 else throw LogLineLimit.exceeded;
        if unicode_character.display_invalid_index(origin) < 0 {
            confirm Utf8Encoded(origin).bytes().size() <= 1048576 else throw LogLineLimit.exceeded;
            return origin;
        }
        let digits = "0123456789abcdef";
        // Code points, compared by code (#172): C0 and DEL, C1, U+2028, U+2029.
        let parts is @string = origin.characters().map() -> character {
            let code = character.code();
            if code < 32 || code == 127 || (code >= 128 && code < 160) {
                let high = (code / 16).int();
                let low = code % 16;
                "\\u00" + digits.slice(high, high + 1) + digits.slice(low, low + 1);
            }
            else if code == 8232 {
                "\\u2028";
            }
            else if code == 8233 {
                "\\u2029";
            }
            else {
                character.string();
            }
        };
        let result = parts.join("");
        confirm Utf8Encoded(result).bytes().size() <= 1048576 else throw LogLineLimit.exceeded;
        result;
    }
}

// A line over the size limit.
enum LogLineLimit is Error = (exceeded);

test "a record is one physical line of text or JSON, quotes escaped" {
    let record = LogRecord(
        occurred: Instant(Duration(seconds: 1700000000.rat())),
        level: LogLevel.warning,
        message: "slow \"query\"",
        context: LogContext(
            name: LogName("app", "db"),
            fields: LogFields(JsonField("ms", 900)),
            process: 7
        ),
        cause: InvalidLogProcess.invalid,
    );
    test.is(
        TextLogLine(
            origin: record,
            zone: FixedZone(name: "UTC", offset: Duration(seconds: 0.rat()))
        ).string(),
        "2023-11-14T22:13:20Z level=WARNING name=\"app.db\" process=7 message=\"slow \\\"query\\\"\" fields={\"ms\":900} cause=\"InvalidLogProcess.invalid\""
    );
    test.is(
        JsonLogLine(record).string(),
        "{\"time\":\"2023-11-14T22:13:20Z\",\"level\":\"WARNING\",\"name\":\"app.db\",\"process\":7,\"message\":\"slow \\\"query\\\"\",\"fields\":{\"ms\":900},\"cause\":\"InvalidLogProcess.invalid\"}"
    );
}

test "a physical line escapes terminal controls and line separators only" {
    let text = "a" + 7.char().string() + "б" + 127.char().string() + 133.char().string() + "в" +
        8232.char().string() + 8233.char().string() + "\tж";
    test.is(PhysicalLogLine(text).string(), "a\\u0007б\\u007f\\u0085в\\u2028\\u2029\\u0009ж");
    test.is(PhysicalLogLine("plain ж").string(), "plain ж");
}

test "text and JSON lines stay byte for byte: levels, field kinds, controls, zones" {
    let utc = FixedZone(name: "UTC", offset: Duration(seconds: 0.rat()));
    let east = FixedZone(name: "IST", offset: Duration(seconds: 19800.rat()));
    let west = FixedZone(name: "PST", offset: Duration(seconds: (-28800).rat()));
    let plain = LogContext(name: LogName("app"), fields: LogFields(), process: 1);
    let at = Instant(Duration(seconds: 1700000000.rat()));
    let up = LogRecord(occurred: at, level: LogLevel.info, message: "up", context: plain);
    test.is(
        TextLogLine(origin: up, zone: utc).string(),
        "2023-11-14T22:13:20Z level=INFO name=\"app\" process=1 message=\"up\" fields={}"
    );
    test.is(
        JsonLogLine(up).string(),
        "{\"time\":\"2023-11-14T22:13:20Z\",\"level\":\"INFO\",\"name\":\"app\",\"process\":1,\"message\":\"up\",\"fields\":{}}"
    );
    let empty = LogRecord(occurred: at, level: LogLevel.info, message: "", context: plain);
    test.is(
        TextLogLine(origin: empty, zone: utc).string(),
        "2023-11-14T22:13:20Z level=INFO name=\"app\" process=1 message=\"\" fields={}"
    );
    test.is(
        JsonLogLine(empty).string(),
        "{\"time\":\"2023-11-14T22:13:20Z\",\"level\":\"INFO\",\"name\":\"app\",\"process\":1,\"message\":\"\",\"fields\":{}}"
    );
    let kinds = LogFields(
        JsonField("int", -42),
        JsonField("str", "a \"b\" \\c"),
        JsonField("yes", true),
        JsonField("no", false),
        JsonField("float", 1.5),
        JsonField("tiny", 0.0000001),
        JsonField("dec", Decimal("12.50")),
        JsonField("null", Json()),
        JsonField("obj", ParsedJson("{\"k\":[1,2,{\"z\":null}]}").root()),
        JsonField("arr", Json([Json(1), Json("x")])),
        JsonField("big", 123456789012345678901.0)
    );
    let typed = LogRecord(
        occurred: Instant(Duration(seconds: rat(1700000000123456789, 1000000000))),
        level: LogLevel.debug,
        message: "привет 🙂 «ok» 中文",
        context: LogContext(name: LogName("shop", "db", "pool"), fields: kinds, process: 123456)
    );
    test.is(
        TextLogLine(origin: typed, zone: utc).string(),
        "2023-11-14T22:13:20.123456789Z level=DEBUG name=\"shop.db.pool\" process=123456 message=\"привет 🙂 «ok» 中文\" fields={\"int\":-42,\"str\":\"a \\\"b\\\" \\\\c\",\"yes\":true,\"no\":false,\"float\":1.5,\"tiny\":1e-7,\"dec\":12.5,\"null\":null,\"obj\":{\"k\":[1,2,{\"z\":null}]},\"arr\":[1,\"x\"],\"big\":123456789012345680000}"
    );
    test.is(
        JsonLogLine(typed).string(),
        "{\"time\":\"2023-11-14T22:13:20.123456789Z\",\"level\":\"DEBUG\",\"name\":\"shop.db.pool\",\"process\":123456,\"message\":\"привет 🙂 «ok» 中文\",\"fields\":{\"int\":-42,\"str\":\"a \\\"b\\\" \\\\c\",\"yes\":true,\"no\":false,\"float\":1.5,\"tiny\":1e-7,\"dec\":12.5,\"null\":null,\"obj\":{\"k\":[1,2,{\"z\":null}]},\"arr\":[1,\"x\"],\"big\":123456789012345680000}}"
    );
    let controls = LogRecord(
        occurred: Instant(Duration(seconds: rat(17000000005, 10))),
        level: LogLevel.warning,
        message: "a\nb\rc\td" + 0.char().string() + 27.char().string() + "\"q\" \\ /",
        context: LogContext(
            name: LogName("web"),
            fields: LogFields(
                JsonField("text", "line1\nline2\r\t" + 127.char().string() + "end"),
                JsonField("ключ", "значение")
            ),
            process: 0
        )
    );
    test.is(
        TextLogLine(origin: controls, zone: east).string(),
        "2023-11-15T03:43:20.5+05:30 level=WARNING name=\"web\" process=0 message=\"a\\nb\\rc\\td\\u0000\\u001b\\\"q\\\" \\\\ /\" fields={\"text\":\"line1\\nline2\\r\\t\\u007fend\",\"ключ\":\"значение\"}"
    );
    test.is(
        JsonLogLine(controls).string(),
        "{\"time\":\"2023-11-14T22:13:20.5Z\",\"level\":\"WARNING\",\"name\":\"web\",\"process\":0,\"message\":\"a\\nb\\rc\\td\\u0000\\u001b\\\"q\\\" \\\\ /\",\"fields\":{\"text\":\"line1\\nline2\\r\\t\\u007fend\",\"ключ\":\"значение\"}}"
    );
    let separated = "x" + 127.char().string() + 133.char().string() + 159.char().string() +
        160.char().string() + 8232.char().string() + 8233.char().string() + "y";
    let separators = LogRecord(
        occurred: Instant(Duration(seconds: rat(-1000000001, 1000000000))),
        level: LogLevel.error,
        message: separated,
        context: LogContext(
            name: LogName("srv"),
            fields: LogFields(JsonField("k" + 133.char().string(), separated)),
            process: 7
        ),
        cause: LogLineProbe.failed("disk\nfull " + 8232.char().string())
    );
    test.is(
        TextLogLine(origin: separators, zone: west).string(),
        "1969-12-31T15:59:58.999999999-08:00 level=ERROR name=\"srv\" process=7 message=\"x\\u007f\\u0085\\u009f \\u2028\\u2029y\" fields={\"k\\u0085\":\"x\\u007f\\u0085\\u009f \\u2028\\u2029y\"} cause=\"LogLineProbe.failed(\\\"disk\\\\nfull \\u2028\\\")\""
    );
    test.is(
        JsonLogLine(separators).string(),
        "{\"time\":\"1969-12-31T23:59:58.999999999Z\",\"level\":\"ERROR\",\"name\":\"srv\",\"process\":7,\"message\":\"x\\u007f\\u0085\\u009f \\u2028\\u2029y\",\"fields\":{\"k\\u0085\":\"x\\u007f\\u0085\\u009f \\u2028\\u2029y\"},\"cause\":\"LogLineProbe.failed(\\\"disk\\\\nfull \\u2028\\\")\"}"
    );
}

test "lines keep long values whole and write times from year 1 to 9999" {
    let utc = FixedZone(name: "UTC", offset: Duration(seconds: 0.rat()));
    let west = FixedZone(name: "PST", offset: Duration(seconds: (-28800).rat()));
    let plain = LogContext(name: LogName("app"), fields: LogFields(), process: 1);
    let xs is @string = (0..10000).map() -> index {
        "x";
    };
    let long_message = xs.join("") + "ж";
    let ys is @string = (0..5000).map() -> index {
        "й";
    };
    let long_value = ys.join("");
    let long = LogRecord(
        occurred: Instant(Duration(seconds: 1700000000.rat())),
        level: LogLevel.critical,
        message: long_message,
        context: LogContext(
            name: LogName("long"),
            fields: LogFields(JsonField("v", long_value)),
            process: 99
        ),
        cause: InvalidLogProcess.invalid
    );
    test.is(
        TextLogLine(origin: long, zone: utc).string(),
        "2023-11-14T22:13:20Z level=CRITICAL name=\"long\" process=99 message=\"" + long_message +
            "\" fields={\"v\":\"" + long_value + "\"} cause=\"InvalidLogProcess.invalid\""
    );
    test.is(
        JsonLogLine(long).string(),
        "{\"time\":\"2023-11-14T22:13:20Z\",\"level\":\"CRITICAL\",\"name\":\"long\",\"process\":99,\"message\":\"" +
            long_message + "\",\"fields\":{\"v\":\"" + long_value +
            "\"},\"cause\":\"InvalidLogProcess.invalid\"}"
    );
    let first = LogRecord(
        occurred: Instant(Duration(seconds: (-62135596800).rat())),
        level: LogLevel.info,
        message: "m",
        context: plain
    );
    test.is(
        TextLogLine(origin: first, zone: utc).string(),
        "0001-01-01T00:00:00Z level=INFO name=\"app\" process=1 message=\"m\" fields={}"
    );
    test.is(
        JsonLogLine(first).string(),
        "{\"time\":\"0001-01-01T00:00:00Z\",\"level\":\"INFO\",\"name\":\"app\",\"process\":1,\"message\":\"m\",\"fields\":{}}"
    );
    let edge = LogRecord(
        occurred: Instant(Duration(seconds: rat(9223372036854775807, 1000000000))),
        level: LogLevel.info,
        message: "m",
        context: plain
    );
    test.is(
        TextLogLine(origin: edge, zone: west).string(),
        "2262-04-11T15:47:16.854775807-08:00 level=INFO name=\"app\" process=1 message=\"m\" fields={}"
    );
    test.is(
        JsonLogLine(edge).string(),
        "{\"time\":\"2262-04-11T23:47:16.854775807Z\",\"level\":\"INFO\",\"name\":\"app\",\"process\":1,\"message\":\"m\",\"fields\":{}}"
    );
    let past_edge = LogRecord(
        occurred: Instant(Duration(seconds: rat(9223372036854775808, 1000000000))),
        level: LogLevel.info,
        message: "m",
        context: plain
    );
    test.is(
        TextLogLine(origin: past_edge, zone: utc).string(),
        "2262-04-11T23:47:16.854775808Z level=INFO name=\"app\" process=1 message=\"m\" fields={}"
    );
    test.is(
        JsonLogLine(past_edge).string(),
        "{\"time\":\"2262-04-11T23:47:16.854775808Z\",\"level\":\"INFO\",\"name\":\"app\",\"process\":1,\"message\":\"m\",\"fields\":{}}"
    );
    let low_edge = LogRecord(
        occurred: Instant(Duration(seconds: rat(-9223372036854775807, 1000000000))),
        level: LogLevel.info,
        message: "m",
        context: plain
    );
    test.is(
        TextLogLine(origin: low_edge, zone: utc).string(),
        "1677-09-21T00:12:43.145224193Z level=INFO name=\"app\" process=1 message=\"m\" fields={}"
    );
    test.is(
        JsonLogLine(low_edge).string(),
        "{\"time\":\"1677-09-21T00:12:43.145224193Z\",\"level\":\"INFO\",\"name\":\"app\",\"process\":1,\"message\":\"m\",\"fields\":{}}"
    );
    let latest = LogRecord(
        occurred: Instant(Duration(seconds: 253402300799.rat())),
        level: LogLevel.info,
        message: "m",
        context: plain
    );
    test.is(
        JsonLogLine(latest).string(),
        "{\"time\":\"9999-12-31T23:59:59Z\",\"level\":\"INFO\",\"name\":\"app\",\"process\":1,\"message\":\"m\",\"fields\":{}}"
    );
}

test "a line is at most 1 MiB of UTF-8 after escaping, text or JSON" {
    let utc = FixedZone(name: "UTC", offset: Duration(seconds: 0.rat()));
    let plain = LogContext(name: LogName("app"), fields: LogFields(), process: 1);
    let at = Instant(Duration(seconds: 1700000000.rat()));
    // The plain text line is 73 bytes without its message, the JSON line 96.
    let ays is @string = (0..(1048576 - 73)).map() -> index {
        "a";
    };
    let fits = ays.join("");
    let line = TextLogLine(
        origin: LogRecord(occurred: at, level: LogLevel.info, message: fits, context: plain),
        zone: utc
    ).string();
    test.is(line.length(), 1048576);
    test.is(
        line,
        "2023-11-14T22:13:20Z level=INFO name=\"app\" process=1 message=\"" + fits + "\" fields={}"
    );
    let wides is @string = (0..(((1048576 - 73) / 2).int() + 1)).map() -> index {
        "ж";
    };
    let escapes is @string = (0..(((1048576 - 73) / 6).int() + 1)).map() -> index {
        127.char().string();
    };
    for [fits + "a", wides.join(""), escapes.join("")] -> message {
        let record = LogRecord(
            occurred: at,
            level: LogLevel.info,
            message: message,
            context: plain
        );
        test.throws(LogLineLimit) {
            TextLogLine(origin: record, zone: utc).string();
        };
        test.throws(LogLineLimit) {
            JsonLogLine(record).string();
        };
    }
    let json_ays is @string = (0..(1048576 - 96)).map() -> index {
        "a";
    };
    let json_fits = json_ays.join("");
    let json_record = LogRecord(
        occurred: at,
        level: LogLevel.info,
        message: json_fits,
        context: plain
    );
    test.is(JsonLogLine(json_record).string().length(), 1048576);
    test.throws(LogLineLimit) {
        JsonLogLine(
            LogRecord(occurred: at, level: LogLevel.info, message: json_fits + "a", context: plain)
        ).string();
    };
}

hidden enum LogLineProbe is Error = (failed(reason is string));

module testing/report v1.0.0;

// Test reports as text: for people, TAP, JSON or JUnit XML. `okkama run -t`
// writes them.
//
//     HumanTestReport(origin: report, width: 80).string();
//     TapTestReport(report).string();
//     JUnitTestReport(origin: report, suite: "std").string();

import "testing/result" take TestReport, TestResult, TestFailure, TestFailureText, TestCounts,
    TestStatus, InvalidTestResult, TestOutput, TestPosition;
import "encoding/utf" take Utf8Encoded, Utf8Decoded;
import "encoding/hex" take HexEncoded;
import "encoding/base64" take Base64Encoded;
import "json" take Json, JsonField;
import "time/clock" take Instant;
import "time/duration" take Duration, DurationUnit;
import "xml/name" take InvalidXml;
import "xml/write" take EscapedXml;

hidden object TestStatusName {
    has origin is TestStatus;

    TestStatusName(origin is TestStatus) {
        self.origin = origin;
    }

    string() is string {
        match origin {
            case TestStatus.passed {
                "passed";
            }
            case TestStatus.failed {
                "failed";
            }
            case TestStatus.skipped {
                "skipped";
            }
            case TestStatus.timed_out {
                "timed_out";
            }
            else {
                "crashed";
            }
        }
    }
}

// Text escaped for a report line.
object ReportText {
    has origin is string;

    // The text.
    ReportText(origin is string) {
        self.origin = origin;
    }

    // It with backslashes and control characters escaped.
    string() is string {
        let fragments is @string = (0..origin.length()).map() -> index {
            let scalar = origin.slice(index, index + 1);
            let bytes = Utf8Encoded(scalar).bytes();
            if scalar == "\\" {
                "\\\\";
            }
            else {
                if scalar == "\n" {
                    "\\n";
                }
                else {
                    if scalar == "\r" {
                        "\\r";
                    }
                    else {
                        if scalar == "\t" {
                            "\\t";
                        }
                        else {
                            if bytes[0].int() < 32
                                || bytes[0].int() == 127
                                || (bytes.size() == 2
                                && bytes[0].int() == 194
                                && bytes[1].int() <= 159) {
                                    "\\x" + HexEncoded(bytes).string();
                                }
                                else {
                                    if bytes.size() == 3
                                        && bytes[0].int() == 226
                                        && bytes[1].int() == 128
                                        && (bytes[2].int() == 168 || bytes[2].int() == 169) {
                                            "\\x" + HexEncoded(bytes).string();
                                        }
                                        else {
                                            scalar;
                                        }
                                }
                        }
                    }
                }
            }
        };
        fragments.join("");
    }
}

// A report for people.
object HumanTestReport {
    has origin is TestReport;
    has width is int;

    // origin, wrapped to width.
    HumanTestReport(origin is TestReport, width is int) {
        confirm width >= 20 && width <= 512
            else throw InvalidTestResult.because("human width must be 20..512 scalars");
        self.origin = origin;
        self.width = width;
    }

    // The report.
    string() is string {
        let results = origin.results();
        let counts = origin.counts();
        let records is @string = (0..results.size()).map() -> index {
            let result = results.item(index);
            let failures = result.failures();
            let problems is @string = (0..failures.size()).map() -> at {
                self.line("  " + ReportText(TestFailureText(failures.item(at)).string()).string());
            };
            self.line(
                TestStatusName(result::Outcome::status).string() + " " + ReportText(
                    result::Outcome::name
                ).string() + (if result::Outcome::skip_reason != "" {
                    " (" + ReportText(result::Outcome::skip_reason).string() + ")";
                }
                else {
                    "";
                })
            ) + problems.join("") +
                self.bytes("stdout", result.output()::Captured::output) + self.bytes(
                    "stderr",
                    result.output()::Captured::errors
                ) +
                (if result.output()::Captured::truncated {
                    "  captured output truncated\n";
                }
                else {
                    "";
                });
        };
        "seed=" + origin.seed().string() + "\n" + records.join("") + counts::Counts::passes.string() + " passed, " + counts::Counts::failures.string() + " failed, " + counts::Counts::skips.string() + " skipped\n";
    }

    hidden line(text is string) is string {
        (if text.length() > width {
            text.slice(0, width - 3) + "...";
        }
        else {
            text;
        }) + "\n";
    }

    hidden bytes(label is string, bytes is @byte) is string {
        if bytes.size() == 0 {
            return "";
        }
        let count = if bytes.size() < 64 {
            bytes.size();
        }
        else {
            64;
        };
        let prefix is @byte = (0..count).map() -> index {
            bytes[index];
        };
        self.line("  " + label + "(hex)=" + HexEncoded(prefix).string() + (if count < bytes.size() {
            "... " + bytes.size().string() + " bytes";
        }
        else {
            "";
        }));
    }
}

// A TAP version 13 report.
object TapTestReport {
    has origin is TestReport;

    // origin.
    TapTestReport(origin is TestReport) {
        self.origin = origin;
    }

    // The report.
    string() is string {
        let results = origin.results();
        let lines is @string = (0..results.size()).map() -> index {
            let result = results.item(index);
            let status = result::Outcome::status;
            let failures = result.failures();
            let diagnostics is @string = (0..failures.size()).map() -> at {
                "# " + ReportText(TestFailureText(failures.item(at)).string()).string() + "\n";
            };
            (if status == TestStatus.passed || status == TestStatus.skipped {
                "ok ";
            }
            else {
                "not ok ";
            }) + (index + 1).string() + " - " + ReportText(result::Outcome::name).string().split(
                "#"
            ).join(
                "\\#"
            ) +
                (if status == TestStatus.skipped {
                    " # SKIP" + (if result::Outcome::skip_reason != "" {
                        " " + ReportText(result::Outcome::skip_reason).string();
                    }
                    else {
                        "";
                    });
                }
                else {
                    "";
                }) + "\n" + diagnostics.join("") +
                "# status=" + TestStatusName(status).string() + " duration_ns=" + result.duration().nanoseconds().string() + "\n" +
                "# stdout(hex)=" + HexEncoded(result.output()::Captured::output).string() + "\n# stderr(hex)=" + HexEncoded(
                    result.output()::Captured::errors
                ).string() + "\n" +
                (if result.output()::Captured::truncated {
                    "# captured output truncated\n";
                }
                else {
                    "";
                });
        };
        "TAP version 13\n1.." + results.size().string() + (if results.size() == 0 {
            " # SKIP empty report";
        }
        else {
            "";
        }) + "\n# seed=" + origin.seed().string() + "\n" + lines.join("");
    }
}

// A JSON report.
object JsonTestReport {
    has origin is TestReport;

    // origin.
    JsonTestReport(origin is TestReport) {
        self.origin = origin;
    }

    // The report.
    string() is string {
        let results = origin.results();
        let counts = origin.counts();
        let values is @Json = (0..results.size()).map() -> index {
            self.result(results.item(index));
        };
        Json(
            JsonField("seed", Json(origin.seed())),
            JsonField("start_unix_ns", Json(origin.start().unix_duration().nanoseconds().string())),
            JsonField("duration_ns", Json(origin.duration().nanoseconds().string())),
            JsonField(
                "counts",
                Json(
                    JsonField("passes", Json(counts::Counts::passes)),
                    JsonField("failures", Json(counts::Counts::failures)),
                    JsonField("skips", Json(counts::Counts::skips)),
                    JsonField("total", Json(counts.total()))
                )
            ),
            JsonField("results", Json(items: values))
        ).string();
    }

    hidden result(result is TestResult) is Json {
        let failures = result.failures();
        let problems is @Json = (0..failures.size()).map() -> index {
            self.failure(failures.item(index));
        };
        Json(
            JsonField("name", Json(result::Outcome::name)),
            JsonField("status", Json(TestStatusName(result::Outcome::status).string())),
            JsonField("duration_ns", Json(result.duration().nanoseconds().string())),
            JsonField("failures", Json(items: problems)),
            JsonField(
                "stdout_base64",
                Json(Base64Encoded(result.output()::Captured::output).string())
            ),
            JsonField(
                "stderr_base64",
                Json(Base64Encoded(result.output()::Captured::errors).string())
            ),
            JsonField("truncated", Json(result.output()::Captured::truncated)),
            JsonField("skip_reason", Json(result::Outcome::skip_reason))
        );
    }

    hidden failure(failure is TestFailure) is Json {
        let position is Json = if failure.located() {
            let place = failure.position();
            Json(
                JsonField("module", Json(place::Position::source)),
                JsonField("line", Json(place::Position::line)),
                JsonField("column", Json(place::Position::column))
            );
        }
        else {
            Json();
        };
        let reasons = failure.causes();
        let members is @JsonField = [
            JsonField("message", Json(failure::Failure::message)),
            JsonField("position", position)
        ];
        if reasons.size() == 0 {
            Json(members);
        }
        else {
            Json(members[0], members[1], JsonField("cause", self.failure(reasons.item(0))));
        }
    }
}

// JUnit has several consumer dialects. This profile uses a testsuite root,
// case-level capture properties and Base64 system-out/system-err. It preserves
// nanosecond durations without float formatting or invalid XML byte decoding.
object JUnitTestReport {
    has origin is TestReport;
    has suite is string;

    // origin as JUnit suite.
    JUnitTestReport(origin is TestReport, suite is string) {
        confirm suite.length() > 0 && suite.length() <= 4096
            else throw InvalidTestResult.because("JUnit suite length must be 1..4096");
        self.origin = origin;
        self.suite = suite;
    }

    // The XML.
    string() is string {
        let results = origin.results();
        let counts = origin.counts();
        let failed = (0..results.size()).reduce(0) -> count, index {
            count + (if results.item(index)::Outcome::status == TestStatus.failed {
                1;
            }
            else {
                0;
            });
        };

        // The vocabulary and shape are fixed. Building an XML tree here used
        // to validate every constant name with a Unicode regex and traverse
        // the tree again for namespaces, depths and serialization.
        let classname = self.attribute(suite);
        let children is @string = (0..results.size()).map() -> index {
            self.result(results.item(index), classname);
        };
        let body = "<testsuite xmlns=\"\" name=\"" + classname +
            "\" tests=\"" + counts.total().string() +
            "\" failures=\"" + failed.string() +
            "\" errors=\"" + (counts::Counts::failures - failed).string() +
            "\" skipped=\"" + counts::Counts::skips.string() +
            "\" time=\"" + JUnitSeconds(origin.duration()).string() + "\">" +
            "<properties xmlns=\"\">" +
            self.property("seed", origin.seed().string()) +
            self.property("start_unix_ns", origin.start().unix_duration().nanoseconds().string()) +
            self.property("captured-output-encoding", "base64") +
            "</properties>" + children.join("") + "</testsuite>";
        // Retain XmlDocument's output budget. All descendants are smaller;
        // the fixed shape also stays within XML depth/attribute/child limits.
        confirm body.length() + 38 <= 33554432
            else throw InvalidXml.located(0, "XML document exceeds 32 Mi scalars");
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" + body;
    }

    // Only fixed names and numeric/base64/boolean values reach this helper.
    hidden property(name is string, value is string) is string {
        "<property xmlns=\"\" name=\"" + name + "\" value=\"" + value + "\"/>";
    }

    hidden attribute(text is string) is string {
        EscapedXml(origin: JUnitReportText(text).string(), attribute: true).string();
    }

    hidden result(result is TestResult, classname is string) is string {
        let status = result::Outcome::status;
        let failures = result.failures();
        let messages is @string = (0..failures.size()).map() -> index {
            let failure = failures.item(index);
            (if failure.located() {
                let place = failure.position();
                JUnitReportText(place::Position::source).string() + ":" + place::Position::line.string() + ":" + place::Position::column.string() + ": ";
            }
            else {
                "";
            }) + JUnitReportText(TestFailureText(failure).string()).string();
        };

        let terminal = if status == TestStatus.passed {
            "";
        }
        else {
            if status == TestStatus.skipped {
                "<skipped xmlns=\"\" message=\"" + self.attribute(result::Outcome::skip_reason) + "\"/>";
            }
            else {
                let label = TestStatusName(status).string();
                let tag = if status == TestStatus.failed {
                    "failure";
                }
                else {
                    "error";
                };
                "<" + tag + " xmlns=\"\" type=\"" + label + "\">" +
                    EscapedXml(
                        origin: if messages.size() == 0 {
                            label;
                        }
                        else {
                            messages.join("\n");
                        },
                        attribute: false
                    ).string() +
                    "</" + tag + ">";
            }
        };
        let output = result.output();
        "<testcase xmlns=\"\" name=\"" + self.attribute(result::Outcome::name) +
            "\" classname=\"" + classname +
            "\" time=\"" + JUnitSeconds(result.duration()).string() + "\">" +
            terminal + "<properties xmlns=\"\">" +
            self.property("captured-output-truncated", if output::Captured::truncated {
                "true";
            }
            else {
                "false";
            }) +
            "</properties><system-out xmlns=\"\">" + Base64Encoded(output::Captured::output).string() +
            "</system-out><system-err xmlns=\"\">" + Base64Encoded(output::Captured::errors).string() +
            "</system-err></testcase>";
    }
}

// Text escaped for JUnit XML.
object JUnitReportText {
    has origin is string;

    // The text.
    JUnitReportText(origin is string) {
        self.origin = origin;
    }

    // It escaped.
    string() is string {
        let fffe = Utf8Decoded([byte(239), byte(191), byte(190)]).string();
        let ffff = Utf8Decoded([byte(239), byte(191), byte(191)]).string();
        ReportText(origin).string().replace(fffe, "\\uFFFE").replace(ffff, "\\uFFFF");
    }
}

hidden object JUnitSeconds {
    has origin is Duration;

    JUnitSeconds(origin is Duration) {
        self.origin = origin;
    }

    string() is string {
        let digits = origin.nanoseconds().string();
        if digits.length() <= 9 {
            let zeroes is @string = (0..9 - digits.length()).map() -> index {
                "0";
            };
            "0." + zeroes.join("") + digits;
        }
        else {
            digits.slice(0, digits.length() - 9) + "." + digits.slice(
                digits.length() - 9,
                digits.length()
            );
        }
    }
}

test "empty TAP report carries an explicit skipped plan" {
    let duration = Duration(seconds: 0);
    test.is(
        TapTestReport(
            TestReport(start: Instant(duration), duration: duration, seed: 0, results: [])
        ).string(),
        "TAP version 13\n1..0 # SKIP empty report\n# seed=0\n"
    );
}

test "JUnit empty suite preserves declaration attributes and properties" {
    let zero = Duration(seconds: 0);
    test.is(
        JUnitTestReport(
            origin: TestReport(start: Instant(zero), duration: zero, seed: 42, results: []),
            suite: "s"
        ).string(),
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?><testsuite xmlns=\"\" name=\"s\" tests=\"0\" failures=\"0\" errors=\"0\" skipped=\"0\" time=\"0.000000000\"><properties xmlns=\"\"><property xmlns=\"\" name=\"seed\" value=\"42\"/><property xmlns=\"\" name=\"start_unix_ns\" value=\"0\"/><property xmlns=\"\" name=\"captured-output-encoding\" value=\"base64\"/></properties></testsuite>"
    );
}

test "JUnit separates failures errors skips and escapes attributes and text" {
    let duration = Duration(value: 1234567890.rat(), unit: DurationUnit.nanosecond);
    let statuses = [
        TestStatus.passed,
        TestStatus.failed,
        TestStatus.skipped,
        TestStatus.timed_out,
        TestStatus.crashed
    ];
    let results is @TestResult = statuses.map() -> status {
        TestResult(
            name: "n&<>\"'é",
            status: status,
            duration: duration,
            failures: if status == TestStatus.failed {
                [
                    TestFailure(
                        message: "m&<>\"'中文\n",
                        position: TestPosition(source: "a&.ok", line: 2, column: 3)
                    )
                ];
            }
            else {
                [];
            },
            output: TestOutput(output: [byte(0), byte(255)], errors: [byte(38)], truncated: true),
            skip_reason: if status == TestStatus.skipped {
                "&<>\"'é";
            }
            else {
                "";
            }
        );
    };
    let xml = JUnitTestReport(
        origin: TestReport(start: Instant(duration), duration: duration, seed: 7, results: results),
        suite: "s&<>\"'é"
    ).string();
    test.ok(
        xml.contains(
            "name=\"s&amp;&lt;&gt;&quot;'é\" tests=\"5\" failures=\"1\" errors=\"2\" skipped=\"1\" time=\"1.234567890\""
        )
    );
    test.ok(
        xml.contains(
            "<testcase xmlns=\"\" name=\"n&amp;&lt;&gt;&quot;'é\" classname=\"s&amp;&lt;&gt;&quot;'é\" time=\"1.234567890\">"
        )
    );
    test.ok(
        xml.contains(
            "<failure xmlns=\"\" type=\"failed\">a&amp;.ok:2:3: m&amp;&lt;&gt;\"'中文\\n</failure>"
        )
    );
    test.ok(xml.contains("<skipped xmlns=\"\" message=\"&amp;&lt;&gt;&quot;'é\"/>"));
    test.ok(xml.contains("<error xmlns=\"\" type=\"timed_out\">timed_out</error>"));
    test.ok(xml.contains("<error xmlns=\"\" type=\"crashed\">crashed</error>"));
    test.ok(
        xml.contains("<property xmlns=\"\" name=\"captured-output-truncated\" value=\"true\"/>")
    );
    test.ok(
        xml.contains(
            "<system-out xmlns=\"\">AP8=</system-out><system-err xmlns=\"\">Jg==</system-err>"
        )
    );
}

test "JUnit report text keeps controls and forbidden XML scalars printable" {
    test.is(
        JUnitReportText("\\\n\r\t\u{0}\u{7F}\u{85}\u{2028}\u{2029}\u{FFFE}\u{FFFF}😀").string(),
        "\\\\\\n\\r\\t\\x00\\x7f\\xc285\\xe280a8\\xe280a9\\uFFFE\\uFFFF😀"
    );
}

test "JUnit passed case keeps empty capture elements and false truncation" {
    let zero = Duration(seconds: 0);
    let result = TestResult(
        name: "pass",
        status: TestStatus.passed,
        duration: Duration(value: 1.rat(), unit: DurationUnit.nanosecond),
        failures: [],
        output: TestOutput(output: [], errors: [], truncated: false)
    );
    let report = TestReport(start: Instant(zero), duration: zero, seed: 0, results: [result]);
    let xml = JUnitTestReport(origin: report, suite: "s").string();
    test.ok(
        xml.contains(
            "<testcase xmlns=\"\" name=\"pass\" classname=\"s\" time=\"0.000000001\"><properties xmlns=\"\"><property xmlns=\"\" name=\"captured-output-truncated\" value=\"false\"/></properties><system-out xmlns=\"\"></system-out><system-err xmlns=\"\"></system-err></testcase>"
        )
    );
    test.throws(InvalidTestResult) {
        JUnitTestReport(origin: report, suite: "");
    };
}

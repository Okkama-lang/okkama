module http/client_request v1.0.0;

// A request checked before it leaves: an absolute http or https URL and at most
// one Host, matching it. HttpClient uses it. A body its fields do not frame is
// framed for HTTP/1.1 here: Content-Length when its length is known and not 0,
// Transfer-Encoding: chunked when it is not known; it is never read for that.

import "http/message" take Request;
import "http/target" take RequestTargetKind, OriginTarget;
import "http/version" take HttpVersion;
import "http/header" take Header, HeaderName;
import "url/value" take UrlParts;
import "url/value" take ParsedUrl;
import "http/target" take AbsoluteTarget;
import "http/method" take Method;
import "http/header" take Headers;
import "http/body" take BodyOpening, UnknownBodyLength, ByteBody, OneShotBody, StreamBodyReading,
    ByteBodyInput;
import "numbers/bigint" take BigInt;

// Prepare an ordinary direct request before DNS or socket effects. CONNECT and
// OPTIONS * require separate explicitly routed consumers.
object HttpDirectRequest {
    has url is UrlParts;
    has request is Request;

    // origin to send directly.
    HttpDirectRequest(origin is Request) {
        confirm origin::Head::target.kind() == RequestTargetKind.absolute
            else throw InvalidClientRequest.because("absolute HTTP URL required");
        confirm origin::Head::version == HttpVersion.http_1_1
            else throw InvalidClientRequest.because("HTTP1.1 request required");
        let destination = origin::Head::target.url();
        let parts = destination;
        let authority = parts.authority();
        let supplied = origin::Head::headers.values(HeaderName("Host"));
        confirm supplied.size() <= 1 else throw InvalidClientRequest.because("duplicate Host");
        if supplied.size() == 1 {
            confirm supplied.item(0) == authority
                else throw InvalidClientRequest.because("Host differs from URL authority");
        }
        let fields = if supplied.size() == 1 {
            origin::Head::headers;
        }
        else {
            origin::Head::headers.addition(Header(name: HeaderName("Host"), value: authority));
        };
        let framed = Http1OutgoingFraming(origin: fields, body: origin.body()).headers();
        let path = if parts::Parts::path == "" {
            "/";
        }
        else {
            parts::Parts::path;
        };
        let target = OriginTarget(path: path, query: parts::Parts::query);
        request = Request(
            method: origin::Head::method,
            target: target,
            headers: framed,
            body: origin.body(),
            version: origin::Head::version
        );
        url = destination;
    }

    // The URL it goes to.
    url() is UrlParts {
        url;
    }

    // The request with its Host; InvalidClientRequest when it is not a direct
    // HTTP/1.1 request.
    request() is Request {
        request;
    }
}

// The fields with framing for a body they leave unframed.
hidden object Http1OutgoingFraming {
    has origin is Headers;
    has body is BodyOpening;

    Http1OutgoingFraming(origin is Headers, body is BodyOpening) {
        self.origin = origin;
        self.body = body;
    }

    headers() is Headers {
        if origin.membership(HeaderName("Content-Length"))
            || origin.membership(HeaderName("Transfer-Encoding")) {
                return origin;
            }
        let known is @BigInt = try {
            [body.length()];
        }
        catch e is UnknownBodyLength {
            let unknown is @BigInt = [];
            unknown;
        };
        if known.size() == 0 {
            origin.addition(Header(name: HeaderName("Transfer-Encoding"), value: "chunked"));
        }
        else if known[0].sign() == 0 {
            origin;
        }
        else {
            origin.addition(Header(name: HeaderName("Content-Length"), value: known[0].string()));
        }
    }
}

// A request a client cannot send; reason says why.
enum InvalidClientRequest is Error = (because(reason is string));

test "direct route adds Host and a slash without adding optional client features" {
    let request = Request(
        method: Method.get,
        target: AbsoluteTarget(ParsedUrl("http://example.test").parts())
    );
    let wire = HttpDirectRequest(request).request();
    test.ok(
        wire::Head::target.string() == "/"
            && wire::Head::headers.first(HeaderName("Host")) == "example.test"
    );
    test.ok(!wire::Head::headers.membership(HeaderName("User-Agent")));
}

test "an unframed body is framed for HTTP/1.1: a known length, chunked when unknown, nothing when empty" {
    let url = "http://example.test/upload";
    let sized = HttpDirectRequest(
        Request(url: url, method: Method.post, body: ByteBody([byte(1), byte(2), byte(3)]))
    ).request();
    test.is(sized::Head::headers.first(HeaderName("Content-Length")), "3");
    test.ok(!sized::Head::headers.membership(HeaderName("Transfer-Encoding")));
    let stream = ByteBodyInput([byte(1)]);
    let unknown = HttpDirectRequest(
        Request(
            url: url,
            method: Method.post,
            body: OneShotBody(StreamBodyReading(input: stream, owner: stream, trailers: Headers()))
        )
    ).request();
    test.is(unknown::Head::headers.first(HeaderName("Transfer-Encoding")), "chunked");
    test.ok(!unknown::Head::headers.membership(HeaderName("Content-Length")));
    let empty = HttpDirectRequest(Request(url: url)).request();
    test.ok(
        !empty::Head::headers.membership(HeaderName("Content-Length"))
            && !empty::Head::headers.membership(HeaderName("Transfer-Encoding"))
    );
    let declared = HttpDirectRequest(
        Request(
            url: url,
            method: Method.post,
            headers: Headers(
                Header(name: HeaderName("Transfer-Encoding"), value: "chunked"),
                Header(name: HeaderName("Authorization"), value: "Bearer token")
            ),
            body: ByteBody([byte(1)])
        )
    ).request();
    test.ok(!declared::Head::headers.membership(HeaderName("Content-Length")));
    test.is(declared::Head::headers.values(HeaderName("Transfer-Encoding")).size(), 1);
    test.is(declared::Head::headers.first(HeaderName("Authorization")), "Bearer token");
}

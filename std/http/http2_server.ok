module http/http2_server v1.0.0;

// The server side of one HTTP/2 connection. HttpServer uses it when ALPN or its
// policy selects HTTP/2; at most 100 streams run at once.

import "http/method" take Method;
import "http/handler" take Handling, HandlingResult, HandlingKind, ResponseHandling;
import "http/request_context" take HttpRequestContext;
import "http/server_policy" take ServerPolicy, ServerTimeouts;
import "http/exchange" take ExchangeDetails;
import "http/message" take Request, Response, InvalidHttpMessage;
import "http/status" take Status, StatusCode, StatusClass;
import "http/version" take HttpVersion;
import "http/header" take Headers, HeaderName, HttpAsciiLowercase;
import "http/body" take BodyOpening, BodyReading, EmptyBody, UnknownBodyLength, ByteBodyInput;
import "http/http2_settings" take Http2Settings, Http2SettingsWire;
import "http/internal/http2_preface" take Http2ServerPreface;
import "http/internal/http2_settings" take Http2PeerSettings;
import "http/internal/http2_input" take Http2ConnectionInput, Http2ReceivingEvents,
    Http2ReceivingBarrier, Http2ReadBoundary;
import "http/internal/http2_output" take Http2ConnectionOutput, Http2OutputTicket,
    Http2OutputStopped;
import "http/internal/http2_sending" take Http2DataScheduler;
import "http/internal/http2_receiving" take Http2ReceiveFlow;
import "http/internal/http2_body" take Http2BodyBuffer, Http2BodyEvents, Http2IncomingBody,
    Http2BodyLength, Http2Trailers;
import "http/internal/http2_headers" take Http2HeaderBlock;
import "http/internal/http2_fields" take ParsedHttp2Request, Http2ResponseFields,
    Http2OrdinaryFields;
import "http/internal/http2_flow" take Http2DataPayload, Http2WindowIncrement;
import "http/internal/http2_controls" take Http2Reset, Http2ResetFrame, Http2GoAway,
    Http2GoAwayFrame;
import "http/internal/http2_frame" take Http2Fault, Http2FaultScope, Http2FaultView, Http2Frame,
    Http2FrameHeader;
import "http/internal/hpack_tables" take HpackField;
import "http/internal/hpack" take HpackBudget;
import "io/stream" take AsyncReading, AsyncWriting, Closing, ByteSource;
import "io/decorators" take InvalidReading;
import "strings/parse" take Number;
import "compare" take Order;
import "async/atomic" take Atomic;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "async/cancellation" take Cancellation;
import "async/timeout" take Within, Before, TimedOut;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration, DurationUnit;
import "error" take InvalidState;
import "encoding/binary" take Binary, Signedness;
import "encoding/utf" take ByteOrder, Utf8Encoded;

import "http/client_policy" take HttpLimits;
import "collections/set" take OrderedSet;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "io/buffer" take ByteBuffer;

// Serves one HTTP/2 connection with a handler.
object Http2ServerSession does Closing {
    has state is Http2ServerState;

    // Serves the connection on input and output with handling, under policy.
    Http2ServerSession(
        input is AsyncReading,
        output is AsyncWriting,
        owner is Closing,
        handling is Handling,
        details is ExchangeDetails,
        policy is ServerPolicy,
        clock is Timing
    ) {
        confirm details.version() == HttpVersion.http_2
            && policy.protocols().membership(HttpVersion.http_2)
            && !owner.closed()
            else throw InvalidState.because("H2 server requires selected H2 transport and policy");
        state = Http2ServerState(
            input: input,
            output: output,
            owner: owner,
            handling: handling,
            details: details,
            policy: policy,
            clock: clock
        );
    }

    // Whether it was closed.
    closed() is bool {
        state.closed();
    }

    // Closes the connection.
    close() is void {
        state.close();
    }

    // Serves until the connection ends; true when it ended cleanly.
    async serve() is bool {
        await state.run();
    }

    // Takes no new streams; those open go on.
    stop_accepting() is void {
        state.stop_accepting();
    }

    // Waits until no stream is left.
    async drained() is bool {
        await state.drained();
    }

    // Waits until serving has stopped.
    async settled() is bool {
        await state.settled();
    }

    destroy {
        self.close();
    }
}

hidden object Http2ServerState does Http2ReceivingEvents, Http2ReceivingBarrier, Http2BodyEvents {
    has input is AsyncReading;
    has output_origin is AsyncWriting;
    has owner is Closing;
    has handling is Handling;
    has details is ExchangeDetails;
    has policy is ServerPolicy;
    has clock is Timing;
    has output is Http2ConnectionOutput;
    has sender is Atomic<@Http2DataScheduler>;
    has flow is Http2ReceiveFlow;
    has peer is Atomic<Http2PeerSettings>;
    has local is Http2Settings;

    has active, retired, publications is Atomic<@Http2ServerStream>;
    has highest is Atomic<int>;
    has changed is Atomic<Event>;
    has stopped, started, finished, draining is Event;
    has reading_busy is Atomic<bool>;
    has loops is FutureGroup<bool>;
    has openings is FutureGroup<Http2PeerSettings>;
    has goodbye is Atomic<@Http2OutputTicket>;
    has failures is Atomic<@Error>;

    Http2ServerState(
        input is AsyncReading,
        output is AsyncWriting,
        owner is Closing,
        handling is Handling,
        details is ExchangeDetails,
        policy is ServerPolicy,
        clock is Timing
    ) {
        self.input = input;
        output_origin = output;
        self.owner = owner;
        self.handling = handling;
        self.details = details;
        self.policy = policy;
        self.clock = clock;
        self.output = Http2ConnectionOutput(origin: output, maximum: 256, byte_limit: 1048576);
        let schedulers is @Http2DataScheduler = [];
        sender = Atomic(schedulers);
        flow = Http2ReceiveFlow(controls: self.output, maximum: 100);
        peer = Atomic(Http2PeerSettings());
        local = Http2Settings();
        let empty is @Http2ServerStream = [];
        active = Atomic(empty);
        retired = Atomic(empty);
        publications = Atomic(empty);
        highest = Atomic(0);
        changed = Atomic(Event());
        stopped = Event();
        started = Event();
        finished = Event();
        draining = Event();
        reading_busy = Atomic(false);
        loops = FutureGroup();
        openings = FutureGroup();
        let tickets is @Http2OutputTicket = [];
        goodbye = Atomic(tickets);
        let errors is @Error = [];
        failures = Atomic(errors);
    }

    closed() is bool {
        stopped.ready() || owner.closed();
    }

    wake() is void {
        let previous = changed.value();
        changed.replace(Event());
        previous.set();
    }

    output() is Http2ConnectionOutput {
        output;
    }

    sender() is Http2DataScheduler {
        sender.value()[0];
    }

    details() is ExchangeDetails {
        details;
    }

    handling() is Handling {
        handling;
    }

    policy() is ServerPolicy {
        policy;
    }

    clock() is Timing {
        clock;
    }

    body_limit() is int {
        policy.limits().body_bytes();
    }

    budget() is HpackBudget {
        let limit = policy.limits().header_bytes();
        let remote = peer.value();
        let decoded = if remote.header_list_limited() && remote.header_list() < limit {
            remote.header_list();
        }
        else {
            limit;
        };
        HpackBudget(encoded: limit, decoded: decoded, fields: 128);
    }

    check_fields(block is Http2HeaderBlock) is void {
        for block.fields() -> field {
            confirm field.size() <= policy.limits().line_bytes() + 32
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    11,
                    block.stream(),
                    "request field line limit"
                );
        }
    }

    credit(stream is int, amount is int, stream_update is bool) is void {
        flow.credit(stream, amount, stream_update);
    }

    discard(stream is int, amount is int, cancel is bool) is void {
        flow.discard(stream, amount, false);
        if cancel {
            for self.matching(stream) -> entry {
                entry.reset(8);
            }
        }
    }

    attach(stream is int, body is Http2BodyBuffer) is void {
        flow.attach(stream, body);
    }

    matching(stream is int) is @Http2ServerStream {
        active.value().filter() -> entry {
            entry.stream() == stream;
        };
    }

    async run() is bool {
        confirm !started.ready() && !self.closed()
            else throw InvalidState.because("H2 server session is single-use");
        started.set();
        let cleanup = Http2ServerCleanup(state: self, owner: owner, finished: finished);
        let opening_cleanup = Http2ServerSettlement(openings);
        defer await opening_cleanup.close();
        let preface = Http2ServerPreface(input: input, output: output_origin, settings: local).settings();
        let timeout = policy.timeouts().headers_timeout();
        let selected = if timeout::Span::seconds > 0.rat() {
            let bounded is Within<Http2PeerSettings> = Within(
                origin: preface,
                limit: timeout,
                clock: clock
            );
            bounded.outcome();
        }
        else {
            preface;
        };
        openings.start(selected);
        let advertisement = await selected;
        peer.replace(advertisement);
        sender.replace([Http2DataScheduler(output: output, peer: advertisement, maximum: 100)]);
        if self.closed() {
            return true;
        }
        // start() is eager: hold the reader and idle timer until every loop
        // is registered. Start the writer last so it owns output cleanup
        // before EOF can close the session with a GOAWAY still queued.
        let ready = Event();
        loops.start(self.reading(ready));
        loops.start(self.idling(ready));
        loops.start(self.writing());
        ready.set();
        await stopped.wait();
        for failures.value() -> failure {
            throw failure;
        }
        true;
    }

    async reading(ready is Event) is bool {
        defer self.close();
        await ready.wait();
        let wire = Http2ServerWireInput(origin: input, owner: self);
        let reader = Http2ConnectionInput(
            origin: wire,
            receiver: self,
            controls: output,
            local: local,
            peer: peer.value(),
            budget: HpackBudget(policy.limits().header_bytes(), policy.limits().header_bytes(), 128),
            from_server: false,
            barrier: self,
            boundary: wire
        );
        let pending = reader.run();
        try {
            await pending;
        }
        catch e is Cancelled {
            if !stopped.ready() {
                throw;
            }
            false;
        }
        catch e is Http2Fault {
            failures.replace([e]);
            await self.connection_fault(e);
            false;
        }
        catch e is TimedOut {
            let fault = Http2Fault.detailed(Http2FaultScope.connection, 1, 0, "HTTP2 wire deadline");
            failures.replace([fault]);
            await self.connection_fault(fault);
            false;
        }
        catch e is Error {
            failures.replace([e]);
            self.close();
            false;
        }
        catch e is NativeFailure {
            self.close();
            throw;
        }
    }

    busy(value is bool) is void {
        reading_busy.replace(value);
        self.wake();
    }

    async idling(ready is Event) is bool {
        await ready.wait();
        let interval = policy.timeouts().keep_alive_timeout();
        loop {
            if self.closed() {
                return true;
            }
            let signal = changed.value();
            let pending = signal.wait();
            let waiting = if interval::Span::seconds > 0.rat()
                && active.value().size() == 0
                && !reading_busy.value() {
                    let deadline is Within<Event> = Within(
                        origin: pending,
                        limit: interval,
                        clock: clock
                    );
                    deadline.outcome();
                }
                else {
                    pending;
                };
            try {
                await waiting;
            }
            catch e is TimedOut {
                if active.value().size() == 0 && !reading_busy.value() {
                    self.close();
                    return true;
                }
            }
        }
    }

    async connection_fault(failure is Http2Fault) is bool {
        defer self.close();
        draining.set();
        flow.stop(failure);
        sender.value()[0].stop();
        for active.value() -> entry {
            entry.cancel();
        }
        try {
            let ticket = output.submit(
                [
                    Http2GoAwayFrame(
                        last_stream: highest.value(),
                        code: Http2FaultView(failure).code(),
                        debug: []
                    ).frame()
                ]
            );
            let bounded is Within<bool> = Within(
                origin: ticket.delivered(),
                limit: Duration(1.rat(), DurationUnit.second),
                clock: clock
            );
            let pending = bounded.outcome();
            await pending;
        }
        catch e is Cancelled {
            throw;
        }
        catch e is Error {}
        true;
    }

    async writing() is bool {
        defer self.close();
        let pending = output.run();
        try {
            await pending;
        }
        catch e is Cancelled {
            if !stopped.ready() {
                throw;
            }
            false;
        }
        catch e is Error {
            failures.replace([e]);
            self.close();
            false;
        }
        catch e is NativeFailure {
            self.close();
            throw;
        }
    }

    headers(block is Http2HeaderBlock) is void {
        let stream = block.stream();
        let matched = self.matching(stream);
        if matched.size() == 1 {
            matched[0].trailers(block);
            return;
        }
        confirm stream > highest.value() && stream % 2 == 1
            else throw Http2Fault.detailed(
                Http2FaultScope.connection,
                1,
                0,
                "request stream IDs must increase"
            );
        highest.replace(stream);
        confirm !draining.ready() && active.value().size() < 100
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                7,
                stream,
                "request stream refused"
            );
        self.check_fields(block);
        let head = ParsedHttp2Request(origin: block.fields(), stream: stream);
        let declared = Http2BodyLength(origin: head.headers(), stream: stream).known();
        confirm head.target().string().length() <= policy.limits().line_bytes()
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                11,
                stream,
                "request target limit"
            );
        let entry = Http2ServerStream(owner: self, block: block, head: head, declared: declared);
        sender.value()[0].open(stream);
        flow.register(stream);
        let old = active.value();
        let following is @Http2ServerStream = old + [entry];
        active.replace(following);
        publications.replace([entry]);
        entry.start();
    }

    async published() is bool {
        let batch = publications.value();
        publications.replace([]);
        for batch -> entry {
            await entry.ready();
        }
        await self.reap();
        true;
    }

    data(data is Http2DataPayload) is void {
        let matched = self.matching(data.stream());
        if matched.size() > 0 {
            confirm !matched[0].ended()
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    5,
                    data.stream(),
                    "DATA after request end"
                );
        }
        flow.data(data);
    }

    reset(reset is Http2Reset) is void {
        confirm reset.stream() <= highest.value() && reset.stream() % 2 == 1
            else throw Http2Fault.detailed(Http2FaultScope.connection, 1, 0, "reset on idle stream");
        for self.matching(reset.stream()) -> entry {
            entry.cancel();
        }
    }

    window(update is Http2WindowIncrement) is void {
        if update.stream() == 0 || self.matching(update.stream()).size() > 0 {
            sender.value()[0].window(update);
        }
        else {
            confirm update.stream() <= highest.value() && update.stream() % 2 == 1
                else throw Http2Fault.detailed(
                    Http2FaultScope.connection,
                    1,
                    0,
                    "WINDOW_UPDATE on idle stream"
                );
        }
    }

    settings(previous is Http2PeerSettings, current is Http2PeerSettings) is void {
        sender.value()[0].settings(previous, current);
        peer.replace(current);
    }

    local_settings(settings is Http2Settings) is void {}

    goaway(frame is Http2GoAway) is void {
        self.stop_accepting();
    }

    stream_fault(fault is Http2Fault) is bool {
        flow.observed_closed(Http2FaultView(fault).stream());
        let matched = self.matching(Http2FaultView(fault).stream());
        if matched.size() > 0 {
            let issued = matched[0].reset_issued();
            matched[0].cancel();
            return !issued;
        }
        true;
    }

    ended() is void {
        self.close();
    }

    remove(entry is Http2ServerStream) is void {
        let old = retired.value();
        let following is @Http2ServerStream = old + [entry];
        retired.replace(following);
        active.replace(active.value().filter() -> other {
            other.stream() != entry.stream();
        });
        flow.retire(entry.stream());
        sender.value()[0].close(entry.stream());
        if entry.unexpected() && !self.closed() {
            self.close();
        }
        self.wake();
    }

    async reap() is bool {
        let batch = retired.value();
        retired.replace([]);
        for batch -> entry {
            await entry.settled();
        }
        true;
    }

    close() is void {
        if !stopped.ready() {
            stopped.set();
            openings.cancel();
            flow.stop(Http2ServerClosed.closed);
            for sender.value() -> scheduler {
                scheduler.stop();
            }
            for active.value() -> entry {
                entry.cancel();
            }
            loops.cancel();
            output.finish();
            self.wake();
            if !started.ready() {
                owner.close();
                finished.set();
            }
        }
    }

    stop_accepting() is void {
        if !draining.ready() && !self.closed() {
            draining.set();
            goodbye.replace(
                [
                    output.submit(
                        [Http2GoAwayFrame(last_stream: highest.value(), code: 0, debug: []).frame()]
                    )
                ]
            );
            self.wake();
        }
    }

    async drained() is bool {
        confirm started.ready() else throw InvalidState.because("server has not started");
        self.stop_accepting();
        loop {
            if active.value().size() == 0 {
                last;
            }
            let signal = changed.value();
            await signal.wait();
        }
        await self.reap();
        // A session that closed first sent no GOAWAY; a client that left first
        // stopped the output before it went out (#502). Neither leaves anything
        // to drain.
        let goodbyes = goodbye.value();
        if goodbyes.size() > 0 {
            let pending = goodbyes[0].delivered();
            let group is FutureGroup<bool> = FutureGroup();
            let cleanup = Http2ServerSettlement(group);
            defer await cleanup.close();
            group.start(pending);
            try {
                await pending;
            }
            catch e is Http2OutputStopped {}
        }
        self.close();
        await finished.wait();
        true;
    }

    async cleanup() is bool {
        self.close();
        await loops.wait();
        let batch = active.value();
        for batch -> entry {
            await entry.settled();
        }
        await self.reap();
        true;
    }

    async settled() is bool {
        await finished.wait();
        true;
    }
}

hidden object Http2ServerStream {
    has owner is Http2ServerState;
    has block is Http2HeaderBlock;
    has head is ParsedHttp2Request;
    has declared is @int;
    has buffers is Atomic<@Http2BodyBuffer>;
    has group is FutureGroup<bool>;
    has aborted, completed is Event;
    has reset_sent is Event;
    has ready is Event;
    has cancelled is Cancellation;
    has sent is Atomic<bool>;
    has continuing is Future<bool>;

    Http2ServerStream(
        owner is Http2ServerState,
        block is Http2HeaderBlock,
        head is ParsedHttp2Request,
        declared is @int
    ) {
        self.owner = owner;
        self.block = block;
        self.head = head;
        self.declared = declared;
        let empty is @Http2BodyBuffer = [];
        buffers = Atomic(empty);
        group = FutureGroup();
        aborted = Event();
        completed = Event();
        reset_sent = Event();
        ready = Event();
        cancelled = Cancellation();
        sent = Atomic(false);
        continuing = Http2ServerContinue(self).run();
    }

    stream() is int {
        block.stream();
    }

    start() is void {
        group.start(self.run());
    }

    async ready() is bool {
        await ready.wait();
        true;
    }

    async settled() is bool {
        await group.wait();
        true;
    }

    unexpected() is bool {
        !completed.ready() && !aborted.ready();
    }

    reset_issued() is bool {
        reset_sent.ready();
    }

    reset(code is int) is void {
        if !reset_sent.ready() && !owner.closed() {
            reset_sent.set();
            owner.output().frame(Http2ResetFrame(stream: self.stream(), code: code).frame());
        }
    }

    cancel() is void {
        aborted.set();
        reset_sent.set();
        cancelled.cancel();
        group.cancel();
    }

    ended() is bool {
        let values = buffers.value();
        values.size() == 1 && values[0].wire_ended();
    }

    trailers(block is Http2HeaderBlock) is void {
        confirm block.end_stream() && !self.ended()
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                1,
                self.stream(),
                "invalid request trailers"
            );
        buffers.value()[0].ending(
            Http2Trailers(fields: block.fields(), stream: self.stream()).headers()
        );
    }

    async run() is bool {
        defer owner.remove(self);
        defer ready.set();
        defer cancelled.cancel();
        let result = try {
            let body = Http2BodyBuffer(
                stream: self.stream(),
                initial: 65535,
                maximum: owner.body_limit(),
                events: owner,
                expected: declared,
                empty: false
            );
            defer body.close();
            buffers.replace([body]);
            owner.attach(self.stream(), body);
            if block.end_stream() {
                body.ending(Headers());
            }
            ready.set();
            let opening = Http2ServerBody(
                entry: self,
                origin: Http2IncomingBody(body, declared),
                timeout: owner.policy().timeouts().body_idle_timeout(),
                clock: owner.clock()
            );
            let request = head.request(opening);
            let context = HttpRequestContext(
                details: owner.details(),
                cancellation: cancelled.cancelling()
            );
            let expected = head.headers().values(HeaderName("expect"));
            let unsupported = expected.size() > 0
                && (expected.size() != 1
                || HttpAsciiLowercase(expected.item(0)).string() != "100-continue");
            let result is HandlingResult = if unsupported {
                ResponseHandling(
                    Response(
                        status: Status.expectation_failed,
                        version: HttpVersion.http_2
                    )
                );
            }
            else {
                let pending = owner.handling().handling(request, context);
                let timeout = owner.policy().timeouts().handling_timeout();
                let bounded = if timeout::Span::seconds > 0.rat() {
                    let deadline is Within<HandlingResult> = Within(
                        origin: pending,
                        limit: timeout,
                        clock: owner.clock()
                    );
                    deadline.outcome();
                }
                else {
                    pending;
                };
                try {
                    await bounded;
                }
                catch e is Cancelled {
                    throw;
                }
                catch e is Http2Fault {
                    throw;
                }
                catch e is TimedOut {
                    ResponseHandling(
                        Response(
                            status: Status.service_unavailable,
                            version: HttpVersion.http_2
                        )
                    );
                }
                catch e is Error {
                    ResponseHandling(
                        Response(
                            status: Status.internal_server_error,
                            version: HttpVersion.http_2
                        )
                    );
                }
            };
            confirm result.kind() == HandlingKind.response
                else throw Http2Fault.detailed(
                    Http2FaultScope.stream,
                    1,
                    self.stream(),
                    "HTTP2 Upgrade requires negotiated extended CONNECT"
                );
            try {
                await self.respond(request, result.response());
            }
            catch e is Cancelled {
                throw;
            }
            catch e is Error {
                if sent.value() {
                    throw;
                }
                await self.respond(
                    request,
                    Response(
                        status: Status.internal_server_error,
                        version: HttpVersion.http_2
                    )
                );
            }
            true;
        }
        catch e is Cancelled {
            false;
        }
        catch Http2Fault.detailed(_, code, _, _) {
            self.reset(code);
            false;
        }
        catch e is Error {
            self.reset(2);
            false;
        };
        completed.set();
        result;
    }

    async continue_request() is bool {
        let group is FutureGroup<bool> = FutureGroup();
        let cleanup = Http2ServerSettlement(group);
        defer await cleanup.close();
        group.start(continuing);
        await continuing;
    }

    async respond(request is Request, response is Response) is bool {
        confirm !reset_sent.ready()
            else throw Http2Fault.detailed(
                Http2FaultScope.stream,
                8,
                self.stream(),
                "request body abandoned before response"
            );
        let status = response::Head::status;
        let class = StatusCode(status).class();
        confirm class != StatusClass.informational
            && !(request::Head::method == Method.connect && class == StatusClass.successful)
            else throw InvalidHttpMessage.because(
                "unsupported server final status or CONNECT tunnel"
            );
        let fields = Http2ResponseFields(response: response, stream: self.stream()).fields();
        let declared = Http2BodyLength(origin: response::Head::headers, stream: self.stream()).known();
        let suppressed = request::Head::method == Method.head
            || status == Status.no_content
            || status == Status.not_modified;
        confirm status != Status.no_content || declared.size() == 0
            else throw InvalidHttpMessage.because("204 forbids Content-Length");
        let known is @int = if suppressed {
            [];
        }
        else {
            try {
                [response.body().length()];
            }
            catch e is UnknownBodyLength {
                [];
            }
        };
        if !suppressed {
            for known -> length {
                confirm length.sign() >= 0
                    && length.order((owner.body_limit())) != Order.greater
                    else throw InvalidHttpMessage.because("response source length limit");
                for declared -> expected {
                    confirm length.order(expected) == Order.equal
                        else throw InvalidHttpMessage.because("response source length mismatch");
                }
            }
        }
        let zero = suppressed || (known.size() == 1 && known[0].sign() == 0);
        let ticket = owner.output().headers(self.stream(), fields, owner.budget(), 16384, zero);
        sent.replace(true);
        let pending = ticket.delivered();
        await pending;
        if zero {
            return true;
        }
        let producer = Http2ServerBodySending(
            sender: owner.sender(),
            output: owner.output(),
            budget: owner.budget(),
            stream: self.stream(),
            opening: response.body(),
            declared: declared,
            known: known,
            maximum: owner.body_limit()
        );
        let sending = producer.run();
        await sending;
    }

    async send_continue() is bool {
        let expected = head.headers().values(HeaderName("expect"));
        if expected.size() == 0 || self.ended() {
            return true;
        }
        let output = owner.output();
        let ticket = output.headers(
            self.stream(),
            [HpackField(name: ":status", value: "100")],
            owner.budget(),
            16384,
            false
        );
        let pending = ticket.delivered();
        await pending;
    }
}

hidden object Http2ServerBodySending {
    has sender is Http2DataScheduler;
    has output is Http2ConnectionOutput;
    has budget is HpackBudget;
    has stream, maximum is int;
    has opening is BodyOpening;
    has declared, known is @int;

    Http2ServerBodySending(
        sender is Http2DataScheduler,
        output is Http2ConnectionOutput,
        budget is HpackBudget,
        stream is int,
        opening is BodyOpening,
        declared is @int,
        known is @int,
        maximum is int
    ) {
        self.sender = sender;
        self.output = output;
        self.budget = budget;
        self.stream = stream;
        self.opening = opening;
        self.declared = declared;
        self.known = known;
        self.maximum = maximum;
    }

    async run() is bool {
        let source = opening.reading();
        defer source.close();
        let used = Atomic(0);
        loop {
            let remaining = maximum - used.value();
            let limit = if remaining >= 16384 {
                16384;
            }
            else {
                remaining + 1;
            };
            let pending = source.bytes(limit);
            let bytes = await pending;
            confirm bytes.size() <= limit
                else throw InvalidReading.because("H2 response source exceeded requested chunk");
            let total = used.value() + bytes.size();
            confirm total <= maximum else throw InvalidHttpMessage.because("response byte limit");
            for [declared, known] -> batch {
                for batch -> length {
                    let order = total.order(length);
                    confirm order != Order.greater && (bytes.size() > 0 || order == Order.equal)
                        else throw InvalidHttpMessage.because("response length mismatch");
                }
            }
            let offered = if bytes.size() == 0 {
                let trailers = Http2OrdinaryFields(
                    origin: source.trailers(),
                    request: false,
                    stream: stream
                ).fields();
                Http2Trailers(fields: trailers, stream: stream);
                if trailers.size() > 0 {
                    output.headers(stream, trailers, budget, 16384, true).delivered();
                }
                else {
                    sender.data(stream, bytes, true);
                }
            }
            else {
                sender.data(stream, bytes, false);
            };
            await offered;
            used.replace(total);
            if bytes.size() == 0 {
                return true;
            }
        }
    }
}

hidden object Http2ServerBody does BodyOpening {
    has entry is Http2ServerStream;
    has origin is BodyOpening;
    has timeout is Duration;
    has clock is Timing;

    Http2ServerBody(
        entry is Http2ServerStream,
        origin is BodyOpening,
        timeout is Duration,
        clock is Timing
    ) {
        self.entry = entry;
        self.origin = origin;
        self.timeout = timeout;
        self.clock = clock;
    }

    length() is int {
        origin.length();
    }

    replayable() is bool {
        origin.replayable();
    }

    // The whole body when it is already in memory (#115).
    contained() is Maybe<@byte> {
        Maybe<@byte>.none;
    }

    reading() is BodyReading {
        Http2ServerBodyReading(
            entry: entry,
            origin: origin.reading(),
            timeout: timeout,
            clock: clock
        );
    }
}

hidden object Http2ServerBodyReading does BodyReading {
    has entry is Http2ServerStream;
    has origin is BodyReading;
    has timeout is Duration;
    has clock is Timing;

    Http2ServerBodyReading(
        entry is Http2ServerStream,
        origin is BodyReading,
        timeout is Duration,
        clock is Timing
    ) {
        self.entry = entry;
        self.origin = origin;
        self.timeout = timeout;
        self.clock = clock;
    }

    closed() is bool {
        origin.closed();
    }

    close() is void {
        origin.close();
    }

    trailers() is Headers {
        origin.trailers();
    }

    async bytes(limit is int) is @byte {
        await entry.continue_request();
        let reading = origin.bytes(limit);
        let pending = if timeout::Span::seconds > 0.rat() {
            let deadline is Within<@byte> = Within(origin: reading, limit: timeout, clock: clock);
            deadline.outcome();
        }
        else {
            reading;
        };
        try {
            await pending;
        }
        catch e is TimedOut {
            throw Http2Fault.detailed(
                Http2FaultScope.stream,
                8,
                entry.stream(),
                "request body idle deadline"
            );
        }
    }
}

// One memoized informational write per admitted request. A complete body
// permits skipping100; construction and body opening alone emit nothing.
hidden object Http2ServerContinue {
    has entry is Http2ServerStream;

    Http2ServerContinue(entry is Http2ServerStream) {
        self.entry = entry;
    }

    async run() is bool {
        await entry.send_continue();
    }
}

// At most nine header bytes are retained. One absolute budget spans the
// initial HEADERS and every CONTINUATION read until dispatch completes. DATA
// payload reads use the separate body-idle budget. The idle monitor observes
// busy transitions, so it can start after an unrelated handler completes while
// the sole physical reader is already waiting for its next byte.
hidden object Http2ServerWireInput does AsyncReading, Http2ReadBoundary {
    has origin is AsyncReading;
    has owner is Http2ServerState;
    has between is Atomic<bool>;
    has header is Atomic<@byte>;
    has remaining, kind is Atomic<int>;
    has deadlines is Atomic<@MonotonicInstant>;

    Http2ServerWireInput(origin is AsyncReading, owner is Http2ServerState) {
        self.origin = origin;
        self.owner = owner;
        between = Atomic(true);
        let bytes is @byte = [];
        header = Atomic(bytes);
        remaining = Atomic(0);
        kind = Atomic(-1);
        let times is @MonotonicInstant = [];
        deadlines = Atomic(times);
    }

    dispatched() is void {
        between.replace(true);
        header.replace([]);
        remaining.replace(0);
        kind.replace(-1);
        deadlines.replace([]);
        owner.busy(false);
    }

    account(bytes is @byte) is void {
        if remaining.value() > 0 {
            remaining.replace(remaining.value() - bytes.size());
            if remaining.value() == 0 {
                header.replace([]);
                kind.replace(-1);
            }
            return;
        }
        let old = header.value();
        let following is @byte = old + bytes;
        header.replace(following);
        if following.size() == 9 {
            kind.replace(following[3].int());
            remaining.replace(
                Binary(bytes: following.slice(0, 3), order: ByteOrder.big).int(Signedness.unsigned)
            );
            if remaining.value() == 0 {
                header.replace([]);
                kind.replace(-1);
            }
        }
    }

    async bytes(limit is int) is @byte {
        let first = between.value();
        let count = if first {
            1;
        }
        else {
            let available = if remaining.value() > 0 {
                remaining.value();
            }
            else {
                9 - header.value().size();
            };
            if available < limit {
                available;
            }
            else {
                limit;
            }
        };
        let reading = origin.bytes(count);
        let pending = if !first && kind.value() == 0 && remaining.value() > 0 {
            let interval = owner.policy().timeouts().body_idle_timeout();
            if interval::Span::seconds > 0.rat() {
                let idle is Within<@byte> = Within(
                    origin: reading,
                    limit: interval,
                    clock: owner.clock()
                );
                idle.outcome();
            }
            else {
                reading;
            }
        }
        else {
            if !first && deadlines.value().size() == 1 {
                let deadline is Before<@byte> = Before(
                    origin: reading,
                    deadline: deadlines.value()[0],
                    clock: owner.clock()
                );
                deadline.outcome();
            }
            else {
                reading;
            }
        };
        let bytes = await pending;
        confirm bytes.size() <= count
            else throw InvalidReading.because("H2 server input exceeded request");
        if first && bytes.size() > 0 {
            between.replace(false);
            owner.busy(true);
            let interval = owner.policy().timeouts().headers_timeout();
            if interval::Span::seconds > 0.rat() {
                deadlines.replace([owner.clock().monotonic_instant().plus(interval)]);
            }
        }
        if bytes.size() > 0 {
            self.account(bytes);
        }
        bytes;
    }
}

hidden object Http2ServerSettlement<T> {
    has group is FutureGroup<T>;

    Http2ServerSettlement(group is FutureGroup<T>) {
        self.group = group;
    }

    async close() is void {
        if group.active() > 0 {
            group.cancel();
            await group.wait();
        }
    }
}

hidden object Http2ServerCleanup {
    has state is Http2ServerState;
    has owner is Closing;
    has finished is Event;

    Http2ServerCleanup(state is Http2ServerState, owner is Closing, finished is Event) {
        self.state = state;
        self.owner = owner;
        self.finished = finished;
    }

    async destroy {
        defer finished.set();
        defer owner.close();
        await state.cleanup();
    }
}

// The session was used after it closed.
enum Http2ServerClosed is Error = (closed);

// In-memory session fixtures: no sockets and no wall-clock deadlines.

hidden object Http2ServerTestOutput does AsyncWriting {
    has buffer is ByteBuffer;
    has writes is Atomic<int>;
    has fail_after is int;

    Http2ServerTestOutput(fail_after is int = -1) {
        buffer = ByteBuffer();
        writes = Atomic(0);
        self.fail_after = fail_after;
    }

    async write(source is ByteSource) is AsyncWriting {
        await self.write(source.bytes());
    }

    async write(bytes is @byte) is AsyncWriting {
        confirm writes.value() != fail_after
            else throw InvalidReading.because("test output failure");
        writes.replace(writes.value() + 1);
        buffer.writing().write(bytes);
        self;
    }

    bytes() is @byte {
        buffer.content().bytes();
    }
}

hidden object Http2ServerTestClock does Timing {
    has elapsed is Event;
    has waiting is Atomic<int>;

    Http2ServerTestClock(elapsed is Event = Event()) {
        self.elapsed = elapsed;
        waiting = Atomic(0);
    }

    instant() is Instant {
        Instant(Duration(seconds: 100));
    }

    monotonic_instant() is MonotonicInstant {
        MonotonicInstant(Duration(seconds: 100));
    }

    async wait(duration is Duration) is void {
        waiting.replace(waiting.value() + 1);
        defer waiting.replace(waiting.value() - 1);
        await elapsed.wait();
    }

    active() is int {
        waiting.value();
    }
}

hidden object Http2ServerTestHandler does Handling {
    Http2ServerTestHandler();

    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        panic "no request was sent";
    }
}

hidden object Http2ServerTestConnection {
    Http2ServerTestConnection();

    preface() is @byte {
        let payload = Http2SettingsWire(origin: Http2Settings(), client: true).bytes();
        Utf8Encoded("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n").bytes() + Http2Frame(
            header: Http2FrameHeader(4.byte(), 0.byte(), 0, payload.size()),
            payload: payload
        ).bytes();
    }

    session(input is ByteBodyInput, output is AsyncWriting) is Http2ServerSession {
        self.session(input, output, input, Http2ServerTestClock(), Duration(seconds: 0));
    }

    session(
        input is AsyncReading,
        output is AsyncWriting,
        owner is Closing,
        clock is Timing,
        idle is Duration
    ) is Http2ServerSession {
        let endpoints is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
            local: IpEndpoint(IpAddress("127.0.0.1"), 80),
            remote: IpEndpoint(IpAddress("127.0.0.1"), 50000)
        );
        Http2ServerSession(
            input: input,
            output: output,
            owner: owner,
            handling: Http2ServerTestHandler(),
            details: ExchangeDetails(endpoints: endpoints, version: HttpVersion.http_2),
            policy: ServerPolicy(
                protocols: OrderedSet([HttpVersion.http_2]),
                limits: HttpLimits(),
                timeouts: ServerTimeouts(
                    headers: Duration(seconds: 0),
                    body_idle: Duration(seconds: 0),
                    keep_alive: idle,
                    handling: Duration(seconds: 0)
                ),
                connections: 1,
                ranges: 16
            ),
            clock: clock
        );
    }
}

async test "an HTTP/2 server settles EOF immediately after preface and SETTINGS" {
    let connection = Http2ServerTestConnection();
    let input = ByteBodyInput(connection.preface());
    let server = connection.session(input, Http2ServerTestOutput());
    test.is(await server.serve(), true);
    test.is(server.closed(), true);
    test.is(input.closed(), true);
    test.is(await server.drained(), true);
    test.is(await server.settled(), true);
}

async test "an HTTP/2 server settles early EOF after control frames and GOAWAY" {
    let connection = Http2ServerTestConnection();
    let ack = Http2Frame(header: Http2FrameHeader(4.byte(), 1.byte(), 0, 0), payload: []).bytes();
    let ping = Http2Frame(
        header: Http2FrameHeader(6.byte(), 0.byte(), 0, 8),
        payload: [0.byte(), 1.byte(), 2.byte(), 3.byte(), 4.byte(), 5.byte(), 6.byte(), 7.byte()]
    ).bytes();
    for [ack, ping, Http2GoAwayFrame(last_stream: 0, code: 0, debug: []).frame().bytes()] -> tail {
        let input = ByteBodyInput(connection.preface() + tail);
        let server = connection.session(input, Http2ServerTestOutput());
        test.is(await server.serve(), true);
        test.is(input.closed(), true);
        test.is(await server.drained(), true);
        test.is(await server.settled(), true);
    }
}

async test "an HTTP/2 server preserves faults and settles every truncated preface" {
    let connection = Http2ServerTestConnection();
    let preface = connection.preface();
    for 0..preface.size() -> length {
        let input = ByteBodyInput(preface.slice(0, length));
        let server = connection.session(input, Http2ServerTestOutput());
        let code = try {
            await server.serve();
            -1;
        }
        catch failure is Http2Fault {
            Http2FaultView(failure).code();
        };
        test.is(code, 1);
        test.is(input.closed(), true);
        test.is(await server.drained(), true);
        test.is(await server.settled(), true);
    }
}

async test "an HTTP/2 server preserves partial frame faults and sends GOAWAY" {
    let connection = Http2ServerTestConnection();
    let ping = Http2Frame(
        header: Http2FrameHeader(6.byte(), 0.byte(), 0, 8),
        payload: [0.byte(), 1.byte(), 2.byte(), 3.byte(), 4.byte(), 5.byte(), 6.byte(), 7.byte()]
    ).bytes();
    for 1..ping.size() -> length {
        let input = ByteBodyInput(connection.preface() + ping.slice(0, length));
        let output = Http2ServerTestOutput();
        let server = connection.session(input, output);
        let reason = try {
            await server.serve();
            "served";
        }
        catch failure is Http2Fault {
            test.is(Http2FaultView(failure).code(), 1);
            Http2FaultView(failure).reason();
        };
        test.is(reason, if length < 9 {
            "partial frame header";
        }
        else {
            "partial frame payload";
        });
        let goodbye = Http2GoAwayFrame(last_stream: 0, code: 1, debug: []).frame().bytes();
        let written = output.bytes();
        test.is(written.slice(written.size() - goodbye.size(), written.size()), goodbye);
        test.is(input.closed(), true);
        test.is(await server.drained(), true);
        test.is(await server.settled(), true);
    }
}

// Keeps the transport open after its prefix so cancellation must settle a read.
hidden object Http2ServerTestWaitingInput does AsyncReading, Closing {
    has prefix is ByteBodyInput;
    has waiting is Atomic<int>;
    has fail is bool;

    Http2ServerTestWaitingInput(bytes is @byte, fail is bool = false) {
        prefix = ByteBodyInput(bytes);
        waiting = Atomic(0);
        self.fail = fail;
    }

    async bytes(limit is int) is @byte {
        let bytes = await prefix.bytes(limit);
        if bytes.size() > 0 {
            return bytes;
        }
        confirm !fail else throw InvalidReading.because("test input failure");
        waiting.replace(waiting.value() + 1);
        defer waiting.replace(waiting.value() - 1);
        await Event().wait();
        bytes;
    }

    active() is int {
        waiting.value();
    }

    closed() is bool {
        prefix.closed();
    }

    close() is void {
        prefix.close();
    }
}

async test "an HTTP/2 server settles an immediate idle timeout and its pending read" {
    let connection = Http2ServerTestConnection();
    let input = Http2ServerTestWaitingInput(bytes: connection.preface());
    let clock = Http2ServerTestClock(elapsed: Event(ready: true));
    let server = connection.session(
        input,
        Http2ServerTestOutput(),
        input,
        clock,
        Duration(seconds: 1)
    );
    test.is(await server.serve(), true);
    test.is(input.closed(), true);
    test.is(input.active(), 0);
    test.is(clock.active(), 0);
    test.is(await server.drained(), true);
    test.is(await server.settled(), true);
}

async test "an HTTP/2 server preserves an immediate input failure and settles" {
    let connection = Http2ServerTestConnection();
    let input = Http2ServerTestWaitingInput(bytes: connection.preface(), fail: true);
    let clock = Http2ServerTestClock();
    let server = connection.session(
        input,
        Http2ServerTestOutput(),
        input,
        clock,
        Duration(seconds: 1)
    );
    let reason = try {
        await server.serve();
        "served";
    }
    catch InvalidReading.because(reason) {
        reason;
    };
    test.is(reason, "test input failure");
    test.is(input.closed(), true);
    test.is(input.active(), 0);
    test.is(clock.active(), 0);
    test.is(await server.drained(), true);
    test.is(await server.settled(), true);
}

async test "an HTTP/2 server preserves writer failure and settles its read and timer" {
    let connection = Http2ServerTestConnection();
    let ping = Http2Frame(
        header: Http2FrameHeader(6.byte(), 0.byte(), 0, 8),
        payload: [0.byte(), 1.byte(), 2.byte(), 3.byte(), 4.byte(), 5.byte(), 6.byte(), 7.byte()]
    ).bytes();
    let input = Http2ServerTestWaitingInput(bytes: connection.preface() + ping);
    let clock = Http2ServerTestClock();
    let server = connection.session(
        input,
        Http2ServerTestOutput(fail_after: 2),
        input,
        clock,
        Duration(seconds: 1)
    );
    let reason = try {
        await server.serve();
        "served";
    }
    catch InvalidReading.because(reason) {
        reason;
    };
    test.is(reason, "test output failure");
    test.is(input.closed(), true);
    test.is(input.active(), 0);
    test.is(clock.active(), 0);
    test.is(await server.drained(), true);
    test.is(await server.settled(), true);
}

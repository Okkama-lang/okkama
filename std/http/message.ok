async test "response status content compatible Content-Type (#942)" {
    let response = Response(
        status: Status.created,
        content: TextBody(text: "hé"),
        headers: Headers(
            Header(name: "Content-Type", value: "Text/Plain; Charset=UTF-8; format=flowed")
        ),
        version: HttpVersion.http_1_0
    );
    let fields = response::Head::headers;
    test.is(fields.values(HeaderName("Content-Type")).size(), 1);
    test.is(fields.text("Content-Type"), "Text/Plain; Charset=UTF-8; format=flowed");
    let reading = response.body().reading();
    defer reading.close();
    test.is(Utf8Decoded(await reading.bytes(64)).string(), "hé");
}

test "response status content conflicting Content-Type (#942)" {
    for ["application/json", "text/plain; charset=iso-8859-1", "text/plain"] -> declared {
        test.throws(ConflictingContentType) {
            Response(
                status: Status.created,
                content: TextBody(text: "hé"),
                headers: Headers(Header(name: "Content-Type", value: declared)),
                version: HttpVersion.http_1_0
            );
        };
    }
}


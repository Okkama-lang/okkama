// Binds a route table to a listener: HTTP/1.1 in cleartext, or HTTPS with
// HTTP/2 and HTTP/1.1 offered by ALPN (#80).
//
//     await WebApplication(routes).listen(address: "127.0.0.1", port: 8000);
//     await WebApplication(routes).listen(address: "0.0.0.0", port: 8443, tls: identity);
//
// listen() serves until SIGTERM or SIGINT: then the server stops accepting,
// gives the requests in flight 10 seconds to finish, closes, and listen()
// returns; a second signal ends the process at once. The address is an IP
// literal; no name resolution happens here. server() binds and returns the std
// HttpServer without serving, for callers that own the lifetime themselves:
// port 0 picks a free port, local_endpoint() reports it, and server.drain(limit:)
// drains it.

// A route table served on an address and port. Pass logger: to log every
// completed request, including 404s and fallbacks; the default logs nothing.
// Exceptions keep their HTTP status at info; other errors log 500 at error
// with their cause and propagate. The request never carries the logger.
object WebApplication does Handling {
    has routes is WebRoutes;
    has policy is ServerPolicy;
    has clock is Timing;
    has logger is Logger;

    // Serves routes with the default policy. logger logs completed requests at
    // info, or unhandled errors at error with their cause; omitted, it is silent.
    // Lines are "GET /notes?limit=5 200 0.412 ms", with an address field.
    WebApplication(
        routes is WebRoutes,
        logger is Logger = Logger(name: "web", destination: DiscardingLogs())
    ) {
        self.routes = routes;
        policy = ServerPolicy();
        clock = SystemClock();
        self.logger = logger;
    }

    // Serves routes with policy, timing requests on clock. logger has the same
    // line, levels and address field as above; omitted, it logs nothing.
    WebApplication(
        routes is WebRoutes,
        policy is ServerPolicy,
        clock is Timing,
        logger is Logger = Logger(name: "web", destination: DiscardingLogs())
    ) {
        self.routes = routes;
        self.policy = policy;
        self.clock = clock;
        self.logger = logger;
    }

    // The server knows its own URL, so a WebSocket route can check the Origin
    // of an upgrade against it.
    async server(address is string, port is int) is HttpServer {
        let host = IpAddress(address);
        let listener = await TcpListening(port: port, address: host).listener();
        let literal = if host.version() == IpVersion.v6 {
            "[" + host.string() + "]";
        }
        else {
            host.string();
        };
        let own = ParsedUrl("http://" + literal + ":" + listener::Local::port.string() + "/")
            .parts();
        HttpServer(
            listener: listener,
            handling: self,
            url: own,
            policy: policy,
            clock: clock
        );
    }

    // Serves on address and port until the process stops.
    async listen(address is string, port is int) is void {
        let stopping = AppStopping();
        defer await stopping.close();
        await stopping.serve(await self.server(address, port));
        // #1180: listen() drains the logger here
    }

    // HTTPS: the identity's certificate and key, HTTP/2 and HTTP/1.1 by ALPN.
    async listen(address is string, port is int, tls is TlsIdentity) is void {
        let stopping = AppStopping();
        defer await stopping.close();
        await stopping.serve(await self.server(address, port, tls));
        // #1180: listen() drains the logger here
    }

    // The HTTPS server, bound and not serving; its own URL is https.
    async server(address is string, port is int, tls is TlsIdentity) is HttpServer {
        let host = IpAddress(address);
        let listener = await TcpListening(port: port, address: host).listener();
        let literal = if host.version() == IpVersion.v6 {
            "[" + host.string() + "]";
        }
        else {
            host.string();
        };
        let own = ParsedUrl("https://" + literal + ":" + listener::Local::port.string() + "/")
            .parts();
        let both is Set<HttpVersion> = OrderedSet([HttpVersion.http_1_1, HttpVersion.http_2]);
        let secured = ServerPolicy(
            protocols: both,
            limits: policy.limits(),
            timeouts: policy.timeouts(),
            connections: policy.connections(),
            ranges: policy.ranges()
        );
        HttpServer(
            listener: listener,
            handling: self,
            url: own,
            tls: TlsServerPolicy(identity: tls),
            policy: secured,
            clock: clock
        );
    }

    // Handles a request through the server's pipeline, including its log.
    // WebTestClient(application) exercises it without a listener.
    async handling(request is Request, context is HttpRequestContext) is HandlingResult {
        // A silent logger costs one check: no clock reading, no line, no catch.
        if !logger.enabled(LogLevel.error) {
            return await routes.table().handling(request, context);
        }
        let log = RequestLog(
            request: request,
            context: context,
            clock: clock,
            start: clock.monotonic_instant()
        );
        let answer = try {
            await routes.table().handling(request, context);
        }
        catch Exception.status(code, _detail) {
            log.info(logger, code.string());
            throw;
        }
        catch failure is Error {
            log.error(logger, failure);
            throw failure;
        };
        let status = if answer.kind() == HandlingKind.websocket {
            Status.switching_protocols;
        }
        else {
            answer.response()::Head::status;
        };
        log.info(logger, StatusCode(status).number().string());
        answer;
    }

    async test "request logging covers responses exceptions and propagated failures" {
        let kept = CollectedLogs();
        let logger = Logger(name: "test.web", destination: kept);
        let clock = ManualClock(start: Instant(origin: Duration(seconds: 0.rat())));
        defer clock.close();
        let probe = RequestLogProbe(clock);
        let routes = WebRoutes(
            Post(path: "/notes", endpoint: probe.created),
            Get(path: "/gone", endpoint: probe.gone),
            Get(path: "/failed", endpoint: probe.failed),
            Get(path: "/unavailable", endpoint: probe.unavailable),
        );
        let app = WebApplication(
            routes: routes,
            policy: ServerPolicy(),
            clock: clock,
            logger: logger
        );
        let client = WebTestClient(app);
        test.is((await client.post("/notes?limit=5&q=a%20b", TextBody(text: "")))::Head::code, 201);
        test.is((await client.get("/missing"))::Head::code, 404);
        test.is((await client.get("/gone"))::Head::code, 410);
        let propagated = try {
            await client.get("/failed?");
            false;
        }
        catch failure is RequestLogFailure {
            failure == RequestLogFailure.broken;
        };
        test.ok(propagated);
        test.is((await client.get("/unavailable"))::Head::code, 503);
        test.is(kept.size(), 5);
        let records = kept.records();
        test.is(records.item(0)::Entry::message, "POST /notes?limit=5&q=a%20b 201 0.412 ms");
        test.is(records.item(1)::Entry::message, "GET /missing 404 0.000 ms");
        test.is(records.item(2)::Entry::message, "GET /gone 410 1.005 ms");
        test.is(records.item(3)::Entry::message, "GET /failed? 500 12.345 ms");
        test.is(records.item(4)::Entry::message, "GET /unavailable 503 0.000 ms");
        for 0..5 -> index {
            let record = records.item(index);
            test.is(record.context().fields().values().string(), "{\"address\":\"127.0.0.1\"}");
            test.is(record.context().name().string(), "test.web");
            test.ok(record::Entry::level == (if index == 3: LogLevel.error else: LogLevel.info));
            test.is(record.has_cause(), index == 3);
        }
        test.is(records.item(3).cause().text(), RequestLogFailure.broken.text());
    }

    async test "request logging includes fallbacks and routing rejections" {
        let kept = CollectedLogs();
        let greetings = Greetings();
        let routes = WebRoutes(
            Get(path: "/notes", endpoint: greetings.long),
            Fallback(greetings.missing),
        );
        let app = WebApplication(routes: routes, logger: Logger(name: "web", destination: kept));
        let client = WebTestClient(app);
        test.is((await client.get("/elsewhere?q=1"))::Head::code, 404);
        test.is((await client.post("/notes", TextBody(text: "")))::Head::code, 405);
        test.is(kept.size(), 2);
        test.ok(kept.records().item(0)::Entry::message.starts_with("GET /elsewhere?q=1 404 "));
        test.ok(kept.records().item(1)::Entry::message.starts_with("POST /notes 405 "));
        for kept.records() -> record {
            test.ok(record::Entry::level == LogLevel.info);
            test.is(record.context().fields().values().text("address"), "127.0.0.1");
        }
    }

    async test "request logging respects an error-only logger" {
        let kept = CollectedLogs();
        let clock = ManualClock(start: Instant(origin: Duration(seconds: 0.rat())));
        defer clock.close();
        let probe = RequestLogProbe(clock);
        let routes = WebRoutes(Get(path: "/failed", endpoint: probe.failed));
        let app = WebApplication(
            routes: routes,
            policy: ServerPolicy(),
            clock: clock,
            logger: Logger(name: "web", destination: kept, level: LogLevel.error)
        );
        let client = WebTestClient(app);
        test.is((await client.get("/missing"))::Head::code, 404);
        try {
            await client.get("/failed");
        }
        catch failure is RequestLogFailure {}
        test.is(kept.size(), 1);
        test.is(kept.records().first()::Entry::message, "GET /failed 500 12.345 ms");
        test.ok(kept.records().first()::Entry::level == LogLevel.error);
        test.is(kept.records().first().cause().text(), RequestLogFailure.broken.text());
    }

    async test "request logging keeps an escaping HTTP exception status" {
        let kept = CollectedLogs();
        let clock = ManualClock(start: Instant(origin: Duration(seconds: 0.rat())));
        defer clock.close();
        let probe = RequestLogProbe(clock);
        let app = WebApplication(
            routes: WebRoutes(Get(path: "/late", endpoint: probe.late)),
            policy: ServerPolicy(),
            clock: clock,
            logger: Logger(name: "web", destination: kept)
        );
        let client = WebTestClient(app);
        let propagated = try {
            await client.get("/late");
            false;
        }
        catch Exception.status(code, detail) {
            code == 409 && detail == "late conflict";
        };
        test.ok(propagated);
        test.is(kept.size(), 1);
        test.is(kept.records().first()::Entry::message, "GET /late 409 0.000 ms");
        test.ok(kept.records().first()::Entry::level == LogLevel.info);
        test.ok(!kept.records().first().has_cause());
    }

    async test "request logging preserves WebSocket upgrade results" {
        let kept = CollectedLogs();
        let clock = ManualClock(start: Instant(origin: Duration(seconds: 0.rat())));
        defer clock.close();
        let app = WebApplication(
            routes: WebRoutes(WebSocket(path: "/live", application: Shouting())),
            policy: ServerPolicy(),
            clock: clock,
            logger: Logger(name: "web", destination: kept)
        );
        let client = WebTestClient(app);
        test.is((await client.get("/live"))::Head::code, 101);
        test.is(kept.size(), 1);
        test.is(kept.records().first()::Entry::message, "GET /live 101 0.000 ms");
        test.ok(kept.records().first()::Entry::level == LogLevel.info);
    }

    async test "request logging is silent without a logger" {
        let clock = ManualClock(start: Instant(origin: Duration(seconds: 0.rat())));
        defer clock.close();
        let probe = RequestLogProbe(clock);
        let routes = WebRoutes(
            Post(path: "/notes", endpoint: probe.created),
            Get(path: "/gone", endpoint: probe.gone),
            Get(path: "/failed", endpoint: probe.failed),
        );
        let applications = [
            WebApplication(routes),
            WebApplication(routes: routes, policy: ServerPolicy(), clock: clock)
        ];
        for applications -> app {
            let client = WebTestClient(app);
            test.is((await client.post("/notes", TextBody(text: "")))::Head::code, 201);
            test.is((await client.get("/missing"))::Head::code, 404);
            test.is((await client.get("/gone"))::Head::code, 410);
            let propagated = try {
                await client.get("/failed");
                false;
            }
            catch failure is RequestLogFailure {
                failure == RequestLogFailure.broken;
            };
            test.ok(propagated);
        }
    }
}

// Serving that stops on SIGTERM or SIGINT. The signals are taken when the
// object is made, before the port is bound (Interruption), so a signal that
// comes as soon as the port accepts is not missed. On the signal the server
// stops accepting, the requests in flight get 10 seconds, and the server
// closes, which ends serve(); a second signal ends the process at once.
// close() gives the signals their earlier actions back if none came.
hidden object AppStopping {
    has interruption is Interruption;
    has signals is FutureGroup<CaughtSignal>;
    has draining is FutureGroup<bool>;

    AppStopping() {
        let taking = Interruption(signals: [CaughtSignal.terminate, CaughtSignal.interrupt]);
        let waiting is FutureGroup<CaughtSignal> = FutureGroup();
        waiting.start(taking.arrival());
        interruption = taking;
        signals = waiting;
        draining = FutureGroup();
    }

    async serve(server is HttpServer) is void {
        draining.start(self.drained(server));
        defer await server.settled();
        defer server.close();
        await server.serve();
    }

    async drained(server is HttpServer) is bool {
        await signals.wait();
        await server.drain(limit: Duration(seconds: 10.rat()));
        true;
    }

    async close() is void {
        signals.cancel();
        draining.cancel();
        try {
            await draining.wait();
        }
        catch e is Cancelled {}
        try {
            await signals.wait();
        }
        catch e is Cancelled {}
        interruption.close();
    }
}

hidden enum RequestLogFailure is Error = (broken);

hidden object RequestLogProbe {
    has clock is ManualClock;

    RequestLogProbe(clock is ManualClock) {
        self.clock = clock;
    }

    async created(request is WebRequest) is Responding {
        clock.advance(Duration(seconds: 412 / 1000000));
        TextReply(text: "created", status: Status.created);
    }

    async gone(request is WebRequest) is Responding {
        clock.advance(Duration(seconds: 1005 / 1000000));
        throw Exception.status(410, "gone");
    }

    async failed(request is WebRequest) is Responding {
        clock.advance(Duration(seconds: 12345 / 1000000));
        throw RequestLogFailure.broken;
    }

    async late(request is WebRequest) is Responding {
        LateRequestReply();
    }

    async unavailable(request is WebRequest) is Responding {
        throw Exception.status(503, "unavailable");
    }
}

hidden object LateRequestReply does Responding {
    LateRequestReply();

    response() is Response {
        throw Exception.status(409, "late conflict");
    }
}

hidden object Greetings {
    Greetings();

    async hello(request is WebRequest) is Responding {
        TextReply(
            "Hello, " + request.path().text("name") +
                (request.query().maybe("mark").text() else "") + "!"
        );
    }

    async echo(request is WebRequest) is Responding {
        TextReply(text: (await request.text(1024)).upper(), status: Status.created);
    }

    async long(request is WebRequest) is Responding {
        TextReply("tea ".repeat(2000));
    }

    async missing(request is WebRequest) is Responding {
        TextReply(
            text: "no " + MethodName(request.method()).string() + " here",
            status: Status.not_found
        );
    }
}

hidden object Shouting does WebSocketHandling {
    Shouting();

    async handle(
        connection is WebSocketConnection,
        request is Request,
        context is HttpRequestContext
    ) is WebSocketHandling {
        for await connection -> message {
            if message.text().starts_with("{") {
                await connection.send_json(
                    Json(JsonField("shout", message.json().text("say").upper()))
                );
            }
            else {
                await connection.send_text(message.text().upper());
            }
        }
        self;
    }
}

async test "a web application routes requests over loopback and drains" {
    let greetings = Greetings();
    let routes = WebRoutes(
        Scope(
            "/api",
            Get(path: "/hello/:name", endpoint: greetings.hello),
            Post(path: "/echo", endpoint: greetings.echo),
        ),
        WebSocket(path: "/shout", application: Shouting()),
        Fallback(greetings.missing),
    );
    let server = (await WebApplication(routes).server("127.0.0.1", 0)).started();
    let base = "http://127.0.0.1:" + server::Local::port.string();
    let client = HttpClient(endpoints: LoopbackEndpoints());
    test.is(await (await client.get(base + "/api/hello/Ada?mark=%21")).text(), "Hello, Ada!!");
    let created = await client.post(url: base + "/api/echo", body: TextBody(text: "quiet"));
    test.is(created::Head::status, Status.created);
    test.is(await created.text(), "QUIET");
    let lost = await client.get(base + "/nowhere");
    test.is(lost::Head::status, Status.not_found);
    test.is(await lost.text(), "no GET here");
    let socket = await WebSocketConnecting(
        url: ParsedUrl("ws://127.0.0.1:" + server::Local::port.string() + "/shout").parts(),
        headers: Headers(Header(name: "Origin", value: base)),
        resolver: FixedResolution(),
        policy: WebSocketPolicy(
            limits: WebSocketLimits(),
            opening: Duration(seconds: 5.rat()),
            closing: Duration(seconds: 2.rat()),
            access: LoopbackEndpoints(),
        ),
    ).connection();
    await socket.send(TextWebSocketMessage("hey"));
    test.is((await socket.message()).text(), "HEY");
    await socket.send_json(Json(JsonField("say", "hi")));
    let answer = await socket.next();
    test.is(
        match answer {
            case Maybe.some(message) {
                message.json().text("shout");
            }
            else {
                "closed";
            }
        },
        "HI"
    );
    await socket.close(1000, "bye");
    client.close();
    await server.drain(limit: Duration(seconds: 5.rat()));
}

async test "a compressed reply reaches the client decoded" {
    let greetings = Greetings();
    let routes = WebRoutes(Around(Compression()), Get(path: "/long", endpoint: greetings.long));
    let server = (await WebApplication(routes).server("127.0.0.1", 0)).started();
    let base = "http://127.0.0.1:" + server::Local::port.string();
    let client = HttpClient(endpoints: LoopbackEndpoints());
    let page = await client.get(base + "/long");
    test.ok(!page::Head::headers.membership(HeaderName("Content-Encoding")));
    test.is(await page.text(), "tea ".repeat(2000));
    let raw = await client.response(
        Request(
            url: base + "/long",
            headers: Headers(Header(name: "Accept-Encoding", value: "gzip"))
        )
    );
    test.is(raw::Head::headers.text("Content-Encoding"), "gzip");
    test.is(
        Utf8Decoded(GzipDecompressed(origin: await raw.bytes(), limit: 100000).bytes()).string(),
        "tea ".repeat(2000)
    );
    client.close();
    await server.drain(limit: Duration(seconds: 5.rat()));
}


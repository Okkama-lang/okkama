module web/testing v1.0.0;

// Calls a route table the way HttpClient calls a server, without a network
// (#85). A request goes through the routes, their arounds and exception
// scopes, and comes back as the ClientResponse a real client gets, so a test
// reads it the same way:
//
//     let client = WebTestClient(routes);
//     let page = await client.get("/notes/7");
//     test.is(page::Head::code, 200);
//     test.is((await page.json()).text("title"), "Tea");
//
// A target is a path with an optional query, "/notes?limit=5". The request
// comes from 127.0.0.1 over HTTP/1.1. A HEAD response has no body, as on the
// wire, and an accepted WebSocket upgrade is 101 Switching Protocols.
//
// Every method takes `headers`. A client made with a cookie jar keeps the
// cookies the replies set and sends them back, as a browser does, so a login
// and the requests after it can be tested end to end:
//
//     let client = WebTestClient(routes: routes, cookies: MemoryCookieJar());
//     await client.post("/login", FormBody(...));
//     test.is((await client.get("/me"))::Head::code, 200);
//
// The site of those cookies is http://127.0.0.1; a Cookie field the caller
// sets is sent as it is, instead of the jar's.

import "http/handler" take Handling, HandlingKind;
import "http/request_context" take HttpRequestContext;
import "http/message" take Request, Response, Responding;
import "http/method" take Method;
import "http/status" take Status;
import "http/header" take Headers, Header, HeaderName;
import "http/target" take ParsedRequestTarget;
import "http/body" take Content, EmptyBody, TextBody, JsonBody, BytesBody;
import "http/exchange" take ClientResponse, ExchangeDetails;
import "http/version" take HttpVersion;
import "async/cancellation" take Cancellation;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "web/routing" take WebRoutes, Get, Post, Delete, Resource, Around;
import "web/around" take BearerAuth;
import "web/request" take WebRequest;
import "web/reply" take TextReply, JsonReply, CreatedReply;
import "json" take Json, JsonField;
import "http/cookie_jar" take CookieStoring, MemoryCookieJar;
import "http/cookie_policy" take CookieContext;
import "http/cookie" take Cookie;
import "http/target" take RequestTargetKind;
import "url/value" take ParsedUrl, UrlParts;
import "collections/sequence" take Sequencing;

// Calls a route table like an HTTP client, without a network, for tests.
object WebTestClient {
    has routes is Handling;
    has cookies is CookieStoring;

    // A client of routes; it keeps no cookies.
    WebTestClient(routes is Handling) {
        self.routes = routes;
        cookies = NoTestCookies();
    }

    // A client of routes that keeps the cookies replies set in cookies and
    // sends them with later requests.
    WebTestClient(routes is Handling, cookies is CookieStoring) {
        self.routes = routes;
        self.cookies = cookies;
    }

    // The table's response to request.
    async response(request is Request) is ClientResponse {
        // Cookies follow requests for paths (origin-form targets) on the site http://127.0.0.1.
        let pathed = request::Head::target.kind() == RequestTargetKind.origin;
        let site = ParsedUrl(
            "http://127.0.0.1" + (if pathed: request::Head::target.string() else: "/")
        ).parts();
        let cookie_context = CookieContext(
            site: site,
            top_level: true,
            method: request::Head::method
        );
        let caller_cookie = request::Head::headers.membership(HeaderName("Cookie"));
        let pairs = if pathed && !caller_cookie: TestCookiePairs(
            cookies.cookies(site, cookie_context)
        ).string() else: "";
        let sent = if pairs == "" {
            request;
        }
        else {
            Request(
                target: request::Head::target,
                method: request::Head::method,
                headers: request::Head::headers.addition(Header(name: "Cookie", value: pairs)),
                body: request.body(),
                version: request::Head::version
            );
        };
        let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(
            local: IpEndpoint(address: IpAddress("127.0.0.1"), port: 80),
            remote: IpEndpoint(address: IpAddress("127.0.0.1"), port: 50000)
        );
        let details = ExchangeDetails(endpoints: ends, version: HttpVersion.http_1_1);
        let context = HttpRequestContext(
            details: details,
            cancellation: Cancellation().cancelling()
        );
        let result = await routes.handling(sent, context);
        let answered = if result.kind() == HandlingKind.websocket {
            Response(status: Status.switching_protocols);
        }
        else {
            result.response();
        };
        if pathed {
            cookies.store(site, answered::Head::headers, cookie_context);
        }
        let response = if request::Head::method == Method.head {
            Response(
                status: answered::Head::status,
                headers: answered::Head::headers,
                body: EmptyBody()
            );
        }
        else {
            answered;
        };
        ClientResponse(request: request, response: response, details: details);
    }

    // GET target, with headers.
    async get(target is string, headers is Headers = Headers()) is ClientResponse {
        await self.response(TestRequest(target: target, method: Method.get).request(headers));
    }

    // HEAD target, with headers.
    async head(target is string, headers is Headers = Headers()) is ClientResponse {
        await self.response(TestRequest(target: target, method: Method.head).request(headers));
    }

    // OPTIONS target, with headers.
    async options(target is string, headers is Headers = Headers()) is ClientResponse {
        await self.response(TestRequest(target: target, method: Method.options).request(headers));
    }

    // DELETE target, with headers.
    async delete(target is string, headers is Headers = Headers()) is ClientResponse {
        await self.response(TestRequest(target: target, method: Method.delete).request(headers));
    }

    // POST body to target.
    async post(
        target is string,
        body is Content,
        headers is Headers = Headers()
    ) is ClientResponse {
        await self.response(
            TestRequest(target: target, method: Method.post).request(body, headers)
        );
    }

    // PUT body to target.
    async put(target is string, body is Content, headers is Headers = Headers()) is ClientResponse {
        await self.response(TestRequest(target: target, method: Method.put).request(body, headers));
    }

    // PATCH body to target.
    async patch(
        target is string,
        body is Content,
        headers is Headers = Headers()
    ) is ClientResponse {
        await self.response(
            TestRequest(target: target, method: Method.patch).request(body, headers)
        );
    }
}

// A request for a target, with a body framed the way HttpClient frames it:
// Content-Type from the content and Content-Length from its size, unless the
// headers give them.
hidden object TestRequest {
    has target is string;
    has method is Method;

    TestRequest(target is string, method is Method) {
        self.target = target;
        self.method = method;
    }

    request(headers is Headers) is Request {
        Request(
            target: ParsedRequestTarget(origin: target, method: method).target(),
            method: method,
            headers: headers
        );
    }

    request(body is Content, headers is Headers) is Request {
        let opening = body.opening();
        let typed = if headers.membership(HeaderName("Content-Type")) {
            headers;
        }
        else {
            headers.addition(Header(name: "Content-Type", value: body.media_type()));
        };
        let fields = if typed.membership(HeaderName("Content-Length"))
            || typed.membership(HeaderName("Transfer-Encoding")) {
            typed;
        }
        else {
            typed.addition(Header(name: "Content-Length", value: opening.length().string()));
        };
        Request(
            target: ParsedRequestTarget(origin: target, method: method).target(),
            method: method,
            headers: fields,
            body: opening
        );
    }
}

// The jar of a client made without one: nothing is kept or sent.
hidden object NoTestCookies does CookieStoring {
    NoTestCookies() {}

    cookies(origin is UrlParts, context is CookieContext) is Sequencing<Cookie> {
        let empty is @Cookie = [];
        empty;
    }

    store(origin is UrlParts, headers is Headers, context is CookieContext) is void {}

    clear() is void {}
}

// The jar's cookies as one Cookie field value: "a=1; b=2".
hidden object TestCookiePairs {
    has text is string;

    TestCookiePairs(cookies is Sequencing<Cookie>) {
        let pairs is @string = (0..cookies.size()).map() -> index {
            cookies.item(index).pair();
        };
        text = pairs.join("; ");
    }

    string() is string {
        text;
    }
}

hidden object TestNotes {
    TestNotes() {}

    async accepted(request is WebRequest) is Responding {
        TextReply("accept " + (request.header().maybe("Accept").text() else "none"));
    }

    async login(request is WebRequest) is Responding {
        TextReply(
            text: "in",
            headers: Headers(Header(name: "Set-Cookie", value: "sid=abc123; Path=/; HttpOnly"))
        );
    }

    async me(request is WebRequest) is Responding {
        match request.cookies().maybe("sid").text() {
            case Maybe.some(sid) {
                TextReply("session " + sid);
            }
            else {
                TextReply(text: "anonymous", status: Status.unauthorized);
            }
        }
    }

    async logout(request is WebRequest) is Responding {
        TextReply(
            text: "out",
            headers: Headers(Header(name: "Set-Cookie", value: "sid=; Path=/; Max-Age=0"))
        );
    }

    async show(request is WebRequest) is Responding {
        let id = request.path().int("id");
        JsonReply(Json(JsonField("id", id), JsonField("title", "Tea")));
    }

    async add(request is WebRequest) is Responding {
        let body = await request.json(4096);
        CreatedReply(location: "/notes/2", value: Json(JsonField("title", body.text("title"))));
    }

    async search(request is WebRequest) is Responding {
        TextReply("page " + (request.query().maybe("page").int() else 1).string());
    }
}

async test "a test client calls the routes without a network" {
    let notes = TestNotes();
    let client = WebTestClient(
        WebRoutes(
            Resource("/notes", Get(notes.search), Post(notes.add)),
            Get(path: "/notes/:id", endpoint: notes.show),
            Get(path: "/admin", endpoint: notes.search),
        )
    );
    let page = await client.get("/notes/7");
    test.is(page::Head::code, 200);
    test.is((await page.json()).text("title"), "Tea");
    test.is((await page.json()).int("id"), 7);
    test.is(await (await client.get("/notes?page=3")).text(), "page 3");
    let created = await client.post("/notes", JsonBody(Json(JsonField("title", "Milk"))));
    test.is(created::Head::status, Status.created);
    test.is(created::Head::headers.text("Location"), "/notes/2");
    test.is((await created.json()).text("title"), "Milk");
    let bad = await client.get("/notes/x");
    test.is(bad::Head::code, 400);
    test.is((await bad.json()).text("detail"), "path parameter id must be an integer");
    let missing = await client.get("/elsewhere");
    test.is(missing::Head::code, 404);
    let refused = await client.delete("/notes");
    test.is(refused::Head::code, 405);
    test.is(refused::Head::headers.text("Allow"), "GET, HEAD, POST");
    let head = await client.head("/notes/7");
    test.is(head::Head::code, 200);
    test.is((await head.bytes()).size(), 0);
    let text = await client.put("/notes", TextBody("x"));
    test.is(text::Head::code, 405);
    // A JSON body goes to the parser as bytes (#135): non-ASCII text reads
    // back, and bytes that are not UTF-8 are a 400 naming where they start.
    let tea = await client.post(
        "/notes",
        BytesBody(
            bytes: [
                123.byte(),
                34.byte(),
                116.byte(),
                105.byte(),
                116.byte(),
                108.byte(),
                101.byte(),
                34.byte(),
                58.byte(),
                34.byte(),
                195.byte(),
                167.byte(),
                97.byte(),
                34.byte(),
                125.byte()
            ],
            media_type: "application/json"
        )
    );
    test.is((await tea.json()).text("title"), "ça");
    let broken = await client.post(
        "/notes",
        BytesBody(
            bytes: [
                123.byte(),
                34.byte(),
                116.byte(),
                34.byte(),
                58.byte(),
                34.byte(),
                255.byte(),
                34.byte(),
                125.byte()
            ],
            media_type: "application/json"
        )
    );
    test.is(broken::Head::code, 400);
    test.ok((await broken.json()).text("detail").contains("6, 1, 7, \"invalid UTF-8\""));
}

async test "a test client passes the arounds of the routes" {
    let notes = TestNotes();
    let client = WebTestClient(
        WebRoutes(Around(BearerAuth(token: "s3cret")), Get(path: "/notes", endpoint: notes.search))
    );
    test.is((await client.get("/notes"))::Head::code, 401);
    let request = Request(
        target: ParsedRequestTarget(origin: "/notes?page=2", method: Method.get).target(),
        headers: Headers(Header(name: "Authorization", value: "Bearer s3cret"))
    );
    let page = await client.response(request);
    test.is(await page.text(), "page 2");
}

async test "every method sends headers (#650)" {
    let notes = TestNotes();
    let client = WebTestClient(
        WebRoutes(
            Get(path: "/accept", endpoint: notes.accepted),
            Resource("/guarded", Get(notes.search), Post(notes.add)),
        )
    );
    let accept = Headers(Header(name: "Accept", value: "text/plain"));
    test.is(
        await (await client.get(target: "/accept", headers: accept)).text(),
        "accept text/plain"
    );
    test.is(await (await client.get("/accept")).text(), "accept none");
    let guarded = WebTestClient(
        WebRoutes(
            Around(BearerAuth(token: "s3cret")),
            Get(path: "/notes", endpoint: notes.search),
            Delete(path: "/notes", endpoint: notes.search),
        )
    );
    let bearer = Headers(Header(name: "Authorization", value: "Bearer s3cret"));
    test.is((await guarded.get("/notes"))::Head::code, 401);
    test.is(await (await guarded.get(target: "/notes?page=4", headers: bearer)).text(), "page 4");
    test.is((await guarded.head(target: "/notes", headers: bearer))::Head::code, 200);
    test.is((await guarded.delete("/notes"))::Head::code, 401);
    test.is(
        await (await guarded.delete(target: "/notes?page=5", headers: bearer)).text(),
        "page 5"
    );
    // No route serves OPTIONS: the table answers 405, headers or not.
    test.is((await guarded.options(target: "/notes", headers: bearer))::Head::code, 405);
}

async test "a client with a jar carries the cookies replies set (#650)" {
    let notes = TestNotes();
    let routes = WebRoutes(
        Post(path: "/login", endpoint: notes.login),
        Get(path: "/me", endpoint: notes.me),
        Post(path: "/logout", endpoint: notes.logout),
    );
    let browser = WebTestClient(routes: routes, cookies: MemoryCookieJar());
    test.is((await browser.get("/me"))::Head::code, 401);
    test.is(await (await browser.post("/login", TextBody("u"))).text(), "in");
    test.is(await (await browser.get("/me")).text(), "session abc123");
    // A Cookie field the caller sets goes instead of the jar's.
    test.is(
        await (await browser.get(
            target: "/me",
            headers: Headers(Header(name: "Cookie", value: "sid=mine"))
        )).text(),
        "session mine"
    );
    test.is(await (await browser.post("/logout", TextBody(""))).text(), "out");
    // Logout expired the cookie.
    test.is((await browser.get("/me"))::Head::code, 401);
    // A client without a jar keeps nothing.
    let plain = WebTestClient(routes);
    await plain.post("/login", TextBody("u"));
    test.is((await plain.get("/me"))::Head::code, 401);
}

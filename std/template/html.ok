module template/html v1.0.0;

// HTML templates that escape each value for where it lands.
//
//     let card = HtmlTemplate("<p title=\"{{.}}\">Hello, {{.}}</p>");
//     card.string(Json("Ada & \"friends\""));   // <p title="Ada &amp; &quot;friends&quot;">…
//
// Values may go into text and into a whitelist of quoted ordinary attributes;
// anywhere else, such as an event handler attribute, the template is refused
// with InvalidHtmlTemplate before anything is written. The template's own
// markup must be balanced; nothing is sanitized or repaired.
//
// HtmlTemplate is template/engine's Template with TemplateEscaping.html and no
// partials (#178): the one engine compiles, checks and renders it, and its
// refusals come back as InvalidHtmlTemplate. Sections are checked as the
// engine checks them; a partial is refused, as there is no library.

import "template/engine" take Template, TemplateEscaping, TemplateLimits, TemplateError;
import "template/compile" take InvalidTemplateLimits;
import "json" take Json;
import "io/stream" take WritingText;

// An HTML template.
object HtmlTemplate {
    has origin is string;
    has maximum_input, maximum_nodes, maximum_output is int;

    // A template of source, within 65536 characters, 10000 nodes and 1 MiB of
    // output.
    HtmlTemplate(source is string) {
        origin = source;
        maximum_input = 65536;
        maximum_nodes = 10000;
        maximum_output = 1048576;
    }

    // The same within these limits.
    HtmlTemplate(
        source is string,
        maximum_input is int,
        maximum_nodes is int,
        maximum_output is int
    ) {
        confirm maximum_input >= 0 && maximum_nodes >= 0 && maximum_output >= 0
            else throw InvalidTemplateLimits.invalid;
        origin = source;
        self.maximum_input = maximum_input;
        self.maximum_nodes = maximum_nodes;
        self.maximum_output = maximum_output;
    }

    // Its source.
    source() is string {
        origin;
    }

    // The HTML filled from data; InvalidHtmlTemplate for a place values may not
    // go.
    string(data is Json) is string {
        try {
            self.engine().string(data);
        }
        catch TemplateError.html(reason) {
            throw InvalidHtmlTemplate.because(reason);
        }
        catch TemplateError.partial(name) {
            throw InvalidHtmlTemplate.because(
                "partial " + name + " needs a library: use template/engine"
            );
        }
    }

    // Writes the HTML to destination, piece by piece.
    write(data is Json, destination is WritingText) is void {
        try {
            self.engine().write(data, destination);
        }
        catch TemplateError.html(reason) {
            throw InvalidHtmlTemplate.because(reason);
        }
        catch TemplateError.partial(name) {
            throw InvalidHtmlTemplate.because(
                "partial " + name + " needs a library: use template/engine"
            );
        }
    }

    hidden engine() is Template {
        once let engine = Template(
            source: origin,
            escaping: TemplateEscaping.html,
            limits: TemplateLimits(
                characters: maximum_input,
                tokens: maximum_nodes,
                output: maximum_output
            )
        );
        engine;
    }
}

// A template that is not safe or not valid; reason says why.
enum InvalidHtmlTemplate is Error = (because(reason is string));

test "HTML templates escape text and quoted ordinary attributes" {
    test.is(
        HtmlTemplate("<p title=\"{{.}}\">Hello, {{.}}</p>").string(Json("Ada & \"friends\"")),
        "<p title=\"Ada &amp; &quot;friends&quot;\">Hello, Ada &amp; \"friends\"</p>"
    );
}

test "HTML templates refuse event attributes, raw content and unfinished markup" {
    for ["<p onclick='{{.}}'>x</p>", "<script>{{.}}</script>", "<p>{{.}}", "{{>part}}"] -> source {
        test.ok(try {
            HtmlTemplate(source).string(Json("x"));
            false;
        }
        catch e is InvalidHtmlTemplate {
            true;
        });
    }
    test.is(InvalidHtmlTemplate.because("test").text(), "InvalidHtmlTemplate.because(\"test\")");
    test.throws(InvalidTemplateLimits) {
        HtmlTemplate(source: "", maximum_input: -1, maximum_nodes: 0, maximum_output: 0);
    };
}

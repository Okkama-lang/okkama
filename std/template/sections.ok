module template/sections v1.0.0;

// Section templates over JSON, in the Mustache style.
//
//     let order = SectionTemplate(
//         source: "Order {{id}}:\n{{#items}}  - {{title}}\n{{/items}}{{^items}}  (empty)\n{{/items}}",
//     );
//     order.string(ParsedJson(text).root());
//
// `{{#name}}…{{/name}}` repeats over an array, renders once for an object or a
// true value, and not at all for false, null, "", [] or a missing member;
// `{{^name}}` is the opposite; `{{.}}` is the current item; `{{>name}}`
// includes a template from the partials library. Nothing is escaped.
//
// SectionTemplate is template/engine's Template in text mode (#178): the one
// engine compiles and renders it, its library becomes TemplatePartials, and
// the engine's failures come back as the errors this module always had
// (TemplateIterationLimitExceeded, UnsupportedTemplatePartial, MissingTemplate,
// TemplatePartialDepthExceeded, TemplateSectionDepthExceeded). New code uses
// Template directly.

import "template/library" take TemplateLibrary, MissingTemplate;
import "template/compile" take InvalidTemplateLimits, TemplateOutputLimitExceeded;
import "template/compile" as legacy take TextTemplate;
import "template/engine" take Template, TemplatePartials, TemplateLimits, TemplateError;
import "json" take Json, ParsedJson;
import "io/stream" take WritingText;
import "async/atomic" take Atomic;
import "runtime/template" take template_output_size;

// A section template over JSON.
object SectionTemplate {
    has origin is string;
    has maximum_iterations, maximum_output, maximum_members is int;
    has partials is TemplateLibrary;
    has maximum_partial_depth is int = 32;
    has partials_enabled is bool = false;

    // A template of source, without partials: 10000 iterations, 1 MiB of
    // output, 1024 members a step.
    SectionTemplate(source is string) {
        origin = source;
        partials = TemplateLibrary();
        maximum_iterations = 10000;
        maximum_output = 1048576;
        maximum_members = 1024;
    }

    // The same within these limits.
    SectionTemplate(
        source is string,
        maximum_iterations is int,
        maximum_output is int,
        maximum_members is int
    ) {
        confirm maximum_iterations >= 0 && maximum_output >= 0 && maximum_members >= 0
            else throw InvalidTemplateLimits.invalid;
        origin = source;
        partials = TemplateLibrary();
        self.maximum_iterations = maximum_iterations;
        self.maximum_output = maximum_output;
        self.maximum_members = maximum_members;
    }

    // A template that may include partials, nested at most 32 deep.
    SectionTemplate(source is string, partials is TemplateLibrary) {
        origin = source;
        self.partials = partials;
        partials_enabled = true;
        maximum_iterations = 10000;
        maximum_output = 1048576;
        maximum_members = 1024;
    }

    // The same within these limits.
    SectionTemplate(
        source is string,
        partials is TemplateLibrary,
        maximum_iterations is int,
        maximum_output is int,
        maximum_members is int,
        maximum_partial_depth is int
    ) {
        confirm maximum_iterations >= 0
            && maximum_output >= 0
            && maximum_members >= 0
            && maximum_partial_depth >= 0
            else throw InvalidTemplateLimits.invalid;
        origin = source;
        self.partials = partials;
        partials_enabled = true;
        self.maximum_iterations = maximum_iterations;
        self.maximum_output = maximum_output;
        self.maximum_members = maximum_members;
        self.maximum_partial_depth = maximum_partial_depth;
    }

    // The text for data; the source is checked whole first.
    string(data is Json) is string {
        try {
            self.engine().string(data);
        }
        catch failure is TemplateError {
            throw SectionTemplateFailure(failure: failure, partials: partials_enabled).error();
        }
    }

    // Writes the text for data to destination.
    write(data is Json, destination is WritingText) is void {
        try {
            self.engine().write(data, destination);
        }
        catch failure is TemplateError {
            throw SectionTemplateFailure(failure: failure, partials: partials_enabled).error();
        }
    }

    hidden engine() is Template {
        once let engine = Template(
            source: origin,
            partials: TemplateLibraryPartials(partials).partials(),
            limits: TemplateLimits(
                iterations: maximum_iterations,
                output: maximum_output,
                members: maximum_members,
                partials: maximum_partial_depth
            )
        );
        engine;
    }
}

// A template library's sources as the engine's partials.
hidden object TemplateLibraryPartials {
    has library is TemplateLibrary;

    TemplateLibraryPartials(library is TemplateLibrary) {
        self.library = library;
    }

    partials() is TemplatePartials {
        let none_here is %string:string = [:];
        TemplatePartials(library.names().reduce(none_here) -> sources, name {
            sources + [name: library.template(name).source()];
        });
    }
}

// The engine's failure as the error this module throws.
hidden object SectionTemplateFailure {
    has failure is TemplateError;
    has partials is bool;

    SectionTemplateFailure(:failure, :partials);

    error() is Error {
        match failure {
            case TemplateError.iterations(_) {
                TemplateIterationLimitExceeded.exceeded;
            }
            case TemplateError.depth(_) {
                TemplateSectionDepthExceeded.exceeded;
            }
            case TemplateError.partial_depth(_) {
                TemplatePartialDepthExceeded.exceeded;
            }
            case TemplateError.partial(name) {
                if partials {
                    MissingTemplate.name(name);
                }
                else {
                    UnsupportedTemplatePartial.name(name);
                }
            }
            else {
                failure;
            }
        }
    }
}

// A borrowed text sink with a byte budget. It owns only its count, never the
// sink. Empty contributions produce no calls. No newline, flush, close or
// retry, and no whole-result storage. At most 1024 scalars per sink call.
object TemplateSectionOutput {
    has destination is WritingText;
    has maximum is int;
    has used is Atomic<int>;

    // To destination, at most maximum bytes.
    TemplateSectionOutput(destination is WritingText, maximum is int) {
        confirm maximum >= 0 else throw InvalidTemplateLimits.invalid;
        self.destination = destination;
        self.maximum = maximum;
        used = Atomic(0);
    }

    // Bytes left.
    remaining() is int {
        maximum - used.value();
    }

    // Writes value; TemplateOutputLimitExceeded beyond the limit, before any
    // of it is written.
    append(value is string) is void {
        let size = template_output_size(value, maximum - used.value());
        confirm size >= 0 else throw TemplateOutputLimitExceeded.exceeded;
        used.replace(used.value() + size);
        for (0..((value.length() + 1023) >> 10)) -> chunk {
            let start = chunk << 10;
            let end = if value.length() - start > 1024 {
                start + 1024;
            }
            else {
                value.length();
            };
            destination.write(value.slice(start, end));
        }
    }
}

// More iterations than the limit.
enum TemplateIterationLimitExceeded is Error = (exceeded);

// A negative size.
enum InvalidTemplateSectionSize is Error = (invalid);

// A partial the library does not have, or partials without a library.
enum UnsupportedTemplatePartial is Error = (name(name is string));

// Partial expansion and active section depth are separate bounded dimensions.
enum TemplatePartialDepthExceeded is Error = (exceeded);

// Sections nested deeper than allowed.
enum TemplateSectionDepthExceeded is Error = (exceeded);

// What was written to it, for the tests.
hidden object TemplateSectionWrites does WritingText {
    has parts is Atomic<@string>;

    TemplateSectionWrites() {
        let none_yet is @string = [];
        parts = Atomic(none_yet);
    }

    write(values is ...string) is void {
        let listed is @string = values...;
        parts.replace(parts.value() + listed);
    }

    writeln(values is ...string) is void {
        let listed is @string = values...;
        parts.replace(parts.value() + listed + ["\n"]);
    }

    parts() is @string {
        parts.value();
    }
}

test "section templates render what they always rendered (#178: goldens from the old engine)" {
    let data = ParsedJson(
        "{\"id\":17,\"items\":[{\"title\":\"Tea\",\"price\":\"4.50\"},{\"title\":\"Cake\",\"price\":3}],\"none\":[],\"user\":{\"name\":\"Ada\"},\"t\":true,\"z\":null,\"s\":\"\"}"
    ).root();
    test.is(
        SectionTemplate(
            "Order {{id}}:\n{{#items}}  - {{title}} ({{price}})\n{{/items}}{{^items}}  (empty)\n{{/items}}"
        ).string(data),
        "Order 17:\n  - Tea (4.50)\n  - Cake (3)\n"
    );
    test.is(SectionTemplate("{{#none}}x{{/none}}{{^none}}none{{/none}}").string(data), "none");
    test.is(
        SectionTemplate(
            "{{#user}}{{name}}{{/user}}{{#t}}T{{/t}}{{^z}}Z{{/z}}{{^s}}S{{/s}}{{#missing}}M{{/missing}}"
        ).string(data),
        "AdaTZS"
    );
    test.is(
        SectionTemplate("a\n  {{#items}}\n  * {{title}}\n  {{/items}}\nb {{! c }}d").string(data),
        "a\n  * Tea\n  * Cake\nb d"
    );
    test.is(
        SectionTemplate("{{#items}}{{#title}}[{{.}}]{{/title}}{{/items}}").string(data),
        "[Tea][Cake]"
    );
    let item = TemplateLibrary(["item": legacy.TextTemplate("  - {{title}}\n")]);
    test.is(
        SectionTemplate(
            source: "Order {{id}}:\n{{#items}}{{>item}}{{/items}}{{^items}}  (empty)\n{{/items}}",
            partials: item
        ).string(data),
        "Order 17:\n  - Tea\n  - Cake\n"
    );
}

test "section templates keep their errors: iterations, partials, depths, limits" {
    let data = ParsedJson("{\"xs\":[1,2,3]}").root();
    test.throws(TemplateIterationLimitExceeded) {
        SectionTemplate(
            source: "{{#xs}}{{.}}{{/xs}}",
            maximum_iterations: 2,
            maximum_output: 100,
            maximum_members: 10
        ).string(data);
    };
    test.is(
        SectionTemplate(
            source: "{{#xs}}{{.}}{{/xs}}",
            maximum_iterations: 3,
            maximum_output: 100,
            maximum_members: 10
        ).string(data),
        "123"
    );
    test.is(
        try {
            SectionTemplate("{{>item}}").string(data);
            "";
        }
        catch UnsupportedTemplatePartial.name(name) {
            name;
        },
        "item"
    );
    test.is(
        try {
            SectionTemplate(source: "{{>item}}", partials: TemplateLibrary()).string(data);
            "";
        }
        catch MissingTemplate.name(name) {
            name;
        },
        "item"
    );
    let forever = TemplateLibrary(["loop": legacy.TextTemplate("x{{>loop}}")]);
    test.throws(TemplatePartialDepthExceeded) {
        SectionTemplate(
            source: "{{>loop}}",
            partials: forever,
            maximum_iterations: 100,
            maximum_output: 100,
            maximum_members: 10,
            maximum_partial_depth: 3
        ).string(data);
    };
    let deep = TemplateLibrary(["in": legacy.TextTemplate("{{#.}}{{>in}}{{/.}}")]);
    test.throws(TemplateSectionDepthExceeded) {
        SectionTemplate(
            source: "{{>in}}",
            partials: deep,
            maximum_iterations: 1000,
            maximum_output: 100,
            maximum_members: 10,
            maximum_partial_depth: 100
        ).string(Json(true));
    };
    test.throws(TemplateOutputLimitExceeded) {
        SectionTemplate(
            source: "{{#xs}}é{{/xs}}",
            maximum_iterations: 10,
            maximum_output: 5,
            maximum_members: 10
        ).string(data);
    };
    test.is(TemplatePartialDepthExceeded.exceeded.text(), "TemplatePartialDepthExceeded.exceeded");
    test.is(TemplateSectionDepthExceeded.exceeded.text(), "TemplateSectionDepthExceeded.exceeded");
}

test "section configuration rejects negatives before parsing" {
    test.throws(InvalidTemplateLimits) {
        SectionTemplate(source: "{{", maximum_iterations: -1, maximum_output: 0, maximum_members: 0);
    };
    test.throws(InvalidTemplateLimits) {
        SectionTemplate(source: "{{", maximum_iterations: 0, maximum_output: -1, maximum_members: 0);
    };
    test.throws(InvalidTemplateLimits) {
        SectionTemplate(source: "{{", maximum_iterations: 0, maximum_output: 0, maximum_members: -1);
    };
}

test "a section output measures exact UTF-8 contributions and refuses one whole" {
    let writes = TemplateSectionWrites();
    let output = TemplateSectionOutput(destination: writes, maximum: 6);
    output.append("é");
    test.is(output.remaining(), 4);
    output.append("😀");
    test.is(output.remaining(), 0);
    output.append("");
    test.throws(TemplateOutputLimitExceeded) {
        output.append("x");
    };
    test.is(output.remaining(), 0);
    test.is(writes.parts(), ["é", "😀"]);
    let small = TemplateSectionOutput(destination: TemplateSectionWrites(), maximum: 1);
    test.throws(TemplateOutputLimitExceeded) {
        small.append("é");
    };
    test.is(small.remaining(), 1);
    let large = TemplateSectionOutput(
        destination: TemplateSectionWrites(),
        maximum: 9223372036854775807
    );
    large.append("x");
    test.is(large.remaining(), 9223372036854775806);
    test.throws(InvalidTemplateLimits) {
        TemplateSectionOutput(destination: TemplateSectionWrites(), maximum: -1);
    };
}

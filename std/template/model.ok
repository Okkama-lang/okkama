module template/model v1.0.0;

// The strings a text template is filled with.
//
//     TemplateBindings(["user.name": "Ada"]);
//     TemplateBindings(TemplateBinding(path: TemplatePath("user", "name"), value: "Ada"));
//
// A value is looked up by its exact path; MissingTemplateValue when absent.
// Values are plain strings: no objects, no reflection.
//
// The bindings are one Json document (#178), the data model of
// template/engine: `user.name` is member name of member user. A path that is
// a value and also leads to others (`a` and `a.b`) has no such document and is
// DuplicateTemplateValue, like a path given twice; both are found in one pass.

import "template/path" take TemplatePath, TemplatePathFromString;

import "collections/sequence" take Sequencing;
import "compare" take Order;
import "json" take Json, JsonField, JsonKind;

// Something a text template takes its values from.
role TemplateStrings {
    // The value at path; MissingTemplateValue when absent.
    string(path is TemplatePath) is string;

    fake {
        string(path is TemplatePath) is string {
            test.is(path.string(), "name");
            "Ada";
        }
    }
}

// One value at a path.
object TemplateBinding {
    has key is TemplatePath;
    has value is string;

    // value at path.
    TemplateBinding(path is TemplatePath, value is string) {
        key = path;
        self.value = value;
    }

    // The path.
    path() is TemplatePath {
        key;
    }

    // The value.
    string() is string {
        value;
    }
}

// Values given by path.
object TemplateBindings does TemplateStrings {
    has origin is @TemplateBinding;

    // The values, at most 1024; DuplicateTemplateValue for a repeated path.
    TemplateBindings(values is Sequencing<TemplateBinding>) {
        origin = TemplateBindingSnapshot(source: values, maximum: 1024).items();
    }

    // The same, one argument per part: TemplateBindings(a, b).
    TemplateBindings(values is ...TemplateBinding) {
        let listed is @TemplateBinding = values...;
        origin = TemplateBindingSnapshot(source: listed, maximum: 1024).items();
    }

    // Texts by dotted path: TemplateBindings(["user.name": "Ada"]). A segment
    // that holds a dot needs TemplateBinding and TemplatePath.
    TemplateBindings(texts is %string:string) {
        let names = texts.keys();
        let values = texts.values();
        let listed is @TemplateBinding = (0..names.size()).map() -> index {
            TemplateBinding(path: TemplatePathFromString(names[index]).path(), value: values[index]);
        };
        origin = TemplateBindingSnapshot(source: listed, maximum: 1024).items();
    }

    // The values, at most maximum_bindings.
    TemplateBindings(values is Sequencing<TemplateBinding>, maximum_bindings is int) {
        origin = TemplateBindingSnapshot(source: values, maximum: maximum_bindings).items();
    }

    // The value at path; MissingTemplateValue when absent.
    string(path is TemplatePath) is string {
        let found = path.segments().reduce(self.json()) -> current, name {
            if current.kind() == JsonKind.object_value && current.has(name) {
                current.get(name);
            }
            else {
                Json();
            }
        };
        confirm found.kind() == JsonKind.string_value
            else throw MissingTemplateValue.path(path.string());
        found.text();
    }

    // The bindings as one Json document.
    hidden json() is Json {
        once let document = TemplateBindingsJson(origin.map() -> binding {
            TemplateBindingEntry(segments: binding.path().segments(), value: binding.string());
        }).json();
        document;
    }
}

// One binding as the rest of its path below some object, and its value.
hidden object TemplateBindingEntry {
    has segments is @string;
    has value is string;

    TemplateBindingEntry(segments is Sequencing<string>, value is string) {
        self.segments = (0..segments.size()).map() -> index {
            segments.item(index);
        };
        self.value = value;
    }

    first() is string {
        segments[0];
    }

    leaf() is bool {
        segments.size() == 1;
    }

    rest() is TemplateBindingEntry {
        TemplateBindingEntry(segments: segments.slice(1, segments.size()), value: value);
    }

    value() is string {
        value;
    }
}

// Bindings below one object as that object: members in first-seen order.
hidden object TemplateBindingsJson {
    has entries is @TemplateBindingEntry;
    has prefix is string = "";

    TemplateBindingsJson(entries is @TemplateBindingEntry) {
        self.entries = entries;
    }

    TemplateBindingsJson(entries is @TemplateBindingEntry, prefix is string) {
        self.entries = entries;
        self.prefix = prefix;
    }

    json() is Json {
        let none_here is %string:@TemplateBindingEntry = [:];
        let names is @string = [];
        let grouped = entries.reduce(none_here) -> groups, entry {
            groups + [entry.first(): (groups[entry.first()] else []) + [entry]];
        };
        let order = entries.reduce(names) -> seen, entry {
            if seen.contains(entry.first()) {
                seen;
            }
            else {
                seen + [entry.first()];
            }
        };
        let fields is @JsonField = order.map() -> name {
            let group = grouped[name];
            let leaves = group.filter() -> entry {
                entry.leaf();
            };
            if leaves.size() > 0 {
                confirm group.size() == 1 else throw DuplicateTemplateValue.path(prefix + name);
                JsonField(name, Json(leaves[0].value()));
            }
            else {
                let below is @TemplateBindingEntry = group.map() -> entry {
                    entry.rest();
                };
                JsonField(
                    name,
                    TemplateBindingsJson(entries: below, prefix: prefix + name + ".").json()
                );
            }
        };
        Json(fields);
    }
}

// Internal bounded snapshot collaborator; importable because module declarations
// have no private visibility. No item is reread during duplicate validation.
hidden object TemplateBindingSnapshot {
    has origin is @TemplateBinding;

    TemplateBindingSnapshot(source is Sequencing<TemplateBinding>, maximum is int) {
        confirm maximum >= 0 else throw InvalidTemplateBindingLimit.invalid;
        let size = source.size();
        confirm size >= 0 else throw InvalidTemplateBindingSize.invalid;
        confirm size <= maximum else throw TemplateBindingLimitExceeded.exceeded;
        let snapshot is @TemplateBinding = (0..size).map() -> index {
            source.item(index);
        };
        let seen is %string:bool = [:];
        snapshot.reduce(seen) -> paths, binding {
            let parts = binding.path().segments();
            let key = (0..parts.size()).map() -> index {
                parts.item(index);
            }.join("\u{0}");
            confirm !paths.has(key) else throw DuplicateTemplateValue.path(binding.path().string());
            paths + [key: true];
        };
        origin = snapshot;
    }

    items() is @TemplateBinding {
        origin;
    }
}

// No value at the path.
enum MissingTemplateValue is Error = (path(path is string));

// Two values at one path.
enum DuplicateTemplateValue is Error = (path(path is string));

// A negative limit.
enum InvalidTemplateBindingLimit is Error = (invalid);

// A negative size.
enum InvalidTemplateBindingSize is Error = (invalid);

// More values than the limit.
enum TemplateBindingLimitExceeded is Error = (exceeded);

test "explicit template strings have exact nominal paths" {
    let data is TemplateStrings = TemplateBindings(
        TemplateBinding(path: TemplatePath("user.name"), value: "literal"),
        TemplateBinding(path: TemplatePath("user", "name"), value: "nested")
    );
    test.is(data.string(TemplatePath("user.name")), "literal");
    test.is(data.string(TemplatePath("user", "name")), "nested");
    test.is(TemplateStrings.fake().string(TemplatePath("name")), "Ada");
}

test "template binding errors retain path and budget contracts" {
    test.is(
        try {
            TemplateBindings(values: [], maximum_bindings: 0).string(TemplatePath("missing"));
            "";
        }
        catch MissingTemplateValue.path(path) {
            path.string();
        },
        "missing"
    );
    test.ok(try {
        TemplateBindings(values: [], maximum_bindings: -1);
        false;
    }
    catch error is InvalidTemplateBindingLimit {
        true;
    });
    test.ok(try {
        TemplateBindings(
            values: [TemplateBinding(path: TemplatePath("a"), value: "")],
            maximum_bindings: 0
        );
        false;
    }
    catch error is TemplateBindingLimitExceeded {
        true;
    });
    test.is(
        try {
            TemplateBindings(
                TemplateBinding(path: TemplatePath("x"), value: "1"),
                TemplateBinding(path: TemplatePath("x"), value: "2")
            );
            "";
        }
        catch DuplicateTemplateValue.path(path) {
            path.string();
        },
        "x"
    );
}

test "bindings are one Json document: nested, literal-dot and conflicting paths (#178)" {
    let data = TemplateBindings(
        TemplateBinding(path: TemplatePath("user", "name"), value: "Ada"),
        TemplateBinding(path: TemplatePath("user", "mail"), value: "a@x"),
        TemplateBinding(path: TemplatePath("user.name"), value: "dot")
    );
    test.is(data.string(TemplatePath("user", "mail")), "a@x");
    test.is(data.string(TemplatePath("user.name")), "dot");
    test.throws(MissingTemplateValue) {
        data.string(TemplatePath("user", "name", "first"));
    };
    test.is(
        try {
            TemplateBindings(["a": "1", "a.b": "2"]).string(TemplatePath("a"));
            "";
        }
        catch DuplicateTemplateValue.path(path) {
            path;
        },
        "a"
    );
    let many is @TemplateBinding = (0..1000).map() -> index {
        TemplateBinding(path: TemplatePath("k" + index.string()), value: index.string());
    };
    test.is(TemplateBindings(many).string(TemplatePath("k999")), "999");
}

test "bindings read a map of dotted paths" {
    let data = TemplateBindings(["user.name": "Ada", "user.unread": "3", "plain": ""]);
    test.is(data.string(TemplatePath("user", "name")), "Ada");
    test.is(data.string(TemplatePath("user", "unread")), "3");
    test.is(data.string(TemplatePath("plain")), "");
    test.throws(MissingTemplateValue) {
        data.string(TemplatePath("user"));
    };
}

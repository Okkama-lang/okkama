module template/library v1.0.0;

// Named text templates, for partials of section templates.
//
//     let partials = TemplateLibrary(["item": TextTemplate("  - {{title}}\n")]);
//     SectionTemplate(source: "{{#items}}{{>item}}{{/items}}", partials: partials);
//
// Names are exact: no trimming or case folding. template/engine's
// TemplatePartials is the one library of the engine (#178); SectionTemplate
// turns a TemplateLibrary into it.

import "collections/sequence" take Sequencing;
import "template/compile" take TextTemplate;

// A text template with its name.
object NamedTemplate {
    has key is string;
    has origin is TextTemplate;

    // value named name; InvalidTemplateName for an empty name.
    NamedTemplate(name is string, value is TextTemplate) {
        confirm name != "" else throw InvalidTemplateName.invalid;
        key = name;
        origin = value;
    }

    // The name.
    name() is string {
        key;
    }

    // The template.
    template() is TextTemplate {
        origin;
    }
}

// Immutable ordered library, empty by default. Sequence constructors snapshot
// size once then each ascending item once, rejecting invalid size/excess count
// before item access. Optional nonnegative maximum_templates defaults to 1024;
// zero permits an empty source. Duplicates are checked after the full snapshot.
// Original source failures propagate; no cursor/first/last/close calls.
// Queries never revisit the source. Missing names throw MissingTemplate, while
// membership returns false, including for "". Returned values/names outlive us.
// Retains TextTemplate owners; no resource acquisition, compilation or destroy.
// O(n) references; duplicates and lookups go through a map of names (#178).
// The count does not limit source bytes; TextTemplate owns compile/output limits.
// Example: TemplateLibrary(NamedTemplate("greeting",TextTemplate("Hello")));
// Partial expansion is a separate contract: this module only names templates.
// Run: okkama run -t std/template/library.ok
object TemplateLibrary {
    has origin is @NamedTemplate;

    // No templates.
    TemplateLibrary() {
        origin = [];
    }

    // The templates, at most 1024; DuplicateTemplate for a repeated name.
    TemplateLibrary(values is Sequencing<NamedTemplate>) {
        origin = TemplateLibrarySnapshot(source: values, maximum: 1024).items();
    }

    // The same, one argument per part: TemplateLibrary(a, b).
    TemplateLibrary(values is ...NamedTemplate) {
        let listed is @NamedTemplate = values...;
        origin = TemplateLibrarySnapshot(source: listed, maximum: 1024).items();
    }

    // Templates by name: TemplateLibrary(["item": TextTemplate("- {{title}}")]).
    TemplateLibrary(templates is %string:TextTemplate) {
        let names = templates.keys();
        let values = templates.values();
        let listed is @NamedTemplate = (0..names.size()).map() -> index {
            NamedTemplate(name: names[index], value: values[index]);
        };
        origin = TemplateLibrarySnapshot(source: listed, maximum: 1024).items();
    }

    // The templates, at most maximum_templates.
    TemplateLibrary(values is Sequencing<NamedTemplate>, maximum_templates is int) {
        origin = TemplateLibrarySnapshot(source: values, maximum: maximum_templates).items();
    }

    // Whether a template has the name.
    membership(name is string) is bool {
        self.positions().has(name);
    }

    // The template of the name; MissingTemplate when none.
    template(name is string) is TextTemplate {
        let position = self.positions()[name] else -1;
        confirm position >= 0 else throw MissingTemplate.name(name);
        origin[position].template();
    }

    // Where each name is, for lookups by name (#178).
    hidden positions() is %string:int {
        once let positions = TemplateLibraryIndex(origin.map() -> item {
            item.name();
        }).positions();
        positions;
    }

    // Every name, in order.
    names() is Sequencing<string> {
        let names is @string = origin.map() -> item {
            item.name();
        };
        names;
    }
}

// Internal snapshot collaborator; public only because Okkama has no
// module-private declarations. No source observation after construction.
hidden object TemplateLibrarySnapshot {
    has origin is @NamedTemplate;

    TemplateLibrarySnapshot(source is Sequencing<NamedTemplate>, maximum is int) {
        confirm maximum >= 0 else throw InvalidTemplateLibraryLimit.invalid;
        let size = source.size();
        confirm size >= 0 else throw InvalidTemplateLibrarySize.invalid;
        confirm size <= maximum else throw TemplateLibraryLimitExceeded.exceeded;
        let snapshot is @NamedTemplate = (0..size).map() -> index {
            source.item(index);
        };
        let seen is %string:bool = [:];
        snapshot.reduce(seen) -> names, item {
            confirm !names.has(item.name()) else throw DuplicateTemplate.name(item.name());
            names + [item.name(): true];
        };
        origin = snapshot;
    }

    items() is @NamedTemplate {
        origin;
    }
}

// Where each name is in a library.
hidden object TemplateLibraryIndex {
    has names is @string;

    TemplateLibraryIndex(names is @string) {
        self.names = names;
    }

    positions() is %string:int {
        let none_here is %string:int = [:];
        (0..names.size()).reduce(none_here) -> index, position {
            index + [names[position]: position];
        };
    }
}

// Lookup/declaration errors preserve exact names for programmatic diagnostics.
enum MissingTemplate is Error = (name(name is string));

// Two templates with one name.
enum DuplicateTemplate is Error = (name(name is string));

// An empty name.
enum InvalidTemplateName is Error = (invalid);

// A negative limit.
enum InvalidTemplateLibraryLimit is Error = (invalid);

// A negative size.
enum InvalidTemplateLibrarySize is Error = (invalid);

// More templates than the limit.
enum TemplateLibraryLimitExceeded is Error = (exceeded);

// Imported constructors currently fail lookup in root test bodies; successful
// nonempty library/rendering and source-failure cases run in consumer suite 285.
test "empty and missing templates have explicit behavior" {
    test.is(TemplateLibrary().names().size(), 0);
    test.is(TemplateLibrary(values: [], maximum_templates: 0).membership(""), false);
    test.is(
        try {
            TemplateLibrary().template("x");
            "bad";
        }
        catch MissingTemplate.name(name) {
            name;
        },
        "x"
    );
}

test "empty library permits zero and rejects negative bounds" {
    test.is(TemplateLibrary().names().size(), 0);
    test.is(TemplateLibrary(values: [], maximum_templates: 0).names().size(), 0);
    test.ok(try {
        TemplateLibrary(values: [], maximum_templates: -1);
        false;
    }
    catch e is InvalidTemplateLibraryLimit {
        true;
    });
}

test "a library reads a map of templates by name" {
    let library = TemplateLibrary(
        ["item": TextTemplate("- {{title}}"), "head": TextTemplate("Order")]
    );
    test.ok(library.membership("item"));
    test.is(library.template("head").source(), "Order");
    test.ok(!library.membership("tail"));
}

test "a repeated name is refused, and names are found by a map (#178)" {
    test.is(
        try {
            TemplateLibrary(
                NamedTemplate(name: "a", value: TextTemplate("1")),
                NamedTemplate(name: "a", value: TextTemplate("2"))
            );
            "";
        }
        catch DuplicateTemplate.name(name) {
            name;
        },
        "a"
    );
    let many is @NamedTemplate = (0..500).map() -> index {
        NamedTemplate(name: "t" + index.string(), value: TextTemplate(index.string()));
    };
    let library = TemplateLibrary(many);
    test.is(library.template("t499").source(), "499");
    test.ok(library.membership("t0") && !library.membership("t500"));
}

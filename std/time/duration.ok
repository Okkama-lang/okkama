module time/duration v1.0.0;

import "compare" take Comparing, Order;
import "operators" take Adding, Subtracting, Negating;
import "strings/parse" take Number;

// Exact immutable durations with nanosecond resolution.
//
// ```okkama,run
// import "io/stdout" take Stdout;
// let delay = Duration(seconds: rat(3, 2));
// let timeout = Duration(seconds: (5 * 60).rat());
// Stdout().writeln(delay.nanoseconds().string());
// Stdout().writeln(DurationString(origin: delay).string());
// Stdout().writeln(DurationString(origin: timeout + delay).string());
// ```
// ```output
// 1500000000
// 3/2s
// 603/2s
// ```
//
// A Duration has one constructor, `Duration(seconds is rat)`: the exact
// length in seconds. Other units are arithmetic at the call site, and the
// value is never rounded:
//
//     Duration(seconds: 30.rat());              // 30 seconds
//     Duration(seconds: (5 * 60).rat());        // 5 minutes
//     Duration(seconds: (2 * 3600).rat());      // 2 hours
//     Duration(seconds: (7 * 86400).rat());     // 7 days of 86,400 seconds
//     Duration(seconds: rat(250, 1000));        // 250 milliseconds
//     Duration(seconds: rat(1, 1000000000));    // 1 nanosecond
//
// The seconds must come to a whole number of nanoseconds; `rat(1, 3)` or
// anything finer than a nanosecond is InvalidDuration, and so is scaling
// that leaves the nanosecond grid. A day here is exactly 86,400 seconds, not
// a civil-calendar day. Negative and zero durations are valid.
//
// DurationString is a lossless canonical `<rat>s` representation. Primitive
// numbers deliberately have no `.duration()` or unit conversion methods: a
// stdlib type is always introduced through its explicit constructor.

// An exact length of time, nanosecond resolution: `Duration(seconds: 30.rat())`.
object Duration does Comparing<Duration>, Adding<Duration, Duration>,
    Subtracting<Duration, Duration>, Negating<Duration> {
    has origin is rat;

    // Exactly `seconds` long; InvalidDuration unless that is a whole number of
    // nanoseconds: `Duration(seconds: rat(250, 1000))`.
    Duration(seconds is rat) {
        confirm (seconds * 1000000000.rat()).denominator() == 1
            else throw InvalidDuration.because(
                "duration must contain an integral number of nanoseconds"
            );
        origin = seconds;
    }

    // The exact length in seconds.
    cap Span {
        seconds is rat {
            origin;
        }
    }

    // The length in nanoseconds.
    nanoseconds() is int {
        (origin * 1000000000.rat()).numerator();
    }

    // The sum.
    plus(other is Duration) is Duration {
        Duration(seconds: origin + other::Span::seconds);
    }

    // The difference.
    minus(other is Duration) is Duration {
        Duration(seconds: origin - other::Span::seconds);
    }

    // -a
    negated() is Duration {
        Duration(seconds: -origin);
    }

    // This duration scaled by `factor`; InvalidDuration when the result is not
    // a whole number of nanoseconds.
    times(factor is rat) is Duration {
        Duration(seconds: origin * factor);
    }

    // Shorter durations come first.
    order(other is Duration) is Order {
        origin.order(other::Span::seconds);
    }
}

// A duration as exact text in seconds: "3/2s".
object DurationString {
    has origin is Duration;

    // The text of origin.
    DurationString(origin is Duration) {
        self.origin = origin;
    }

    // The seconds as an exact rat, then `s`.
    string() is string {
        origin::Span::seconds.string() + "s";
    }
}

// A duration that is not whole nanoseconds.
enum InvalidDuration is Error = (because(message is string));

test "seconds are exact: whole, fractional and one nanosecond" {
    let whole = Duration(seconds: 30.rat());
    test.is(whole::Span::seconds, 30.rat());
    test.is(whole.nanoseconds(), 30000000000);
    let quarter = Duration(seconds: rat(1, 4));
    test.is(quarter::Span::seconds, rat(1, 4));
    test.is(quarter.nanoseconds(), 250000000);
    let one = Duration(seconds: rat(1, 1000000000));
    test.is(one.nanoseconds(), 1);
    test.is(one::Span::seconds.string(), "1/1000000000");
    test.is(Duration(seconds: rat(250, 1000)) == quarter, true);
    test.is(Duration(seconds: (5 * 60).rat())::Span::seconds, 300.rat());
    test.is(Duration(seconds: (1 * 86400).rat()).nanoseconds(), 86400000000000);
}

test "negative and zero durations" {
    let zero = Duration(seconds: 0.rat());
    test.is(zero.nanoseconds(), 0);
    test.is(zero == Duration(seconds: rat(0, 1000)), true);
    let back = Duration(seconds: -3.rat());
    test.is(back::Span::seconds, -3.rat());
    test.is(back.nanoseconds(), -3000000000);
    test.is(Duration(seconds: rat(-1, 1000000000)).nanoseconds(), -1);
    test.is(back.negated() == Duration(seconds: 3.rat()), true);
    test.is(zero.negated() == zero, true);
}

test "arithmetic and order" {
    let second = Duration(seconds: 1.rat());
    let half = Duration(seconds: rat(1, 2));
    test.is(second.plus(half)::Span::seconds, rat(3, 2));
    test.is((second + half)::Span::seconds, rat(3, 2));
    test.is(half.minus(second)::Span::seconds, rat(-1, 2));
    test.is((half - second).nanoseconds(), -500000000);
    test.is((-half)::Span::seconds, rat(-1, 2));
    test.is(second.order(half), Order.greater);
    test.is(half.order(second), Order.less);
    test.is(half.order(Duration(seconds: rat(500, 1000))), Order.equal);
    test.is(half < second, true);
    test.is(Duration(seconds: -1.rat()) < Duration(seconds: 0.rat()), true);
}

test "durations scale exactly" {
    let minute = Duration(seconds: 60.rat());
    test.is(minute.times(rat(3, 2))::Span::seconds.string(), "90");
    test.is(minute.times(0.rat())::Span::seconds.string(), "0");
    test.is(minute.times(-2.rat())::Span::seconds.string(), "-120");
    test.is(Duration(seconds: rat(1, 1000000000)).times(3.rat()).nanoseconds(), 3);
}

test "DurationString round trip" {
    for [rat(3, 2), rat(1, 1000000000), -7.rat(), 0.rat(), rat(-1, 4), 86400.rat()] -> seconds {
        let text = DurationString(origin: Duration(seconds: seconds)).string();
        test.is(text.ends_with("s"), true);
        let back = Duration(seconds: Number(text.slice(0, text.length() - 1)).rat());
        test.is(back == Duration(seconds: seconds), true);
        test.is(DurationString(origin: back).string(), text);
    }
    test.is(DurationString(origin: Duration(seconds: rat(3, 2))).string(), "3/2s");
    test.is(DurationString(origin: Duration(seconds: -3.rat())).string(), "-3s");
}

test "511 duration nanoseconds preserve large signed ints" {
    for [0, 1, -1, 123456789012345678901234567890, -123456789012345678901234567890] -> n {
        let ns is int = Duration(seconds: rat(n, 1000000000)).nanoseconds();
        test.is(ns, n);
    }
}

test "finer than a nanosecond is InvalidDuration, without rounding" {
    for [
        rat(1, 3),
        rat(1, 2000000000),
        rat(-1, 3000000000),
        rat(1000000001, 10000000000)
    ] -> seconds {
        test.ok(try {
            Duration(seconds: seconds);
            false;
        }
        catch error is InvalidDuration {
            true;
        });
    }
    test.ok(try {
        Duration(seconds: rat(1, 1000000000)).times(rat(1, 2));
        false;
    }
    catch error is InvalidDuration {
        true;
    });
}

module time/rfc3339 v1.0.0;

import "time/duration" take Duration;
import "time/clock" take Instant;
import "time/date" take Date, InvalidDate;
import "time/day" take TimeOfDay;
import "time/local_datetime" take LocalDateTime;
import "time/iso" take IsoText, InvalidIsoLocalDateTime;
import "strings/parse" take Number, InvalidInteger;
import "runtime/time_zone" take rfc3339_text;

// Strict nanosecond-resolution RFC 3339 timestamps.
//
//     Rfc3339(
//         origin: clock.instant(),
//         offset: Duration(seconds: 0.rat()),
//     ).string(); // ...Z
//
//     let instant = Rfc3339("2026-08-11T12:30:45.125+05:00").instant();
//
// This profile requires uppercase T/Z, seconds and either Z or ±HH:MM.
// Fractions contain one through nine digits and are never rounded. Numeric
// offsets must be whole minutes and have magnitude below 24 hours. Parsing
// accepts RFC 3339 `-00:00` as a zero displacement with unknown local-offset
// provenance; formatting canonicalizes every zero displacement to `Z`.

// An instant as RFC 3339 text at an offset: `2026-11-13T10:00:00Z`.
object Rfc3339 {
    has origin is Instant;
    has offset is Duration;
    has source is string;
    has reading is bool;

    // origin at offset from UTC, a whole number of minutes below 24 hours.
    Rfc3339(origin is Instant, offset is Duration) {
        confirm offset::Span::seconds.denominator() == 1
            else throw InvalidRfc3339Offset.because("RFC 3339 offset must contain whole seconds");
        let seconds is int = offset::Span::seconds.int();
        confirm seconds % 60 == 0
            else throw InvalidRfc3339Offset.because("RFC 3339 offset must contain whole minutes");
        confirm seconds > -86400 && seconds < 86400
            else throw InvalidRfc3339Offset.because(
                "RFC 3339 offset magnitude must be below 24 hours"
            );
        self.origin = origin;
        self.offset = offset;
        source = "";
        reading = false;
    }

    // Keeps a timestamp to read; instant() and string() read it.
    Rfc3339(text is string) {
        origin = Instant(origin: Duration(seconds: 0.rat()));
        offset = Duration(seconds: 0.rat());
        source = text;
        reading = true;
    }

    // The instant.
    instant() is Instant {
        if reading {
            self.parsed().instant();
        }
        else {
            origin;
        }
    }

    // The text, with nanoseconds when there are any.
    string() is string {
        if reading {
            return self.parsed().string();
        }
        // One native call writes it (#1180); the calendar below reports what it refuses.
        let written = rfc3339_text(origin.unix_duration()::Span::seconds, offset::Span::seconds);
        if written != "" {
            return written;
        }
        let epoch is LocalDateTime = LocalDateTime(
            date: Date(year: 1970, month: 1, day: 1),
            time: TimeOfDay(hour: 0, minute: 0, second: 0, nanosecond: 0),
        );
        let local is LocalDateTime = epoch
            .plus(origin.unix_duration())
            .plus(offset);
        let seconds is int = offset::Span::seconds.int();
        let suffix is string = if seconds == 0 {
            "Z";
        }
        else {
            let sign is string = if seconds < 0 {
                "-";
            }
            else {
                "+";
            };
            let magnitude is int = if seconds < 0 {
                -seconds;
            }
            else {
                seconds;
            };
            let hour is string = (magnitude / 3600).int().string();
            let minute is string = ((magnitude % 3600) / 60).int().string();
            sign +
                ("00" + hour).slice(hour.length(), hour.length() + 2) +
                ":" +
                ("00" + minute).slice(minute.length(), minute.length() + 2);
        };
        local.string() + suffix;
    }

    // The formatter of the timestamp read from the source.
    hidden parsed() is Rfc3339 {
        let length is int = source.length();
        confirm length >= 20 else throw InvalidRfc3339.origin(source);

        let utc is bool = source.slice(length - 1, length) == "Z";
        let numeric is bool = length >= 25
            && (source.slice(length - 6, length - 5) == "+"
            || source.slice(length - 6, length - 5) == "-")
            && source.slice(length - 3, length - 2) == ":";
        confirm utc || numeric else throw InvalidRfc3339.origin(source);

        let local_source is string = if utc {
            source.slice(0, length - 1);
        }
        else {
            source.slice(0, length - 6);
        };
        let local is LocalDateTime = try {
            IsoText(local_source).local_date_time();
        }
        catch error is InvalidIsoLocalDateTime {
            throw InvalidRfc3339.origin(source);
        };

        let offset is Duration = if utc {
            Duration(seconds: 0.rat());
        }
        else {
            try {
                let hour is int = Number(source.slice(length - 5, length - 3)).int();
                let minute is int = Number(source.slice(length - 2, length)).int();
                confirm hour <= 23 && minute <= 59
                    else throw InvalidRfc3339.origin(source);
                let sign is int = if source.slice(length - 6, length - 5) == "-" {
                    -1;
                }
                else {
                    1;
                };
                Duration(
                    seconds: (sign * (hour * 3600 + minute * 60)).rat(),
                );
            }
            catch error is InvalidInteger {
                throw InvalidRfc3339.origin(source);
            }
        };

        let epoch is LocalDateTime = LocalDateTime(
            date: Date(year: 1970, month: 1, day: 1),
            time: TimeOfDay(hour: 0, minute: 0, second: 0, nanosecond: 0),
        );
        Rfc3339(origin: Instant(origin: local.minus(epoch).minus(offset)), offset: offset);
    }
}

// Text that is not an RFC 3339 timestamp.
enum InvalidRfc3339 is Error = (origin(origin is string));

// An offset RFC 3339 cannot write.
enum InvalidRfc3339Offset is Error = (because(message is string));

test "RFC 3339 text reads an instant and keeps its offset" {
    let read = Rfc3339("2026-08-11T12:30:45.125+05:00");
    test.is(read.string(), "2026-08-11T12:30:45.125+05:00");
    let utc = Rfc3339(
        origin: read.instant(),
        offset: Duration(seconds: 0.rat())
    );
    test.is(utc.string(), "2026-08-11T07:30:45.125Z");
    test.is(Rfc3339("1970-01-01T00:00:00Z").instant().unix_duration()::Span::seconds.string(), "0");
    for ["2026-08-11t12:30:45Z", "2026-08-11T12:30:45", "2026-08-11T12:30:45+5:00"] -> bad {
        test.is(
            try {
                Rfc3339(bad).instant();
                "accepted";
            }
            catch InvalidRfc3339.origin(given) {
                given;
            },
            bad
        );
    }
}

test "RFC 3339 text is the calendar's local date and time with the offset" {
    let epoch = LocalDateTime(
        date: Date(year: 1970, month: 1, day: 1),
        time: TimeOfDay(hour: 0, minute: 0, second: 0, nanosecond: 0),
    );
    let instants is @rat = [
        0.rat(),
        1700000000.rat(),
        rat(1700000000123456789, 1000000000),
        rat(17000000005, 10),
        rat(-1000000001, 1000000000),
        rat(951782399999999999, 1000000000),
        rat(-2203891200000000001, 1000000000),
        (-62135596800).rat() + 86400.rat(),
        253402300799.rat() - 86400.rat(),
        rat(9223372036854775807, 1000000000),
        rat(9223372036854775808, 1000000000),
        rat(1, 1000000000),
        rat(-1, 1000000000)
    ];
    for instants -> seconds {
        for [0, 60, -60, 19800, -28800, 86340, -86340] -> shift {
            let offset = Duration(seconds: shift.rat());
            let suffix = if shift == 0 {
                "Z";
            }
            else {
                let sign = if shift < 0 {
                    "-";
                }
                else {
                    "+";
                };
                let magnitude = if shift < 0 {
                    -shift;
                }
                else {
                    shift;
                };
                let hour = (magnitude / 3600).int().string();
                let minute = ((magnitude % 3600) / 60).int().string();
                sign + ("00" + hour).slice(hour.length(), hour.length() + 2) + ":" +
                    ("00" + minute).slice(minute.length(), minute.length() + 2);
            };
            test.is(
                Rfc3339(origin: Instant(Duration(seconds: seconds)), offset: offset).string(),
                epoch.plus(Duration(seconds: seconds)).plus(offset).string() + suffix
            );
        }
    }
    let latest = Instant(Duration(seconds: 253402300799.rat()));
    test.is(
        Rfc3339(origin: latest, offset: Duration(seconds: 0.rat())).string(),
        "9999-12-31T23:59:59Z"
    );
    test.throws(InvalidDate) {
        Rfc3339(origin: latest, offset: Duration(seconds: 19800.rat())).string();
    };
    test.throws(InvalidDate) {
        Rfc3339(
            origin: Instant(Duration(seconds: (-62135596800).rat())),
            offset: Duration(seconds: (-60).rat())
        ).string();
    };
}

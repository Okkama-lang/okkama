module fs/file v1.0.0;

import "strings/parse" take Number;
import "fs/path" take Path;
import "fs/error" take FileError, FileFailure;
import "fs/lock" take FileLock, FileLockMode;
import "io/stream" take ByteSource, Reading, ReadingText, Closing, Writing, WritingText,
    IncompleteWrite, InvalidReadLimit;
import "io/stdin" take EndOfInput;
import "collections/iteration" take Batching;
import "encoding/utf" take Utf8Encoded, Utf16Encoded, Utf32Encoded, ByteOrder;
import "encoding/single_byte" take AsciiEncoded, Latin1Encoded, UnrepresentableAsciiCharacter,
    UnrepresentableLatin1Character;
import "runtime/fs" take FileState, file_state_open, file_state_lock, file_state_locked,
    path_encode, file_state_read_line, file_state_read_lines, file_state_read_text,
    file_state_closed, file_state_read, file_state_write, file_state_write_text,
    file_state_rewrite_text, file_state_flush, file_state_sync, file_state_close,
    file_state_position, file_state_seek, file_state_truncate, directory_entries, stat, chmod,
    symlink, readlink, path_decode;
import "fs/temp" take TemporaryDirectory, TemporaryFile;
import "fs/directory" take Directory;

// A file is a resource: File opens it lazily, owns the handle and closes it
// once (close() is idempotent; destroy closes too). It is read and written
// through one of two symmetric views, and the first view used picks the mode;
// the other view then throws FileError.invalid_operation.
//
// ```okkama
// let file = File(path: Path("notes.txt"));
// defer file.close();
// let content = file.text().content();
// ```
//
// This compile-only example reads an existing UTF-8 notes.txt when used in a
// program. File I/O is not allowed in runnable documentation examples.
//
//     let file = File(path: Path("notes.txt"));            // reading, UTF-8 text
//     defer file.close();
//     for file.text() -> line { … }                  // line by line, in batches
//     let lines is @string = file.text().lines();    // the remaining lines
//     let all = file.text().content();               // the remaining text
//
//     let log = File(path: Path("app.log"), mode: FileMode.appending);
//     log.text().writeln("started");
//     log.close();
//
//     let image = File(path: Path("image.png"));
//     for image.binary() -> b { … }                  // byte by byte, in batches
//     let header is @byte = image.binary().bytes(8); // up to 8 bytes; [] at the end
//     let rest is @byte = image.binary().bytes();    // the remaining bytes
//     image.binary().seek(0, SeekOrigin.start);
//
// | | text() | binary() |
// |---|---|---|
// | for … -> | lines | bytes |
// | next unit | line() | byte() |
// | the rest as an array | lines() | bytes() |
// | the whole as one value | content() | (bytes()) |
// | a piece | — | bytes(n) |
// | where | — | offset(), seek(…), truncate(…) |
// | write | write(…), writeln(…), rewrite(…) | write(source), <- |
// | replace the whole file at once | replace(…) | replace(bytes) |
// | make it durable | sync() | sync() |
//
// A whole file is one line each way, and the file closes when the File goes:
//
//     let notes = File(path: Path("notes.txt")).text().content();
//     let image is @byte = File(path: Path("image.png")).binary().bytes();
//     File(path: Path("notes.txt"), mode: FileMode.writing).text().write(notes);
//     File(path: Path("image.png"), mode: FileMode.writing).binary().write(image);
//
// Writing so empties the file first, so a reader or a crash in the middle sees
// a part. replace writes a temporary file beside it and renames it over the old
// one, so the file at the path is the whole old content or the whole new one:
//
//     File(path: Path("config.json")).text().replace(json);
//     File(path: Path("image.png")).binary().replace(image);
//
// replace is atomic and durable. Atomic: a reader, and a crash at any point,
// finds the old file or the new one, never a part; two replaces at once leave
// one of them whole. Durable: the new file is synchronized before the rename
// and its directory after it, so once replace returns the new content survives
// a crash or a power cut, as far as the system and the disk keep the promise of
// fsync (F_FULLFSYNC on macOS); a disk that lies about its cache can still lose
// it. Linux and macOS are supported; Windows is not.
//
// replace works on the path, whatever the File's mode, and neither opens nor
// moves its handle: a File already open still reads the old file. The new file
// keeps the permission bits of the file it replaces (owner, group, others;
// through a link, the target's); a file that did not exist is made owner-only.
// It is a new file: hard links to the old one keep the old content, and its
// owner is whoever runs the program. A symbolic link at the path is itself
// replaced by the file, and its target is left alone. A directory at the path
// is refused. Any failure before the rename leaves the old file as it was and
// removes the temporary one. When the rename is done but the directory could
// not be synchronized, the new content is in place and the failure is
// FileError.failed("not_durable", …).
//
// flush() hands written data to the operating system, which may still lose it
// in a crash; sync() makes it durable.
//
// content(), lines(), bytes() and replace hold the whole file in memory. For a
// file of unknown size read a bounded piece, bytes(limit), or walk it with for.
//
// A line loses its LF and one CR before it; a final unterminated line is a
// line. line() and byte() throw EndOfInput at the end. Text is strict UTF-8
// unless File names another canonical encoding: utf-16-le, utf-16-be,
// utf-32-le, utf-32-be, ascii, latin-1; no byte order is inferred and BOMs are
// kept as text. for walks a view batch by batch (Batching, #465): the runtime
// reads about 64 KiB and cuts it into lines or hands it out as bytes.
//
// lock(mode) takes a whole-file advisory lock without waiting: a lock in the
// way gives Maybe.none. locked(mode) tells whether the file is locked in mode
// now, by this process or another one (fs/lock).
//
//     let file = File(path: Path("counter.txt"), mode: FileMode.reading_and_writing);
//     defer file.close();
//     let lock = file.lock(FileLockMode.exclusive) else throw Busy.now;
//     let count = Number(file.text().content()).int();
//     file.text().rewrite((count + 1).string());
//
//     match guard.lock(FileLockMode.exclusive) {
//         case Maybe.some(lock) { serve(); }
//         case Maybe.none { Stdout().writeln("already running"); }
//     }

// How File opens its file: reading (the default), writing (emptied first),
// appending, or reading and writing or appending together.
//
// - `reading`: Opens an existing file for reading; writes are refused.
// - `writing`: Opens for writing, creating the file or truncating its contents.
// - `appending`: Opens for writing at the end, creating the file if absent.
// - `reading_and_writing`: Opens an existing file for reads and writes without truncation.
// - `reading_and_appending`: Reads and appends to the file, creating it if absent.
enum FileMode = (reading, writing, appending, reading_and_writing, reading_and_appending);

// A file on disk, opened on first use and closed once; read and written through
// text() or binary().
object File does Closing {
    has state is FileState;
    has location is string;
    has encoding is string;

    // A file at path, opened on first use; text is read and written as encoding
    // (UTF-8 unless told: `utf-16-le`, `utf-16-be`, `utf-32-le`, `utf-32-be`,
    // `ascii`, `latin-1`).
    File(path is Path, mode is FileMode = FileMode.reading, encoding is string = "utf-8") {
        state = FileOpening(mode: mode, path: path, encoding: encoding).state();
        location = path.string();
        self.encoding = encoding;
    }

    destroy {
        self.close();
    }

    // The text view; the first view used decides, and binary() then refuses.
    text() is FileText {
        FileText(owner: self, state: state, location: location, encoding: encoding);
    }

    // The byte view; the first view used decides, and text() then refuses.
    binary() is FileBytes {
        FileBytes(owner: self, state: state, location: location);
    }

    // A lock on the whole file, or none when another lock is in the way.
    lock(mode is FileLockMode) is Maybe<FileLock> {
        try {
            Maybe.some(
                FileLock(state: file_state_lock(state, NativeLockMode(mode).code(), 1), owner: self)
            );
        }
        catch failure is NativeFailure {
            if failure.code() == "would_block" {
                Maybe.none;
            }
            else {
                throw FileFailure(failure: failure, path: location).error();
            }
        }
    }

    // Whether the file is locked in mode now, by this process or another one.
    locked(mode is FileLockMode) is bool {
        try {
            file_state_locked(state, NativeLockMode(mode).code());
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Whether the file is closed.
    closed() is bool {
        file_state_closed(state);
    }

    // Closes the file; closing again does nothing.
    close() is void {
        try {
            file_state_close(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }
}

// The text view: a file as lines, read in batches, or as one string.
object FileText does ReadingText, WritingText, Batching<string> {
    has owner is File;
    has state is FileState;
    has location is string;
    has encoding is string;

    // Made by File.text(); not constructed directly.
    FileText(owner is File, state is FileState, location is string, encoding is string) {
        self.owner = owner;
        self.state = state;
        self.location = location;
        self.encoding = encoding;
    }

    // The next line without its LF and one CR before it; EndOfInput at the end.
    line() is string {
        try {
            file_state_read_line(state);
        }
        catch failure is NativeFailure {
            if failure.code() == "end_of_input" {
                throw EndOfInput.reached;
            }
            else {
                throw FileFailure(failure: failure, path: location).error();
            }
        }
    }

    // The remaining lines.
    lines() is @string {
        self.map() -> line {
            line;
        };
    }

    // The remaining text, unchanged.
    content() is string {
        try {
            file_state_read_text(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // The next batch of whole lines; [] at the end.
    batch() is @string {
        try {
            file_state_read_lines(state, 65536);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Writes the strings in the file's encoding, one after another.
    write(values is ...string) is void {
        let text is @string = values...;
        try {
            file_state_write_text(state, text, false);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Writes the strings and then one LF.
    writeln(values is ...string) is void {
        let text is @string = values...;
        try {
            file_state_write_text(state, text, true);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Empties the file and writes values from its start.
    rewrite(values is ...string) is void {
        let text is @string = values...;
        try {
            file_state_rewrite_text(state, text);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Replaces the whole file, in one step, with the strings in the file's
    // encoding; a reader sees the old file or the new one, never a part.
    replace(values is ...string) is void {
        let text is @string = values...;
        FileReplacement(
            path: Path(location),
            content: EncodedFileText(text: text.join(""), encoding: encoding, location: location)
                .bytes(),
        ).replace();
    }

    // Hands written text to the operating system; sync() makes it durable.
    flush() is void {
        try {
            file_state_flush(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Makes written text durable: it survives a crash once sync returns.
    sync() is void {
        try {
            file_state_sync(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }
}

// The byte view: a file as bytes, read in batches, in pieces or whole, at a
// byte offset.
object FileBytes does Reading, Writing, ByteSource, Batching<byte> {
    has owner is File;
    has state is FileState;
    has location is string;

    // Made by File.binary(); not constructed directly.
    FileBytes(owner is File, state is FileState, location is string) {
        self.owner = owner;
        self.state = state;
        self.location = location;
    }

    // The next byte; EndOfInput at the end.
    byte() is byte {
        let one = self.bytes(1);
        confirm one.size() == 1 else throw EndOfInput.reached;
        one[0];
    }

    // Up to limit bytes; [] at the end.
    bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        try {
            file_state_read(state, limit);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // The remaining bytes.
    bytes() is @byte {
        self.map() -> b {
            b;
        };
    }

    // The next batch of bytes; [] at the end.
    batch() is @byte {
        self.bytes(65536);
    }

    // Writes the bytes of source.
    write(source is ByteSource) is void {
        self.write(source.bytes());
    }

    // Writes the bytes.
    write(bytes is @byte) is void {
        try {
            let written is int = file_state_write(state, bytes);
            confirm written == bytes.size() else throw IncompleteWrite.after(written);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Replaces the whole file with bytes in one step; a reader sees the old
    // file or the new one, never a part.
    replace(bytes is @byte) is void {
        FileReplacement(path: Path(location), content: bytes).replace();
    }

    // Hands written bytes to the operating system; sync() makes them durable.
    flush() is void {
        try {
            file_state_flush(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Makes written bytes durable: they survive a crash once sync returns.
    sync() is void {
        try {
            file_state_sync(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // The byte offset of the next read or write.
    offset() is int {
        try {
            file_state_position(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Moves the position to offset bytes from the start, the current position
    // or the end.
    seek(offset is int, from is SeekOrigin) is void {
        try {
            file_state_seek(state, offset, NativeSeekOrigin(from).code());
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }

    // Cuts or extends the file to size bytes.
    truncate(size is int) is void {
        try {
            file_state_truncate(state, size);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: location).error();
        }
    }
}

// Where a seek counts from.
//
// - `start`: Counts the byte offset from the beginning of the file.
// - `current`: Counts the byte offset from the current position.
// - `end`: Counts the byte offset from the end of the file.
enum SeekOrigin = (start, current, end);

hidden object FileOpening {
    has mode is FileMode;
    has path is Path;
    has encoding is string;

    FileOpening(mode is FileMode, path is Path, encoding is string) {
        self.mode = mode;
        self.path = path;
        self.encoding = encoding;
    }

    state() is FileState {
        confirm FileEncoding(encoding).supported()
            else throw FileError.unsupported_encoding(encoding);
        try {
            file_state_open(path_encode(path.string()), NativeFileMode(mode).code(), encoding);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: path.string()).error();
        }
    }
}

// The whole new content of the file at path, written to a temporary file in
// its directory and renamed over it (TemporaryFile.replace).
hidden object FileReplacement {
    has path is Path;
    has content is @byte;

    FileReplacement(path is Path, content is @byte) {
        self.path = path;
        self.content = content;
    }

    replace() is void {
        let temporary = TemporaryFile(
            directory: Directory(path: path.parent()),
            prefix: "." + path.name() + ".",
        );
        defer temporary.close();
        temporary.write(content);
        temporary.replace(path);
    }
}

// Text as the bytes of a file's encoding; a character it lacks is
// FileError.invalid_text, as when the file is written.
hidden object EncodedFileText {
    has text, encoding, location is string;

    EncodedFileText(text is string, encoding is string, location is string) {
        self.text = text;
        self.encoding = encoding;
        self.location = location;
    }

    bytes() is @byte {
        if encoding == "utf-8" {
            Utf8Encoded(text).bytes();
        }
        else if encoding == "utf-16-le" {
            Utf16Encoded(origin: text, order: ByteOrder.little).bytes();
        }
        else if encoding == "utf-16-be" {
            Utf16Encoded(origin: text, order: ByteOrder.big).bytes();
        }
        else if encoding == "utf-32-le" {
            Utf32Encoded(origin: text, order: ByteOrder.little).bytes();
        }
        else if encoding == "utf-32-be" {
            Utf32Encoded(origin: text, order: ByteOrder.big).bytes();
        }
        else if encoding == "ascii" {
            try {
                AsciiEncoded(text).bytes();
            }
            catch failure is UnrepresentableAsciiCharacter {
                throw FileError.invalid_text(location);
            }
        }
        else {
            try {
                Latin1Encoded(text).bytes();
            }
            catch failure is UnrepresentableLatin1Character {
                throw FileError.invalid_text(location);
            }
        }
    }
}

hidden object FileEncoding {
    has origin is string;

    FileEncoding(origin is string) {
        self.origin = origin;
    }

    supported() is bool {
        origin == "utf-8"
            || origin == "utf-16-le"
            || origin == "utf-16-be"
            || origin == "utf-32-le"
            || origin == "utf-32-be"
            || origin == "ascii"
            || origin == "latin-1";
    }
}

hidden object NativeFileMode {
    has origin is FileMode;

    NativeFileMode(origin is FileMode) {
        self.origin = origin;
    }

    code() is int {
        if origin == FileMode.reading {
            0;
        }
        else if origin == FileMode.writing {
            1;
        }
        else if origin == FileMode.appending {
            2;
        }
        else if origin == FileMode.reading_and_writing {
            3;
        }
        else {
            4;
        }
    }
}

hidden object NativeSeekOrigin {
    has origin is SeekOrigin;

    NativeSeekOrigin(origin is SeekOrigin) {
        self.origin = origin;
    }

    code() is int {
        if origin == SeekOrigin.start {
            0;
        }
        else if origin == SeekOrigin.current {
            1;
        }
        else {
            2;
        }
    }
}

hidden object NativeLockMode {
    has origin is FileLockMode;

    NativeLockMode(origin is FileLockMode) {
        self.origin = origin;
    }

    code() is int {
        if origin == FileLockMode.shared {
            0;
        }
        else {
            1;
        }
    }
}

test "text: write, append, read whole, by line, in batches and rewrite" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let path = scratch.path().child("notes.txt");
    let writer = File(path: path, mode: FileMode.writing);
    writer.text().writeln("first");
    writer.text().write("sec", "ond");
    writer.text().writeln();
    writer.close();
    let more = File(path: path, mode: FileMode.appending);
    more.text().writeln("");
    more.text().write("last");
    more.close();
    test.is(File(path: path).text().content(), "first\nsecond\n\nlast");
    test.is(File(path: path).text().lines(), ["first", "second", "", "last"]);
    let reader = File(path: path);
    test.is(reader.text().line(), "first");
    let seen is @string = reader.text().map() -> line {
        "<" + line + ">";
    };
    test.is(seen, ["<second>", "<>", "<last>"]);
    test.ok(try {
        reader.text().line();
        false;
    }
    catch end is EndOfInput {
        true;
    });
    reader.close();
    reader.close();
    test.ok(reader.closed());
    let counter = File(path: path, mode: FileMode.reading_and_writing);
    let old = counter.text().content();
    counter.text().rewrite(old.length().string());
    counter.close();
    test.is(File(path: path).text().content(), "18");
    scratch.close();
}

test "binary: bytes one by one, in pieces and whole, at an offset; the first view picks the mode" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let path = scratch.path().child("data.bin");
    let writer = File(path: path, mode: FileMode.writing);
    writer.binary() <- [byte(1), byte(2), byte(3), byte(4), byte(5)];
    writer.close();
    let all is @int = File(path: path).binary().map() -> b {
        b.int();
    };
    test.is(all, [1, 2, 3, 4, 5]);
    let reader = File(path: path);
    test.is(reader.binary().byte().int(), 1);
    test.is(reader.binary().bytes(2), [byte(2), byte(3)]);
    test.is(reader.binary().bytes(), [byte(4), byte(5)]);
    test.is(reader.binary().bytes(9), []);
    test.ok(try {
        reader.text().line();
        false;
    }
    catch FileError.invalid_operation(_) {
        true;
    });
    reader.close();
    let seeking = File(path: path, mode: FileMode.reading_and_writing);
    seeking.binary().seek(3, SeekOrigin.start);
    test.is(seeking.binary().bytes(9), [byte(4), byte(5)]);
    seeking.binary().truncate(2);
    test.is(seeking.binary().offset(), 5);
    seeking.close();
    test.is(File(path: path).binary().bytes(), [byte(1), byte(2)]);
    scratch.close();
}

test "errors name the path; locks are taken without waiting and reported by mode" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let missing = scratch.path().child("missing.txt");
    test.ok(try {
        File(path: missing).text().content();
        false;
    }
    catch FileError.not_found(path) {
        path == missing.string();
    });
    test.ok(try {
        File(path: missing, encoding: "klingon");
        false;
    }
    catch FileError.unsupported_encoding(name) {
        name == "klingon";
    });
    let path = scratch.path().child("locked.txt");
    File(path: path, mode: FileMode.writing).text().write("");
    let file = File(path: path, mode: FileMode.reading_and_writing);
    test.ok(!file.locked(FileLockMode.shared) && !file.locked(FileLockMode.exclusive));
    let lock = file.lock(FileLockMode.exclusive) else panic "a free file locks";
    test.ok(file.locked(FileLockMode.exclusive) && !file.locked(FileLockMode.shared));
    let other = File(path: path, mode: FileMode.reading_and_writing);
    test.ok(match other.lock(FileLockMode.shared) {
        case Maybe.none: true;
        case _: false;
    });
    lock.close();
    test.ok(!file.locked(FileLockMode.exclusive));
    let shared = other.lock(FileLockMode.shared) else panic "a released file locks";
    test.ok(other.locked(FileLockMode.shared));
    shared.close();
    other.close();
    file.close();
    scratch.close();
}

test "a whole file in one line each way: empty, text, bytes with zeros, large, invalid text" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let path = scratch.path().child("whole.txt");
    File(path: path, mode: FileMode.writing).text().write("");
    test.is(File(path: path).text().content(), "");
    test.is(File(path: path).binary().bytes(), []);
    File(path: path, mode: FileMode.writing).text().write("héllo\nworld");
    test.is(File(path: path).text().content(), "héllo\nworld");
    let zeros = [byte(0), byte(255), byte(0), byte(10), byte(0)];
    File(path: path, mode: FileMode.writing).binary().write(zeros);
    test.is(File(path: path).binary().bytes(), zeros);
    let large = "abcdefg\n".repeat(131072);
    File(path: path, mode: FileMode.writing).text().write(large);
    test.is(File(path: path).text().content(), large);
    test.is(File(path: path).binary().bytes().size(), 1048576);
    File(path: path, mode: FileMode.writing).binary().write([byte(104), byte(255), byte(105)]);
    test.ok(try {
        File(path: path).text().content();
        false;
    }
    catch FileError.invalid_text(failed) {
        failed == path.string();
    });
    scratch.close();
}

test "replace: an existing file and a new one, as text in the file's encoding or as bytes" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let path = scratch.path().child("config.txt");
    File(path: path, mode: FileMode.writing).text().write("old");
    File(path: path).text().replace("new ", "config");
    test.is(File(path: path).text().content(), "new config");
    let fresh = scratch.path().child("fresh.bin");
    File(path: fresh).binary().replace([byte(0), byte(1), byte(0)]);
    test.is(File(path: fresh).binary().bytes(), [byte(0), byte(1), byte(0)]);
    test.is(stat(path_encode(fresh.string()))["permissions"], 384);
    File(path: fresh).binary().replace([]);
    test.is(File(path: fresh).binary().bytes(), []);
    File(path: path).text().replace();
    test.is(File(path: path).text().content(), "");
    let large = "0123456789abcdef".repeat(65536);
    File(path: path).text().replace(large);
    test.is(File(path: path).text().content(), large);
    let wide = scratch.path().child("wide.txt");
    File(path: wide, encoding: "utf-16-le").text().replace("hé");
    test.is(File(path: wide).binary().bytes(), [byte(104), byte(0), byte(233), byte(0)]);
    test.is(File(path: wide, encoding: "utf-16-le").text().content(), "hé");
    File(path: wide, encoding: "utf-32-be").text().replace("h");
    test.is(File(path: wide).binary().bytes(), [byte(0), byte(0), byte(0), byte(104)]);
    File(path: wide, encoding: "latin-1").text().replace("é");
    test.is(File(path: wide).binary().bytes(), [byte(233)]);
    test.ok(try {
        File(path: wide, encoding: "ascii").text().replace("é");
        false;
    }
    catch FileError.invalid_text(failed) {
        failed == wide.string();
    });
    test.is(File(path: wide).binary().bytes(), [byte(233)]);
    test.is(
        directory_entries(path_encode(scratch.path().string())),
        ["config.txt", "fresh.bin", "wide.txt"]
    );
    scratch.close();
}

test "replace keeps permission bits, replaces a link itself, refuses a directory and names what failed" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let root = scratch.path();
    let path = root.child("secret.txt");
    File(path: path, mode: FileMode.writing).text().write("old");
    chmod(path_encode(path.string()), 416);
    File(path: path).text().replace("new");
    test.is(stat(path_encode(path.string()))["permissions"], 416);
    test.is(File(path: path).text().content(), "new");
    let target = root.child("target.txt");
    let link = root.child("link.txt");
    File(path: target, mode: FileMode.writing).text().write("target");
    symlink(path_encode(target.string()), path_encode(link.string()));
    test.is(path_decode(readlink(path_encode(link.string()))), target.string());
    File(path: link).text().replace("replaced");
    test.ok(try {
        readlink(path_encode(link.string()));
        false;
    }
    catch failure is NativeFailure {
        true;
    });
    test.is(File(path: link).text().content(), "replaced");
    test.is(File(path: target).text().content(), "target");
    let folder = root.child("folder");
    Directory(path: folder).create();
    test.ok(try {
        File(path: folder).text().replace("x");
        false;
    }
    catch FileError.invalid_operation(_) {
        true;
    });
    test.ok(Directory(path: folder).existence());
    let orphan = root.child("missing").child("file.txt");
    test.ok(try {
        File(path: orphan).binary().replace([byte(1)]);
        false;
    }
    catch FileError.not_found(failed) {
        failed == root.child("missing").string();
    });
    test.is(
        directory_entries(path_encode(root.string())),
        ["folder", "link.txt", "secret.txt", "target.txt"]
    );
    scratch.close();
}

test "a directory that refuses new files refuses replace and keeps the old file, unless run as root" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let locked = scratch.path().child("locked");
    Directory(path: locked).create();
    let path = locked.child("data.txt");
    File(path: path, mode: FileMode.writing).text().write("old");
    chmod(path_encode(locked.string()), 320);
    let refused = try {
        File(path: path).text().replace("new");
        false;
    }
    catch FileError.permission_denied(failed) {
        test.is(failed, locked.string());
        true;
    };
    chmod(path_encode(locked.string()), 448);
    let expected = if refused {
        "old";
    }
    else {
        "new";
    };
    test.is(File(path: path).text().content(), expected);
    test.is(directory_entries(path_encode(locked.string())), ["data.txt"]);
    scratch.close();
}

test "readers see a whole version: an open reader keeps the old file, a new reader gets the new one" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let path = scratch.path().child("lines.txt");
    File(path: path, mode: FileMode.writing).text().write("old 1\nold 2\nold 3\n");
    let reader = File(path: path);
    test.is(reader.text().line(), "old 1");
    File(path: path).text().replace("new 1\nnew 2\n");
    test.is(reader.text().lines(), ["old 2", "old 3"]);
    reader.close();
    test.is(File(path: path).text().lines(), ["new 1", "new 2"]);
    scratch.close();
}

test "sync makes written data durable; a file not open for writing or closed refuses it" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let path = scratch.path().child("log.txt");
    let writer = File(path: path, mode: FileMode.writing);
    writer.text().writeln("started");
    writer.text().flush();
    writer.text().sync();
    writer.close();
    test.is(File(path: path).text().content(), "started\n");
    let bytes = File(path: path, mode: FileMode.appending);
    bytes.binary().write([byte(0)]);
    bytes.binary().sync();
    bytes.close();
    test.is(File(path: path).binary().bytes().size(), 9);
    test.ok(try {
        File(path: path).text().sync();
        false;
    }
    catch FileError.invalid_operation(_) {
        true;
    });
    test.ok(try {
        writer.text().sync();
        false;
    }
    catch FileError.invalid_operation(_) {
        true;
    });
    scratch.close();
}

test "a directory that cannot be synchronized: the new content is in place and the failure says so, unless run as root" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-file-test-");
    let unreadable = scratch.path().child("unreadable");
    Directory(path: unreadable).create();
    let path = unreadable.child("data.txt");
    File(path: path, mode: FileMode.writing).text().write("old");
    chmod(path_encode(unreadable.string()), 192);
    try {
        File(path: path).text().replace("new");
    }
    catch FileError.failed(code, message) {
        test.is(code, "not_durable");
        test.ok(message.starts_with(path.string() + " is replaced"));
    }
    chmod(path_encode(unreadable.string()), 448);
    test.is(File(path: path).text().content(), "new");
    test.is(directory_entries(path_encode(unreadable.string())), ["data.txt"]);
    scratch.close();
}

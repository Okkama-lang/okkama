module fs/temp v1.0.0;

import "fs/directory" take Directory, DirectoryLocating;
import "fs/entry" take FileEntry;
import "fs/error" take FileError, FileFailure;
import "fs/path" take Path;
import "io/stream" take ByteSource, Reading, Writing, WritingText, Closing, IncompleteWrite,
    InvalidReadLimit;
import "encoding/utf" take Utf8Encoded;
import "os/environment" take Environment;
import "runtime/fs" take FileState, TemporaryDirectoryState, path_encode, path_decode,
    file_state_read, file_state_write, file_state_flush, file_state_sync, file_state_close,
    file_state_closed, temporary_file_create, temporary_file_path, temporary_file_preserve,
    temporary_file_replace, temporary_directory_create, temporary_directory_path,
    temporary_directory_closed, temporary_directory_close, symlink, stat, chmod, directory_sync,
    directory_entries, file_content;

// Temporary resources are created eagerly with unpredictable names inside an
// explicitly supplied directory. prefix is one filename component, not a path.
// Temporary files are binary read/write streams with owner-only permissions:
//
//     let temporary = TemporaryFile(directory: scratch, prefix: "upload-");
//     defer temporary.close();
//     temporary.write(payload);
//     temporary.flush();
//     let path is Path = temporary.path();
//
// close() is idempotent and deletes an unpreserved temporary file. Preserve a
// completed file under a deliberate destination before the deferred close:
//
//     let preservation = TemporaryFilePreservation(
//         origin: temporary,
//         destination: output,
//     );
//     preservation.preserve();
//     let result = preservation.destination();
//
// Preservation never replaces an existing destination. It keeps the operation
// atomic when both paths share a filesystem and copies in bounded chunks when
// crossing filesystems.
//
// replace(destination) is the other way to keep it: it takes the place of
// whatever is at destination in one step, and is never copied. Make the
// temporary file in the destination's directory, so both share a filesystem:
//
//     let temporary = TemporaryFile(directory: Directory(path: output.parent()), prefix: ".report-");
//     defer temporary.close();
//     temporary.write(payload);
//     temporary.replace(output);
//
// It is durable as well as atomic: the file is synchronized before the rename
// and the directory after it. A reader sees the old file or the new one, never
// a part. The new file keeps the permission bits of the file it replaces (owner,
// group and others; through a link, the target's); with nothing there it stays
// owner-only. It is a new file: hard links to the old one keep the old content,
// and its owner is whoever runs the program. A symbolic link at destination is
// itself replaced, and its target is left alone. When the rename was done but
// the directory could not be synchronized, the new content is in place and the
// failure is FileError.failed("not_durable", …).
//
// flush() only hands the bytes to the operating system, which may still lose
// them in a crash; sync() makes them durable, as far as the system and the disk
// keep that promise.
//
// TemporaryDirectory.close() recursively deletes its contents. Symbolic links
// are removed as leaves; their targets are never traversed or deleted.

// A file with an unpredictable name, readable and writable, removed on close
// unless preserved.
object TemporaryFile does Reading, Writing, WritingText, Closing {
    has state is FileState;

    // Makes the file now inside directory, its name starting with prefix (one
    // name, not a path), readable by the owner only.
    TemporaryFile(directory is DirectoryLocating, prefix is string) {
        state = try {
            temporary_file_create(
                path_encode(directory.path().string()),
                prefix,
            );
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: directory.path().string()).error();
        };
    }

    // At most limit bytes from the current position; [] at the end.
    bytes(limit is int) is @byte {
        confirm limit > 0 else throw InvalidReadLimit.limit(limit);
        try {
            file_state_read(state, limit);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    // Writes the bytes of source.
    write(source is ByteSource) is void {
        self.write(source.bytes());
    }

    // Writes the bytes.
    write(bytes is @byte) is void {
        let written is int = try {
            file_state_write(state, bytes);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        };
        confirm written == bytes.size() else throw IncompleteWrite.after(written);
    }

    // Text, as UTF-8.
    write(values is ...string) is void {
        let text is @string = values...;
        self.write(Utf8Encoded(text.join("")));
    }

    // Writes the strings as UTF-8 and then one LF.
    writeln(values is ...string) is void {
        let text is @string = values...;
        self.write(Utf8Encoded(text.join("") + "\n"));
    }

    // Hands written bytes to the operating system; sync() makes them durable.
    flush() is void {
        try {
            file_state_flush(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    // Makes written bytes durable: they survive a crash once sync returns, as
    // far as the system and the disk keep that promise (fsync; F_FULLFSYNC on
    // macOS).
    sync() is void {
        try {
            file_state_sync(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    destroy {
        self.close();
    }

    // Whether it is closed.
    closed() is bool {
        try {
            file_state_closed(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    // Closes the file and removes it unless it was preserved.
    close() is void {
        try {
            file_state_close(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    // Where it is.
    path() is Path {
        try {
            Path(path_decode(temporary_file_path(state)));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    // Its size in bytes on disk now.
    size() is int {
        FileEntry(path: self.path()).stat()::Shape::size;
    }

    // Keeps the file at destination: renamed when possible, copied across file
    // systems; an existing destination is refused.
    preserve(destination is Path) is void {
        try {
            temporary_file_preserve(state, path_encode(destination.string()));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: destination.string()).error();
        }
    }

    // Puts the file at destination in one step, replacing what is there, and
    // makes it durable: synchronized, renamed over destination (never copied),
    // then its directory synchronized. It keeps the permission bits of the file
    // it replaces. A failure before the rename leaves destination as it was.
    replace(destination is Path) is void {
        let target = destination.string();
        try {
            chmod(temporary_file_path(state), stat(path_encode(target))["permissions"]);
        }
        catch failure is NativeFailure {
            if failure.code() != "not_found" {
                throw FileFailure(failure: failure, path: target).error();
            }
        }
        try {
            file_state_sync(state);
            temporary_file_replace(state, path_encode(target));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: target).error();
        }
        try {
            directory_sync(path_encode(destination.parent().string()));
        }
        catch failure is NativeFailure {
            throw FileError.failed(
                "not_durable",
                target + " is replaced, but its directory was not synchronized: " + failure.message(),
            );
        }
    }
}

// A temporary file kept under a chosen name before it is closed.
object TemporaryFilePreservation {
    has owner is TemporaryFile;
    has destination is Path;

    // Plans to keep origin at destination.
    TemporaryFilePreservation(origin is TemporaryFile, destination is Path) {
        owner = origin;
        self.destination = destination;
    }

    // The kept file.
    destination() is FileEntry {
        FileEntry(path: destination);
    }

    // Keeps it; an existing destination is never replaced.
    preserve() is void {
        owner.preserve(destination);
    }
}

// A directory with an unpredictable name, removed with everything in it on
// close.
object TemporaryDirectory does DirectoryLocating, Closing {
    has state is TemporaryDirectoryState;

    // In the system's directory for temporary files unless a parent is given:
    // TemporaryDirectory(prefix: "build-").
    TemporaryDirectory(
        parent is DirectoryLocating = Environment().temporary(),
        prefix is string = "okkama-"
    ) {
        state = try {
            temporary_directory_create(
                path_encode(parent.path().string()),
                prefix,
            );
        }
        catch failure is NativeFailure {
            throw FileFailure(failure: failure, path: parent.path().string()).error();
        };
    }

    // A temporary file inside it: scratch.file(prefix: "upload-").
    file(prefix is string = "okkama-") is TemporaryFile {
        TemporaryFile(directory: self, prefix: prefix);
    }

    // Where it is.
    path() is Path {
        try {
            Path(path_decode(temporary_directory_path(state)));
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    destroy {
        self.close();
    }

    // Whether it is closed.
    closed() is bool {
        try {
            temporary_directory_closed(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }

    // Removes the directory and everything in it; links are removed, never
    // followed.
    close() is void {
        try {
            temporary_directory_close(state);
        }
        catch failure is NativeFailure {
            throw FileFailure(failure).error();
        }
    }
}

test "a temporary file is written, named under its directory and gone after close" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let temporary = TemporaryFile(directory: scratch, prefix: "upload-");
    let path = temporary.path();
    test.is(path.parent(), scratch.path());
    test.ok(
        path.string().slice(scratch.path().string().length() + 1, path.string().length()).starts_with(
            "upload-"
        )
    );
    temporary.write([byte(1), byte(2), byte(3)]);
    temporary.flush();
    test.is(FileEntry(path: path).stat()::Shape::size, 3);
    test.ok(!temporary.closed());
    temporary.close();
    temporary.close();
    test.ok(temporary.closed());
    test.ok(!FileEntry(path: path).existence());
    let other = TemporaryFile(directory: scratch, prefix: "upload-");
    test.ok(other.path() != path);
    other.close();
    scratch.close();
}

test "a preserved file stays under its destination and never replaces one" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let output = scratch.path().child("report.bin");
    let temporary = TemporaryFile(directory: scratch, prefix: "report-");
    temporary.write([byte(7), byte(8)]);
    temporary.flush();
    let preservation = TemporaryFilePreservation(origin: temporary, destination: output);
    preservation.preserve();
    temporary.close();
    test.is(preservation.destination().path(), output);
    test.ok(preservation.destination().existence());
    test.is(FileEntry(path: output).stat()::Shape::size, 2);
    let second = TemporaryFile(directory: scratch, prefix: "report-");
    test.ok(try {
        second.preserve(output);
        false;
    }
    catch FileError.already_exists(failed) {
        failed == output.string();
    });
    second.close();
    test.is(FileEntry(path: output).stat()::Shape::size, 2);
    scratch.close();
}

test "a temporary directory removes its whole tree on close, links as leaves" {
    let outside = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let kept = outside.path().child("kept");
    Directory(path: kept).create();
    let scratch = TemporaryDirectory(parent: Directory(path: outside.path()), prefix: "tree-");
    let root = scratch.path();
    test.is(root.parent(), outside.path());
    Directory(path: root.child("a")).create();
    Directory(path: root.child("a").child("b")).create();
    let file = TemporaryFile(directory: Directory(path: root.child("a").child("b")), prefix: "f-");
    file.preserve(root.child("a").child("b").child("data"));
    file.close();
    symlink(path_encode(kept.string()), path_encode(root.child("link").string()));
    test.ok(!scratch.closed());
    scratch.close();
    scratch.close();
    test.ok(scratch.closed());
    test.ok(!Directory(path: root).existence());
    test.ok(Directory(path: kept).existence());
    test.ok(try {
        TemporaryFile(directory: Directory(path: root), prefix: "late-");
        false;
    }
    catch FileError.not_found(failed) {
        failed == root.string();
    });
    outside.close();
}

test "a scratch directory is a place to make scratch files in" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "temp-nest-");
    let inner = TemporaryDirectory(parent: scratch, prefix: "inner-");
    test.is(inner.path().parent() == scratch.path(), true);
    inner.close();
    scratch.close();
}

test "a temporary directory makes its own files and takes text" {
    let scratch = TemporaryDirectory(prefix: "fs-temp-text-");
    test.ok(scratch.path().name().starts_with("fs-temp-text-"));
    let notes = scratch.file(prefix: "notes-");
    test.is(notes.path().parent(), scratch.path());
    notes.write("héllo", " ");
    notes.writeln("world");
    notes.write([byte(33)]);
    notes.flush();
    test.is(notes.size(), 14);
    notes.close();
    scratch.close();
}

test "a replacing file takes the destination's place in one step and keeps its permission bits" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let output = scratch.path().child("report.bin");
    let old = TemporaryFile(directory: scratch, prefix: ".report-");
    old.write([byte(1), byte(2), byte(3)]);
    old.preserve(output);
    old.close();
    chmod(path_encode(output.string()), 416);
    let temporary = TemporaryFile(directory: scratch, prefix: ".report-");
    temporary.write([byte(7), byte(0), byte(8)]);
    temporary.sync();
    test.is(file_content(path_encode(output.string())), [byte(1), byte(2), byte(3)]);
    temporary.replace(output);
    test.ok(temporary.closed());
    test.is(temporary.path(), output);
    temporary.close();
    temporary.close();
    test.is(file_content(path_encode(output.string())), [byte(7), byte(0), byte(8)]);
    test.is(stat(path_encode(output.string()))["permissions"], 416);
    test.is(directory_entries(path_encode(scratch.path().string())), ["report.bin"]);
    let fresh = scratch.path().child("fresh.bin");
    let created = TemporaryFile(directory: scratch, prefix: ".fresh-");
    created.replace(fresh);
    created.close();
    test.is(file_content(path_encode(fresh.string())), []);
    test.is(stat(path_encode(fresh.string()))["permissions"], 384);
    test.is(directory_entries(path_encode(scratch.path().string())), ["fresh.bin", "report.bin"]);
    scratch.close();
}

test "replacements one after another: the last rename wins and no temporary file is left" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let output = scratch.path().child("state");
    let first = TemporaryFile(directory: scratch, prefix: ".state-");
    let second = TemporaryFile(directory: scratch, prefix: ".state-");
    first.write("first");
    second.write("second");
    second.replace(output);
    test.is(file_content(path_encode(output.string())), Utf8Encoded("second").bytes());
    first.replace(output);
    test.is(file_content(path_encode(output.string())), Utf8Encoded("first").bytes());
    first.close();
    second.close();
    test.is(directory_entries(path_encode(scratch.path().string())), ["state"]);
    scratch.close();
}

test "a failed replace leaves the destination alone and close removes the temporary file" {
    let scratch = TemporaryDirectory(parent: Directory(path: Path(".")), prefix: "fs-temp-test-");
    let folder = scratch.path().child("folder");
    Directory(path: folder).create();
    let kept = TemporaryFile(directory: Directory(path: folder), prefix: "kept-");
    kept.preserve(folder.child("kept"));
    kept.close();
    let temporary = TemporaryFile(directory: scratch, prefix: ".folder-");
    temporary.write([byte(1)]);
    test.ok(try {
        temporary.replace(folder);
        false;
    }
    catch FileError.invalid_operation(_) {
        true;
    });
    test.is(directory_entries(path_encode(folder.string())), ["kept"]);
    temporary.close();
    test.is(directory_entries(path_encode(scratch.path().string())), ["folder"]);
    test.ok(try {
        temporary.replace(scratch.path().child("late"));
        false;
    }
    catch FileError.invalid_operation(_) {
        true;
    });
    test.ok(!FileEntry(path: scratch.path().child("late")).existence());
    let missing = scratch.path().child("missing").child("file");
    let stray = TemporaryFile(directory: scratch, prefix: ".stray-");
    test.ok(try {
        stray.replace(missing);
        false;
    }
    catch FileError.not_found(failed) {
        failed == missing.string();
    });
    stray.close();
    test.is(directory_entries(path_encode(scratch.path().string())), ["folder"]);
    scratch.close();
}

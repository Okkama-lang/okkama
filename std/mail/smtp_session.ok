// Lines and DATA from a client, for the test server.
hidden object SmtpTestInput {
    has input is AsyncReading;
    has buffer is Atomic<@byte>;

    SmtpTestInput(input is AsyncReading) {
        self.input = input;
        let empty is @byte = [];
        buffer = Atomic(empty);
    }

    // Whether bytes wait past the last line.
    pending() is bool {
        buffer.value().size() > 0;
    }

    // The next text up to and without end, or "<eof>" when the client is gone.
    async upto(end is string) is string {
        let mark = Utf8Encoded(end).bytes();
        loop {
            let held = buffer.value();
            let found = SmtpTestFind(bytes: held, mark: mark).index();
            if found >= 0 {
                let text is @byte = (0..found).map() -> index {
                    held[index];
                };
                let rest is @byte = (found + mark.size()..held.size()).map() -> index {
                    held[index];
                };
                buffer.replace(rest);
                return test_utf.Utf8Decoded(text).string();
            }
            let chunk = try {
                await input.bytes(4096);
            }
            catch failure is Error {
                let empty is @byte = [];
                empty;
            };
            if chunk.size() == 0 {
                return "<eof>";
            }
            buffer.replace(held + chunk);
        }
    }
}

hidden object SmtpTestFind {
    has bytes, mark is @byte;

    SmtpTestFind(bytes is @byte, mark is @byte) {
        self.bytes = bytes;
        self.mark = mark;
    }

    index() is int {
        let final_start = bytes.size() - mark.size();
        if final_start < 0 {
            return -1;
        }
        for (0..final_start + 1) -> start {
            let same = (0..mark.size()).reduce(true) -> equal, offset {
                equal && bytes[start + offset] == mark[offset];
            };
            if same {
                return start;
            }
        }
        -1;
    }
}

// A scripted SMTP server for one connection. script maps each command line
// to its reply: "<close>" closes without a reply, "<hang>" never answers; a
// line it lacks gets 500. "<greeting>" is the greeting, "." the reply after the
// data, and "tls:" keys answer once TLS is up (STARTTLS answered with 220
// starts it; implicit starts with it). serve() gives back what it heard.
hidden object SmtpTestServer {
    has listener is test_tcp.TcpListener;
    has script is %string:string;
    has implicit is bool;
    has heard is Atomic<@string>;

    SmtpTestServer(listener is test_tcp.TcpListener, script is %string:string, implicit is bool) {
        self.listener = listener;
        self.script = script;
        self.implicit = implicit;
        let empty is @string = [];
        heard = Atomic(empty);
    }

    async serve() is string {
        try {
            let accepted = await listener.connection();
            defer accepted.close();
            if implicit {
                let secure = await self.secured(accepted);
                defer secure.close();
                await self.talk(
                    input: SmtpTestInput(secure.input()),
                    output: secure.output(),
                    secure: true,
                    greet: true
                );
            }
            else {
                let input = SmtpTestInput(accepted.input());
                let outcome = await self.talk(
                    input: input,
                    output: accepted.output(),
                    secure: false,
                    greet: true
                );
                if outcome == "starttls" {
                    if input.pending() {
                        heard.replace(heard.value() + ["<early bytes>"]);
                    }
                    let secure = await self.secured(accepted);
                    defer secure.close();
                    await self.talk(
                        input: SmtpTestInput(secure.input()),
                        output: secure.output(),
                        secure: true,
                        greet: false
                    );
                }
            }
        }
        catch failure is Error {
            heard.replace(heard.value() + ["<failed>"]);
        }
        heard.value().join("\n");
    }

    hidden async secured(accepted is TcpConnection) is TlsConnection {
        let unnamed is @string = [];
        await test_tls.TlsServerHandshake(
            origin: accepted,
            policy: test_tls.TlsServerPolicy(
                identity: test_tls.TlsIdentity(
                    certificates: SMTP_TEST_CERTIFICATE,
                    key: SMTP_TEST_KEY
                )
            ),
            protocols: unnamed
        ).connection();
    }

    hidden reply(key is string) is string {
        script[key] else "500 unknown command\r\n";
    }

    // The conversation until QUIT, the end of input, or STARTTLS accepted.
    hidden async talk(
        input is SmtpTestInput,
        output is AsyncWriting,
        secure is bool,
        greet is bool
    ) is string {
        if greet {
            let greeting = script["<greeting>"] else "220 test.example ESMTP\r\n";
            await output.write(Utf8Encoded(greeting).bytes());
        }
        loop {
            let line = await input.upto("\r\n");
            if line == "<eof>" {
                return "end";
            }
            heard.replace(heard.value() + [line]);
            let shielded = script["tls:" + line] else "";
            let answer = if secure && shielded != "" {
                shielded;
            }
            else {
                self.reply(line);
            };
            if answer == "<close>" {
                return "end";
            }
            if answer != "<hang>" {
                await output.write(Utf8Encoded(answer).bytes());
            }
            if line == "QUIT" {
                return "end";
            }
            if line == "STARTTLS" && answer.starts_with("220") {
                return "starttls";
            }
            if line == "DATA" && answer.starts_with("354") {
                let body = await input.upto("\r\n.\r\n");
                if body == "<eof>" {
                    return "end";
                }
                heard.replace(heard.value() + ["<data>" + body + "</data>"]);
                let ending = self.reply(".");
                if ending == "<close>" {
                    return "end";
                }
                if ending != "<hang>" {
                    await output.write(Utf8Encoded(ending).bytes());
                }
            }
        }
        "end";
    }
}

// What the tests send.
hidden object SmtpTestMail {
    SmtpTestMail() {}

    message() is MailMessage {
        fixtures.ParsedMail(
            Utf8Encoded(
                "From: Ada <ada@example.test>\r\nTo: grace@example.test\r\nBcc: hidden@example.test\r\nSubject: Lunch\r\n\r\nShall we?\r\n.hidden dot\r\n"
            ).bytes()
        ).message();
    }

    eight_bit() is MailMessage {
        fixtures.ParsedMail(
            Utf8Encoded(
                "From: ada@example.test\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: 8bit\r\n\r\nbody é\r\n"
            ).bytes()
        ).message();
    }
}

hidden const SMTP_TEST_EHLO = "250-test.example\r\n250-SIZE 1000000\r\n250 8BITMIME\r\n";

async test "a submission: multiline greeting, EHLO, MAIL with SIZE, every recipient, dot-stuffed data without Bcc, QUIT" {
    let listener = await test_tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let message = SmtpTestMail().message();
    let size = PreparedSmtpData(
        origin: message,
        capabilities: SmtpCapabilities(SmtpReply(code: 250, lines: ["x", "SIZE 1000000"]))
    ).message_size();
    let mail = "MAIL FROM:<ada@example.test> SIZE=" + size.string();
    let server = SmtpTestServer(
        listener: listener,
        script: [
            "<greeting>": "220-test.example ESMTP\r\n220 ready\r\n",
            "EHLO localhost": SMTP_TEST_EHLO,
            mail: "250 2.1.0 ok\r\n",
            "RCPT TO:<grace@example.test>": "250 2.1.5 ok\r\n",
            "RCPT TO:<hidden@example.test>": "251 2.1.5 forwarded\r\n",
            "DATA": "354 go ahead\r\n",
            ".": "250 2.0.0 queued as 7F3A\r\n",
            "QUIT": "221 2.0.0 bye\r\n",
        ],
        implicit: false
    );
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let session = await SmtpConnecting(
        host: "127.0.0.1",
        port: listener::Local::port,
        security: SmtpSecurity.plaintext
    ).session();
    test.ok(session.capabilities().features().membership(SmtpFeature.eight_bit_mime));
    let submission = await session.submission(
        message: message,
        sender: "ada@example.test",
        recipients: ["grace@example.test", "hidden@example.test"]
    );
    test.ok(submission.complete());
    test.is(submission.accepted().size(), 2);
    test.is(submission.reply().text(), "2.0.0 queued as 7F3A");
    await session.quit();
    test.ok(session.closed());
    await session.quit();
    session.close();
    let heard = await serving;
    test.is(
        heard,
        "EHLO localhost\n" + mail +
            "\nRCPT TO:<grace@example.test>\nRCPT TO:<hidden@example.test>\nDATA\n<data>From: Ada <ada@example.test>\r\nTo: grace@example.test\r\nSubject: Lunch\r\n\r\nShall we?\r\n..hidden dot</data>\nQUIT"
    );
}

async test "refused recipients: a partial refusal is reported, a full one sends no data and keeps the session" {
    let listener = await test_tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let server = SmtpTestServer(
        listener: listener,
        script: [
            "EHLO localhost": "250 test.example\r\n",
            "MAIL FROM:<ada@example.test>": "250 ok\r\n",
            "RCPT TO:<grace@example.test>": "250 ok\r\n",
            "RCPT TO:<nobody@example.test>": "550 5.1.1 no such user\r\n",
            "RCPT TO:<later@example.test>": "450 4.2.1 try later\r\n",
            "RSET": "250 reset\r\n",
            "DATA": "354 go ahead\r\n",
            ".": "250 queued\r\n",
            "QUIT": "221 bye\r\n",
        ],
        implicit: false
    );
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let session = await SmtpConnecting(
        host: "127.0.0.1",
        port: listener::Local::port,
        security: SmtpSecurity.plaintext
    ).session();
    let message = SmtpTestMail().message();
    let partial = await session.submission(
        message: message,
        sender: "ada@example.test",
        recipients: ["nobody@example.test", "grace@example.test", "later@example.test"]
    );
    test.ok(!partial.complete());
    test.is(partial.accepted().size(), 1);
    test.is(partial.accepted().first(), "grace@example.test");
    test.is(partial.refusals().size(), 2);
    test.is(partial.refusals().first()::Refusal::recipient, "nobody@example.test");
    test.is(partial.refusals().first()::Refusal::code, 550);
    test.is(partial.refusals().last()::Refusal::code, 450);
    test.is(partial.refusals().last()::Refusal::text, "4.2.1 try later");
    test.ok(try {
        await session.submission(
            message: message,
            sender: "ada@example.test",
            recipients: ["nobody@example.test", "later@example.test"]
        );
        false;
    }
    catch SmtpFailure.rejected(step, code, text) {
        step == SmtpStep.recipients && code == 550 && text == "5.1.1 no such user";
    });
    test.ok(!session.closed());
    let again = await session.submission(
        message: message,
        sender: "ada@example.test",
        recipients: ["grace@example.test"]
    );
    test.ok(again.complete());
    await session.quit();
    let heard = await serving;
    test.is(
        heard.split("\n").filter() -> line {
            line == "DATA" || line == "RSET";
        },
        ["DATA", "RSET", "DATA"]
    );
}

async test "STARTTLS: verified TLS, a fresh EHLO whose capabilities replace the old ones, then AUTH PLAIN" {
    let listener = await test_tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let server = SmtpTestServer(
        listener: listener,
        script: [
            "EHLO localhost": "250-test.example\r\n250-SIZE 1000000\r\n250 STARTTLS\r\n",
            "STARTTLS": "220 2.0.0 ready for TLS\r\n",
            "tls:EHLO localhost": "250-test.example\r\n250-AUTH LOGIN PLAIN\r\n250 8BITMIME\r\n",
            "tls:AUTH PLAIN AGFkYQBzZWNyZXQ=": "235 2.7.0 accepted\r\n",
            "tls:MAIL FROM:<ada@example.test>": "250 ok\r\n",
            "tls:RCPT TO:<grace@example.test>": "250 ok\r\n",
            "tls:DATA": "354 go ahead\r\n",
            ".": "250 queued\r\n",
            "tls:QUIT": "221 bye\r\n",
        ],
        implicit: false
    );
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let session = await SmtpConnecting(
        host: "127.0.0.1",
        credentials: SmtpCredentials(user: "ada", password: SecretBytes("secret")),
        port: listener::Local::port,
        trust: test_trust.PemTrustStore(SMTP_TEST_CA)
    ).session();
    let offered = session.capabilities().features();
    test.ok(offered.membership(SmtpFeature.eight_bit_mime));
    test.ok(!offered.membership(SmtpFeature.start_tls));
    test.ok(!offered.membership(SmtpFeature.size));
    let submission = await session.submission(
        message: SmtpTestMail().message(),
        sender: "ada@example.test",
        recipients: ["grace@example.test"]
    );
    test.ok(submission.complete());
    await session.quit();
    let heard = (await serving).split("\n");
    test.is(
        [heard[0], heard[1], heard[2], heard[3], heard[4]],
        [
            "EHLO localhost",
            "STARTTLS",
            "EHLO localhost",
            "AUTH PLAIN AGFkYQBzZWNyZXQ=",
            "MAIL FROM:<ada@example.test>"
        ]
    );
    test.is(heard.last(), "QUIT");
}

async test "implicit TLS: a refused login closes the connection and the error holds no secret" {
    let listener = await test_tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let server = SmtpTestServer(
        listener: listener,
        script: [
            "tls:EHLO localhost": "250-test.example\r\n250 AUTH PLAIN\r\n",
            "tls:AUTH PLAIN AGFkYQBzZWNyZXQ=": "535 5.7.8 authentication failed\r\n",
        ],
        implicit: true
    );
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let refusal = try {
        await SmtpConnecting(
            host: "127.0.0.1",
            credentials: SmtpCredentials(user: "ada", password: SecretBytes("secret")),
            port: listener::Local::port,
            security: SmtpSecurity.implicit_tls,
            trust: test_trust.PemTrustStore(SMTP_TEST_CA)
        ).session();
        "connected";
    }
    catch failure is SmtpFailure {
        failure.text();
    };
    test.ok(refusal.contains("authentication"));
    test.ok(refusal.contains("535"));
    test.ok(!refusal.contains("secret") && !refusal.contains("AGFkYQ"));
    test.is(await serving, "EHLO localhost\nAUTH PLAIN AGFkYQBzZWNyZXQ=");
}

async test "TLS is never skipped: no STARTTLS offered, no PLAIN offered, a wrong host name, bytes after the STARTTLS reply" {
    let names = test_dns.FixedResolution(
        test_dns.HostAddresses(host: HostName("wrong.test"), addresses: [IpAddress("127.0.0.1")])
    );
    let cases = [
        ["EHLO localhost": "250 test.example\r\n"],
        [
            "EHLO localhost": "250-test.example\r\n250 STARTTLS\r\n",
            "STARTTLS": "220 ready\r\n",
            "tls:EHLO localhost": "250-test.example\r\n250 AUTH LOGIN\r\n",
        ],
        ["EHLO localhost": "250-test.example\r\n250 STARTTLS\r\n", "STARTTLS": "220 ready\r\n"],
        [
            "EHLO localhost": "250-test.example\r\n250 STARTTLS\r\n",
            "STARTTLS": "220 ready\r\n250 injected\r\n",
        ],
    ];
    let empty is @string = [];
    let outcomes = Atomic(empty);
    for (0..cases.size()) -> index {
        let listener = await test_tcp.TcpListening(port: 0).listener();
        defer listener.close();
        let server = SmtpTestServer(listener: listener, script: cases[index], implicit: false);
        let serve is async () is string = server.serve;
        let serving = spawn serve();
        let host = if index == 2 {
            "wrong.test";
        }
        else {
            "127.0.0.1";
        };
        let outcome = try {
            await SmtpConnecting(
                host: host,
                credentials: SmtpCredentials(user: "ada", password: SecretBytes("secret")),
                port: listener::Local::port,
                trust: test_trust.PemTrustStore(SMTP_TEST_CA),
                resolver: names
            ).session();
            "connected";
        }
        catch MissingSmtpExtension.name(name) {
            name;
        }
        catch failure is test_trust.CertificateVerificationFailed, TlsFailure {
            "certificate";
        }
        catch failure is InvalidSmtpReply {
            "injection";
        };
        let heard = await serving;
        test.ok(!heard.contains("AUTH"));
        outcomes.replace(outcomes.value() + [outcome]);
    }
    test.is(outcomes.value(), ["STARTTLS", "AUTH PLAIN", "certificate", "injection"]);
}

// One plaintext session with script, one submission of message to recipients:
// what happened, whether the session stayed open, and what the server heard.
hidden object SmtpTestTrial {
    has script is %string:string;
    has message is MailMessage;
    has recipients is @string;

    SmtpTestTrial(script is %string:string, message is MailMessage, recipients is @string) {
        self.script = script;
        self.message = message;
        self.recipients = recipients;
    }

    async result() is string {
        let listener = await test_tcp.TcpListening(port: 0).listener();
        defer listener.close();
        let server = SmtpTestServer(listener: listener, script: script, implicit: false);
        let serve is async () is string = server.serve;
        let serving = spawn serve();
        let outcome = try {
            let session = await SmtpConnecting(
                host: "127.0.0.1",
                port: listener::Local::port,
                security: SmtpSecurity.plaintext,
                timeout: Duration(seconds: rat(500, 1000))
            ).session();
            defer session.close();
            let state = try {
                let submission = await session.submission(
                    message: message,
                    sender: "ada@example.test",
                    recipients: recipients
                );
                "accepted " + submission.accepted().size().string();
            }
            catch failure is Error {
                failure.text();
            };
            let open = if session.closed() {
                "closed";
            }
            else {
                "open";
            };
            state + " | " + open;
        }
        catch failure is Error {
            failure.text() + " | none";
        };
        outcome + " | " + await serving;
    }
}

async test "server refusals keep the session open, 421 closes it, EHLO has no HELO fallback" {
    let message = SmtpTestMail().message();
    let base = "EHLO localhost";
    let hello = "250 test.example\r\n";
    let mail = "MAIL FROM:<ada@example.test>";
    let rcpt = "RCPT TO:<grace@example.test>";
    test.is(
        await SmtpTestTrial(
            script: ["<greeting>": "554 5.3.2 no service\r\n"],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.rejected(SmtpStep.greeting, 554, \"5.3.2 no service\") | none | "
    );
    test.is(
        await SmtpTestTrial(
            script: [base: "502 5.5.1 not implemented\r\n"],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.rejected(SmtpStep.hello, 502, \"5.5.1 not implemented\") | none | EHLO localhost"
    );
    test.is(
        await SmtpTestTrial(
            script: [base: hello, mail: "553 5.7.1 denied\r\n"],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.rejected(SmtpStep.sender, 553, \"5.7.1 denied\") | open | EHLO localhost\n" +
            mail
    );
    test.is(
        await SmtpTestTrial(
            script: [base: hello, mail: "421 4.3.2 shutting down\r\n"],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.rejected(SmtpStep.sender, 421, \"4.3.2 shutting down\") | closed | EHLO localhost\n" +
            mail
    );
    test.is(
        await SmtpTestTrial(
            script: [
                base: hello,
                mail: "250 ok\r\n",
                rcpt: "250 ok\r\n",
                "DATA": "554 5.5.1 no valid recipients\r\n",
                "RSET": "250 ok\r\n"
            ],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.rejected(SmtpStep.data, 554, \"5.5.1 no valid recipients\") | open | EHLO localhost\n" +
            mail + "\n" + rcpt + "\nDATA\nRSET"
    );
    let final = await SmtpTestTrial(
        script: [
            base: hello,
            mail: "250 ok\r\n",
            rcpt: "250 ok\r\n",
            "DATA": "354 go\r\n",
            ".": "552 5.3.4 too big\r\n"
        ],
        message: message,
        recipients: ["grace@example.test"]
    ).result();
    test.ok(
        final.starts_with(
            "SmtpFailure.rejected(SmtpStep.message, 552, \"5.3.4 too big\") | open | "
        )
    );
    test.ok(final.contains("<data>"));
}

async test "a reply that breaks the protocol, or a lost connection, closes the session; after the data it is uncertain" {
    let message = SmtpTestMail().message();
    let base = "EHLO localhost";
    let hello = "250 test.example\r\n";
    let mail = "MAIL FROM:<ada@example.test>";
    let rcpt = "RCPT TO:<grace@example.test>";
    test.is(
        await SmtpTestTrial(
            script: [base: hello, mail: "354 what\r\n"],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.unexpected(SmtpStep.sender, 354, \"what\") | closed | EHLO localhost\n" + mail
    );
    test.ok(
        (await SmtpTestTrial(
            script: [base: hello, mail: "250 ok\r\n", rcpt: "hello\r\n"],
            message: message,
            recipients: ["grace@example.test"]
        ).result()).starts_with(
            "InvalidSmtpReply.located("
        )
    );
    test.is(
        await SmtpTestTrial(
            script: [base: hello, mail: "250 ok\r\n", rcpt: "<close>"],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.disconnected(SmtpStep.recipients) | closed | EHLO localhost\n" + mail + "\n" +
            rcpt
    );
    test.is(
        await SmtpTestTrial(
            script: [base: hello, mail: "250 ok\r\n", rcpt: "250 ok\r\n", "DATA": "250 ok\r\n"],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.unexpected(SmtpStep.data, 250, \"ok\") | closed | EHLO localhost\n" + mail +
            "\n" + rcpt + "\nDATA"
    );
    let lost = await SmtpTestTrial(
        script: [
            base: hello,
            mail: "250 ok\r\n",
            rcpt: "250 ok\r\n",
            "DATA": "354 go\r\n",
            ".": "<close>"
        ],
        message: message,
        recipients: ["grace@example.test"]
    ).result();
    test.ok(lost.starts_with("SmtpFailure.uncertain("));
    test.ok(lost.contains(" | closed | "));
    test.ok(lost.ends_with("</data>"));
}

async test "a step over its timeout closes the session; cancelling a submission does too" {
    let message = SmtpTestMail().message();
    let mail = "MAIL FROM:<ada@example.test>";
    test.is(
        await SmtpTestTrial(
            script: ["EHLO localhost": "250 test.example\r\n", mail: "<hang>"],
            message: message,
            recipients: ["grace@example.test"]
        ).result(),
        "SmtpFailure.timed_out(SmtpStep.sender) | closed | EHLO localhost\n" + mail
    );
    let late = await SmtpTestTrial(
        script: [
            "EHLO localhost": "250 test.example\r\n",
            mail: "250 ok\r\n",
            "RCPT TO:<grace@example.test>": "250 ok\r\n",
            "DATA": "354 go\r\n",
            ".": "<hang>"
        ],
        message: message,
        recipients: ["grace@example.test"]
    ).result();
    test.ok(
        late.starts_with(
            "SmtpFailure.uncertain(\"SmtpFailure.timed_out(SmtpStep.message)\") | closed | "
        )
    );
    let listener = await test_tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let server = SmtpTestServer(
        listener: listener,
        script: ["EHLO localhost": "250 test.example\r\n", mail: "<hang>"],
        implicit: false
    );
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let session = await SmtpConnecting(
        host: "127.0.0.1",
        port: listener::Local::port,
        security: SmtpSecurity.plaintext
    ).session();
    let submit is async (MailMessage, string, Sequencing<string>) is SmtpSubmission = session.submission;
    let pending = spawn submit(message, "ada@example.test", ["grace@example.test"]);
    await SystemClock().wait(Duration(seconds: rat(100, 1000)));
    pending.cancel();
    test.ok(try {
        await pending;
        false;
    }
    catch stopped is Cancelled {
        true;
    });
    test.ok(session.closed());
    test.ok(try {
        await session.submission(
            message: message,
            sender: "ada@example.test",
            recipients: ["grace@example.test"]
        );
        false;
    }
    catch SmtpFailure.closed {
        true;
    });
    test.is(await serving, "EHLO localhost\n" + mail);
}

async test "submissions started together run one after another" {
    let listener = await test_tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let server = SmtpTestServer(
        listener: listener,
        script: [
            "EHLO localhost": "250 test.example\r\n",
            "MAIL FROM:<ada@example.test>": "250 ok\r\n",
            "MAIL FROM:<grace@example.test>": "250 ok\r\n",
            "RCPT TO:<linus@example.test>": "250 ok\r\n",
            "DATA": "354 go\r\n",
            ".": "250 queued\r\n",
            "QUIT": "221 bye\r\n",
        ],
        implicit: false
    );
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let session = await SmtpConnecting(
        host: "127.0.0.1",
        port: listener::Local::port,
        security: SmtpSecurity.plaintext
    ).session();
    let message = SmtpTestMail().message();
    let submit is async (MailMessage, string, Sequencing<string>) is SmtpSubmission = session.submission;
    let first = spawn submit(message, "ada@example.test", ["linus@example.test"]);
    let second = spawn submit(message, "grace@example.test", ["linus@example.test"]);
    test.ok((await first).complete());
    test.ok((await second).complete());
    await session.quit();
    let heard = await serving;
    let ada = heard.find("MAIL FROM:<ada@example.test>") else -1;
    let grace = heard.find("MAIL FROM:<grace@example.test>") else -1;
    let data_end = heard.find("</data>") else -1;
    test.ok(ada >= 0 && grace > data_end && data_end > ada);
}

async test "8BITMIME, SMTPUTF8 and SIZE are checked before anything is sent" {
    let listener = await test_tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let server = SmtpTestServer(
        listener: listener,
        script: [
            "EHLO localhost": "250-test.example\r\n250 SIZE 100\r\n",
            "MAIL FROM:<ada@example.test> SIZE=90": "250 ok\r\n",
            "RCPT TO:<grace@example.test>": "250 ok\r\n",
            "DATA": "354 go\r\n",
            ".": "250 queued\r\n",
        ],
        implicit: false
    );
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let session = await SmtpConnecting(
        host: "127.0.0.1",
        port: listener::Local::port,
        security: SmtpSecurity.plaintext
    ).session();
    let mail = SmtpTestMail();
    test.ok(try {
        await session.submission(
            message: mail.eight_bit(),
            sender: "ada@example.test",
            recipients: ["grace@example.test"]
        );
        false;
    }
    catch MissingSmtpExtension.name(name) {
        name == "8BITMIME";
    });
    test.ok(try {
        await session.submission(
            message: mail.message(),
            sender: "ada@example.test",
            recipients: ["jörg@example.test"]
        );
        false;
    }
    catch MissingSmtpExtension.name(name) {
        name == "SMTPUTF8";
    });
    let big = fixtures.ParsedMail(
        Utf8Encoded("Subject: big\r\n\r\n" + "x".repeat(200) + "\r\n").bytes()
    ).message();
    test.ok(try {
        await session.submission(
            message: big,
            sender: "ada@example.test",
            recipients: ["grace@example.test"]
        );
        false;
    }
    catch failure is SmtpLimitExceeded {
        true;
    });
    test.ok(!session.closed());
    let small = fixtures.ParsedMail(
        Utf8Encoded("Subject: small\r\n\r\n" + "x".repeat(70) + "\r\n").bytes()
    ).message();
    let size = PreparedSmtpData(origin: small, capabilities: session.capabilities()).message_size();
    test.ok(
        (await session.submission(
            message: small,
            sender: "ada@example.test",
            recipients: ["grace@example.test"]
        )).complete()
    );
    session.close();
    test.is(size, 90);
    test.is((await serving).split("\n")[1], "MAIL FROM:<ada@example.test> SIZE=90");
}

async test "an international envelope and 8-bit data name SMTPUTF8 and BODY=8BITMIME" {
    let listener = await test_tcp.TcpListening(port: 0).listener();
    defer listener.close();
    let server = SmtpTestServer(
        listener: listener,
        script: [
            "EHLO localhost": "250-test.example\r\n250-8BITMIME\r\n250 SMTPUTF8\r\n",
            "MAIL FROM:<> BODY=8BITMIME SMTPUTF8": "250 ok\r\n",
            "RCPT TO:<jörg@bücher.example>": "250 ok\r\n",
            "DATA": "354 go\r\n",
            ".": "250 queued\r\n",
        ],
        implicit: false
    );
    let serve is async () is string = server.serve;
    let serving = spawn serve();
    let session = await SmtpConnecting(
        host: "127.0.0.1",
        port: listener::Local::port,
        security: SmtpSecurity.plaintext
    ).session();
    let submission = await session.submission(
        message: SmtpTestMail().eight_bit(),
        sender: "",
        recipients: ["jörg@bücher.example"]
    );
    test.ok(submission.complete());
    session.close();
    test.ok((await serving).contains("<data>From: ada@example.test\r\nMIME-Version: 1.0"));
}

test "envelope addresses are mailboxes and cannot carry a command" {
    let good = [
        "a@example.test",
        "first.last+tag@sub.example.test",
        "\"two words\"@example.test",
        "a@[192.0.2.1]",
        "jörg@bücher.example"
    ];
    for good -> address {
        SmtpEnvelope(sender: address, recipients: [address]);
    }
    let bad = [
        "",
        "plain",
        "@example.test",
        "a@",
        ".a@example.test",
        "a.@example.test",
        "a..b@example.test",
        "a b@example.test",
        "a@example.test>\r\nRSET",
        "a@exa mple.test",
        "a@-example.test",
        "a@example-.test",
        "a@example..test",
        "\"open@example.test",
        "\"a\"b\"@example.test",
        "x".repeat(65) + "@example.test",
        "a@" + "b".repeat(254),
        "a\n@example.test"
    ];
    for bad -> address {
        test.ok(try {
            SmtpEnvelope(sender: "", recipients: [address]);
            false;
        }
        catch failure is InvalidSmtpEnvelope {
            true;
        });
    }
    test.ok(try {
        SmtpEnvelope(sender: "a@b@c", recipients: ["a@example.test"]);
        false;
    }
    catch failure is InvalidSmtpEnvelope {
        true;
    });
    let none_given is @string = [];
    test.ok(try {
        SmtpEnvelope(sender: "a@example.test", recipients: none_given);
        false;
    }
    catch failure is InvalidSmtpEnvelope {
        true;
    });
    test.ok(SmtpEnvelope(sender: "", recipients: ["jörg@example.test"]).international());
    test.ok(!SmtpEnvelope(sender: "", recipients: ["a@example.test"]).international());
}

test "credentials need TLS, and the client name is a domain" {
    test.throws(InvalidArgument) {
        SmtpConnecting(
            host: "smtp.example.test",
            credentials: SmtpCredentials(user: "ada", password: SecretBytes("secret")),
            security: SmtpSecurity.plaintext
        );
    };
    test.throws(InvalidArgument) {
        SmtpCredentials(user: "ada\r\nRSET", password: SecretBytes("secret"));
    };
    test.throws(InvalidArgument) {
        SmtpConnecting(host: "smtp.example.test", client: "bad name\r\n");
    };
    test.throws(InvalidArgument) {
        SmtpConnecting(host: "smtp.example.test", port: 0);
    };
    SmtpConnecting(host: "smtp.example.test", client: "[192.0.2.1]");
    test.is(
        test_utf.Utf8Decoded(
            SmtpCredentials(user: "ada", password: SecretBytes("secret")).response().export_bytes()
        ).string(),
        "AGFkYQBzZWNyZXQ="
    );
}

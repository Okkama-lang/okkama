module parallel/map v1.0.0;

import "collections/sequence" take Sequencing;
import "collections/iteration" take Cursor;
import "async/atomic" take Atomic;
import "collections/list" take List, EmptyList;
import "collections/views" take Reversed;
import "async/scope" take FutureScope, Supervising;
import "async/collect" take AllFutures;
import "runtime/system" take system_cpu_count, system_platform;
import "runtime/process" take process_current_id;
import "async/timeout" take Within, TimedOut;
import "time/clock" take SystemClock;
import "time/duration" take Duration;

// An ordered mapping performed by bounded batches of process workers.
//
//     let mapped is ParallelMapped<int,int> = ParallelMapped(
//         origins: [1,2,3], action: Worker(seed: 10).run, workers: 2);
//     let values = await mapped.results();
//
// Construction stores the inputs and validates the positive worker bound. The
// default is the runtime CPU count, read when a run starts. Each results() call creates a fresh
// lazy run; awaiting the same Future again reuses its completed outcome.
//
// A worker must be a synchronous typed bound action accepted by spawn. Receiver
// fields must reconstruct its constructor and all boundary values must satisfy
// the spawn codec. Closures, async actions and arbitrary objects are unsupported.
// The single-file CLI uses processes; embedded execution uses its configured
// executor. This module does not turn Local execution into process parallelism.
// Unix process workers are reused only within one results() run. Every item gets
// a fresh VM and receiver reconstructed from its fields, including fresh once
// slots, language globals, virtual environment and working directory. The OS
// process is shared: PID, native statics/caches and foreign process-global state
// can persist between items. This is not fresh-process isolation. Other hosts
// retain one process per item, as do programs containing native process launches
// (so descendants still get per-item process-group cleanup). No process is kept
// across results() calls.
//
// Batches preserve input order and never exceed workers active children. A batch
// failure prevents later batches. Input/dispatch failure and caller cancellation
// also cancel outstanding children and await their cleanup before settlement.
// Worker failures retain the existing spawn diagnostics, not reconstructed child
// Error objects. Empty inputs yield an empty sequence without dispatch.

// An ordered map done by process workers.
object ParallelMapped<T, R> {
    has origins is Sequencing<T>;
    has action is (T) is R;
    has bound is int;

    // action over origins with workers processes; InvalidWorkerCount below 1.
    ParallelMapped(origins is Sequencing<T>, action is (T) is R, workers is int) {
        confirm workers > 0 else throw InvalidWorkerCount.workers(workers);
        self.origins = origins;
        self.action = action;
        bound = workers;
    }

    // As many workers as the runtime has processors, counted when the run
    // starts.
    ParallelMapped(origins is Sequencing<T>, action is (T) is R) {
        self.origins = origins;
        self.action = action;
        bound = 0;
    }

    // How many workers.
    workers() is int {
        if bound > 0 {
            bound;
        }
        else {
            let workers = system_cpu_count();
            confirm workers > 0 else throw InvalidWorkerCount.workers(workers);
            workers;
        }
    }

    // The results, in the order of origins.
    async results() is Sequencing<R> {
        let workers = self.workers();
        let pool is ParallelMapWorkers<T, R> = ParallelMapWorkers(action: action, workers: workers);
        defer await pool.close();
        let run is ParallelMapRun<T, R> = ParallelMapRun(
            origins: origins,
            action: pool.bound(),
            workers: workers
        );
        let scope is FutureScope<R, Sequencing<R>> = FutureScope(action: run.run);
        await scope.outcome();
    }
}

// Private transport lifetime. The fallback retains the configured executor.
hidden object ParallelMapWorkers<T, R> {
    has action is (T) is R;
    has workers is int;

    ParallelMapWorkers(:action, :workers);

    bound() is (T) is R {
        action;
    }

    async close() is void {}
}

// Implementation body owned by one FutureScope. All started children remain
// supervised even if reading or encoding a later input throws during dispatch.
hidden object ParallelMapRun<T, R> {
    has origins is Sequencing<T>;
    has action is (T) is R;
    has workers is int;

    ParallelMapRun(:origins, :action, :workers);

    async run(group is Supervising<R>) is Sequencing<R> {
        let amount = origins.size();
        let state is ParallelMapProgress<R> = ParallelMapProgress();
        loop {
            let position = state.position();
            if position >= amount {
                last;
            }
            let count = if workers < amount - position {
                workers;
            }
            else {
                amount - position;
            };
            let batch = AllFutures(origins: self.pending(group, position, count));
            let values = await batch.results();
            for values -> value {
                state = state.added(value);
            }
        }
        state.values();
    }

    pending(group is Supervising<R>, position is int, count is int) is @Future<R> {
        let result is @Future<R> = (position..position + count).map() -> index {
            let child = spawn action(origins.item(index));
            group.start(child);
            child;
        };
        result;
    }
}

// Persistent run-local accumulator; a successor appends one ordered result.
hidden object ParallelMapProgress<R> {
    has position is int;
    has reversed is List<R>;

    ParallelMapProgress() {
        let empty is List<R> = EmptyList();
        position = 0;
        reversed = empty;
    }

    position() is int {
        position;
    }

    added(value is R) is ^ParallelMapProgress<R> {
        ^reversed = reversed.prefix(value);
        ^position = position + 1;
    }

    values() is Sequencing<R> {
        let materialized is @R = reversed.map() -> value {
            value;
        };
        Reversed(origin: materialized);
    }
}

// A worker count below 1.
enum InvalidWorkerCount is Error = (workers(workers is int));

hidden object Doubling {
    Doubling();

    run(value is int) is int {
        value * 2;
    }
}

test "the worker bound is given or read from the runtime; zero is refused" {
    test.is(ParallelMapped(origins: [1, 2, 3], action: Doubling().run, workers: 2).workers(), 2);
    test.ok(ParallelMapped(origins: [1, 2, 3], action: Doubling().run).workers() > 0);
    test.throws(InvalidWorkerCount) {
        ParallelMapped(origins: [1], action: Doubling().run, workers: 0);
    };
}

async test "results preserve input order across batches and calls" {
    let mapped is ParallelMapped<int, int> = ParallelMapped(
        origins: [9, 1, 7, 3, 5],
        action: Doubling().run,
        workers: 2
    );
    let first = await mapped.results();
    let second = await mapped.results();
    test.is(first.size(), 5);
    for 0..5 -> index {
        test.is(first.item(index), [18, 2, 14, 6, 10][index]);
        test.is(second.item(index), first.item(index));
    }
}

async test "empty input never dispatches even an unsupported closure" {
    let origins is @int = [];
    let mapped is ParallelMapped<int, int> = ParallelMapped(
        origins: origins,
        action: (value is int) is int {
            value;
        },
        workers: 2
    );
    test.is((await mapped.results()).size(), 0);
}

hidden object StatefulWorker {
    has seed is int;

    StatefulWorker(seed is int) {
        self.seed = seed + 1;
    }

    hidden cached() is int {
        once let answer = seed * 2;
        answer;
    }

    run(value is int) is int {
        self.cached() + value;
    }
}

async test "each item reconstructs the receiver and its once state" {
    let mapped is ParallelMapped<int, int> = ParallelMapped(
        origins: [1, 2, 3, 4],
        action: StatefulWorker(seed: 10).run,
        workers: 1
    );
    let values = await mapped.results();
    for 0..4 -> index {
        test.is(values.item(index), 25 + index);
    }
}

hidden object ProcessWorker {
    ProcessWorker();

    run(value is int) is int {
        process_current_id();
    }
}

async test "a run reuses at most its worker bound and calls own separate pools" {
    if system_platform() == "windows" {
        test.skip("Unix reusable transport");
    }
    let mapped is ParallelMapped<int, int> = ParallelMapped(
        origins: [1, 2, 3, 4, 5, 6],
        action: ProcessWorker().run,
        workers: 2
    );
    let first = await mapped.results();
    test.isnt(first.item(0), first.item(1));
    for 2..6 -> index {
        test.ok(first.item(index) == first.item(0) || first.item(index) == first.item(1));
    }
    let second = await mapped.results();
    for second -> pid {
        test.isnt(pid, first.item(0));
        test.isnt(pid, first.item(1));
    }
}

hidden object NeverWorker {
    NeverWorker();

    run(value is int) is int {
        loop {}
        value;
    }
}

async test "caller cancellation settles outstanding workers before returning" {
    let mapped is ParallelMapped<int, int> = ParallelMapped(
        origins: [1, 2, 3, 4],
        action: NeverWorker().run,
        workers: 2
    );
    test.is(
        try {
            await Within(
                origin: mapped.results(),
                limit: Duration(milliseconds: 100),
                clock: SystemClock()
            ).outcome();
            false;
        }
        catch error is TimedOut {
            true;
        },
        true
    );
}

hidden enum DispatchFailed is Error = (input);

hidden object FailingOrigins does Sequencing<int> {
    has visits is Atomic<int>;

    FailingOrigins(:visits);

    size() is int {
        4;
    }

    item(index is int) is int {
        visits.replace(visits.value() + 1);
        confirm index == 0 else throw DispatchFailed.input;
        1;
    }

    first() is int {
        self.item(0);
    }

    last() is int {
        self.item(3);
    }

    cursor() is Cursor<int> {
        [1, 2, 3, 4].cursor();
    }
}

async test "dispatch failure cancels started work and prevents later input reads" {
    let visits = Atomic(0);
    let mapped is ParallelMapped<int, int> = ParallelMapped(
        origins: FailingOrigins(visits: visits),
        action: NeverWorker().run,
        workers: 2
    );
    test.is(
        try {
            await mapped.results();
            false;
        }
        catch error is DispatchFailed {
            true;
        },
        true
    );
    test.is(visits.value(), 2);
}

// Extracted from new-mixed-merge; checkpoints use the plain P1 test log.
module app;
import "async/atomic" take Atomic;
import "io/stdout" take Stdout;
object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }
    label() is string {
        name;
    }
    renamed(name is string) is ^Res {
        ^name = name;
    }
    destroy {
        log.replace(log.value() + name);
    }
}
main() is int {
    let log = Atomic("");
    defer log.close();
    {
        let a = Res("A", log);
        let b = Res("B", log);
        a = a.renamed("C");
        confirm log.value() == "";
        Stdout().writeln(log.value());
        b.label();
    }
    confirm log.value() == "CBA";
    Stdout().writeln(log.value());
    0;
}

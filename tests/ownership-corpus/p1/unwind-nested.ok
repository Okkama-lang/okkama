// Extracted from unwind; checkpoints use the plain P1 test log.
module app;
import "async/atomic" take Atomic;
import "io/stdout" take Stdout;
object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }
    label() is string {
        name;
    }
    destroy {
        log.replace(log.value() + name);
    }
}
enum Stop is Error = (now);
main() is int {
    let log = Atomic("");
    defer log.close();
    {
        let outer = Res("O", log);
        try {
            let a = Res("A", log);
            {
                let b = Res("B", log);
                throw Stop.now;
            }
        }
        catch e is Stop {
            confirm log.value() == "BA";
            Stdout().writeln(log.value());
            let h = Res("H", log);
            e.text();
        }
        confirm log.value() == "BAH";
        Stdout().writeln(log.value());
    }
    confirm log.value() == "BAHO";
    Stdout().writeln(log.value());
    0;
}

// Extracted from try-results; checkpoints use the plain P1 test log.
module app;
import "async/atomic" take Atomic;
import "io/stdout" take Stdout;
object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }
    label() is string {
        name;
    }
    destroy {
        log.replace(log.value() + name);
    }
}
enum Stop is Error = (now);
main() is int {
    let log = Atomic("");
    defer log.close();
    {
        let value = try {
            let local = Res("L", log);
            Res("T", log);
        }
        catch e is Stop {
            Res("X", log);
        };
        confirm log.value() == "L";
        Stdout().writeln(log.value());
        value.label();
    }
    confirm log.value() == "LT";
    Stdout().writeln(log.value());
    log.replace("");
    {
        let value = try {
            let local = Res("L", log);
            throw Stop.now;
            Res("X", log);
        }
        catch e is Stop {
            let local = Res("H", log);
            Res("C", log);
        };
        confirm log.value() == "LH";
        Stdout().writeln(log.value());
        value.label();
    }
    confirm log.value() == "LHC";
    Stdout().writeln(log.value());
    0;
}

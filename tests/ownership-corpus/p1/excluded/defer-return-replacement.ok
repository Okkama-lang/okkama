// Extracted from new-defer-return-replacement; checkpoints use the plain P1 test log.
module app;
import "async/atomic" take Atomic;
import "io/stdout" take Stdout;
object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }
    label() is string {
        name;
    }
    destroy {
        log.replace(log.value() + name);
    }
}
object Work {
    Work();
    returned(log is Atomic<string>) is Res {
        defer if true {
            return Res("B", log);
        }
        else {
            Res("Z", log);
        };
        return Res("A", log);
    }
}
main() is int {
    let log = Atomic("");
    defer log.close();
    {
        let r = Work().returned(log);
        confirm log.value() == "A";
        Stdout().writeln(log.value());
        r.label();
    }
    confirm log.value() == "AB";
    Stdout().writeln(log.value());
    0;
}

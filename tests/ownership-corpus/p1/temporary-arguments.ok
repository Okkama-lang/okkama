// Extracted from temporary-arguments; checkpoints use the plain P1 test log.
module app;
import "async/atomic" take Atomic;
import "io/stdout" take Stdout;
object Res {
    has name is string;
    has log is Atomic<string>;
    Res(name is string, log is Atomic<string>) {
        self.name = name;
        self.log = log;
    }
    label() is string {
        name;
    }
    destroy {
        log.replace(log.value() + name);
    }
}
object Inspect {
    Inspect();
    two(a is Res, b is Res) is void {
        a.label();
        b.label();
    }
}
main() is int {
    let log = Atomic("");
    defer log.close();
    Inspect().two(Res("A", log), Res("B", log));
    confirm log.value() == "BA";
    Stdout().writeln(log.value());
    log.replace("");
    {
        let a = Res("A", log);
        Inspect().two(a, Res("B", log));
        confirm log.value() == "B";
        Stdout().writeln(log.value());
        Inspect().two(a, a);
        confirm log.value() == "B";
        Stdout().writeln(log.value());
    }
    confirm log.value() == "BA";
    Stdout().writeln(log.value());
    0;
}

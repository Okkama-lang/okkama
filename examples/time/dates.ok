module examples/time/dates v1.0.0;

import "time/date" take Date;
import "time/iso" take IsoText;
import "io/stdout" take Stdout;

// Calendar dates: build one, move it by days, count the days between two,
// read and write ISO 8601.

main() is int {
    let out = Stdout();
    let release = Date(year: 2026, month: 11, day: 11);
    let deadline = release.shifted(30);
    out.writeln("release:  ", release);
    out.writeln("deadline: ", deadline);
    out.writeln("days: ", release.days_until(deadline));

    // A leap day and the day after it.
    let leap = IsoText("2028-02-29").date();
    out.writeln("after the leap day: ", leap.shifted(1));

    // Months keep the day where the target month has it, else take its last day.
    let month_end = Date(year: 2024, month: 1, day: 31);
    out.writeln("a month later: ", month_end.plus_months(1));
    out.writeln("a year after the leap day: ", leap.plus_years(1));

    // Day numbers count from 0001-01-01; equal numbers mean the same day.
    let number = release.day_number();
    out.writeln("day number: ", number);
    out.writeln("same day: ", Date(day_number: number) == release);
    0;
}

module t v1.0.0;

// t/op: compact match cases, case pattern: value; (Book ch. 24.3; #893 replaced ?? !!).
import "tap" take Tap;

enum Status = (ready, failed, done);

main() is int {
    let t = Tap(5);
    let enabled = true;
    t = t.is(if enabled { "on"; } else { "off"; }, "on", "a boolean choice");
    t = t.is(if !enabled { "on"; } else { "off"; }, "off", "the other branch");
    let status = Status.failed;
    t = t.is(match status { case Status.ready: "go"; case Status.failed: "stop"; case Status.done: "done"; }, "stop", "a choice on an enum");
    t = t.is(match status { case Status.ready: "go"; case _: "wait"; }, "wait", "_ covers the rest");
    let found = Maybe.some(3);
    t = t.is(match found { case Maybe.some(n): n * 2; case Maybe.none: 0; }, 6, "a choice binds a payload");
    t.done();
}

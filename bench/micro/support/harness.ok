module bench/support/harness v1.0.0;
import "io/stdout" take Stdout;
import "time/clock" take SystemClock, MonotonicInstant;
import "cli/arguments" take ProcessArguments;
import "strings/parse" take Number;

// Protocol v2: one explicitly warmed batch. Reporting is outside the timed span.
object Measurement {
    has clock is SystemClock;
    has count, warming is int;
    Measurement() {
        let args = ProcessArguments().strings();
        confirm args.size() == 2 else panic "expected N WARMUP";
        let n = Number(args[0]).int();
        let warm = Number(args[1]).int();
        confirm n > 0 && warm >= 0 else panic "N must be positive and WARMUP nonnegative";
        count = n;
        warming = warm;
        clock = SystemClock();
    }
    n() is int { count; }
    warmup() is int { warming; }
    // The span ends at the clock read in elapsed_since. start() runs it once before it reads the start
    // instant, so its first call (and the compile of the clock path) is not inside the span (#1085).
    start() is MonotonicInstant {
        let probe = self.elapsed_since(clock.monotonic_instant());
        confirm probe >= 0 else panic "the monotonic clock went back";
        clock.monotonic_instant();
    }
    elapsed_since(start is MonotonicInstant) is int { clock.monotonic_instant().minus(start).nanoseconds(); }
    finish(start is MonotonicInstant, checksum is int, warm_checksum is int) is void {
        let elapsed = self.elapsed_since(start);
        Stdout().writeln("micro-v2 ", count, " ", warming, " ", elapsed, " ", checksum, " ", warm_checksum);
    }
}

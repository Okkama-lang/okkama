module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/channel" take Channel;

object Job {
    Job();
    async value(i is int) is int { i % 7; }
}

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let channel is Channel<int> = Channel(capacity: 1);
        let sending = channel.sending();
        let receiving = channel.receiving();
        let sum = Sum(total: 0);
        for 0..n -> i {
            await sending.send(i % 7);
            sum = sum.add(await receiving.item());
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

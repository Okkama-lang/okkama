module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "../support/extension" take scalar, bytes, create, read, release, asynchronous;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    value(i is int) is int {
        let counter = create(i);
        let value = read(counter);
        release(counter);
        value;
    }
    run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i { sum = sum.add(self.value(i % 251)); }
        sum.total();
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let warm = bench.run(measure.warmup());
    let before = measure.start();
    let check = bench.run(measure.n());
    measure.finish(before, check, warm);
    0;
}

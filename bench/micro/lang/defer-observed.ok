module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "async/atomic" take Atomic;
object Resource {
    has count is Atomic<int>;
    Resource(:count);
    touch() is void { count.replace(count.value() + 1); }
}
object Bench {
    has count is Atomic<int>;
    Bench() { count = Atomic(0); }
    hidden step(i is int) is int {
        defer Resource(count: count).touch();
        i % 7;
    }
    run(i is int, n is int, acc is int) is int {
        if i == 0 { count.replace(0); }
        if i == n { return acc + count.value(); }
        let value = self.step(i);
        self.run(i + 1, n, acc + value);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

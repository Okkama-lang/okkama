module bench/micro v1.0.0;

import "../support/harness" take Measurement;


role Shape {
    area() is int;
}
object Square does Shape {
    has side is int;
    Square(:side);
    area() is int { side * side; }
}
object Strip does Shape {
    has width is int;
    Strip(:width);
    area() is int { width; }
}
object Shapes {
    has items is @Shape;
    Shapes(:items);
    at(i is int) is Shape { items[i % 2]; }
}

object Bench {
    has shapes is Shapes;
    Bench() { shapes = Shapes(items: [Square(side: 3), Strip(width: 5)]); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        self.run(i + 1, n, acc + (shapes.at(i).area()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

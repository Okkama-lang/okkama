module bench/micro v1.0.0;

import "../support/harness" take Measurement;

// #1176: `rest = rest.slice(1, n)` over a 512-byte text, starting again when one character is left. A slice that
// keeps at most twice what it holds shares its text; copying every slice would cost a quarter of a kilobyte each.

object Bench {
    Bench();
    run(i is int, n is int, text is string, rest is string, acc is int) is int {
        if i == n { return acc; }
        let following = if rest.length() > 1 { rest.slice(1, rest.length()); } else { text; };
        self.run(i + 1, n, text, following, acc + following.length() % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let text = (0..32).reduce("") -> t, k { t + "0123456789abcdef"; };
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), text, text, 0);
    let before = measure.start();
    let check = bench.run(0, n, text, text, 0);
    measure.finish(before, check, warm);
    0;
}

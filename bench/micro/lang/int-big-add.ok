module bench/micro v1.0.0;

import "../support/harness" take Measurement;

// #1148: additions of a 64-digit (4096-bit) integer, eight per iteration.

object Bench {
    Bench();
    power(k is int, x is int) is int {
        if k == 0 { return x; }
        self.power(k - 1, x * 18446744073709551557);
    }
    run(i is int, n is int, big is int, acc is int) is int {
        if i == n { return acc; }
        let s = big + big + big + big + big + big + big + big + i;
        self.run(i + 1, n, big, acc + s % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let big = bench.power(64, 1);
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), big, 0);
    let before = measure.start();
    let check = bench.run(0, n, big, 0);
    measure.finish(before, check, warm);
    0;
}

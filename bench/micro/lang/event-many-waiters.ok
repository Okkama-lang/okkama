module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/event" take Event;

object Waiter {
    has gate is Event;
    has i is int;
    Waiter(:gate, :i);
    async run() is int {
        await gate.wait();
        i % 7;
    }
}

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

// Eight tasks woken by one Event per repetition (#340).
object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let gate = Event();
            let waiters = [0, 1, 2, 3, 4, 5, 6, 7].map() -> k { spawn Waiter(gate: gate, i: i + k).run(); };
            gate.set();
            for waiters -> waiter {
                sum = sum.add(await waiter);
            }
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

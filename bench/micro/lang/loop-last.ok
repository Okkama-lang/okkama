module bench/micro v1.0.0;

import "../support/harness" take Measurement;


object Step {
    has count is int;
    Step(:count);
    next() is ^Step { ^count = count + 1; }
    count() is int { count; }
}

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let step = Step(count: 0);
        let found = loop {
            step = step.next();
            if step.count() == 3 { last step.count(); }
        };
        self.run(i + 1, n, acc + (found + i) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;


object Res {
    has id is int;
    Res(:id);
    destroy { }
    id() is int { id; }
}
object Maker {
    Maker();
    // The resource is destroyed when this action's scope ends.
    make(i is int) is int {
        let r = Res(id: i);
        r.id();
    }
}

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        self.run(i + 1, n, acc + (Maker().make(i)) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/event" take Event;

object Waiter {
    has gate is Event;
    has i is int;
    Waiter(:gate, :i);
    async run() is int {
        await gate.wait();
        i % 7;
    }
}

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

// One task woken through an Event per repetition (#340): spawn, set, await.
object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let gate = Event();
            let waiter = spawn Waiter(gate: gate, i: i).run();
            gate.set();
            sum = sum.add(await waiter);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/event" take Event;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Lease {
    has done is Event;
    Lease(:done);
    async destroy {
        await done.wait();
    }
}

object Holder {
    has done is Event;
    has i is int;
    Holder(:done, :i);
    async run() is int {
        let lease = Lease(done: done);
        await Event().wait();
        i % 7;
    }
}

// A task with an async destroy cancelled and awaited per repetition (#340, #154).
object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        let done = Event(true);
        for 0..n -> i {
            let holder = spawn Holder(done: done, i: i).run();
            holder.cancel();
            let value = try { await holder; } catch e is Cancelled { i % 7; };
            sum = sum.add(value);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

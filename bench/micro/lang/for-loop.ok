module bench/micro v1.0.0;

import "../support/harness" take Measurement;



object Counter {
 has total is int;
 Counter(:total);
 plus(value is int) is ^Counter { ^total = total + value; }
 total() is int { total; }
}

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let sum = Counter(total: i);
        for 0..8 -> value { sum = sum.plus(value); }
        self.run(i + 1, n, acc + sum.total() % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "collections/iteration" take Cursor;
import "collections/views" take Accumulated, Filtered, Flattened, Mapped, Pairwise, Reduced;

hidden object Sum {
    has cursor is Cursor<int>;
    Sum(cursor is Cursor<int>) { self.cursor = cursor; }
    total() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + at.value().item());
            at.replace(at.value().successor());
        }
        n.value();
    }
}

hidden object Walk<T> {
    has cursor is Cursor<T>;
    Walk(cursor is Cursor<T>) { self.cursor = cursor; }
    count() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + 1);
            at.replace(at.value().successor());
        }
        n.value();
    }
}

// Views that fold, filter, flatten, map and pair 1..=v.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 5 + 3;
        let xs is @int = (1..(v + 1)).map() -> x { x; };
        let total = Sum(Accumulated(origin: xs, initial: 0, action: (a is int, b is int) is int { a + b; }).cursor()).total()
            + Sum(Filtered(origin: xs, condition: (x is int) is bool { x % 2 == 0; }).cursor()).total()
            + Sum(Flattened(origin: [xs, [10]]).cursor()).total()
            + Sum(Mapped(origin: xs, mapping: (x is int) is int { x * x; }).cursor()).total()
            + Walk(Pairwise(origin: xs).cursor()).count()
            + Reduced(origin: xs, initial: 1, action: (a is int, b is int) is int { a + b; }).total();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http2-output-delivery; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2Fault, Http2FaultScope;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/internal/http2_output" take Http2ConnectionOutput, Http2OutputTicket, Http2OutputStarting, Http2OutputStopped;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object Start does Http2OutputStarting { Start(); start() is void {} }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let sink = Sink();
            let output = Http2ConnectionOutput(sink,8,1024);
            let frame = Http2Frame(Http2FrameHeader(0.byte(),1.byte(),1,1),[v.byte()]);
            output.frame(frame);
            let ticket = Http2OutputTicket([frame],10,Start());
            ticket.begin();
            ticket.completed();
            let delivered = await ticket.delivered();
            let cancelled = Http2OutputTicket([frame],10,Start());
            cancelled.cancel();
            let failed = Http2OutputTicket([frame],10,Start());
            failed.failed();
            let failure = try { await failed.delivered(); 0; } catch e is Http2OutputStopped { 1; };
            output.finish();
            let done = await output.run();
            let contribution = sink.checksum()+failure+(if delivered && done && cancelled.cancelled() { 1; } else { 0; });
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

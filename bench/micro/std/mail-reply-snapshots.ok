// #244: mail-reply-snapshots; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "encoding/utf" take Utf8Encoded;
import "mail/imap_reading" take ImapResponseRead;
import "mail/imap_response" take ImapResponseDecoder;
import "mail/pop3_reading" take PopReplyRead;
import "mail/pop3_reply" take PopReplyDecoder, PopReplyMode;
import "mail/smtp_reading" take SmtpReplyRead;
import "mail/smtp_reply" take SmtpReplyDecoder;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let imap = ImapResponseRead(ImapResponseDecoder().fed(Utf8Encoded("A"+x+" OK done\r\n").bytes()));
        let pop = PopReplyRead(PopReplyDecoder(PopReplyMode.single).fed(Utf8Encoded("+OK "+x+"\r\n").bytes()));
        let smtp = SmtpReplyRead(SmtpReplyDecoder().fed(Utf8Encoded("250 "+x+"\r\n").bytes()));
        let contribution = imap.consumed()+pop.consumed()+smtp.consumed();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

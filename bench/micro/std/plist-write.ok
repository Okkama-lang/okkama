// Deterministic composite iteration; see oracles.py for the independent checksum.
// EncodedPlist.new(origin is PlistValue, format is PlistFormat) is EncodedPlist | EncodedPlist.new(origin is PlistValue, format is PlistFormat, maximum_bytes is int, maximum_nodes is int, maximum_depth is int) is EncodedPlist
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "plist/write" take EncodedPlist, PlistFormat;
import "plist/value" take PlistString;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let contribution = EncodedPlist(PlistString("item" + i.string()), PlistFormat.xml).bytes().size();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/x25519" take X25519PrivateKey;
import "crypto/secret" take SecretBytes;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let scalar is @byte = [byte(i % 256)] + (1..32).map() -> k { byte(k); };
        let raw = X25519PrivateKey(secret: SecretBytes(scalar)).public_key().raw();
        self.run(i + 1, n, acc + (raw[0].int() + raw[31].int()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "statistics" take Sample;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let sample = Sample([v.float(), (v + 1).float(), (v + 2).float(), (v + 4).float()]);
        let result = sample.size() + sample.values().size() + sample.mean().int() + sample.geometric_mean().int() + sample.harmonic_mean().int() + sample.median_low().int() + sample.median_high().int() + sample.quantiles(
            4
        ).reduce(0) -> s, q {
            s + q.int();
        };
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// Deterministic composite iteration; see oracles.py for the independent checksum.
// TemplateOutput.new(origin is TextTemplate, data is TemplateStrings, destination is WritingText) is TemplateOutput
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "template/render" take TemplateOutput;
import "template/compile" take TextTemplate;
import "template/model" take TemplateBindings;
import "io/buffer" take ByteBuffer;
import "io/text" take Utf8Output;


object Bench {
    has template is TextTemplate;
    Bench() { template = TextTemplate("Hi {{n}}!"); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let buffer = ByteBuffer();
        TemplateOutput(template, TemplateBindings(["n": i.string()]), Utf8Output(origin: buffer.writing())).write();
        let contribution = buffer.content().size();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

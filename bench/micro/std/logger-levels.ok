module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/logger" take Logger;
import "logging/write" take CollectedLogs;
import "logging/level" take LogLevel, LogLevelName, LogLevelFromName;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let collected = CollectedLogs();
        let logger = Logger(name: "svc", destination: collected, level: LogLevel.warning);
        logger.info("hello");
        logger.warning("careful " + i.string());
        if i % 2 == 0 { logger.error("broken"); }
        let parsed = LogLevelFromName(["debug", "info", "warning", "error", "critical"][i % 5]).level();
        let enabled = if logger.enabled(parsed) { 1; } else { 0; };
        self.run(i + 1, n, acc + (collected.size() + enabled + LogLevelName(parsed).string().length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

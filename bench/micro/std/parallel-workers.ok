module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "parallel/map" take ParallelMapped;

object Squarer {
    has offset is int;
    Squarer(:offset);
    of(value is int) is int { value * value + offset; }
}

// The worker bound of a parallel map; no run starts, so no process spawns.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let mapped = ParallelMapped(origins: [i, i + 1], action: Squarer(offset: 1).of, workers: i % 4 + 1);
        self.run(i + 1, n, acc + mapped.workers() % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

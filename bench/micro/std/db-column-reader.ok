module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/read" take DbColumnReader;
import "db/row" take Row, Column;
import "db/value" take DbInteger, DbText, DbValue;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let number = DbColumnReader(name: "n", origin: DbInteger(i % 1000)).int();
        let label = DbColumnReader(name: "label", origin: DbText("v" + i.string())).text();
        let values is @DbValue = [DbInteger(i % 13), DbText("x")];
        let row = Row(columns: [Column(index: 0, name: "id", declaration: "INTEGER"), Column(index: 1, name: "name", declaration: "TEXT")], values: values);
        self.run(i + 1, n, acc + (number + label.length() + row.int("id") + row.text("name").length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/record" take LogRecord, LogContext;
import "logging/level" take LogLevel;
import "logging/name" take LogName;
import "logging/field" take LogFields;
import "time/clock" take Instant;
import "time/duration" take Duration;
import "json" take JsonField, Json;
import "compare" take Order;
import "logging/line" take TextLogLine;
import "logging/level" take LogLevelOrder;
import "logging/redact" take RedactedCauseLogs;
import "logging/write" take CollectedLogs;
import "logging/stream" take TextStreamLogs, LogStyles, LogStyle;
import "logging/logger" take Logger;
import "terminal/style" take TextStyle, DefaultColor, TextAttribute;
import "time/zone" take FixedZone;
import "io/buffer" take ByteBuffer;
import "encoding/utf" take Utf8Decoded;
import "db/error" take DbClosed;

// A record with a cause as a text line (+01:00) on a stream; its cause redacted; level order; per-level styles; a child logger.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let levels is @LogLevel = [LogLevel.debug, LogLevel.info, LogLevel.warning, LogLevel.error, LogLevel.critical];
        let level = levels[i % 5];
        let record = LogRecord(occurred: Instant(origin: Duration(seconds: 1700000000 + i)), level: level, message: "m" + x,
            context: LogContext(name: LogName("app", ["db", "web"][i % 2]), fields: LogFields(JsonField("password", "s" + x), JsonField("id", v)), process: 42));
        let failed = LogRecord(occurred: Instant(origin: Duration(seconds: 1700000000 + i)), level: level, message: "m" + x,
            context: LogContext(name: LogName("app"), fields: LogFields(JsonField("id", v)), process: 42), cause: DbClosed.closed);
        let line = TextLogLine(origin: record, zone: FixedZone(name: "X", offset: Duration(hours: 1))).string();
        let buffer = ByteBuffer();
        TextStreamLogs(origin: buffer.writing()).write(failed);
        let hidden = CollectedLogs();
        RedactedCauseLogs(origin: hidden, replacement: "gone").write(failed);
        let styles = LogStyles(LogStyle(level: LogLevel.error, style: TextStyle(foreground: DefaultColor(), background: DefaultColor(), attributes: [TextAttribute.bold])));
        let child = Logger(name: "svc", destination: hidden, level: LogLevel.debug).child("c" + x);
        let total = line.length() + 1000 * (if hidden.records().first().cause().text().contains("gone") { 1; } else { 0; })
            + (if LogLevelOrder(left: level, right: LogLevel.warning).order() == Order.less { 10000; } else { 20000; })
            + 100000 * styles.style(level).attributes().size() + 1000000 * child.name().string().length()
            + (if Utf8Decoded(buffer.content().bytes()).string().contains(" cause=") { 10000000; } else { 0; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

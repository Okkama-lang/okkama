module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "i18n/plural" take PluralCategoryOf, PluralNumber, PluralCategory, PluralKind;
import "locale/tag" take Locale;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let category = PluralCategoryOf(origin: PluralNumber(i.string()), locale: Locale("ru"), kind: PluralKind.cardinal).category();
        self.run(i + 1, n, acc + (PluralScore(category).value()) % 7);
    }
}

// One, few and many as 1, 2 and 3.
object PluralScore {
    has category is PluralCategory;

    PluralScore(category is PluralCategory) {
        self.category = category;
    }

    value() is int {
        match category {
            case PluralCategory.one {
                1;
            }
            case PluralCategory.few {
                2;
            }
            case PluralCategory.many {
                3;
            }
            else {
                0;
            }
        }
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

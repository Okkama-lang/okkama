// #244: imap-response-decoder; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "encoding/utf" take Utf8Encoded;
import "mail/imap_response" take ImapResponseDecoder, ImapResponseLimits, ImapResponseHeader, ImapResponseQuote;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let limits = ImapResponseLimits(line_bytes:128,literal_bytes:128,wire_bytes:512,literals:4);
        let decoder = ImapResponseDecoder(limits);
        decoder = decoder.fed(Utf8Encoded("A"+x+" OK done\r\nTAIL").bytes());
        let a = decoder.response();
        let b = decoder.finish();
        let header = ImapResponseHeader("A"+x+" OK done");
        let quote = ImapResponseQuote();
        quote = quote.accepted("\"",0);
        let contribution = a.bytes().size()+b.tag().length()+decoder.remainder().size()+header.tag().length()+(if quote.quoted() { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: Basic: сборка Authorization и Base64.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/auth" take BasicCredentials;
import "http/header" take Header;
import "crypto/secret" take SecretBytes;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let secret = SecretBytes("pw" + x);
        let value = BasicCredentials("user" + x, secret).authorization().value();
        let contribution = value.characters().reduce(0) -> total, c { total + c.code(); };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

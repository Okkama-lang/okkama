module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/process" take Process, ExitKind, Signal;
import "os/command" take InheritedCommand;
import "fs/path" take Path;
import "encoding/utf" take Utf8Encoded;
import "os/run" take Run;

// /bin/cat through its async streams: lines and text written, read back as lines, text and bytes; /bin/echo run for bytes and completion.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let child = Process(InheritedCommand(program: Path("/bin/cat"), arguments: []));
        let streams = child.streams();
        let input = streams.input();
        await input.writeln("one", x);
        await input.write("two\n");
        let open = if input.closed() { 0; } else { 1; };
        input.close();
        let lines = streams.output().lines();
        let first = await lines.next();
        let second = await lines.next();
        let third = await lines.next();
        await child.exit();
        let again = Process(InheritedCommand(program: Path("/bin/cat"), arguments: []));
        let more = again.streams();
        await more.input().write("xyz" + x);
        more.input().close();
        let text = await more.output().text(100);
        await again.exit();
        let raw = Process(InheritedCommand(program: Path("/bin/cat"), arguments: []));
        await raw.streams().input().write([byte(1), byte(2), byte(v)]);
        raw.streams().input().close();
        let bytes = await raw.streams().output().bytes(100);
        await raw.exit();
        let echoed = await Run("echo", ["e" + x]).bytes();
        let done = await Run("echo", ["f"]).completion();
        let total = open + 10 * ((first else "").length() + (second else "").length()) + (if third == Maybe.none { 100; } else { 0; })
            + 1000 * text.length() + 10000 * bytes[bytes.size() - 1].int() + 1000000 * echoed.size() + (if done.exit().success() { 10000000; } else { 0; });
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

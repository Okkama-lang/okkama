// #244: http-robots-fetch; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/cache_memory" take CachedHttpEntry, MemoryHttpCache;
import "http/cache_freshness" take CacheResponseTiming, CacheFreshness;
import "http/cache_validation" take CacheValidation, CacheRequestFreshness;
import "http/message" take Request, Response;
import "http/exchange" take ExchangeDetails, ClientResponse;
import "http/header" take Headers, Header;
import "http/status" take Status;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "http/exchange" take Exchanging;
import "http/body" take TextBody;
import "http/robots" take FetchedRobots, RobotsPolicy;
import "url/value" take ParsedUrl;
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds: 100.rat())); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds: 100.rat())); } async wait(duration is Duration) is void {} }
object Origin does Exchanging { has details is ExchangeDetails; has text is string; Origin(details is ExchangeDetails,text is string) { self.details=details; self.text=text; } async response(request is Request) is ClientResponse { ClientResponse(request,Response(status:Status.ok,content:TextBody(text)),details); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let clock = FixedClock();
            let now = clock.monotonic_instant();
            let timing = CacheResponseTiming(clock.instant(),now,now);
            let endpoint = IpEndpoint(IpAddress("127.0.0.1"),80);
            let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(endpoint,endpoint);
            let details = ExchangeDetails(ends,HttpVersion.http_1_1);
            let request = Request(url:"http://example.test/"+x);
            let fields = Headers(Header("Cache-Control","max-age=600"),Header("ETag", "\""+x+"\""));
            let response = ClientResponse(request,Response(status:Status.ok,headers:fields),details);
            let entry = CachedHttpEntry(request,response,timing,[v.byte()],Headers());

            let origin = Origin(details,"User-agent: *\nCrawl-delay: "+x+"\nDisallow: /private\n");
            let robots = FetchedRobots(origin,ParsedUrl("http://example.test/").parts(),"bench");
            let fetched = await robots.fetch();
            let policy = await robots.policy();
            let contribution = fetched.delay("bench")::Span::seconds.int()+policy.delay("bench")::Span::seconds.int()+policy.selected("bench").size();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

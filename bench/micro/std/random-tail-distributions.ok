// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "random/source" take Randomizing;
import "random/distribution" take VonMisesDistribution, ParetoDistribution, WeibullDistribution;

// A controlled Randomizing capability: uniforms are 1/8, integer choices depend on i.
object FixedRandom does Randomizing {
    has index is int;

    FixedRandom(:index);

    integer(start is int, stop is int) is int {
        start + index % (stop - start);
    }

    float() is float {
        0.125;
    }

    bytes(size is int) is @byte {
        (0..size).map() -> k {
            byte((index + k) % 256);
        };
    }
}

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let random = FixedRandom(index: v);
        let a = ParetoDistribution(random, 2.0, v.float()).sample();
        let b = WeibullDistribution(random, 2.0, v.float()).sample();
        let c = VonMisesDistribution(random, v.float() / 10.0, 2.0).sample();
        let result = (a * 1000.0).int() + (b * 1000.0).int() + (c * 1000.0).int();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

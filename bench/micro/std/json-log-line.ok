module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/record" take LogRecord, LogContext;
import "logging/level" take LogLevel;
import "logging/name" take LogName;
import "logging/field" take LogFields;
import "time/clock" take Instant;
import "time/duration" take Duration;
import "json" take JsonField, Json;
import "logging/line" take JsonLogLine;

object Bench {
    has levels is @LogLevel;
    Bench() {
        levels = [LogLevel.debug, LogLevel.info, LogLevel.warning, LogLevel.error, LogLevel.critical];
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let context = LogContext(name: LogName("app", "http"), fields: LogFields(JsonField("id", i)), process: 42);
        let record = LogRecord(occurred: Instant(origin: Duration(seconds: (1700000000 + i).rat())), level: levels[i % 5], message: "request " + i.string(), context: context);
        let line = JsonLogLine(record).string();
        self.run(i + 1, n, acc + (line.length() + line.characters()[line.length() - 3].code()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

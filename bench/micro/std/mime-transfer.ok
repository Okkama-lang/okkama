// Deterministic composite iteration; see oracles.py for the independent checksum.
// TransferEncodedBody.new(origin is ByteSource, encoding is TransferEncoding) is TransferEncodedBody | TransferEncodedBody.new(origin is ByteSource, encoding is TransferEncoding, maximum_bytes is int) is TransferEncodedBody
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mime/transfer" take TransferEncodedBody, TransferEncoding;
import "io/decorators" take ByteSnapshot;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let source = ByteSnapshot([byte(i % 256), byte(1), byte(2)]);
        let contribution = TransferEncodedBody(source, TransferEncoding.base64).bytes()[0].int();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

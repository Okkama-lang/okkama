// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "net/failure" take NetworkError, NetworkOperation, NetworkFailure;
import "net/stream" take StreamFailure;
import "runtime/net" take ip_parse;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let result = try {
            ip_parse(1, "invalid" + x, 0);
            0;
        }
        catch failure is NativeFailure {
            let a = NetworkError(NetworkOperation.reading, failure);
            let b = StreamFailure(NetworkOperation.reading, failure);
            let one = try {
                throw a.error();
            }
            catch e is NetworkFailure {
                v;
            };
            let two = try {
                throw b.error();
            }
            catch e is NetworkFailure {
                v;
            };
            one + two + (if a.applicable() {
                1;
            }
            else {
                0;
            }) + (if b.applicable() {
                1;
            }
            else {
                0;
            });
        };
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

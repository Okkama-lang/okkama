module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/system" take FixedLanguagePreferences;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let preferences = FixedLanguagePreferences(origin: ["de-CH", "en", (if i % 2 == 0 { "fr"; } else { "it-IT"; })], platform_owned: i % 3 == 0);
        let length = preferences.tags().reduce(0) -> total, tag { total + tag.length(); };
        let owned = if preferences.platform_owned() { 1; } else { 0; };
        self.run(i + 1, n, acc + (length + owned) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

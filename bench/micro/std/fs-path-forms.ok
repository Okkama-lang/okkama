module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "compare" take Order;
import "fs/path" take Path, PathStyle, NativePathStyle;

// POSIX paths joined, normalized, made relative, compared; stems and replaced extensions.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let paths is @string = ["/srv/app/./logs/../data/f" + x + ".tar.gz", "rel/a/b" + x + ".txt", "/a/b/c" + x, "../up/x" + x + ".md"];
        let path = Path(paths[i % 4]);
        let base = Path("/srv/app");
        let total = (if path.absolute() { 1; } else { 0; }) + 10 * path.child("k" + x).string().length()
            + 100 * path.extension_replaced("bak").string().length() + 1000 * path.normalized().string().length()
            + (if path.order(base) == Order.less { 10000; } else { 20000; }) + 100000 * Path("/srv/app/data/q" + x).relative_to(base).string().length()
            + 1000000 * path.stem().length() + (if NativePathStyle().style() == PathStyle.posix { 10000000; } else { 0; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http-form-read; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/form" take FormText, ParsedMultipartForm, ParsedUrlEncodedForm, FormLimits;
import "http/body" take ByteBody;
import "encoding/utf" take Utf8Encoded;

object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let wire = "--b\r\nContent-Disposition: form-data; name=\"n\"\r\n\r\n"+x+"\r\n--b--\r\n";
            let reading = ByteBody(Utf8Encoded(wire).bytes()).reading();
            let multipart = ParsedMultipartForm(reading,"b",FormLimits());
            let parts = multipart.parts();
            let part = await parts.part();
            let value = await FormText(part).text();
            parts.close();
            await parts.settled();
            let url_reading = ByteBody(Utf8Encoded("n="+x).bytes()).reading();
            let form = ParsedUrlEncodedForm(url_reading,FormLimits());
            let parsed = await form.read();
            let contribution = value.length()+parsed.text("n").length();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

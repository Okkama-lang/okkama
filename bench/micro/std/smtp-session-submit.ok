// #244: smtp-session-submit; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "async/event" take Event;
import "mail/smtp_session" take SmtpSession, SmtpConnecting, SmtpSecurity;
import "mail/smtp" take SmtpCapabilities, SmtpExtension;
import "mail/smtp_reply" take SmtpReply;
import "mail/smtp_data" take SmtpDataLimits;
import "mail/message" take MailMessage;
import "message/header" take MessageHeaders, MessageHeader, MessageHeaderName;
import "mime/part" take TextBody;
import "crypto/x509/trust" take TrustedCertificates;
import "net/dns" take FixedResolution;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void { await Event().wait(); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput(Utf8Encoded("250 ok\r\n250 ok\r\n354 send\r\n250 saved\r\n221 bye\r\n").bytes());
            let sink = Sink();
            let caps = SmtpCapabilities(SmtpReply(250,["server"]));
            let session = SmtpSession(input,sink,input,caps,[],Duration(seconds:10),FixedClock());
            let mail = MailMessage(MessageHeaders(MessageHeader(MessageHeaderName("Subject"),x)),TextBody("hello\r\n","us-ascii"));
            let result = await session.submission(mail,"a@example.test",["b@example.test"]);
            await session.quit();
            let contribution = (if result.complete() && session.closed() { v; } else { 0; });
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

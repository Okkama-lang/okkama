// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "time/date" take Date;
import "time/day" take TimeOfDay;
import "time/duration" take Duration;
import "time/clock" take Instant, MonotonicInstant;
import "time/local_datetime" take LocalDateTime;
import "time/zone" take FixedZone, Today;
import "time/clock" take Timing;

object FixedClock does Timing {
    has at is Instant;

    FixedClock(:at);

    instant() is Instant {
        at;
    }

    monotonic_instant() is MonotonicInstant {
        MonotonicInstant(Duration(seconds: 0));
    }

    async wait(duration is Duration) is void {}
}

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let zone = FixedZone("fixed", Duration(hours: 1));
        let local = LocalDateTime(Date(1970, 1, v), TimeOfDay(1, 0, 0, 0));
        let at = zone.instant(local);
        let result = at.unix_duration().nanoseconds() + Today(zone: zone, clock: FixedClock(at: at)).date()::Calendar::day;
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "digest/blocks" take DigestBlocks64, DigestCompression64;
import "digest/legacy" take Md5, Sha1;

// The first hex digit of a digest.
hidden object First {
    First();
    digit(hex is string) is int {
        "0123456789abcdef".find(hex.slice(0, 1)) else 99;
    }
}

// A compression that only counts its blocks.
hidden object BlockCount does DigestCompression64 {
    has count is int;
    BlockCount(count is int) { self.count = count; }
    block(origin is @byte) is ^BlockCount { ^count = count + 1; }
    bytes() is @byte { [byte(count % 256)]; }
}

// MD5 and SHA-1 of "a<x>" continued by "b"; the 64-byte block framing of 1..100 bytes, fed twice.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let x = (i % 251 + 1).string();
        let text = "a" + x;
        let f = First();
        let data is @byte = (0..(i % 100 + 1)).map() -> k { byte(k % 256); };
        let blocks = DigestBlocks64(compression: BlockCount(0), origin: data, little_endian: true).state(data).bytes()[0].int();
        let total = f.digit(Md5(text).state("b").hex()) + f.digit(Sha1(text).state("b").hex()) + blocks;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

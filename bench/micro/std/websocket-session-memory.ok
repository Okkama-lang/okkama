// #244: websocket-session-memory; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "random/source" take PcgRandom;
import "http/websocket" take WebSocketLimits, WebSocketClose, WebSocketClosed, TextWebSocketMessage, BinaryWebSocketMessage;
import "http/internal/websocket_frame" take WebSocketFrame, WebSocketFrameHeader, ParsedWebSocketFrameHeader, WebSocketHeaderPrefix;
import "http/internal/websocket_messages" take ParsedWebSocketClose, WebSocketMessageAssembly;
import "http/internal/websocket_output" take WebSocketOutput, WebSocketOutputTicket, WebSocketOutputSettlement, WebSocketOutputCancelled;
import "http/websocket_session" take WebSocketSession;
import "http/internal/websocket_upgrade" take WebSocketOpeningCleanup;
import "io/stream" take AsyncReading, Closing;
import "json" take Json, JsonField;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void { await Event().wait(); } }object Input does AsyncReading, Closing { has source is ByteBodyInput; has stop is Event; Input(bytes is @byte) { source=ByteBodyInput(bytes); stop=Event(); } async bytes(limit is int) is @byte { let bytes=await source.bytes(limit); if bytes.size()>0 { return bytes; } await stop.wait(); []; } close() is void { source.close(); stop.set(); } closed() is bool { stop.ready(); } }object Returned { has session is WebSocketSession; Returned(session is WebSocketSession) { self.session=session; } async value() is WebSocketSession { session; } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let frame = WebSocketFrame(1,true,Utf8Encoded(x).bytes()).bytes([0.byte(),0.byte(),0.byte(),0.byte()]);
            let input = Input(frame+frame);
            let sink = Sink();
            let session = WebSocketSession(input,sink,input,false,PcgRandom(v),WebSocketLimits(),Duration(seconds:1),FixedClock());
            await session.started();
            let message = await session.message();
            let following = await session.next() else TextWebSocketMessage("");
            await session.send(BinaryWebSocketMessage([v.byte()]));
            await session.send_text(x);
            await session.send_bytes([v.byte()]);
            await session.send_json(Json(JsonField("n",v)));
            await session.ping([v.byte()]);
            session.close(); let settled = await session.settled();
            let opening = Returned(session).value();
            let group is FutureGroup<WebSocketSession> = FutureGroup(); group.start(opening); await opening; await group.wait();
            await WebSocketOpeningCleanup(group,opening,Event()).close();
            let contribution = message.text().length()+following.text().length()+sink.checksum()+(if settled { 1; } else { 0; });
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

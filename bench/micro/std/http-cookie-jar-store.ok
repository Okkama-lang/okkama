// #244: Cookie jar store/select с фиксированным clock.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/cookie_jar" take MemoryCookieJar;
import "url/value" take ParsedUrl;
import "http/header" take Header, Headers;
import "http/cookie_policy" take CookieContext;
import "collections/sequence" take Sequencing;
import "http/cookie" take Cookie;
import "time/clock" take Instant, MonotonicInstant, Timing;
import "time/duration" take Duration;
import "http/method" take Method;


object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds: 100.rat())); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds: 100.rat())); } async wait(duration is Duration) is void {} }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let jar = MemoryCookieJar(clock:FixedClock());
        let url = ParsedUrl("https://example.test/a").parts();
        let context = CookieContext(url,true,Method.get);
        jar.store(url,Headers(Header("Set-Cookie","sid="+x+"; Path=/; Secure")),context);
        let contribution = jar.cookies(url,context).first().value().length();
        jar.close();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/hmac" take Hmac, HmacHash;
import "crypto/secret" take SecretBytes;
import "crypto/password" take Argon2Policy;
import "encoding/utf" take Utf8Encoded;

// HMAC-SHA-256 fed in two parts, written as hex and checked against tags; secrets compared; Argon2 cost policies written as arguments and PHC parameters.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let key = SecretBytes("k" + v.string());
        let mac = Hmac(hash: HmacHash.sha256, key: key).state("part" + v.string()).state([byte(i % 256)]);
        let tag = Hmac(hash: HmacHash.sha256, key: key).state("part" + v.string()).state([byte(i % 256)]).bytes();
        let policy = if i % 2 == 0 { Argon2Policy(); } else { Argon2Policy(memory_kib: 1024 * v, iterations: v, parallelism: 1); };
        let total = ("0123456789abcdef".find(mac.hex().slice(0, 1)) else 99) + (if mac.matches(tag) { 16; } else { 0; })
            + (if mac.matches([byte(0)]) { 32; } else { 0; }) + (if key.matches(Utf8Encoded("k" + v.string()).bytes()) { 64; } else { 0; })
            + 128 * key.size() + 1000 * policy.arguments().size() + 10000 * policy.parameters().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

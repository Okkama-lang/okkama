// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "random/distribution" take ListRemoval;
import "collections/list" take EmptyList, List;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let empty is List<int> = EmptyList();
        let items = empty.prefix(v + 2).prefix(v + 1).prefix(v);
        let removed = ListRemoval(items, v % 3);
        let result = removed.item() + removed.remainder().reduce(0) -> s, k {
            s + k;
        };
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

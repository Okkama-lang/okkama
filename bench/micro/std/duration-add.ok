// Deterministic composite iteration; see oracles.py for the independent checksum.
// Duration.new(days is int) is Duration | Duration.new(hours is int) is Duration | Duration.new(microseconds is int) is Duration | Duration.new(milliseconds is int) is Duration | Duration.new(minutes is int) is Duration | Duration.new(nanoseconds is int) is Duration | Duration.new(seconds is int) is Duration | Duration.new(value is rat, unit is DurationUnit) is Duration
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "time/duration" take Duration;


object Bench {
    has extra is Duration;
    Bench() { extra = Duration(milliseconds: 250); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let value = Duration(milliseconds: i);
        let contribution = value.plus(extra).nanoseconds();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: imap-response-progress; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "encoding/utf" take Utf8Encoded;
import "mail/imap_response" take ImapResponseProgress, ImapResponseLimits, ImapResponse;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let progress = ImapResponseProgress(ImapResponseLimits());
        for Utf8Encoded("* 1 FETCH (BODY[TEXT] {"+x.length().string()+"}\r\n").bytes() -> octet { progress = progress.accepted(octet); }
        progress = progress.literal_fragment(Utf8Encoded(x).bytes());
        for Utf8Encoded(")\r\n").bytes() -> octet { progress = progress.accepted(octet); }
        let response = ImapResponse(progress);
        let contribution = response.bytes().size()+response.parts().item(1).bytes().size();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory, SqliteTransactionMode;
import "db/sqlite/blob" take OpenedSqliteBlob;
import "db/value" take DbInteger;
import "db/transaction" take TransactionOptions;

// A zero BLOB of 5..13 bytes opened inside a transaction, written, read back and closed.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let db = await SqliteMemory().connection();
        await db.execution("CREATE TABLE t(data BLOB)");
        await db.execution("INSERT INTO t(data) VALUES (zeroblob(?))", DbInteger(v + 4));
        let tx = await db.transaction(options: TransactionOptions(), mode: SqliteTransactionMode.deferred);
        let blob = await OpenedSqliteBlob(origin: tx, database: "main", table: "t", column: "data", row: 1, writable: true).blob();
        await blob.write(1, [byte(v), byte(7)]);
        let head = await blob.bytes(0, 3);
        let size = blob.size();
        blob.close();
        await tx.commit();
        db.close();
        let total = head[0].int() + head[1].int() + head[2].int() + size;
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

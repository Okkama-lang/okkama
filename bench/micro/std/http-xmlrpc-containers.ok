// #244: http-xmlrpc-containers; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/xmlrpc" take XmlRpcArray, XmlRpcStruct, XmlRpcInteger, XmlRpcMember, XmlRpcDouble, XmlRpcFloat, XmlRpcDateTime, XmlRpcFault, XmlRpcLimits;
import "math/decimal" take Decimal;
import "time/local_datetime" take LocalDateTime;
import "time/date" take Date;
import "time/day" take TimeOfDay;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let array = XmlRpcArray(XmlRpcInteger(v));
        let structure = XmlRpcStruct(XmlRpcMember("n",array.item(0)));
        let floating = XmlRpcFloat(v.float());
        let double = XmlRpcDouble(floating.decimal());
        let date = XmlRpcDateTime(LocalDateTime(Date(2024,1,1),TimeOfDay(0,0,0,0)));
        let fault = XmlRpcFault(v,x);
        let limits = XmlRpcLimits(4,8,v,3);
        let contribution = structure.member("n").int()+double.decimal().rat().int()+date.local_date_time().date()::Calendar::year+fault::Fault::code+limits.wire_bytes();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "template/sections" take SectionTemplate, TemplateSectionOutput;
import "json" take Json, JsonField;
import "io/buffer" take ByteBuffer;
import "io/text" take Utf8Output;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let buffer = ByteBuffer();
        let output = Utf8Output(origin: buffer.writing());
        let template = SectionTemplate("{{#ok}}yes{{/ok}}{{n}}");
        template.write(Json(JsonField("ok", v % 2 == 0), JsonField("n", x)), output);
        let section = TemplateSectionOutput(output, 32);
        section.append("é" + x);
        let result = buffer.content().bytes().reduce(0) -> s, b {
            s + b.int();
        } + section.remaining();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "digest/read" take ReadDigest;
import "digest/sha2" take Sha256;
import "io/buffer" take ByteBuffer;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let data is @byte = (0..40).map() -> k { byte((i + k) % 256); };
        let digest = ReadDigest(origin: ByteBuffer(data).reading(), digest: Sha256(), chunk: 16).digest().bytes();
        self.run(i + 1, n, acc + (digest[0].int() + digest[31].int()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

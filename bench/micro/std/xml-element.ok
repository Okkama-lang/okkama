module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "xml/name" take XmlName;
import "xml/node" take XmlNode, XmlElement, XmlText, XmlComment, XmlProcessingInstruction, XmlAttribute, XmlDocument;

// A small tree built, written and read: children, depth and text.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let item = XmlElement(
            name: XmlName("item"),
            attributes: [XmlAttribute(name: XmlName("id"), value: x + "<&")],
            children: [XmlText("t" + x), XmlComment("c" + x)]
        );
        let children is @XmlNode = [item, XmlProcessingInstruction(target: "pi", data: "d" + x), XmlText("tail")];
        let root = XmlElement(name: XmlName("root"), children: children);
        let total = XmlDocument(root).xml().length() + root.xml().length() + item.xml().length() + root.depth()
            + root.children().size() + root.children("item").size() + item.text().length() + root.text("item").length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

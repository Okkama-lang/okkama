module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/match" take BasicLanguageRange;
import "locale/tag" take Locale;
import "cell" take Cell;

object Bench {
    has available is @Locale;
    has ranges is @string;
    Bench() {
        available = [Locale("en", "US"), Locale("en", "GB"), Locale("de", "DE"), Locale("de"), Locale("fr", "CA")];
        ranges = ["en", "en-GB", "de", "*", "fr-FR", "es"];
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let range = BasicLanguageRange(ranges[i % 6]);
        let matched = Cell(0);
        for available -> locale {
            if range.matches(locale) { matched.replace(matched.value() + locale.string().length()); }
        }
        let direct = if range.matches(Locale("en", "GB")) { 1; } else { 0; };
        self.run(i + 1, n, acc + (matched.value() + range.string().length() + direct) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

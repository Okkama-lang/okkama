module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "archive/path" take ArchivePath;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let path = ArchivePath("docs/" + (i % 50).string() + "/guide-" + i.string() + ".md");
        self.run(i + 1, n, acc + (path.name().length() + path.parent().string().length() + path.segments().size()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

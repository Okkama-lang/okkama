// #244: Robots longest-match allow/disallow.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/robots" take RobotsPolicy;
import "url/value" take ParsedUrl;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = RobotsPolicy("User-agent: *\nDisallow: /private\nAllow: /private/public\n");
        let yes = value.allowed("bot",ParsedUrl("https://example.test/private/public/"+x).parts());
        let no = value.allowed("bot",ParsedUrl("https://example.test/private/"+x).parts());
        let contribution = if yes && !no { v; } else { 999; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

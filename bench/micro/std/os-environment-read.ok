module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/environment" take Environment;
import "os/command" take InheritedCommand;
import "os/platform" take Platform, Host, OperatingSystem;
import "fs/path" take Path;
import "os/environment" take InvalidEnvironmentValue;

// A given environment read: home, membership, text and maybe values (int, boolean); a command described; platform facts (host-independent checks).
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let env = Environment(values: ["HOME": "/home/u" + x, "PORT": (8000 + v).string(), "DEBUG": ["true", "false", "yes", "false"][i % 4], "NAME": "n" + x]);
        let os = Platform().operating_system();
        let total = env.home().path().string().length() + (if env.membership(["PORT", "NOPE"][i % 2]) { 100; } else { 0; }) + 1000 * env.text("NAME").length()
            + (env.maybe("PORT").int() else 0) * 10000 + (try { if env.maybe("DEBUG").boolean() else false { 100000000; } else { 0; }; } catch e is InvalidEnvironmentValue { 300000000; })
            + (if InheritedCommand(program: Path("/bin/echo"), arguments: ["a" + x]).string().contains("\"/bin/echo\"") { 1000000000; } else { 0; })
            + (if Platform().architecture().length() > 0 && os != OperatingSystem.windows && Host().name().length() >= 0 { 10; } else { 20; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

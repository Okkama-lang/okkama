module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "config/source" take LayeredSettings, SettingSource, SettingSourceKind;
import "config/document" take IniSettings;
import "config/environment" take EnvironmentSettings, EnvironmentBinding;
import "config/value" take ScalarSetting;
import "config/key" take SettingKey;
import "config/ini" take ParsedIni;
import "os/environment" take Environment;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let file = SettingSource(kind: SettingSourceKind.document, name: "app.ini");
        let ini = IniSettings(document: ParsedIni("[server]\nport=" + (8000 + i % 100).string() + "\nhost=a\n").document(), source: file);
        let variables = Environment(values: ["APP_HOST": "b" + (i % 3).string()]);
        let environment = EnvironmentSettings(
            environment: variables,
            names: [EnvironmentBinding(name: "APP_HOST", key: SettingKey("server", "host"))],
            source: SettingSource(kind: SettingSourceKind.environment, name: "env")
        );
        let settings = LayeredSettings(ini, environment);
        let port = settings.int("server.port") else 0;
        let host = settings.text("server.host") else "";
        let scalar = ScalarSetting(origin: settings, key: SettingKey("server", "port")).text();
        self.run(i + 1, n, acc + (port + host.length() + scalar.length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

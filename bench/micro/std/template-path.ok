// Deterministic composite iteration; see oracles.py for the independent checksum.
// TemplatePath.new(segments is Sequencing<string>) is TemplatePath | TemplatePath.new(segments is Sequencing<string>, maximum_segments is int, maximum_length is int) is TemplatePath | TemplatePath.new(segments... is string) is TemplatePath
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "template/path" take TemplatePath;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let contribution = TemplatePath("user", "item" + i.string()).string().length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

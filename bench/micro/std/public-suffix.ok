// Deterministic composite iteration; see oracles.py for the independent checksum.
// PublicSuffixList.registrable(origin is HostName) is HostName
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "net/public_suffix" take PublicSuffixList;
import "net/endpoint" take HostName;


object Bench {
    has suffixes is PublicSuffixList;
    Bench() { suffixes = PublicSuffixList(); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let contribution = suffixes.registrable(HostName("www.node" + i.string() + ".co.uk")).ascii().length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

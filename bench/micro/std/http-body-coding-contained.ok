// #244: Gzip body в памяти с проверкой распакованных байтов.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/body_coding" take GzipEncodedBody;
import "http/body" take TextBody;
import "compression/gzip" take GzipDecompressed;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let packed = GzipEncodedBody(TextBody("body"+x).opening()).contained() else [];
        let plain = GzipDecompressed(packed,1024).bytes();
        let contribution = plain.reduce(0) -> s, b { s + b.int(); };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

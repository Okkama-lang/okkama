// Deterministic composite iteration; see oracles.py for the independent checksum.
// NetworkFailure.detailed(operation is NetworkOperation, kind is NetworkFailureKind, message is string) is NetworkFailure
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "net/failure" take NetworkFailure, NetworkOperation, NetworkFailureKind;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let message = "failure " + i.string();
        let error = NetworkFailure.detailed(NetworkOperation.reading, NetworkFailureKind.reset, message);
        let contribution = match error { case NetworkFailure.detailed(_operation, _kind, text) { text.length(); } };
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "i18n/catalog" take MessageCatalog, MessageKey, PluralMessage, PluralForm,
    FallbackTranslation, MessageEntry;
import "i18n/plural" take PluralNumber, PluralCategory;
import "locale/tag" take Locale;

object Bench {
    has fallback is FallbackTranslation;
    has primary_key, fallback_key is MessageKey;

    Bench() {
        let ak = MessageKey("", "a");
        let bk = MessageKey("", "b");
        primary_key = ak;
        fallback_key = bk;
        let forms = [
            PluralForm(PluralCategory.one, "one"),
            PluralForm(PluralCategory.other, "many")
        ];
        let a is @MessageEntry = [PluralMessage(ak, forms)];
        let b is @MessageEntry = [PluralMessage(bk, forms)];
        fallback = FallbackTranslation(
            MessageCatalog(Locale("en"), a),
            MessageCatalog(Locale("en"), b)
        );
    }

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let key = if v % 2 == 0 {
            primary_key;
        }
        else {
            fallback_key;
        };
        let result = fallback.plural(key, PluralNumber(x)).length() + (if fallback.membership(key) {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

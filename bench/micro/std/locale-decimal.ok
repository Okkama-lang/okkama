module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/number" take LocalizedDecimal, NumberFormat, NumberNotation, NumberGrouping, NumberSign, NumberPrecision;
import "locale/tag" take Locale;
import "math/decimal" take Decimal;
import "math/rounding" take Rounding;


object Bench {
    has format is NumberFormat;
    Bench() {
        format = NumberFormat(notation: NumberNotation.standard, grouping: NumberGrouping.automatic, sign: NumberSign.automatic, precision: NumberPrecision(minimum_integer: 1, minimum_fraction: 2, maximum_fraction: 2, rounding: Rounding.half_even));
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let value = Decimal(i.string() + ".5");
        self.run(i + 1, n, acc + (LocalizedDecimal(origin: value, locale: Locale("de"), format: format).string().length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "collections/iteration" take Cursor;
import "collections/set" take OrderedSet, Difference, SymmetricDifference;

hidden object Sum {
    has cursor is Cursor<int>;
    Sum(cursor is Cursor<int>) { self.cursor = cursor; }
    total() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + at.value().item());
            at.replace(at.value().successor());
        }
        n.value();
    }
}

// The difference and symmetric difference of two small sets: walked, sized and probed.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 5 + 3;
        let xs is @int = [v, 1, v, 4, 2, 4];
        let ys is @int = [2, v, 9];
        let left = OrderedSet(values: xs);
        let right = OrderedSet(values: ys);

        let only = Difference(left: left, right: right);
        let either = SymmetricDifference(left: left, right: right);
        let total = Sum(only.cursor()).total() + only.size() + (if only.membership(2) { 1; } else { 0; })
            + Sum(either.cursor()).total() + either.size() + (if either.membership(9) { 1; } else { 0; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

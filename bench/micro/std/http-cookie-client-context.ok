// #244: First-party cookie context.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/cookie_client" take FirstPartyCookies;
import "http/message" take Request;
import "http/cookie_policy" take CookieContext;
import "url/value" take UrlParts;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = FirstPartyCookies().context(Request(url:"https://site"+x+".test/a"));
        let contribution = value.site().string().length();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

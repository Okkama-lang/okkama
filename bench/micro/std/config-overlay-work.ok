// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "config/source" take SettingEntry, SettingSource, SettingSourceKind, SettingOverlay;
import "config/key" take SettingKey;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let source = SettingSource(SettingSourceKind.document, x);
        let key = SettingKey("n");
        let overlay = SettingOverlay().replaced(SettingEntry(key, ["old"], source)).replaced(
            SettingEntry(key, [x], source)
        );
        let result = overlay.entries().first().values().first().length() + overlay.keys().size() + overlay.entry(
            key
        ).values().first().length() + (if overlay.membership(key) {
            v;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

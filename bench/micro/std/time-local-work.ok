// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "time/date" take Date;
import "time/day" take TimeOfDay;
import "time/duration" take Duration;
import "time/clock" take Instant;
import "time/local_datetime" take LocalDateTime;
import "compare" take Order;
import "time/iso" take IsoText;
import "time/rfc3339" take Rfc3339;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let t = TimeOfDay(v, 0, 0, 0);
        let z = TimeOfDay(0, 0, 0, 0);
        let a = LocalDateTime(Date(2024, 1, 1), t);
        let b = LocalDateTime(Date(2024, 1, 1), z);
        let text = a.string();
        let result = a.minus(b).nanoseconds() + text.length() + IsoText(text).local_date_time().time()::Clock::hour + Rfc3339(
            Instant(Duration(seconds: v.rat())),
            Duration(seconds: 0.rat())
        ).string().length() + (if t.order(z) == Order.greater {
            1;
        }
        else {
            0;
        }) + (if a.order(b) == Order.greater {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

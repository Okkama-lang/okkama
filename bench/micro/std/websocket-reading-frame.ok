// #244: WebSocket frame reader на памяти.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/websocket_reading" take WebSocketFrameReading;
import "http/body" take ByteBodyInput;
import "http/internal/websocket_frame" take WebSocketFrame;



object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput(WebSocketFrame(2,true,[byte(v%256)]).bytes([]));
            let frame = await WebSocketFrameReading(input,false,1024).frame();
            let contribution = frame.payload()[0].int();
            input.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

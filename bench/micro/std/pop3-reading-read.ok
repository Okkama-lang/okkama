// #244: Асинхронный PopReplyReading на памяти.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mail/pop3_reading" take PopReplyRead, PopReplyReading;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;
import "mail/pop3_reply" take PopReplyMode;



object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput(Utf8Encoded("+OK value"+x+"\r\n").bytes());
            let value = await PopReplyReading(input,PopReplyMode.single).read();
            let contribution = value.consumed();
            input.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

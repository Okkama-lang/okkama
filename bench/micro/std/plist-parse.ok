// Deterministic composite iteration; see oracles.py for the independent checksum.
// ParsedPlist.new(origin is @byte) is ParsedPlist | ParsedPlist.new(origin is @byte, maximum_input is int, maximum_nodes is int, maximum_depth is int) is ParsedPlist
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "plist/parse" take ParsedPlist;
import "plist/value" take PlistDictionary;
import "encoding/utf" take Utf8Encoded;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let xml = "<plist version=\"1.0\"><dict><key>n</key><integer>" + i.string() + "</integer></dict></plist>";
        let contribution = ParsedPlist(Utf8Encoded(xml).bytes()).dictionary().int("n");
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

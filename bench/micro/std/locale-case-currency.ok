module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "compare" take Order;
import "locale/case" take LocalizedCase;
import "locale/currency" take Currency, LocalizedCurrency, CurrencyFormat, CurrencyDisplay;
import "locale/number" take NumberFormat, NumberNotation, NumberGrouping, NumberSign, NumberPrecision;
import "locale/tag" take Locale;
import "math/decimal" take Decimal;
import "math/rounding" take Rounding;

// The sum of the code points of a text.
hidden object Codes {
    Codes();
    of(text is string) is int {
        text.characters().reduce(0) -> sum, c { sum + c.code(); };
    }
}

// Turkish lower and title case (dotted and dotless i); an amount written in USD, EUR or JPY for en, de and fr; currency codes compared.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let tr = Locale("tr");
        let c = Codes();
        let format = CurrencyFormat(numbers: NumberFormat(notation: NumberNotation.standard, grouping: NumberGrouping.automatic,
            sign: NumberSign.automatic, precision: NumberPrecision(minimum_integer: 1, minimum_fraction: 0, maximum_fraction: 3, rounding: Rounding.half_even)),
            display: CurrencyDisplay.symbol, accounting: false, currency_digits: true);
        let pairs is @string = ["en USD", "de EUR", "fr EUR", "en JPY"];
        let pair = pairs[i % 4].split(" ");
        let total = c.of(LocalizedCase(text: "ISTANBUL " + x + "\u{130}", locale: tr).lower())
            + c.of(LocalizedCase(text: "istanbul ilçe" + x, locale: tr).title())
            + (if Currency(pair[1]).order(Currency("GBP")) == Order.less { 1; } else { 2; })
            + c.of(LocalizedCurrency(amount: Decimal(x + "234.567"), currency: Currency(pair[1]), locale: Locale(pair[0]), format: format).string());
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

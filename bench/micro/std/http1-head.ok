// #244: Парсинг request line и Host.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/http1_head" take Http1RequestHead, ParsedHttp1RequestHead;
import "http/target" take RequestTarget;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = ParsedHttp1RequestHead("GET /a" + x + " HTTP/1.1\r\nHost: example.test\r\n\r\n").head();
        let contribution = value.target().path().length();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "time/duration" take Duration;
import "time/clock" take Instant, MonotonicInstant;
import "compare" take Order;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let a = Instant(Duration(seconds: v.rat()));
        let b = Instant(Duration(seconds: 0.rat()));
        let m = MonotonicInstant(Duration(seconds: v.rat()));
        let z = MonotonicInstant(Duration(seconds: 0.rat()));
        let result = a.minus(b).nanoseconds() + a.string().length() + m.plus(Duration(seconds: 1.rat())).minus(
            z
        ).nanoseconds() + (if a.order(b) == Order.greater {
            1;
        }
        else {
            0;
        }) + (if m.order(z) == Order.greater {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

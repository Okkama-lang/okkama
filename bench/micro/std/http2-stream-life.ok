// #244: http2-stream-life; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/http2_life" take Http2StreamLife, Http2ClientStreamIds;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let stream = v*2+1;
        let life = Http2StreamLife(stream);
        life = life.local_headers(false);
        life = life.remote_headers(false);
        life = life.local_data(true);
        life = life.remote_data(true);
        let local = Http2StreamLife(stream);
        local = local.local_headers(false);
        local = local.local_reset();
        let remote = Http2StreamLife(stream);
        remote = remote.remote_headers(false);
        remote = remote.remote_reset();
        let ids = Http2ClientStreamIds(stream);
        let contribution = ids.highest()+ids.next_stream()+(if life.discarding() && local.discarding() && remote.discarding() { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

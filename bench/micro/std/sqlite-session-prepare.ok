module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory;
import "db/value" take DbInteger;
import "db/prepared" take Prepared;
import "db/query" take Query;

// Prepared statements: one run three times, one queried; both closed (finalized).
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let db = await SqliteMemory().connection();
        await db.execution("CREATE TABLE t(x INTEGER)");
        let insert = await Prepared(origin: db, text: "INSERT INTO t(x) VALUES (?)").statement();
        await insert.execution(DbInteger(v));
        await insert.execution(DbInteger(v + 5));
        let added = await insert.execution(DbInteger(20));
        let select = await db.prepared("SELECT x FROM t WHERE x > ? ORDER BY x");
        let rows = await Query(prepared: select, values: [DbInteger(v)]).all(10);
        let open = if select.closed() { 0; } else { 1; };
        insert.close();
        select.close();
        let shut = if select.closed() { 2; } else { 0; };
        db.close();
        let total = added.affected_rows() + rows.size() + rows[0].int("x") + open + shut;
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/process" take Process, ExitKind, Signal;
import "os/command" take InheritedCommand;
import "fs/path" take Path;
import "encoding/utf" take Utf8Encoded;

// /bin/cat through its input and output readers, error output read; another cat signalled and closed while running.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let child = Process(InheritedCommand(program: Path("/bin/cat"), arguments: []));
        let input = child.input();
        input.write("ab", v.string());
        input.writeln("!");
        input.write([byte(65)]);
        input.close();
        let text = child.output().text(100);
        let errors = child.errors().text(100).length() + child.error_bytes(10).size();
        await child.exit();
        let other = Process(InheritedCommand(program: Path("/bin/cat"), arguments: []));
        let running = if other.running() { 1; } else { 0; };
        other.signal(Signal.terminate);
        let ended = await other.exit();
        other.close();
        let total = text.length() + 100 * errors + 1000 * running + (if ended.success() { 0; } else { 10000; });
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

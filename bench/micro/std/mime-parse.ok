module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "message/header" take MessageHeaders, MessageHeader, MessageHeaderName;
import "mime/part" take ParsedMime, MimeMultipartParsing, MimeMetadata, MimeLimits;
import "mime/media_type" take MediaType;
import "mime/transfer" take TransferEncoding;
import "encoding/utf" take Utf8Encoded;

// One header.
hidden object Header {
    Header();
    of(name is string, value is string) is MessageHeader { MessageHeader(name: MessageHeaderName(name), value: value); }
}

// A hand-written multipart message parsed whole and by its multipart scanner; part metadata read.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let h = Header();
        let inner = Utf8Encoded("--b" + x + "\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nhello " + x + "\r\n--b" + x + "\r\nContent-Type: application/octet-stream\r\nContent-Transfer-Encoding: base64\r\nContent-Disposition: attachment; filename=d.bin\r\n\r\nAQID\r\n--b" + x + "--\r\n").bytes();
        let message = Utf8Encoded("Content-Type: multipart/mixed; boundary=b" + x + "\r\n\r\n").bytes() + inner;
        let parsed = ParsedMime(message);
        let node = parsed.node();
        let scanned = MimeMultipartParsing(origin: inner, start: 0, stop: inner.size(), type: MediaType("multipart/mixed; boundary=b" + x), limits: MimeLimits(),
            depth: 0, remaining_parts: 16, remaining_bytes: 1000000).multipart();
        let meta = MimeMetadata(MessageHeaders(h.of("Content-Type", "image/png"), h.of("Content-Transfer-Encoding", "base64"),
            h.of("Content-Disposition", "inline; filename=p" + x + ".png")));
        let total = node.nodes() + 10 * parsed.part().headers().entries().size() + 100 * scanned.body().parts().size() + 1000 * node.children()[1].part().body().bytes().size()
            + (if meta.type().string() == "image/png" { 10000; } else { 0; }) + (if meta.encoding() == TransferEncoding.base64 { 20000; } else { 0; })
            + 100000 * meta.disposition().string().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "archive/limits" take ArchiveLimits, ArchiveBudget;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let limits = ArchiveLimits(2, 64, 128, 32);
        let budget = ArchiveBudget(limits).entered("a" + x, v).expanded(v);
        let result = budget.entry_remaining() + budget.path().string().length() + budget.completed().total_remaining() + limits.path(
            "b" + x
        ).string().length();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "io/input" take ByteInput;
import "io/stream" take AsyncReading;
import "async/atomic" take Atomic;
import "encoding/utf" take Utf8Encoded;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let input = ByteInput(source: ChunkedSource(Utf8Encoded("first " + i.string() + "\nsecond\nx").bytes()));
            let first = await input.line(terminator: [byte(10)], limit: 64) else [];
            let second = await input.line(terminator: [byte(10)], limit: 64) else [];
            sum = sum.add((first.size() + second.size()) % 7);
        }
        sum.total();
    }
}

// The bytes of origin, at most three a read: an AsyncReading over memory.
object ChunkedSource does AsyncReading {
    has origin is @byte;
    has position is Atomic<int>;

    ChunkedSource(origin is @byte) {
        self.origin = origin;
        position = Atomic(0);
    }

    async bytes(limit is int) is @byte {
        let start = position.value();
        let size = origin.size() - start;
        let count = if size < 3 { size; } else { 3; };
        let taken = if count < limit { count; } else { limit; };
        position.replace(start + taken);
        origin.slice(start, start + taken);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

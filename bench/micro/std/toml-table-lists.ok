module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "toml/parse" take ParsedToml;

// Arrays of floats, booleans and tables, directly and through maybe readers.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let root = ParsedToml("tags = [\"a\", \"b" + x + "\"]\nports = [1, " + x + "]\nweights = [0.5, 1.5]\n" +
            "flags = [true, false, true]\n[[replica]]\nid = 1\n[[replica]]\nid = " + x + "\n").root();
        let total = root.floats("weights").size() + root.booleans("flags").size() + root.tables("replica")[1].int("id")
            + (root.maybe("ports").ints() else [0]).size() + (root.maybe("replica").tables() else []).size()
            + (root.maybe("tags").texts() else []).size() + (root.maybe("absent").ints() else [v]).size();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

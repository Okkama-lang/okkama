module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/jwt" take JwtHmacKey, JwtToken, JwtAlgorithm;
import "crypto/secret" take SecretBytes;
import "json" take Json, JsonField;

object Bench {
    has key is JwtHmacKey;
    Bench() {
        key = JwtHmacKey(algorithm: JwtAlgorithm.hs256, secret: SecretBytes("a-benchmark-secret-of-32-or-more-bytes"));
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let claims = Json(JsonField("sub", "user-" + i.string()), JsonField("n", i));
        let token = JwtToken(claims: claims, key: key).string();
        self.run(i + 1, n, acc + (token.length() + token.characters()[token.length() - 1].code()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

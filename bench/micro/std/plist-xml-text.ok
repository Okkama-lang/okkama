module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/utf" take Utf8Encoded;
import "plist/parse" take ParsedPlist, PlistXmlText;
import "plist/value" take PlistArray, PlistDictionary, PlistMember, PlistString, PlistInteger, PlistUid;

// Plist text whitespace helpers; two parses of a small plist compared; values built in code.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let small = "<plist version=\"1.0\"><array><integer>" + x + "</integer><true/></array></plist>";
        let total = PlistXmlText(" a \n b" + x + " ").compact().length() + PlistXmlText(" a" + x + " ").stripped().length()
            + (if PlistXmlText("a b").whitespace(1) { 1; } else { 0; })
            + (if ParsedPlist(Utf8Encoded(small).bytes()).root() == ParsedPlist(Utf8Encoded(small).bytes()).root() { 1; } else { 0; })
            + PlistArray(PlistString(x), PlistInteger(v)).values().size()
            + PlistDictionary(PlistMember("a", PlistInteger(v)), PlistMember("u", PlistUid(v))).int("a");
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/number" take NumberLocaleData;
import "locale/tag" take Locale;

// The sum of the code points of a text.
hidden object Codes {
    Codes();
    of(text is string) is int {
        text.characters().reduce(0) -> sum, c { sum + c.code(); };
    }
}

// The number data of en and de: decimal and percent patterns (kinds 0 and 2), affixes fitted to symbols, compact forms; Arabic-Indic digits of ar-EG.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let data = NumberLocaleData(Locale(["en", "de"][i % 2]));
        let decimal = data.pattern(0);
        let percent = data.pattern(2);
        let c = Codes();
        let total = c.of(percent.suffix(false)) + c.of(decimal.prefix(true)) + decimal.primary()
            + c.of(data.template(percent.suffix(false), true, false)) + (if data.compact(i % 3 == 0).keys().size() > 0 { 1; } else { 0; })
            + c.of(NumberLocaleData(Locale("ar-EG")).localized("12" + v.string()));
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

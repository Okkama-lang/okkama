// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "net/ip" take IpAddress, IpNetwork, IpInterface, IpAddresses;
import "net/endpoint" take HostName, IpEndpoint;
import "compare" take Order;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let ip = IpAddress("10.0.0." + x);
        let iface = IpInterface(ip, 24);
        let cursor = IpAddresses(IpNetwork(ip, 30)).cursor();
        let result = iface.string().length() + cursor.item().bytes()[3].int() + IpEndpoint(
            ip,
            8000 + v
        ).string().length() + (if HostName("a" + x + ".test").order(HostName("b.test")) == Order.less {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "archive/tar" take TarArchive, ParsedTar;
import "archive/entry" take ArchiveFile, ArchiveEntry, ArchiveEntryVisitor, ArchiveDirectory, ArchiveSymbolicLink, ArchiveHardLink, ArchiveFifo, ArchiveDevice;
import "async/atomic" take Atomic;
import "archive/path" take ArchivePath;
import "archive/metadata" take ArchiveMetadata, ArchiveModificationFromEpoch;
import "archive/limits" take ArchiveLimits;
import "fs/stat" take PermissionMode;
import "cell" take Cell;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let metadata = ArchiveMetadata(
            mode: PermissionMode(420),
            modified: ArchiveModificationFromEpoch((1762000000 + i).rat()).local_date_time(),
            comment: ""
        );
        let entries is @ArchiveEntry = [
            ArchiveFile(path: ArchivePath("a.txt"), metadata: metadata, text: "hello " + i.string()),
            ArchiveFile(path: ArchivePath("dir/b.bin"), metadata: metadata, data: [byte(i % 256), byte(7)])
        ];
        let bytes = TarArchive(entries).bytes();
        let parsed = ParsedTar(origin: bytes, limits: ArchiveLimits(entries: 16, entry_size: 4096, total_size: 65536, path_length: 256)).entries();
        let sizes = DataSizes();
        for parsed -> entry {
            entry.accept(sizes);
        }
        let aligned = if bytes.size() % 512 == 0 { 1; } else { 0; };
        self.run(i + 1, n, acc + (parsed.size() + sizes.total() + aligned) % 7);
    }
}

// Adds up the bytes of the files it visits.
object DataSizes does ArchiveEntryVisitor {
    has sum is Atomic<int>;

    DataSizes() {
        sum = Atomic(0);
    }

    total() is int {
        sum.value();
    }

    file(entry is ArchiveFile) is void {
        sum.replace(sum.value() + entry.data().size());
    }

    directory(entry is ArchiveDirectory) is void {}

    symbolic_link(entry is ArchiveSymbolicLink) is void {}

    hard_link(entry is ArchiveHardLink) is void {}

    fifo(entry is ArchiveFifo) is void {}

    device(entry is ArchiveDevice) is void {}
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

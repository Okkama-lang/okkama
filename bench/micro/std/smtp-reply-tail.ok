// #244: smtp-reply-tail; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "encoding/utf" take Utf8Encoded;
import "mail/smtp_reply" take SmtpReplyLimits, SmtpReplyDecoder;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let decoder = SmtpReplyDecoder(SmtpReplyLimits(line_bytes:128,lines:8,wire_bytes:512)).fed(Utf8Encoded("250 hello"+x+"\r\nTAIL").bytes());
        let contribution = decoder.reply().code()+decoder.reply().text().length()+decoder.remainder().size();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

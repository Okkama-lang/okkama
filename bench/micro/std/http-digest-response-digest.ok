// #244: RFC 7616 SHA-256 Digest response, фиксированный cnonce.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/digest" take DigestChallenge, DigestCredentials;
import "http/auth_challenge" take AuthenticationChallenges;
import "crypto/secret" take SecretBytes;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let challenge = DigestChallenge(AuthenticationChallenges("Digest realm=realm, nonce=nonce, algorithm=SHA-256, qop=auth").values()[0]);
        let secret = SecretBytes("pw");
        let value = DigestCredentials("user"+x,secret).response_digest(challenge,"/path","GET","fixed","00000001");
        let contribution = value.characters().reduce(0) -> s, c { s + c.code(); };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

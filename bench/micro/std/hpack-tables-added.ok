// #244: Вставка HPACK dynamic entry и accounting.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/hpack_tables" take HpackDynamicTable, HpackField;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let table = HpackDynamicTable(4096).added(HpackField("x-id", x));
        let contribution = table.used();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

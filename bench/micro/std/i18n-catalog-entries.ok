// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "i18n/catalog" take MessageCatalog, MessageKey, SingularMessage, PluralMessage, PluralForm,
    MessageEntry;
import "i18n/plural" take PluralCategory;
import "locale/tag" take Locale;
import "compare" take Order;

object Bench {
    has locale is Locale;

    Bench() {
        locale = Locale("en");
    }

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let key = MessageKey("", x);
        let other = MessageKey("z", x);
        let entries is @MessageEntry = [
            SingularMessage(key, x),
            PluralMessage(
                other,
                [PluralForm(PluralCategory.one, "one"), PluralForm(PluralCategory.other, "many")]
            )
        ];
        let catalog = MessageCatalog(locale, entries);
        let result = catalog.text(key).length() + (if catalog.membership(key) {
            1;
        }
        else {
            0;
        }) + (if key.order(other) == Order.less {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

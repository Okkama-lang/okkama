// #244: http-body-brotli-contained; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/body" take ByteBody;
import "http/body_coding" take BrotliEncodedBody;
import "compression/brotli" take BrotliDecompressed;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let packed = BrotliEncodedBody(ByteBody([v.byte()])).contained() else [];
        let decoded = BrotliDecompressed(packed,128).bytes();
        let contribution = decoded[0].int();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

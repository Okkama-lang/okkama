// #244: http-header-queries; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/header" take HeaderName, HeaderLimits, Headers, Header, HttpAsciiLowercase;
import "compare" take Order;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let name = HeaderName("X-N");
        let headers = Headers(entries:[Header(name,x)],limits:HeaderLimits(entries:8,bytes:1024)).addition(Header("Accept","text/plain, application/json"));
        let contribution = headers.first(name).length()+headers.values(name).size()+headers.list("Accept").size()
         + (headers.maybe("x-n").int() else 0) + HttpAsciiLowercase("ABC"+x).string().length()
         + (if headers.membership(name) && name.order(HeaderName("x-n")) == Order.equal { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

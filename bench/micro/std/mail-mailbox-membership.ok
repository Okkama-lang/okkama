// #244: Набор mail flags и поиск keyword.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mail/mailbox" take KeywordFlag, MailFlags;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let flag = KeywordFlag("custom"+x);
        let flags = MailFlags(flag,KeywordFlag("other"));
        let contribution = if flags.membership(KeywordFlag("custom"+x)) { v; } else { 0; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

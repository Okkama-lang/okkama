// #244: http-media-parameters; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/media_type" take HttpMediaParameter, HttpMediaParameters, HttpMediaWireParameter, HttpMediaFields;
import "compare" take Order;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let p = HttpMediaParameter("note","a "+x);
        let parameters = HttpMediaParameters(p);
        let wire = HttpMediaWireParameter(p,true,v);
        let fields = HttpMediaFields("text","plain",[wire],4);
        let contribution = p.string().length()+parameters.string().length()+fields.parameters().first("note").length()+wire.offset()
         + (if parameters.membership("NOTE") && p.order(p)==Order.equal { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

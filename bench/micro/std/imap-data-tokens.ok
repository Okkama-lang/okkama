// #244: Лексинг IMAP списка number/NIL.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mail/imap_data" take ImapDataLexing, ImapDataLimits, ImapDataToken, ImapDataTokens;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = ImapDataLexing("("+x+" NIL)",ImapDataTokens(ImapDataLimits())).tokens().entries();
        let contribution = value.size()+value[1].bytes().size();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

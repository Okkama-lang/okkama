// #244: http1-framing-fields; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/http1_head" take Http1Limits, Http1RequestHead, Http1ResponseHead, ParsedHttp1RequestHead, ParsedHttp1ResponseHead;
import "http/http1_framing" take Http1BodyPlan, Http1BodyKind, Http1FramingFields, Http1ResponseFraming;
import "http/header" take Headers, Header;
import "http/version" take HttpVersion;
import "http/target" take OriginTarget;
import "http/method" take Method;
import "http/status" take Status;
import "http/body" take EmptyBody;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let limits = Http1Limits(head_bytes:512,line_bytes:128,fields:8,body_bytes:1024);
        let fields = Http1FramingFields(Headers(Header("Content-Length",x),Header("Connection","keep-alive")),HttpVersion.http_1_1,limits);
        let chunked = Http1FramingFields(Headers(Header("Transfer-Encoding","chunked")),HttpVersion.http_1_1,limits);
        let codings = chunked.codings();
        chunked.supported(codings);
        let plan = Http1BodyPlan(Http1BodyKind.fixed,v,true);
        let response = Http1ResponseHead(Status.ok,Headers(Header("Content-Length",x)),HttpVersion.http_1_1);
        let framed = Http1ResponseFraming(response,Method.get,limits).plan();
        let contribution = fields.length()[0]+fields.fixed(v,true).length()+plan.length()+framed.length()+fields.list("Connection").size()+codings.size()+(if fields.reusable() { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

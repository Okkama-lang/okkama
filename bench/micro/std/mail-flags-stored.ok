// #244: mail-flags-stored; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "mail/message" take MailMessage, ParsedMail, DeliveredMail, MailDate, ParsedMailDate;
import "mail/mailbox" take StoredMail, MailFlags, SystemFlag, SystemMailFlag, KeywordFlag, Maildir, MaildirLimits, ChangedMaildirFlags;
import "mail/mbox" take MboxArchive, MboxRecord, MboxSeparator, ParsedMbox, MboxLimits;
import "mail/mbox_store" take Mbox;
import "mime/part" take MimeLimits;
import "compare" take Order;
import "encoding/utf" take Utf8Encoded;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let system = SystemFlag(SystemMailFlag.seen);
        let keyword = KeywordFlag("key"+x);
        let flags = MailFlags(system);
        let added = flags.addition(keyword);
        let removed = flags.difference(system);
        let message = ParsedMail(Utf8Encoded("Subject: "+x+"\r\n\r\nhello\r\n").bytes()).message();
        let stored = StoredMail("id"+x,message,added);
        let contribution = stored.flags().size()+removed.size()+system.string().length()+(if system.order(system)==Order.equal && keyword.order(keyword)==Order.equal { v; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

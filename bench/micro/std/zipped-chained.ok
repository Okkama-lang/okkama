module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "collections/combining" take Zipped, Chained;
import "cell" take Cell;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let left = [i % 4, 1, 2, 3];
        let right = ["a", "bb", (i % 10).string()];
        let total = Cell(0);
        for Zipped(left: left, right: right) -> pair {
            total.replace(total.value() + pair.first() + pair.second().length());
        }
        let parts is @@int = [[i % 3], [4, 5], left];
        for Chained(origins: parts) -> value {
            total.replace(total.value() + value);
        }
        self.run(i + 1, n, acc + total.value() % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

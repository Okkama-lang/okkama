// #244: http-conditional-ranges; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/conditional" take ByteRange, ByteRanges, ConditionalLimits;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let range = ByteRange(v,v+2);
        let ranges = ByteRanges("bytes="+range.string()+", -1",ConditionalLimits(bytes:128,entries:8));
        let materialized = ranges.ranges(v+10);
        let contribution = ranges.string().length()+materialized.size()+materialized.item(0).size()
         + (if ranges.satisfiable(v+10) { v; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

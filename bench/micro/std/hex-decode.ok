module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/hex" take HexDecoded;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let text = HexEncodedByte(i % 256).text() + "0102ff";
        self.run(i + 1, n, acc + (HexDecoded(origin: text).bytes()[0].int()) % 7);
    }
}

// The two hex digits of one byte, as HexEncoded writes them.
object HexEncodedByte {
    has value is int;

    HexEncodedByte(value is int) {
        self.value = value;
    }

    text() is string {
        let digits = "0123456789abcdef";
        digits.slice((value / 16).int(), (value / 16).int() + 1) + digits.slice(value % 16, value % 16 + 1);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

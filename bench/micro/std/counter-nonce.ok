module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/nonce" take CounterNonce;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let nonce = CounterNonce(prefix: [byte(1), byte(2), byte(3), byte(4)], counter: i * 65537, size: 12).bytes();
        self.run(i + 1, n, acc + (nonce[11].int() + nonce[9].int() + nonce.size()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

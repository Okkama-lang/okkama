module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/binary" take FloatBytes, Binary, FloatWidth;
import "encoding/utf" take ByteOrder;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let value = i.float() / 8.0 - 1.5;
        let bytes = FloatBytes(value: value, width: FloatWidth.bits64, order: ByteOrder.little).bytes();
        let back = Binary(bytes: bytes, order: ByteOrder.little).float(FloatWidth.bits64);
        let same = if back == value { 1; } else { 0; };
        self.run(i + 1, n, acc + (bytes[7].int() + bytes[6].int() + same) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

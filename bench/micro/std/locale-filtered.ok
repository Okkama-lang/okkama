module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "collections/iteration" take Cursor;
import "locale/tag" take Locale;
import "locale/match" take BasicLanguageRange, FilteredLocales, LookedUpLocale;

hidden object Walk<T> {
    has cursor is Cursor<T>;
    Walk(cursor is Cursor<T>) { self.cursor = cursor; }
    count() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + 1);
            at.replace(at.value().successor());
        }
        n.value();
    }
}

// RFC 4647 basic filtering of six available locales by two ranges, walked and indexed; lookup with truncation and fallback.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let available is @Locale = [Locale("en-US"), Locale("en-GB"), Locale("de"), Locale("de-CH"), Locale("fr-CA"), Locale("sr-Latn-RS")];
        let ranges is @string = ["en", "de-ch", "fr", "sr-latn", "*", "zh"];
        let requested is @BasicLanguageRange = [BasicLanguageRange(ranges[i % 6]), BasicLanguageRange(ranges[(i + 2) % 6])];
        let filtered = FilteredLocales(requested: requested, available: available);
        let size = filtered.size();
        let looked = LookedUpLocale(requested: [BasicLanguageRange(["en-us-x-a", "de-ch-1901", "fr-fr", "zh-hant"][i % 4])], available: available,
            fallback: Locale("de"));
        let total = size + 10 * Walk(filtered.cursor()).count()
            + (if size > 0 { filtered.first().string().length() + filtered.last().string().length() + filtered.item(size - 1).string().length(); } else { 0; })
            + 100 * looked.locale().string().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

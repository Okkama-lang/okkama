// #244: hpack-primitives-parse; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/hpack_primitives" take HpackInteger, ParsedHpackInteger, HpackString, ParsedHpackString, HpackHuffman;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let integer = HpackInteger(v,5,0);
        let parsed = ParsedHpackInteger(integer.bytes(),0,5);
        let text = HpackString([v.byte()]);
        let decoded = ParsedHpackString(text.bytes(),0,8);
        let huffman = HpackHuffman([(7+8*(v%2)).byte()],8);
        let contribution = parsed.int()+decoded.bytes()[0].int()+huffman.bytes()[0].int();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

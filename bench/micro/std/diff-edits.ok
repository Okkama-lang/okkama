module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "diff" take Diff;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let mark = (i % 5).string();
        let left = ["alpha", "beta", "gamma", mark, "delta"];
        let right = ["alpha", "gamma", "beta", mark, "delta", (i % 3).string()];
        let changes = Diff(left: left, right: right);
        let same = if changes.ratio() == 1.0 { 1; } else { 0; };
        self.run(i + 1, n, acc + (changes.edits().size() + (changes.ratio() * 1000.0).int() + same) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

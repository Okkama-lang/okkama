// #244: SMTP DATA dot-stuffing и terminator.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mail/smtp_data" take PreparedSmtpData;
import "mail/message" take ParsedMail;
import "mail/smtp" take SmtpCapabilities;
import "mail/smtp_reply" take SmtpReply;
import "encoding/utf" take Utf8Encoded;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let message = ParsedMail(Utf8Encoded("Subject: x\r\n\r\n.line"+x+"\r\n").bytes()).message();
        let data = PreparedSmtpData(message,SmtpCapabilities(SmtpReply(250,["server"]))).bytes();
        let contribution = data.reduce(0) -> s, b { s + b.int(); };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "compression/internal/codec" take NativeDecompressor, NativeCompressed;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let packed = NativeCompressed([byte(v), byte(255)], "zlib", 6).bytes();
        let decompressor = NativeDecompressor("zlib", 64);
        decompressor.write(packed);
        decompressor.finish();
        let finished = if decompressor.finished() {
            1;
        }
        else {
            0;
        };
        let data = decompressor.output().bytes(128);
        decompressor.close();
        let result = data[0].int() + data[1].int() + finished;
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

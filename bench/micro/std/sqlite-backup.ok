module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory;
import "db/sqlite/backup" take SqliteBackup, BackupReport;
import "fs/temp" take TemporaryDirectory;
import "os/environment" take Environment;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "async/event" take Event;

// A clock whose waits never end on their own: nothing here reads real time.
hidden object StillClock does Timing {
    StillClock();
    instant() is Instant { Instant(origin: Duration(seconds: 0)); }
    monotonic_instant() is MonotonicInstant { MonotonicInstant(origin: Duration(seconds: 0)); }
    async wait(duration is Duration) is void { await Event().wait(); }
}

// An in-memory database of 1..9 tables backed up in one step (12..15 pages; the still clock never waits) into a file of a temporary directory.
object Bench {
    has parent is Environment;
    Bench() {
        parent = Environment();
    }
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let db = await SqliteMemory().connection();
        let made = await db.script(((0..v).map() -> k { "CREATE TABLE t" + k.string() + "(x INTEGER);"; }).join(""));
        let scratch = TemporaryDirectory(parent: parent.temporary(), prefix: "okkama-bk-");
        let report = await SqliteBackup(origin: db, target: scratch.path().child("copy.db"), pages: i % 4 + 12, clock: StillClock(),
            timeout: Duration(seconds: 5)).report();
        let given = BackupReport(copies: v, total: v + 1);
        db.close();
        scratch.close();
        let total = made.size() + report.copies() + 10 * report.total() + given.total();
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

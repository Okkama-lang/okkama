// #244: http-cookie-storage; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/cookie_jar" take CookieLimits, MemoryCookieJar;
import "http/cookie_policy" take CookieOrigin, CookieDomainMatch, CookieContext, ParsedSetCookie;
import "http/header" take Headers, Header;
import "http/method" take Method;
import "url/value" take ParsedUrl;
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void {} }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let url = ParsedUrl("https://example.test/a"+x).parts();
        let origin = CookieOrigin(url);
        let context = CookieContext(url,true,Method.get);
        let wire = "sid="+x+"; Path=/; Secure; Max-Age=600";
        let cookie = ParsedSetCookie(wire,url,FixedClock().instant()).cookie();
        let jar = MemoryCookieJar(FixedClock(),CookieLimits(total:8,per_domain:4));
        jar.store(url,Headers(Header("Set-Cookie",wire)),context);
        let saved = jar.persisted_text();
        let restored = MemoryCookieJar(FixedClock()).restored(saved);
        let contribution = jar.size()+restored.size()+restored.cookies(url,context).item(0).value().length()+cookie.value().length()
         + (if CookieDomainMatch("example.test",origin::Origin::domain,false).matches() { v; } else { 0; });
        jar.clear();
        jar.close();
        restored.close();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: RFC 9457 problem JSON.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "web/exception" take ProblemReply;
import "http/header" take Headers;
import "http/status" take Status;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let response = ProblemReply(Status.not_found,"missing"+x).response();
        let contribution = response::Head::headers.int("Content-Length");
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

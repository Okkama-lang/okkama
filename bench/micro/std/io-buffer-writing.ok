// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "io/buffer" take ByteBuffer;
import "io/decorators" take TeeWriting;
import "io/stream" take Writing;
import "io/text" take Utf8Output;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let a = ByteBuffer();
        let b = ByteBuffer();
        let outputs is @Writing = [a.writing(), b.writing()];
        let tee = TeeWriting(outputs);
        tee.write([byte(v)]);
        tee.flush();
        let text = Utf8Output(origin: a.writing());
        text.write(x);
        text.writeln(x);
        b.writing().write([byte(v + 1)]);
        let result = a.reading().bytes(64).reduce(0) -> s, b {
            s + b.int();
        } + b.content().bytes().reduce(0) -> s, b {
            s + b.int();
        };
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "toml/parse" take ParsedToml;

// A parsed table read by its scalar and array readers.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let root = ParsedToml("name = \"svc" + x + "\"\nport = " + x + "\nratio = " + x + ".5\non = true\n" +
            "tags = [\"a\", \"b" + x + "\"]\nports = [1, " + x + "]\n[server]\nhost = \"h" + x + "\"\n").root();
        let total = root.int("port") + root.float("ratio").int() + (if root.boolean("on") { 1; } else { 0; })
            + root.texts("tags").size() + root.ints("ports")[1] + root.get("server").text("host").length()
            + (if root.value("port") == root.value("port") { 1; } else { 0; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http-endpoint-selection; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/client_policy" take ClientPolicy, ClientTimeouts, Http1ClientProtocols;
import "http/client_protocols" take HttpClientProtocols;
import "http/server_policy" take ServerPolicy;
import "net/tls" take TlsClientPolicy;
import "crypto/x509/trust" take TrustedCertificates;
import "http/version" take HttpVersion;
import "http/endpoint" take HttpEndpointSelection, ListedNetworks, PublicEndpoints, AllEndpoints;
import "net/dns" take FixedResolution;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress, IpNetwork;
import "url/value" take ParsedUrl;

object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let url = ParsedUrl("http://127.0.0."+x+":8080/").parts();
            let access = ListedNetworks(IpNetwork(IpAddress("127.0.0.0"),8));
            let selection = HttpEndpointSelection(url,FixedResolution(),access);
            let endpoints = await selection.endpoints();
            let endpoint = endpoints.item(0);
            let contribution = endpoint::Parts::port+endpoints.size()+(if access.allowed(url,endpoint) && !PublicEndpoints().allowed(url,endpoint) { v; } else { 0; });
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "collections/iteration" take Cursor;
import "collections/frequencies" take Frequencies, KeyedFrequencies, Frequency;

hidden object Counts {
    has cursor is Cursor<Frequency<int>>;
    Counts(cursor is Cursor<Frequency<int>>) { self.cursor = cursor; }
    // Sum of item * amount.
    weighted() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + at.value().item().item() * at.value().item().amount());
            at.replace(at.value().successor());
        }
        n.value();
    }
}

// Frequencies of six ints, in order of first sight and keyed.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 5 + 3;
        let xs is @int = [v, 1, v, 4, 2, 4];
        let keyed = KeyedFrequencies(values: xs);
        let total = Counts(Frequencies(values: xs).cursor()).weighted() + Counts(keyed.cursor()).weighted()
            + keyed.size() + keyed.total() + Frequency(item: v, amount: 2).amount();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

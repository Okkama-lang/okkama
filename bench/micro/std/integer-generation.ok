module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "testing/generation" take IntegerGeneration;
import "random/source" take Randomizing;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let minimum = 10 + i % 10;
        let generated = IntegerGeneration(minimum: minimum, maximum: minimum + 50).sample(random: FirstRandom(), size: 5);
        self.run(i + 1, n, acc + (generated.value() + generated.string().length()) % 7);
    }
}

// A Randomizing that always answers the bottom of the range it is asked for.
object FirstRandom does Randomizing {
    FirstRandom();

    integer(start is int, stop is int) is int {
        start;
    }

    float() is float {
        0.0;
    }

    bytes(size is int) is @byte {
        (0..size).map() -> index { byte(0); };
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: imap-fetch-fields; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "encoding/utf" take Utf8Encoded;
import "mail/imap_message" take ImapFetch, ImapMessage;
import "mail/imap_metadata" take ImapFlagsValue;
import "mail/imap_response" take ParsedImapResponse;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let header = "Subject: "+x+"\r\n\r\n";
        let wire = "* 1 FETCH (UID "+x+" FLAGS (\\Seen) BODY[TEXT] {"+x.length().string()+"}\r\n"+x+" BODY[HEADER] {"+header.length().string()+"}\r\n"+header+" BODY[] {"+(header.length()+x.length()).string()+"}\r\n"+header+x+")\r\n";
        let response = ParsedImapResponse(Utf8Encoded(wire).bytes()).response();
        let fetch = ImapFetch(response);
        let message = ImapMessage(response);
        let flags = ImapFlagsValue(fetch.attribute("FLAGS")).flags();
        let contribution = fetch.body().size()+fetch.headers().entries().size()+fetch.message().headers().entries().size()+fetch.flags().size()+flags.size()+message.uid().number()
         + (if fetch.contains("UID") && fetch.has_body() && fetch.has_headers() && fetch.has_message() { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "xml/name" take XmlName;
import "xml/node" take XmlText, XmlComment, XmlProcessingInstruction, XmlAttribute;

// Leaf nodes built and written: an attribute, a text, a processing instruction and a comment, with escaping.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let total = XmlAttribute(name: XmlName("k"), value: "\"" + x).xml().length() + XmlText("a<b" + x).xml().length()
            + XmlProcessingInstruction(target: "go", data: x).xml().length() + XmlComment(x).xml().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

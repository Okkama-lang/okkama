module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "regex/pattern" take Regex;
import "regex/match" take RegexMatch;
import "regex/search" take RegexMatches;
import "regex/replace" take ExpandedRegexReplacement, RegexSubstitution;

// A template with named and numbered references expanded and substituted; all digit matches walked.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let text = "k" + x + "=" + x + x + " name=n" + x;
        let pair = Regex("(?<key>[a-z]+)(?<id>\\d)?=(?<num>\\d+)");
        let first is RegexMatch = pair.all(text)[0];
        let matches = RegexMatches(origin: text, regex: Regex("\\d"));
        let cursor = Atomic(matches.cursor());
        let digits = Atomic(0);
        loop {
            last if !cursor.value().available();
            digits.replace(digits.value() + 1);
            cursor.replace(cursor.value().successor());
        }
        let template = ExpandedRegexReplacement("${num}-$1");
        let total = template.replacement(first).length()
            + RegexSubstitution(origin: text, regex: pair, replacing: template).amount()
            + (if matches.found() { 1; } else { 0; }) + digits.value();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

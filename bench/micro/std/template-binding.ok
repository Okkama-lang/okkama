// Deterministic composite iteration; see oracles.py for the independent checksum.
// TemplateBindings.new(texts is @string:string) is TemplateBindings | TemplateBindings.new(values is Sequencing<TemplateBinding>) is TemplateBindings | TemplateBindings.new(values is Sequencing<TemplateBinding>, maximum_bindings is int) is TemplateBindings | TemplateBindings.new(values... is TemplateBinding) is TemplateBindings
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "template/model" take TemplateBindings;
import "template/path" take TemplatePath;


object Bench {
    has path is TemplatePath;
    Bench() { path = TemplatePath("n"); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let contribution = TemplateBindings(["n": i.string()]).string(path).length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

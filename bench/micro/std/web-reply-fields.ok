// #244: web-reply-fields; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "web/internal/reply" take BodyStatus, EmptyReplyResponse, OpenedReplyFields, OpenedReplyResponse, ReplyMediaType;
import "http/status" take Status;
import "http/header" take Headers;
import "http/body" take ByteBody;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let media = ReplyMediaType("text/plain").string();
        let body = ByteBody([v.byte()]);
        let fields = OpenedReplyFields(media,body).fields();
        let response = OpenedReplyResponse(BodyStatus(Status.ok).status(),fields,body,Headers()).response();
        let empty = EmptyReplyResponse(Status.no_content,Headers()).response();
        let contribution = response::Head::headers.text("Content-Length").length()+response::Head::code+empty::Head::code+v;
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

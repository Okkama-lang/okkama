module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/record" take LogRecord, LogContext;
import "logging/level" take LogLevel;
import "logging/name" take LogName;
import "logging/field" take LogFields;
import "time/clock" take Instant;
import "time/duration" take Duration;
import "json" take JsonField, Json;
import "compare" take Order;
import "logging/name" take ChildLogName;
import "logging/field" take CombinedLogFields;
import "logging/filter" take LevelThresholds, LevelOverride;

// Log names compared, written and extended; fields merged and read; thresholds with overrides by name prefix.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let levels is @LogLevel = [LogLevel.debug, LogLevel.info, LogLevel.warning, LogLevel.error, LogLevel.critical];
        let level = levels[i % 5];
        let record = LogRecord(occurred: Instant(origin: Duration(seconds: 1700000000 + i)), level: level, message: "m" + x,
            context: LogContext(name: LogName("app", ["db", "web"][i % 2]), fields: LogFields(JsonField("password", "s" + x), JsonField("id", v)), process: 42));
        let name = LogName("app", ["db", "web"][i % 2]);
        let child = ChildLogName(origin: name, segment: "q" + x).name();
        let fields = CombinedLogFields(base: LogFields(JsonField("a", 1), JsonField("b", v)), added: LogFields(JsonField("b", 2), JsonField("c", 3))).fields();
        let thresholds = LevelThresholds(fallback: LogLevel.warning, overrides: [LevelOverride(name: LogName("app", "db"), level: LogLevel.debug)]);
        let total = (if name.order(LogName("app", "m")) == Order.less { 1; } else { 2; }) + 10 * child.string().length()
            + 100 * fields.members().size() + 1000 * fields.value("b").integer() + (if thresholds.allowed(child, level) { 10000; } else { 0; })
            + (if LevelThresholds(fallback: LogLevel.error).allowed(name, level) { 100000; } else { 0; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

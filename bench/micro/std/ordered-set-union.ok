module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "collections/set" take OrderedSet, Union;
import "collections/list" take List, EmptyList;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let empty is List<string> = EmptyList();
        let left = OrderedSet(values: empty.prefix("a").prefix("b").prefix((i % 5).string()));
        let right = OrderedSet(values: empty.prefix("b").prefix("c").prefix((i % 7).string()));
        self.run(i + 1, n, acc + Union(left: left, right: right).size() % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

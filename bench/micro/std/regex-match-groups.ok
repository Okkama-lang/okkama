module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "regex/pattern" take Regex;
import "regex/match" take RegexMatch, RegexCapture;

// One match read by text, named and numbered groups, ranges and an optional group.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let text = "k" + x + "=" + x + x + " name=n" + x;
        let pair = Regex("(?<key>[a-z]+)(?<id>\\d)?=(?<num>\\d+)");
        let first is RegexMatch = pair.all(text)[0];
        let capture = first.capture(1);
        let total = first.text().length() + first.text("num").length() + first.int("num") + first.range()::Bounds::end
            + first.captures().size() + first.group("key").range()::Bounds::start + capture.range()::Bounds::end
            + (first.maybe("id").int() else 0);
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

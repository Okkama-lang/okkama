module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/kdf" take Pbkdf2Secret, KdfHash;
import "crypto/secret" take SecretBytes;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let password = SecretBytes("password-" + i.string());
        let salt = [byte(115), byte(97), byte(108), byte(116)];
        let key = Pbkdf2Secret(KdfHash.sha256, password, salt, 16, 32).secret().export_bytes();
        self.run(i + 1, n, acc + (key[0].int() + key[31].int()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

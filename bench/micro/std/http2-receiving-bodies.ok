// #244: Пустой receiving slot с stream id.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/http2_receiving" take Http2ReceivingSlot;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = Http2ReceivingSlot(v);
        let contribution = value.stream()+value.bodies().size();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

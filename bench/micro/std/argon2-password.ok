module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/password" take PasswordHash, PasswordCheck, Argon2Policy;
import "crypto/secret" take SecretBytes;
import "crypto/nonce" take Entropy;

object Bench {
    has policy is Argon2Policy;
    Bench() {
        policy = Argon2Policy(memory_kib: 8, iterations: 1, parallelism: 1);
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let stored = PasswordHash(password: SecretBytes("pw-" + i.string()), policy: policy, entropy: FixedEntropy()).string();
        let attempt = if i % 3 == 0 { "wrong"; } else { "pw-" + i.string(); };
        let matches = if PasswordCheck(stored: stored, password: SecretBytes(attempt)).matches() { 1; } else { 0; };
        self.run(i + 1, n, acc + (stored.length() + matches) % 7);
    }
}

// The same bytes every time: a deterministic salt.
object FixedEntropy does Entropy {
    FixedEntropy();

    bytes(size is int) is @byte {
        (0..size).map() -> index { byte((index * 37 + 11) % 256); };
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

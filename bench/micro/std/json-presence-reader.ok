module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "json" take ParsedJson, JsonLocation, JsonPointerToken;

// Presence readers of lists, numbers, objects and texts; a pointer location and an escaped token.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let root = ParsedJson("{\"id\":" + x + ",\"name\":\"n" + x + "\",\"ok\":true,\"price\":" + x + ".5,\"none\":null," +
            "\"tags\":[\"a\",\"b\"],\"inner\":{\"k\":" + x + "}}").root();
        let total = (match root.presence("tags").list() { case Presence.some(items) { items.size(); } else { 0; } })
            + (match root.presence("price").number() { case Presence.some(number) { 1; } else { 0; } })
            + (match root.presence("inner").object() { case Presence.some(inner) { inner.size(); } else { 0; } })
            + (match root.presence("name").text() { case Presence.some(name) { name.length(); } else { 0; } })
            + JsonLocation("/a/" + x).string().length() + JsonPointerToken("a/b~" + x).string().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

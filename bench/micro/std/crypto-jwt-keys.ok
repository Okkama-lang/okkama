module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/jwt" take JwtEd25519Key, JwtHmacKey, JwtKeys, JwtKey, JwtAlgorithm, JwtAlgorithmName;
import "crypto/ed25519" take Ed25519PrivateKey;
import "crypto/secret" take SecretBytes;
import "encoding/utf" take Utf8Encoded;

// JWT keys: HS256/384/512 and EdDSA signatures of a changing input, an HMAC check, a key set looked up by kid, algorithm names.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let s = i % 16;
        let input = Utf8Encoded("h.c" + s.string()).bytes();
        let algorithms is @JwtAlgorithm = [JwtAlgorithm.hs256, JwtAlgorithm.hs384, JwtAlgorithm.hs512];
        let algorithm = algorithms[i % 3];
        let hmac = JwtHmacKey(algorithm: algorithm, secret: SecretBytes("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"), id: "h");
        let seed is @byte = (0..32).map() -> k { byte((k + s) % 256); };
        let eddsa = JwtEd25519Key(signing: Ed25519PrivateKey(seed: SecretBytes(seed)), id: "e");
        let keys = JwtKeys(hmac, eddsa);
        let tag = hmac.signature(input);
        let total = tag.size() + tag[0].int() + 1000 * eddsa.signature(input)[0].int() + (if hmac.verified(input, tag) { 1; } else { 0; })
            + (if keys.key(["h", "e"][i % 2]).id() == ["h", "e"][i % 2] { 2; } else { 0; }) + JwtAlgorithmName(algorithm).string().length() * 100000;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

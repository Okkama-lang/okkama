// #244: Валидация server upgrade policy.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/websocket_server" take WebSocketUpgrade;
import "http/websocket" take WebSocketLimits;
import "http/websocket_origin" take SameOriginWebSockets;
import "time/duration" take Duration;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = WebSocketUpgrade(["chat"+x],WebSocketLimits(),SameOriginWebSockets(),Duration(seconds:5));
        let contribution = value.protocols()[0].length();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/system" take PreferredLocales, PreferredLocalePolicy, FixedLanguagePreferences;
import "os/environment" take Environment;

// Preferred locales from given POSIX variables (LANGUAGE, LC_ALL, LANG) or from a platform-owned list; duplicates and bad tags dropped.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let x = (i % 9 + 1).string();
        let environments is @Environment = [Environment(values: ["LANGUAGE": "de_DE:fr:de_DE.UTF-8:C", "LANG": "en_US.UTF-8"]),
            Environment(values: ["LC_ALL": "pt_BR.UTF-8@euro", "LANG": "en_US"]), Environment(values: ["LANG": "C"]), Environment(values: ["HOME": "/h" + x])];
        let environment = environments[i % 4];
        let owned = FixedLanguagePreferences(origin: ["sr-Latn-RS", "en", "en", "x?" + x], platform_owned: i % 5 == 0);
        let preferred = PreferredLocales(origin: environment, preferences: owned);
        let total = preferred.size() + 10 * preferred.first().string().length() + 100 * PreferredLocalePolicy(environment: environment, preferences: owned).values().size();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

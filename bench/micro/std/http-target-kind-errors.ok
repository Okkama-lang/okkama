// #244: http-target-kind-errors; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/target" take OriginTarget, AbsoluteTarget, AuthorityTarget, AsteriskTarget, WrongRequestTargetKind;
import "url/value" take ParsedUrl;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let origin = OriginTarget("/"+x,Maybe<string>.none);
        let absolute = AbsoluteTarget(ParsedUrl("http://example.test/"+x).parts());
        let authority = AuthorityTarget(ParsedUrl("//example.test:80").parts());
        let star = AsteriskTarget();
        let e0 = try { origin.authority(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e1 = try { origin.url(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e2 = try { absolute.authority(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e3 = try { authority.path(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e4 = try { authority.query(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e5 = try { authority.url(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e6 = try { star.authority(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e7 = try { star.path(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e8 = try { star.query(); 0; } catch e is WrongRequestTargetKind { 1; };
        let e9 = try { star.url(); 0; } catch e is WrongRequestTargetKind { 1; };
        let contribution = v+e0+e1+e2+e3+e4+e5+e6+e7+e8+e9;
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

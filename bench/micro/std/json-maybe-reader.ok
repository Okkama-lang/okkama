module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "json" take ParsedJson;

// Maybe readers of a parsed object, present and nested.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let root = ParsedJson("{\"id\":" + x + ",\"name\":\"n" + x + "\",\"ok\":true,\"price\":" + x + ".5,\"none\":null," +
            "\"tags\":[\"a\",\"b\"],\"inner\":{\"k\":" + x + "}}").root();
        let inner = root.maybe("inner");
        let total = (root.maybe("id").int() else 0) + (root.maybe("id").integer() else 0)
            + (if root.maybe("ok").boolean() else false { 1; } else { 0; }) + (root.maybe("tags").list() else []).size()
            + (inner.maybe("k").int() else 0) + (if inner.node() == Maybe.none { 0; } else { 1; })
            + (root.maybe("price").number() else root.number("id")).string().length()
            + (root.maybe("absent").int() else 2 * v);
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

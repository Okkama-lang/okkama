module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "xml/name" take XmlNCName, InvalidXml;
import "xml/write" take XmlCharacters;
import "xml/internal/events" take XmlTokens;

// The event list of a small document read by kind, name, text and offset; a name and a text validated, half of them invalid.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let doc = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><root xmlns=\"\"><item xmlns=\"\" id=\"" + x + "&lt;&amp;\">t" + x +
            "<!--c" + x + "--></item><?pi d" + x + "?>tail</root>";
        let events = XmlTokens(origin: doc, maximum_depth: 16, maximum_events: 64).events();
        let name = if i % 2 == 0 { "n" + x; } else { x + "n"; };
        let valid = try { XmlNCName(name); 1; } catch e is InvalidXml { 0; };
        let chars = try { XmlCharacters(if i % 3 == 0 { "a\u{1}b"; } else { "a&b<" + x; }); 2; } catch e is InvalidXml { 0; };
        let total = events.count() + events.kind(1) + events.name(0).length() + events.text(2).length() + events.event_offset(1)
            + valid + chars;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

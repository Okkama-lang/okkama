module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "compare" take Order;
import "collections/ordering" take SortedBy, Ranked, PositionOf, LowerBound, UpperBound;

// Ranked comparison, linear position and binary bounds over small sorted lists.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 5 + 3;
        let total = SortedBy(origin: [v, 1, 4], key: (x is int) is int { 0 - x; }).size()
            + (if Ranked(item: "a", key: v).order(Ranked(item: "b", key: 4)) == Order.less { 1; } else { 2; })
            + PositionOf(origin: [1, 2, 4, v + 10], item: 4).index()
            + LowerBound(origin: [1, 2, 4, 4, 8], item: v).index() + UpperBound(origin: [1, 2, 4, 4, 8], item: v).index();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http2-send-data; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2Fault, Http2FaultScope;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/internal/http2_output" take Http2ConnectionOutput, Http2OutputTicket, Http2OutputStarting, Http2OutputStopped;
import "http/internal/http2_flow" take Http2FlowWindow, Http2SendCredit, Http2DataPayload, Http2WindowFrame, Http2WindowIncrement;
import "http/internal/http2_sending" take Http2DataScheduler, Http2DataGrant;
import "http/internal/http2_settings" take Http2PeerSettings;
import "async/scope" take FutureGroup;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let sink = Sink();
            let output = Http2ConnectionOutput(sink,8,1024);
            let scheduler = Http2DataScheduler(output,Http2PeerSettings(),8);
            scheduler.open(1);
            let group is FutureGroup<bool> = FutureGroup();
            let runner = output.run();
            group.start(runner);
            let delivered = await scheduler.data(1,[v.byte()],true);
            output.finish();
            let done = await runner;
            await group.wait();
            let contribution = sink.checksum()+(if delivered && done { 1; } else { 0; });
            scheduler.stop();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

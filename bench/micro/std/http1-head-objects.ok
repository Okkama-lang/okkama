// #244: http1-head-objects; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/http1_head" take Http1Limits, Http1RequestHead, Http1ResponseHead, ParsedHttp1RequestHead, ParsedHttp1ResponseHead;
import "http/http1_framing" take Http1BodyPlan, Http1BodyKind, Http1FramingFields, Http1ResponseFraming;
import "http/header" take Headers, Header;
import "http/version" take HttpVersion;
import "http/target" take OriginTarget;
import "http/method" take Method;
import "http/status" take Status;
import "http/body" take EmptyBody;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let request = Http1RequestHead(Method.get,OriginTarget("/"+x,Maybe<string>.none),Headers(Header("Host","example.test")),HttpVersion.http_1_1);
        let response = Http1ResponseHead(Status.ok,Headers(Header("X-N",x)),HttpVersion.http_1_1);
        let contribution = request.host().authority().length()+request.request(EmptyBody())::Head::target.path().length()+response.response(EmptyBody())::Head::headers.int("X-N");
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

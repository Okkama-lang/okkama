module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/semaphore" take Semaphore;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let semaphore = Semaphore(permits: 1 + i % 3);
            let permit = await semaphore.permit();
            let left = semaphore.permits();
            permit.close();
            sum = sum.add((left + semaphore.permits()) % 7);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

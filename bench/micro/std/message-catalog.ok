module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "i18n/catalog" take MessageCatalog, MessageKey, SingularMessage, PluralMessage, PluralForm, FallbackTranslation, MessageEntry;
import "i18n/plural" take PluralNumber, PluralCategory;
import "locale/tag" take Locale;

object Bench {
    has catalog is MessageCatalog;
    has fallback is FallbackTranslation;
    has hello is MessageKey;
    has files is MessageKey;
    has missing is MessageKey;
    Bench() {
        let greeting = MessageKey(context: "", identity: "hello");
        let counted = MessageKey(context: "", identity: "files");
        let quitting = MessageKey(context: "menu", identity: "quit");
        let entries is @MessageEntry = [
            SingularMessage(key: greeting, text: "Hallo"),
            PluralMessage(key: counted, forms: [PluralForm(category: PluralCategory.one, text: "eine Datei"), PluralForm(category: PluralCategory.other, text: "viele Dateien")])
        ];
        let german = MessageCatalog(locale: Locale("de"), entries: entries);
        let base is @MessageEntry = [SingularMessage(key: quitting, text: "Beenden")];
        hello = greeting;
        files = counted;
        missing = quitting;
        catalog = german;
        fallback = FallbackTranslation(primary: german, fallback: MessageCatalog(locale: Locale("de"), entries: base));
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let plural = catalog.plural(files, PluralNumber((i % 3).string()));
        self.run(i + 1, n, acc + (catalog.text(hello).length() + plural.length() + fallback.text(missing).length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

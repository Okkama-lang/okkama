// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "template/compile" take TextTemplate;
import "template/engine" take Template;
import "template/html" take HtmlTemplate;
import "template/model" take TemplateBindings;
import "json" take Json, JsonField;
import "io/buffer" take ByteBuffer;
import "io/text" take Utf8Output;

object Bench {
    has a is Template;
    has b is TextTemplate;
    has c is HtmlTemplate;

    Bench() {
        a = Template("A{{n}}");
        b = TextTemplate("B{{n}}");
        c = HtmlTemplate("<p>{{n}}</p>");
    }

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let buffer = ByteBuffer();
        let output = Utf8Output(origin: buffer.writing());
        let data = Json(JsonField("n", x));
        a.write(data, output);
        b.write(TemplateBindings(["n": x]), output);
        c.write(data, output);
        let result = buffer.content().bytes().reduce(0) -> s, b {
            s + b.int();
        };
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

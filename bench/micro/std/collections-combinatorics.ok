module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "collections/iteration" take Cursor;
import "collections/combinatorics" take CartesianProduct, CombinationsWithReplacement, Permutations;

hidden object Walk<T> {
    has cursor is Cursor<T>;
    Walk(cursor is Cursor<T>) { self.cursor = cursor; }
    count() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + 1);
            at.replace(at.value().successor());
        }
        n.value();
    }
}

// Products, combinations with replacement and permutations of small lists, counted.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 5 + 3;
        let xs is @int = (1..(v + 1)).map() -> x { x; };
        let total = Walk(CartesianProduct(origins: [[1, 2], xs]).cursor()).count()
            + Walk(CombinationsWithReplacement(xs, 2).cursor()).count()
            + Walk(Permutations([1, 2, 3, 4].slice(0, i % 2 + 3)).cursor()).count();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

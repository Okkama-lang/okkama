module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "cli/command" take CliCommand, Option, Flag, Operand, OperandCount;

object Bench {
    has command is CliCommand;
    Bench() {
        command = CliCommand(
            name: "tool",
            summary: "A tool",
            options: [Option(name: "count", short: "c", value: "N", repeated: false, help: "How many")],
            flags: [Flag(name: "verbose", short: "v", help: "Talk more")],
            operands: [Operand(name: "FILE", count: OperandCount.repeated, help: "Inputs")],
            commands: []
        );
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let arguments = if i % 2 == 0 { ["-v", "--count", (i % 50).string(), "a", "b" + i.string()]; } else { ["-c", (i % 50).string(), "x"]; };
        let call = command.invocation(arguments);
        let verbose = if call.flag("verbose") { 1; } else { 0; };
        self.run(i + 1, n, acc + ((call.int("count") else 0) + verbose + call.operands().size()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

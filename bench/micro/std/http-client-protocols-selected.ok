// #244: Выбор разрешённого ALPN с пустым explicit trust store.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/client_protocols" take HttpClientProtocols;
import "http/client_policy" take ClientPolicy;
import "net/tls" take TlsClientPolicy;
import "crypto/x509/trust" take TrustedCertificates;
import "http/version" take HttpVersion;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let selected = if i%2==0 { ""; } else { "http/1.1"; };
        let value = HttpClientProtocols(ClientPolicy(),TlsClientPolicy(TrustedCertificates())).selected(selected);
        let contribution = if value==HttpVersion.http_1_1 { v; } else { 0; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

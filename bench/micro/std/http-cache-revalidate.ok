// #244: http-cache-revalidate; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/cache_memory" take CachedHttpEntry, MemoryHttpCache;
import "http/cache_freshness" take CacheResponseTiming, CacheFreshness;
import "http/cache_validation" take CacheValidation, CacheRequestFreshness;
import "http/message" take Request, Response;
import "http/exchange" take ExchangeDetails, ClientResponse;
import "http/header" take Headers, Header;
import "http/status" take Status;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void {} }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let clock = FixedClock();
        let now = clock.monotonic_instant();
        let timing = CacheResponseTiming(clock.instant(),now,now);
        let endpoint = IpEndpoint(IpAddress("127.0.0.1"),80);
        let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(endpoint,endpoint);
        let details = ExchangeDetails(ends,HttpVersion.http_1_1);
        let request = Request(url:"http://example.test/"+x);
        let fields = Headers(Header("Cache-Control","max-age=600"),Header("ETag", "\""+x+"\""));
        let response = ClientResponse(request,Response(status:Status.ok,headers:fields),details);
        let entry = CachedHttpEntry(request,response,timing,[v.byte()],Headers());

        let validation = CacheValidation(request,entry);
        let update = ClientResponse(validation.request(),Response(status:Status.not_modified,headers:fields),details);
        let refreshed = validation.refreshed(update,timing);
        let contribution = refreshed.bytes()[0].int()+ (if validation.conditional() && CacheRequestFreshness(request,refreshed).usable(now) { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

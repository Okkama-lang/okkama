// #244: Проверка same-origin WebSocket.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/websocket_origin" take SameOriginWebSockets;
import "http/message" take Request;
import "http/header" take Header, Headers;
import "url/value" take ParsedUrl;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let url = "https://site"+x+".test";
        let request = Request(url:url+"/",headers:Headers(Header("Origin",url)));
        let contribution = if SameOriginWebSockets().allowed(request,ParsedUrl(url).parts()) { v; } else { 0; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "collections/iteration" take Cursor;
import "os/environment" take Environment, SearchPath;
import "os/platform" take Platform, Host, OperatingSystem;

hidden object Walk<T> {
    has cursor is Cursor<T>;
    Walk(cursor is Cursor<T>) { self.cursor = cursor; }
    count() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + 1);
            at.replace(at.value().successor());
        }
        n.value();
    }
}

// A PATH of 1..5 entries split, walked and indexed; the operating system and host name read (host-independent checks).
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let count = i % 5 + 1;
        let parts is @string = (0..count).map() -> k { "/opt/p" + k.string() + "/bin" + v.string(); };
        let path = SearchPath(environment: Environment(values: ["PATH": parts.join(":")]));
        let os = Platform().operating_system();
        let total = path.size() + 10 * Walk(path.cursor()).count() + 100 * path.first().string().length() + 1000 * path.last().string().length()
            + 10000 * path.item(count - 1).string().length() + (if os == OperatingSystem.linux || os == OperatingSystem.macos { 1000000; } else { 1000000; })
            + (if Host().name().length() > 0 { 10000000; } else { 10000000; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "toml/value" take TomlArray, TomlTable, TomlMember, TomlInteger, TomlString, TomlLocalDate, TomlInfinity;

// TOML values built in code: an array, a table, a local date and an infinity written back.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let table = TomlTable(TomlMember("a", TomlInteger(v)), TomlMember("b", TomlString(x)));
        let total = TomlArray(TomlInteger(1), TomlInteger(v)).values().size() + table.int("a")
            + TomlLocalDate(year: 2000 + v, month: v, day: v).string().length()
            + TomlInfinity(v % 2 == 0).string().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

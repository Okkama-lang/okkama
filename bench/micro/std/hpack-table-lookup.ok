// #244: hpack-table-lookup; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/hpack_tables" take HpackField, HpackStaticTable, HpackDynamicTable, HpackTableBound, HpackLookup;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let fixed = HpackStaticTable();
        let field = HpackField("x-n",x);
        let dynamic = HpackDynamicTable(128).added(field);
        dynamic = dynamic.resized(64);
        HpackTableBound(64+v);
        let lookup = HpackLookup(fixed,dynamic,62);
        let contribution = lookup.field().value().length()+dynamic.field(1).size()+fixed.named(":method")+fixed.exact(HpackField(":method","GET"))+fixed.field(2).value().length();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

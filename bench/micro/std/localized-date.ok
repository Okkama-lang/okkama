module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/date_time" take LocalizedDate, DateStyle;
import "locale/tag" take Locale;
import "time/date" take Date;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let date = Date(year: 2000 + i % 30, month: 1 + i % 12, day: 1 + i % 28);
        let text = LocalizedDate(origin: date, locale: Locale("en", "US"), style: DateStyle.long).string();
        self.run(i + 1, n, acc + (text.length() + text.characters()[0].code()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

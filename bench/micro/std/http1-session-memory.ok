// #244: http1-session-memory; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/http1_head" take Http1Limits, Http1RequestHead, Http1ResponseHead, ParsedHttp1RequestHead, ParsedHttp1ResponseHead;
import "http/http1_framing" take Http1BodyPlan, Http1BodyKind, Http1FramingFields, Http1ResponseFraming;
import "http/header" take Headers, Header;
import "http/version" take HttpVersion;
import "http/target" take OriginTarget;
import "http/method" take Method;
import "http/status" take Status;
import "http/body" take EmptyBody;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/http1_session" take Http1Session;
import "http/message" take Request;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;
import "http/conversation" take Http1Conversation;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void {} }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput(Utf8Encoded("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n").bytes());
            let sink = Sink();
            let session = Http1Session(input,sink,input,Http1Limits(),Duration(seconds:1),FixedClock());
            let conversation = Http1Conversation(session);
            let result = await conversation.exchange(Request(url:"http://example.test/"+x));
            let contribution = result.response()::Head::code+sink.checksum();
            session.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

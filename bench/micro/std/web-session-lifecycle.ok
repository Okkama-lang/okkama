// #244: web-session-lifecycle; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/request_context" take HttpRequestContext;
import "http/exchange" take ExchangeDetails;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "async/cancellation" take Cancellation;
import "web/session" take Sessions, SessionValue, MemorySessions, CsrfProtection;
import "web/request" take WebRequest;
import "web/reply" take TextReply;
import "http/message" take Request, Responding;
import "http/header" take Headers, Header;
import "http/method" take Method;
import "random/source" take Randomizing;
import "crypto/secret" take SecretBytes;
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void {} }
object Context { Context(); value() is HttpRequestContext {
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(local:IpEndpoint(IpAddress("127.0.0.1"),80),remote:IpEndpoint(IpAddress("127.0.0.1"),50000));
    HttpRequestContext(details:ExchangeDetails(endpoints:ends,version:HttpVersion.http_1_1),cancellation:Cancellation().cancelling());
} }
object Endpoint { Endpoint(); async answer(request is WebRequest) is Responding { TextReply("ok"); } }
object FixedRandom does Randomizing { has value is int; FixedRandom(value is int) { self.value=value; } integer(start is int,stop is int) is int { start; } float() is float { 0.0; } bytes(size is int) is @byte { (0..size).map() -> index { value.byte(); }; } }

object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let sessions = Sessions(key:SecretBytes([1.byte(),2.byte(),3.byte(),4.byte(),5.byte(),6.byte(),7.byte(),8.byte(),9.byte(),10.byte(),11.byte(),12.byte(),13.byte(),14.byte(),15.byte(),16.byte()]),store:MemorySessions(FixedClock()),random:FixedRandom(v));
            let started = await sessions.started(SessionValue("n",x));
            let pair = started.cookie().header().value().split(";")[0];
            let request = WebRequest(Request(url:"https://example.test/",method:Method.post,headers:Headers(Header("Cookie",pair),Header("X-CSRF-Token",started.csrf()))),Context().value());
            let found = await sessions.found(request);
            let session = await sessions.session(request);
            let answer = await CsrfProtection(sessions).around(request,Endpoint().answer);
            let ended = await sessions.ended(request);
            let contribution = session.text("n").length()+session.id().length()+session.csrf().length()+answer.response()::Head::code+ended.header().value().length();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

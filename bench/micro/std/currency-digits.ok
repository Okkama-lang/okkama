module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/currency" take Currency;

object Bench {
    has codes is @string;
    Bench() {
        codes = ["USD", "JPY", "BHD", "EUR", "KWD", "CLP", "GBP", "TND"];
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let currency = Currency(code: codes[i % 8]);
        self.run(i + 1, n, acc + (currency.digits() + currency.code().length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

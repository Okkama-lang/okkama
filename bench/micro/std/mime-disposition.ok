// Deterministic composite iteration; see oracles.py for the independent checksum.
// ContentDisposition.new(kind is string, parameters is MimeParameters) is ContentDisposition | ContentDisposition.new(origin is string) is ContentDisposition | ContentDisposition.new(origin is string, maximum_parameters is int, maximum_bytes is int) is ContentDisposition
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mime/disposition" take ContentDisposition;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let value = ContentDisposition("attachment; filename=file" + i.string() + ".txt");
        let contribution = value.string().length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/process" take Exit, ExitKind;

object Bench {
    has kinds is @ExitKind;
    Bench() {
        kinds = [ExitKind.exited, ExitKind.interrupted, ExitKind.terminated, ExitKind.killed, ExitKind.other];
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let exit = Exit(kind: kinds[i % 5], code: i % 3);
        let success = if exit.success() { 2; } else { 0; };
        let code = if i % 5 == 0 { exit.code(); } else { 0; };
        self.run(i + 1, n, acc + (code + success) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

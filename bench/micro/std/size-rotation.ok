module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/rotation" take SizeRotating;
import "time/clock" take Instant;
import "time/duration" take Duration;

object Bench {
    has opened is Instant;
    Bench() {
        opened = Instant(origin: Duration(seconds: 1700000000.rat()));
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let rotation = SizeRotating(limit: 1000);
        let size = (i * 37) % 2000 + 1 - ((i * 37) % 2000) % 2;
        let needed = if rotation.needed(size: size, opened: opened, now: opened) { 1; } else { 0; };
        self.run(i + 1, n, acc + (needed + size % 5) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// Deterministic composite iteration; see oracles.py for the independent checksum.
// HtmlTemplateLibrary.new() is HtmlTemplateLibrary | HtmlTemplateLibrary.new(templates is @string:HtmlTemplate) is HtmlTemplateLibrary | HtmlTemplateLibrary.new(values is Sequencing<NamedHtmlTemplate>) is HtmlTemplateLibrary | HtmlTemplateLibrary.new(values is Sequencing<NamedHtmlTemplate>, maximum_templates is int) is HtmlTemplateLibrary | HtmlTemplateLibrary.new(values... is NamedHtmlTemplate) is HtmlTemplateLibrary
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "template/html_library" take HtmlTemplateLibrary, NamedHtmlTemplate;
import "template/html" take HtmlTemplate;


object Bench {
    has template is HtmlTemplate;
    Bench() { template = HtmlTemplate("<p>{{.}}</p>"); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let name = "card" + i.string();
        let library = HtmlTemplateLibrary(NamedHtmlTemplate(name, template));
        let contribution = library.template(name).source().length() + name.length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

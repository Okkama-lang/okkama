// #244: pop3-reply-decoder; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "encoding/utf" take Utf8Encoded;
import "mail/pop3_reply" take PopReply, PopReplyDecoder, PopReplyLimits, PopReplyMode;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let bounds = PopReplyLimits(status_bytes:128,line_bytes:128,body_bytes:256,wire_bytes:512,lines:8);
        let decoder = PopReplyDecoder(PopReplyMode.multiline,bounds).fed(Utf8Encoded("+OK done\r\n.."+x+"\r\n.\r\nTAIL").bytes());
        let reply = decoder.reply();
        let ended = decoder.finish();
        let copy = PopReply(reply::Reply::successful,reply::Reply::text,reply::Reply::body,reply::Reply::lines,reply::Reply::multiline);
        let contribution = copy::Reply::body.size()+ended::Reply::body.size()+decoder.remainder().size();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

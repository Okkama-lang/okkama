module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/secret" take SecretBytes;
import "digest/blake2" take Blake2s, Blake2sMac;

// The first hex digit of a digest.
hidden object First {
    First();
    digit(hex is string) is int {
        "0123456789abcdef".find(hex.slice(0, 1)) else 99;
    }
}

// BLAKE2s, plain (32 bytes) and keyed, of "a<x>" continued by "b".
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let x = (i % 251 + 1).string();
        let text = "a" + x;
        let f = First();
        let key = SecretBytes("key" + x);
        let total = f.digit(Blake2s(32, text).state("b").hex()) + f.digit(Blake2sMac(key, text).state("b").hex());
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "cli/arguments" take ProcessArguments;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let raw is @@byte = [[byte(97), byte(98)], [byte(45), byte(45), byte(110), byte(48 + i % 10)], [byte(195), byte(169)]];
        let arguments = ProcessArguments(arguments: raw);
        let strings = arguments.strings();
        self.run(i + 1, n, acc + (arguments.size() + strings[1].length() + strings[2].length() + arguments.last().size()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

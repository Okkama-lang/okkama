// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "config/source" take SettingSource, SettingSourceKind;
import "config/key" take SettingKey;
import "config/document" take JsonSettings, TomlSettings;
import "json" take ParsedJson;
import "toml/parse" take ParsedToml;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let source = SettingSource(SettingSourceKind.document, x);
        let key = SettingKey("n");
        let a = JsonSettings(ParsedJson("{\"n\":" + x + "}").root(), source);
        let b = TomlSettings(ParsedToml("n = " + x + "\n").root(), source);
        let result = a.entry(key).values().first().length() + b.entry(key).values().first().length();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

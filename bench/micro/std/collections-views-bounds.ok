module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "collections/iteration" take Cursor;
import "collections/views" take Dropped, DroppedWhile, Sliced, Taken, TakenWhile;

hidden object Sum {
    has cursor is Cursor<int>;
    Sum(cursor is Cursor<int>) { self.cursor = cursor; }
    total() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + at.value().item());
            at.replace(at.value().successor());
        }
        n.value();
    }
}

// Views that cut 1..=v by count or by condition, each cursor walked once.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 5 + 3;
        let xs is @int = (1..(v + 1)).map() -> x { x; };
        let total = Sum(Dropped(xs, 2).cursor()).total()
            + Sum(DroppedWhile(origin: xs, condition: (x is int) is bool { x < 3; }).cursor()).total()
            + Sum(Sliced(xs, 1, v, 2).cursor()).total()
            + Sum(Taken(xs, 2).cursor()).total()
            + Sum(TakenWhile(origin: xs, condition: (x is int) is bool { x < 3; }).cursor()).total();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http-header-transforms; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/header" take Headers, Header, HeaderName, HeadersWithout, ReplacedHeader, Http2Headers;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let headers = Headers(Header("X-N",x),Header("X-Old","gone"));
        let clean = HeadersWithout(headers,[HeaderName("X-Old")]).headers();
        let replaced = ReplacedHeader(clean,Header("X-N",(v+1).string())).headers();
        let h2 = Http2Headers(replaced,true).headers();
        let contribution = h2.int("x-n")+h2.entries().size();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

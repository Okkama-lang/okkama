module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/binary" take IntegerBytes, Binary, Signedness;
import "encoding/utf" take ByteOrder;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let value = (i * 7919) % 2000000 - 1000000;
        let bytes = IntegerBytes(value: value, size: 4, signedness: Signedness.signed, order: ByteOrder.big).bytes();
        let back = Binary(bytes: bytes, order: ByteOrder.big).int(Signedness.signed);
        let same = if back == value { 1; } else { 0; };
        self.run(i + 1, n, acc + (bytes[0].int() + bytes[3].int() + same) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

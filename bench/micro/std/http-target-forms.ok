// #244: http-target-forms; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/target" take AbsoluteTarget, OriginTarget, AuthorityTarget, RequestTargetMethod, RequestTargetSnapshot;
import "url/value" take ParsedUrl;
import "http/method" take Method;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let absolute = AbsoluteTarget(ParsedUrl("http://example.test/a"+x+"?n="+x).parts());
        let origin = OriginTarget(path:"/a"+x,query:Maybe.some("n="+x));
        let authority = AuthorityTarget(ParsedUrl("//example.test:"+(8000+v).string()).parts());
        let snapshot = RequestTargetSnapshot(origin).target();
        let contribution = absolute.path().length()+(absolute.query() else "").length()+origin.string().length()+snapshot.string().length()+authority.authority().authority().length()
         + (if RequestTargetMethod(Method.get,origin.kind()).valid() { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

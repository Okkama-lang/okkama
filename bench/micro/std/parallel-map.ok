module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "parallel/map" take ParallelMapped;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let results = await ParallelMapped(origins: [i, i + 1, i + 2, i + 3], action: Squarer(offset: 1).of, workers: 2).results();
            sum = sum.add((results.first() + results.last()) % 7);
        }
        sum.total();
    }
}

object Squarer {
    has offset is int;
    Squarer(:offset);
    of(value is int) is int { value * value + offset; }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

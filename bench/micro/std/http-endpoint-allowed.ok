// #244: Endpoint policy: loopback IPv4 без DNS.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/endpoint" take LoopbackEndpoints;
import "url/value" take ParsedUrl;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let url = ParsedUrl("http://example.test/").parts();
        let endpoint = IpEndpoint(IpAddress("127.0.0."+x),80);
        let contribution = if LoopbackEndpoints().allowed(url,endpoint) { v; } else { 0; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

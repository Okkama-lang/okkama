// #244: web-reply-empty; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "web/reply" take RedirectReply, NoContentReply;
import "http/header" take Headers;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let redirected = RedirectReply("/a"+x).response();
        let empty = NoContentReply().response();
        let contribution = redirected::Head::code + empty::Head::code + redirected::Head::headers.text("Location").length();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

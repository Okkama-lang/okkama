module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/environment" take Environment;
import "fs/temp" take TemporaryDirectory;
import "fs/file" take File, FileMode, SeekOrigin;
import "fs/entry" take FileEntry;

// A binary file written, flushed and synced; reopened, seeked, read by byte and bytes, truncated.
object Bench {
    has parent is Environment;
    Bench() {
        parent = Environment();
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let scratch = TemporaryDirectory(parent: parent.temporary(), prefix: "okkama-fs-");
        let root = scratch.path();
        let path = root.child("b.bin");
        let data is @byte = (0..(i % 50 + 10)).map() -> k { byte((k + i) % 256); };
        let file = File(path: path, mode: FileMode.writing);
        let out = file.binary();
        out.write(data);
        out.flush();
        out.sync();
        file.close();
        let again = File(path: path, mode: FileMode.reading_and_writing);
        let bytes = again.binary();
        bytes.seek(3, SeekOrigin.start);
        let third = bytes.byte();
        let at = bytes.offset();
        let rest = bytes.bytes(5);
        bytes.truncate(8);
        again.close();
        let size = FileEntry(path).stat()::Shape::size;
        scratch.close();
        let total = third.int() + 1000 * at + 10000 * rest[4].int() + 10000000 * size;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

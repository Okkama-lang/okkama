module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "url/value" take ParsedUrl, UrlComponentText;
import "url/percent" take UrlComponent;
import "url/query" take QueryParameters, QueryParameter;

// URL parts joined, given a query (appended and replaced), resolved; a component text checked.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let base = ParsedUrl("https://user@Example.org:8443/a/b/../c?q=" + x + "#top").parts();
        let query = QueryParameters(QueryParameter(name: "k", value: x), QueryParameter(name: "on", value: "true"),
            QueryParameter(name: "k", value: "2"));
        let total = base.joined("d", "e" + x).string().length() + base.query_appended(query).string().length()
            + base.query_replaced(query).string().length() + base.resolved(ParsedUrl("../z" + x).parts()).string().length()
            + UrlComponentText("a%20b/" + x, UrlComponent.path).string().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/single_byte" take Latin1Decoded;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let text = Latin1Decoded(origin: [byte(99), byte(97), byte(102), byte(i % 256)]).string();
        self.run(i + 1, n, acc + (text.length() + text.characters()[3].code()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

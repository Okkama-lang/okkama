module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mime/media_type" take MediaTypeLimits, MimeCharacter, MimeItems, MimeParameter, MimeParameters, MediaType, MimeLimitExceeded;

// MIME parameters built, probed and written with quoting; token characters; item lists; media types parsed under tight limits.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let params = MimeParameters(MimeParameter(name: "charset", value: "utf-8"), MimeParameter(name: "name", value: "a b" + x), MimeParameter(name: "q", value: x));
        let empty is MimeItems<int> = MimeItems();
        let items = empty.following(v).following(2);
        let chars is @string = ["a", " ", "(", "~", "/", "Z"];
        let limited = try { MediaType("text/plain; a=1; b=" + x, MediaTypeLimits(parameters: i % 3, bytes: 100)).parameters().entries().size(); } catch e is MimeLimitExceeded { 9; };
        let total = (if params.membership(["charset", "zz"][i % 2]) { 1; } else { 0; }) + 10 * params.string().length()
            + 1000 * (if MimeCharacter(chars[i % 6]).token() { 1; } else { 0; }) + 10000 * items.entries()[0] + 100000 * limited;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

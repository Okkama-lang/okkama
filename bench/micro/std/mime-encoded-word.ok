// Deterministic composite iteration; see oracles.py for the independent checksum.
// EncodedWord.new(origin is string) is EncodedWord | EncodedWord.new(origin is string, charset is string) is EncodedWord | EncodedWord.new(origin is string, charset is string, maximum_bytes is int) is EncodedWord
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mime/word" take EncodedWord;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let contribution = EncodedWord("café " + i.string()).string().length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/record" take LogRecord, LogContext;
import "logging/level" take LogLevel;
import "logging/name" take LogName;
import "logging/field" take LogFields;
import "time/clock" take Instant;
import "time/duration" take Duration;
import "json" take JsonField, Json;
import "logging/logger" take Logger;
import "logging/write" take CollectedLogs;
import "logging/queue" take SynchronousLogDelivery;
import "logging/rotation" take IntervalRotating;
import "time/zone" take FixedZone;
import "db/error" take DbClosed;

// A logger at debug and critical (with a cause); synchronous delivery; an hourly rotation rule checked and suffixed.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let levels is @LogLevel = [LogLevel.debug, LogLevel.info, LogLevel.warning, LogLevel.error, LogLevel.critical];
        let level = levels[i % 5];
        let record = LogRecord(occurred: Instant(origin: Duration(seconds: 1700000000 + i)), level: level, message: "m" + x,
            context: LogContext(name: LogName("app", ["db", "web"][i % 2]), fields: LogFields(JsonField("password", "s" + x), JsonField("id", v)), process: 42));
        let collected = CollectedLogs();
        let logger = Logger(name: "svc", destination: collected, level: levels[i % 3]);
        logger.debug("d" + x, JsonField("k", v));
        logger.critical("c", DbClosed.closed, JsonField("k", v));
        let delivered = await SynchronousLogDelivery(collected).deliver(record);
        let rule = IntervalRotating(interval: Duration(hours: 1), zone: FixedZone(name: "Z", offset: Duration(seconds: 0)));
        let opened = Instant(origin: Duration(seconds: 1700000000));
        let total = collected.size() + 10 * delivered + (if rule.needed(0, opened, Instant(origin: Duration(seconds: 1700000000 + i * 600))) { 100; } else { 0; })
            + 1000 * rule.suffix(opened, v).length();
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/platform" take Platform, Host;
import "os/directory" take WorkingDirectory;
import "fs/path" take Path;
import "encoding/utf" take ByteOrder;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let little = if Platform().byte_order() == ByteOrder.little { 1; } else { 0; };
        let cpus = if Host().cpu_count() > 0 { 1; } else { 0; };
        let absolute = if WorkingDirectory().path().absolute() { 1; } else { 0; };
        self.run(i + 1, n, acc + (little + 2 * cpus + absolute + i % 3) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http-sse-body; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/sse" take ServerEvent, EventBody, EventStreamHeaders;
import "web/reply" take EventsReply;
import "async/channel" take Channel;

object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let channel is Channel<ServerEvent> = Channel(1);
            await channel.sending().send(ServerEvent(x));
            let reading = EventBody(channel.receiving()).reading();
            let bytes = await reading.bytes(128);
            reading.close();
            let second is Channel<ServerEvent> = Channel(1);
            let reply = EventsReply(second.receiving()).response();
            let contribution = bytes.size()+EventStreamHeaders().headers().entries().size()+reply::Head::code;
            reply.body().reading().close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

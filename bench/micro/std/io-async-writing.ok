// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "async/atomic" take Atomic;
import "io/buffer" take ByteBuffer;
import "io/stream" take AsyncReading, AsyncWriting, ByteSource;
import "io/decorators" take BufferedAsyncWriting;

object MemoryReading does AsyncReading {
    has buffer is ByteBuffer;

    MemoryReading(data is @byte) {
        buffer = ByteBuffer(data);
    }

    async bytes(limit is int) is @byte {
        buffer.reading().bytes(limit);
    }
}

object MemoryWriting does AsyncWriting {
    has buffer is ByteBuffer;

    MemoryWriting(:buffer);

    async write(bytes is @byte) is AsyncWriting {
        buffer.writing().write(bytes);
        self;
    }

    async write(source is ByteSource) is AsyncWriting {
        buffer.writing().write(source);
        self;
    }

    async flush() is void {
        buffer.writing().flush();
    }
}

object Bench {
    Bench();

    async run(n is int) is int {
        let total = Atomic(0);
        for 0..n -> i {
            let v = i % 23 + 1;
            let buffer = ByteBuffer();
            let output = BufferedAsyncWriting(MemoryWriting(buffer: buffer), 4);
            await output.write([byte(v), byte(2)]);
            let before = output.buffered();
            await output.flush();
            let result = before + output.buffered() + buffer.content().bytes().reduce(0) -> s, b {
                s + b.int();
            };
            total.replace(total.value() + result);
        }
        total.value();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

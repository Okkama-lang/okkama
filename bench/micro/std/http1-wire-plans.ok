// #244: http1-wire-plans; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/http1_head" take Http1Limits, Http1RequestHead, Http1ResponseHead, ParsedHttp1RequestHead, ParsedHttp1ResponseHead;
import "http/http1_framing" take Http1BodyPlan, Http1BodyKind, Http1FramingFields, Http1ResponseFraming;
import "http/header" take Headers, Header;
import "http/version" take HttpVersion;
import "http/target" take OriginTarget;
import "http/method" take Method;
import "http/status" take Status;
import "http/body" take EmptyBody;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/http1_writing" take Http1RequestHeadWriting, Http1ResponseHeadWriting, Http1RequestHeadWire, Http1ResponseHeadWire;
import "http/http1_message_writing" take Http1ResponseWriting;
import "http/message" take Response;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let request = Http1RequestHead(Method.get,OriginTarget("/"+x,Maybe<string>.none),Headers(Header("Host","example.test")),HttpVersion.http_1_1);
            let response = Http1ResponseHead(Status.no_content,Headers(),HttpVersion.http_1_1);
            let limits = Http1Limits();
            let one = Http1RequestHeadWire(request,limits);
            let two = Http1ResponseHeadWire(response,Method.get,limits);
            let sink = Sink();
            await Http1RequestHeadWriting(sink,request,limits).output();
            await Http1ResponseHeadWriting(sink,response,Method.get,limits).output();
            let writing = Http1ResponseWriting(sink,Response(status:Status.no_content),Method.get);
            await writing.output();
            let contribution = one.plan().length()+two.plan().length()+two.bytes().size()+writing.plan().length()+sink.checksum();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "compression/deflate" take DeflateCompressed, DeflateDecompressed;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let bytes = [byte(i % 256), byte(1), byte(2), byte(3), byte(4), byte(5), byte(6), byte(7)];
        let packed = DeflateCompressed(origin: bytes, level: 6).bytes();
        let unpacked = DeflateDecompressed(origin: packed, limit: 1048576).bytes();
        self.run(i + 1, n, acc + (unpacked[0].int() + unpacked.size()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

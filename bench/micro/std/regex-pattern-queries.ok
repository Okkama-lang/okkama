module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "regex/pattern" take Regex;

// "k<v>=<v><v> name=n<v>": a pattern with named groups found, listed, split and replaced.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let text = "k" + x + "=" + x + x + " name=n" + x;
        let pair = Regex("(?<key>[a-z]+)(?<id>\\d)?=(?<num>\\d+)");
        let total = (if pair.found(text) { 1; } else { 0; }) + pair.all(text).size() + pair.group_count()
            + pair.group_names().size() + pair.parts(text).size() + pair.replaced(origin: text, by: "#").length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

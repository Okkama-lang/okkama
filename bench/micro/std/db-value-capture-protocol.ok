module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/value" take DbValueCapture, DbValueKind, DbInteger, DbNativeValue, ObservedDbValue, InvalidDbValue, WrongDbValue;

// The position of a kind in DbValueKind.
hidden object Code {
    Code();
    of(kind is DbValueKind) is int {
        match kind {
            case DbValueKind.null_value { 0; }
            case DbValueKind.boolean { 1; }
            case DbValueKind.integer { 2; }
            case DbValueKind.floating { 3; }
            case DbValueKind.decimal { 4; }
            case DbValueKind.text { 5; }
            case DbValueKind.bytes { 6; }
        }
    }
}

// The print protocol driven by hand: one event, its cell, sealing, kind checks and the two protocol errors.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let cell = ObservedDbValue(DbInteger(v)).state();
        let c = DbValueCapture(DbValueKind.integer);
        let before = if c.completed() { 1; } else { 0; };
        c.emit(DbValueKind.integer);
        c.published(cell);
        c.complete();
        c.require(DbValueKind.integer);
        let sealed = (if c.completed() { 8; } else { 0; }) + Code().of(c.cell().kind()) + 8 * Code().of(DbNativeValue(c.state()).kind());
        let wrong = try { c.require(DbValueKind.text); 0; } catch e is WrongDbValue { 4; };
        let again = try { c.emit(DbValueKind.integer); 0; } catch e is InvalidDbValue { 2; };
        let total = before + sealed + wrong + again + v;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/internal/iana" take IanaLanguages;
import "locale/internal/currencies" take CldrCurrencies, CurrencySymbolLetters;
import "locale/internal/numbers" take CldrNumbers;

// Pinned tables read directly: IANA grandfathered tags and extlang prefixes, currency profiles, patterns and symbol letters, number profiles and compact forms.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let iana = IanaLanguages();
        let currencies = CldrCurrencies();
        let numbers = CldrNumbers();
        let tags is @string = ["en", "de", "ar", "zz-Unknown"];
        let profile = currencies.profile(tags[i % 4], "latn");
        let total = (if iana.grandfathered(["i-klingon", "en-US", "zh-min-nan", "en"][i % 4]) { 1; } else { 0; })
            + 2 * iana.extlang_prefix(["yue", "cmn", "abc", "zsm"][i % 4]).length()
            + (if profile >= 0 { (if currencies.fields(profile).size() > 0 { 10; } else { 0; }) + (if currencies.compact(profile).size() > 0 { 20; } else { 0; }); } else { 300; })
            + (if CurrencySymbolLetters().membership(["A", "$", "AB", "z"][i % 4]) { 400; } else { 0; })
            + (if numbers.profile(i % 3).size() > 0 { 1000; } else { 0; }) + (if numbers.compact(i % 3, i % 2 == 0).size() > 0 { 2000; } else { 0; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

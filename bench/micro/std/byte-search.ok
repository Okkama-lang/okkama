module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/bytes" take ByteSearch;

object Bench {
    has source is @byte;
    Bench() {
        source = (0..512).map() -> k { byte((k * 31 + 7) % 251); };
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let start = i % 300;
        let pattern = [source[start + 40], source[start + 41], source[start + 42]];
        self.run(i + 1, n, acc + ByteSearch(source: source, pattern: pattern).from(start) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "encoding/base32" take Base32Decoded, Base32Encoded;
import "encoding/base64" take Base64Decoded, Base64Encoded;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let data = [byte(v), byte(128), byte(255)];
        let a = Base32Decoded(Base32Encoded(data).string()).bytes();
        let b = Base64Decoded(Base64Encoded(data).string()).bytes();
        let result = a.reduce(0) -> s, b {
            s + b.int();
        } + b.reduce(0) -> s, b {
            s + b.int();
        };
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

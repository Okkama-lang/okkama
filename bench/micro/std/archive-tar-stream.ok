// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "archive/entry" take ArchiveFile;
import "archive/metadata" take ArchiveMetadata, ArchiveOwnership, ArchiveModificationFromEpoch;
import "archive/path" take ArchivePath;
import "archive/limits" take ArchiveLimits;
import "archive/stream" take EndOfArchive;
import "archive/tar" take TarWriting, TarReading;
import "io/buffer" take ByteBuffer;
import "fs/stat" take PermissionMode;

object Bench {
    has mode is PermissionMode;

    Bench() {
        mode = PermissionMode(420);
    }

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let metadata = ArchiveMetadata(
            mode: mode,
            modified: ArchiveModificationFromEpoch(0.rat()).local_date_time(),
            ownership: ArchiveOwnership("u", "g", v, 2),
            comment: ""
        );
        let buffer = ByteBuffer();
        let writer = TarWriting(buffer.writing());
        writer.write(ArchiveFile(path: ArchivePath(x), metadata: metadata, text: x));
        writer.finish();
        writer.close();
        let reader = TarReading(buffer.reading(), ArchiveLimits(2, 64, 128, 32));
        let name = reader.entry().path().string();
        let end = try {
            reader.entry();
            0;
        }
        catch e is EndOfArchive {
            1;
        };
        let done = if reader.finished() {
            1;
        }
        else {
            0;
        };
        reader.close();
        let result = name.length() + end + done + (if reader.closed() {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

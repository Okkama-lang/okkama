// #244: Закрытие sending slot.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/http2_sending" take Http2SendingSlot;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = Http2SendingSlot(v,65535);
        value.close();
        let contribution = if value.closed() { value.stream(); } else { 0; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http-negotiation-media; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/negotiation" take MediaRange, MediaMatch, MediaSpecificity, MediaNegotiationLimits, AcceptedMediaTypes;
import "http/media_type" take HttpMediaType;
import "compare" take Order;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let q = "0."+(1000+v).string().slice(1,4);
        let range = MediaRange("text/plain;q="+q);
        let media = HttpMediaType("text/plain");
        let matched = MediaMatch();
        matched = matched.following(range,v);
        let exact = MediaSpecificity(2,0);
        let accepted = AcceptedMediaTypes("text/plain;q="+q,MediaNegotiationLimits(bytes:128,entries:4,parameters:4,available:4));
        let contribution = (accepted.quality(media).weight()*1000.rat()).int() + (matched.quality().weight()*1000.rat()).int()
         + accepted.preference([media]).string().length()+accepted.string().length()+range.string().length()
         + (if range.matches(media) && matched.specificity().order(exact)==Order.equal { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: Асинхронный HTTP/1 reader на памяти.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/http1_reading" take Http1HeadRead, Http1RequestHeadReading;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;



object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput(Utf8Encoded("GET /a"+x+" HTTP/1.1\r\nHost: example.test\r\n\r\n").bytes());
            let read = await Http1RequestHeadReading(input).head();
            let contribution = read.consumed();
            input.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

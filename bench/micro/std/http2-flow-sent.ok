// #244: Flow-control списание window.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/http2_flow" take Http2FlowWindow;
import "http/internal/http2_frame" take Http2FaultScope;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let contribution = Http2FlowWindow(Http2FaultScope.stream,1,65535).sent(v).remaining();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: web-json-optionals; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "web/request" take RequestJson;
import "json" take ParsedJson;
import "math/decimal" take Decimal;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let j = RequestJson(ParsedJson("{\"n\":"+x+",\"s\":\"a"+x+"\",\"b\":true,\"a\":["+x+"]}").root());
        let contribution = j.optional("n").int(0) + j.optional("n").number(Decimal(0)).rat().int()
         + j.optional("s").text("").length() + j.optional("a").items().size()
         + j.optional("n").node().int() + (if j.optional("b").boolean(false) { 1; } else { 0; })
         + j.optional("absent").int(v);
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

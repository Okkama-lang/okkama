module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/lock" take Lock;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let lock = Lock();
            let guard = await lock.guard();
            let held = if lock.locked() { 1; } else { 0; };
            guard.close();
            let released = if lock.locked() { 0; } else { 2; };
            sum = sum.add((held + released + i % 2) % 7);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

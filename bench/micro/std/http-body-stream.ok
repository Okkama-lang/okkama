// #244: http-body-stream; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/body" take ByteBodyInput, StreamBodyReading, OneShotBody;
import "http/header" take Headers, Header;

object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput([v.byte(),(v+1).byte()]);
            let first = await input.bytes(1);
            let stream = StreamBodyReading(input,input,Headers(Header("X-End",x)));
            let body = OneShotBody(stream);
            let reading = body.reading();
            let rest = await stream.bytes(8);
            let end = await stream.bytes(8);
            let contribution = first[0].int()+rest[0].int()+end.size()+stream.trailers().int("X-End");
            stream.close();
            stream.abort();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

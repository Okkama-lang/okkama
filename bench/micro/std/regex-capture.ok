// Deterministic composite iteration; see oracles.py for the independent checksum.
// FirstRegexMatch.new(origin is string, regex is Regex) is FirstRegexMatch | FirstRegexMatch.new(origin is string, regex is Regex, range is RegexRange) is FirstRegexMatch
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "regex/pattern" take Regex;
import "regex/search" take FirstRegexMatch;
import "regex/match" take RegexCapture;


object Bench {
    has pattern is Regex;
    Bench() { pattern = Regex("id=(\\d+)"); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let found = FirstRegexMatch("id=" + i.string(), pattern);
        let contribution = found.capture(1).text().length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

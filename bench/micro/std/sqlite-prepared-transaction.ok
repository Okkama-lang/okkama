module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory;
import "db/value" take DbInteger;
import "db/transaction" take TransactionOptions;

// A transaction that also prepares: a bound statement, a prepared one, a query; committed or rolled back in turn.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let db = await SqliteMemory().connection();
        await db.execution("CREATE TABLE t(x INTEGER)");
        let tx = await db.prepared_transaction(TransactionOptions());
        await tx.execution("INSERT INTO t(x) VALUES (?)", DbInteger(v));
        let insert = await tx.prepared("INSERT INTO t(x) VALUES (?)");
        await insert.execution(DbInteger(7));
        insert.close();
        let inside = await tx.query("SELECT SUM(x) AS s FROM t").all(1);
        if i % 2 == 0 { await tx.commit(); } else { await tx.rollback(); }
        let after = await db.query("SELECT COUNT(*) AS c FROM t").all(1);
        db.close();
        let total = inside[0].int("s") + 100 * after[0].int("c");
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: HTTP/2 client preface и SETTINGS ACK на памяти.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/http2_preface" take Http2ClientPreface;
import "http/body" take ByteBodyInput;
import "http/http2_settings" take Http2Settings;
import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader;
import "http/internal/http2_settings" take Http2PeerSettings;
import "async/atomic" take Atomic;
import "io/stream" take AsyncWriting, ByteSource;


object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let bytes = Http2Frame(Http2FrameHeader(byte(4),byte(0),0,6),[byte(0),byte(4),byte(0),byte(0),byte(0),byte(v)]).bytes();
            let input = ByteBodyInput(bytes);
            let peer = await Http2ClientPreface(input,Sink(),Http2Settings()).settings();
            let contribution = peer.initial_window();
            input.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

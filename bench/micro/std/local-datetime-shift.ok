// Deterministic composite iteration; see oracles.py for the independent checksum.
// LocalDateTime.plus(duration is Duration) is LocalDateTime
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "time/local_datetime" take LocalDateTime;
import "time/date" take Date;
import "time/day" take TimeOfDay;
import "time/duration" take Duration;


object Bench {
    has epoch is LocalDateTime;
    Bench() { epoch = LocalDateTime(Date(2026, 11, 22), TimeOfDay(23, 59, 0, 0)); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let contribution = epoch.plus(Duration(seconds: (i % 100000).rat())).time()::Clock::second;
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http1-body-remainder; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/http1_head" take Http1Limits, Http1RequestHead, Http1ResponseHead, ParsedHttp1RequestHead, ParsedHttp1ResponseHead;
import "http/http1_framing" take Http1BodyPlan, Http1BodyKind, Http1FramingFields, Http1ResponseFraming;
import "http/header" take Headers, Header;
import "http/version" take HttpVersion;
import "http/target" take OriginTarget;
import "http/method" take Method;
import "http/status" take Status;
import "http/body" take EmptyBody;
import "http/body" take ByteBodyInput;
import "http/http1_body" take Http1BodyReading, Http1IncomingBody;
import "encoding/utf" take Utf8Encoded;

object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput([]);
            let body = Http1BodyReading(input,input,Http1BodyPlan(Http1BodyKind.chunked,0,true),Utf8Encoded("1\r\n"+x.slice(0,1)+"\r\n0\r\nX-N: "+x+"\r\n\r\nTAIL").bytes(),Headers());
            let incoming = Http1IncomingBody(body);
            let reading = incoming.reading();
            let first = await body.bytes(8);
            let end = await body.bytes(8);
            let contribution = first[0].int()+end.size()+body.remainder().size()+body.trailers().int("X-N");
            body.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

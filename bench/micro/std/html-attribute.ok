module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "html/events" take HtmlAttribute;

// An attribute built with and without a value.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let x = (i % 9 + 1).string();
        let valued = HtmlAttribute(name: "data-" + x, valued: true, value: x + x);
        let bare = HtmlAttribute(name: "hidden", valued: false, value: "");
        self.run(i + 1, n, acc + (valued.name().length() + bare.name().length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

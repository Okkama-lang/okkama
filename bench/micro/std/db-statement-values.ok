module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "math/decimal" take Decimal;
import "db/value" take DbValue, DbValueKind, DbNull, DbBoolean, DbInteger, DbFloating, DbDecimal, DbText, DbBytes;
import "db/row" take Row, Column, DbColumns;
import "db/statement" take DbLimits, DbValueSnapshot, Statement, Execution, DbBoundaryLimit;

// The position of a kind in DbValueKind.
hidden object Code {
    Code();
    of(kind is DbValueKind) is int {
        match kind {
            case DbValueKind.null_value { 0; }
            case DbValueKind.boolean { 1; }
            case DbValueKind.integer { 2; }
            case DbValueKind.floating { 3; }
            case DbValueKind.decimal { 4; }
            case DbValueKind.text { 5; }
            case DbValueKind.bytes { 6; }
        }
    }
}

// Statements and value snapshots checked against limits (a tight limit refuses every fourth); executions with and without a row count; row values.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let names is @string = ["b", "y", "d", "f", "g", "n", "t", "z"];
        let columns is @Column = (0..8).map() -> at { Column(index: at, name: names[at], declaration: ""); };
        let values is @DbValue = [DbBoolean(v % 2 == 0), DbBytes([byte(v), byte(5)]), DbDecimal(Decimal(x + ".5")), DbInteger(i % 2),
            DbFloating(if v > 4 { 6.5; } else { 2.5; }), DbInteger(v * 13), DbText("t" + x), DbNull()];
        let row = Row(columns: columns, values: values);
        let limits = DbLimits(values: 4, bytes: if i % 4 == 0 { 8; } else { 64; }, sql_bytes: 100);
        let snapshot = try { DbValueSnapshot(values: [DbText("abcdefgh" + x), DbInteger(v)], limits: limits).values().size(); } catch e is DbBoundaryLimit { 10; };
        let statement = Statement(text: "SELECT ?" + x, values: [DbInteger(v)], limits: limits);
        let total = row.floating("g").int() + Code().of(row.value("z").kind()) + DbColumns(values: columns, limits: DbLimits()).values().size()
            + snapshot + statement.text().length() + (if Execution().affected_known() { 1; } else { 0; })
            + (if Execution(affected: v).affected_known() { 2; } else { 0; }) + Execution(affected: v).affected_rows();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

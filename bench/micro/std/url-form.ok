module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/utf" take Utf8Encoded;
import "url/percent" take PercentDecoded;
import "url/form" take FormUrlEncoded;
import "url/query" take QueryParameters, QueryParameter, ParameterParsing;

// A form body parsed and one encoded (text and bytes); a percent-encoded text decoded.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let query = QueryParameters(QueryParameter(name: "k", value: x + " &"), QueryParameter(name: "on", value: "true"));
        let parsed = ParameterParsing(Utf8Encoded("a=" + x + "&b=true&a=7").bytes(), true, 10, 100).parameters();
        let total = parsed.list("a").size() + FormUrlEncoded(query).string().length() + FormUrlEncoded(query).bytes().size()
            + PercentDecoded("a%20b%2" + x).bytes().size();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

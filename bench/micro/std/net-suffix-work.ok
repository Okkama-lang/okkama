// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "net/public_suffix" take PublicSuffixList;
import "net/endpoint" take HostName;

object Bench {
    has suffixes is PublicSuffixList;

    Bench() {
        suffixes = PublicSuffixList();
    }

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let host = HostName("node" + x + ".co.uk");
        let suffix = suffixes.suffix(host);
        let result = suffix.ascii().length() + (if suffixes.public(suffix) {
            v;
        }
        else {
            0;
        }) + (if suffixes.public(host) {
            100;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

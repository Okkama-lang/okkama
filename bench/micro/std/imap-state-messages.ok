// #244: Сборка SELECT state из EXISTS/FLAGS/UIDVALIDITY.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mail/imap_state" take ImapMailboxState;
import "mail/imap_command_reading" take ImapCommandRead;
import "mail/imap_response" take ParsedImapResponse;
import "encoding/utf" take Utf8Encoded;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let exists = ParsedImapResponse(Utf8Encoded("* "+x+" EXISTS\r\n").bytes()).response();
        let flags = ParsedImapResponse(Utf8Encoded("* FLAGS ()\r\n").bytes()).response();
        let uid = ParsedImapResponse(Utf8Encoded("* OK [UIDVALIDITY 123] valid\r\n").bytes()).response();
        let done = ParsedImapResponse(Utf8Encoded("A1 OK done\r\n").bytes()).response();
        let result = ImapCommandRead([exists,flags,uid],done,[],100);
        let contribution = ImapMailboxState(result,false).messages();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

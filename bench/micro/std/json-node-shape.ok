module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "json" take ParsedJson, JsonKindName;

// A parsed object sized, indexed, merged and pretty-printed.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let root = ParsedJson("{\"id\":" + x + ",\"name\":\"n" + x + "\",\"ok\":true,\"price\":" + x + ".5,\"none\":null," +
            "\"tags\":[\"a\",\"b\"],\"inner\":{\"k\":" + x + "}}").root();
        let tags = root.get("tags");
        let total = root.size() + tags.items().size() + tags.at(1).text().length() + JsonKindName(tags.kind()).string().length()
            + root.merged(ParsedJson("{\"id\":0,\"extra\":1}").root()).size() + root.pretty(2).length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: RST_STREAM frame.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/http2_controls" take Http2ResetFrame;
import "http/internal/http2_frame" take Http2Frame;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let data = Http2ResetFrame(v, 8).frame().bytes();
        let contribution = data.reduce(0) -> s, b { s + b.int(); };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

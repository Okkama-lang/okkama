// #244: Валидация WebSocket client limits без подключения.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/websocket_client" take WebSocketPolicy;
import "http/websocket" take WebSocketLimits;
import "http/endpoint" take LoopbackEndpoints;
import "time/duration" take Duration;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = WebSocketPolicy(WebSocketLimits(1024+v,512,16),Duration(seconds:3),Duration(seconds:2),LoopbackEndpoints());
        let contribution = value.limits().message_bytes();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: pop3-session-mail; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;
import "mail/pop3_session" take PopSession, PopCommand, PopSimpleCommand, PopMessageCommand, PreviewedPopMail, PopDeleteReset;
import "mail/pop3" take PopCapabilities, PopListingLimits, PopNumber;
import "mail/pop3_reply" take PopReply, PopReplyLimits, PopReplyMode;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let message = "Subject: "+x+"\r\n\r\nbody\r\n";
            let chunk = "+OK mail\r\n"+message+".\r\n";
            let wire = chunk+chunk+chunk+chunk+"+OK deleted\r\n";

            let input = ByteBodyInput(Utf8Encoded(wire).bytes());
            let sink = Sink();
            let capabilities = PopCapabilities(PopReply(true,"caps",Utf8Encoded("TOP\r\n").bytes(),1,true));
            let session = PopSession(input,sink,input,capabilities,[],PopReplyLimits(),PopListingLimits());
            let mailbox = session.mailbox();

            let number = PopNumber(v);
            let bytes = await mailbox.bytes(number);
            let mail = await mailbox.message(number);
            let preview = await mailbox.preview(number,1);
            let deferred = await PreviewedPopMail(mailbox,number,1).bytes();
            await mailbox.delete(number);
            let contribution = bytes.size()+preview.size()+deferred.size()+mail.headers().first("Subject").length();
            session.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

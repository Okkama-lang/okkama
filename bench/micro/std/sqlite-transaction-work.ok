module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory, SqliteTransactions, SqliteTransactionMode;
import "db/value" take DbInteger;
import "db/transaction" take TransactionOptions;

// An immediate transaction doing every kind of work: a bound statement, a script, a prepared statement and a query.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let db = await SqliteMemory().connection();
        await db.execution("CREATE TABLE t(x INTEGER)");
        let tx = await SqliteTransactions(origin: db, mode: SqliteTransactionMode.immediate).transaction(TransactionOptions());
        let open = if tx.active() { 1; } else { 0; };
        await tx.execution("INSERT INTO t(x) VALUES (?)", DbInteger(v));
        let ran = await tx.script("INSERT INTO t(x) VALUES (2); INSERT INTO t(x) VALUES (3);");
        let insert = await tx.prepared("INSERT INTO t(x) VALUES (?)");
        await insert.execution(DbInteger(10));
        insert.close();
        let rows = await tx.query("SELECT SUM(x) AS s FROM t WHERE x > ?", DbInteger(1)).all(1);
        await tx.commit();
        db.close();
        let total = open + ran.size() + rows[0].int("s");
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

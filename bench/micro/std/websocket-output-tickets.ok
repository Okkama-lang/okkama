// #244: websocket-output-tickets; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "random/source" take PcgRandom;
import "http/websocket" take WebSocketLimits, WebSocketClose, WebSocketClosed, TextWebSocketMessage, BinaryWebSocketMessage;
import "http/internal/websocket_frame" take WebSocketFrame, WebSocketFrameHeader, ParsedWebSocketFrameHeader, WebSocketHeaderPrefix;
import "http/internal/websocket_messages" take ParsedWebSocketClose, WebSocketMessageAssembly;
import "http/internal/websocket_output" take WebSocketOutput, WebSocketOutputTicket, WebSocketOutputSettlement, WebSocketOutputCancelled;
import "http/websocket_session" take WebSocketSession;
import "http/internal/websocket_upgrade" take WebSocketOpeningCleanup;
import "io/stream" take AsyncReading, Closing;
import "json" take Json, JsonField;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds: 100.rat())); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds: 100.rat())); } async wait(duration is Duration) is void { await Event().wait(); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let sink = Sink();
            let output = WebSocketOutput(sink,false,PcgRandom(v),WebSocketLimits());
            let group is FutureGroup<bool> = FutureGroup();
            let runner = output.run(); group.start(runner);
            let one = WebSocketOutputTicket(output,2,[v.byte()]);
            let sent = await one.waiting();
            let two = WebSocketOutputTicket(output,2,[v.byte()]);
            let delivered = await two.delivered();
            let cancelled = WebSocketOutputTicket(output,2,[]); cancelled.cancel();
            let failed = WebSocketOutputTicket(output,2,[]); failed.failed();
            output.finish(); await runner; await group.wait();
            let cleanup = WebSocketOutputSettlement(group); await cleanup.close();
            let contribution = sink.checksum()+(if sent && delivered && cancelled.cancelled() { 1; } else { 0; });
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

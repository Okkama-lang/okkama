// #244: mail-message-values; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "mail/message" take MailMessage, ParsedMail, DeliveredMail, MailDate, ParsedMailDate;
import "mail/mailbox" take StoredMail, MailFlags, SystemFlag, SystemMailFlag, KeywordFlag, Maildir, MaildirLimits, ChangedMaildirFlags;
import "mail/mbox" take MboxArchive, MboxRecord, MboxSeparator, ParsedMbox, MboxLimits;
import "mail/mbox_store" take Mbox;
import "mime/part" take MimeLimits;
import "compare" take Order;
import "encoding/utf" take Utf8Encoded;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let bytes = Utf8Encoded("Subject: "+x+"\r\nBcc: hidden@example.test\r\n\r\nhello\r\n").bytes();
        let parsed = ParsedMail(bytes).message();
        let mail = MailMessage(parsed.headers(),parsed.body());
        let delivered = DeliveredMail(mail).bytes();
        let date = ParsedMailDate("Wed, 01 Jan 2020 00:00:00 +0000");
        let printed = MailDate(date.date_time(),date.offset_known()).string();
        let contribution = delivered.size()+mail.string().length()+printed.length();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: 100-continue deadline state с фиксированным clock.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/http1_continue" take Http1ContinueState;
import "time/duration" take Duration;
import "time/clock" take Instant, MonotonicInstant, Timing;


object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void {} }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = Http1ContinueState(i%2==0,FixedClock(),Duration(seconds:v)).begun();
        let contribution = if value.body_sent() { v; } else { 0; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

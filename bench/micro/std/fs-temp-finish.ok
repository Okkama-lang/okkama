module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/environment" take Environment;
import "fs/temp" take TemporaryDirectory;
import "fs/temp" take TemporaryFile;
import "fs/file" take File, FileMode;
import "fs/lock" take FileLockMode;
import "fs/entry" take FileEntry;

// Temporary files kept at a destination or replacing a file; files replaced atomically as bytes and text; a lock probed; the directory closed.
object Bench {
    has parent is Environment;
    Bench() {
        parent = Environment();
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let scratch = TemporaryDirectory(parent: parent.temporary(), prefix: "okkama-fs-");
        let root = scratch.path();
        let kept = TemporaryFile(directory: scratch, prefix: "k-");
        kept.write("keep" + x);
        kept.preserve(root.child("kept.txt"));
        let target = root.child("target.txt");
        File(path: target, mode: FileMode.writing).text().write("old");
        let fresh = TemporaryFile(directory: scratch, prefix: "r-");
        fresh.write("new!" + x + x);
        fresh.replace(target);
        let open = if fresh.closed() { 1; } else { 0; };
        fresh.close();
        let shut = if fresh.closed() { 2; } else { 0; };
        File(path: root.child("b.bin")).binary().replace([byte(v), byte(1), byte(2)]);
        File(path: root.child("c.txt")).text().replace("text ", x);
        let probe = File(path: target, mode: FileMode.reading);
        let locked = if probe.locked(FileLockMode.exclusive) { 4; } else { 0; };
        probe.close();
        let sizes = FileEntry(root.child("kept.txt")).stat()::Shape::size + 10 * FileEntry(target).stat()::Shape::size
            + 100 * FileEntry(root.child("b.bin")).stat()::Shape::size + 1000 * FileEntry(root.child("c.txt")).stat()::Shape::size;
        scratch.close();
        let total = open + shut + locked + 8 * (if scratch.closed() { 1; } else { 0; }) + 16 * sizes;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: web-request-values; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/request_context" take HttpRequestContext;
import "http/exchange" take ExchangeDetails;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "async/cancellation" take Cancellation;
import "web/request" take WebRequest, WebLinks, RouteParameter;
import "http/message" take Request;
import "http/target" take OriginTarget;
import "http/header" take Headers, Header;
import "http/method" take Method;
import "url/query" take QueryParameters;
object Context { Context(); value() is HttpRequestContext {
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(local:IpEndpoint(IpAddress("127.0.0.1"),80),remote:IpEndpoint(IpAddress("127.0.0.1"),50000));
    HttpRequestContext(details:ExchangeDetails(endpoints:ends,version:HttpVersion.http_1_1),cancellation:Cancellation().cancelling());
} }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let context = Context().value().parameters(["id":x]);
        let request = WebRequest(Request(target:OriginTarget(path:"/a",query:Maybe.some("n="+x+"&b=true")),headers:Headers(Header("Cookie","sid="+x),Header("X-N",x))),context,WebLinks(["item":"/a/:id"]));
        let first = request.path().int("id") + (request.query().maybe("n").int() else 0);
        let contribution = first + request.header().int("X-N") + request.cookies().int("sid")
         + request.parameters().text("n").length() + request.link("item",RouteParameter("id",x)).length()
         + (if request.method() == Method.get && (request.query().maybe("b").boolean() else false) { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "collections/iteration" take Cursor;
import "collections/ordering" take Sorted, SortedBy;

hidden object Sum {
    has cursor is Cursor<int>;
    Sum(cursor is Cursor<int>) { self.cursor = cursor; }
    total() is int {
        let at = Atomic(cursor);
        let n = Atomic(0);
        loop {
            last if !at.value().available();
            n.replace(n.value() + at.value().item());
            at.replace(at.value().successor());
        }
        n.value();
    }
}

// Six ints sorted ascending and by a descending key: walked and indexed.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 5 + 3;
        let xs is @int = [v, 1, v, 4, 2, 4];
        let sorted = Sorted(origin: xs);
        let by = SortedBy(origin: xs, key: (x is int) is int { 0 - x; });
        let total = Sum(sorted.cursor()).total() + sorted.item(1) + sorted.last() + sorted.size()
            + Sum(by.cursor()).total() + by.first() + by.item(1) + by.last();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "message/header" take MessageHeader, MessageHeaderName, MessageHeaders,
    RenderedMessageHeaders;
import "compare" take Order;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let name = MessageHeaderName("X-Count");
        let lower = MessageHeaderName("x-count");
        let headers = MessageHeaders([MessageHeader(name, x)]).addition(
            MessageHeader(lower, "next")
        );
        let data = RenderedMessageHeaders(headers).bytes();
        let result = headers.first(lower).length() + headers.values(name).size() + (if headers.membership(
            name
        ) {
            1;
        }
        else {
            0;
        }) + (if name.order(lower) == Order.equal {
            1;
        }
        else {
            0;
        }) + data.reduce(0) -> s, b {
            s + b.int();
        };
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

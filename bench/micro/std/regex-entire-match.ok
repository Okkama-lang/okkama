module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "regex/pattern" take Regex;
import "regex/search" take EntireRegexMatch;

// A match of the entire text: every reader.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let text = "k" + x + "=" + x + x + " name=n" + x;
        let pair = Regex("(?<key>[a-z]+)(?<id>\\d)?=(?<num>\\d+)");
        let entire = EntireRegexMatch(origin: text, regex: Regex("(?<key>k)(?<id>\\d)=(?<num>\\d+) name=(?<rest>\\w+)"));
        let total = entire.capture(4).range()::Bounds::start + entire.captures().size() + entire.group("rest").range()::Bounds::end
            + entire.int("num") + (entire.maybe("id").int() else 0) + entire.range()::Bounds::end + entire.text().length()
            + entire.text("rest").length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: Сборка binary WebSocket message.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/websocket_messages" take WebSocketMessageAssembly;
import "http/internal/websocket_frame" take WebSocketFrame;
import "http/websocket" take WebSocketLimits, WebSocketMessage;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let assembly = WebSocketMessageAssembly(WebSocketLimits());
        let value = assembly.accept(WebSocketFrame(2,true,[byte(v%256)]));
        let contribution = value[0].bytes()[0].int();
        assembly.close();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

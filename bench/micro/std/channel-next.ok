module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/channel" take Channel;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let channel is Channel<int> = Channel(capacity: 2);
            let sending = channel.sending();
            let receiving = channel.receiving();
            await sending.send(i % 5);
            await sending.send(i % 3);
            let first = match await receiving.next() {
                case Maybe.some(value) { value; }
                else { 0; }
            };
            let second = match await receiving.next() {
                case Maybe.some(value) { value; }
                else { 0; }
            };
            sum = sum.add((first + second) % 7);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

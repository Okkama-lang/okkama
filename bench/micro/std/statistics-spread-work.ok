// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "statistics" take Sample, Population;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let values = [v.float(), (v + 1).float(), (v + 4).float()];
        let sample = Sample(values);
        let population = Population(values);
        let result = (sample.variance() * 1000.0).int() + (sample.deviation() * 1000.0).int() + (population.variance() * 1000.0).int() + (population.deviation() * 1000.0).int();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: web-session-memory; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "web/session" take MemorySessions, Session;
import "http/cookie" take SetCookie;
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void {} }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let store = MemorySessions(FixedClock());
            await store.save("id"+x,["n":x]);
            let values = await store.values("id"+x) else [:];
            let session = Session("id"+x,values,SetCookie("sid",x),"csrf");
            let contribution = session.maybe("n").int() else 0;
            await store.remove("id"+x);
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

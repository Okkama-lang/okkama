module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/number" take NumberPrinting, NumberPattern, NumberMagnitude, NumberFormat, NumberNotation, NumberGrouping, NumberSign, NumberPrecision;
import "locale/tag" take Locale;
import "math/rounding" take Rounding;

// The sum of the code points of a text.
hidden object Codes {
    Codes();
    of(text is string) is int {
        text.characters().reduce(0) -> sum, c { sum + c.code(); };
    }
}

// A magnitude printed as a number or a percent for en and de, its rendering and frame; a hand-made pattern read.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let format = NumberFormat(notation: NumberNotation.standard, grouping: NumberGrouping.automatic, sign: NumberSign.automatic,
            precision: NumberPrecision(minimum_integer: 1, minimum_fraction: 0, maximum_fraction: 1, rounding: Rounding.half_even));
        let printing = NumberPrinting(origin: NumberMagnitude(coefficient: 12345 * v, exponent: (0 - 2).rat(), negative: false),
            locale: Locale(["en", "de"][i % 2]), format: format, percent: i % 3 == 0, per_mille: false);
        let given = NumberPattern(["a", "b", "-a", "c", "3", (i % 3 + 1).string(), "2", "4"]);
        let total = Codes().of(printing.string()) + printing.rendering().frame(given).primary()
            + 10 * given.secondary() + 100 * given.exponent_digits() + 1000 * given.zeros();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

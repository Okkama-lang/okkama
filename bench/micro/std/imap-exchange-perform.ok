// #244: IMAP command exchange с ответом в памяти.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mail/imap_exchange" take ImapCommandChannel;
import "mail/imap_command" take ImapCommand, ImapMailboxCommand;
import "mail/imap_name" take ImapMailboxName;
import "mail/imap_command_reading" take ImapCommandLimits, ImapCommandRead;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;
import "async/atomic" take Atomic;
import "io/stream" take AsyncWriting, ByteSource;


object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput(Utf8Encoded("O1 OK done\r\n").bytes());
            let sink = Sink();
            let channel = ImapCommandChannel(input,sink,input,[],ImapCommandLimits());
            let result = await channel.perform(ImapCommand(operation:ImapMailboxCommand.create,mailbox:ImapMailboxName("box"+x)));
            let contribution = if result.successful() { sink.checksum(); } else { 0; };
            channel.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

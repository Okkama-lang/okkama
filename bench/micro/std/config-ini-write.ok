// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "config/ini" take IniEntry, IniSection, IniDocument, IniString, ParsedIni, IniWriting;
import "async/atomic" take Atomic;

object IniSink does IniWriting {
    has count is Atomic<int>;

    IniSink() {
        count = Atomic(0);
    }

    section(name is string) is void {
        count.replace(count.value() + name.length());
    }

    entry(name is string, value is string) is void {
        count.replace(count.value() + name.length() + value.length());
    }

    total() is int {
        count.value();
    }
}

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let section = IniSection("s", [IniEntry("n", x)]);
        let doc = IniDocument([section]);
        let sink = IniSink();
        section.print(sink);
        doc.print(sink);
        ParsedIni("[s]\nn=" + x + "\n").print(sink);
        let result = sink.total() + IniString(doc).string().length();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

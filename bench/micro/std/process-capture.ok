module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/run" take Run;
import "os/command_capture" take CommandCapture;
import "os/pipeline_capture" take PipelineCapture;
import "os/command" take Command, InheritedCommand, Commanding;
import "os/environment" take Environment;
import "fs/directory" take Directory;
import "fs/path" take Path;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let echoed = await Run("echo", ["hello", i.string()]).text();
            let empty is %string:string = [:];
            let cat = Command(program: Path("/bin/cat"), environment: Environment(values: empty), directory: Directory(Path("/")), arguments: []);
            let captured = await CommandCapture(origin: cat, text: "in " + i.string(), limit: 4096).completion();
            let stages is @Commanding = [InheritedCommand(program: Path("/bin/echo"), arguments: ["p" + i.string()]), InheritedCommand(program: Path("/bin/cat"), arguments: [])];
            let piped = await PipelineCapture(commands: stages, limit: 4096).completion();
            let ok = if captured.exit().success() && piped.exits()[1].success() { 1; } else { 0; };
            sum = sum.add((echoed.length() + captured::Captured::output.length() + piped::Captured::output.length() + ok) % 7);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

// #244: web-routing-methods; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "web/routing" take Post, Put, Patch, Delete, Resource, Scope, Route;
import "web/request" take WebRequest;
import "web/reply" take TextReply;
import "http/message" take Responding;
import "http/method" take Method;
object Endpoint { Endpoint(); async answer(request is WebRequest) is Responding { TextReply("ok"); } }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let endpoint = Endpoint();
        let resource = Resource("/a"+x, Post(endpoint.answer),Put(endpoint.answer),Patch(endpoint.answer),Delete(endpoint.answer));
        let direct = resource.routes("",[]);
        let scope = Scope("/api",resource);
        let routes = scope.routes("",[]);
        let other = Route(Method.options,"/a"+x,endpoint.answer).routes("",[]);
        let contribution = direct.size()+routes.size()+other[0].pattern().string().length()+routes[0].pattern().string().length();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "template/engine" take Template;
import "json" take Json, JsonField;


object Bench {
    has template is Template;
    Bench() {
        template = Template("Hello, {{name}} #{{n}}!");
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let data = Json(JsonField("name", "Ada"), JsonField("n", i));
        self.run(i + 1, n, acc + (template.string(data).length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

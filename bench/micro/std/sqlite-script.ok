module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory;
import "db/sqlite/script" take SqliteScript;

// A script of three statements run as one; one Execution per statement.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let db = await SqliteMemory().connection();
        let ran = await SqliteScript(origin: db, source: "CREATE TABLE t(x INTEGER); INSERT INTO t(x) VALUES (" + v.string() +
            "), (2); DELETE FROM t WHERE x < 3;").executions();
        db.close();
        let total = ran.size() + 10 * ran.item(1).affected_rows() + 100 * ran.item(2).affected_rows();
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

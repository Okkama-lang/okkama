// #244: Компиляция web route с prefix.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "web/routing" take Get;
import "http/routing" take Route, RoutePattern;
import "web/request" take WebRequest;
import "http/message" take Responding;
import "web/reply" take TextReply;


object Endpoint { Endpoint(); async answer(request is WebRequest) is Responding { TextReply("ok"); } }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let routes = Get(path:"/a"+x,endpoint:Endpoint().answer).routes("/api",[]);
        let contribution = routes[0].pattern().string().length();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

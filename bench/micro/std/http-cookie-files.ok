// #244: http-cookie-files; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "fs/path" take Path;
import "fs/directory" take Directory;
import "fs/file" take File, FileMode;
import "fs/entry" take FileEntry;
import "fs/temp" take TemporaryDirectory;
import "fs/root" take FileRoot;import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/cookie_jar" take MemoryCookieJar, SavedCookieJar, LoadedCookieJar;
import "http/cookie_policy" take CookieContext;
import "http/method" take Method;
import "http/header" take Headers, Header;
import "url/value" take ParsedUrl;
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds: 100.rat())); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds: 100.rat())); } async wait(duration is Duration) is void {} }
object Bench {
    has temporary is TemporaryDirectory;
Bench() { let scratch=TemporaryDirectory(parent:Directory(Path(".")),prefix:"work244-"); self.temporary=scratch; }
destroy { temporary.close(); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let jar = MemoryCookieJar(FixedClock());
        let url = ParsedUrl("https://example.test/").parts();
        jar.store(url,Headers(Header("Set-Cookie","n="+x+"; Path=/; Max-Age=1000")),CookieContext(url,true,Method.get));
        let saved = SavedCookieJar(jar,FileEntry(temporary.path().child("cookies"))).file();
        let loaded = LoadedCookieJar(saved,FixedClock()).jar();
        let contribution = loaded.size();
        loaded.close(); jar.close();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

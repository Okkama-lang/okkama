module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "regex/pattern" take Regex;
import "regex/search" take FirstRegexMatch;

// The first match of a pattern anywhere: groups, an int, an optional group, its range.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let text = "=" + x + " k" + x + "=" + x + x + " name=n" + x;
        let pair = Regex("(?<key>[a-z]+)(?<id>\\d)?=(?<num>\\d+)");
        let firsts = FirstRegexMatch(origin: text, regex: pair);
        let total = firsts.captures().size() + firsts.group("num").range()::Bounds::end + firsts.int("num")
            + (firsts.maybe("id").int() else 0) + firsts.range()::Bounds::end;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

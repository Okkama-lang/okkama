module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/status" take StatusCode;

object Bench {
    has codes is @int;
    Bench() {
        codes = [200, 201, 204, 301, 304, 400, 404, 500, 503];
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let status = StatusCode(code: codes[i % 9]);
        self.run(i + 1, n, acc + (status.phrase().length() + status.number()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

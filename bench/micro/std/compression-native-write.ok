// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "compression/internal/codec" take NativeCompressor, NativeDecompressed;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let compressor = NativeCompressor("zlib", 6);
        compressor.write([byte(v), byte(255)]);
        compressor.finish();
        let finished = if compressor.finished() {
            1;
        }
        else {
            0;
        };
        let packed = compressor.output().bytes(128);
        compressor.close();
        let data = NativeDecompressed(packed, "zlib", 64).bytes();
        let result = data[0].int() + data[1].int() + finished;
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

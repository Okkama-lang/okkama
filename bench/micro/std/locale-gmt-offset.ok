module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/date_time" take GregorianLocaleData, DateStyle, TimeStyle, DateTimeStyle;
import "locale/tag" take Locale;
import "time/date" take Date, Weekday;
import "time/day" take TimeOfDay;
import "locale/date_time" take LocalizedGmtOffset;
import "locale/internal/zone_names" take CldrZoneNames;
import "time/duration" take Duration;

// The sum of the code points of a text.
hidden object Codes {
    Codes();
    of(text is string) is int {
        text.characters().reduce(0) -> sum, c { sum + c.code(); };
    }
}

// UTC offsets from -12:00 to +13:30 in half hours, short and wide, for en, de and fr.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let data = GregorianLocaleData(Locale(["en", "de", "fr"][i % 3]));
        let offset = Duration(seconds: (i % 52 - 24) * 1800);
        let total = Codes().of(LocalizedGmtOffset(offset: offset, data: data, table: CldrZoneNames(), wide: i % 2 == 0).string());
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

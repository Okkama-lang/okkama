module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/date" take ParsedHttpDate;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let second = i % 60;
        let text = "Sun, 06 Nov 1994 08:49:" + (if second < 10 { "0"; } else { ""; }) + second.string() + " GMT";
        let seconds = ParsedHttpDate(origin: text).instant().unix_duration()::Span::seconds.int();
        self.run(i + 1, n, acc + seconds % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

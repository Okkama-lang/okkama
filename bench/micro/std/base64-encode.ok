module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/base64" take Base64Encoded;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let bytes = [byte(i % 256), byte(102), byte(111), byte(111), byte(98), byte(97), byte(114), byte(33)];
        self.run(i + 1, n, acc + (Base64Encoded(origin: bytes).string().characters()[0].code()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

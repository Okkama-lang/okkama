// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "cli/command" take CliCommand, Option;

object Bench {
    has command is CliCommand;

    Bench() {
        command = CliCommand(
            name: "tool",
            options: [
                Option(name: "n", short: "n", value: "N", repeated: true, help: ""),
                Option(name: "b", short: "b", value: "B", repeated: false, help: "")
            ]
        );
    }

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let call = command.invocation(["--n", x, "--b", "true", "--n", x]);
        let result = (call.text("n") else "").length() + call.texts("n").size() + (call.float("n") else 0.0).int() + (if call.bool(
            "b"
        ) else false {
            1;
        }
        else {
            0;
        }) + call.path().first().length();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

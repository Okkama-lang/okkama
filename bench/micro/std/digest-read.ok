module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "io/stream" take AsyncReading;
import "io/buffer" take ByteBuffer;
import "digest/read" take ReadDigest, AsyncReadDigest;
import "digest/sha2" take Sha256;

// Bytes handed out five at a time.
hidden object Pieces does AsyncReading {
    has content is @byte;
    has position is Atomic<int>;
    Pieces(content is @byte) { self.content = content; position = Atomic(0); }
    async bytes(limit is int) is @byte {
        let at = position.value();
        let end = if at + 5 < content.size() { at + 5; } else { content.size(); };
        position.replace(end);
        content.slice(at, end);
    }
}

// SHA-256 of 1..100 bytes read through a reader, blocking and async, in chunks.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let data is @byte = (0..(i % 100 + 1)).map() -> k { byte(k % 256); };
        let read = ReadDigest(origin: ByteBuffer(data).reading(), digest: Sha256(), chunk: 16).continued(Sha256("p")).bytes()[0].int();
        let digest = AsyncReadDigest(origin: Pieces(data), digest: Sha256(), chunk: 8);
        let total = read + (await digest.result()).bytes()[0].int()
            + (await AsyncReadDigest(origin: Pieces(data), digest: Sha256()).continued(Sha256("q"))).bytes()[0].int();
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

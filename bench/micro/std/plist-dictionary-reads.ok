module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/utf" take Utf8Encoded;
import "plist/parse" take ParsedPlist;

// A parsed plist dictionary read by its typed readers.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let text = "<?xml version=\"1.0\"?>\n<plist version=\"1.0\"><dict>" +
            "<key>name</key><string>App &amp; " + x + "</string><key>on</key><true/><key>ratio</key><real>" + x + ".5</real>" +
            "<key>blob</key><data>AQID</data><key>when</key><date>2026-01-0" + x + "T00:00:00Z</date>" +
            "<key>tags</key><array><string>a</string><string>b" + x + "</string></array>" +
            "<key>ports</key><array><integer>1</integer><integer>" + x + "</integer></array>" +
            "<key>items</key><array><dict><key>id</key><integer>" + x + "</integer></dict></array>" +
            "<key>inner</key><dict><key>k</key><string>v" + x + "</string></dict></dict></plist>";
        let root = ParsedPlist(Utf8Encoded(text).bytes()).dictionary();
        let total = root.text("name").length() + (if root.boolean("on") { 1; } else { 0; }) + root.float("ratio").int()
            + root.data("blob").size() + (if root.date("when") == root.date("when") { 1; } else { 0; })
            + root.ints("ports")[1] + root.dictionaries("items")[0].int("id") + root.get("inner").text("k").length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

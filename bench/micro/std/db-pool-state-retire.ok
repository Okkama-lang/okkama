module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/atomic" take Atomic;
import "db/sqlite" take SqliteMemory;
import "db/acquisition" take DbAcquiring, DbAcquisition;
import "db/connection" take DbConnection, DbConnecting;
import "db/error" take DbClosed;
import "db/value" take DbInteger;
import "db/transaction" take TransactionOptions;
import "db/pool" take DbPoolState, DbPool, DbPreparedPool, DbPhysical, PoolOptions, PooledTransactions, DbChecking;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "async/event" take Event;

// A clock whose waits never end on their own: nothing here reads real time.
hidden object StillClock does Timing {
    StillClock();
    instant() is Instant { Instant(origin: Duration(seconds: 0)); }
    monotonic_instant() is MonotonicInstant { MonotonicInstant(origin: Duration(seconds: 0)); }
    async wait(duration is Duration) is void { await Event().wait(); }
}

// Each acquisition is a new in-memory database.
hidden object Memory does DbAcquiring {
    Memory();
    async acquisition() is DbAcquisition {
        let connection = await SqliteMemory().connection();
        DbAcquisition(connection: connection, preparation: connection, transactions: connection);
    }
}

// Refuses the first connection it checks when picky, accepts the rest.
hidden object Picky does DbChecking {
    has picky is bool;
    has seen is Atomic<int>;
    Picky(picky is bool) { self.picky = picky; seen = Atomic(0); }
    async healthy(origin is DbConnection) is bool {
        seen.replace(seen.value() + 1);
        !(picky && seen.value() == 1);
    }
}

// A pool state whose health check refuses the first connection on even iterations (discarded, retired); closed with idle connections; a recorded failure surfaced by settled.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let state = DbPoolState(origin: Memory(), options: PoolOptions(minimum: 0, maximum: 3, idle_timeout: Duration(seconds: 60), lifetime: Duration(seconds: 600), acquisition_timeout: Duration(seconds: 5)), clock: StillClock(), health: Picky(i % 2 == 0));
        let lease = await state.connection();
        let serial = lease.identifier();
        lease.close();
        let first = if await state.settled() { 1; } else { 0; };
        state.close();
        let second = if await state.settled() { 2; } else { 0; };
        state.failed(DbClosed.closed);
        let failure = try { await state.settled(); 0; } catch e is DbClosed { 4; };
        let total = 10 * serial + first + second + failure + v;
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

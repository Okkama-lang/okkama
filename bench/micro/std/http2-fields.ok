// #244: HTTP/2 request pseudo-fields.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/http2_fields" take Http2RequestFields;
import "http/message" take Request;
import "http/internal/hpack_tables" take HpackField;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let fields = Http2RequestFields(Request(url:"https://example.test/a"+x),1).fields();
        let contribution = fields.reduce(0) -> s, f { s + f.name().length()+f.value().length(); };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

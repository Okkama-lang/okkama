module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/quoted_printable" take QuotedPrintableEncoded;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let bytes = [byte(i % 256), byte(61), byte(32), byte(116), byte(9), byte(255)];
        let encoded = QuotedPrintableEncoded(origin: bytes).bytes();
        self.run(i + 1, n, acc + (encoded.size() + encoded[0].int()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http-cookie-read; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/cookie" take RequestCookies;
import "http/message" take Request;
import "http/header" take Headers, Header;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let cookies = RequestCookies(Request(url:"http://example.test/",headers:Headers(Header("Cookie","sid="+x+"; sid="+(v+1).string()))));
        let contribution = cookies.text("sid").length()+cookies.int("sid")+cookies.list("sid").size()+(cookies.maybe("sid").int() else 0);
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

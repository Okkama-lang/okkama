module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "strings/parse" take Number;
import "locale/number" take NumberMagnitude, DecimalNumberMagnitude, NumberQuantized, NumberPrecision;
import "math/decimal" take Decimal;
import "math/rounding" take Rounding;

// Decimals as magnitudes (shifted by -1..1), rounded half-even to 1..2 fraction digits and split into whole and fraction digits.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let precision = NumberPrecision(minimum_integer: 1, minimum_fraction: 1, maximum_fraction: 2, rounding: Rounding.half_even);
        let magnitude = DecimalNumberMagnitude(origin: Decimal("12." + (i % 3).string() + v.string() + "5"), shift: i % 3 - 1, negative_zero: false).magnitude();
        let q = NumberQuantized(origin: magnitude, precision: precision);
        let raw = NumberMagnitude(coefficient: 4560 * v, exponent: (0 - 2).rat(), negative: true);
        let total = raw.magnitude().int() + 10 * (magnitude.magnitude().int() + 2) + 100 * q.whole().length() + q.fraction(1).length()
            + 1000 * q.ascii(1).length() + 10000 * (q.magnitude().magnitude().int() + 2) + Number(q.whole()).int();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

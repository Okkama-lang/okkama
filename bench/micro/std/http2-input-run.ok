// #244: Диспетчер SETTINGS, ACK и EOF на памяти.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/internal/http2_input" take Http2ConnectionInput, Http2ControlQueuing, Http2ReceivingEvents;
import "http/body" take ByteBodyInput;
import "http/http2_settings" take Http2Settings;
import "http/internal/http2_frame" take Http2Fault, Http2Frame, Http2FrameHeader;
import "http/internal/http2_settings" take Http2PeerSettings;
import "async/atomic" take Atomic;
import "http/internal/http2_headers" take Http2HeaderBlock;
import "http/internal/http2_flow" take Http2DataPayload, Http2WindowIncrement;
import "http/internal/http2_controls" take Http2GoAway, Http2Reset;


object Receiver does Http2ReceivingEvents, Http2ControlQueuing {
 has result is Atomic<int>;
 Receiver() { result=Atomic(0); }
 headers(block is Http2HeaderBlock) is void {}
 data(data is Http2DataPayload) is void {}
 reset(reset is Http2Reset) is void {}
 window(update is Http2WindowIncrement) is void {}
 settings(previous is Http2PeerSettings, current is Http2PeerSettings) is void { result.replace(result.value()+current.initial_window()); }
 local_settings(settings is Http2Settings) is void {}
 goaway(frame is Http2GoAway) is void {}
 stream_fault(fault is Http2Fault) is bool { false; }
 ended() is void { result.replace(result.value()+1); }
 frame(frame is Http2Frame) is void { result.replace(result.value()+frame.header().flags().int()); }
 checksum() is int { result.value(); }
}
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let data = Http2Frame(Http2FrameHeader(byte(4),byte(0),0,6),[byte(0),byte(4),byte(0),byte(0),byte(0),byte(v)]).bytes();
            let input = ByteBodyInput(data);
            let receiver = Receiver();
            await Http2ConnectionInput(input,receiver,receiver,Http2Settings(),Http2PeerSettings()).run();
            let contribution = receiver.checksum();
            input.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

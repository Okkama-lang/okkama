// Deterministic composite iteration; see oracles.py for the independent checksum.
// Rfc3339.new(origin is Instant, offset is Duration) is Rfc3339 | Rfc3339.new(text is string) is Rfc3339
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "time/rfc3339" take Rfc3339;
import "time/clock" take Instant;
import "time/duration" take Duration;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let contribution = Rfc3339("1970-01-01T00:00:" + (if i % 60 < 10 { "0"; } else { ""; }) + (i % 60).string() + "Z").instant().unix_duration().nanoseconds();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

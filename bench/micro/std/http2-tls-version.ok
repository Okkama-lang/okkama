// #244: Точная проверка h2 ALPN, включая отказ.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/http2_tls" take Http2TlsProtocol;
import "http/version" take HttpVersion, UnsupportedHttpVersion;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let selected = if i%2==0 { "h2"; } else { "H2"; };
        let good = try { Http2TlsProtocol(selected).version() == HttpVersion.http_2; } catch e is UnsupportedHttpVersion { false; };
        let contribution = if good { v; } else { 0; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

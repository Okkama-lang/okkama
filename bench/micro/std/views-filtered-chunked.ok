module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "collections/views" take Filtered, Chunked;
import "collections/list" take List, EmptyList;
import "cell" take Cell;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let empty is List<int> = EmptyList();
        let values = empty.prefix(6).prefix(5).prefix(4).prefix(3).prefix(2).prefix(1).prefix(i % 5);
        let chunks = Cell(0);
        let items = Cell(0);
        for Chunked(origin: Filtered(origin: values, condition: (value is int) is bool { value % 2 == 0; }), size: 2) -> chunk {
            chunks.replace(chunks.value() + 1);
            items.replace(items.value() + chunk[0]);
        }
        self.run(i + 1, n, acc + (3 * chunks.value() + items.value()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

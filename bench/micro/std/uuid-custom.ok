module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "compare" take Order;
import "uuid/value" take UuidText, UuidBytes;
import "uuid/generation" take Uuid8;

hidden object Rank {
    Rank();
    of(order is Order) is int {
        if order == Order.less { 1; } else if order == Order.equal { 2; } else { 3; }
    }
}

// A custom (version 8) UUID laid out from three fields, re-read from its bytes and compared.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let dns = UuidText("6ba7b810-9dad-11d1-80b4-00c04fd430c8");
        let rank = Rank();
        let v8 = Uuid8(high: v, middle: v, low: v);
        let raw = UuidBytes(v8.bytes());
        let total = v8.bytes()[15].int() + v8.string().length() + rank.of(v8.order(raw)) + rank.of(raw.order(dns))
            + raw.string().slice(14, 15).length() + ("0123456789abcdef".find(raw.string().slice(7, 8)) else 99);
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

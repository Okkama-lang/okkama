module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "math/decimal" take Decimal;
import "db/value" take DbValue, DbValueCapture, DbBoolean, DbInteger, DbFloating, DbDecimal, DbText, DbBytes, ObservedDbValue;

// A value printed into a capture of its own kind.
hidden object Printed {
    Printed();
    of(value is DbValue) is DbValueCapture {
        let capture = DbValueCapture(value.kind());
        value.print(capture);
        capture.finish();
        capture;
    }
}

// Every value kind printed into the protocol and read back; an observed value printed through its native cell.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let p = Printed();
        let total = (if p.of(DbBoolean(v % 2 == 1)).boolean_value() { 1; } else { 0; }) + p.of(DbInteger(v * 7)).integer_value()
            + p.of(DbFloating(if v % 3 == 0 { 4.5; } else { 1.5; })).floating_value().int()
            + p.of(DbDecimal(Decimal(x + ".5"))).decimal_value().string().length() + p.of(DbText("t" + x)).text_value().length()
            + p.of(DbBytes([byte(v), byte(1)])).bytes_value()[0].int() + p.of(ObservedDbValue(DbInteger(v)).cell()).integer_value()
            + ObservedDbValue(DbText(x + x)).text().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

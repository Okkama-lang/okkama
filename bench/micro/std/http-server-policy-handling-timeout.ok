// #244: Валидация server timeout policy.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/server_policy" take ServerTimeouts;
import "time/duration" take Duration;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let contribution = ServerTimeouts(Duration(seconds: 1.rat()),Duration(seconds: 2.rat()),Duration(seconds: 3.rat()),Duration(seconds: v.rat())).handling_timeout()::Span::seconds.int();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

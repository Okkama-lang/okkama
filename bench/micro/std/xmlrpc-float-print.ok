// #244: xmlrpc-float-print; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/xmlrpc" take XmlRpcFloat, XmlRpcWriting, XmlRpcValue, XmlRpcMember;
import "math/decimal" take Decimal;
import "time/local_datetime" take LocalDateTime;
import "collections/sequence" take Sequencing;
import "async/atomic" take Atomic;
object Capture does XmlRpcWriting { has n is Atomic<int>; Capture() { n=Atomic(0); } value() is int { n.value(); } floating(value is Decimal) is void { n.replace(value.rat().int()); } integer(value is int) is void {} boolean(value is bool) is void {} text(value is string) is void {} datetime(value is LocalDateTime) is void {} binary(value is @byte) is void {} elements(values is Sequencing<XmlRpcValue>) is void {} members(values is Sequencing<XmlRpcMember>) is void {} nil_value() is void {} }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let writer = Capture(); XmlRpcFloat(v.float()).print(writer);
        let contribution = writer.value();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "config/source" take Settings, LayeredSettings, SettingEntry, SettingSource,
    SettingSourceKind;
import "config/key" take SettingKey;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let source = SettingSource(SettingSourceKind.document, "s" + x);
        let key = SettingKey("n");
        let settings = Settings(
            SettingEntry(key, [x], source),
            SettingEntry(SettingKey("b"), ["true"], source)
        );
        let layered = LayeredSettings(settings);
        let result = settings.texts("n").first().length() + (settings.source("n") else source)::Source::name.length() + layered.texts(
            "n"
        ).first().length() + (layered.source("n") else source)::Source::name.length() + (layered.float(
            "n"
        ) else 0.0).int() + (if layered.bool("b") else false {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "numbers/bigrational" take BigRational;
import "compare" take Order;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let a = BigRational(numerator: v, denominator: 3);
        let b = BigRational(numerator: 2, denominator: 5);
        let values = [a.plus(b), a.minus(b), a.times(b), a.divided(b)];
        let result = values.reduce(0) -> s, r {
            s + r.numerator() + r.denominator() + r.string().length();
        } + (if a.order(b) == Order.less {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: Чтение fixed body из памяти.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/http1_body" take Http1BodyReading;
import "http/body" take ByteBodyInput;
import "http/http1_framing" take Http1BodyKind, Http1BodyPlan;
import "http/header" take Headers;
import "encoding/utf" take Utf8Encoded;



object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let input = ByteBodyInput(Utf8Encoded(x).bytes());
            let body = Http1BodyReading(input,input,Http1BodyPlan(Http1BodyKind.fixed,x.length(),true),[],Headers());
            let data = await body.bytes(32);
            let contribution = data.reduce(0) -> s,b { s+b.int(); };
            body.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "unicode/character" take UnicodeCharacter, UnicodeCategory;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let letter = LetterOf(i % 52).character();
        self.run(i + 1, n, acc + (CategoryScore(UnicodeCharacter(origin: letter).category()).value()) % 7);
    }
}

// A-Z for 0..25, a-z for 26..51.
object LetterOf {
    has index is int;

    LetterOf(index is int) {
        self.index = index;
    }

    character() is char {
        if index < 26 {
            char(65 + index);
        }
        else {
            char(97 + index - 26);
        }
    }
}

// Upper case as 1, lower case as 2.
object CategoryScore {
    has category is UnicodeCategory;

    CategoryScore(category is UnicodeCategory) {
        self.category = category;
    }

    value() is int {
        if category == UnicodeCategory.uppercase_letter {
            1;
        }
        else if category == UnicodeCategory.lowercase_letter {
            2;
        }
        else {
            0;
        }
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

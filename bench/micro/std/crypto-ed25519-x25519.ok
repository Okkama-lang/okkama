module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/ed25519" take Ed25519PrivateKey, Ed25519PublicKey;
import "crypto/x25519" take X25519PrivateKey, X25519PublicKey;
import "crypto/secret" take SecretBytes;

// Ed25519 keys from 16 seeds: PKCS#8 holds the seed, the public key rebuilt from its raw bytes verifies; an X25519 shared secret.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let s = i % 16;
        let seed is @byte = (0..32).map() -> k { byte((k * 11 + s) % 256); };
        let other is @byte = (0..32).map() -> k { byte((k * 13 + s + 1) % 256); };
        let key = Ed25519PrivateKey(seed: SecretBytes(seed));
        let message is @byte = [byte(s), byte(1), byte(2)];
        let signature = key.signature(message);
        let public = Ed25519PublicKey(raw: key.public_key().bytes().slice(12, 44));
        let good = if public.verified(message, signature) { 1; } else { 0; };
        let bad = if public.verified([byte(9)], signature) { 2; } else { 0; };
        let seeded = if key.pkcs8().export_bytes().slice(16, 48) == seed { 4; } else { 0; };
        let peer = X25519PublicKey(raw: X25519PrivateKey(secret: SecretBytes(other)).public_key().raw());
        let shared = X25519PrivateKey(secret: SecretBytes(seed)).shared_secret(peer).export_bytes();
        let total = good + bad + seeded + 10 * public.bytes().size() + 1000 * public.bytes()[43].int() + 100000 * shared[0].int();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

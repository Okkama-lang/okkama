// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "calendar" take YearMonth, MonthDates, CalendarMonth, CalendarWeek;
import "time/date" take Date, Weekday;
import "compare" take Order;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let month = YearMonth(2024, v % 12 + 1);
        let dates = MonthDates(origin: month);
        let grid = CalendarMonth(month, Weekday.monday);
        let week = CalendarWeek(Date(2024, 1, v));
        let result = dates.item(v % 20)::Calendar::day + dates.last()::Calendar::day + grid.item(0).first()::Calendar::day + grid.last().last()::Calendar::day + week.item(
            1
        )::Calendar::day + (if month.order(YearMonth(2025, 1)) == Order.less {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

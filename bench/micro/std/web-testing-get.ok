// #244: In-process web dispatch без TCP.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "web/testing" take WebTestClient;
import "web/routing" take Get, WebRoutes;
import "http/exchange" take ClientResponse;
import "web/reply" take TextReply;
import "web/request" take WebRequest;
import "http/message" take Responding;


object Endpoint { Endpoint(); async answer(request is WebRequest) is Responding { TextReply("ok"); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let client = WebTestClient(WebRoutes(Get(path:"/a"+x,endpoint:Endpoint().answer)));
            let reply = await client.get("/a"+x);
            let contribution = (await reply.text()).length()+reply::Head::code;
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

// Deterministic composite iteration; see oracles.py for the independent checksum.
// TemplateLibrary.new() is TemplateLibrary | TemplateLibrary.new(templates is @string:TextTemplate) is TemplateLibrary | TemplateLibrary.new(values is Sequencing<NamedTemplate>) is TemplateLibrary | TemplateLibrary.new(values is Sequencing<NamedTemplate>, maximum_templates is int) is TemplateLibrary | TemplateLibrary.new(values... is NamedTemplate) is TemplateLibrary
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "template/library" take TemplateLibrary, NamedTemplate;
import "template/compile" take TextTemplate;


object Bench {
    has template is TextTemplate;
    Bench() { template = TextTemplate("Hi {{n}}!"); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let name = "item" + i.string();
        let library = TemplateLibrary(NamedTemplate(name, template));
        let contribution = library.template(name).source().length() + name.length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

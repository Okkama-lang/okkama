module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory;
import "db/value" take DbInteger;
import "db/transaction" take TransactionOptions;

// Two transactions on one connection: one committed, one rolled back.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let db = await SqliteMemory().connection();
        await db.execution("CREATE TABLE t(x INTEGER)");
        let keep = await db.transaction(options: TransactionOptions());
        await keep.execution("INSERT INTO t(x) VALUES (?)", DbInteger(v));
        await keep.commit();
        let undone = await db.transaction(options: TransactionOptions());
        await undone.execution("INSERT INTO t(x) VALUES (?)", DbInteger(100));
        await undone.rollback();
        let left = await db.query("SELECT SUM(x) AS s, COUNT(*) AS c FROM t").all(1);
        db.close();
        let total = left[0].int("s") + left[0].int("c");
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

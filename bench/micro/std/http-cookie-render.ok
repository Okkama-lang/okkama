// #244: http-cookie-render; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/cookie" take Cookie, CookieAttributes, CookieExpiry, CookieFlag, SameSite, SetCookie, ExpiredCookie;
import "collections/set" take OrderedSet;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let expiry = CookieExpiry(Instant(Duration(seconds: (100+v).rat())));
        let flags is OrderedSet<CookieFlag> = OrderedSet([CookieFlag.secure,CookieFlag.http_only]);
        let attributes = CookieAttributes("","/",expiry,SameSite.lax,flags);
        let cookie = Cookie("sid",x,attributes);
        let set = SetCookie(cookie).header();
        let expired = ExpiredCookie("sid"+x).header();
        let contribution = cookie.string().length()+attributes.string().length()+attributes.flags().size()+expiry.instant().unix_duration()::Span::seconds.int()+set.value().length()+expired.value().length();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

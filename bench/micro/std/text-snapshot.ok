module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "testing/snapshot" take TextSnapshot, RawSnapshot;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let text = TextSnapshot("snapshot " + i.string() + "\n").bytes();
        let raw = RawSnapshot([byte(i % 256), byte(10)]).bytes();
        self.run(i + 1, n, acc + (text.size() + raw[0].int() + raw.size()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

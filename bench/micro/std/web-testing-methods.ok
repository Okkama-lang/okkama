// #244: web-testing-methods; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "web/testing" take WebTestClient;
import "web/routing" take WebRoutes, Any;
import "web/request" take WebRequest;
import "web/reply" take TextReply;
import "http/message" take Request, Responding;
import "http/body" take TextBody;
import "http/target" take OriginTarget;
object Endpoint { Endpoint(); async answer(request is WebRequest) is Responding { TextReply("ok"); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let client = WebTestClient(WebRoutes(Any("/a"+x,Endpoint().answer)));
            let a = await client.delete("/a"+x);
            let b = await client.head("/a"+x);
            let c = await client.options("/a"+x);
            let d = await client.patch("/a"+x,TextBody(x));
            let e = await client.post("/a"+x,TextBody(x));
            let f = await client.put("/a"+x,TextBody(x));
            let g = await client.response(Request(target:OriginTarget(path:"/a"+x,query:Maybe<string>.none)));
            let contribution = a::Head::code+b::Head::code+c::Head::code+d::Head::code+e::Head::code+f::Head::code+g::Head::code+(await b.bytes()).size();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

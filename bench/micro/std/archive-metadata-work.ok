// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "archive/entry" take ArchiveDevice, ArchiveEntryKind;
import "archive/metadata" take ArchiveMetadata, ArchiveOwnership, ArchiveModificationFromEpoch;
import "archive/path" take ArchivePath;
import "fs/stat" take PermissionMode;

object Bench {
    has mode is PermissionMode;

    Bench() {
        mode = PermissionMode(420);
    }

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let metadata = ArchiveMetadata(
            mode: mode,
            modified: ArchiveModificationFromEpoch(0.rat()).local_date_time(),
            ownership: ArchiveOwnership("u", "g", v, 2),
            comment: ""
        );
        let device = ArchiveDevice(
            ArchivePath("dev" + x),
            ArchiveEntryKind.character_device,
            metadata,
            v,
            2
        );
        let result = metadata.mode().special() + metadata.ownership().user_identity() + device.major() + device.minor();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

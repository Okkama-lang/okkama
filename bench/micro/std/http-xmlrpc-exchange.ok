// #244: http-xmlrpc-exchange; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/cache_memory" take CachedHttpEntry, MemoryHttpCache;
import "http/cache_freshness" take CacheResponseTiming, CacheFreshness;
import "http/cache_validation" take CacheValidation, CacheRequestFreshness;
import "http/message" take Request, Response;
import "http/exchange" take ExchangeDetails, ClientResponse;
import "http/header" take Headers, Header;
import "http/status" take Status;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "http/exchange" take Exchanging;
import "http/body" take TextBody;import "http/request_context" take HttpRequestContext;
import "http/exchange" take ExchangeDetails;
import "async/cancellation" take Cancellation;
import "http/xmlrpc" take XmlRpcClient, XmlRpcCalling, XmlRpcCall, XmlRpcResult, XmlRpcSuccess, XmlRpcInteger, XmlRpcLimits, XmlRpcHandling;
import "url/value" take ParsedUrl;
object Context { Context(); value() is HttpRequestContext {
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(local:IpEndpoint(IpAddress("127.0.0.1"),80),remote:IpEndpoint(IpAddress("127.0.0.1"),50000));
    HttpRequestContext(details:ExchangeDetails(endpoints:ends,version:HttpVersion.http_1_1),cancellation:Cancellation().cancelling());
} }object Echo does XmlRpcCalling { Echo(); async result(call is XmlRpcCall) is XmlRpcResult { XmlRpcSuccess(call.parameter(0)); } }
object RpcOrigin does Exchanging { RpcOrigin(); async response(request is Request) is ClientResponse { let context=Context().value(); let result=await XmlRpcHandling("/rpc",Echo(),XmlRpcLimits()).handling(request,context); ClientResponse(request,result.response(),ExchangeDetails(context.endpoints(),HttpVersion.http_1_1)); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let client = XmlRpcClient(RpcOrigin(),ParsedUrl("http://example.test/rpc").parts(),XmlRpcLimits());
            let result = await client.result(XmlRpcCall("echo",[XmlRpcInteger(v)]));
            let contribution = result.value().int();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

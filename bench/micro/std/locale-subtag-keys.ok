module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/tag" take LocaleSubtag, UnicodeLocaleKeyword, UnicodeLocaleExtension, TransformedLocaleExtension;

// Private-use, singleton and extension-key roles, as bits.
hidden object Keys {
    Keys();
    bits(origin is string) is int {
        let t = LocaleSubtag(origin);
        (if t.private_use() { 1; } else { 0; }) + (if t.singleton() { 2; } else { 0; }) + (if t.unicode_key() { 4; } else { 0; })
            + (if t.transform_key() { 8; } else { 0; });
    }
}

// Subtags tested as private-use, singleton and extension keys; a u keyword written; u and t extensions parsed.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let pool is @string = ["en", "Latn", "DE", "1996", "yue", "abc12", "x", "u1", "t0", "419", "rozaj", "a1b2c3d4e", "ca", "ZH", "9", "h0"];
        let p = pool.size();
        let picks is @string = [pool[i % p], pool[(i + 5) % p], pool[(i * 7 + 3) % p]];
        let k = Keys();
        let x = (i % 9 + 1).string();
        let u = UnicodeLocaleExtension(["attr" + x, "ca", "buddhist", "nu", "latn"]);
        let t = TransformedLocaleExtension(["en", "h0", "hybrid"]);
        let total = k.bits(picks[0]) + k.bits(picks[1]) + k.bits(picks[2])
            + UnicodeLocaleKeyword(key: "ca", values: ["islamic", "civil" + x]).string().length()
            + u.keywords().size() + 10 * u.attributes().size() + t.parts().size();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

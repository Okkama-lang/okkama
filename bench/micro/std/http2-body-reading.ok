// #244: http2-body-reading; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2Fault, Http2FaultScope;
import "http/internal/http2_flow" take Http2FlowWindow, Http2SendCredit, Http2DataPayload, Http2WindowFrame, Http2WindowIncrement;
import "http/internal/http2_body" take Http2BodyBuffer, Http2BodyEvents, Http2IncomingBody, Http2BodyLength, Http2Trailers;
import "http/header" take Headers, Header;
import "http/internal/hpack_tables" take HpackField;
object Events does Http2BodyEvents { Events(); credit(stream is int,amount is int,stream_update is bool) is void {} discard(stream is int,amount is int,cancel is bool) is void {} }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let body = Http2BodyBuffer(stream:1,initial:1024,maximum:128,events:Events(),expected:[],empty:false);
            body.require_fields();
            body.configure([1],false);
            body.check();
            body.data(Http2DataPayload(Http2Frame(Http2FrameHeader(0.byte(),0.byte(),1,1),[v.byte()])));
            body.exact(1);
            body.ending(Headers(Header("X-End",x)));
            let incoming = Http2IncomingBody(body,[1]);
            let reading = incoming.reading();
            let bytes = await body.bytes(128);
            let end = await body.bytes(128);
            let contribution = bytes[0].int()+end.size()+incoming.length()+body.trailers().int("X-End")+body.remaining();
            body.wake();
            body.credit(1);
            body.release(false);
            body.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

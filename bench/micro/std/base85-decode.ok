module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/base85" take Base85Encoded, Base85Decoded, Base85Alphabet;

object Bench {
    has texts is @string;
    Bench() {
        texts = (0..256).map() -> value {
            let bytes = [byte(value), byte(9), byte(8), byte(7), byte(6), byte(5)];
            Base85Encoded(origin: bytes, alphabet: Base85Alphabet.rfc1924).string();
        };
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let decoded = Base85Decoded(origin: texts[i % 256], alphabet: Base85Alphabet.rfc1924).bytes();
        self.run(i + 1, n, acc + (decoded[0].int() + decoded.size()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http-media-scanning; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/media_type" take HttpMediaScanning, HttpMediaLimits, HttpMediaItems, HttpMediaOctet, HttpMediaScanned, HttpMediaPosition;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let parsed = HttpMediaScanning("text/plain; note="+x,HttpMediaLimits(bytes:128,parameters:4)).media_type();
        let items is HttpMediaItems<string> = HttpMediaItems();
        items = items.following(parsed.parameters().first("note"));
        let scanned = HttpMediaScanned(items.values()[0],v);
        let position = HttpMediaPosition(v,1);
        let contribution = scanned.text().length()+scanned.end()+position.index()
         + (if HttpMediaOctet(48+v%10).token() { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

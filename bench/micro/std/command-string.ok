module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/command" take Command;
import "os/environment" take Environment;
import "fs/directory" take Directory;
import "fs/path" take Path;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let arguments = ["--name", "a \"quoted\" " + i.string(), "tab\there"];
        let command = Command(program: Path("/usr/bin/tool"), environment: Environment(values: ["A": "1"]), directory: Directory(Path("/srv/work")), arguments: arguments);
        self.run(i + 1, n, acc + (command.string().length() + command.string().characters()[20].code()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http2-flow-windows; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2Fault, Http2FaultScope;
import "http/internal/http2_flow" take Http2FlowWindow, Http2SendCredit, Http2DataPayload, Http2WindowFrame, Http2WindowIncrement;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let window = Http2FlowWindow(Http2FaultScope.stream,1,1024);
        window = window.received(v);
        window = window.credited(v+1);
        window = window.adjusted(-1);
        let credit = Http2SendCredit(Http2FlowWindow(Http2FaultScope.connection,0,1024),window);
        credit = credit.spent(v);
        let contribution = window.available()+credit.available()+credit.connection().remaining()+credit.stream().remaining();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

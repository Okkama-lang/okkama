module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/record" take LogRecord, LogContext;
import "logging/level" take LogLevel;
import "logging/name" take LogName;
import "logging/field" take LogFields;
import "time/clock" take Instant;
import "time/duration" take Duration;
import "json" take JsonField, Json;
import "logging/file" take LogFileState, FileLogOptions;
import "logging/rotation" take RotatingLogFile, IntervalRotating;
import "fs/temp" take TemporaryDirectory;
import "fs/entry" take FileEntry;
import "fs/stat" take PermissionMode;
import "os/environment" take Environment;
import "encoding/utf" take Utf8Encoded;
import "time/zone" take FixedZone;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "async/event" take Event;

// A clock whose waits never end on their own: nothing here reads real time.
hidden object StillClock does Timing {
    StillClock();
    instant() is Instant { Instant(origin: Duration(seconds: 0.rat())); }
    monotonic_instant() is MonotonicInstant { MonotonicInstant(origin: Duration(seconds: 0.rat())); }
    async wait(duration is Duration) is void { await Event().wait(); }
}

// A log file state written, flushed, reopened, released and closed.
object Bench {
    has parent is Environment;
    Bench() {
        parent = Environment();
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let scratch = TemporaryDirectory(parent: parent.temporary(), prefix: "okkama-lf-");
        let options = FileLogOptions(permissions: PermissionMode(384), flush_each: false, sync_each: false);
        let state = LogFileState(path: scratch.path().child("a.log"), options: options);
        state.write(Utf8Encoded("one " + x + "\n").bytes());
        state.flush();
        state.reopen();
        state.write(Utf8Encoded("two\n").bytes());
        state.release();
        state.close();
        let total = FileEntry(scratch.path().child("a.log")).stat()::Shape::size;
        scratch.close();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

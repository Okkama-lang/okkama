// Deterministic composite iteration; see oracles.py for the independent checksum.
// NetworkInterface.new(name is string, index is int, addresses is @IpInterface, up is bool, loopback is bool) is NetworkInterface
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "net/interface" take NetworkInterface;
import "net/ip" take IpInterface;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let addresses is @IpInterface = [];
        let value = NetworkInterface("if" + i.string(), i + 1, addresses, true, false);
        let contribution = value.name().length() + value.index();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

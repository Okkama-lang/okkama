// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "time/date" take Date;
import "time/day" take TimeOfDay;
import "time/local_datetime" take LocalDateTime;
import "time/zone" take Zone, ZonedDateTime, ZoneObservation;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let zone = Zone("Europe/Berlin");
        let local = LocalDateTime(Date(2024, 1, v), TimeOfDay(12, 0, 0, 0));
        let instant = zone.instant(local);
        let zoned = ZonedDateTime(instant, zone);
        let observation = ZoneObservation(zoned);
        let result = zone.offset(instant).nanoseconds() + zone.abbreviation(instant).length() + observation.abbreviation().length() + zoned.local_datetime().date()::Calendar::day + (if zone.daylight_saving(
            instant
        ) {
            100;
        }
        else {
            0;
        }) + (if observation.daylight_saving() {
            100;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

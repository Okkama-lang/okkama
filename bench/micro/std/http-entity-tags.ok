module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/conditional" take ParsedEntityTags, EntityTag;

object Bench {
    has wanted is EntityTag;
    Bench() {
        wanted = EntityTag(value: "b1", weak: false);
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let tags = ParsedEntityTags("\"a\", W/\"b" + (i % 3).string() + "\"").tags();
        let weak = if tags.weak_matches(wanted) { 1; } else { 0; };
        let strong = if tags.strong_matches(wanted) { 2; } else { 0; };
        self.run(i + 1, n, acc + (tags.values().size() + weak + strong) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

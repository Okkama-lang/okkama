module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory;
import "db/value" take DbText, DbInteger;
import "db/transaction" take TransactionOptions;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let db = await SqliteMemory().connection();
            await db.execution("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT, amount INTEGER)");
            for (0..5) -> k {
                await db.execution("INSERT INTO t(name, amount) VALUES (?, ?)", DbText("n" + k.string()), DbInteger(i % 7 + k));
            }
            let totals = await db.query("SELECT COUNT(*) AS c, SUM(amount) AS s FROM t WHERE amount > ?", DbInteger(2)).all(1);
            let change = await db.transaction(options: TransactionOptions());
            let deleted = await change.execution("DELETE FROM t WHERE amount < ?", DbInteger(i % 4 + 1));
            if i % 2 == 0 { await change.commit(); } else { await change.rollback(); }
            let left = await db.query("SELECT COUNT(*) AS c FROM t").all(1);
            db.close();
            sum = sum.add((totals[0].int("c") + totals[0].int("s") + left[0].int("c") + 2 * deleted.affected_rows()) % 7);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

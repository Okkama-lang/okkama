module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/bytes" take ByteRange;
import "encoding/binary" take Signedness;
import "encoding/utf" take ByteOrder;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let source = [byte(1), byte(i % 256), byte((i * 7) % 256), byte(200), byte(9)];
        let value = ByteRange(source: source, start: 1, end: 4).integer(Signedness.unsigned, ByteOrder.big);
        self.run(i + 1, n, acc + value % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

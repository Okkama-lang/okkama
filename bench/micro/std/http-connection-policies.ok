// #244: http-connection-policies; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/cache_memory" take CachedHttpEntry, MemoryHttpCache;
import "http/cache_freshness" take CacheResponseTiming, CacheFreshness;
import "http/cache_validation" take CacheValidation, CacheRequestFreshness;
import "http/message" take Request, Response;
import "http/exchange" take ExchangeDetails, ClientResponse;
import "http/header" take Headers, Header;
import "http/status" take Status;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "http/connection" take Http1Connecting;
import "http/http1_head" take Http1Limits;
import "http/http2_connection" take Http2Connecting;
import "http/http2_settings" take Http2Settings;
import "http/selected_connection" take HttpSelectedConnecting;
import "http/client_policy" take ClientPolicy, HttpLimits;
import "http/proxy_policy" take ProxyPolicy;
import "http/proxy_connection" take HttpProxyRouting;
import "http/proxy_request" take HttpForwardRequest;
import "http/proxy" take Proxied;
import "http/auth" take BasicCredentials;
import "crypto/secret" take SecretBytes;
import "net/tls" take TlsClientPolicy;
import "crypto/x509/trust" take TrustedCertificates;
import "net/dns" take FixedResolution;
import "http/endpoint" take HttpEndpointSelection, AllEndpoints;
import "url/value" take ParsedUrl;
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void {} }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let clock = FixedClock();
        let now = clock.monotonic_instant();
        let timing = CacheResponseTiming(clock.instant(),now,now);
        let endpoint = IpEndpoint(IpAddress("127.0.0.1"),80);
        let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(endpoint,endpoint);
        let details = ExchangeDetails(ends,HttpVersion.http_1_1);
        let request = Request(url:"http://example.test/"+x);
        let fields = Headers(Header("Cache-Control","max-age=600"),Header("ETag", "\""+x+"\""));
        let response = ClientResponse(request,Response(status:Status.ok,headers:fields),details);
        let entry = CachedHttpEntry(request,response,timing,[v.byte()],Headers());

        let route = HttpEndpointSelection(ParsedUrl("http://127.0.0.1/"+x).parts(),FixedResolution(),AllEndpoints());
        let tls = TlsClientPolicy(TrustedCertificates());
        let policy = ClientPolicy();
        let http1 = Http1Connecting(route,tls,Http1Limits(),FixedClock());
        let http2 = Http2Connecting(route,tls,Http2Settings(),HttpLimits(),FixedClock());
        let selected = HttpSelectedConnecting(route,tls,policy,FixedClock());
        let proxy = ProxyPolicy(ParsedUrl("http://proxy.test:3128").parts(),BasicCredentials("u"+x,SecretBytes("p")));
        let routing = HttpProxyRouting(proxy,FixedResolution(),tls,policy,FixedClock());
        let proxied = Proxied(proxy,FixedResolution(),tls,policy,FixedClock());
        let forwarded = HttpForwardRequest(request,[]).request();
        let contribution = forwarded::Head::target.string().length()+proxy.credentials().authorization().value().length()+(if routing.allowed(request::Head::target.url(),details,AllEndpoints()) { 1; } else { 0; });
        proxied.close();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

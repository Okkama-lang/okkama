// #244: imap-data-values; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "encoding/utf" take Utf8Encoded;
import "mail/imap_data" take ImapValue, ImapValueKind, ImapDataUpper, ImapDataTokens, ImapDataToken, ImapTokenKind, ImapDataLimits, ImapDataTree, ParsedImapData;
import "mail/imap_response" take ParsedImapResponse;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let scalar = ImapValue(ImapValueKind.atom,Utf8Encoded(x).bytes(),[]);
        let list = ImapValue(ImapValueKind.list,[],[scalar]);
        let tokens = ImapDataTokens(ImapDataLimits());
        tokens = tokens.following(ImapDataToken(ImapTokenKind.atom,scalar.bytes()));
        let tree = ImapDataTree(tokens.entries(),ImapDataLimits()).item(0,0);
        let response = ParsedImapResponse(Utf8Encoded("* "+x+" EXISTS\r\n").bytes()).response();
        let parsed = ParsedImapData(response);
        let contribution = scalar.string().length()+list.entries().size()+tree.parsed().string().length()+parsed.entries().size()+ImapDataUpper("nil"+x).string().length()+(if !scalar.absent() { v; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

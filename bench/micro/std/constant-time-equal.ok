module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/constant_time" take ConstantTimeEqual;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let left = [byte(i % 256), byte(1), byte(2), byte(3), byte(4), byte(5), byte(6), byte(7), byte(8), byte(9), byte(10), byte(11), byte(12), byte(13), byte(14), byte(15)];
        let ending = if i % 3 == 0 { byte(255); } else { byte(15); };
        let right = left.slice(0, 15) + [ending];
        let contribution = if ConstantTimeEqual(left: left, right: right).matches() { 1; } else { 2; };
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

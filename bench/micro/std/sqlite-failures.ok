module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "db/sqlite" take SqliteMemory, SqliteConnection;
import "db/value" take DbInteger;
import "db/statement" take Statement;
import "db/error" take DbFailure;
import "db/transaction" take TransactionOptions;

// A transaction left open: its end rolls it back.
hidden object Dropped {
    Dropped();
    async run(db is SqliteConnection) is int {
        let tx = await db.transaction(options: TransactionOptions());
        await tx.execution("INSERT INTO t(x) VALUES (?)", DbInteger(50));
        1;
    }
}

// A rejected statement, rows read by hand, a BLOB sized, a transaction abandoned, the worker settled.
object Bench {
    Bench();
    async run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let db = await SqliteMemory().connection();
        await db.execution("CREATE TABLE t(x INTEGER, data BLOB)");
        await db.execution("INSERT INTO t(x, data) VALUES (?, zeroblob(?))", DbInteger(v), DbInteger(v + 3));
        let failed = try { await db.execution("INSERT INTO missing VALUES (1)"); 0; } catch e is DbFailure { 1; };
        let rows = await db.rows(Statement("SELECT x FROM t"));
        let first = await rows.row();
        rows.close();
        let blob = await db.opened_blob("main", "t", "data", 1, false);
        let size = blob.size();
        blob.close();
        let dropped = await Dropped().run(db);
        let left = await db.query("SELECT COUNT(*) AS c FROM t").all(1);
        let settled = if await db.settled() { 4; } else { 0; };
        db.close();
        let total = failed + first.int("x") + size + dropped + 10 * left[0].int("c") + settled;
        await self.run(i + 1, n, acc + total % 7);
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = await bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

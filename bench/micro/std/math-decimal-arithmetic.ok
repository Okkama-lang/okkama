// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "math/decimal" take Decimal;
import "math/rounding" take Rounding;
import "compare" take Order;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let a = Decimal(x + ".25");
        let b = Decimal("0.5");
        let result = a.minus(b).rat().numerator() + a.times(b).rat().numerator() + a.divided(
            by: b,
            scale: 2,
            rounding: Rounding.half_even
        ).rat().numerator() + a.rounded(scale: 0, rounding: Rounding.half_even).float().int() + a.float().int() + (if a.order(
            b
        ) == Order.greater {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

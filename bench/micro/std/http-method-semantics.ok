module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/method" take MethodName, MethodSemantics;

object Bench {
    has names is @string;
    Bench() {
        names = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE"];
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let semantics = MethodSemantics(origin: MethodName(token: names[i % 8]).method());
        let safe = if semantics.safe() { 1; } else { 0; };
        let idempotent = if semantics.idempotent() { 2; } else { 0; };
        self.run(i + 1, n, acc + (safe + idempotent) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

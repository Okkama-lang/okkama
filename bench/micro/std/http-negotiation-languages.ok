// #244: http-negotiation-languages; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/negotiation" take AcceptedLanguages, CharsetName;
import "locale/tag" take Locale;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let quality = "0."+(1000+v).string().slice(1,4);
        let accepted = AcceptedLanguages("en;q="+quality);
        let choice = Locale("en");
        let selected = accepted.preference([choice]);
        let contribution = (accepted.quality(choice).weight()*1000.rat()).int()+accepted.values().size()+accepted.string().length()+selected.string().length();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

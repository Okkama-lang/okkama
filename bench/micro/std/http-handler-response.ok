// #244: Обёртка результата HTTP handler.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/handler" take ResponseHandling;
import "http/message" take Response;
import "http/status" take StatusCode;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = ResponseHandling(Response(status:StatusCode(200+v%50).status())).response();
        let contribution = value::Head::code;
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: websocket-server-memory; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "async/event" take Event;
import "async/scope" take FutureGroup;
import "random/source" take PcgRandom;
import "http/websocket" take WebSocketLimits, WebSocketClose, WebSocketClosed, TextWebSocketMessage, BinaryWebSocketMessage;
import "http/internal/websocket_frame" take WebSocketFrame, WebSocketFrameHeader, ParsedWebSocketFrameHeader, WebSocketHeaderPrefix;
import "http/internal/websocket_messages" take ParsedWebSocketClose, WebSocketMessageAssembly;
import "http/internal/websocket_output" take WebSocketOutput, WebSocketOutputTicket, WebSocketOutputSettlement, WebSocketOutputCancelled;
import "http/websocket_session" take WebSocketSession;
import "http/internal/websocket_upgrade" take WebSocketOpeningCleanup;
import "io/stream" take AsyncReading, Closing;
import "json" take Json, JsonField;
import "http/websocket_handshake" take WebSocketClientHandshake, WebSocketServerHandshake;
import "http/http1_head" take Http1RequestHead;
import "http/header" take Headers, Header;
import "http/version" take HttpVersion;
import "url/value" take ParsedUrl;
import "http/http1_reading" take Http1HeadRead;
import "http/websocket_server" take WebSocketAccepting, WebSocketUpgrade;
import "http/websocket_origin" take SameOriginWebSockets;
import "http/websocket_client" take WebSocketOpening, WebSocketPolicy, WebSocketConnecting;
import "http/endpoint" take HttpEndpointSelection, AllEndpoints;
import "net/dns" take FixedResolution;
import "net/tls" take TlsClientPolicy;
import "crypto/x509/trust" take TrustedCertificates;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds: 100.rat())); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds: 100.rat())); } async wait(duration is Duration) is void { await Event().wait(); } }object Input does AsyncReading, Closing { has source is ByteBodyInput; has stop is Event; Input(bytes is @byte) { source=ByteBodyInput(bytes); stop=Event(); } async bytes(limit is int) is @byte { let bytes=await source.bytes(limit); if bytes.size()>0 { return bytes; } await stop.wait(); []; } close() is void { source.close(); stop.set(); } closed() is bool { stop.ready(); } }object Returned { has session is WebSocketSession; Returned(session is WebSocketSession) { self.session=session; } async value() is WebSocketSession { session; } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let url = ParsedUrl("ws://example.test/"+x).parts();
            let client = WebSocketClientHandshake(url,["p"+x],Headers(Header("Origin","http://example.test")),Utf8Encoded("the sample nonce").bytes());
            let request = client.request();
            let head = Http1RequestHead(request::Head::method,request::Head::target,request::Head::headers,HttpVersion.http_1_1);
            let server = WebSocketServerHandshake(head);

            let input = Input([]);
            let sink = Sink();
            let received is Http1HeadRead<Http1RequestHead> = Http1HeadRead(head,[],0);
            let accepting = WebSocketAccepting(input,sink,input,received,url,WebSocketUpgrade(["p"+x],WebSocketLimits(),SameOriginWebSockets(),Duration(seconds: 1.rat())),FixedClock());
            let connection = await accepting.connection();
            let contribution = (if !connection.closed() { v; } else { 0; });
            input.close();
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/list" take LocalizedList, ListKind, ListStyle;
import "locale/tag" take Locale;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let values is @string = ["tea", "milk", i.string()];
        self.run(i + 1, n, acc + (LocalizedList(values: values, locale: Locale("en"), kind: ListKind.conjunction, style: ListStyle.long).string().length()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

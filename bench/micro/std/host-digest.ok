module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "digest/host" take HostDigest;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let data is @byte = (0..24).map() -> k { byte((i * 3 + k) % 256); };
        let digest = HostDigest(algorithm: "sha256", key: [], width: 0).appended(data.slice(0, 10)).appended(data.slice(10, 24)).bytes();
        self.run(i + 1, n, acc + (digest[0].int() + digest[31].int()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

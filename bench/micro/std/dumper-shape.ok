module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "debug/dumper" take Dumper;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let probe = DumpProbe(x: i, y: i % 7, label: "p" + i.string());
        let dump = Dumper(probe);
        let names = dump.fields().reduce(0) -> total, field { total + field.length(); };
        let array = Dumper([1, 2, i % 5]);
        self.run(i + 1, n, acc + (dump.size() + names + dump.kind().length() + array.size() + Dumper("t" + i.string()).size()) % 7);
    }
}

object DumpProbe {
    has x, y is int;
    has label is string;
    DumpProbe(x is int, y is int, label is string) {
        self.x = x;
        self.y = y;
        self.label = label;
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "async/timeout" take Within;
import "time/duration" take Duration;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "async/event" take Event;

object Sum {
    has total is int;
    Sum(:total);
    add(value is int) is ^Sum { ^total = total + value; }
    total() is int { total; }
}

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let value = await Within(origin: Job(value: i).result(), limit: Duration(seconds: 5), clock: StillClock()).outcome();
            sum = sum.add(value % 7);
        }
        sum.total();
    }
}

object Job {
    has value is int;
    Job(:value);
    async result() is int { value % 7; }
}

// A clock whose waits never end on their own (no real time is read).
object StillClock does Timing {
    StillClock();

    instant() is Instant {
        Instant(origin: Duration(seconds: 0));
    }

    monotonic_instant() is MonotonicInstant {
        MonotonicInstant(origin: Duration(seconds: 0));
    }

    async wait(duration is Duration) is void {
        await Event().wait();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

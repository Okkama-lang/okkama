// #244: imap-copy-mapping; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/body" take ByteBodyInput;
import "encoding/utf" take Utf8Encoded;
import "mail/imap_session" take ImapSession, ImapSessionReply, SelectedMailbox, ImapSelectionToken, ImapSelectedState, ImapAssignedUids, ImapCopiedUids, SearchedMail, FetchedMail, ChangedMailFlags, CopiedMail, MovedMail, ExpungedMail, CreatedImapMailbox, RenamedImapMailbox, ImapMailboxDeletion, ImapSubscription, AppendedMail, MailboxEvent, MailboxEventKind, MailboxEvents, MailboxEventsClosed, ImapIdleTask, ImapEventObservation;
import "mail/imap_exchange" take ImapCommandChannel, ImapLiteralWriting, ImapIdleContinuation;
import "mail/imap_command" take ImapCommand, ImapSimpleCommand;
import "mail/imap_command_reading" take ImapCommandLimits;
import "mail/imap" take ImapCapabilities;
import "mail/imap_name" take ImapMailboxName;
import "mail/imap_uid" take ImapUid, ImapUidSet, ImapUidValidity, MailboxUids;
import "mail/imap_search" take AllMail;
import "mail/imap_command" take ImapDatum, FlagChange;
import "mail/mailbox" take MailFlags;
import "mail/message" take MailMessage;
import "message/header" take MessageHeaders, MessageHeader, MessageHeaderName;
import "mime/part" take TextBody;
import "async/event" take Event;
import "async/channel" take Channel;
import "async/scope" take FutureGroup;
import "mail/imap_command_reading" take ImapCommandRead;
import "mail/imap_response" take ParsedImapResponse;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let completion=ParsedImapResponse(Utf8Encoded("O1 OK [COPYUID 1 "+x+" "+(v+1).string()+"] copied\r\n").bytes()).response();
        let read=ImapCommandRead([],completion,[],completion.bytes().size());
        let copied=ImapCopiedUids(read,ImapUidSet(ImapUid(v)),ImapMailboxName("dest"),ImapCapabilities(["IMAP4rev1","UIDPLUS"]),"account");
        let contribution=copied.sources().entries().item(0).number()+copied.assigned().uids().uids().entries().item(0).number();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

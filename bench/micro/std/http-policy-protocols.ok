// #244: http-policy-protocols; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "time/clock" take Timing, Instant, MonotonicInstant;
import "time/duration" take Duration;
import "http/client_policy" take ClientPolicy, ClientTimeouts, Http1ClientProtocols;
import "http/client_protocols" take HttpClientProtocols;
import "http/server_policy" take ServerPolicy;
import "net/tls" take TlsClientPolicy;
import "crypto/x509/trust" take TrustedCertificates;
import "http/version" take HttpVersion;
import "http/endpoint" take HttpEndpointSelection, ListedNetworks, PublicEndpoints, AllEndpoints;
import "net/dns" take FixedResolution;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress, IpNetwork;
import "url/value" take ParsedUrl;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let tls = TlsClientPolicy(TrustedCertificates());
        let client = ClientPolicy();
        let timeouts = ClientTimeouts(Duration(seconds:v),Duration(seconds:1),Duration(seconds:2));
        let protocols = Http1ClientProtocols(client,tls);
        let selected = HttpClientProtocols(client,tls).clear();
        let server = ServerPolicy();
        let contribution = timeouts.connection_timeout()::Span::seconds.int()+server.connections()+(if selected==protocols.version() { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

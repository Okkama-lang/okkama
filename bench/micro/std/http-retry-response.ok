// #244: Локальный Retrying decorator без сетевого origin.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/retry" take Retrying;
import "http/message" take Request, Response;
import "http/header" take Header, Headers;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "net/stream" take ConnectionEndpoints;
import "http/exchange" take ClientResponse, ExchangeDetails, Exchanging;
import "http/status" take Status;
import "http/version" take HttpVersion;
import "time/clock" take Instant, MonotonicInstant, Timing;
import "time/duration" take Duration;


object Origin does Exchanging { has details is ExchangeDetails; Origin(details is ExchangeDetails) { self.details=details; } async response(request is Request) is ClientResponse { ClientResponse(request,Response(status:Status.ok,headers:Headers(Header("Cache-Control","max-age=60"),Header("X-Value",request::Head::headers.text("X-Value")))),details); } }
object FixedClock does Timing { FixedClock(); instant() is Instant { Instant(Duration(seconds:100)); } monotonic_instant() is MonotonicInstant { MonotonicInstant(Duration(seconds:100)); } async wait(duration is Duration) is void {} }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let endpoint = IpEndpoint(IpAddress("127.0.0.1"),80);
            let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(endpoint,endpoint);
            let details = ExchangeDetails(ends,HttpVersion.http_1_1);
            let request = Request(url:"https://example.test/"+x,headers:Headers(Header("X-Value",x)));
            let value = await Retrying(Origin(details)).response(request);
            let contribution = value::Head::headers.int("X-Value");
            sum = sum.add(contribution);
        }
        sum.total();
    }
}

async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

// #244: POP3 multiline и dot-unstuffing.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mail/pop3_reply" take ParsedPopReply, PopReplyMode;
import "encoding/utf" take Utf8Encoded;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let reply = ParsedPopReply(Utf8Encoded("+OK follows\r\n..line"+x+"\r\n.\r\n").bytes(),PopReplyMode.multiline).reply();
        let contribution = reply::Reply::body.size();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

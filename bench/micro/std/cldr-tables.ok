module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "locale/internal/iana" take IanaLanguages;
import "locale/internal/likely" take CldrLikely;
import "locale/internal/parents" take CldrParents;
import "locale/internal/zone_meta" take CldrZoneMeta;
import "locale/internal/numbers" take CldrNumbers;
import "locale/internal/currencies" take CldrCurrencies;

object Bench {
    has languages, likely, parents, zones, systems, currencies is @string;
    Bench() {
        languages = ["iw", "mo", "in", "en"];
        likely = ["ru", "und-JP", "zh", "sr-ME"];
        parents = ["en-GB", "es-MX", "pt-AO", "de-CH"];
        zones = ["Asia/Kolkata", "Asia/Calcutta", "Europe/Paris", "America/Buenos_Aires"];
        systems = ["arab", "latn", "deva", "thai"];
        currencies = ["JPY", "USD", "BHD", "EUR"];
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let k = i % 4;
        let alias = IanaLanguages().alias("language", languages[k]);
        let full = CldrLikely().lookup(likely[k]);
        let parent = CldrParents().parent(parents[k]);
        let zone = CldrZoneMeta().canonical(zones[k]);
        let digits = CldrNumbers().digits(systems[k]);
        let minor = CldrCurrencies().digits(currencies[k]);
        self.run(i + 1, n, acc + (alias.length() + full.length() + parent.length() + zone.length() + digits.characters()[1].code() + minor.length() + minor.characters()[0].code()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

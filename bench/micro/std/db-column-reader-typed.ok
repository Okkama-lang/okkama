module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "math/decimal" take Decimal;
import "db/value" take DbValue, DbValueKind, DbNull, DbBoolean, DbInteger, DbFloating, DbDecimal, DbText, DbBytes;
import "db/row" take Row, Column;
import "db/read" take DbColumnReader, RowValueFailure;

// The position of a kind in DbValueKind.
hidden object Code {
    Code();
    of(kind is DbValueKind) is int {
        match kind {
            case DbValueKind.null_value { 0; }
            case DbValueKind.boolean { 1; }
            case DbValueKind.integer { 2; }
            case DbValueKind.floating { 3; }
            case DbValueKind.decimal { 4; }
            case DbValueKind.text { 5; }
            case DbValueKind.bytes { 6; }
        }
    }
}

// Column readers over values of every kind; a flag that is neither 0 nor 1 refused every third iteration.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let bad = try { if DbColumnReader(name: "f", origin: DbInteger(i % 3 + 1)).flag() { 20; } else { 10; }; } catch e is RowValueFailure { 30; };
        let total = (if DbColumnReader(name: "b", origin: DbBoolean(v % 2 == 0)).boolean() { 1; } else { 0; })
            + DbColumnReader(name: "y", origin: DbBytes([byte(v)])).bytes()[0].int()
            + Code().of(DbColumnReader(name: "c", origin: DbText(x)).cell().kind())
            + DbColumnReader(name: "n", origin: DbInteger(v * 3)).checked_int()
            + DbColumnReader(name: "t", origin: DbText("ab" + x)).checked_text().length()
            + DbColumnReader(name: "d", origin: DbDecimal(Decimal(x + ".5"))).decimal().string().length()
            + DbColumnReader(name: "g", origin: DbFloating(2.5)).floating().int() + bad;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

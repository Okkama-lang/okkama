module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "toml/parse" take ParsedToml;

// Offset and local dates and times read and written back as strings.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let root = ParsedToml("when = 2026-0" + x + "-01T07:30:00+05:30\nday = 2026-01-0" + x + "\nat = 07:3" + x + ":00\n" +
            "local = 2026-01-01T00:00:0" + x + "\n").root();
        let total = root.date_time("when").string().length() + root.local_date("day").string().length()
            + root.local_time("at").string().length() + root.local_date_time("local").string().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

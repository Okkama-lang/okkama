module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "encoding/pem" take PemEncoded;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let data is @byte = (0..40).map() -> k { byte((i + 7 * k) % 256); };
        let text = PemEncoded(kind: "TEST DATA", data: data).string();
        self.run(i + 1, n, acc + (text.length() + text.characters()[26].code()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

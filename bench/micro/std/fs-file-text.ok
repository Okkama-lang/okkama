module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "os/environment" take Environment;
import "fs/temp" take TemporaryDirectory;
import "fs/file" take File, FileMode;

// A text file written line by line, flushed and synced; read as a line, the remaining lines, all its content and one batch; rewritten.
object Bench {
    has parent is Environment;
    Bench() {
        parent = Environment();
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let scratch = TemporaryDirectory(parent: parent.temporary(), prefix: "okkama-fs-");
        let root = scratch.path();
        let path = root.child("t.txt");
        let file = File(path: path, mode: FileMode.writing);
        let text = file.text();
        text.writeln("alpha", x);
        text.writeln("beta", "-", x, x);
        text.writeln("gamma");
        text.flush();
        text.sync();
        file.close();
        let reading = File(path: path).text();
        let first = reading.line();
        let rest = reading.lines();
        let content = File(path: path).text().content();
        let batch = File(path: path).text().batch();
        File(path: path, mode: FileMode.reading_and_writing).text().rewrite("z", x);
        let after = File(path: path).text().content();
        scratch.close();
        let total = first.length() + 10 * rest.size() + 100 * content.length() + 1000 * batch.size() + 10000 * after.length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

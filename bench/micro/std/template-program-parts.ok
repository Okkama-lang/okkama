// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "template/compile" take TemplateProgram;
import "template/engine" take TemplatePartials;
import "template/tree" take TemplateTreeNode, TemplateTreeKind;
import "template/path" take TemplatePath, TemplatePathFromString;
import "compare" take Order;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let partials = TemplatePartials(["p": "A" + x]);
        let program = TemplateProgram(partials.source("p") + "{{n}}", 64, 8);
        let node = TemplateTreeNode(TemplateTreeKind.literal, x, []);
        let path = TemplatePathFromString("a." + x).path();
        let result = program.instructions().size() + node.text().length() + path.string().length() + (if path.order(
            TemplatePath("z")
        ) == Order.less {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

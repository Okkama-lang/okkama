// #244: http2-control-frames; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2Fault, Http2FaultScope;
import "http/internal/http2_controls" take Http2Reset, Http2ResetFrame, Http2GoAway, Http2GoAwayFrame, Http2GoAwayProgress, Http2PingReply;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let reset = Http2Reset(Http2ResetFrame(1,v).frame());
        let goaway = Http2GoAway(Http2GoAwayFrame(v,0,[v.byte()]).frame());
        let progress = Http2GoAwayProgress().received(goaway);
        let ping = Http2PingReply(Http2Frame(Http2FrameHeader(6.byte(),0.byte(),0,8),[v.byte(),0.byte(),0.byte(),0.byte(),0.byte(),0.byte(),0.byte(),0.byte()]));
        let contribution = reset.code()+goaway.debug()[0].int()+progress.last_stream()+ping.frames()[0].payload()[0].int();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

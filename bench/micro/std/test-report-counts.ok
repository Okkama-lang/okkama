module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "testing/result" take TestReport, TestResult, TestStatus, TestFailure, TestOutput, TestCounts;
import "time/clock" take Instant;
import "time/duration" take Duration;

object Bench {
    has statuses is @TestStatus;
    Bench() {
        statuses = [TestStatus.passed, TestStatus.failed, TestStatus.skipped, TestStatus.passed, TestStatus.timed_out];
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let output = TestOutput(output: [], errors: [], truncated: false);
        let failures is @TestFailure = [];
        let results is @TestResult = (0..1 + i % 4).map() -> k {
            TestResult(name: "case " + k.string(), status: statuses[(i + k) % 5], duration: Duration(seconds: 0.rat()), failures: failures, output: output);
        };
        let report = TestReport(start: Instant(origin: Duration(seconds: 0.rat())), duration: Duration(seconds: 1.rat()), seed: i, results: results);
        let counts = report.counts();
        self.run(i + 1, n, acc + (counts.total() + counts::Counts::passes * 2 + TestCounts(passes: i % 3, failures: 1, skips: 0).total()) % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/record" take LogRecord, LogContext;
import "logging/level" take LogLevel;
import "logging/name" take LogName;
import "logging/field" take LogFields;
import "time/clock" take Instant;
import "time/duration" take Duration;
import "json" take JsonField, Json;
import "logging/write" take CollectedLogs, BroadcastLogs, BestEffortLogs, FallbackLogs;
import "logging/filter" take AllowedLogs;
import "logging/redact" take RedactedLogs;

// One record through filtering, broadcasting, redaction, fallback and best-effort writers into collections.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let levels is @LogLevel = [LogLevel.debug, LogLevel.info, LogLevel.warning, LogLevel.error, LogLevel.critical];
        let level = levels[i % 5];
        let record = LogRecord(occurred: Instant(origin: Duration(seconds: 1700000000 + i)), level: level, message: "m" + x,
            context: LogContext(name: LogName("app", ["db", "web"][i % 2]), fields: LogFields(JsonField("password", "s" + x), JsonField("id", v)), process: 42));
        let kept = CollectedLogs();
        let other = CollectedLogs();
        let allowed = AllowedLogs(origin: BroadcastLogs(kept, other), level: LogLevel.info, overrides: ["app.db": LogLevel.error]);
        allowed.write(record);
        let broadcast = BroadcastLogs(kept, CollectedLogs(capacity: 0));
        let broken = try { broadcast.write(record); 0; } catch e is Error { 1; };
        let redacted = CollectedLogs();
        RedactedLogs(origin: redacted, names: ["password"], replacement: Json("***")).write(record);
        let backup = CollectedLogs();
        FallbackLogs(primary: CollectedLogs(capacity: 0), fallback: backup).write(record);
        let quiet = BestEffortLogs(CollectedLogs(capacity: i % 2));
        quiet.write(record);
        let total = kept.size() + 10 * other.size() + 100 * broken + 1000 * backup.size() + 10000 * quiet.failures()
            + (if allowed.enabled(LogName("app", "db"), level) { 100000; } else { 0; }) + (if broadcast.enabled(LogName("x"), level) { 1000000; } else { 0; })
            + 10000000 * redacted.records().first().context().fields().value("password").text().length();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: Conversation exchange snapshot и освобождение lease.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/conversation" take HttpConversationExchange;
import "http/message" take Request, Response;
import "http/status" take StatusCode;
import "http/body" take ByteBodyInput;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let request = Request(url:"http://example.test/"+x);
        let lease = ByteBodyInput([]);
        let result = HttpConversationExchange(request,Response(status:StatusCode(200+v%50).status()),[],lease);
        let contribution = result.response()::Head::code;
        result.close();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// Deterministic composite iteration; see oracles.py for the independent checksum.
// JsonTemplateStrings.new(origin is Json) is JsonTemplateStrings | JsonTemplateStrings.new(origin is Json, maximum_members is int, maximum_output is int) is JsonTemplateStrings
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "template/json" take JsonTemplateStrings;
import "json" take Json;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let contribution = JsonTemplateStrings(Json(i)).string(".").length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

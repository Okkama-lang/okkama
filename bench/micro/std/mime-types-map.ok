module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mime/types" take MappedMediaTypes, MediaTypeExtension, MediaMatch, MediaTypeFileLimits, StandardMediaTypes, EmptyMediaTypes, UnknownMediaType;
import "mime/media_type" take MediaType;
import "fs/path" take Path;

// Extension maps with standard and empty fallbacks: types by file name, extensions by type, positions of a match; file limits.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let entries is @MediaTypeExtension = [MediaTypeExtension(extension: "okk", type: MediaType("text/x-okkama")), MediaTypeExtension(extension: "ok" + x, type: MediaType("text/x-okkama")),
            MediaTypeExtension(extension: "PNG", type: MediaType("image/x-own"))];
        let mapped = MappedMediaTypes(entries: entries, fallback: if i % 2 == 0 { StandardMediaTypes(); } else { EmptyMediaTypes(); });
        let names is @string = ["a.okk", "b.ok" + x, "c.png", "d.pdf"];
        let limits = MediaTypeFileLimits(files: v, bytes: 1000, entries: 10);
        let total = (try { mapped.type(Path(names[i % 4])).string().length(); } catch e is UnknownMediaType { 3; }) + 100 * mapped.extensions(MediaType("text/x-okkama")).size()
            + 1000 * (MediaMatch(entries, "file.b.ok" + x).index() + 1) + 10000 * (try { EmptyMediaTypes().type(Path("z.txt")).string().length(); } catch e is UnknownMediaType { 3; }) + 1000000 * limits.files();
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

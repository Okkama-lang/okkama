// #244: Состояние наблюдения первых response bytes.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/transport_observation" take HttpResponseObservation;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let value = HttpResponseObservation();
        value.begin();
        if i % 2 == 0 { value.receive(); }
        let contribution = if value.received() { v; } else { 0; };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

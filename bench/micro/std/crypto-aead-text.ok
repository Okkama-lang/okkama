module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/aes_gcm" take AesGcm;
import "crypto/chacha20_poly1305" take ChaCha20Poly1305;
import "crypto/secret" take SecretBytes;
import "crypto/error" take AuthenticationFailed;

// AES-GCM (128 or 256-bit key) and ChaCha20-Poly1305 sealing a text and opening it as text; a changed associated text refused.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 9 + 1;
        let x = v.string();
        let short is @byte = (0..(if i % 2 == 0 { 16; } else { 32; })).map() -> k { byte((k * 3 + i) % 256); };
        let long is @byte = (0..32).map() -> k { byte((k * 5 + i) % 256); };
        let nonce is @byte = (0..12).map() -> k { byte(k + v); };
        let aes = AesGcm(SecretBytes(short));
        let chacha = ChaCha20Poly1305(SecretBytes(long));
        let text = "note " + x + x;
        let a = aes.sealed(nonce, "hdr" + x, text);
        let c = chacha.sealed(nonce, "hdr", text);
        let bad = try { chacha.opened_text(nonce, "other", c).length(); } catch e is AuthenticationFailed { 100; };
        let total = (if aes.algorithm() == "aes-128-gcm" { 1; } else { 2; }) + aes.opened_text(nonce, "hdr" + x, a).length() + 10 * a.size()
            + chacha.opened_text(nonce, "hdr", c).length() + bad;
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// Deterministic composite iteration; see oracles.py for the independent checksum.
// TlsDetails.new(ends is ConnectionEndpoints<IpEndpoint>, peer is CertificateChain, version is TlsVersion, cipher is string, protocol is string) is TlsDetails | TlsDetails.new(ends is ConnectionEndpoints<IpEndpoint>, version is TlsVersion, cipher is string, protocol is string) is TlsDetails
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "net/tls" take TlsDetails, TlsVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;


object Bench {
    has ends is ConnectionEndpoints<IpEndpoint>;
    Bench() { let endpoint = IpEndpoint(IpAddress("192.0.2.1"), 443); ends = ConnectionEndpoints(endpoint, endpoint); }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let details = TlsDetails(ends: ends, version: TlsVersion.tls1_3, cipher: "TLS_AES_128_GCM_SHA256", protocol: "h2-" + i.string());
        let contribution = details::Session::protocol.length();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "archive/entry" take ArchiveFile, ArchiveEntry;
import "archive/metadata" take ArchiveMetadata, ArchiveModificationFromEpoch;
import "archive/path" take ArchivePath;
import "archive/stream" take ArchiveWriting;
import "async/atomic" take Atomic;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let count = Atomic(0);
        let metadata = ArchiveMetadata(ArchiveModificationFromEpoch(0.rat()).local_date_time(), "");
        let writer = ArchiveWriting(
            (entry is ArchiveEntry) is void {
                count.replace(count.value() + entry.path().string().length());
            },
            () is void {
                count.replace(count.value() + 1);
            }
        );
        writer.write(ArchiveFile(path: ArchivePath(x), metadata: metadata, text: x));
        writer.finish();
        let finished = if writer.finished() {
            1;
        }
        else {
            0;
        };
        writer.close();
        let result = count.value() + finished + (if writer.closed() {
            1;
        }
        else {
            0;
        });
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: deterministic small work scenario; independent oracle in oracles.py.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;
import "time/format" take FormattedDate, FormattedLocalDateTime;

object Bench {
    Bench();

    run(i is int, n is int, acc is int) is int {
        if i == n {
            return acc;
        }
        let v = i % 23 + 1;
        let x = v.string();
        let day = if v < 10 {
            "0" + x;
        }
        else {
            x;
        };
        let date = "2024-01-" + day;
        let a = FormattedLocalDateTime(text: date + " 12:34:56", pattern: "%Y-%m-%d %H:%M:%S");
        let result = FormattedDate(text: date, pattern: "%Y-%m-%d").date()::Calendar::day + a.local_date_time().date()::Calendar::day + a.string().length();
        self.run(i + 1, n, acc + result);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

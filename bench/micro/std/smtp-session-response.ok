// #244: SMTP AUTH PLAIN response (RFC 4616).
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "mail/smtp_session" take SmtpCredentials;
import "crypto/secret" take ExportedSecret, SecretBytes;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let secret = SecretBytes("pw"+x);
        let data = ExportedSecret(SmtpCredentials("u"+x,secret).response()).bytes();
        let contribution = data.reduce(0) -> s, b { s + b.int(); };
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: http2-send-reservations; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/internal/http2_frame" take Http2Frame, Http2FrameHeader, Http2Fault, Http2FaultScope;
import "io/stream" take AsyncWriting, ByteSource;
import "async/atomic" take Atomic;
import "http/internal/http2_output" take Http2ConnectionOutput, Http2OutputTicket, Http2OutputStarting, Http2OutputStopped;
import "http/internal/http2_flow" take Http2FlowWindow, Http2SendCredit, Http2DataPayload, Http2WindowFrame, Http2WindowIncrement;
import "http/internal/http2_sending" take Http2DataScheduler, Http2DataGrant;
import "http/internal/http2_settings" take Http2PeerSettings;
import "async/scope" take FutureGroup;
object Sink does AsyncWriting { has sum is Atomic<int>; Sink() { sum=Atomic(0); } async write(source is ByteSource) is AsyncWriting { await self.write(source.bytes()); } async write(bytes is @byte) is AsyncWriting { sum.replace(sum.value()+bytes.reduce(0) -> s,b { s+b.int(); }); self; } checksum() is int { sum.value(); } }
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let output = Http2ConnectionOutput(Sink(),8,1024);
        let peer = Http2PeerSettings();
        let scheduler = Http2DataScheduler(output,peer,8);
        scheduler.open(1);
        let slot = scheduler.slot(1);
        let grants = scheduler.reserve(slot,v);
        grants[0].start();
        let reserved = scheduler.reserve(slot,1);
        reserved[0].cancel();
        let zero = Http2DataGrant(scheduler,slot,0);
        zero.cancel();
        scheduler.commit(slot,0);
        scheduler.release(slot,0);
        scheduler.settings(peer,peer);
        scheduler.window(Http2WindowIncrement(Http2WindowFrame(0,v).frame()));
        scheduler.wake();
        let contribution = scheduler.connection_remaining()+scheduler.stream_remaining(1);
        scheduler.close(1);
        scheduler.stop();
        output.abort();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

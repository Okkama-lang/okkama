// #244: Рендеринг HTTP/1 request head.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/http1_writing" take Http1RequestHeadWire;
import "http/http1_head" take Http1Limits, ParsedHttp1RequestHead;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let text = "GET /a"+x+" HTTP/1.1\r\nHost: example.test\r\n\r\n";
        let head = ParsedHttp1RequestHead(text).head();
        let contribution = Http1RequestHeadWire(head,Http1Limits()).bytes().size();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

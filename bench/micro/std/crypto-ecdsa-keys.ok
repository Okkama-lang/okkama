module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "crypto/ecdsa" take EcdsaPrivateKey, EcdsaPublicKey, EcdsaCurve;
import "crypto/jwt" take JwtEcdsaKey, JwtAlgorithm;
import "crypto/secret" take SecretBytes;
import "encoding/pem" take PemBlock;
import "encoding/utf" take Utf8Encoded;

// A P-256 key read from PKCS#8 and SPKI; its public key and JWT ES256 keys sign and verify a changing input.
object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let key = EcdsaPrivateKey(curve: EcdsaCurve.p256, pkcs8: SecretBytes(PemBlock(origin: "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgooq/y5Wqru57uZ/f\nLtDqQBGy63m5uDllm9k87Q2FqQuhRANCAAQaMDVadj3Njz0QDGkIC6mwMvsIrcKE\ngNpBpZ4p9lZl/U7IZOjaGwl/oQS67X/YHf5rcfdxvcb70003NsmoexTL\n-----END PRIVATE KEY-----\n").bytes()));
        let public = EcdsaPublicKey(curve: EcdsaCurve.p256, spki: PemBlock(origin: "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEGjA1WnY9zY89EAxpCAupsDL7CK3C\nhIDaQaWeKfZWZf1OyGTo2hsJf6EEuu1/2B3+a3H3cb3G+9NNNzbJqHsUyw==\n-----END PUBLIC KEY-----\n").bytes());
        let input = Utf8Encoded("header.claims" + i.string()).bytes();
        let signer = JwtEcdsaKey(algorithm: JwtAlgorithm.es256, signing: key);
        let checker = JwtEcdsaKey(algorithm: JwtAlgorithm.es256, verifying: public);
        let signature = signer.signature(input);
        let derived = key.public_key();
        let total = key.pkcs8().size() + 1000 * signature.size() + (if checker.verified(input, signature) { 1; } else { 0; })
            + (if checker.verified(Utf8Encoded("x").bytes(), signature) { 2; } else { 0; }) + (if derived.bytes() == public.bytes() { 4; } else { 0; });
        self.run(i + 1, n, acc + total % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

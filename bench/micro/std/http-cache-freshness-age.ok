// #244: RFC 9111 age: Age + response delay + residence.
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "http/cache_freshness" take CacheFreshness, CacheResponseTiming;
import "http/header" take Header, Headers;
import "time/clock" take Instant, MonotonicInstant;
import "time/duration" take Duration;



object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let start = MonotonicInstant(Duration(seconds: 0.rat()));
        let end = MonotonicInstant(Duration(seconds: 2.rat()));
        let timing = CacheResponseTiming(Instant(Duration(seconds: 100.rat())),start,end);
        let value = CacheFreshness(Headers(Header("Cache-Control","max-age=3600"),Header("Age",x)),timing);
        let contribution = value.age(MonotonicInstant(Duration(seconds: 12.rat())))::Span::seconds.int();
        self.run(i + 1, n, acc + contribution);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

// #244: imap-capabilities-construct; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "encoding/utf" take Utf8Encoded;
import "mail/imap" take ImapCapabilities, ImapCapabilityLimits, ParsedImapCapabilities;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let limits = ImapCapabilityLimits(tokens:8,token_bytes:64,wire_bytes:256);
        let caps = ImapCapabilities(["IMAP4rev1","X-"+x],limits);
        let parsed = ParsedImapCapabilities(Utf8Encoded("* CAPABILITY IMAP4rev1 X-"+x+"\r\n").bytes(),limits).capabilities();
        let contribution = caps.tokens().size()+parsed.tokens().size()+caps.bytes().size();
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

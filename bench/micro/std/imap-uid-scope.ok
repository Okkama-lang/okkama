// #244: imap-uid-scope; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "mail/imap_uid" take ImapSequence, ImapUid, ImapUidSet, ImapUidValidity, MailboxUids;
import "mail/imap_name" take ImapMailboxName;
import "compare" take Order;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let uid = ImapUid(v);
        let sequence = ImapSequence(v);
        let validity = ImapUidValidity(v);
        let ids = ImapUidSet(uid);
        let mailbox = ImapMailboxName("box"+x);
        let scoped = MailboxUids(mailbox,validity,ids,"account");
        let checked = scoped.checked(mailbox,validity,"account");
        let contribution = checked.entries().item(0).number()+(if !ids.empty() && uid.order(uid)==Order.equal && sequence.order(sequence)==Order.equal && validity.order(validity)==Order.equal { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

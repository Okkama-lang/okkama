// #244: http-cache-directives; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/cache_control" take CacheControl, CacheDeltaSeconds;
import "http/date" take HttpDate;
import "http/header" take Headers, Header;
import "time/clock" take Instant;
import "time/duration" take Duration;
import "compare" take Order;

object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let v = i % 251 + 1;
        let x = v.string();
        let control = CacheControl(Headers(Header("Cache-Control","max-age="+x+", public")));
        let seconds = CacheDeltaSeconds(control.arguments("max-age")[0]).seconds();
        let date = HttpDate(Instant(Duration(seconds:v)));
        let contribution = seconds+control.count("public")+(if date.order(date)==Order.equal { 1; } else { 0; });
        self.run(i + 1, n, acc + contribution);
    }
}
main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

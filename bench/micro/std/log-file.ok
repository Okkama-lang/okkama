module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "logging/file" take LogFile, FileLogOptions;
import "fs/temp" take TemporaryDirectory;
import "fs/entry" take FileEntry;
import "fs/stat" take PermissionMode;
import "os/environment" take Environment;
import "encoding/utf" take Utf8Encoded;

object Bench {
    has parent is Environment;
    Bench() {
        parent = Environment();
    }
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let scratch = TemporaryDirectory(parent: parent.temporary(), prefix: "okkama-log-");
        let path = scratch.path().child("app.log");
        let log = LogFile(path: path, options: FileLogOptions(permissions: PermissionMode(384), flush_each: i % 2 == 0, sync_each: false));
        log.write(Utf8Encoded("line " + i.string() + "\n").bytes());
        log.write(Utf8Encoded("second\n").bytes());
        log.flush();
        log.close();
        let size = FileEntry(path).stat()::Shape::size;
        scratch.close();
        self.run(i + 1, n, acc + size % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

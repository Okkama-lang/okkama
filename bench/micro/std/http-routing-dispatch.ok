// #244: http-routing-dispatch; independent checksum in oracles.py.
module bench/micro v1.0.0;
import "../support/harness" take Measurement;
import "http/request_context" take HttpRequestContext;
import "http/exchange" take ExchangeDetails;
import "http/version" take HttpVersion;
import "net/stream" take ConnectionEndpoints;
import "net/endpoint" take IpEndpoint;
import "net/ip" take IpAddress;
import "async/cancellation" take Cancellation;
import "http/handler" take Handling, HandlingResult, ResponseHandling;
import "http/message" take Request, Response, Responding;
import "http/status" take Status, StatusCode, StatusClass;
import "http/method" take Method;
import "http/routing" take Route, RoutePattern, RouteSegment, Routes;
object Context { Context(); value() is HttpRequestContext {
    let ends is ConnectionEndpoints<IpEndpoint> = ConnectionEndpoints(local:IpEndpoint(IpAddress("127.0.0.1"),80),remote:IpEndpoint(IpAddress("127.0.0.1"),50000));
    HttpRequestContext(details:ExchangeDetails(endpoints:ends,version:HttpVersion.http_1_1),cancellation:Cancellation().cancelling());
} }object Handler does Handling { Handler(); async handling(request is Request,context is HttpRequestContext) is HandlingResult { ResponseHandling(Response(status:Status.ok)); } }
object Sum { has total is int; Sum(:total); add(value is int) is ^Sum { ^total = total + value; } total() is int { total; } }

object Bench {
    Bench();
    async run(n is int) is int {
        let sum = Sum(total: 0);
        for 0..n -> i {
            let v = i % 251 + 1;
            let x = v.string();
            let pattern = RoutePattern("/items/:id");
            let segment = RouteSegment(":"+"id",true);
            let matched = pattern.matching(["items",x]);
            let route = Route(Method.get,pattern,Handler());
            let routes = Routes([route],Handler());
            let request = Request(url:"http://example.test/items/"+x);
            let result = await routes.handling(request,Context().value());
            let invoked = await routes.invoke(Handler(),request,Context().value());
            let contribution = result.response()::Head::code+invoked.response()::Head::code+route.method_token().length()+segment::Segment::text.length()+(if route.method()==Method.get && pattern.matches(["items",x]) && pattern.overlaps(RoutePattern("/items/"+x)) { v; } else { 0; });
            sum = sum.add(contribution);
        }
        sum.total();
    }
}
async main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = await bench.run(measure.warmup());
    let before = measure.start();
    let check = await bench.run(n);
    measure.finish(before, check, warm);
    0;
}

// Deterministic composite iteration; see oracles.py for the independent checksum.
// TemplateTree.new(source is string) is TemplateTree | TemplateTree.new(source is string, maximum_input is int, maximum_tokens is int, maximum_depth is int) is TemplateTree
module bench/micro v1.0.0;

import "../support/harness" take Measurement;

import "template/tree" take TemplateTree, TemplateTreeNode;


object Bench {
    Bench();
    run(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        let nodes = TemplateTree("item" + i.string() + "{{name}}").nodes();
        let contribution = nodes[0].text().length() + nodes.size();
        self.run(i + 1, n, acc + contribution % 7);
    }
}

main() is int {
    let measure = Measurement();
    let bench = Bench();
    let n = measure.n();
    let warm = bench.run(0, measure.warmup(), 0);
    let before = measure.start();
    let check = bench.run(0, n, 0);
    measure.finish(before, check, warm);
    0;
}

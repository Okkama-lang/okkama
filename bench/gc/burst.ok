module bench/gc v1.0.0;

// Burst and reuse (#522): a 200 000-element structure is built and dropped, then a steady trickle of small
// allocations runs on the freed memory; RSS should come back down instead of staying at the burst.
import "io/stdout" take Stdout, Stderr;
import "runtime/process" take process_arguments;
import "runtime/time" take monotonic_clock;

object Cell {
    has value is int;
    has label is string;
    Cell(:value, :label);
    value() is int { value; }
}

object Work {
    Work();
    trickle(i is int, n is int, acc is int) is int {
        if i == n { return acc; }
        self.trickle(i + 1, n, acc + Cell(value: i, label: "t").value() % 5);
    }
}

// #236 protocol, as bench/ownership/ownership.ok: an argument N repeats the work N times and prints
// "iteration <nanoseconds>" to stderr per run; stdout gets the result once.
object Repeat {
    Repeat();
    run(work is () is string) is string {
        let arguments = process_arguments();
        if arguments.size() == 0 { return work(); }
        let count = arguments[0].reduce(0) -> number, digit { number * 10 + digit.int() - 48; };
        (0..count).reduce("") -> previous, index {
            let started = monotonic_clock();
            let result = work();
            Stderr().writeln("iteration " + (monotonic_clock() - started).string());
            result;
        };
    }
}

main() is int {
    Stdout().writeln(Repeat().run(() is string {
        let burst = (0..200000).map() -> i { Cell(value: i, label: i.string()); };
        let total = burst.reduce(0) -> sum, cell { sum + cell.value() % 11; };
        (total + Work().trickle(0, 400000, 0)).string();
    }));
    0;
}
